// The system calls of a user program through the IR: each is a `pcall` with
// the number and a frame slot of three argument words (c 10: as it is, 11:
// the console buffer is written out first, 12: `sys_spawn`).
fn plain(pid: u64) -> u64 {
  let t = sys_info(1);
  sys_yield();
  let me = sys_getpid();
  if sys_kill(pid) != 0 {
    return t + me;
  }
  return sys_wait(pid);
}

fn listing() {
  sys_ps();
  sys_poweroff();
}

fn open(name: &Bytes, n: u64) -> u64
  requires n <= blen(name)
{
  return sys_send(11, 2, name, n);
}

fn fill(fd: u64, buf: &mut Bytes) -> u64
  ensures blen(buf) == old(blen(buf))
{
  return sys_recv(13, fd, &mut buf);
}

fn close(fd: u64, off: u64) -> u64 {
  return sys_call(12, fd, off);
}

fn start(names: &Buf, from: u64, to: u64) -> u64
  requires from <= to && to <= len(names)
{
  return sys_spawn(names, from, to);
}

fn main(con: &mut Serial) -> u64 {
  return 0;
}
