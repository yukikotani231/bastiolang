// Functions outside the first IR subset: irdump says why for each.
struct Pair { a: u64, b: u64 }

fn first(p: Pair) -> u64 {
  return p.a;
}

fn sum(v: &Vec[u64]) -> u64 {
  return 0;
}

fn bump(x: u64) -> u64
  requires x < 100
{
  return wrap_add(x, 1);
}

