fn chain(v0) {
  v3 = const 1
  v4 = add v0, v3
  v6 = const 1
  v7 = add v4, v6
  ret v7
}
fn moves(v0) {
  v1 = mov v0
  v2 = mov v1
  v3 = const 1
  v4 = add v1, v3
  v1 = mov v4
  v5 = add v2, v1
  ret v5
}
fn looped(v0) {
  v1 = const 1
  v2 = add v0, v1
  v3 = mov v2
  v4 = const 0
  v5 = const 0
L0:
  v6 = const 3
  v7 = lt v5, v6
  br v7, L1, L2
L1:
  v8 = add v4, v3
  v4 = mov v8
  v9 = const 1
  v10 = add v5, v9
  v5 = mov v10
  jmp L0
L2:
  ret v4
}
fn main() {
  v0 = const 1
  v1 = call chain(v0)
  v2 = const 2
  v3 = call moves(v2)
  v4 = add v1, v3
  v5 = const 3
  v6 = call looped(v5)
  v7 = add v4, v6
  ret v7
}
