fn chain(v0) {
  v3 = const 1
  v4 = add v0, v3
  v7 = const 1
  v8 = add v4, v7
  ret v8
}
fn moves(v0) {
  v1 = mov v0
  v2 = mov v1
  v3 = const 1
  v4 = add v1, v3
  v1 = mov v4
  v5 = add v2, v1
  ret v5
}
fn looped(v0) {
  v1 = const 1
  v2 = add v0, v1
  v4 = mov v2
  v5 = const 0
  v6 = mov v5
  v7 = const 0
  v8 = mov v7
L0:
  v9 = const 3
  v10 = lt v8, v9
  br v10, L1, L2
L1:
  v11 = add v6, v4
  v6 = mov v11
  v12 = const 1
  v13 = add v8, v12
  v8 = mov v13
  jmp L0
L2:
  ret v6
}
fn main() {
  v0 = const 1
  v1 = call chain(v0)
  v2 = const 2
  v3 = call moves(v2)
  v4 = add v1, v3
  v5 = const 3
  v6 = call looped(v5)
  v7 = add v4, v6
  ret v7
}
