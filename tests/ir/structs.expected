fn mk(v0, v1) {
  v3 = mov v1
  v2 = mov v0
  ret v2, v3
}
fn swap(v0, v1) {
  v2 = mov v1
  v3 = mov v0
  ret v2, v3
}
fn area(v0, v1, v2, v3, v4) {
  v5 = sub v2, v0
  v6 = mov v5
  v7 = sub v3, v1
  v8 = mov v7
  v9 = mul v6, v8
  ret v9
}
fn grow(v0, v1, v2, v3, v4) {
  v5 = mov v0
  v6 = mov v1
  v7 = mov v2
  v8 = mov v3
  v9 = mov v4
  v10 = const 1
  v11 = add v7, v10
  v7 = mov v11
  v12 = const 1
  v9 = mov v12
  ret v7, v8
}
fn main() {
  v0 = const 1
  v1 = const 2
  v2, v3 = call mk(v0, v1)
  v4, v5 = call swap(v2, v3)
  v6 = mov v4
  v7 = mov v5
  v8 = mov v6
  v9 = mov v7
  v15 = const 5
  v13 = mov v15
  v16 = const 9
  v14 = mov v16
  v10 = mov v13
  v11 = mov v14
  v17 = const 0
  v12 = mov v17
  v18, v19 = call grow(v8, v9, v10, v11, v12)
  v20 = mov v18
  v21 = mov v19
  v22 = mov v6
  v23 = mov v7
  v24 = mov v20
  v25 = mov v21
  v27 = const 1
  v26 = mov v27
  v28 = call area(v22, v23, v24, v25, v26)
  ret v28
}
