// Jump threading through a merge block (`iropt_merge`): the branch that sets
// the tag goes straight to the arm that tests it.
enum Pick { Some(u64), None }

fn pick(c: u64, x: u64) -> u64 {
  let mut r = Pick::None;
  if c < 10 {
    r = Pick::Some(x);
  }
  match r {
    Pick::Some(v) => { return wrap_add(v, 1); }
    Pick::None => { return 0; }
  }
}

fn main() -> u64 {
  return pick(3, 4);
}
