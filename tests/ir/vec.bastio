fn fill(v: &mut Vec[u64], n: u64)
  requires vlen(v) == 0 && n <= 100000000
  ensures vlen(v) == n
{
  let mut i = 0;
  while i < n
    invariant i <= n && vlen(v) == i
  {
    vec_push(&mut v, i % 1000);
    i = i + 1;
  }
}

fn sum(v: &Vec[u64]) -> u64
  requires vlen(v) <= 100000000
  ensures result <= vlen(v) * 1000
{
  let mut t = 0;
  let mut i = 0;
  while i < vec_len(v)
    invariant i <= vlen(v) && t <= i * 1000
  {
    t = t + vec_get(v, i) % 1000;
    i = i + 1;
  }
  return t;
}

fn main() -> u64 {
  let mut t = 0;
  let mut r = 0;
  while r < 20
    invariant t < 1000000007
  {
    let mut v: Vec[u64] = vec_new[u64]();
    fill(&mut v, 10000000);
    t = (t + sum(v)) % 1000000007;
    vec_free(v);
    r = r + 1;
  }
  print(t);
  return 0;
}
