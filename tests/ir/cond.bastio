// Jump threading (stage1/iropt.bastio, iropt_thread): the branch that tests
// the result of `&&` / `||` again is skipped on the edge that already knows it.
fn f(a: u64, b: u64) -> u64 {
  if a < 3 && b < 4 {
    return 1;
  }
  if a == 0 || b == 0 {
    return 2;
  }
  return 3;
}
fn main() -> u64 { return f(1, 2); }
