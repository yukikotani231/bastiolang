// Operations with a constant that leave the other operand as it was, give a
// constant, or compare two constants are folded (`iropt_fold`).
fn idents(x: u64) -> u64 {
  let a = x + 0;
  let b = a - 0;
  let c = b * 1;
  let d = c | 0;
  let e = d ^ 0;
  let f = e / 1;
  let z = f * 0;
  let w = f & 0;
  let r = f % 1;
  return f + z + w + r;
}

fn consts() -> u64 {
  let t = 3;
  let u = 5;
  let mut s = 0;
  if t < u {
    s = s + 1;
  }
  if t == u {
    s = s + 10;
  }
  return s;
}

fn main() {
  print(idents(7));
  print(consts());
}
