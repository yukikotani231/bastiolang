// vec_with: the element's address is the first argument, by address when large
struct Wide { a: u64, b: u64, c: u64, d: u64, e: u64 }

fn wide_sum(w: &Wide, extra: u64) -> u64 {
  return wrap_add(w.a, wrap_add(w.e, extra));
}

fn word_plus(x: &u64, k: u64) -> u64 {
  return wrap_add(x, k);
}

fn main() -> u64 {
  let mut ws = vec_new[Wide]();
  vec_push(&mut ws, Wide { a: 1, b: 2, c: 3, d: 4, e: 5 });
  let s = vec_with(ws, 0, wide_sum, 100);
  vec_free(ws);
  let mut xs = vec_new[u64]();
  vec_push(&mut xs, 5);
  let t = vec_with(xs, 0, word_plus, 40);
  vec_free(xs);
  return wrap_add(s, t);
}
