// Generic enums, structs and functions (stage1/ir.bastio): `E[T]::V(x)`,
// `S[T] { .. }` and `f[T](..)` lower to the instance the monomorphizer made.
enum Option[T] { Some(T), None }
struct Pair[A, B] { a: A, b: B }

fn swap[A, B](p: Pair[A, B]) -> Pair[B, A] {
  return Pair[B, A] { a: p.b, b: p.a };
}

fn or_else[T](o: Option[T], d: T) -> T {
  match o {
    Option::Some(v) => { return v; },
    Option::None => { return d; },
  }
}

fn checked_div(a: u64, b: u64) -> Option[u64] {
  if b == 0 { return Option[u64]::None; }
  return Option[u64]::Some(a / b);
}

fn main() -> u64 {
  let p = swap[u64, bool](Pair[u64, bool] { a: 7, b: true });
  let mut x = 0;
  if p.a { x = p.b; }
  return or_else[u64](checked_div(30, 5), 1) + x;
}
