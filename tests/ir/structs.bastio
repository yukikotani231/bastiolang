struct Pt { x: u64, y: u64 }

struct Span { lo: Pt, hi: Pt, tag: bool }

fn mk(x: u64, y: u64) -> Pt {
  return Pt { y: y, x: x };
}

fn swap(p: Pt) -> Pt {
  return Pt { x: p.y, y: p.x };
}

fn area(s: Span) -> u64
  requires s.lo.x <= s.hi.x && s.lo.y <= s.hi.y && s.hi.x < 1000 && s.hi.y < 1000
{
  let w = s.hi.x - s.lo.x;
  let h = s.hi.y - s.lo.y;
  return w * h;
}

fn grow(s: Span) -> Pt
  requires s.hi.x < 1000
{
  let mut t = s;
  t.hi.x = t.hi.x + 1;
  t.tag = true;
  return t.hi;
}

fn main() -> u64 {
  let p = swap(mk(1, 2));
  let q = grow(Span { lo: p, hi: Pt { x: 5, y: 9 }, tag: false });
  return area(Span { lo: p, hi: q, tag: true });
}
