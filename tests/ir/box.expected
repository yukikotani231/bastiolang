fn make(v0, v1) {
  v2 = mov v0
  v3 = mov v1
  v4 = const 2
  v5 = alloc64 v4
  v6 = const 0
  store64 v5[v6], v2
  v7 = const 1
  store64 v5[v7], v3
  ret v5
}
fn sum(v0) {
  v1 = const 0
  v2 = load64 v0[v1]
  v3 = const 1
  v4 = load64 v0[v3]
  v5 = wadd v2, v4
  ret v5
}
fn main() {
  v0 = const 3
  v1 = const 4
  v2 = call make(v0, v1)
  v3 = mov v2
  v4 = call sum(v3)
  v5 = mov v3
  v6 = mov v4
  v7 = mov v5
  v8 = mov v6
  v11 = const 0
  v9 = load64 v7[v11]
