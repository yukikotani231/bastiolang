// The console capability (stage1/ir.bastio): `serial_write` and `serial_read` become
// `putc` and `getc`, and a `&Serial` parameter is one word.

fn puts(con: &Serial, s: Str) {
  let mut i = 0;
  while i < slen(s) invariant i <= slen(s) {
    serial_write(con, sget(s, i));
    i = i + 1;
  }
}

fn put_digit(con: &Serial, d: u64) requires d < 10 {
  serial_write(con, cast[u8](48 + d));
}

fn main(con: Serial) -> Serial {
  puts(con, "hi ");
  put_digit(con, 42 / 10);
  put_digit(con, 42 % 10);
  // Hosted builds read stdin; at end of input serial_read returns 4 (EOT).
  let c = serial_read(con);
  if c != 4 {
    serial_write(con, c);
  }
  serial_write(con, 10);
  return con;
}
