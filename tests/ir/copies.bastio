// Copy propagation (stage1/iropt.bastio, iropt_copies): a name for a value
// that is written once is replaced by the value; a variable that changes is
// left alone, and so is a copy of a value that a loop writes again; a value
// written once outside every loop is propagated into the loops that read it.
fn chain(x: u64) -> u64
  requires x <= 1000
  ensures result == x + 2
{
  let a = x;
  let b = a;
  let c = b + 1;
  let d = c;
  return d + 1;
}

fn moves(n: u64) -> u64
  requires n <= 1000
  ensures result == 2 * n + 1
{
  let mut a = n;
  let c = a;
  a = a + 1;
  return c + a;
}

fn looped(n: u64) -> u64
  requires n <= 1000
  ensures result == 3 * (n + 1)
{
  let t = n + 1;
  let y = t;
  let mut s = 0;
  let mut i = 0;
  while i < 3
    invariant i <= 3 && s == i * (n + 1)
  {
    s = s + y;
    i = i + 1;
  }
  return s;
}

fn main() -> u64 {
  return chain(1) + moves(2) + looped(3);
}
