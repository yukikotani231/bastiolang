// Functions of the first IR subset: integer and bool locals, arithmetic,
// comparisons, short-circuit operators, `if`, `while`, calls.
fn add(a: u64, b: u64) -> u64
  requires a < 1000 && b < 1000
{
  return a + b;
}

fn sum_to(n: u64) -> u64
  requires n < 1000
{
  let mut i = 0;
  let mut s = 0;
  while i < n
    invariant i <= n && s <= i * 1000
  {
    s = s + i;
    i = i + 1;
  }
  return s;
}

fn between(x: u64, lo: u64, hi: u64) -> bool {
  return x >= lo && x < hi;
}

fn pick(a: i64, b: i64) -> i64 {
  if a < b {
    return b;
  }
  return a;
}

fn twice(x: u64) -> u64
  requires x < 100
{
  let y = add(x, x);
  return y;
}

fn main(con: &mut Serial) -> u64 {
  if between(twice(3), 1, 10) && pick(1, 2) == 2 {
    return sum_to(5);
  }
  return 0;
}
