// A loop that sets every byte of a range to one value is one `fill`
fn fill(b: &mut Bytes, v: u64, n: u64)
  requires n <= blen(b) && v <= 255
{
  let mut i = 0;
  while i < n
    invariant i <= n && n <= blen(b)
  {
    bset(&mut b, i, cast[u8](v));
    i = i + 1;
  }
}

fn main() -> u64 {
  let mut b = balloc(16);
  fill(&mut b, 7, 16);
  let r = bget(b, 15);
  bfree(b);
  return cast[u64](r);
}
