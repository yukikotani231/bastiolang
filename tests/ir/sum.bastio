fn fill(mut b: Buf) -> Buf
  requires len(b) <= 100000000
  ensures len(result) == len(b)
  ensures forall j: u64 :: j < len(result) ==> get(result, j) < 1000
{
  let mut i = 0;
  while i < len(b)
    invariant i <= len(b)
    invariant forall j: u64 :: j < i ==> get(b, j) < 1000
  {
    b = set(b, i, (i * 7 + 3) % 1000);
    i = i + 1;
  }
  return b;
}

fn sum(b: &Buf) -> u64
  requires len(b) <= 100000000
  requires forall j: u64 :: j < len(b) ==> get(b, j) < 1000
  ensures result <= len(b) * 1000
{
  let mut s = 0;
  let mut i = 0;
  while i < len(b)
    invariant i <= len(b)
    invariant s <= i * 1000
  {
    s = s + get(b, i);
    i = i + 1;
  }
  return s;
}

fn main() -> u64 {
  let b = fill(alloc(10000000));
  let mut t = 0;
  let mut r = 0;
  while r < 100
    invariant t < 1000000007 && len(b) == 10000000
    invariant forall j: u64 :: j < len(b) ==> get(b, j) < 1000
  {
    t = (t + sum(b)) % 1000000007;
    r = r + 1;
  }
  print(t);
  free(b);
  return 0;
}
