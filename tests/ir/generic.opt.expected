fn checked_div(v0, v1) {
  v2 = const 0
  v3 = eq v1, v2
  br v3, L0, L1
L0:
  v4 = const 1
  v5 = const 0
  ret v4, v5
L1:
L2:
  v6 = const 0
  v7 = const 0
  v8 = div v0, v1
  v7 = mov v8
  ret v6, v7
}
fn main() {
  v2 = const 7
  v3 = const 1
  v4, v5 = call swap(v2, v3)
  v7 = mov v5
  v8 = const 0
  v9 = mov v8
  br v4, L0, L1
L0:
  v9 = mov v7
  jmp L2
L1:
L2:
  v10 = const 30
  v11 = const 5
  v12, v13 = call checked_div(v10, v11)
  v14 = const 1
  v15 = call or_else(v12, v13, v14)
  v16 = add v15, v9
  ret v16
}
fn swap(v0, v1) {
  ret v1, v0
}
fn or_else(v0, v1, v2) {
  v5 = const 0
  v6 = eq v0, v5
  br v6, L2, L1
L2:
  ret v1
L1:
  ret v2
L0:
  ret
}
