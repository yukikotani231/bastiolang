fn checked_div(v0, v1) {
  v2 = const 0
  v3 = eq v1, v2
  br v3, L0, L1
L0:
  v4 = const 1
  v5 = const 0
  ret v4, v5
L1:
L2:
  v6 = const 0
  v8 = div v0, v1
  v7 = mov v8
  ret v6, v7
}
fn main() {
  v2 = const 7
  v3 = const 1
  v4, v5 = call swap(v2, v3)
  v7 = mov v5
  v8 = const 0
  br v4, L0, L1
L0:
  v8 = mov v7
  jmp L2
L1:
L2:
  v9 = const 30
  v10 = const 5
  v11, v12 = call checked_div(v9, v10)
  v13 = const 1
  v14 = call or_else(v11, v12, v13)
  v15 = add v14, v8
  ret v15
}
fn swap(v0, v1) {
  ret v1, v0
}
fn or_else(v0, v1, v2) {
  v5 = const 0
  v6 = eq v0, v5
  br v6, L2, L1
L2:
  ret v1
L1:
  ret v2
L0:
  ret
}
