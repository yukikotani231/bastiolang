// Buffers lent by `&mut` (stage1/ir.bastio): the callee gets the address of
// the buffer's two words (length, data), writes its bytes in place with
// `bset`, may replace it, and the caller reads it back after the call.
fn fill(b: &mut Bytes)
  requires blen(b) == 4
  ensures blen(b) == 4
{
  bset(&mut b, 0, 7);
  bset(&mut b, 3, 9);
}

fn outer(b: &mut Bytes)
  requires blen(b) == 4
  ensures blen(b) == 4
{
  fill(&mut b);
  bset(&mut b, 1, 5);
}

fn replace(b: &mut Buf) -> u64
  ensures result == len(old(b)) && len(b) == 3
{
  let old_len = len(b);
  free(b);
  b = alloc(3);
  return old_len;
}

fn main() -> u64 {
  let mut b = balloc(4);
  bset(&mut b, 2, 1);
  outer(&mut b);
  let r = wrap_add(wrap_add(bget(b, 0), bget(b, 1)), bget(b, 3));
  bfree(b);
  let mut x = alloc(9);
  let n = replace(&mut x);
  let m = len(x);
  free(x);
  print(cast[u64](r));
  return n - m;
}
