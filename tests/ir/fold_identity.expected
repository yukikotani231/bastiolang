fn idents(v0) {
  v1 = const 0
  v2 = add v0, v1
  v3 = const 0
  v4 = sub v2, v3
  v5 = const 1
  v6 = mul v4, v5
  v7 = const 0
  v8 = or v6, v7
  v9 = const 0
  v10 = xor v8, v9
  v11 = const 1
  v12 = div v10, v11
  v13 = const 0
  v14 = mul v12, v13
  v15 = const 0
  v16 = and v12, v15
  v17 = const 1
  v18 = rem v12, v17
  v19 = add v12, v14
  v20 = add v19, v16
  v21 = add v20, v18
  ret v21
}
fn consts() {
  v0 = const 3
  v1 = const 5
  v2 = const 0
  v3 = lt v0, v1
  br v3, L0, L1
L0:
  v4 = const 1
  v5 = add v2, v4
  v2 = mov v5
  jmp L2
L1:
L2:
  v6 = eq v0, v1
