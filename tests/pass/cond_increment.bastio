// expect-exit: 0
// expect-stdout: 5
// expect-stdout: 5
// expect-stdout: 6
// expect-stdout: 2
// expect-stdout: 1
// expect-stdout: 5
// expect-stdout: 2
// A counter bumped by a branch on a comparison: zeros in a buffer, values
// above and below a limit, and a counter that is also what it is tested
// against.
fn zeros(b: &Buf) -> u64
  requires len(b) <= 1000
  ensures result <= len(b)
{
  let mut c = 0;
  let mut i = 0;
  while i < len(b)
    invariant c <= i && i <= len(b)
  {
    if get(b, i) == 0 { c = c + 1; }
    i = i + 1;
  }
  return c;
}

fn above(b: &Buf, k: u64) -> u64
  requires len(b) <= 1000
  ensures result <= len(b)
{
  let mut c = 0;
  let mut i = 0;
  while i < len(b)
    invariant c <= i && i <= len(b)
  {
    if get(b, i) > k { c = c + 1; }
    i = i + 1;
  }
  return c;
}

fn below(b: &Buf, k: u64) -> u64
  requires len(b) <= 1000
  ensures result <= len(b)
{
  let mut c = 0;
  let mut i = 0;
  while i < len(b)
    invariant c <= i && i <= len(b)
  {
    if get(b, i) < k { c = c + 1; }
    i = i + 1;
  }
  return c;
}

fn steps(b: &Buf, up: bool) -> u64
  requires len(b) >= 1 && len(b) <= 1000
  ensures result <= len(b)
{
  let mut c = 0;
  let mut i = 1;
  while i < len(b)
    invariant c <= i && 1 <= i && i <= len(b)
  {
    if up {
      if get(b, i) > get(b, i - 1) { c = c + 1; }
    } else {
      if get(b, i) < get(b, i - 1) { c = c + 1; }
    }
    i = i + 1;
  }
  return c;
}

fn self_zero(n: u64) -> u64
  requires n <= 1000
  ensures result <= n + 1
{
  let mut c = 0;
  let mut i = 0;
  while i < n
    invariant c <= i + 1 && i <= n
  {
    if c == 0 { c = c + 1; }
    i = i + 1;
  }
  return c;
}

fn main() -> u64 {
  let mut b = alloc(8);
  let mut i = 0;
  while i < 8
    invariant len(b) == 8 && i <= 8
  {
    b = set(b, i, i % 3 * 10);
    i = i + 1;
  }
  print(zeros(b) + 2);
  print(above(b, 5));
  print(below(b, 15));
  print(self_zero(0) + 2);
  print(self_zero(7));
  print(steps(b, true));
  print(steps(b, false));
  free(b);
  return 0;
}
