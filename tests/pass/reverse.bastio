// expect-exit: 1
// In-place reverse with two indices. `j = n - 1 - i` needs the underflow
// proof `i < n`, and both indices are proved in bounds.

fn reverse(mut b: Buf) -> Buf
  ensures len(result) == len(b)
{
  let n = len(b);
  let mut i = 0;
  while i < n / 2
    invariant i <= n / 2
    invariant len(b) == n
  {
    let j = n - 1 - i;
    let x = get(b, i);
    let y = get(b, j);
    b = set(b, i, y);
    b = set(b, j, x);
    i = i + 1;
  }
  return b;
}

fn main() -> u64 {
  let a = alloc(4);
  let a1 = set(a, 0, 1);
  let a2 = set(a1, 3, 9);
  let r = reverse(a2);
  let ok = get(r, 0) == 9 && get(r, 3) == 1;
  free(r);
  if ok {
    return 1;
  }
  return 0;
}
