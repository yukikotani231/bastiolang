// expect-exit: 0
// expect-stdout: 2536
// expect-stdout: 11
// expect-stdout: 25
// expect-stdout: 5200
// expect-stdout: 1020
// Selects by an equality or a signed comparison: each a conditional move,
// with registers, memory and immediates as the arms.
fn lim(b0: u64, lo0: u64) -> u64 {
  let mut lo = lo0;
  if b0 == 244 {
    lo = 143;
  }
  return lo;
}

fn pick(a: i64, b: i64, x: u64, y: u64) -> u64 {
  let mut r = y;
  if a < b {
    r = x;
  }
  return r;
}

fn neq(a: u64, b: u64, x: u64, y: u64) -> u64 {
  if a != b {
    return wrap_add(x, 1);
  }
  return y;
}

fn main() -> u64 {
  let mut s = 0;
  let mut k = 0;
  while k < 300 {
    s = wrap_add(wrap_add(s, lim(k, 7)), k % 3);
    k = k + 1;
  }
  print(s % 100000);
  let m5: i64 = -5;
  let p3: i64 = 3;
  print(pick(m5, p3, 11, 25));
  print(pick(p3, m5, 11, 25));
  print(wrap_mul(neq(4, 5, 99, 1), 52));
  print(wrap_add(lim(244, 9), lim(1, 877)));
  return 0;
}
