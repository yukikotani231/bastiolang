// expect-exit: 0
// expect-stdout: 10100
// expect-stdout: 10103
// expect-stdout: 10105
// expect-stdout: 11005
// expect-stdout: 11005
// expect-stdout: 1
// expect-stdout: 5
// expect-stdout: 6
// expect-stdout: 7
// expect-stdout: 6
// A test after a loop that ended on a mismatch is decided by the loop's own
// test, which holds on that exit (`k < n` while `a[k] == b[k]`); on the exit
// where the loop's test failed it is not. Checked for `==`, `!=`, `<=`, `>`,
// with the counter written in between, and with a limit of zero.
fn common(a: &Bytes, b: &Bytes, n: u64) -> u64
  requires blen(a) == 16 && blen(b) == 16 && n <= 16
{
  let mut k = 0;
  while k < n && bget(a, k) == bget(b, k)
    invariant k <= n && n <= 16 && blen(a) == 16 && blen(b) == 16
  {
    k = k + 1;
  }
  let mut t = 0;
  if k == n {
    t = t + 1;
  }
  if k != n {
    t = t + 10;
  }
  if k <= n {
    t = t + 100;
  }
  if k > n {
    t = t + 1000;
  }
  return t * 100 + k;
}

fn bumped(a: &Bytes, b: &Bytes, n: u64) -> u64
  requires blen(a) == 16 && blen(b) == 16 && n <= 15
{
  let mut k = 0;
  while k < n && bget(a, k) == bget(b, k)
    invariant k <= n && n <= 15 && blen(a) == 16 && blen(b) == 16
  {
    k = k + 1;
  }
  k = k + 1;
  if k == n {
    return 7;
  }
  return k;
}

fn main() -> u64 {
  let mut a = balloc(16);
  let mut b = balloc(16);
  let mut i = 0;
  while i < 16
    invariant i <= 16 && blen(a) == 16 && blen(b) == 16
  {
    bset(&mut a, i, cast[u8](97 + i % 3));
    bset(&mut b, i, cast[u8](97 + i % 3));
    i = i + 1;
  }
  bset(&mut b, 5, 200);
  print(common(a, b, 0));
  print(common(a, b, 3));
  print(common(a, b, 5));
  print(common(a, b, 6));
  print(common(a, b, 16));
  print(bumped(a, b, 0));
  print(bumped(a, b, 4));
  print(bumped(a, b, 5));
  print(bumped(a, b, 6));
  print(bumped(a, b, 15));
  bfree(a);
  bfree(b);
  return 0;
}
