// expect-exit: 0
// expect-stdout: 3481
// expect-stdout: 886008
// Many values live across loops that read one of them often, so the
// register allocator keeps that value in the frame and copies it into a
// register around each loop; the result must not change.
fn mix(a: u64, b: u64) -> u64 {
  return wrap_add(wrap_mul(a, 3), b);
}

fn run(n: u64, k: u64) -> u64
  requires n <= 100
{
  let mut s0 = 0;
  let mut s1 = 1;
  let mut s2 = 2;
  let mut s3 = 3;
  let mut s4 = 4;
  let mut s5 = 5;
  let mut s6 = 6;
  let mut s7 = 7;
  let mut i = 0;
  while i < n
    invariant i <= n
  {
    s0 = wrap_add(s0, k);
    s1 = wrap_add(s1, k);
    s2 = wrap_add(s2, k);
    s3 = wrap_add(s3, k);
    s4 = wrap_add(s4, k);
    s5 = wrap_add(s5, k);
    i = i + 1;
  }
  let mut j = 0;
  while j < n
    invariant j <= n
  {
    s6 = mix(s6, k);
    s7 = mix(s7, k);
    s0 = wrap_add(s0, k);
    s1 = wrap_add(s1, k);
    j = j + 1;
  }
  let mut t = 0;
  while t < n
    invariant t <= n
  {
    s2 = wrap_add(s2, k);
    s3 = wrap_add(s3, k);
    s4 = wrap_add(s4, k);
    s5 = wrap_add(s5, k);
    s6 = wrap_add(s6, k);
    t = t + 1;
  }
  return wrap_add(wrap_add(wrap_add(s0, s1), wrap_add(s2, s3)), wrap_add(wrap_add(s4, s5), wrap_add(s6, s7)));
}

fn main() -> u64 {
  print(run(5, 1));
  print(run(10, 2));
  return 0;
}
