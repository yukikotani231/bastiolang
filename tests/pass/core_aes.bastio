// expect-exit: 0
// core/aes: AES-128 of the FIPS 197 examples (appendix B and C.1) and of 62 more blocks and keys,
// made by OpenSSL (Python's `cryptography`).
import "core/aes.bastio";

/// The value of the hex digit `c` (0 for anything else).
fn nib(c: u8) -> u8
  ensures result < 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 0;
}

/// The bytes written as hex digits in `s`.
fn unhex(s: Str) -> Bytes
  requires slen(s) < 100000
  ensures blen(result) == slen(s) / 2
{
  let n = slen(s) / 2;
  let mut b = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(b) == n && slen(s) >= 2 * n
  {
    bset(&mut b, i, nib(sget(s, 2 * i)) * 16 + nib(sget(s, 2 * i + 1)));
    i = i + 1;
  }
  return b;
}

/// 0 if AES-128 of `block` under `key` (hex) is `want` (hex), else 1.
fn check(key: Str, block: Str, want: Str) -> u64
  requires slen(key) == 32 && slen(block) == 32 && slen(want) == 32
  ensures result <= 1
{
  let k = unhex(key);
  let b = unhex(block);
  let w = unhex(want);
  let a = aes128_new(k);
  let out = aes128_encrypt(a, b);
  let mut bad = 1;
  if bytes_eq(out, w) { bad = 0; }
  bfree(out);
  aes128_free(a);
  bfree(w);
  bfree(b);
  bfree(k);
  return bad;
}

fn group0() -> u64
  ensures result <= 8
{
  return check("000102030405060708090a0b0c0d0e0f", "00112233445566778899aabbccddeeff", "69c4e0d86a7b0430d8cdb78070b4c55a") + check("00000000000000000000000000000000", "00000000000000000000000000000000", "66e94bd4ef8a2c3b884cfa59ca342b2e") + check("ffffffffffffffffffffffffffffffff", "ffffffffffffffffffffffffffffffff", "bcbf217cb280cf30b2517052193ab979") + check("2b7e151628aed2a6abf7158809cf4f3c", "3243f6a8885a308d313198a2e0370734", "3925841d02dc09fbdc118597196a0b32") + check("a407367b4867cabc6116e34551a45c7a", "80225ad9ac57e26a454af32acaa9991f", "45db38d170d48788a3010c43213fae56") + check("717695c3f1b40d0eb4dbd0fea32579c4", "a1390e8d681990fb4827bd43cf6aa9f1", "ab86788ec23eef7ca058bced56a22de5") + check("327bad7c56af663db3ccbdd6cc698cd1", "b63561f5c92125c493a42e82136b099c", "56ba6b4ca655d314b69d09383f81ce76") + check("523c4c4b8d590dfa93894de273c6b782", "df73f3c899aaf9f61ced95fbb4170e35", "98f0f6c69797ef1d89d9282b0e4dd3a4");
}

