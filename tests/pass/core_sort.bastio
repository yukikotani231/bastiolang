// expect-exit: 0
// core/sort.bastio: sorting is proved to give an ascending permutation of
// its input, so the binary search after it needs no check that its input
// is sorted, and an element pushed before the sort is still there.
import "core/sort.bastio";
import "core/hashmap.bastio";

fn main() -> u64 {
  let mut v = vec_new[u64]();
  let mut i = 0;
  while i < 300
    invariant i <= 300
  {
    vec_push(&mut v, hash_u64(i) % 1000);
    i = i + 1;
  }
  vec_push(&mut v, 500);
  sort_u64(&mut v);
  assert vcount(v, 500) >= 1;
  assert !(forall k: u64 :: k < vlen(v) ==> vget(v, k) != 500);
  let n = vec_len(v);
  let mut ok = n == 301 && sorted_contains_u64(v, 500) && vec_contains_u64(v, 500);
  let at = lower_bound_u64(v, 500);
  ok = ok && at < n && vec_get(v, at) == 500;
  ok = ok && !sorted_contains_u64(v, 1000) && lower_bound_u64(v, 1000) == n;
  // Checked again by hand: the proof says so too.
  let mut j = 1;
  while j < vec_len(v)
    invariant j >= 1
  {
    if vec_get(v, j - 1) > vec_get(v, j) { ok = false; }
    j = j + 1;
  }
  vec_free(v);
  let mut e = vec_new[u64]();
  sort_u64(&mut e);
  ok = ok && lower_bound_u64(e, 3) == 0;
  vec_free(e);
  if ok { return 0; }
  return 1;
}
