// expect-exit: 0
// expect-stdout: 625
// expect-stdout: 1250
// expect-stdout: 1024
// expect-stdout: 1977
// A frame addressed from the stack pointer, with %rbp free to hold a value:
// calls that pass most of their arguments on the stack, values that live
// across them (more than the registers hold) and a struct kept in the frame.
fn mix(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64) -> u64 {
  return wrap_add(wrap_mul(a, 1), wrap_add(wrap_mul(b, 2), wrap_add(wrap_mul(c, 3), wrap_add(wrap_mul(d, 4), wrap_add(wrap_mul(e, 5), wrap_add(wrap_mul(f, 6), wrap_add(wrap_mul(g, 7), wrap_mul(h, 8))))))));
}

fn many(n: u64) -> u64
  requires n < 1000
{
  let a = n + 1;
  let b = n + 2;
  let c = n + 3;
  let d = n + 4;
  let e = n + 5;
  let f = n + 6;
  let g = n + 7;
  let h = n + 8;
  let i = n + 9;
  let j = n + 10;
  let x = mix(a, b, c, d, e, f, g, h);
  let y = mix(h, g, f, e, d, c, b, a);
  return wrap_add(wrap_add(x, y), wrap_add(wrap_add(wrap_add(a, b), wrap_add(c, d)), wrap_add(wrap_add(e, f), wrap_add(wrap_add(g, h), wrap_add(i, j)))));
}

struct Q { a: u64, b: u64, c: u64, d: u64 }

fn qsum(q: &Q, n: u64) -> u64 {
  return mix(q.a, q.b, q.c, q.d, n, n, n, n);
}

fn table(n: u64) -> u64
  requires n < 1000
{
  let mut q = Q { a: n, b: n + 1, c: n + 2, d: n + 3 };
  let mut k = 0;
  let mut s = 0;
  while k < 8 {
    s = wrap_add(s, qsum(q, k));
    q.a = wrap_add(q.a, k);
    k = k + 1;
  }
  return s;
}

// Parameters kept in the stack words they arrived in, written by the callee.
fn bump(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64) -> u64 {
  let mut k = 0;
  let mut x = a;
  let mut y = h;
  while k < 5 {
    x = wrap_add(x, mix(k, b, c, d, e, f, g, y));
    y = wrap_add(y, x % 7);
    k = k + 1;
  }
  return wrap_add(x, y);
}

fn main() -> u64 {
  print(many(3));
  print(wrap_mul(many(3), 2));
  print(table(1));
  print(wrap_add(bump(1, 2, 3, 4, 5, 6, 7, 8), bump(8, 7, 6, 5, 4, 3, 2, 1)));
  return 0;
}
