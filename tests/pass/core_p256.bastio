// expect-exit: 0
// core/p256: signatures made by Python's `cryptography` (OpenSSL) under P-256 and
// SHA-256 verify (messages of 1 to 1000 bytes, short r and s among them); a signature,
// key or message with bits changed, a key that is not on the curve, an r or s of 0 or
// of n, and encodings that are not minimal DER are refused.
import "core/p256.bastio";

/// The value of the hex digit `c` (0 for anything else).
fn nib(c: u8) -> u8
  ensures result < 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 0;
}

/// The bytes written as hex digits in `s`.
fn unhex(s: Str) -> Bytes
  requires slen(s) < 100000
  ensures blen(result) == slen(s) / 2
{
  let n = slen(s) / 2;
  let mut b = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(b) == n && slen(s) >= 2 * n
  {
    bset(&mut b, i, nib(sget(s, 2 * i)) * 16 + nib(sget(s, 2 * i + 1)));
    i = i + 1;
  }
  return b;
}

/// 1 unless the signature `sig` of `msg` under `pubkey` (all in hex) verifies.
fn good(pubkey: Str, msg: Str, sig: Str) -> u64
  requires slen(pubkey) == 130 && slen(msg) < 100000 && slen(sig) < 40000
  ensures result <= 1
{
  let p = unhex(pubkey);
  let m = unhex(msg);
  let s = unhex(sig);
  let ok = ecdsa_p256_verify(p, m, s);
  bfree(s);
  bfree(m);
  bfree(p);
  if ok { return 0; }
  return 1;
}

/// 1 if the signature verifies although it should not.
fn bad(pubkey: Str, msg: Str, sig: Str) -> u64
  requires slen(pubkey) == 130 && slen(msg) < 100000 && slen(sig) < 40000
  ensures result <= 1
{
  return 1 - good(pubkey, msg, sig);
}

/// `b` with bit `i` toggled.
fn flip(b: &mut Bytes, i: u64)
  requires i / 8 < blen(b)
  ensures blen(b) == blen(old(b))
{
  let mask = cast[u8](1 << (i % 8));
  bset(&mut b, i / 8, bget(b, i / 8) ^ mask);
}

/// The number of one-bit changes (every 5-th bit) of the signature that still verify.
fn tamper_sig(pubkey: Str, msg: Str, sig: Str) -> u64
  requires slen(pubkey) == 130 && slen(msg) < 100000 && slen(sig) < 400
  ensures result <= 2000
{
  let p = unhex(pubkey);
  let m = unhex(msg);
  let mut s = unhex(sig);
  let mut n = 0;
  let mut i = 0;
  while i < 8 * blen(s)
    invariant i <= 8 * blen(s) + 5 && blen(s) == slen(sig) / 2 && blen(s) < 200 && blen(p) == 65 && blen(m) < 100000 && n <= i
  {
    flip(&mut s, i);
    if ecdsa_p256_verify(p, m, s) { n = n + 1; }
    flip(&mut s, i);
    i = i + 5;
  }
  bfree(s);
  bfree(m);
  bfree(p);
  return n;
}

/// The number of one-bit changes of the key (every 5-th bit after the first byte) that still verify.
fn tamper_key(pubkey: Str, msg: Str, sig: Str) -> u64
  requires slen(pubkey) == 130 && slen(msg) < 100000 && slen(sig) < 400
  ensures result <= 2000
{
  let mut p = unhex(pubkey);
  let m = unhex(msg);
  let s = unhex(sig);
  let mut n = 0;
  let mut i = 0;
  while i < 520
    invariant i <= 520 + 5 && blen(p) == 65 && blen(s) < 200 && blen(m) < 100000 && n <= i
  {
    flip(&mut p, i);
    if ecdsa_p256_verify(p, m, s) { n = n + 1; }
    flip(&mut p, i);
    i = i + 5;
  }
  bfree(s);
  bfree(m);
  bfree(p);
  return n;
}

/// The number of one-bit changes of the first byte of the message that still verify.
fn tamper_msg(pubkey: Str, msg: Str, sig: Str) -> u64
  requires slen(pubkey) == 130 && slen(msg) >= 2 && slen(msg) < 100000 && slen(sig) < 400
  ensures result <= 8
{
  let p = unhex(pubkey);
  let mut m = unhex(msg);
  let s = unhex(sig);
  let mut n = 0;
  let mut i = 0;
  while i < 8
    invariant i <= 8 && blen(p) == 65 && blen(s) < 200 && blen(m) >= 1 && blen(m) < 100000 && n <= i
  {
    flip(&mut m, i);
    if ecdsa_p256_verify(p, m, s) { n = n + 1; }
    flip(&mut m, i);
    i = i + 1;
  }
  bfree(s);
  bfree(m);
  bfree(p);
  return n;
}

