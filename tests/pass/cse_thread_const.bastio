// expect-exit: 0
// expect-stdout: 3
// expect-stdout: 2
// expect-stdout: 3
// A test whose first compare is decided (va < 0 never holds) is skipped by
// an edge into it; the constant 1 it sets for the second compare of the
// inlined range check must still be set on that path.
const BASE: u64 = 0;
const SIZE: u64 = 549755813888;

fn in_range(va: u64, n: u64) -> bool {
  if va < BASE || va - BASE > SIZE {
    return false;
  }
  return n <= SIZE - (va - BASE);
}

fn rd(n: u64, va: u64, w: u64) -> u64 {
  let s0 = wrap_add(w, 123456789123);
  let s1 = wrap_add(w, 124456789130);
  let s2 = wrap_add(w, 125456789137);
  let s3 = wrap_add(w, 126456789144);
  let t = wrap_add(wrap_add(wrap_add(s0, wrap_mul(s1, 4)), wrap_mul(s2, 5)), wrap_mul(s3, 6));
  if t == 5 {
    return 9;
  }
  if n == 0 {
    return 1;
  }
  if !in_range(va, 1) {
    return 2;
  }
  return 3;
}
fn main() -> u64 {
  print(rd(1, 549755813887, 99999999));
  print(rd(1, 549755813888, 99999999));
  print(rd(1, 549755813885, 99999999));
  return 0;
}
