// expect-exit: 0
// expect-stdout: 4095
// expect-stdout: 228
// expect-stdout: 56
// A counter whose next value the loop body already computed (`x + 1` for a
// neighbour, then `x = x + 1`) steps in place on native-ir, and `v = 1 or 0` by
// a condition is the condition itself: a count of neighbours in a ring, a
// flag counted in a loop, and a flag whose arms are not 1 and 0.
fn ring(n: u64) -> u64
  requires n == 64
{
  let mut sum = 0;
  let mut x = 0;
  while x < 64
    invariant x <= 64 && sum <= 128 * x
  {
    let lf = (x + 63) % 64;
    let rt = (x + 1) % 64;
    sum = sum + lf + rt + x % 3;
    x = x + 1;
  }
  return sum;
}

fn flags(n: u64) -> u64
  requires n <= 1000
{
  let mut live = 0;
  let mut i = 0;
  while i < n
    invariant i <= n && n <= 1000 && live <= i
  {
    let mut v = 0;
    if i % 7 == 3 || (i % 5 == 2 && i % 2 == 1) {
      v = 1;
    }
    live = live + v;
    i = i + 1;
  }
  return live;
}

fn other(n: u64) -> u64
  requires n <= 1000
{
  let mut t = 0;
  let mut i = 0;
  while i < n
    invariant i <= n && n <= 1000 && t <= 7 * i
  {
    let mut v = 5;
    if i % 4 == 1 {
      v = 7;
    }
    t = t + v % 8;
    i = i + 1;
  }
  return t % 100;
}

fn main() -> u64 {
  print(ring(64));
  print(flags(1000));
  print(other(10));
  return 0;
}
