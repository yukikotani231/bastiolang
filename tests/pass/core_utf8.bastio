// expect-exit: 0
// utf8_valid and utf8_seq_len on the boundary of every form in RFC 3629.
import "core/utf8.bastio";

/// 1 unless `utf8_valid` says `want` for the bytes `a`, `b`, `c`, `d` (the first `n`).
fn expect(n: u64, a: u8, b: u8, c: u8, d: u8, want: bool) -> u64
  requires 1 <= n && n <= 4
  ensures result <= 1
{
  let mut s = balloc(n);
  bset(&mut s, 0, a);
  if n > 1 { bset(&mut s, 1, b); }
  if n > 2 { bset(&mut s, 2, c); }
  if n > 3 { bset(&mut s, 3, d); }
  let got = utf8_valid(s);
  let mut ok = got == want;
  match utf8_count(s) {
    Option::Some(k) => { ok = ok && want && k == 1; },
    Option::None => { ok = ok && !want; },
  }
  bfree(s);
  if ok { return 0; }
  return 1;
}

fn main() -> u64 {
  let mut bad = 0;
  // Valid.
  bad = bad + expect(1, 127, 0, 0, 0, true);
  bad = bad + expect(2, 194, 128, 0, 0, true);
  bad = bad + expect(2, 223, 191, 0, 0, true);
  bad = bad + expect(3, 224, 160, 128, 0, true);
  bad = bad + expect(3, 224, 191, 191, 0, true);
  bad = bad + expect(3, 237, 159, 191, 0, true);
  bad = bad + expect(3, 238, 128, 128, 0, true);
  bad = bad + expect(3, 239, 191, 191, 0, true);
  bad = bad + expect(4, 240, 144, 128, 128, true);
  bad = bad + expect(4, 244, 143, 191, 191, true);
  bad = bad + expect(4, 241, 128, 128, 128, true);
  // Invalid.
  bad = bad + expect(1, 128, 0, 0, 0, false);
  bad = bad + expect(1, 191, 0, 0, 0, false);
  bad = bad + expect(2, 192, 128, 0, 0, false);
  bad = bad + expect(2, 193, 191, 0, 0, false);
  bad = bad + expect(1, 194, 0, 0, 0, false);
  bad = bad + expect(2, 194, 65, 0, 0, false);
  bad = bad + expect(3, 224, 159, 191, 0, false);
  bad = bad + expect(3, 237, 160, 128, 0, false);
  bad = bad + expect(3, 237, 191, 191, 0, false);
  bad = bad + expect(2, 226, 130, 0, 0, false);
  bad = bad + expect(3, 226, 40, 161, 0, false);
  bad = bad + expect(4, 240, 143, 191, 191, false);
  bad = bad + expect(4, 244, 144, 128, 128, false);
  bad = bad + expect(4, 245, 128, 128, 128, false);
  bad = bad + expect(3, 240, 159, 152, 0, false);
  bad = bad + expect(1, 255, 0, 0, 0, false);
  bad = bad + expect(2, 195, 40, 0, 0, false);
  // Mixed text: a bad byte after good ones, and the empty string.
  let mixed = bfrom("ok é €");
  let mut good = utf8_valid(mixed);
  bfree(mixed);
  let empty = balloc(0);
  good = good && utf8_valid(empty);
  bfree(empty);
  if !good { bad = bad + 1; }
  if bad != 0 { return 1; }
  return 0;
}
