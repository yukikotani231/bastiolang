// expect-exit: 0
// expect-stdout: 534008
// expect-stdout: 1024
// expect-stdout: 1207
// A select by an unsigned comparison of two registers: each arm a different
// register, one of them the result's own, constants, and values kept in the
// frame by a loop that needs more registers than the machine has.
fn max_of(a: u64, b: u64) -> u64
  requires a < 1000 && b < 1000
  ensures result < 1000
{
  let mut r = b;
  if a > b { r = a; }
  return r;
}

fn min_of(a: u64, b: u64) -> u64
  requires a < 1000 && b < 1000
  ensures result < 1000
{
  let mut r = a;
  if b < a { r = b; }
  return r;
}

fn pick(a: u64, b: u64, c: u64, d: u64) -> u64
  requires c < 1000 && d < 1000
  ensures result < 1000
{
  let mut r = 0;
  if a < b { r = c; } else { r = d; }
  return r;
}

fn pick_const(a: u64, b: u64, c: u64) -> u64
  requires c < 1000
  ensures result < 1000
{
  let mut r = 0;
  if a > b { r = c; } else { r = 77; }
  return r;
}

fn many(n: u64) -> u64
  requires n <= 1000
{
  let mut a = 1;
  let mut b = 2;
  let mut c = 3;
  let mut d = 4;
  let mut e = 5;
  let mut f = 6;
  let mut g = 7;
  let mut h = 8;
  let mut i = 0;
  let mut s = 0;
  while i < n
    invariant i <= n && n <= 1000 && a < 1000 && b < 1000 && c < 1000 && d < 1000 && e < 1000 && f < 1000 && g < 1000 && h < 1000
  {
    let x = max_of(a * 3 % 1000, b * 5 % 1000);
    let y = min_of(c * 7 % 1000, d * 11 % 1000);
    let z = pick(e, f, g, h);
    a = (b + x) % 1000;
    b = (c + y) % 1000;
    c = (d + z) % 1000;
    d = (e + x + y) % 1000;
    e = (f + i) % 1000;
    f = (g + y) % 1000;
    g = (h + x) % 1000;
    h = (a + b + z) % 1000;
    s = wrap_add(s, wrap_add(wrap_add(x, y), wrap_add(z, pick_const(a, b, c))));
    i = i + 1;
  }
  return s;
}

fn main() -> u64 {
  print(many(300));
  print(wrap_add(max_of(999, 7), min_of(900, 25)));
  print(wrap_add(pick(1, 2, 3, 4), wrap_add(pick(2, 1, 3, 4), wrap_add(pick_const(9, 3, 100), 1100))));
  return 0;
}
