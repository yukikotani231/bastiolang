// stage1-only: 64-bit constants are moved out of loops (stage1/iropt.bastio, iropt_wide).
// expect-exit: 0
// expect-stdout: 172303625
// expect-stdout: 77
// A constant that needs a 64-bit move, read in a loop, is made once in front
// of the outermost loop with a single way in. Here: a nested loop, a loop
// entered from a branch, a constant read only on one arm, and a power of two
// (which stays an immediate).
fn mix(n: u64, seed: u64) -> u64 {
  let mut h = seed;
  let mut i = 0;
  while i < n {
    let mut j = 0;
    while j < 3 {
      h = wrap_mul(h ^ i, 11400714819323198485);
      h = wrap_add(h, j);
      j = wrap_add(j, 1);
    }
    if i % 2 == 0 {
      h = h ^ 6364136223846793005;
    }
    h = h % 4294967296;
    i = wrap_add(i, 1);
  }
  return h;
}

fn main() -> u64 {
  let a = mix(1000, 12345);
  let b = mix(0, 77);
  print(a);
  print(b);
  return 0;
}
