// expect-exit: 0
// expect-stdout: 22
// expect-stdout: 3
// expect-stdout: 6
// A word that only a comparison with a register reads, and then the branch,
// is compared in memory. The load may be either operand of the comparison,
// and the comparison may be signed or unsigned.
fn count_eq(b: &Buf, k: u64) -> u64
  requires len(b) == 16
  ensures result <= 16
{
  let mut c = 0;
  let mut i = 0;
  while i < 16
    invariant i <= 16 && len(b) == 16 && c <= i
  {
    if get(b, i) == k { c = c + 1; }
    i = i + 1;
  }
  return c;
}

fn count_below(b: &Buf, k: u64) -> u64
  requires len(b) == 16
  ensures result <= 16
{
  let mut c = 0;
  let mut i = 0;
  while i < 16
    invariant i <= 16 && len(b) == 16 && c <= i
  {
    if k > get(b, i) { c = c + 1; }
    i = i + 1;
  }
  return c;
}

fn count_above(b: &Buf, k: u64) -> u64
  requires len(b) == 16
  ensures result <= 16
{
  let mut c = 0;
  let mut i = 0;
  while i < 16
    invariant i <= 16 && len(b) == 16 && c <= i
  {
    if get(b, i) > k { c = c + 1; }
    i = i + 1;
  }
  return c;
}

fn main() -> u64 {
  let mut b = alloc(16);
  let mut i = 0;
  while i < 16
    invariant i <= 16 && len(b) == 16
  {
    b = set(b, i, i % 5);
    i = i + 1;
  }
  print(count_below(b, 3) + count_eq(b, 4) + count_above(b, 2) + 3);
  print(count_eq(b, 4));
  print(count_above(b, 2));
  free(b);
  return 0;
}
