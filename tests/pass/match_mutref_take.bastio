// expect-exit: 0
// A match on an enum behind `&mut` whose arm overwrites the enum and then
// returns what the arm bound: the binding must hold the old payload, not
// the words the assignment left in the enum. The payload is large enough
// that the backend keeps it in memory.
struct Big { f00: u64, f01: u64, f02: u64, f03: u64, f04: u64, f05: u64, f06: u64, f07: u64, f08: u64, f09: u64, f10: u64, f11: u64, f12: u64, f13: u64, f14: u64, f15: u64, f16: u64, f17: u64, f18: u64, f19: u64, f20: u64, f21: u64, f22: u64, f23: u64, f24: u64, f25: u64, f26: u64, f27: u64, f28: u64, f29: u64, f30: u64, f31: u64, f32: u64, f33: u64, f34: u64, f35: u64, f36: u64, f37: u64, f38: u64, f39: u64, f40: u64, f41: u64, f42: u64, f43: u64, f44: u64, f45: u64, f46: u64, f47: u64, f48: u64, f49: u64, f50: u64, f51: u64, f52: u64, f53: u64, f54: u64, f55: u64, f56: u64, f57: u64, f58: u64, f59: u64, f60: u64, f61: u64, f62: u64, f63: u64, f64: u64, f65: u64, f66: u64, f67: u64, f68: u64, f69: u64 }
enum Slot { Empty, Full(Big) }
enum Out { None, Got(Big) }

fn take(s: &mut Slot) -> Out {
  match s {
    Slot::Full(x) => {
      s = Slot::Empty;
      return Out::Got(x);
    },
    Slot::Empty => { s = Slot::Empty; },
  }
  return Out::None;
}

fn main() -> u64 {
  let mut s = Slot::Full(Big { f00: 1, f01: 2, f02: 3, f03: 4, f04: 5, f05: 6, f06: 7, f07: 8, f08: 9, f09: 10, f10: 11, f11: 12, f12: 13, f13: 14, f14: 15, f15: 16, f16: 17, f17: 18, f18: 19, f19: 20, f20: 21, f21: 22, f22: 23, f23: 24, f24: 25, f25: 26, f26: 27, f27: 28, f28: 29, f29: 30, f30: 31, f31: 32, f32: 33, f33: 34, f34: 35, f35: 36, f36: 37, f37: 38, f38: 39, f39: 40, f40: 41, f41: 42, f42: 43, f43: 44, f44: 45, f45: 46, f46: 47, f47: 48, f48: 49, f49: 50, f50: 51, f51: 52, f52: 53, f53: 54, f54: 55, f55: 56, f56: 57, f57: 58, f58: 59, f59: 60, f60: 61, f61: 62, f62: 63, f63: 64, f64: 65, f65: 66, f66: 67, f67: 68, f68: 69, f69: 70 });
  let o = take(&mut s);
  let mut r = 0;
  match o {
    Out::Got(x) => {
      if x.f00 != 1 || x.f01 != 2 || x.f02 != 3 || x.f03 != 4 || x.f04 != 5 || x.f05 != 6 || x.f06 != 7 || x.f07 != 8 || x.f08 != 9 || x.f09 != 10 || x.f10 != 11 || x.f11 != 12 || x.f12 != 13 || x.f13 != 14 || x.f14 != 15 || x.f15 != 16 || x.f16 != 17 || x.f17 != 18 || x.f18 != 19 || x.f19 != 20 || x.f20 != 21 || x.f21 != 22 || x.f22 != 23 || x.f23 != 24 || x.f24 != 25 || x.f25 != 26 || x.f26 != 27 || x.f27 != 28 || x.f28 != 29 || x.f29 != 30 || x.f30 != 31 || x.f31 != 32 || x.f32 != 33 || x.f33 != 34 || x.f34 != 35 || x.f35 != 36 || x.f36 != 37 || x.f37 != 38 || x.f38 != 39 || x.f39 != 40 || x.f40 != 41 || x.f41 != 42 || x.f42 != 43 || x.f43 != 44 || x.f44 != 45 || x.f45 != 46 || x.f46 != 47 || x.f47 != 48 || x.f48 != 49 || x.f49 != 50 || x.f50 != 51 || x.f51 != 52 || x.f52 != 53 || x.f53 != 54 || x.f54 != 55 || x.f55 != 56 || x.f56 != 57 || x.f57 != 58 || x.f58 != 59 || x.f59 != 60 || x.f60 != 61 || x.f61 != 62 || x.f62 != 63 || x.f63 != 64 || x.f64 != 65 || x.f65 != 66 || x.f66 != 67 || x.f67 != 68 || x.f68 != 69 || x.f69 != 70 {
        r = 1;
      }
    },
    Out::None => { r = 2; },
  }
  match s {
    Slot::Empty => {},
    Slot::Full(y) => { r = 3; },
  }
  return r;
}
