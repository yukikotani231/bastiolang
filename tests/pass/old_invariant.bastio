// expect-exit: 0
// `old(x)` in a loop invariant: the value parameter `x` had at the call,
// so a loop can say what it leaves alone.
fn append(t: &mut Vec[u64], n: u64)
  requires n <= 100
  ensures vlen(t) == vlen(old(t)) + n
  ensures forall k: u64 :: k < vlen(old(t)) ==> vget(t, k) == vget(old(t), k)
{
  let mut i = 0;
  while i < n
    invariant i <= n && vlen(t) == vlen(old(t)) + i
    invariant forall k: u64 :: k < vlen(old(t)) ==> vget(t, k) == vget(old(t), k)
  {
    vec_push(&mut t, i);
    i = i + 1;
  }
}

fn clear_from(b: &mut Bytes, from: u64)
  requires from <= blen(b)
  ensures blen(b) == blen(old(b))
  ensures forall k: u64 :: k < from ==> bget(b, k) == bget(old(b), k)
{
  let mut i = from;
  while i < blen(b)
    invariant from <= i && i <= blen(b)
    invariant forall k: u64 :: k < from ==> bget(b, k) == bget(old(b), k)
  {
    bset(&mut b, i, 0);
    i = i + 1;
  }
}

fn main() -> u64 {
  let mut v = vec_new[u64]();
  vec_push(&mut v, 42);
  append(&mut v, 5);
  let first = vec_get(v, 0);
  assert first == 42;                    // proved through the invariant
  vec_free(v);
  let mut b = bfrom("abc");
  clear_from(&mut b, 1);
  let a = bget(b, 0);
  assert a == 97;
  bfree(b);
  return 0;
}
