// expect-exit: 3
// A page the program may not touch is still owned by its table: hiding it
// and showing it again changes nothing the proof tracks, and it is taken
// out and given back as before.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 2 {
    return 3;
  }
  let mut t = pt_new(pool_take(&mut pool, 0), 1);
  pt_put_frame(&mut t, 3, pool_take(&mut pool, 1), true);
  pt_set_access(&mut t, 3, 0);
  let mut r = 0;
  if pt_has(t, 3) && !pt_accessible(t, 3) && !pt_writable(t, 3) {
    r = r + 1;
  }
  pt_set_access(&mut t, 3, 1);
  if pt_accessible(t, 3) && !pt_writable(t, 3) {
    r = r + 1;
  }
  pt_set_access(&mut t, 3, 2);
  if pt_accessible(t, 3) && pt_writable(t, 3) {
    r = r + 1;
  }
  pt_set_access(&mut t, 3, 0);
  pool_give(&mut pool, pt_take_frame(&mut t, 3));
  pool_give(&mut pool, pt_free(t));
  return r;
}
