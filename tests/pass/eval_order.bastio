// expect-exit: 0
// Operands run left to right, as the verifier assumes. C leaves the order
// of call arguments, operator operands and initializers unspecified, so the
// generated C evaluates them into temporaries in this order. Each of the
// first three lines below reads `b` and then changes it in a later operand:
// the read must see the old value. (Before the fix, gcc ran `bump` first in `pair`, and with
// a function that shrank `b` instead, `get` read past the end of it.)

struct P { x: u64, y: u64 }

fn bump(b: &mut Buf) -> u64
  requires len(b) == 1 && get(b, 0) < 100
  ensures len(b) == 1 && get(b, 0) == old(get(b, 0)) + 1 && result == 0
{
  let v = get(b, 0);
  b = set(b, 0, v + 1);
  return 0;
}

fn pair(a: u64, z: u64) -> u64
  ensures result == a
{
  return a;
}

fn take(b: Buf, z: u64) -> u64
  requires len(b) == 1
{
  let v = get(b, 0);
  free(b);
  return v;
}

fn main() -> u64 {
  let mut b = alloc(1);
  let r1 = pair(get(b, 0), bump(&mut b));
  assert r1 == 0;
  let r2 = get(b, 0) + bump(&mut b);
  assert r2 == 1;
  let p = P { x: get(b, 0), y: bump(&mut b) };
  assert p.x == 2;
  // A linear value passed by name is read after the other arguments have
  // run, so `take` gets `b` as `bump` left it.
  let s = take(b, bump(&mut b));
  if s == 4 {
    return 0;
  }
  return 1;
}
