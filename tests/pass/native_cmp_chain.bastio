// native backend: a long `n == A || n == B || ..` is a binary search
// expect-exit: 0
// expect-stdout: 16
// expect-stdout: 7
// expect-stdout: 3
// The chain of equality tests against constants below compiles to a run of
// `cmpq $N, %reg` / `je L` pairs; the native backend replaces a run of six
// or more with a search that halves the candidates at each step. Every value
// from 0 to 99 is tried, the members and the gaps between and around them.
// `rare` repeats a constant and lists them out of order; `small` is below the
// limit and stays a chain.
fn hit(n: u64) -> bool {
  return n == 76 || n == 77 || n == 17 || n == 18 || n == 24 || n == 25 || n == 11 || n == 10
    || n == 26 || n == 28 || n == 74 || n == 75 || n == 90 || n == 91 || n == 92 || n == 0;
}

fn rare(n: u64) -> bool {
  return n == 50 || n == 40 || n == 50 || n == 30 || n == 20 || n == 10 || n == 99 || n == 5;
}

fn small(n: u64) -> bool {
  return n == 3 || n == 4 || n == 5;
}

fn main() -> u64 {
  let mut a = 0;
  let mut b = 0;
  let mut c = 0;
  let mut n = 0;
  while n < 100
    invariant n <= 100 && a <= n && b <= n && c <= n
  {
    if hit(n) {
      a = a + 1;
    }
    if rare(n) {
      b = b + 1;
    }
    if small(n) {
      c = c + 1;
    }
    n = n + 1;
  }
  print(a);
  print(b);
  print(c);
  return 0;
}
