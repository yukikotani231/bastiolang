// expect-exit: 0
// expect-stdout: 731119185
// Division and remainder by constants, over numbers spread across the whole
// u64 range (the native backend replaces them with multiplications).
fn mix(t: u64, x: u64) -> u64
  requires t < 1000000007
  ensures result < 1000000007
{
  return (t + x % 1000000007) % 1000000007;
}

fn main() -> u64 {
  let mut t = 0;
  let mut i = 0;
  while i < 100000
    invariant t < 1000000007 && i <= 100000
  {
    let n = 18446744073709551615 - i * 184467440737095;
    t = mix(t, n / 3);  t = mix(t, n % 3);
    t = mix(t, n / 7);  t = mix(t, n % 7);
    t = mix(t, n / 10); t = mix(t, n % 10);
    t = mix(t, n / 24); t = mix(t, n % 24);
    t = mix(t, n / 641); t = mix(t, n % 641);
    t = mix(t, n / 1000); t = mix(t, n % 1000);
    t = mix(t, n / 1000000); t = mix(t, n % 1000000);
    t = mix(t, n / 1000000007); t = mix(t, n % 1000000007);
    t = mix(t, n / 6700417); t = mix(t, n % 6700417);
    t = mix(t, n / 12345678901234); t = mix(t, n % 12345678901234);
    t = mix(t, n / 9223372036854775807); t = mix(t, n % 9223372036854775807);
    t = mix(t, n / 4611686018427387905); t = mix(t, n % 4611686018427387905);
    t = mix(t, n / 65536); t = mix(t, n % 65536);
    i = i + 1;
  }
  print(t);
  return 0;
}
