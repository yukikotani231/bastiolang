// expect-exit: 7
// A function whose name starts with `vec_` is an ordinary function, not a
// Vec builtin (stage0's code generator once dispatched on the prefix).

fn vec_total(v: &Vec[u64]) -> u64
  requires vlen(v) == 2 && vget(v, 0) <= 10 && vget(v, 1) <= 10
{
  return vec_get(v, 0) + vec_get(v, 1);
}

fn main() -> u64 {
  let mut v = vec_new[u64]();
  vec_push(&mut v, 3);
  vec_push(&mut v, 4);
  let t = vec_total(v);
  vec_pop(&mut v);
  vec_pop(&mut v);
  vec_free(v);
  return t;
}
