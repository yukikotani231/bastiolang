// expect-exit: 3
// A loop that changes a variable forgets its value but keeps its type's
// range: a u8 stays at most 255 and an i64 may be negative, with no
// invariant needed to say so.
fn last_plus_one(b: &Bytes) -> u64 {
  let mut last: u8 = 0;
  let mut i = 0;
  while i < blen(b)
    invariant i <= blen(b)
  {
    last = bget(b, i);
    i = i + 1;
  }
  return 300 - cast[u64](last);          // proved: last <= 255
}

fn main() -> u64 {
  let mut x: i64 = 0;
  let mut i: i64 = 0;
  while i < 3
    invariant i >= 0 && i <= 3 && x + i == 0
  {
    x = x - 1;
    i = i + 1;
  }
  assert x == -3;
  let b = balloc(2);
  let r = last_plus_one(b);
  bfree(b);
  if r == 300 {
    return cast[u64](-x);
  }
  return 100;
}
