// expect-stdout: 2840089275
// expect-stdout: 2202591588
// A loop-carried `x = (x >> 1) ^ (mask & k)`: the shifted value is built in
// the register of `x` itself.
fn crc_bits(x0: u64, n: u64) -> u64 {
  let mut x = x0;
  let mut k = 0;
  while k < n && k < 64 {
    if x % 2 == 1 {
      x = (x / 2) ^ 3988292384;
    } else {
      x = x / 2;
    }
    k = k + 1;
  }
  return x;
}

fn mix(x0: u64, m: u64) -> u64 {
  let mut x = x0;
  let mut k = 0;
  while k < 10 {
    let lo = x % 2;
    let y = x / 2;
    x = y ^ (m * lo);
    k = k + 1;
  }
  return x;
}

fn main() {
  print(crc_bits(4294967295, 8));
  print(crc_bits(12345, 32));
  print(mix(99999, 3988292384));
}
