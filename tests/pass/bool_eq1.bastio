// `x == 1` and `x != 0` of an `x` that is 0 or 1 (a `% 2`, a comparison) are
// `x` itself (iropt_zext): the counts below must still be right when x is 0,
// 1 and, in the last loop, larger than 1.
// expect-exit: 0
// expect-stdout: 3000
fn main() -> u64 {
  let mut i = 0;
  let mut a = 0;
  let mut b = 0;
  let mut c = 0;
  while i < 1000
    invariant i <= 1000 && a <= i && b <= i && c <= 2 * i
  {
    let x = (i * 7 + 3) % 5 % 2;
    if x == 1 { a = a + 1; }
    if x != 0 { b = b + 1; }
    let y = (i * 3) % 7;
    if y == 1 { c = c + 1; }
    if y != 0 { c = c + 1; }
    i = i + 1;
  }
  print(a * 4 + b + c);
  return 0;
}
