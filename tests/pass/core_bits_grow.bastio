// expect-exit: 0
// core/bitmap.bastio's bits_grow: a packed map grows, keeping its entries,
// and the new ones are clear even in the old last word, whose spare bits
// nothing promised were clear. Out of memory it returns false instead.
import "core/bitmap.bastio";
fn main() -> u64 {
  let mut b = bits_new(70);
  bits_set(&mut b, 69);
  bits_set(&mut b, 3);
  let mut ok = true;
  if bits_grow(&mut b, 200) {
    assert bits_at(b, 69) && !bits_at(b, 70) && !bits_at(b, 199);
    ok = bits_test(b, 69) && bits_test(b, 3) && !bits_test(b, 150) && bits_find_clear(b, 69, 200, 0) == 70;
  }
  bits_free(b);
  if ok { return 0; }
  return 1;
}
