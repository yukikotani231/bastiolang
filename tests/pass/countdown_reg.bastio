// expect-exit: 0
// expect-stdout: 0
// expect-stdout: 3
// expect-stdout: 3000
// expect-stdout: 37
// expect-stdout: 650
// expect-stdout: 5050
// A loop whose counter only counts passes up to a bound held in a register
// counts down from the bound instead. Checked: a bound of zero (the loop must
// not run), of one, a large one, a counter that is also an index (it keeps
// counting up), a bound that the body changes, and a loop in a loop.
fn spin(n: u64) -> u64
  requires n <= 1000000
{
  let m = n * 3;
  let mut i = 0;
  let mut s = 0;
  while i < m
    invariant i <= m && s == i
  {
    s = s + 1;
    i = i + 1;
  }
  return s;
}

fn index_sum(n: u64) -> u64
  requires n <= 1000
{
  let m = n + 1;
  let mut i = 0;
  let mut s = 0;
  while i < m
    invariant i <= m && s <= i * 1000
  {
    s = s + i;
    i = i + 1;
  }
  return s;
}

fn shrink(n: u64) -> u64
  requires n <= 1000
{
  let mut m = n;
  let mut i = 0;
  let mut s = 0;
  while i < m
    invariant i <= m + 1 && m <= n + 5 && s <= i * 1005
  {
    s = s + m;
    if i == 3 {
      m = 5;
    }
    i = i + 1;
  }
  return s;
}

fn grid(n: u64) -> u64
  requires n <= 100
{
  let m = n;
  let mut i = 0;
  let mut t = 0;
  while i < m
    invariant i <= m && t <= i * 100
  {
    let mut j = 0;
    while j < m
      invariant j <= m && t <= i * 100 + j
    {
      t = t + 1;
      j = j + 1;
    }
    i = i + 1;
  }
  return t;
}

fn main() -> u64 {
  print(spin(0));
  print(spin(1));
  print(spin(1000));
  print(shrink(8));
  print(wrap_add(grid(25), 25));
  print(index_sum(100));
  return 0;
}
