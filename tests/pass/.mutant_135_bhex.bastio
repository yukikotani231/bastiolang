// expect-exit: 6
// `bhex(b, from, to)` is hexadecimal value of bytes `from..to`
// (`0-9`, `a-f`, `A-F`), unfolded one digit per mention like `bdec`.
import "core/num.bastio";

fn main() -> u64 {
  let mut b = balloc(3);
  bset(&mut b, 0, 49);   // "1fA"
  bset(&mut b, 1, 102);
  bset(&mut b, 2, 65);
  assert bhex(b, 0, 1) == 1;
  assert bhex(b, 0, 2) == 31;
  assert bhex(b, 0, 3) == 506;
  let mut r = 0;
  match parse_hex_u64(b, 0, 3) {
    Option::Some(v) => {
      assert v == 506;                 // parse_hex_u64 returns the digits' value
      r = v - 500;
    },
    Option::None => {},
  }
  bfree(b);
  return r;
}
