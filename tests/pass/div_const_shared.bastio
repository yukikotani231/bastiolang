// expect-exit: 0
// expect-stdout: 0
// expect-stdout: 7
// expect-stdout: 2414632835954729991
// expect-stdout: 17109562504176528539
// expect-stdout: 0
// expect-stdout: 12987072235998375903
// expect-stdout: 16906003119150506325
// expect-stdout: 5574451091078506666
// expect-stdout: 8803366151423653649
// expect-stdout: 3555487225855807485
// A division by a constant that is not a power of two (a multiplication by a
// magic number and a shift) next to a remainder by the same constant, as in
// the digit loop of a decimal formatter, for odd and even divisors, small and
// large, and for dividends up to the top of the 64-bit range.
fn digits(n: u64) -> u64 {
  let mut v = n;
  let mut s = 0;
  let mut k = 0;
  while v > 0 && k < 20
    invariant k <= 20
  {
    s = wrap_add(wrap_mul(s, 31), v % 10);
    v = v / 10;
    k = k + 1;
  }
  return s;
}

fn fold(n: u64) -> u64 {
  let mut h = n / 3;
  h = wrap_add(wrap_mul(h, 31), n % 3);
  h = wrap_add(wrap_mul(h, 31), n / 6);
  h = wrap_add(wrap_mul(h, 31), n / 7);
  h = wrap_add(wrap_mul(h, 31), n % 7);
  h = wrap_add(wrap_mul(h, 31), n / 100);
  h = wrap_add(wrap_mul(h, 31), n % 100);
  h = wrap_add(wrap_mul(h, 31), n / 641);
  h = wrap_add(wrap_mul(h, 31), n / 1000000007);
  h = wrap_add(wrap_mul(h, 31), n % 1000000007);
  h = wrap_add(wrap_mul(h, 31), n / 4294967297);
  h = wrap_add(wrap_mul(h, 31), n % 4294967297);
  h = wrap_add(wrap_mul(h, 31), n / 4611686018427387905);
  h = wrap_add(wrap_mul(h, 31), n / 9223372036854775807);
  return h;
}

fn main() -> u64 {
  print(digits(0));
  print(digits(7));
  print(digits(1234567890123));
  print(digits(18446744073709551615));
  print(fold(0));
  print(fold(99));
  print(fold(1000000006));
  print(fold(4294967296));
  print(fold(9223372036854775807));
  print(fold(18446744073709551615));
  return 0;
}
