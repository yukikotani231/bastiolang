// expect-exit: 3
// Generic spec fns: `same_len[T]` is copied per type argument, like a
// generic function, and can be named in the specs of generic functions.
spec fn same_len[T](x: &Vec[T], y: &Vec[T]) -> bool { vlen(x) == vlen(y) }
spec fn longer[T](x: &Vec[T], y: &Vec[T]) -> bool { same_len[T](x, y) || vlen(x) > vlen(y) }
spec fn all_below(v: &Vec[u64], n: u64) -> bool { forall i: u64 :: i < vlen(v) ==> vget(v, i) < n }

fn push_both[T](x: &mut Vec[T], y: &mut Vec[T], a: T, b: T)
  requires same_len[T](x, y)
  ensures same_len[T](x, y) && vlen(x) == vlen(old(x)) + 1
{
  vec_push(&mut x, a);
  vec_push(&mut y, b);
}

fn main() -> u64 {
  let mut x = vec_new[u64]();
  let mut y = vec_new[u64]();
  push_both[u64](&mut x, &mut y, 1, 2);
  push_both[u64](&mut x, &mut y, 3, 4);
  assert same_len[u64](x, y);
  assert longer[u64](x, y);
  let mut bs = vec_new[bool]();
  let mut cs = vec_new[bool]();
  push_both[bool](&mut bs, &mut cs, true, false);
  let r = vec_len(x) + vec_len(bs);
  vec_free(x);
  vec_free(y);
  vec_free(bs);
  vec_free(cs);
  return r;
}
