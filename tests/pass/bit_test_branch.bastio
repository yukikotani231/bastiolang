// A one-bit test of a value branches on the flags of a `test` (stage1/iropt.bastio
// iropt_bits, stage1/irx86.bastio ix_test_br) on the native-ir backend.
// expect-exit: 0
// expect-stdout: 5120
// expect-stdout: 80
// `x & 4 == 4`, `x & 4 != 4`, `x % 2 == 1`, `x % 2 == 0`, and a masked value
// that is read again after the test (so no `test` may replace the `and`).
fn tally(n: u64) -> u64 {
  let mut a = 0;
  let mut b = 0;
  let mut c = 0;
  let mut d = 0;
  let mut i = 0;
  while i < n {
    if i & 4 == 4 {
      a = wrap_add(a, 1);
    }
    if i & 4 != 4 {
      b = wrap_add(b, 2);
    }
    if i % 2 == 1 {
      c = wrap_add(c, 3);
    }
    if i % 2 == 0 {
      d = wrap_add(d, 4);
    }
    i = wrap_add(i, 1);
  }
  return wrap_add(wrap_add(a, b), wrap_add(c, d));
}

fn reread(n: u64) -> u64 {
  let mut s = 0;
  let mut i = 0;
  while i < n {
    let m = i & 8;
    if m == 8 {
      s = wrap_add(s, m);
    }
    i = wrap_add(i, 1);
  }
  return s;
}

fn main() -> u64 {
  print(tally(1024));
  print(reread(26));
  return 0;
}
