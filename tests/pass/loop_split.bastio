// expect-stdout: 2400
// A scan loop inside a function with more live values than registers: a
// value kept in the frame may be copied to a register for the loop, and
// back when the loop changes it. Results must not depend on that.
fn scan(v: &Vec[u64], n: u64, a: u64, b: u64, c: u64, d: u64, e: u64, g: u64, h: u64, k: u64, m: u64, p: u64) -> u64 {
  let mut i = 0;
  let mut hits = 0;
  let mut last = 0;
  while i < n && i < 1000 && i < vec_len(v) {
    let x = vec_get(v, i);
    if x == a || x == b || x == c || x == d {
      hits = wrap_add(hits, 1);
      last = i;
    }
    i = i + 1;
  }
  return wrap_add(wrap_add(hits, last), wrap_add(wrap_add(e, g), wrap_add(wrap_add(h, k), wrap_add(m, p))));
}

fn count(v: &Vec[u64], n: u64) -> u64 {
  let mut i = 0;
  let mut s = 0;
  while i < n && i < 1000 && i < vec_len(v) {
    s = wrap_add(s, vec_get(v, i));
    i = i + 1;
  }
  return s;
}

fn main() -> u64 {
  let mut v = vec_new[u64]();
  let mut k = 0;
  while k < 100 {
    vec_push(&mut v, k % 10);
    k = k + 1;
  }
  print(scan(v, 100, 3, 4, 5, 6, 1000, 2000, 3, 4, 5, 6));
  print(wrap_add(count(v, 3), 6));
  let mut t = 0;
  let mut r = 0;
  while r < 50 {
    t = wrap_add(t, wrap_sub(count(v, 100), 449));
    r = r + 1;
  }
  print(wrap_mul(t, 48));
  vec_free(v);
  return 0;
}
