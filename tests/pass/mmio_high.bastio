// expect-exit: 7
// The device window reaches far above 4 GiB, where UEFI firmware puts
// 64-bit PCI BARs (OVMF uses 0xC0_0000_0000), up to 2^46.
const BAR: u64 = 0xC000000000;

fn main(win: &mut MmioSpace) -> u64 {
  let mut r = mmio_claim(&mut win, BAR, 16384);
  mmio_write32(&mut r, 0x1000, 7);
  let v = mmio_read32(&mut r, 0x1000);
  mmio_release(&mut win, r);
  // The very top of the window.
  let top = mmio_claim(&mut win, 0x400000000000 - 4096, 4096);
  mmio_release(&mut win, top);
  return cast[u64](v);
}
