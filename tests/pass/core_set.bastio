// expect-exit: 0
// HashSet through growth, removal, reinsertion and many collisions.
import "core/set.bastio";

fn main() -> u64 {
  let mut s = set_new();
  let mut ok = true;
  let mut i = 0;
  while i < 500
    invariant i <= 500 && set_ok(s)
  {
    let fresh = set_insert(&mut s, i * 7919);
    ok = ok && fresh;
    i = i + 1;
  }
  ok = ok && set_len(s) == 500;
  i = 0;
  while i < 500
    invariant i <= 500 && set_ok(s)
  {
    ok = ok && set_contains(s, i * 7919) && !set_insert(&mut s, i * 7919);
    i = i + 1;
  }
  ok = ok && !set_contains(s, 1) && !set_contains(s, 0xffffffffffffffff);
  i = 0;
  while i < 500
    invariant i <= 500 && set_ok(s)
  {
    if i % 2 == 0 {
      ok = ok && set_remove(&mut s, i * 7919);
    }
    i = i + 1;
  }
  ok = ok && set_len(s) == 250 && !set_remove(&mut s, 0) && !set_contains(s, 0) && set_contains(s, 7919);
  ok = ok && set_insert(&mut s, 0) && set_contains(s, 0) && set_len(s) == 251;
  let items = set_items(s);
  ok = ok && vec_len(items) == 251;
  vec_free(items);
  set_free(s);
  if ok { return 0; }
  return 1;
}
