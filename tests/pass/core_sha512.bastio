/// The number of checks of this group that fail.
fn group4() -> u64
  ensures result <= 3
{
  return same(257, 97, "17fa1d01865805f9e657c5f5088754d19913eb418577b03cd040b99e5e1354fd31d0d7f24b5474c62b49e3271860859510909685c5811eba23b06e1e3369899d") +
    same(1000, 97, "67ba5535a46e3f86dbfbed8cbbaf0125c76ed549ff8b0b9e03e0c88cf90fa634fa7b12b47d77b694de488ace8d9a65967dc96df599727d3292a8d9d447709c97") +
    same(1000000, 97, "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b");
}

fn main() -> u64 {
  let bad = group1() + group2() + group3() + group4();
  if bad > 0 { return 1; }
  return 0;
}
