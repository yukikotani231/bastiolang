// expect-exit: 0
// core/sha512: the FIPS 180-4 vectors, the lengths around a block and a million `a`s.
import "core/sha512.bastio";
import "core/num.bastio";

/// The lower-case hex text of `d`.
fn hex(d: &Bytes) -> Bytes {
  let mut t = text_new();
  let mut i = 0;
  while i < blen(d)
    invariant i <= blen(d)
  {
    text_push(&mut t, hex_char(cast[u64](bget(d, i)) / 16));
    text_push(&mut t, hex_char(cast[u64](bget(d, i)) % 16));
    i = i + 1;
  }
  return text_finish(t);
}

/// 1 unless the SHA-512 of the `n` bytes `c` is `want`.
fn same(n: u64, c: u8, want: Str) -> u64
  requires n < 1000000000
  ensures result <= 1
{
  let mut m = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(m) == n
  {
    bset(&mut m, i, c);
    i = i + 1;
  }
  let d = sha512(m);
  let h = hex(d);
  let ok = bytes_eq_str(h, want);
  bfree(h);
  bfree(d);
  bfree(m);
  if ok { return 0; }
  return 1;
}

/// 1 unless the SHA-512 of the text `s` is `want`.
fn text_same(s: Str, want: Str) -> u64
  ensures result <= 1
{
  let m = bfrom(s);
  let d = sha512(m);
  let h = hex(d);
  let ok = bytes_eq_str(h, want);
  bfree(h);
  bfree(d);
  bfree(m);
  if ok { return 0; }
  return 1;
}

/// The number of checks of this group that fail.
fn group1() -> u64
  ensures result <= 5
{
  return text_same("", "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e") +
    text_same("abc", "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f") +
    text_same("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu", "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909") +
    same(1, 97, "1f40fc92da241694750979ee6cf582f2d5d7d28e18335de05abc54d0560e0f5302860c652bf08d560252aa5e74210546f369fbbbce8c12cfc7957b2652fe9a75") +
    same(111, 97, "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2");
}

