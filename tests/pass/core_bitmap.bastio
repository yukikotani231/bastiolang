// expect-exit: 42
// core/bitmap: an allocation map with reserved entries, a hint, wrap-around.
import "core/bitmap.bastio";

fn main() -> u64 {
  let mut m = balloc(8);
  map_fill(&mut m, 0, 2, 1);           // entries 0 and 1 are reserved
  let a = map_take(&mut m, 2, 8, 6);   // from the hint: 6
  let b = map_take(&mut m, 2, 8, 7);   // 7
  let c = map_take(&mut m, 2, 8, 8);   // a hint past the end starts at lo: 2
  assert a < 8 ==> bget(m, a) == 1;
  map_give(&mut m, a);
  let free = map_count_free(m, 2, 8);  // 3 4 5 6
  map_fill(&mut m, 2, 8, 1);
  let none = map_take(&mut m, 2, 8, 3);
  assert none == 8 ==> map_full(m, 0, 8);
  bfree(m);
  if a == 6 && b == 7 && c == 2 && free == 4 && none == 8 {
    return 42;
  }
  return 1;
}
