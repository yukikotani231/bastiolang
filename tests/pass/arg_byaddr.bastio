// expect-exit: 0
// A struct with a Vec in it of many words (here 3 + 20) goes to a function as
// the address of a copy the caller makes, not as its words: the callee changes
// its own copy, two such arguments and one that is another call's result
// arrive intact, and a loop calls it many times.
struct Wide { v: Vec[u64], a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64, i: u64, j: u64, k: u64, l: u64, m: u64, n: u64, o: u64, p: u64, q: u64, r: u64, s: u64, t: u64 }

fn mk(x: u64) -> Wide
  requires x < 1000
  ensures vlen(result.v) == 1
{
  let mut w = Wide { v: vec_new[u64](), a: x, b: x + 1, c: x + 2, d: x + 3, e: x + 4, f: x + 5, g: x + 6, h: x + 7, i: x + 8, j: x + 9, k: x + 10, l: x + 11, m: x + 12, n: x + 13, o: x + 14, p: x + 15, q: x + 16, r: x + 17, s: x + 18, t: x + 19 };
  vec_push(&mut w.v, x);
  return w;
}

fn total(w: Wide) -> u64
  requires vlen(w.v) == 1
{
  let mut t = vec_get(w.v, 0);
  t = wrap_add(t, wrap_add(w.a, wrap_mul(w.b, 2)));
  t = wrap_add(t, wrap_add(wrap_mul(w.j, 3), wrap_mul(w.k, 5)));
  t = wrap_add(t, wrap_add(wrap_mul(w.s, 7), wrap_mul(w.t, 11)));
  vec_free(w.v);
  return t;
}

// The callee changes its own copy and gives it back.
fn bump(w: Wide, by: u64) -> Wide
  requires vlen(w.v) == 1
  ensures vlen(result.v) == 1
{
  let mut x = w;
  x.a = wrap_add(x.a, by);
  x.t = wrap_add(x.t, by);
  return x;
}

fn pair(p: Wide, q: Wide) -> u64
  requires vlen(p.v) == 1 && vlen(q.v) == 1
{
  return wrap_add(total(p), wrap_mul(total(q), 1000));
}

fn main() -> u64 {
  let w = mk(5);
  // total(mk(x)) = x + x + 2(x+1) + 3(x+9) + 5(x+10) + 7(x+18) + 11(x+19) = 30x + 2 + 27 + 50 + 126 + 209 = 30x + 414
  if total(w) != 30 * 5 + 414 {
    return 1;
  }
  let b = bump(mk(7), 100);
  if total(b) != 30 * 7 + 414 + 100 + 1100 {
    return 2;
  }
  if pair(mk(1), bump(mk(2), 3)) != (30 + 414) + (30 * 2 + 414 + 3 + 33) * 1000 {
    return 3;
  }
  let mut i = 0;
  let mut sum = 0;
  while i < 20
    invariant i <= 20
  {
    sum = wrap_add(sum, total(bump(mk(i), i)));
    i = i + 1;
  }
  // 42 i + 414, summed over i < 20.
  if sum != 42 * 190 + 414 * 20 {
    return 4;
  }
  return 0;
}
