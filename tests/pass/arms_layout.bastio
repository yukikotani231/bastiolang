// expect-stdout: 3
// An if/else whose then arm loads from memory and whose else arm is a short
// straight run: the layout may swap the arms, never what each one computes.
fn at(v: &Vec[u64], i: u64, d: u64) -> u64 {
  let mut r = 0;
  if i < vec_len(v) {
    r = vec_get(v, i);
  } else {
    r = d;
  }
  return r;
}

fn sum(v: &Vec[u64], n: u64) -> u64 {
  let mut s = 0;
  let mut i = 0;
  while i < n && i < 1000 {
    let x = at(v, i, 100);
    s = wrap_add(s, x);
    i = i + 1;
  }
  return s;
}

fn main() -> u64 {
  let mut v = vec_new[u64]();
  let mut k = 1;
  while k <= 5 {
    vec_push(&mut v, k);
    k = k + 1;
  }
  print(sum(v, 5));
  print(at(v, 6, 7));
  print(wrap_sub(sum(v, 7), 103));
  print(at(v, 2, 9));
  vec_free(v);
  return 0;
}
