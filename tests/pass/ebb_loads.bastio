// Value numbering along extended basic blocks (stage1/iropt.bastio, iropt_ebb).
// expect-exit: 0
// expect-stdout: 40
// expect-stdout: 1
// A load or a computation repeated in the next block of a branch is made once
// when nothing it reads changed in between. The cases: `a[j - 1]` in the test
// and the body of an insertion sort, a store between two loads of one slot
// (the second load must see the new value), and an index written between two
// reads (the second read must use the new index).
fn main() -> u64 {
  let mut a = alloc(8);
  let mut i = 0;
  while i < 8
    invariant i <= 8 && len(a) == 8
  {
    a = set(a, i, 8 - i);
    i = i + 1;
  }
  i = 1;
  while i < 8
    invariant i >= 1 && i <= 8 && len(a) == 8
  {
    let v = get(a, i);
    let mut j = i;
    while j > 0 && get(a, j - 1) > v
      invariant j <= i && i < 8 && len(a) == 8
    {
      a = set(a, j, get(a, j - 1));
      j = j - 1;
    }
    a = set(a, j, v);
    i = i + 1;
  }
  let mut s = 0;
  i = 0;
  while i < 8
    invariant i <= 8 && len(a) == 8
  {
    s = wrap_add(s, wrap_mul(get(a, i), i));
    i = i + 1;
  }
  // 1*0 + 2*1 + ... + 8*7 = 168; shown through a store between two loads.
  let before = get(a, 3);
  a = set(a, 3, 100);
  let after = get(a, 3);
  let mut ok = 0;
  if before == 4 && after == 100 {
    ok = 1;
  }
  print(wrap_sub(s, 128));
  print(ok);
  free(a);
  return 0;
}
