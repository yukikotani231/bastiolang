// expect-exit: 42
// Opt-in functional correctness: `max` proves its result is an upper bound
// of every element.

fn max(b: &Buf) -> u64
  requires len(b) > 0
  ensures forall j: u64 :: j < len(b) ==> get(b, j) <= result
{
  let mut m = get(b, 0);
  let mut w = 0;
  let mut i = 1;
  while i < len(b)
    invariant 1 <= i && i <= len(b)
    invariant w < len(b) && get(b, w) == m
    invariant forall j: u64 :: j < i ==> get(b, j) <= m
  {
    let x = get(b, i);
    if x > m {
      m = x;
      w = i;
    }
    i = i + 1;
  }
  return m;
}

fn main() -> u64 {
  let a = alloc(5);
  let a1 = set(a, 0, 3);
  let a2 = set(a1, 1, 42);
  let a3 = set(a2, 2, 17);
  let r = max(a3);
  free(a3);
  return r;
}
