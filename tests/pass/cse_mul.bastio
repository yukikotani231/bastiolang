// expect-exit: 0
// expect-stdout: 105
// expect-stdout: 46
// expect-stdout: 11520
// expect-stdout: 864
// expect-stdout: 865
// expect-stdout: 836
// stage1-only: common subexpression elimination of products
// A product computed again where an earlier one dominates it is taken from
// that one. Nothing may be shared across a redefinition of an operand, between
// branches that do not dominate each other, or with a different constant.
fn dom(a: u64, b: u64) -> u64 {
  let x = wrap_mul(a, b);
  let mut r = x;
  if a > 3 {
    r = wrap_add(r, wrap_mul(b, a));
  } else {
    r = wrap_add(r, wrap_mul(a, 9));
  }
  return wrap_add(r, wrap_mul(a, b));
}

fn redef(a: u64, n: u64) -> u64 {
  let mut k = a;
  let mut s = 0;
  let mut i = 0;
  while i < n && i < 100 {
    s = wrap_add(s, wrap_mul(k, 72));
    k = wrap_add(k, 1);
    s = wrap_add(s, wrap_mul(k, 72));
    i = i + 1;
  }
  return s;
}

fn sides(a: u64, c: bool) -> u64 {
  let mut r = 0;
  if c {
    r = wrap_mul(a, 72);
  } else {
    r = wrap_mul(a, 72);
    r = wrap_add(r, 1);
  }
  return wrap_add(r, wrap_mul(a, 72));
}

fn loops(a: u64, n: u64) -> u64 {
  let m = wrap_mul(a, 11);
  let mut s = 0;
  let mut i = 0;
  while i < n && i < 50 {
    s = wrap_add(s, wrap_mul(a, 11));
    s = wrap_add(s, wrap_mul(i, 11));
    i = i + 1;
  }
  return wrap_add(s, m);
}

fn main() {
  print(dom(5, 7));
  print(dom(2, 7));
  print(redef(3, 10));
  print(sides(6, true));
  print(sides(6, false));
  print(loops(4, 9));
}
