// expect-exit: 0
// HChaCha20, XChaCha20-Poly1305 and WireGuard's cookie reply: the vectors of
// draft-irtf-cfrg-xchacha-03 (sections 2.2.1 and A.3.1), a cookie reply and a
// cookie checked against a reference written in Python, and every one-bit
// change of a reply, of the mac1 it answers and of the key refused.
import "core/wgnoise.bastio";
import "core/num.bastio";

/// The lower-case hex text of `d`.
fn hex(d: &Bytes) -> Bytes {
  let mut t = text_new();
  let mut i = 0;
  while i < blen(d)
    invariant i <= blen(d)
  {
    text_push(&mut t, hex_char(cast[u64](bget(d, i)) / 16));
    text_push(&mut t, hex_char(cast[u64](bget(d, i)) % 16));
    i = i + 1;
  }
  return text_finish(t);
}

/// `n` bytes `(i * mul + add) mod 256`.
fn pattern(n: u64, mul: u64, add: u64) -> Bytes
  requires n < 100000 && mul < 256 && add < 256
  ensures blen(result) == n
{
  let mut b = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(b) == n
  {
    bset(&mut b, i, cast[u8]((i * mul + add) % 256));
    i = i + 1;
  }
  return b;
}

/// 1 unless the hex of `d` is `want`; frees `d`.
fn is_hex(d: Bytes, want: Str) -> u64
  ensures result <= 1
{
  let h = hex(d);
  let ok = bytes_eq_str(h, want);
  bfree(h);
  bfree(d);
  if ok { return 0; }
  return 1;
}

/// draft-irtf-cfrg-xchacha-03 2.2.1: 1 unless HChaCha20 gives the draft's subkey.
fn hchacha_check() -> u64
  ensures result <= 1
{
  let key = pattern(32, 1, 0);
  let mut nonce = balloc(16);
  bset(&mut nonce, 3, 9);
  bset(&mut nonce, 7, 74);
  bset(&mut nonce, 12, 49);
  bset(&mut nonce, 13, 65);
  bset(&mut nonce, 14, 89);
  bset(&mut nonce, 15, 39);
  let sub = hchacha20(key, nonce);
  bfree(nonce);
  bfree(key);
  return is_hex(sub, "82413b4227b27bfed30e42508a877d73a0f9e4d58a74a853c12ec41326d3ecdc");
}

/// draft-irtf-cfrg-xchacha-03 A.3.1: 1 unless the sunscreen message seals as
/// the draft says, and opens again.
fn xaead_check() -> u64
  ensures result <= 1
{
  let key = pattern(32, 1, 128);
  let nonce = pattern(24, 1, 64);
  let mut aad = balloc(12);
  bset(&mut aad, 0, 0x50); bset(&mut aad, 1, 0x51); bset(&mut aad, 2, 0x52); bset(&mut aad, 3, 0x53);
  bset(&mut aad, 4, 0xc0); bset(&mut aad, 5, 0xc1); bset(&mut aad, 6, 0xc2); bset(&mut aad, 7, 0xc3);
  bset(&mut aad, 8, 0xc4); bset(&mut aad, 9, 0xc5); bset(&mut aad, 10, 0xc6); bset(&mut aad, 11, 0xc7);
  let m = bfrom("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.");
  let sealed = xaead_seal(key, nonce, aad, m);
  let h = hex(sealed);
  let mut bad = 1;
  if bytes_eq_str(h, "bd6d179d3e83d43b9576579493c0e939572a1700252bfaccbed2902c21396cbb731c7f1b0b4aa6440bf3a82f4eda7e39ae64c6708c54c216cb96b72e1213b4522f8c9ba40db5d945b11b69b982c1bb9e3f3fac2bc369488f76b2383565d3fff921f9664c97637da9768812f615c68b13b52ec0875924c1c7987947deafd8780acf49") {
    bad = 0;
  }
  bfree(h);
  match xaead_open(key, nonce, aad, sealed) {
    Option::None => { bad = 1; },
    Option::Some(p) => {
      if !bytes_eq(p, m) { bad = 1; }
      bfree(p);
    },
  }
  bfree(sealed);
  bfree(m);
  bfree(aad);
  bfree(nonce);
  bfree(key);
  return bad;
}

/// The cookie reply of the reference: pubkey pattern(32, 3, 1), mac1
/// pattern(16, 5, 2), cookie pattern(16, 7, 3), nonce pattern(24, 11, 4) and
/// receiver index 0x01020304.
fn reply_check() -> u64
  ensures result <= 1
{
  let mypub = pattern(32, 3, 1);
  let mac1 = pattern(16, 5, 2);
  let cookie = pattern(16, 7, 3);
  let nonce = pattern(24, 11, 4);
  let msg = wgn_cookie_reply(mypub, 16909060, nonce, cookie, mac1);
  let h = hex(msg);
  let mut bad = 1;
  if bytes_eq_str(h, "0300000004030201040f1a25303b46515c67727d88939ea9b4bfcad5e0ebf6010855c00e694b600de74b9e517d2801e1817afc8f5830645e7f45d5f88724fd04") {
    bad = 0;
  }
  bfree(h);
  match wgn_consume_cookie_reply(msg, mypub, mac1) {
    Option::None => { bad = 1; },
    Option::Some(c) => {
      if !bytes_eq(c, cookie) { bad = 1; }
      bfree(c);
    },
  }
  bfree(msg);
  bfree(nonce);
  bfree(cookie);
  bfree(mac1);
  bfree(mypub);
  return bad;
}

/// The cookie for 192.168.77.1:51871 under pattern(32, 13, 5).
fn cookie_check() -> u64
  ensures result <= 1
{
  let secret = pattern(32, 13, 5);
  let mut who = balloc(6);
  bset(&mut who, 0, 192); bset(&mut who, 1, 168); bset(&mut who, 2, 77); bset(&mut who, 3, 1);
  bset(&mut who, 4, 0xca); bset(&mut who, 5, 0x9f);
  let c = wgn_cookie(secret, who);
  bfree(who);
  bfree(secret);
  return is_hex(c, "1df633f8b7cdc8f17454d5d6a17b6ac9");
}

/// 1 unless a one-bit change anywhere in the reply, in the mac1 it is read
/// against, or in the public key it is read for makes it refused.
fn tamper_check() -> u64
  ensures result <= 1
{
  let mypub = pattern(32, 3, 1);
  let mac1 = pattern(16, 5, 2);
  let cookie = pattern(16, 7, 3);
  let nonce = pattern(24, 11, 4);
  let msg = wgn_cookie_reply(mypub, 7, nonce, cookie, mac1);
  let mut bad = 0;
  let mut i = 0;
  while i < 64
    invariant bad <= 1 && i <= 64 && blen(msg) == 64 && blen(mypub) == 32 && blen(mac1) == 16
  {
    let mut m = bytes_slice(msg, 0, 64);
    bset(&mut m, i, bget(m, i) ^ 1);
    match wgn_consume_cookie_reply(m, mypub, mac1) {
      Option::None => {},
      Option::Some(c) => {
        // the receiver index is not authenticated: a change there is not refused
        if i < 4 || i >= 8 { bad = 1; }
        bfree(c);
      },
    }
    bfree(m);
    i = i + 1;
  }
  let mut j = 0;
  while j < 16
    invariant bad <= 1 && j <= 16 && blen(msg) == 64 && blen(mypub) == 32 && blen(mac1) == 16
  {
    let mut m1 = bytes_slice(mac1, 0, 16);
    bset(&mut m1, j, bget(m1, j) ^ 1);
    match wgn_consume_cookie_reply(msg, mypub, m1) {
      Option::None => {},
      Option::Some(c) => { bad = 1; bfree(c); },
    }
    bfree(m1);
    j = j + 1;
  }
  let mut k = 0;
  while k < 32
    invariant bad <= 1 && k <= 32 && blen(msg) == 64 && blen(mypub) == 32 && blen(mac1) == 16
  {
    let mut p = bytes_slice(mypub, 0, 32);
    bset(&mut p, k, bget(p, k) ^ 1);
    match wgn_consume_cookie_reply(msg, p, mac1) {
      Option::None => {},
      Option::Some(c) => { bad = 1; bfree(c); },
    }
    bfree(p);
    k = k + 1;
  }
  bfree(msg);
  bfree(nonce);
  bfree(cookie);
  bfree(mac1);
  bfree(mypub);
  return bad;
}

fn main() -> u64 {
  let a0 = hchacha_check();
  let a1 = xaead_check();
  let a2 = reply_check();
  let a3 = cookie_check();
  let a4 = tamper_check();
  if a0 + a1 + a2 + a3 + a4 > 0 { return 1; }
  return 0;
}
