// expect-exit: 0
// expect-stdout: 577
// expect-stdout: 7
// A getter that returns a whole record (the default one past the end) and
// that callers read one field of, here from inside a loop and outside one.
struct Rec { a: u64, b: u64, c: u64, d: u64, e: u64 }

fn blank() -> Rec {
  return Rec { a: 7, b: 0, c: 0, d: 0, e: 0 };
}

fn rec_at(v: &Vec[Rec], i: u64) -> Rec {
  if i < vec_len(v) {
    return vec_get(v, i);
  }
  return blank();
}

fn b_of(v: &Vec[Rec], i: u64) -> u64 {
  let r = rec_at(v, i);
  return r.b;
}

fn a_of(v: &Vec[Rec], i: u64) -> u64 {
  let r = rec_at(v, i);
  return r.a;
}

fn main() -> u64 {
  let mut v = vec_new[Rec]();
  let mut i = 0;
  while i < 20
    invariant i <= 20
  {
    vec_push(&mut v, Rec { a: i, b: i * 3, c: 1, d: 2, e: 3 });
    i = i + 1;
  }
  let mut s = 0;
  i = 0;
  while i < 25
    invariant i <= 25
  {
    if i < 20 {
      s = wrap_add(s, b_of(v, i));
    }
    i = i + 1;
  }
  print(wrap_add(s, 7));
  print(a_of(v, 99));
  vec_free(v);
  return 0;
}
