// Shifts of constants, which the native backends compute at compile time:
// a flag mask, a field extract, the top bit and a shift by zero
// expect-exit: 0
const FLAG: u64 = 1;

fn flags(v: u64) -> u64 {
  let hit = (v & (FLAG << 8)) != 0;
  if hit {
    return 1;
  }
  return 0;
}

fn main() -> u64 {
  if flags(256) != 1 || flags(255) != 0 {
    return 1;
  }
  let top = 1 << 63;
  if top >> 63 != 1 || top != 9223372036854775808 {
    return 2;
  }
  let field = (0xABCD00 >> 8) & 0xFF;
  if field != 0xCD {
    return 3;
  }
  let z = 5 << 0;
  if z != 5 || (7 >> 0) != 7 {
    return 4;
  }
  return 0;
}
