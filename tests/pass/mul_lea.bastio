// expect-exit: 0
// expect-stdout: 3000001
// expect-stdout: 5000007
// expect-stdout: 11147483647
// expect-stdout: 73
// `3 * x + 1`, `x * 5 + 7` and `x * 9 + 2147483647` become one lea; a product
// that is read twice, or a wrapping one, keeps its multiplication.
fn f3(x: u64) -> u64
  requires x < 1000000000000
{
  return 3 * x + 1;
}

fn f5(x: u64) -> u64
  requires x < 1000000000000
{
  return x * 5 + 7;
}

fn f9(x: u64) -> u64
  requires x < 1000000000000
{
  return x * 9 + 2147483647;
}

fn twice(x: u64) -> u64
  requires x < 1000000000000
{
  let t = x * 9;
  return t + 1 + t;
}

fn main() -> u64 {
  print(f3(1000000));
  print(f5(1000000));
  print(f9(1000000000));
  print(twice(4));
  return 0;
}
