// expect-exit: 0
// A copy of a variable that is written while the copy lives, and one that is not.
fn mix(n: u64) -> u64 {
  let mut nr = n;
  let a = nr;
  nr = wrap_add(nr, 1);
  let b = nr;
  let mut t = 0;
  let mut i = 0;
  while i < 3 {
    t = wrap_add(t, wrap_add(a, b));
    nr = wrap_add(nr, 2);
    i = i + 1;
  }
  return wrap_add(t, wrap_add(nr, a));
}

fn pick(nr: u64, k: u64) -> u64 {
  let mut x = nr;
  let c = x;
  if k == 1 {
    x = wrap_add(x, 100);
  }
  return wrap_add(wrap_mul(c, 1000), x);
}

fn main() -> u64 {
  if mix(10) != 90 {
    return 1;
  }
  if pick(7, 0) != 7007 {
    return 2;
  }
  if pick(7, 1) != 7107 {
    return 3;
  }
  return 0;
}
