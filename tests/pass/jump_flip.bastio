// expect-exit: 0
// expect-stdout: 127
// expect-stdout: 5
// expect-stdout: 1
// expect-stdout: 254
// A clamp and a conditional update: the branch around a jump the emitter
// leaves behind must still choose the same arm.
fn clamp(x: u64, hi: u64) -> u64 {
  let mut r = hi;
  if x < hi {
    r = x;
  }
  return r;
}

fn pick(a: u64, b: u64) -> u64 {
  let mut r = 0;
  if a == b {
    r = 1;
  } else if a < b {
    r = 2;
  }
  return r;
}

fn main() -> u64 {
  print(clamp(1000, 127));
  print(clamp(5, 127));
  print(pick(3, 3));
  print(wrap_add(clamp(1000, 127), clamp(1000, 127)));
  return 0;
}
