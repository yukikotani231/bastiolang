// expect-stdout: 9227465
// expect-stdout: 1419833
// Variables that live across calls, more of them than registers, updated in
// place with add, sub, and, or and xor: the updates of a spilled variable are
// one instruction on its frame word.
fn fib(n: u64) -> u64 {
  if n < 2 {
    return n;
  }
  return wrap_add(fib(n - 1), fib(n - 2));
}

fn mix(n: u64) -> u64 {
  let mut a = 1;
  let mut b = 2;
  let mut c = 3;
  let mut d = 4;
  let mut e = 5;
  let mut f = 6;
  let mut g = 7;
  let mut h = 8;
  let mut i = 0;
  while i < n
    invariant i <= n
  {
    let r = fib(i % 7 + 3);
    a = wrap_add(a, r);
    b = b ^ a;
    c = c | b;
    d = d & wrap_add(c, 4095);
    e = wrap_add(wrap_add(e, d), 3);
    f = f ^ (e & 65535);
    g = wrap_add(wrap_add(g, f), 1);
    h = h | (g & 255);
    i = i + 1;
  }
  return wrap_add(wrap_add(wrap_add(a, b), wrap_add(c, d)), wrap_add(wrap_add(e, f), wrap_add(g, h))) % 4294967296;
}

fn main() -> u64 {
  print(fib(35));
  print(mix(1000));
  return 0;
}
