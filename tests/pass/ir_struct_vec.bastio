// expect-exit: 43
// so a literal is built in a frame slot, a function that returns one writes
// it to the space the caller reserves, and a `let` keeps it in a slot of its
// own where its fields are places.
struct Stack { items: Vec[u64], top: u64 }

fn stack_new(n: u64) -> Stack
  ensures result.top == n && vlen(result.items) == 0
{
  let v = vec_new[u64]();
  return Stack { items: v, top: n };
}

fn stack_push(s: &mut Stack, x: u64)
  requires s.top < 1000000 && vlen(s.items) < 1000000
  ensures vlen(s.items) == vlen(old(s).items) + 1 && s.top == old(s).top + 1 && vget(s.items, vlen(old(s).items)) == x
{
  vec_push(&mut s.items, x);
  s.top = s.top + 1;
}

fn main() -> u64 {
  let mut s = stack_new(2);
  stack_push(&mut s, 40);
  let r = s.top + vec_get(s.items, 0);
  vec_free(s.items);
  return r;
}
