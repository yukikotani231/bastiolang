// A function that ends in `t + f(args)` with a wrapping add becomes a loop on
// native-ir: the cases are the double recursion of fib, a single recursion
// whose other operand is a parameter, two parameters swapped by the call,
// a call whose argument reads the parameter it replaces, and a narrower type
// that wraps.
fn fib(n: u64) -> u64 {
  if n < 2 {
    return n;
  }
  return wrap_add(fib(n - 1), fib(n - 2));
}

fn tri(n: u64) -> u64 {
  if n == 0 {
    return 0;
  }
  return wrap_add(n, tri(n - 1));
}

// Two parameters read each other's old value in the call.
fn alt(a: u64, b: u64, k: u64) -> u64 {
  if k == 0 {
    return a;
  }
  return wrap_add(b, alt(b, wrap_add(a, b), k - 1));
}

fn tri3(n: u64) -> u64 {
  if n < 3 {
    return n;
  }
  return wrap_add(wrap_mul(n, n), tri3(n - 3));
}

fn bytes(n: u8) -> u8 {
  if n == 0 {
    return 0;
  }
  return wrap_add(n, bytes(n - 1));
}

fn main() -> u64 {
  print(fib(35));
  print(tri(100));
  print(alt(1, 2, 5));
  print(tri3(30));
  print(cast[u64](bytes(200)));
  return 0;
}
