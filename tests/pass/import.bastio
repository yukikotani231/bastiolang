// expect-exit: 74
// `import "path";` lines at the top of a file load other files (paths are
// relative to the importing file) into the same program. A file imported
// twice is loaded once.
import "../lib/units.bastio";
import "../lib/shapes.bastio";

fn main() -> u64 {
  let r = Rect { w: 2, h: SIDE };    // SIDE = 12
  return area(r) + scale(5);         // 24 + 50
}
