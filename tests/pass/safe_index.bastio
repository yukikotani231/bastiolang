// expect-exit: 5
// A runtime check the programmer writes is enough for the prover:
// inside the `if`, `i < len(b)` is known, so `get` needs no annotation.

fn at_or_zero(b: &Buf, i: u64) -> u64
  ensures i >= len(b) ==> result == 0
{
  if i < len(b) {
    return get(b, i);
  }
  return 0;
}

fn main() -> u64 {
  let a = alloc(2);
  let a1 = set(a, 1, 5);
  let x = at_or_zero(a1, 1);
  let y = at_or_zero(a1, 99);
  free(a1);
  if y == 0 {
    return x;
  }
  return 0;
}
