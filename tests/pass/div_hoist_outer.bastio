// expect-exit: 0
// expect-stdout: 2583
// expect-stdout: 12609
// expect-stdout: 20
// Divisions by constants in loops nested inside others: the multiplier is
// made once outside the outermost loop, also when the loops around the
// division differ in how they are entered, and for several constants.
fn digits(n: u64) -> u64 {
  let mut t = n;
  let mut k = 0;
  while t > 0 && k < 20
    invariant k <= 20
  {
    t = t / 10;
    k = k + 1;
  }
  return k;
}

fn sums(m: u64) -> u64
  requires m <= 200
{
  let mut i = 0;
  let mut s = 0;
  while i < m
    invariant i <= m && m <= 200
  {
    let mut v = wrap_mul(i, 2654435761);
    let mut j = 0;
    while j < 5
      invariant j <= 5
    {
      s = wrap_add(s, v % 7 + v / 13);
      v = v / 10;
      j = j + 1;
    }
    i = i + 1;
  }
  return s % 100000;
}

fn main() -> u64 {
  let mut i = 0;
  let mut tot = 0;
  while i < 300
    invariant i <= 300
  {
    tot = wrap_add(tot, digits(wrap_mul(i, 1000003)));
    i = i + 1;
  }
  print(tot);
  print(sums(150));
  print(digits(12345678901234567890));
  return 0;
}
