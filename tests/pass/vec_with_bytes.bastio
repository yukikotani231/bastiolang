// expect-exit: 0
// A `vec_with` on a Vec of Bytes lends the element where it lies: the
// native-ir backend loaded its two words in the wrong order.

fn len_of(b: &Bytes) -> u64 { return blen(b); }

fn first_of(b: &Bytes, k: u64) -> u64 {
  if blen(b) == 0 { return k; }
  return wrap_add(cast[u64](bget(b, 0)), k);
}

fn main() -> u64 {
  let mut v = vec_new[Bytes]();
  vec_push(&mut v, balloc(3));
  let mut w = balloc(5);
  bset(&mut w, 0, 7);
  vec_push(&mut v, w);
  let r = vec_with(v, 1, len_of);
  let s = vec_with(v, 1, first_of, 2);
  while vec_len(v) > 0 { bfree(vec_pop(&mut v)); }
  vec_free(v);
  if r != 5 { return 1; }
  if s != 9 { return 2; }
  return 0;
}
