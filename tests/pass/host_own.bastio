// stage1-only: host_own and host_return (an owned Host in a struct)
// expect-output: 3
// expect-exit: 0
// A program keeps its Host in a struct, calls host builtins through the
// field, and gives it back with host_return (a Host is linear: it cannot be
// dropped).

struct Vm {
  host: Host,
  calls: u64,
}

fn vm_args(vm: &mut Vm) -> u64 {
  vm.calls = wrap_add(vm.calls, 1);
  return host_argc(vm.host);
}

fn vm_say(vm: &Vm, text: &Bytes) {
  host_eprint(vm.host, text);
}

fn main(h: &mut Host) -> u64 {
  let mut vm = Vm { host: host_own(h), calls: 2 };
  let n = vm_args(&mut vm);
  let hi = bfrom("");
  vm_say(vm, hi);
  bfree(hi);
  let k = vm.calls;
  host_return(vm.host);
  print(k);
  if n == 0 {
    return 1;
  }
  return 0;
}
