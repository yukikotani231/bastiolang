// native backend: a loop that runs a small, constant number of times is
// written out once per trip (iropt_unroll); the results must be those of the
// loop, including a value carried from one trip to the next, the loop
// variable read after the loop, a step other than 1 and a nested loop.
// expect-exit: 0

fn carried() -> u64 {
  let mut sum = 0;
  let mut r = 0;
  while r < 10
    invariant r <= 10
  {
    sum = wrap_add(sum, r);
    r = r + 1;
  }
  return sum;
}

fn after() -> u64 {
  let mut r = 0;
  while r < 7
    invariant r <= 7
  {
    r = r + 1;
  }
  return r;
}

fn stepped() -> u64 {
  let mut acc = 0;
  let mut r = 3;
  while r < 20
    invariant r <= 23
  {
    acc = wrap_add(acc, 1);
    r = r + 4;
  }
  return wrap_add(wrap_mul(acc, 100), r);
}

fn fill(v: &mut Vec[u64], base: u64)
  requires base + 12 <= vlen(v)
  ensures vlen(v) == old(vlen(v))
{
  let mut r = 0;
  while r < 12
    invariant r <= 12 && base + 12 <= vlen(v) && vlen(v) == old(vlen(v))
  {
    vec_set(&mut v, base + r, wrap_mul(r, r));
    r = r + 1;
  }
}

fn nested() -> u64 {
  let mut total = 0;
  let mut a = 0;
  while a < 4
    invariant a <= 4
  {
    let mut b = 0;
    while b < 3
      invariant b <= 3
    {
      total = wrap_add(total, wrap_add(a, b));
      b = b + 1;
    }
    a = a + 1;
  }
  return total;
}

fn main() -> u64 {
  let mut bad = 0;
  if carried() != 45 { bad = 1; }
  if after() != 7 { bad = 2; }
  if stepped() != 5 * 100 + 23 { bad = 3; }
  let mut v = vec_new[u64]();
  let mut i = 0;
  while i < 20
    invariant i <= 20 && vlen(v) == i
  {
    vec_push(&mut v, 1000);
    i = i + 1;
  }
  fill(&mut v, 4);
  if vec_get(v, 3) != 1000 || vec_get(v, 4) != 0 || vec_get(v, 9) != 25 || vec_get(v, 15) != 121 || vec_get(v, 16) != 1000 { bad = 4; }
  if nested() != 30 { bad = 5; }
  vec_free(v);
  return bad;
}
