// expect-exit: 0
// core/md5: the RFC 1321 vectors, the lengths around a block, and the
// HMAC-MD5 vectors of RFC 2202 (including keys longer than a block).
import "core/md5.bastio";
import "core/num.bastio";

/// The lower-case hex text of `d`.
fn hex(d: &Bytes) -> Bytes {
  let mut t = text_new();
  let mut i = 0;
  while i < blen(d)
    invariant i <= blen(d)
  {
    text_push(&mut t, hex_char(cast[u64](bget(d, i)) / 16));
    text_push(&mut t, hex_char(cast[u64](bget(d, i)) % 16));
    i = i + 1;
  }
  return text_finish(t);
}

/// 1 unless the MD5 of the `n` bytes `c` is `want`.
fn same(n: u64, c: u8, want: Str) -> u64
  requires n < 1000000000
  ensures result <= 1
{
  let mut m = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(m) == n
  {
    bset(&mut m, i, c);
    i = i + 1;
  }
  let d = md5(m);
  let h = hex(d);
  let ok = bytes_eq_str(h, want);
  bfree(h);
  bfree(d);
  bfree(m);
  if ok { return 0; }
  return 1;
}

/// 1 unless the MD5 of the text `s` is `want`.
fn text_same(s: Str, want: Str) -> u64
  ensures result <= 1
{
  let m = bfrom(s);
  let d = md5(m);
  let h = hex(d);
  let ok = bytes_eq_str(h, want);
  bfree(h);
  bfree(d);
  bfree(m);
  if ok { return 0; }
  return 1;
}

/// 1 unless HMAC-MD5 of `msg` under the key of `kn` bytes `kc` (or the text `ks` if `kn` is 0) is `want`.
fn mac_same(kn: u64, kc: u8, ks: Str, msg: Str, want: Str) -> u64
  requires kn < 1000
  ensures result <= 1
{
  let mut key = balloc(kn);
  let mut i = 0;
  while i < kn
    invariant i <= kn && blen(key) == kn
  {
    bset(&mut key, i, kc);
    i = i + 1;
  }
  if kn == 0 {
    bfree(key);
    key = bfrom(ks);
  }
  let m = bfrom(msg);
  let d = hmac_md5(key, m);
  let h = hex(d);
  let ok = bytes_eq_str(h, want);
  bfree(h);
  bfree(d);
  bfree(m);
  bfree(key);
  if ok { return 0; }
  return 1;
}

/// The number of checks of this group that fail.
fn group1() -> u64
  ensures result <= 5
{
  return text_same("", "d41d8cd98f00b204e9800998ecf8427e") +
    text_same("abc", "900150983cd24fb0d6963f7d28e17f72") +
    text_same("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", "8215ef0796a20bcaaae116d3876c664a") +
    text_same("The quick brown fox jumps over the lazy dog", "9e107d9d372bb6826bd81d3542a419d6") +
    same(1, 97, "0cc175b9c0f1b6a831c399e269772661");
}

/// The number of checks of this group that fail.
fn group2() -> u64
  ensures result <= 5
{
  return same(55, 97, "ef1772b6dff9a122358552954ad0df65") +
    same(56, 97, "3b0c8ac703f828b04c6c197006d17218") +
    same(57, 97, "652b906d60af96844ebd21b674f35e93") +
    same(63, 97, "b06521f39153d618550606be297466d5") +
    same(64, 97, "014842d480b571495a4a0363793f7367");
}

/// The number of checks of this group that fail.
fn group3() -> u64
  ensures result <= 5
{
  return same(65, 97, "c743a45e0d2e6a95cb859adae0248435") +
    same(119, 97, "8a7bd0732ed6a28ce75f6dabc90e1613") +
    same(120, 97, "5f61c0ccad4cac44c75ff505e1f1e537") +
    same(127, 97, "020406e1d05cdc2aa287641f7ae2cc39") +
    same(128, 97, "e510683b3f5ffe4093d021808bc6ff70");
}

/// The number of checks of this group that fail.
fn group4() -> u64
  ensures result <= 5
{
  return same(129, 97, "b325dc1c6f5e7a2b7cf465b9feab7948") +
    same(1000, 97, "cabe45dcc9ae5b66ba86600cca6b8ba8") +
    same(1000000, 97, "7707d6ae4e027c70eea2a935c2296f21") +
    mac_same(20, 11, "", "Hi There", "5ccec34ea9656392457fa1ac27f08fbc") +
    mac_same(0, 0, "Jefe", "what do ya want for nothing?", "750c783e6ab0b503eaa86e310a5db738");
}

/// The number of checks of this group that fail.
fn group5() -> u64
  ensures result <= 4
{
  return mac_same(131, 170, "", "Test Using Larger Than Block-Size Key - Hash Key First", "bfecaf4efff90a3a668f3922fec3762d") +
    mac_same(131, 170, "", "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.", "09b8ae7b15adbbb243aca3491b51512b") +
    mac_same(64, 7, "", "x", "f3664ef75af47b141c937d4f29885802") +
    mac_same(65, 7, "", "x", "572af423514987c8280315e654897b6f");
}

fn main() -> u64 {
  let bad = group1() + group2() + group3() + group4() + group5();
  if bad > 0 { return 1; }
  return 0;
}
