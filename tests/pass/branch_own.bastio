// expect-exit: 3
// Ownership through branches and early returns: each path consumes the
// buffer exactly once.

fn pick(b: Buf, k: u64) -> u64
  requires len(b) == 3
{
  if k == 0 {
    free(b);
    return 100;
  }
  let v = get(b, 0);
  if v == 0 {
    free(b);
    return 3;
  } else {
    free(b);
  }
  return v;
}

fn main() -> u64 {
  let a = alloc(3);
  return pick(a, 1);
}
