// expect-exit: 0
// core/p256 and core/p384: public keys, ECDH secrets and ECDSA signatures (made with a
// chosen nonce) equal the values computed independently and checked against OpenSSL (the
// public keys and secrets are OpenSSL's, each signature verifies under OpenSSL); a private
// key or nonce of 0 or n, a peer point off the curve and wrong lengths are refused.
import "core/p256.bastio";
import "core/p384.bastio";

/// The value of the hex digit `c` (0 for anything else).
fn nib(c: u8) -> u8
  ensures result < 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 0;
}

/// The bytes written as hex digits in `s`.
fn unhex(s: Str) -> Bytes
  requires slen(s) < 100000
  ensures blen(result) == slen(s) / 2
{
  let n = slen(s) / 2;
  let mut b = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(b) == n && slen(s) >= 2 * n
  {
    bset(&mut b, i, nib(sget(s, 2 * i)) * 16 + nib(sget(s, 2 * i + 1)));
    i = i + 1;
  }
  return b;
}

/// Whether `r` is `Some` of the bytes written as hex in `want`; consumes `r`.
fn is_hex(r: Option[Bytes], want: Str) -> bool
  requires slen(want) < 100000
{
  match r {
    Option::None => { return false; },
    Option::Some(b) => {
      let w = unhex(want);
      let same = bytes_eq(b, w);
      bfree(w);
      bfree(b);
      return same;
    },
  }
}

/// Whether `r` is `None`; consumes `r`.
fn is_none(r: Option[Bytes]) -> bool {
  match r {
    Option::None => { return true; },
    Option::Some(b) => {
      bfree(b);
      return false;
    },
  }
}

fn vec0() -> u64 {
  let d = unhex("d23f0824128b2f330c5c7fd0a6a3a4506513270e269e0d37f2a74de452e6b439");
  let k = unhex("36f675cc81e74ef5e8e25d940ed904759531985d5d9dc9f81818e811892f902c");
  let dg = unhex("1fc0214264e80a6677ef3fce610ca52f0758c7dbbcdc48f44b0ed9f166b1d2c4");
  let peer = unhex("0477c552ac5c9dfd5f7b358dc2b7386adce7948e099d045f7f551bf78257170e8dbca9fbce99cfc1f420283957fedad27ac005001f10516a162b9806330d27256f");
  let mut bad = 0;
  if !is_hex(ecdsa_p256_public_key(d), "0414b8a2c95626f164e38703bd976b200e0650503e4b701ecbf29f96abf786d31f9b978f67b1ea482736e63b98c445745a521135bf468d6d0c168ef66a4163f46f") { bad = bad + 1; }
  if !is_hex(ecdsa_p256_sign_digest(d, dg, k), "8dd0cb91f783328c76cbdbdc3106e4435e34cd7635a747f135f4457e8ecf1a6ca3144e0d717716e30f102fe8f57efd092de7bae91ad99a766c8f0b5ae9e040e1") { bad = bad + 1; }
