// expect-exit: 0
// expect-stdout: 17515
// expect-stdout: 348285
// expect-stdout: 783
// expect-stdout: 99225
// `a || b` and `a && b` of two comparisons guarding a short pure arm become
// one branch, then a mask (native-ir). The cases: `||` and `&&` with a
// constant conditional add (the `d + flag` form), `||` with a conditional
// add of a larger constant, and an error-style check with an empty arm that
// must stay two branches.
fn run(n: u64) -> u64
  requires n < 1000000
{
  let mut x = 12345;
  let mut a = 0;
  let mut b = 0;
  let mut c = 0;
  let mut d = 0;
  let mut i = 0;
  while i < n
    invariant i <= n && x < 4294967296 && a <= i && b <= i * 7 && c <= i && d <= i
  {
    x = (x * 1103515245 + 12345) % 4294967296;
    let v = (x / 65536) % 256;
    if v < 20 || v > 230 {
      a = a + 1;
    }
    if v > 64 && v < 192 {
      b = b + 7;
    }
    if v == 3 || v == 100 {
      c = c + 1;
    }
    if v == 255 || v == 0 {
      d = d + 0;
    } else {
      d = d + 1;
    }
    i = i + 1;
  }
  print(a);
  print(b);
  print(c);
  print(d);
  return 0;
}

fn main() -> u64 {
  return run(100000);
}
