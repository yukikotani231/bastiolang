// expect-exit: 0
// expect-stdout: 14
// expect-stdout: 25
// expect-stdout: 23
// A long chain of equality tests whose constants form runs of three or more
// consecutive values with one target is tested by ranges (`x - lo < len`) by
// the IR backends. Every value from 0 to 299 is tried: the members, the
// ends of the runs and the gaps between and around them, and a run of
// constants that changes target part way through.
fn memb(n: u64) -> bool {
  return n == 41 || n == 42 || n == 43 || n == 44 || n == 45 || n == 48 || n == 49 || n == 50
    || n == 51 || n == 52 || n == 53 || n == 54 || n == 55 || n == 288;
}

fn split(n: u64) -> u64 {
  if n == 10 { return 1; }
  if n == 11 { return 1; }
  if n == 12 { return 1; }
  if n == 13 { return 2; }
  if n == 14 { return 2; }
  if n == 15 { return 3; }
  if n == 16 { return 3; }
  if n == 17 { return 3; }
  if n == 200 { return 4; }
  if n == 18446744073709551615 { return 5; }
  return 0;
}

fn small(n: u64) -> bool {
  return n == 3 || n == 4 || n == 5;
}

fn main() -> u64 {
  let mut a = 0;
  let mut b = 0;
  let mut c = 0;
  let mut n = 0;
  while n < 300 {
    if memb(n) {
      a = wrap_add(a, 1);
    }
    b = wrap_add(b, split(n));
    if small(n) {
      c = wrap_add(c, 1);
    }
    n = n + 1;
  }
  b = wrap_add(b, split(18446744073709551615));
  print(a);
  print(b);
  print(wrap_add(c, 20));
  if a != 14 || b != 25 || c != 3 {
    return 1;
  }
  return 0;
}
