// expect-exit: 0
// stage1-only: host_spawn_err, child_read_err_line, child_kill and child_pid
// backend: c
import "../../std/os.bastio";

// A child with its own standard error pipe, and a signal sent to a child.

fn arg(v: &mut Vec[Bytes], s: Str) {
  vec_push(&mut v, bfrom(s));
}

fn drop_args(v: Vec[Bytes]) {
  let mut w = v;
  while vec_len(w) > 0 {
    bfree(vec_pop(&mut w));
  }
  vec_free(w);
}

fn main(h: &mut Host) -> u64 {
  let mut bad = 0;

  // sh writes one line to each stream; they arrive on separate pipes.
  let mut argv = vec_new[Bytes]();
  arg(&mut argv, "sh");
  arg(&mut argv, "-c");
  arg(&mut argv, "echo out; echo err >&2");
  let mut c = host_spawn_err(h, argv);
  drop_args(argv);
  let mut line = balloc(0);
  if !child_read_line(&mut c, &mut line) || blen(line) != 3 || bget(line, 0) != 111 {
    bad = bad + 1;
  }
  if !child_read_err_line(&mut c, &mut line) || blen(line) != 3 || bget(line, 0) != 101 {
    bad = bad + 1;
  }
  if child_read_err_line(&mut c, &mut line) {
    bad = bad + 1;
  }
  if child_wait(c) != 0 {
    bad = bad + 1;
  }

  // A child that would wait for a minute is ended by SIGTERM (15).
  let mut argv2 = vec_new[Bytes]();
  arg(&mut argv2, "sleep");
  arg(&mut argv2, "60");
  let k = host_spawn_err(h, argv2);
  drop_args(argv2);
  if !child_kill(k, 15) {
    bad = bad + 1;
  }
  if child_wait(k) == 0 {
    bad = bad + 1;
  }

  // child_pid is the id the shell reports as $$.
  let mut argv4 = vec_new[Bytes]();
  arg(&mut argv4, "sh");
  arg(&mut argv4, "-c");
  arg(&mut argv4, "echo $$");
  let mut q = host_spawn_err(h, argv4);
  drop_args(argv4);
  let qpid = child_pid(q);
  let mut told = 0;
  if child_read_line(&mut q, &mut line) {
    let mut j = 0;
    while j < blen(line)
      invariant j <= blen(line) && told <= 18446744073709551615 / 10 - 10
    {
      let d = bget(line, j);
      if d >= 48 && d <= 57 && told < 1000000000000 {
        told = told * 10 + cast[u64](d) - 48;
      }
      j = j + 1;
    }
  }
  // On Windows the shell's $$ is the MSYS id, not the process id: only check it is not 0.
  let mut win = true;
  match os_pipe(h) {
    Option::Some(pp) => {
      win = !os_nonblock(h, pp.start, true);
      os_close(h, pp.start);
      os_close(h, pp.end);
    },
    Option::None => {},
  }
  if qpid == 0 || (!win && told != qpid) {
    bad = bad + 1;
  }
  if child_wait(q) != 0 {
    bad = bad + 1;
  }

  // A program that cannot be started: nothing to read. (Whether kill finds a
  // process depends on how the C library reports the failed exec, so it is not
  // checked.)
  let mut argv3 = vec_new[Bytes]();
  arg(&mut argv3, "no-such-program-bastio");
  let mut z = host_spawn_err(h, argv3);
  drop_args(argv3);
  if child_read_err_line(&mut z, &mut line) {
    bad = bad + 1;
  }
  if child_wait(z) != 127 {
    bad = bad + 1;
  }
  bfree(line);
  return bad;
}
