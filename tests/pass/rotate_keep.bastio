// expect-exit: 0
// expect-stdout: 1048575
// expect-stdout: 3
// expect-stdout: 5050
// A loop whose test computes a value (a load reduced with `%`) that the body
// reads again, and a loop that leaves on its true branch. Both are tested
// again at the bottom; the value must come out the same as when it is tested
// at the top.
const N: u64 = 1024;

fn root(p: &Buf, start: u64) -> u64
  requires len(p) == N && start < N
  ensures result < N
{
  let mut r = start;
  while get(p, r) % N != r
    invariant len(p) == N && r < N
  {
    r = get(p, get(p, r) % N) % N;
  }
  return r;
}

fn main() -> u64 {
  let mut p = alloc(N);
  let mut i = 0;
  while i < N
    invariant i <= N && len(p) == N
  {
    p = set(p, i, i);
    i = i + 1;
  }
  p = set(p, 5, 4);
  p = set(p, 4, 3);
  p = set(p, 3, 2);
  p = set(p, 2, 1);
  p = set(p, 1, 0);
  p = set(p, 7, 3);
  print(root(p, 1023) + 1048575 - 1023);
  print(root(p, 5) + root(p, 7) + 3 - 0);
  let mut s = 0;
  let mut k = 0;
  while !(k >= 100)
    invariant k <= 100 && s <= k * 100
  {
    k = k + 1;
    s = s + k;
  }
  print(s);
  free(p);
  return 0;
}
