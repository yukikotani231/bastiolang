// Reloads of spilled values (stage1/irx86.bastio, ix_reload) and boxes of a
// known size (malloc called directly on a hosted target).
// expect-exit: 0
// expect-stdout: 88868
// Many values are live at once, so some of them, the addresses of the boxes
// among them, live in the frame; each box is filled field by field through
// its address, and the sums read it back after other stores and a call.
struct P { a: u64, b: u64, c: u64, d: u64 }

fn mk(x: u64, y: u64) -> Box[P] {
  return box(P { a: x, b: y, c: wrap_add(x, y), d: wrap_mul(x, 3) });
}

fn mix(p: Box[P], q: Box[P], r: Box[P], s: Box[P], t: Box[P], u: Box[P], k: u64) -> u64 {
  let a = unbox(p);
  let b = unbox(q);
  let c = unbox(r);
  let d = unbox(s);
  let e = unbox(t);
  let f = unbox(u);
  return wrap_add(wrap_add(wrap_mul(a.a, k), wrap_mul(b.b, 2)), wrap_add(wrap_add(c.c, d.d), wrap_add(wrap_mul(e.a, e.d), f.b)));
}

fn main() -> u64 {
  let mut t = 0;
  let mut i = 1;
  while i < 40
    invariant i <= 40
  {
    let p = mk(i, 1);
    let q = mk(wrap_add(i, 2), 5);
    let r = mk(wrap_mul(i, 7), 9);
    let s = mk(3, i);
    let u = mk(i, i);
    let v = mk(wrap_add(i, 11), 4);
    t = wrap_add(t, mix(p, q, r, s, u, v, i));
    i = i + 1;
  }
  print(t);
  return 0;
}
