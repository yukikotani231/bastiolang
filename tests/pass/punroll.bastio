// expect-exit: 0
// expect-stdout: 3990
// expect-stdout: 4475
// expect-stdout: 484
// expect-stdout: 12
// expect-stdout: 16
// Counted loops that the native-ir backend unrolls by 2 or 4 (iropt_punroll):
// a sum over a buffer with a strided second index, a loop that also stores,
// a trip count divisible only by 2, and one divisible by neither (left alone).
fn dot(a: &Buf, b: &Buf) -> u64
  requires len(a) == 400 && len(b) == 400
{
  let mut s = 0;
  let mut k = 0;
  while k < 400
    invariant k <= 400 && len(a) == 400 && len(b) == 400
  {
    s = wrap_add(s, wrap_mul(get(a, k), get(b, 399 - k)));
    k = k + 1;
  }
  return s;
}

fn fill(mut a: Buf, m: u64) -> Buf
  requires len(a) == 400 && m < 100
  ensures len(result) == 400
{
  let mut k = 0;
  while k < 400
    invariant k <= 400 && len(a) == 400
  {
    a = set(a, k, k * m % 7);
    k = k + 1;
  }
  return a;
}

fn pairs(a: &Buf) -> u64
  requires len(a) == 400
{
  let mut s = 0;
  let mut k = 0;
  while k < 160
    invariant k <= 161 && len(a) == 400
  {
    s = wrap_add(s, wrap_add(get(a, k), get(a, k + 200)));
    k = k + 2;
  }
  return s;
}

fn odd(a: &Buf) -> u64
  requires len(a) == 400
{
  let mut s = 0;
  let mut k = 0;
  while k < 3
    invariant k <= 3 && len(a) == 400
  {
    s = wrap_add(s, wrap_add(get(a, k), 1));
    k = k + 1;
  }
  return s;
}

fn six(a: &Buf) -> u64
  requires len(a) == 400
{
  let mut s = 0;
  let mut k = 0;
  while k < 6
    invariant k <= 6 && len(a) == 400
  {
    s = wrap_add(s, get(a, k * 3));
    k = k + 1;
  }
  return s;
}

fn main() -> u64 {
  let a = fill(alloc(400), 3);
  let b = fill(alloc(400), 5);
  print(dot(a, b));
  print(wrap_add(pairs(a), dot(b, a)));
  print(pairs(b));
  print(odd(a));
  print(six(a));
  free(a);
  free(b);
  return 0;
}
