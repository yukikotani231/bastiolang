// Unsigned division and remainder by a constant power of two, including the
// largest one, must agree with the general division.
fn quarter(x: u64) -> u64 { return x / 4; }
fn odd(x: u64) -> u64 { return x % 2; }
fn low(x: u64) -> u64 { return x % 4; }
fn top(x: u64) -> u64 { return x % 9223372036854775808; }
fn one(x: u64) -> u64 { return x / 9223372036854775808; }

fn main() -> u64 {
  let big = 18446744073709551615;
  print(quarter(big));
  print(odd(big));
  print(low(23));
  print(top(big));
  print(one(big));
  return 0;
}
