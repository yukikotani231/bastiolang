// expect-exit: 0
// expect-stdout: 661947862
// expect-stdout: 10
// expect-stdout: 2
// A chain of equality tests whose false labels are followed by another, unused
// label (`if n == 1 { .. } if n == 2 { .. }` leaves one after every test)
// is still a chain: the tests become a search. A join in the middle (the
// first `if`, which falls into the second) stays where it is.
fn lk(n0: u64, a: u64) -> u64 {
  let mut n = n0;
  if n == 435 { n = 56; }
  if n == 435 { return 1; }
  if n == 60 && a > 5 { return 2; }
  if n == 60 || n == 231 { return 3; }
  if n == 202 { return 4; }
  if n == 169 { return 5; }
  if n == 0 || n == 19 { return 6; }
  if n == 1 || n == 20 { return 7; }
  if n == 22 { return 8; }
  if n == 293 { return 9; }
  if n == 56 { return 10; }
  return 0;
}

fn main() -> u64 {
  let mut s = 0;
  let mut n = 0;
  while n < 500
    invariant n <= 500
  {
    s = wrap_add(wrap_mul(s, 31), wrap_add(lk(n, 3), wrap_mul(lk(n, 9), 11)));
    s = s % 1000000007;
    n = n + 1;
  }
  print(s);
  print(lk(435, 0));
  print(lk(60, 9));
  return 0;
}
