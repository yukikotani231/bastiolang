// expect-exit: 42
// stage1-only: par_each
// backend: c
// Sums slices of one vector on every processor at once. Each call of
// `part` writes only its own job; the data is a shared borrow, which
// cannot change, and the count of calls goes through an Atomic.

struct Job { lo: u64, hi: u64, sum: u64 } invariant lo <= hi;

fn part(j: &mut Job, data: &Vec[u64], calls: &Atomic[u64])
  requires j.lo <= j.hi
  ensures j.lo <= j.hi
{
  atomic_wrap_add(calls, 1);
  if j.hi > vec_len(data) {
    return;
  }
  let mut s = 0;
  let mut k = j.lo;
  while k < j.hi invariant k <= j.hi && j.hi <= vlen(data) && s <= 1000000000 {
    let x = vec_get(data, k);
    if x < 100 && s < 1000000000 - 100 {
      s = s + x;
    }
    k = k + 1;
  }
  j.sum = s;
}

fn main() -> u64 {
  let mut data = vec_new[u64]();
  let mut k = 0;
  let mut want = 0;
  while k < 100000 invariant want <= k * 6 {
    vec_push(&mut data, k % 7);
    want = want + k % 7;
    k = k + 1;
  }
  let mut jobs = vec_new[Job]();
  let mut lo = 0;
  while lo < 100000 invariant true {
    let mut hi = lo + 777;
    if hi > 100000 {
      hi = 100000;
    }
    vec_push(&mut jobs, Job { lo: lo, hi: hi, sum: 0 });
    lo = hi;
  }
  let calls = atomic_new(cast[u64](0));
  par_each(&mut jobs, part, data, calls);
  let mut got = 0;
  let n = vec_len(jobs);
  while vec_len(jobs) > 0 invariant got <= 1000000000000 {
    let j = vec_pop(&mut jobs);
    if got < 1000000000000 - 1000000000 && j.sum <= 1000000000 {
      got = got + j.sum;
    }
  }
  vec_free(jobs);
  vec_free(data);
  let c = atomic_load(calls);
  atomic_end(calls);
  if got == want && c == n {
    return 42;
  }
  return 1;
}
