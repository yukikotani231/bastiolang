  let mut sig = unhex("c1a2005b2961039add42e3700ed00e47bc02b457ecf5070a93ab3402eb7536a6ceb28a08fa559f2f0209d95478b71a954a2837fb05ecf3c8e2c02aab104e8d9448cbdee323313c0d2049fb55eeff7d2c9e90ce98cfed8330f9b66d5f58e4fd960e77cc50fcffc4fe2f3dd4bd5002a8b55687b1fc38944ca8876cd5fb6fd2533d");
  if !rsa_pss_verify_salt(n, e, msg, sig, 64, 62, 64) { bad = wrap_add(bad, 1); }
  if rsa_pss_verify_salt(n, e, msg, sig, 64, 63, 64) { bad = wrap_add(bad, 1); }
  bset(&mut sig, 7, bget(sig, 7) ^ 1);
  if rsa_pss_verify_salt(n, e, msg, sig, 64, 62, 64) { bad = wrap_add(bad, 1); }
  bfree(sig);
  bfree(salt);
  bfree(msg);
  return bad;
}

fn key1() -> u64 {
  let n = unhex("dbff68e970882a4dc3442c4a9cfaf9253cd31328ff9c62d445a84b718598b11d72b295482c323c8297681d4749af68424e74d1557d4a160d42e2e64ed37757afae75e3c5160daac08e384d0cb7a48675f2dcf8179f39c0de41d5ea28fc00adc65730ee1250a995ed60a547db6ba1287331f167a60f8b306d1a13625f2c02f1a5");
  let d = unhex("0f6b01fe423db8c1446b15b390f6e1d9233f23bb9ed665f2bc8303ee8bcf5cb254a48163d27d1ed2842beec95d37a6d5e6cbb71407b8d67ccd703b75d0ca2f61e64e1ba05f2682ef05fbcb43c5ceec534f43a85073350c9a6d799981f5bfe978ae31ff30227fd36535d95f08540c576afc1f9262664e0a7dd39f3af0c57dd121");
  let e = unhex("010001");
  let mut bad = 0;
  bad = wrap_add(bad, k1_t0(n, d, e));
  bad = wrap_add(bad, k1_t1(n, d, e));
  bad = wrap_add(bad, k1_t2(n, d, e));
  bad = wrap_add(bad, k1_t3(n, d, e));
  bad = wrap_add(bad, k1_t4(n, d, e));
  bad = wrap_add(bad, k1_t5(n, d, e));
  bad = wrap_add(bad, k1_t6(n, d, e));
  bad = wrap_add(bad, k1_t7(n, d, e));
  bad = wrap_add(bad, k1_t8(n, d, e));
  bad = wrap_add(bad, k1_t9(n, d, e));
  let msg = unhex("00");
  // Under the default minimum of 256 bytes the small key is refused.
  if !is_none(rsa_pkcs1_sign(n, d, msg, 32, 256)) { bad = wrap_add(bad, 1); }
  bfree(msg);
  bfree(e);
  bfree(d);
  bfree(n);
  return bad;
}

fn main() -> u64 {
  let mut bad = 0;
  bad = wrap_add(bad, key0());
  bad = wrap_add(bad, key1());
  return bad;
}
