  let salt = unhex("4f77cadafad3f4fc6965b87db62e6aa4318ce183");
  let mut bad = 0;
  if !is_hex(rsa_pss_sign(n, d, msg, salt, 48, 64), "d1c0fe7f4d5e981962fe6cc2aabde68be22a31c8423334e7fb83a8ee5c4151aa5669beb0aec012434a2cfd365761ef098f61a4a8332d7ac26f2794df02feca6a07d1eae8e29eb3551b2c9011ac7b25c8da2dd479bc716483fab4482a31ef127d5d57191cd296faa610413d5ec23612d03a7313304c4fbcfab10276c5334f0ed2") { bad = wrap_add(bad, 1); }
  let mut sig = unhex("d1c0fe7f4d5e981962fe6cc2aabde68be22a31c8423334e7fb83a8ee5c4151aa5669beb0aec012434a2cfd365761ef098f61a4a8332d7ac26f2794df02feca6a07d1eae8e29eb3551b2c9011ac7b25c8da2dd479bc716483fab4482a31ef127d5d57191cd296faa610413d5ec23612d03a7313304c4fbcfab10276c5334f0ed2");
  if !rsa_pss_verify_salt(n, e, msg, sig, 48, 20, 64) { bad = wrap_add(bad, 1); }
  if rsa_pss_verify_salt(n, e, msg, sig, 48, 21, 64) { bad = wrap_add(bad, 1); }
  bset(&mut sig, 7, bget(sig, 7) ^ 1);
  if rsa_pss_verify_salt(n, e, msg, sig, 48, 20, 64) { bad = wrap_add(bad, 1); }
  bfree(sig);
  bfree(salt);
  bfree(msg);
  return bad;
}

fn k1_t6(n: &Bytes, d: &Bytes, e: &Bytes) -> u64
  requires blen(n) < 65536 && blen(d) < 65536 && blen(e) < 65536
{
  let pt = unhex("77526fe0dd1c0c8e71a7a46216faf081bf01c6d8761965d69e79ea6857cf");
  let seed = unhex("45f44a021084d121ca9431e01c149542b69df0a07444f98f1f4537e461a4d68852f79592ab616fd56ceebe53f3bdcf3e");
  let label = unhex("");
  let other = unhex("ab");
  let mut bad = 0;
  if !is_hex(rsa_oaep_encrypt(n, e, pt, label, seed, 48, 64), "98d61e0ee74a6cc070f7892616918a32dfc39a2cf92b200313c478e83cfa994179522f74029606ea5884c1bdf9d3cdce1d83ca1cb8a1d1a83e7865c717e1be23abbf61f9158fbbbfe5eb00de0f2933ce85a20f392f554a0c699b2ccdd7a3e66130fcc52a3eb700b9305591167abf4907caa982cda53b88a5685d46a340b70aa1") { bad = wrap_add(bad, 1); }
  let mut ct = unhex("98d61e0ee74a6cc070f7892616918a32dfc39a2cf92b200313c478e83cfa994179522f74029606ea5884c1bdf9d3cdce1d83ca1cb8a1d1a83e7865c717e1be23abbf61f9158fbbbfe5eb00de0f2933ce85a20f392f554a0c699b2ccdd7a3e66130fcc52a3eb700b9305591167abf4907caa982cda53b88a5685d46a340b70aa1");
  if !is_hex(rsa_oaep_decrypt(n, d, ct, label, 48, 64), "77526fe0dd1c0c8e71a7a46216faf081bf01c6d8761965d69e79ea6857cf") { bad = wrap_add(bad, 1); }
  if !is_none(rsa_oaep_decrypt(n, d, ct, other, 48, 64)) { bad = wrap_add(bad, 1); }
  bset(&mut ct, 9, bget(ct, 9) ^ 1);
  if !is_none(rsa_oaep_decrypt(n, d, ct, label, 48, 64)) { bad = wrap_add(bad, 1); }
  bfree(ct);
  bfree(other);
  bfree(label);
  bfree(seed);
  bfree(pt);
  return bad;
}

