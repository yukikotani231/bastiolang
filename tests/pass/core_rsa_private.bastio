fn k1_t8(n: &Bytes, d: &Bytes, e: &Bytes) -> u64
  requires blen(n) < 65536 && blen(d) < 65536 && blen(e) < 65536
{
  let msg = unhex("95546a5171150463cfdd89ad9a6f8ed577");
  let mut bad = 0;
  if !is_hex(rsa_pkcs1_sign(n, d, msg, 64, 64), "8a34281c03fe99915e0bfe98f7e7e8a74a8b5fd97d5e2cc23bcf593043ed4bb35df3d54c53c4ab9da1ddf023da8f1079a6f2843cf0b135846013696bfc7d9afbac419c6daccf434ddfbc60c2398283efd1e904b5a5e943f69fbebbd16a9d5a897aad564c603640f37dd5a8a574918baccd5ac969bb3f540ce95322c68da7ae80") { bad = wrap_add(bad, 1); }
  let mut sig = unhex("8a34281c03fe99915e0bfe98f7e7e8a74a8b5fd97d5e2cc23bcf593043ed4bb35df3d54c53c4ab9da1ddf023da8f1079a6f2843cf0b135846013696bfc7d9afbac419c6daccf434ddfbc60c2398283efd1e904b5a5e943f69fbebbd16a9d5a897aad564c603640f37dd5a8a574918baccd5ac969bb3f540ce95322c68da7ae80");
  if !rsa_pkcs1_verify_min(n, e, msg, sig, 64, 64) { bad = wrap_add(bad, 1); }
  bset(&mut sig, 5, bget(sig, 5) ^ 1);
  if rsa_pkcs1_verify_min(n, e, msg, sig, 64, 64) { bad = wrap_add(bad, 1); }
  bfree(sig);
  bfree(msg);
  return bad;
}

fn k1_t9(n: &Bytes, d: &Bytes, e: &Bytes) -> u64
  requires blen(n) < 65536 && blen(d) < 65536 && blen(e) < 65536
{
  let msg = unhex("95546a5171150463cfdd89ad9a6f8ed577");
  let salt = unhex("dbecf025ddaeb2e43c1a90d305725ac551b53802246293e0c828f6997f159670f3fa3288dd2b2588f73dc78204d75e88d9335814a392b988dfc1e664408b");
