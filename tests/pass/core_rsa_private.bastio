fn key0() -> u64 {
  let n = unhex("");
  let d = unhex("");
  let e = unhex("010001");
  let mut bad = 0;
  bad = wrap_add(bad, k0_t0(n, d, e));
  bad = wrap_add(bad, k0_t1(n, d, e));
  bad = wrap_add(bad, k0_t2(n, d, e));
  bad = wrap_add(bad, k0_t3(n, d, e));
  bad = wrap_add(bad, k0_t4(n, d, e));
  bad = wrap_add(bad, k0_t5(n, d, e));
  bad = wrap_add(bad, k0_t6(n, d, e));
  bad = wrap_add(bad, k0_t7(n, d, e));
  bad = wrap_add(bad, k0_t8(n, d, e));
  bad = wrap_add(bad, k0_t9(n, d, e));
  bad = wrap_add(bad, k0_t10(n, d, e));
  bad = wrap_add(bad, k0_t11(n, d, e));
  bfree(e);
  bfree(d);
  bfree(n);
  return bad;
}

fn k1_t0(n: &Bytes, d: &Bytes, e: &Bytes) -> u64
  requires blen(n) < 65536 && blen(d) < 65536 && blen(e) < 65536
{
  let msg = unhex("a49d712305e7b0ec3daec0f49c9a732b58");
  let mut bad = 0;
  if !is_hex(rsa_pkcs1_sign(n, d, msg, 32, 64), "14eefd824e735b3860837a54eafdb8e50db3fe4e75f432310477fe25ceb795fb4a32ce2921bafae278acc4c73cc11834bcbf27f27496bd659fa84ae19968abcad061c47ac5faa373fd2298b79b5aeafe168691cd41b7a49cc8e98fe9094d0f0704a5772f8088348337ac1383ef01edb13e6c9bd84cea2bc1b45714e5a8f60114") { bad = wrap_add(bad, 1); }
  let mut sig = unhex("14eefd824e735b3860837a54eafdb8e50db3fe4e75f432310477fe25ceb795fb4a32ce2921bafae278acc4c73cc11834bcbf27f27496bd659fa84ae19968abcad061c47ac5faa373fd2298b79b5aeafe168691cd41b7a49cc8e98fe9094d0f0704a5772f8088348337ac1383ef01edb13e6c9bd84cea2bc1b45714e5a8f60114");
  if !rsa_pkcs1_verify_min(n, e, msg, sig, 32, 64) { bad = wrap_add(bad, 1); }
  bset(&mut sig, 5, bget(sig, 5) ^ 1);
  if rsa_pkcs1_verify_min(n, e, msg, sig, 32, 64) { bad = wrap_add(bad, 1); }
  bfree(sig);
  bfree(msg);
  return bad;
}

