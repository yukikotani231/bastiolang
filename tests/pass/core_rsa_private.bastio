// expect-exit: 0
// core/rsa: signatures, ciphertexts and decryptions with a private key. RSASSA-PKCS1-v1_5
// signatures equal OpenSSL's (they are deterministic); RSASSA-PSS signatures and RSAES-OAEP
// ciphertexts made with a chosen salt or seed equal an independent encoder's, whose output
// OpenSSL accepts; ciphertexts made by OpenSSL decrypt. Keys of 2048 and 1024 bits (with a
// smaller minimum), SHA-256, SHA-384 and SHA-512. A wrong label, a changed ciphertext, a
// message too long, a small key under the 2048-bit minimum and a changed signature fail.
import "core/rsa.bastio";

/// The value of the hex digit `c` (0 for anything else).
fn nib(c: u8) -> u8
  ensures result < 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 0;
}

/// The bytes written as hex digits in `s`.
fn unhex(s: Str) -> Bytes
  requires slen(s) < 100000
  ensures blen(result) == slen(s) / 2
{
  let n = slen(s) / 2;
  let mut b = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(b) == n && slen(s) >= 2 * n
  {
    bset(&mut b, i, nib(sget(s, 2 * i)) * 16 + nib(sget(s, 2 * i + 1)));
    i = i + 1;
  }
  return b;
}

/// Whether `r` is `Some` of the bytes written as hex in `want`; consumes `r`.
fn is_hex(r: Option[Bytes], want: Str) -> bool
  requires slen(want) < 100000
{
  match r {
    Option::None => { return false; },
    Option::Some(b) => {
      let w = unhex(want);
      let same = bytes_eq(b, w);
      bfree(w);
      bfree(b);
      return same;
    },
  }
}

/// Whether `r` is `None`; consumes `r`.
fn is_none(r: Option[Bytes]) -> bool {
  match r {
    Option::None => { return true; },
    Option::Some(b) => {
      bfree(b);
      return false;
    },
  }
}

fn k0_t0(n: &Bytes, d: &Bytes, e: &Bytes) -> u64
  requires blen(n) < 65536 && blen(d) < 65536 && blen(e) < 65536
{
  let msg = unhex("45c7cabe8b689837c9b1271e5a83c4f77b");
  let mut bad = 0;
  if !is_hex(rsa_pkcs1_sign(n, d, msg, 32, 256), "") { bad = wrap_add(bad, 1); }
  let mut sig = unhex("");
  if !rsa_pkcs1_verify_min(n, e, msg, sig, 32, 256) { bad = wrap_add(bad, 1); }
  bset(&mut sig, 5, bget(sig, 5) ^ 1);
  if rsa_pkcs1_verify_min(n, e, msg, sig, 32, 256) { bad = wrap_add(bad, 1); }
  bfree(sig);
  bfree(msg);
  return bad;
}

fn k0_t1(n: &Bytes, d: &Bytes, e: &Bytes) -> u64
  requires blen(n) < 65536 && blen(d) < 65536 && blen(e) < 65536
{
  let msg = unhex("45c7cabe8b689837c9b1271e5a83c4f77b");
  let salt = unhex("2de3ef3f4171e45ac8ab46911a4458b9667a54116ed3eddf33010b202fbfa629");
  let mut bad = 0;
  if !is_hex(rsa_pss_sign(n, d, msg, salt, 32, 256), "") { bad = wrap_add(bad, 1); }
  let mut sig = unhex("");
  if !rsa_pss_verify_salt(n, e, msg, sig, 32, 32, 256) { bad = wrap_add(bad, 1); }
  if rsa_pss_verify_salt(n, e, msg, sig, 32, 33, 256) { bad = wrap_add(bad, 1); }
  bset(&mut sig, 7, bget(sig, 7) ^ 1);
  if rsa_pss_verify_salt(n, e, msg, sig, 32, 32, 256) { bad = wrap_add(bad, 1); }
  bfree(sig);
  bfree(salt);
  bfree(msg);
  return bad;
}

fn k0_t2(n: &Bytes, d: &Bytes, e: &Bytes) -> u64
  requires blen(n) < 65536 && blen(d) < 65536 && blen(e) < 65536
{
  let pt = unhex("a10ee46d50229578d80561f83e789f903b36c5e110cfef7eaa1166e48346");
  let seed = unhex("536868bb5b4124520424111a3649b3ac8ebe0d6ff7d29d20d4d502d749ba5b61");
  let label = unhex("6b51c4");
  let other = unhex("ab");
  let mut bad = 0;
  if !is_hex(rsa_oaep_encrypt(n, e, pt, label, seed, 32, 256), "") { bad = wrap_add(bad, 1); }
  let mut ct = unhex("");
  if !is_hex(rsa_oaep_decrypt(n, d, ct, label, 32, 256), "a10ee46d50229578d80561f83e789f903b36c5e110cfef7eaa1166e48346") { bad = wrap_add(bad, 1); }
  if !is_none(rsa_oaep_decrypt(n, d, ct, other, 32, 256)) { bad = wrap_add(bad, 1); }
  bset(&mut ct, 9, bget(ct, 9) ^ 1);
  if !is_none(rsa_oaep_decrypt(n, d, ct, label, 32, 256)) { bad = wrap_add(bad, 1); }
  bfree(ct);
  bfree(other);
  bfree(label);
  bfree(seed);
  bfree(pt);
  return bad;
}

