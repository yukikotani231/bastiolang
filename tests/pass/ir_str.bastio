// expect-exit: 31
// A `Str` (a literal, a parameter, a field) in the IR: `slen`, `sget`, and
// literals that are shared with the old generator's data.
struct Label { name: Str, weight: u64 }

fn first(s: &Str) -> u64 {
  if slen(s) > 0 {
    return cast[u64](sget(s, 0));
  }
  return 0;
}

fn total(s: Str) -> u64 {
  let mut t = 0;
  let mut i = 0;
  while i < slen(s)
    invariant i <= slen(s)
  {
    t = wrap_add(t, cast[u64](sget(s, i)));
    i = i + 1;
  }
  return t;
}

fn pick(flag: bool) -> Str {
  if flag {
    return "ab";
  }
  return "xyz";
}

fn weigh(l: &Label) -> u64
  requires l.weight < 1000
{
  return slen(l.name) + l.weight;
}

fn main() -> u64 {
  let a = total("AB") % 7;               // (65 + 66) % 7 = 5
  let one = "a";
  let b = first(one) % 11;               // 97 % 11 = 9
  let c = slen(pick(true)) + slen(pick(false));   // 5
  let l = Label { name: "four", weight: 8 };
  let d = weigh(l);                      // 12
  return wrap_add(wrap_add(a, b), wrap_add(c, d));
}
