// expect-exit: 1
// A lock keeps the type of what it holds: a u8 that comes out is known to
// be at most 255.
fn inc(r: &mut u8) {
  if r < 255 {
    r = r + 1;
  }
}

fn main() -> u64 {
  let z: u8 = 0;
  let l = lock_new(z);
  locked(l, inc);
  let v = lock_end(l);
  assert v <= 255;
  return cast[u64](v);
}
