// expect-exit: 0
// core/sha256: the FIPS 180-4 vectors, the lengths around a block, and the
// HMAC-SHA-256 vectors of RFC 4231 (test 1, 2 and 6: a key longer than a block).
import "core/sha256.bastio";
import "core/num.bastio";

/// The lower-case hex text of `d`.
fn hex(d: &Bytes) -> Bytes {
  let mut t = text_new();
  let mut i = 0;
  while i < blen(d)
    invariant i <= blen(d)
  {
    text_push(&mut t, hex_char(cast[u64](bget(d, i)) / 16));
    text_push(&mut t, hex_char(cast[u64](bget(d, i)) % 16));
    i = i + 1;
  }
  return text_finish(t);
}

/// 1 unless the SHA-256 of the `n` bytes `c` is `want`.
fn same(n: u64, c: u8, want: Str) -> u64
  requires n < 1000000000
  ensures result <= 1
{
  let mut m = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(m) == n
  {
    bset(&mut m, i, c);
    i = i + 1;
  }
  let d = sha256(m);
  let h = hex(d);
  let ok = bytes_eq_str(h, want);
  bfree(h);
  bfree(d);
  bfree(m);
  if ok { return 0; }
  return 1;
}

/// 1 unless the SHA-256 of the text `s` is `want`.
fn text_same(s: Str, want: Str) -> u64
  ensures result <= 1
{
  let m = bfrom(s);
  let d = sha256(m);
  let h = hex(d);
  let ok = bytes_eq_str(h, want);
  bfree(h);
  bfree(d);
  bfree(m);
  if ok { return 0; }
  return 1;
}

/// 1 unless HMAC-SHA-256 of `msg` under the key of `kn` bytes `kc` (or the text `ks` if `kn` is 0) is `want`.
fn mac_same(kn: u64, kc: u8, ks: Str, msg: Str, want: Str) -> u64
  requires kn < 1000
  ensures result <= 1
{
  let mut key = balloc(kn);
  let mut i = 0;
  while i < kn
    invariant i <= kn && blen(key) == kn
  {
    bset(&mut key, i, kc);
    i = i + 1;
  }
  if kn == 0 {
    bfree(key);
    key = bfrom(ks);
  }
  let m = bfrom(msg);
  let d = hmac_sha256(key, m);
  let h = hex(d);
  let ok = bytes_eq_str(h, want);
  bfree(h);
  bfree(d);
  bfree(m);
  bfree(key);
  if ok { return 0; }
  return 1;
}

fn main() -> u64 {
  let mut bad = 0;
  if bad == 0 { bad = text_same("", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"); }
  if bad == 0 { bad = text_same("abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"); }
  if bad == 0 { bad = text_same("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"); }
  if bad == 0 { bad = text_same("The quick brown fox jumps over the lazy dog", "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592"); }
  if bad == 0 { bad = same(1, 97, "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb"); }
  if bad == 0 { bad = same(55, 97, "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318"); }
  if bad == 0 { bad = same(56, 97, "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a"); }
  if bad == 0 { bad = same(57, 97, "f13b2d724659eb3bf47f2dd6af1accc87b81f09f59f2b75e5c0bed6589dfe8c6"); }
  if bad == 0 { bad = same(63, 97, "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34"); }
  if bad == 0 { bad = same(64, 97, "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb"); }
  if bad == 0 { bad = same(65, 97, "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0"); }
  if bad == 0 { bad = same(119, 97, "31eba51c313a5c08226adf18d4a359cfdfd8d2e816b13f4af952f7ea6584dcfb"); }
  if bad == 0 { bad = same(120, 97, "2f3d335432c70b580af0e8e1b3674a7c020d683aa5f73aaaedfdc55af904c21c"); }
  if bad == 0 { bad = same(127, 97, "c57e9278af78fa3cab38667bef4ce29d783787a2f731d4e12200270f0c32320a"); }
  if bad == 0 { bad = same(128, 97, "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e"); }
  if bad == 0 { bad = same(129, 97, "c12cb024a2e5551cca0e08fce8f1c5e314555cc3fef6329ee994a3db752166ae"); }
  if bad == 0 { bad = same(1000, 97, "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3"); }
  if bad == 0 { bad = same(1000000, 97, "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"); }
  if bad == 0 { bad = mac_same(20, 11, "", "Hi There", "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"); }
  if bad == 0 { bad = mac_same(0, 0, "Jefe", "what do ya want for nothing?", "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"); }
  if bad == 0 { bad = mac_same(131, 170, "", "Test Using Larger Than Block-Size Key - Hash Key First", "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"); }
  if bad == 0 { bad = mac_same(131, 170, "", "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.", "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2"); }
  if bad == 0 { bad = mac_same(64, 7, "", "x", "72eb5e2941defeb37ad65961919eebff581f6ccb397a04d3ae80f705019c2356"); }
  if bad == 0 { bad = mac_same(65, 7, "", "x", "089d3b040b4df3b1c1a5a61006abce46402a775de368c0303def8bbc5887459f"); }
  return bad;
}
