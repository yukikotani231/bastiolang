// expect-exit: 0
// expect-stdout: 1952
// expect-stdout: 180
// expect-stdout: 424
// A result bound to variables one word at a time, with the loads of its words
// first and the copies after: the loads write the variables directly on
// native-ir. A variable that is read between the load and the copy keeps the
// copy.
struct Quad { a: u64, b: u64, c: u64, d: u64 }

fn mk(i: u64) -> Quad
  requires i < 1000
{
  return Quad { a: i, b: i + 1, c: i + 2, d: i + 3 };
}

fn run(n: u64) -> u64
  requires n <= 100
{
  let mut a = 0;
  let mut b = 0;
  let mut c = 0;
  let mut d = 0;
  let mut sum = 0;
  let mut i = 0;
  while i < n
    invariant i <= n && n <= 100
  {
    let q = mk(i);
    sum = wrap_add(sum, wrap_add(a, b));
    a = q.a;
    sum = wrap_add(sum, c);
    b = q.b;
    c = q.c;
    d = q.d;
    sum = wrap_add(sum, d);
    i = i + 1;
  }
  return wrap_add(sum, wrap_add(wrap_add(a, b), wrap_add(c, d)));
}

fn swap(n: u64) -> u64
  requires n <= 100
{
  let mut x = 1;
  let mut y = 2;
  let mut i = 0;
  while i < n
    invariant i <= n && n <= 100
  {
    let q = mk(i);
    let t = q.a;
    x = wrap_add(y, 1);
    y = wrap_add(t, 1);
    i = i + 1;
  }
  return wrap_add(x, y);
}

// The value copied once to a name of its own and, a few statements later,
// to the variable that keeps it.
fn chain(n: u64) -> u64
  requires n <= 100
{
  let mut keep = 0;
  let mut other = 0;
  let mut i = 0;
  while i < n
    invariant i <= n && n <= 100 && other <= 8 * i
  {
    let w = wrap_add(i, keep) & 255;
    let z = w;
    other = other + z % 8;
    let m = wrap_add(other, 3);
    keep = wrap_add(m, i);
    other = other + 1;
    keep = z;
    i = i + 1;
  }
  return wrap_add(keep, other);
}

fn main() -> u64 {
  print(run(30));
  print(swap(90));
  print(chain(70));
  return 0;
}
