// expect-exit: 0
// expect-stdout: 3
// expect-stdout: 14
// expect-stdout: 0
// expect-stdout: 8
// The test after a loop repeats what every way into the loop already says
// (`i < n`); a way in that says something else must keep the test.
fn skip(b: &Bytes, start: u64) -> u64
  requires start <= blen(b)
  ensures result <= blen(b)
{
  let n = blen(b);
  let mut i = start;
  while i < n && bget(b, i) < 128
    invariant i <= n && n == blen(b)
  {
    i = i + 1;
  }
  if i < n {
    return i;
  }
  return n;
}

fn count(n: u64, step: u64) -> u64
  ensures result < 1000
{
  let mut i = 0;
  let mut c = 0;
  let mut go = true;
  while go && i < n
    invariant i <= n
  {
    c = wrap_add(c, 1);
    if step > n - i {
      go = false;
    } else {
      i = wrap_add(i, step);
    }
  }
  if i < n {
    return c % 1000;
  }
  return 0;
}

fn main() -> u64 {
  let mut b = balloc(10);
  let mut k = 0;
  while k < 10
    invariant blen(b) == 10 && k <= 10
  {
    bset(&mut b, k, 65);
    k = k + 1;
  }
  bset(&mut b, 3, 200);
  print(skip(b, 0));
  print(skip(b, 4) + 4);
  print(count(10, 10) );
  print(count(10, 3) + 4);
  bfree(b);
  return 0;
}
