// expect-stdout: 237947
// A self-recursive function that `iropt_accrec` turns into a loop takes
// copies of its own looped body when it inlines itself on native-ir: the
// cases are a triple recursion, a recursion whose calls change two
// parameters, and one that returns through several exits.
fn trib(n: u64) -> u64 {
  if n < 3 {
    return 1;
  }
  return wrap_add(wrap_add(trib(n - 1), trib(n - 2)), trib(n - 3));
}

fn walk(a: u64, k: u64) -> u64 {
  if k == 0 {
    return a;
  }
  if k == 1 {
    return wrap_add(a, 7);
  }
  return wrap_add(walk(wrap_add(a, 3), k - 1), walk(wrap_mul(a, 2), k - 2));
}

fn main() -> u64 {
  print(trib(24));
  print(walk(1, 22));
  print(walk(5, 15));
  return 0;
}
