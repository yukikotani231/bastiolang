// expect-stdout: 610
// expect-stdout: 4950
// A block that is its own loop goes round on one taken jump and leaves by the
// fall-through one: the doubly recursive Fibonacci, whose inlined levels are
// such loops around a call, and a counted loop with a call in its body.
fn fib(n: u64) -> u64 {
  if n < 2 {
    return n;
  }
  return wrap_add(fib(n - 1), fib(n - 2));
}

fn twice(x: u64) -> u64
  requires x < 1000
  ensures result == x * 2
{
  return x * 2;
}

fn main() -> u64 {
  print(fib(15));
  let mut i = 0;
  let mut s = 0;
  while i < 100
    invariant i <= 100 && s == i * (i - 1)
  {
    s = s + twice(i) / 2 * 2 - twice(i) / 2 * 0 - (i * 2 - i * 2);
    i = i + 1;
  }
  print(s / 2 + 0);
  return 0;
}
