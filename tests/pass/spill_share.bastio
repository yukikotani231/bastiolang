// expect-exit: 0
// expect-stdout: 133
// expect-stdout: 754
// expect-stdout: 3369
// Registers that are copied to and from each other while more of them are
// live than there are machine registers: the copies may share a frame slot,
// and must not when one of the two is written while the other is still read.
struct Job { a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64 }

fn next(j: Job, k: u64) -> Job {
  return Job { a: wrap_add(j.b, k), b: j.c ^ k, c: wrap_add(j.d, j.a), d: j.e, e: wrap_add(j.f, 1), f: wrap_mul(j.g, 3), g: wrap_add(j.h, j.a), h: j.a ^ j.b };
}

fn rot(n: u64) -> u64 {
  let mut j = Job { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 };
  let mut i = 0;
  while i < n {
    let t = next(j, i);
    j = t;
    i = i + 1;
  }
  return wrap_add(wrap_add(wrap_add(j.a, j.b), wrap_add(j.c, j.d)), wrap_add(wrap_add(j.e, j.f), wrap_add(j.g, j.h))) % 10007;
}

fn swap_loop(n: u64) -> u64 {
  let mut a = 1; let mut b = 2; let mut c = 3; let mut d = 4;
  let mut e = 5; let mut f = 6; let mut g = 7; let mut h = 8;
  let mut i = 0;
  while i < n {
    let ta = a; let tb = b;
    a = wrap_add(tb, g); b = wrap_add(ta, h); g = c; h = d; c = wrap_add(e, 1); d = f; e = ta; f = wrap_add(tb, i);
    i = i + 1;
  }
  return wrap_add(wrap_add(wrap_add(wrap_mul(a, 3), wrap_mul(b, 5)), wrap_add(wrap_mul(c, 7), wrap_mul(d, 11))), wrap_add(wrap_add(wrap_mul(e, 13), wrap_mul(f, 17)), wrap_add(wrap_mul(g, 19), wrap_mul(h, 23)))) % 10007;
}

fn main() -> u64 {
  print(rot(5));
  print(rot(9));
  print(swap_loop(11));
  return 0;
}
