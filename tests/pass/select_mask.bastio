// A select by an unsigned comparison whose one side is all ones (a saturating
// add), zero (a clamp to zero), or neither, with the operands in either order
// and one of them a constant.
fn sat_add(a: u64, b: u64) -> u64 {
  if a > 18446744073709551615 - b {
    return 18446744073709551615;
  }
  return a + b;
}

fn clamp_zero(a: u64, lim: u64) -> u64 {
  let mut r = a;
  if a >= lim {
    r = 0;
  }
  return r;
}

fn keep_if_below(a: u64, lim: u64) -> u64 {
  let mut r = 0;
  if lim > a {
    r = a;
  }
  return r;
}

fn max_of(a: u64, b: u64) -> u64 {
  let mut r = b;
  if a > b {
    r = a;
  }
  return r;
}

fn main() -> u64 {
  let mut s = 0;
  let mut i = 0;
  while i < 200
    invariant i <= 200
  {
    let x = i * 7919 % 1000;
    let y = i * 104729 % 1000;
    s = wrap_add(s, wrap_add(wrap_add(clamp_zero(x, 500), keep_if_below(y, 700)), max_of(x, y) % 3));
    i = i + 1;
  }
  print(s % 10007);
  print(sat_add(4611686018427387900, 3));
  print(sat_add(18446744073709551000, 1000));
  return 0;
}
