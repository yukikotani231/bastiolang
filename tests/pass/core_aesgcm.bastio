// expect-exit: 0
// core/aesgcm: AES-128-GCM sealed by OpenSSL (Python's `cryptography`) is reproduced exactly and
// opens, for plaintexts of 0 to 1000 bytes and associated data of 0 to 40 bytes (NIST's test cases 1 to 4
// among them); and what was changed after sealing is refused: every byte of the sealed message in turn
// (flipped), the associated data, the nonce, the key, a truncated message and one shorter than a tag.
import "core/aesgcm.bastio";

/// The value of the hex digit `c` (0 for anything else).
fn nib(c: u8) -> u8
  ensures result < 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 0;
}

/// The bytes written as hex digits in `s`.
fn unhex(s: Str) -> Bytes
  requires slen(s) < 100000
  ensures blen(result) == slen(s) / 2
{
  let n = slen(s) / 2;
  let mut b = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(b) == n && slen(s) >= 2 * n
  {
    bset(&mut b, i, nib(sget(s, 2 * i)) * 16 + nib(sget(s, 2 * i + 1)));
    i = i + 1;
  }
  return b;
}


/// 0 if sealing `plain` under `key`, `nonce` and `aad` (all hex) gives `want` (hex) and opening `want` gives `plain` back, else 1.
fn check(key: Str, nonce: Str, aad: Str, plain: Str, want: Str) -> u64
  requires slen(key) == 32 && slen(nonce) == 24 && slen(aad) < 1000 && slen(plain) < 3000 && slen(want) < 3100
  ensures result <= 1
{
  let k = unhex(key);
  let n = unhex(nonce);
  let a = unhex(aad);
  let p = unhex(plain);
  let w = unhex(want);
  let mut bad = 1;
  let s = gcm_seal(k, n, a, p);
  if bytes_eq(s, w) {
    match gcm_open(k, n, a, w) {
      Option::Some(q) => { if bytes_eq(q, p) { bad = 0; } bfree(q); },
      Option::None => {},
    }
  }
  bfree(s);
  bfree(w);
  bfree(p);
  bfree(a);
  bfree(n);
  bfree(k);
  return bad;
}

/// 1 if any change of the sealed message `want` is accepted: each byte flipped in turn, the associated data, nonce and key changed, a truncation or a message shorter than a tag.
fn tamper(key: Str, nonce: Str, aad: Str, want: Str) -> u64
  requires slen(key) == 32 && slen(nonce) == 24 && slen(aad) < 1000 && slen(want) >= 32 && slen(want) < 3100
  ensures result <= 1
{
  let k = unhex(key);
  let n = unhex(nonce);
  let a = unhex(aad);
  let mut w = unhex(want);
  let mut accepted = 0;
  let mut i = 0;
  while i < blen(w)
    invariant accepted <= 1 && i <= blen(w) && blen(k) == 16 && blen(n) == 12 && blen(w) >= 16 && blen(w) < 1550
  {
    bset(&mut w, i, bget(w, i) ^ 1);
    match gcm_open(k, n, a, w) {
      Option::Some(q) => { accepted = 1; bfree(q); },
      Option::None => {},
    }
    bset(&mut w, i, bget(w, i) ^ 1);
    i = i + 1;
  }
  let a2 = bfrom("x");
  match gcm_open(k, n, a2, w) {
    Option::Some(q) => { accepted = 1; bfree(q); },
    Option::None => {},
  }
  bfree(a2);
  let mut n2 = bytes_slice(n, 0, 12);
  bset(&mut n2, 11, bget(n2, 11) ^ 1);
  match gcm_open(k, n2, a, w) {
    Option::Some(q) => { accepted = 1; bfree(q); },
    Option::None => {},
  }
  bfree(n2);
  let mut k2 = bytes_slice(k, 0, 16);
  bset(&mut k2, 0, bget(k2, 0) ^ 1);
  match gcm_open(k2, n, a, w) {
    Option::Some(q) => { accepted = 1; bfree(q); },
    Option::None => {},
  }
  bfree(k2);
  let cut = bytes_slice(w, 0, blen(w) - 1);
  match gcm_open(k, n, a, cut) {
    Option::Some(q) => { accepted = 1; bfree(q); },
    Option::None => {},
  }
  bfree(cut);
  let short = bytes_slice(w, 0, 15);
  match gcm_open(k, n, a, short) {
    Option::Some(q) => { accepted = 1; bfree(q); },
    Option::None => {},
  }
  bfree(short);
  bfree(w);
  bfree(a);
  bfree(n);
  bfree(k);
  return accepted;
}

fn group0() -> u64
  ensures result <= 6
{
  return check("00000000000000000000000000000000", "000000000000000000000000", "", "", "58e2fccefa7e3061367f1d57a4e7455a") + check("00000000000000000000000000000000", "000000000000000000000000", "", "00000000000000000000000000000000", "0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf") + check("feffe9928665731c6d6a8f9467308308", "cafebabefacedbaddecaf888", "", "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255", "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f59854d5c2af327cd64a62cf35abd2ba6fab4") + check("feffe9928665731c6d6a8f9467308308", "cafebabefacedbaddecaf888", "feedfacedeadbeeffeedfacedeadbeefabaddad2", "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39", "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47") + check("d8f4af81c9c48fd81d2aa0ee35bf7ed8", "65d95e9db761c0cd62b1d532", "", "d8", "7b846ce3776c962f986fa4c92300ef644f") + check("c29ca3364d6a6aca5239460dc923298b", "3d4f98e9cdbc015c9b0859ec", "5fabbf256da0eb3b04e17defb2", "e9", "db56871f69c7d7fb485849aed671bffaf8");
}

