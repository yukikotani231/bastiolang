// expect-exit: 3
// A value with only high bits set (2^40) that lives in a spill slot is
// compared with 0 as a whole word: the low 32 bits of it are 0, and a
// 32-bit compare against memory would say it is zero.
fn id(x: u64) -> u64 {
  return x;
}

fn mix(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64, i: u64, j: u64) -> u64 {
  let mut t = id(a);
  if b == 0 { t = wrap_add(t, 1); }
  if c == 0 { t = wrap_add(t, 2); }
  if d == 0 { t = wrap_add(t, 4); }
  if e == 0 { t = wrap_add(t, 8); }
  if f == 0 { t = wrap_add(t, 16); }
  if g == 0 { t = wrap_add(t, 32); }
  if h == 0 { t = wrap_add(t, 64); }
  if i == 0 { t = wrap_add(t, 128); }
  if j == 0 { t = wrap_add(t, 256); }
  t = id(t);
  if b != 0 && c != 0 && d != 0 && e != 0 && f != 0 && g != 0 && h != 0 && i != 0 && j != 0 {
    t = wrap_add(t, 3);
  }
  return t;
}

fn main() -> u64 {
  let k = 1099511627776;
  return mix(0, k, k, k, k, k, k, k, k, k);
}
