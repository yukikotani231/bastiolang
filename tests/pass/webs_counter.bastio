// expect-exit: 0
// expect-stdout: 2147450880
// expect-stdout: 8590000128
// expect-stdout: 10
// expect-stdout: 45
struct P { x: u64, y: u64, vx: u64, vy: u64 }

const N: u64 = 65536;

fn main() -> u64 {
  let mut ps = vec_new[P]();
  let mut i = 0;
  while i < N
    invariant i <= N && vlen(ps) == i
  {
    vec_push(&mut ps, P { x: i, y: i + 1, vx: 2, vy: 3 });
    i = i + 1;
  }
  // The same `i` again: it is set to 0 for the second loop and its address
  // computation is stepped as a pointer.
  let mut t = 0;
  i = 0;
  while i < N
    invariant i <= N && vlen(ps) == N
  {
    let p = vec_get(ps, i);
    t = wrap_add(t, p.x);
    i = i + 1;
  }
  print(t);
  t = 0;
  i = 0;
  while i < N
    invariant i <= N && vlen(ps) == N
  {
    let p = vec_get(ps, i);
    t = wrap_add(t, wrap_add(p.x, wrap_mul(p.y, 3)));
    i = i + 1;
  }
  print(t);
  vec_free(ps);
  // A counter that is read after its loop and then set again for the next.
  let mut k = 0;
  let mut s = 0;
  while k < 10 {
    s = wrap_add(s, k);
    k = k + 1;
  }
  print(k);
  k = 0;
  s = 0;
  while k < 10 {
    s = wrap_add(s, k);
    k = k + 1;
  }
  print(s);
  return 0;
}
