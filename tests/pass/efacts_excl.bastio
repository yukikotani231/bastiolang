// expect-exit: 0
// expect-stdout: 461621429
// A value known to differ from a constant (or to equal one) on a path that
// only one edge reaches decides the later tests of it: the second `c == 10`
// after `c != 10`, and a test after the register is written again.
fn classify(c: u64, w: u64) -> u64
  requires c < 100 && w < 100
{
  let mut r = 0;
  if c == 10 {
    r = r + 1;
  }
  if c == 32 || c == 10 {
    r = r + 10;
  } else {
    if w == 3 {
      r = r + 100;
    }
    if c == 10 {
      r = r + 1000;
    }
    if c != 7 {
      r = r + 10000;
    }
  }
  let mut d = c;
  if d != 5 {
    d = d + 5;
    if d == 5 {
      r = r + 100000;
    }
    if d == 10 {
      r = r + 1000000;
    }
  } else if d == 5 {
    r = r + 7;
  }
  return r;
}

fn main() -> u64 {
  let mut x: u64 = 12345;
  let mut sum: u64 = 0;
  let mut i = 0;
  while i < 20000
    invariant i <= 20000
  {
    x = wrap_add(wrap_mul(x, 6364136223846793005), 1442695040888963407);
    let c = x / 4294967296 % 40;
    let w = x / 16 % 5;
    sum = wrap_add(sum, wrap_mul(classify(c, w), 1 + i % 3));
    i = i + 1;
  }
  print(sum);
  return 0;
}
