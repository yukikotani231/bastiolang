// expect-exit: 0
// stage1-only: core/tls13server
// core/tls13server against core/tls13client in memory: the handshake with an
// ECDSA P-256 and an RSA certificate (made by OpenSSL under one P-256 root),
// ALPN (the server's choice among the client's), the server name, data both
// ways and close_notify; a client that also offers TLS 1.2 still gets TLS 1.3;
// a server whose key does not match its certificate fails the client's
// CertificateVerify check, a client that trusts another root refuses it, and
// and a server with no chain, or an ECDSA key behind an RSA certificate, fails.
import "core/tls13server.bastio";

/// The value of the hex digit `c` (0 for anything else).
fn nib(c: u8) -> u8
  ensures result < 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 0;
}

/// The bytes written as hex digits in `s`.
fn unhex(s: Str) -> Bytes
  requires slen(s) < 100000
  ensures blen(result) == slen(s) / 2
{
  let n = slen(s) / 2;
  let mut b = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(b) == n && slen(s) >= 2 * n
  {
    bset(&mut b, i, nib(sget(s, 2 * i)) * 16 + nib(sget(s, 2 * i + 1)));
    i = i + 1;
  }
  return b;
}

fn ca_der() -> Bytes
  ensures blen(result) < 50000
{
  return unhex("");
}

fn ec_der() -> Bytes
  ensures blen(result) < 50000
{
  return unhex("");
}

fn rsa_der() -> Bytes
  ensures blen(result) < 50000
{
  return unhex("");
}

fn ec_d() -> Bytes
  ensures blen(result) < 50000
{
  return unhex("3a69f81853cc8fc895509a3512ce7aabf8861f070048f32043bc6e43fada886c");
}

fn rsa_n() -> Bytes
  ensures blen(result) < 50000
{
  return unhex("");
}

fn rsa_d() -> Bytes
  ensures blen(result) < 50000
{
  return unhex("");
}

/// 32 bytes of the value `v`.
fn fill(v: u8) -> Bytes
  requires v < 200
  ensures blen(result) == 32
{
  let mut b = balloc(32);
  let mut i = 0;
  while i < 32
    invariant i <= 32 && blen(b) == 32
  {
    bset(&mut b, i, v + cast[u8](i));
    i = i + 1;
  }
  return b;
}

/// Passes the flights between the client `c` and the server `s`, starting
/// with `first` from the client, until both are connected or one failed.
fn pump(c: &mut Tls13Client, s: &mut Tls13Client, first: Bytes, roots: &Bytes)
  requires tls13c_ok(c) && tls13c_ok(s) && blen(roots) < 1048576
  ensures tls13c_ok(c) && tls13c_ok(s)
{
  let mut to_s = first;
  let mut rounds = 0;
  while rounds < 10
    invariant tls13c_ok(c) && tls13c_ok(s) && blen(roots) < 1048576
  {
    rounds = rounds + 1;
    let mut sout = text_new();
    let mut sapp = text_new();
    if blen(to_s) < 1048576 { tls13s_feed(&mut s, to_s, &mut sout, &mut sapp); }
    bfree(to_s);
    vec_free(sapp);
    let to_c = text_finish(sout);
    let mut cout = text_new();
    let mut capp = text_new();
    if blen(to_c) < 1048576 { tls13c_feed(&mut c, to_c, roots, 1800000000, &mut cout, &mut capp); }
    bfree(to_c);
    vec_free(capp);
    to_s = text_finish(cout);
  }
  bfree(to_s);
}

/// One connection: the server signs with key `kind` (`ka`, `kb`) and sends
/// `chain`; the client trusts `roots` and offers TLS 1.2 too when `v12`.
/// Returns 0 when everything that should work did; in `want_fail` mode, 0
/// when neither side got connected.
fn run(chain: &Bytes, kind: u64, ka: &Bytes, kb: &Bytes, roots: &Bytes, v12: bool, want_fail: bool) -> u64
  requires blen(chain) < 1048576 && blen(ka) < 65536 && blen(kb) < 65536 && blen(roots) < 1048576 && (kind == 1 || kind == 2)
{
  let r1 = fill(1);
  let r2 = fill(2);
  let r3 = fill(3);
  let r4 = fill(4);
  let r5 = fill(5);
  let r6 = fill(6);
  let name = bfrom("localhost");
  let mut ct = text_new();
  text_push(&mut ct, 2);
  text_push_str(&mut ct, "h2");
  text_push(&mut ct, 8);
  text_push_str(&mut ct, "http/1.1");
  let calpn = text_finish(ct);
  let mut st = text_new();
  text_push(&mut st, 8);
  text_push_str(&mut st, "http/1.1");
  text_push(&mut st, 6);
  text_push_str(&mut st, "spdy/3");
  let salpn = text_finish(st);
  let mut first = text_new();
  let mut opts = 0;
  if v12 { opts = 2; }
  let mut c = tls13c_new_opts(r1, r2, r3, name, calpn, opts, &mut first);
  let mut s = tls13s_new(r4, r5, r6, chain, kind, ka, kb, salpn);
  pump(&mut c, &mut s, text_finish(first), roots);
  let mut bad = 0;
  if want_fail {
    if tls13c_state(c) == 5 || tls13c_state(s) == 5 { if bad == 0 { bad = 1; } }
  } else {
    if tls13c_state(c) != 5 || tls13c_state(s) != 5 { bad = 10 + c.state * 10 + s.state; }
    let a = tls13c_alpn(c);
    let a2 = tls13c_alpn(s);
    let sn = tls13s_name(s);
    if !bytes_eq_str(a, "http/1.1") || !bytes_eq_str(a2, "http/1.1") || !bytes_eq_str(sn, "localhost") { if bad == 0 { bad = 2; } }
    if tls13c_version(c) != 772 { if bad == 0 { bad = 3; } }
    bfree(sn);
    bfree(a2);
    bfree(a);
    // Data both ways, then the client says goodbye.
    let ping = bfrom("ping");
    let mut co = text_new();
    if !tls13c_send(&mut c, ping, &mut co) { if bad == 0 { bad = 4; } }
    let cb = text_finish(co);
    let mut so = text_new();
    let mut sapp = text_new();
    if blen(cb) < 1048576 { tls13s_feed(&mut s, cb, &mut so, &mut sapp); }
    let got = text_finish(sapp);
    if !bytes_eq_str(got, "ping") { if bad == 0 { bad = 5; } }
    bfree(got);
    bfree(cb);
    let pong = bfrom("pong");
    if !tls13s_send(&mut s, pong, &mut so) { if bad == 0 { bad = 6; } }
    let sb = text_finish(so);
    let mut co2 = text_new();
    let mut capp = text_new();
    if blen(sb) < 1048576 { tls13c_feed(&mut c, sb, roots, 1800000000, &mut co2, &mut capp); }
    let got2 = text_finish(capp);
    if !bytes_eq_str(got2, "pong") { if bad == 0 { bad = 7; } }
    bfree(got2);
    bfree(sb);
    tls13c_close(&mut c, &mut co2);
    let cb2 = text_finish(co2);
    let mut so2 = text_new();
    let mut sapp2 = text_new();
    if blen(cb2) < 1048576 { tls13s_feed(&mut s, cb2, &mut so2, &mut sapp2); }
    if tls13c_state(s) != 6 { if bad == 0 { bad = 8; } }
    vec_free(sapp2);
    vec_free(so2);
    bfree(cb2);
    bfree(pong);
    bfree(ping);
  }
  tls13c_free(s);
  tls13c_free(c);
  bfree(salpn);
  bfree(calpn);
  bfree(name);
  bfree(r6);
  bfree(r5);
  bfree(r4);
  bfree(r3);
  bfree(r2);
  bfree(r1);
  return bad;
}

fn main() -> u64 {
  let ca = ca_der();
  let ec = ec_der();
  let rsa = rsa_der();
  let d = ec_d();
  let n = rsa_n();
  let e = rsa_d();
  let none = balloc(0);
  let other = fill(9);
  let mut bad = 0;
  let b1 = run(ec, 2, d, none, ca, false, false);
  if b1 != 0 { bad = 100 + b1 % 100; }
  let b2 = run(rsa, 1, n, e, ca, false, false);
  if b2 != 0 { bad = 200 + b2 % 100; }
  let b3 = run(ec, 2, d, none, ca, true, false);
  if b3 != 0 { bad = 300 + b3 % 100; }
  // The key of another certificate: the signature does not verify.
  if run(ec, 2, other, none, ca, false, true) != 0 { if bad == 0 { bad = 400; } }
  // A root the client does not trust.
  if run(ec, 2, d, none, rsa, false, true) != 0 { if bad == 0 { bad = 500; } }
  // No chain at all, and an RSA certificate with an ECDSA key.
  if run(none, 2, d, none, ca, false, true) != 0 { if bad == 0 { bad = 600; } }
  if run(rsa, 2, d, none, ca, false, true) != 0 { if bad == 0 { bad = 700; } }
  bfree(other);
  bfree(none);
  bfree(e);
  bfree(n);
  bfree(d);
  bfree(rsa);
  bfree(ec);
  bfree(ca);
  return bad;
}
