// expect-exit: 0
// A struct of more than 64 words passed by value (the words go through
// registers and a copy in memory): every word must arrive.
struct Big { f0: u64, f1: u64, f2: u64, f3: u64, f4: u64, f5: u64, f6: u64, f7: u64, f8: u64, f9: u64, f10: u64, f11: u64, f12: u64, f13: u64, f14: u64, f15: u64, f16: u64, f17: u64, f18: u64, f19: u64, f20: u64, f21: u64, f22: u64, f23: u64, f24: u64, f25: u64, f26: u64, f27: u64, f28: u64, f29: u64, f30: u64, f31: u64, f32: u64, f33: u64, f34: u64, f35: u64, f36: u64, f37: u64, f38: u64, f39: u64, f40: u64, f41: u64, f42: u64, f43: u64, f44: u64, f45: u64, f46: u64, f47: u64, f48: u64, f49: u64, f50: u64, f51: u64, f52: u64, f53: u64, f54: u64, f55: u64, f56: u64, f57: u64, f58: u64, f59: u64, f60: u64, f61: u64, f62: u64, f63: u64, f64: u64, f65: u64, f66: u64, f67: u64, f68: u64, f69: u64, f70: u64, f71: u64, f72: u64, f73: u64, f74: u64, f75: u64, f76: u64, f77: u64, f78: u64, f79: u64, f80: u64, f81: u64, f82: u64, f83: u64, f84: u64, f85: u64, f86: u64, f87: u64, f88: u64, f89: u64, f90: u64, f91: u64, f92: u64, f93: u64, f94: u64, f95: u64, f96: u64, f97: u64, f98: u64, f99: u64 }

fn mk() -> Big { return Big { f0: 1, f1: 2, f2: 3, f3: 4, f4: 5, f5: 6, f6: 7, f7: 8, f8: 9, f9: 10, f10: 11, f11: 12, f12: 13, f13: 14, f14: 15, f15: 16, f16: 17, f17: 18, f18: 19, f19: 20, f20: 21, f21: 22, f22: 23, f23: 24, f24: 25, f25: 26, f26: 27, f27: 28, f28: 29, f29: 30, f30: 31, f31: 32, f32: 33, f33: 34, f34: 35, f35: 36, f36: 37, f37: 38, f38: 39, f39: 40, f40: 41, f41: 42, f42: 43, f43: 44, f44: 45, f45: 46, f46: 47, f47: 48, f48: 49, f49: 50, f50: 51, f51: 52, f52: 53, f53: 54, f54: 55, f55: 56, f56: 57, f57: 58, f58: 59, f59: 60, f60: 61, f61: 62, f62: 63, f63: 64, f64: 65, f65: 66, f66: 67, f67: 68, f68: 69, f69: 70, f70: 71, f71: 72, f72: 73, f73: 74, f74: 75, f75: 76, f76: 77, f77: 78, f78: 79, f79: 80, f80: 81, f81: 82, f82: 83, f83: 84, f84: 85, f85: 86, f86: 87, f87: 88, f88: 89, f89: 90, f90: 91, f91: 92, f92: 93, f93: 94, f94: 95, f95: 96, f96: 97, f97: 98, f98: 99, f99: 100 }; }

fn pick(b: Big) -> u64 {
  return b.f0 % 7 + b.f1 % 7 + b.f63 % 7 + b.f64 % 7 + b.f80 % 7 + b.f99 % 7;
}

fn drive(k: u64) -> u64
  requires k < 100
{
  let mut g = mk();
  g.f80 = k;
  g.f99 = k + 1;
  return pick(g);
}

fn main() -> u64 {
  // 1, 2, 64 % 7 = 1, 65 % 7 = 2, then 5 and 6.
  if drive(5) == 1 + 2 + 1 + 2 + 5 + 6 { return 0; }
  return 1;
}
