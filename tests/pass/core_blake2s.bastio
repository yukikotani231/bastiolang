// expect-exit: 0
// core/blake2s: RFC 7693's "abc" and the empty message, the lengths around a
// block (against the reference implementation), keyed hashes (a 32-byte key,
// 32- and 16-byte outputs: the forms WireGuard uses) and HMAC-BLAKE2s.
import "core/blake2s.bastio";
import "core/num.bastio";

/// The lower-case hex text of `d`.
fn hex(d: &Bytes) -> Bytes {
  let mut t = text_new();
  let mut i = 0;
  while i < blen(d)
    invariant i <= blen(d)
  {
    text_push(&mut t, hex_char(cast[u64](bget(d, i)) / 16));
    text_push(&mut t, hex_char(cast[u64](bget(d, i)) % 16));
    i = i + 1;
  }
  return text_finish(t);
}

/// The `n` bytes 0, 1, 2, ... wrapping at 251.
fn pat(n: u64) -> Bytes
  requires n < 1000000
  ensures blen(result) == n
{
  let mut m = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(m) == n
  {
    bset(&mut m, i, cast[u8](i % 251));
    i = i + 1;
  }
  return m;
}

/// 1 unless `d` is the bytes whose hex is `want`.
fn is_hex(d: Bytes, want: Str) -> u64
  ensures result <= 1
{
  let h = hex(d);
  let ok = bytes_eq_str(h, want);
  bfree(h);
  bfree(d);
  if ok { return 0; }
  return 1;
}

/// 1 unless the BLAKE2s-256 of `n` pattern bytes under a `kn`-byte key (pattern too) of `outlen` bytes is `want`.
fn hash_same(n: u64, kn: u64, outlen: u64, want: Str) -> u64
  requires n < 1000000 && kn <= 32 && outlen >= 1 && outlen <= 32
  ensures result <= 1
{
  let m = pat(n);
  let key = pat(kn);
  let d = blake2s(m, key, outlen);
  bfree(m);
  bfree(key);
  return is_hex(d, want);
}

/// 1 unless HMAC-BLAKE2s of `n` pattern bytes under `kn` pattern key bytes is `want`.
fn mac_same(kn: u64, n: u64, want: Str) -> u64
  requires kn < 1000000 && n < 1000000
  ensures result <= 1
{
  let key = pat(kn);
  let m = pat(n);
  let d = hmac_blake2s(key, m);
  bfree(key);
  bfree(m);
  return is_hex(d, want);
}

fn main() -> u64 {
  let mut bad = 0;
  let abc = bfrom("abc");
  let none = balloc(0);
  bad = bad + is_hex(blake2s(abc, none, 32), "508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982");
  bad = bad + is_hex(blake2s(none, none, 32), "69217a3079908094e11121d042354a7c1f55b6482ca1a51e1b250dfd1ed0eef9");
  bfree(abc);
  bfree(none);
  bad = bad + hash_same(0, 0, 32, "69217a3079908094e11121d042354a7c1f55b6482ca1a51e1b250dfd1ed0eef9");
  bad = bad + hash_same(1, 0, 32, "e34d74dbaf4ff4c6abd871cc220451d2ea2648846c7757fbaac82fe51ad64bea");
  bad = bad + hash_same(55, 0, 32, "f4495470f226c8c214be08fdfad4bc4a2a9dbea9136a210df0d4b64929e6fc14");
  bad = bad + hash_same(63, 0, 32, "e57cb79487dd57902432b250733813bd96a84efce59f650fac26e6696aefafc3");
  bad = bad + hash_same(64, 0, 32, "56f34e8b96557e90c1f24b52d0c89d51086acf1b00f634cf1dde9233b8eaaa3e");
  bad = bad + hash_same(65, 0, 32, "1b53ee94aaf34e4b159d48de352c7f0661d0a40edff95a0b1639b4090e974472");
  bad = bad + hash_same(127, 0, 32, "f18417b39d617ab1c18fdf91ebd0fc6d5516bb34cf39364037bce81fa04cecb1");
  bad = bad + hash_same(128, 0, 32, "1fa877de67259d19863a2a34bcc6962a2b25fcbf5cbecd7ede8f1fa36688a796");
  bad = bad + hash_same(129, 0, 32, "5bd169e67c82c2c2e98ef7008bdf261f2ddf30b1c00f9e7f275bb3e8a28dc9a2");
  bad = bad + hash_same(200, 0, 32, "6d244e1a06ce4ef578dd0f63aff0936706735119ca9c8d22d86c801414ab9741");
  bad = bad + hash_same(0, 32, 32, "48a8997da407876b3d79c0d92325ad3b89cbb754d86ab71aee047ad345fd2c49");
  bad = bad + hash_same(1, 32, 32, "40d15fee7c328830166ac3f918650f807e7e01e177258cdc0a39b11f598066f1");
  bad = bad + hash_same(64, 32, 32, "8975b0577fd35566d750b362b0897a26c399136df07bababbde6203ff2954ed4");
  bad = bad + hash_same(100, 32, 32, "c376617014d20158bced3d3ba552b6eccf84e62aa3eb650e90029c84d13eea69");
  bad = bad + hash_same(0, 32, 16, "9536f9b267655743dee97b8a670f9f53");
  bad = bad + hash_same(32, 32, 16, "c43b5e836af88620a8a71b1652cb8640");
  bad = bad + hash_same(70, 32, 16, "ec3e1efa5ed195eff667e16b1af1e39e");
  bad = bad + mac_same(0, 0, "eaf4bb25938f4d20e72656bbbc7a9bf63c0c18537333c35bdb67db1402661acd");
  bad = bad + mac_same(3, 3, "175cdc3bb3d9e5d4d54112e7a272ee730b63e07d0d16f9970ba7d6d5a9cf3826");
  bad = bad + mac_same(32, 100, "a81c95080ba2a7c4ed1b7b4c21dec2c4fd6dc9f03ff37b6d65289dc95a7d1ef1");
  bad = bad + mac_same(64, 5, "67c5fec1e74e8aa09876a2ec799ae47aab89a32ab5952987b3f869fba0e0aa9e");
  bad = bad + mac_same(65, 70, "f604354aa5c325e7286763ca8aa7e5b750feeb4322b234663274327d6d699bc7");
  bad = bad + mac_same(100, 200, "c4c95271905c6f69c1dd7c6fbc0cb3735457a660ccc2c4370f28825e7abef5af");
  if bad != 0 { return 1; }
  return 0;
}
