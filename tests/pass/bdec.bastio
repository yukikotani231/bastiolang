// expect-exit: 123
// `bdec(b, from, to)` is the decimal value of bytes `from..to`: proofs
// unfold it one digit per mention, so a chain of asserts evaluates it.
import "core/num.bastio";

fn main() -> u64 {
  let mut b = balloc(3);
  bset(&mut b, 0, 49);   // "123"
  bset(&mut b, 1, 50);
  bset(&mut b, 2, 51);
  assert bdec(b, 0, 1) == 1;
  assert bdec(b, 0, 2) == 12;
  assert bdec(b, 0, 3) == 123;
  let mut r = 0;
  match parse_u64(b, 0, 3) {
    Option::Some(v) => {
      assert v == 123;                 // parse_u64 returns the digits' value
      r = v;
    },
    Option::None => {},
  }
  bfree(b);
  return r;
}
