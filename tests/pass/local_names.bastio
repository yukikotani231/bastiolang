// expect-exit: 9
// Functions and local variables have separate names: a call `f(..)` always
// means the function, so a local may be called like a function, a builtin
// or a spec fn without hiding it.
spec fn small(n: u64) -> bool { n < 100 }

fn step(n: u64) -> u64
  requires small(n)
  ensures result == n + 1
{
  return n + 1;
}

fn main() -> u64 {
  let step = 4;                 // a local named like a function
  let len = step(step);         // the call still means the function: 5
  let small = 2;                // like a spec fn
  let mut b = alloc(small);
  b = set(b, 0, len);
  let n = get(b, 0) + len(b);   // 5 + 2: `len(..)` is the builtin, `len` the local
  free(b);
  assert small(n);
  return n + step - small;      // 7 + 4 - 2
}
