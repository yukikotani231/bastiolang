// expect-exit: 0
// A result of more than eight words that the return copies from memory (a
// struct with a Vec in it stays in a place): 11 words, an odd number, and 20,
// an even one. The native AArch64 backend copies such a result in a loop of
// pairs and the last word of an odd one on its own.
struct Nine { v: Vec[u64], a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64 }
struct Many { v: Vec[u64], a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64, i: u64, j: u64, k: u64, l: u64, m: u64, n: u64, o: u64, p: u64, q: u64 }

fn mk9(x: u64) -> Nine
  requires x < 1000
  ensures vlen(result.v) == 2
{
  let mut n = Nine { v: vec_new[u64](), a: x + 1, b: x + 2, c: x + 3, d: x + 4, e: x + 5, f: x + 6, g: x + 7, h: x + 8 };
  vec_push(&mut n.v, x);
  vec_push(&mut n.v, x + 100);
  return n;
}

fn mkmany(x: u64) -> Many
  requires x < 1000
  ensures vlen(result.v) == 2
{
  let mut n = Many { v: vec_new[u64](), a: x + 1, b: x, c: x + 2, d: x, e: x + 3, f: x, g: x + 4, h: x, i: x + 5, j: x, k: x + 6, l: x, m: x + 7, n: x, o: x + 8, p: x, q: x + 9 };
  vec_push(&mut n.v, x);
  vec_push(&mut n.v, x + 100);
  return n;
}

fn sum9(w: Nine) -> u64
  requires vlen(w.v) >= 2
{
  let mut t = wrap_add(vec_get(w.v, 0), vec_get(w.v, 1));
  t = wrap_add(t, w.a);
  t = wrap_add(t, wrap_mul(w.b, 2));
  t = wrap_add(t, wrap_mul(w.c, 3));
  t = wrap_add(t, wrap_mul(w.d, 4));
  t = wrap_add(t, wrap_mul(w.e, 5));
  t = wrap_add(t, wrap_mul(w.f, 6));
  t = wrap_add(t, wrap_mul(w.g, 7));
  t = wrap_add(t, wrap_mul(w.h, 8));
  vec_free(w.v);
  return t;
}

fn summany(w: Many) -> u64
  requires vlen(w.v) >= 2
{
  let mut t = wrap_add(vec_get(w.v, 0), vec_get(w.v, 1));
  t = wrap_add(t, w.a);
  t = wrap_add(t, wrap_mul(w.b, 2));
  t = wrap_add(t, wrap_mul(w.c, 3));
  t = wrap_add(t, wrap_mul(w.d, 4));
  t = wrap_add(t, wrap_mul(w.e, 5));
  t = wrap_add(t, wrap_mul(w.f, 6));
  t = wrap_add(t, wrap_mul(w.g, 7));
  t = wrap_add(t, wrap_mul(w.h, 8));
  t = wrap_add(t, wrap_mul(w.i, 9));
  t = wrap_add(t, wrap_mul(w.j, 10));
  t = wrap_add(t, wrap_mul(w.k, 11));
  t = wrap_add(t, wrap_mul(w.l, 12));
  t = wrap_add(t, wrap_mul(w.m, 13));
  t = wrap_add(t, wrap_mul(w.n, 14));
  t = wrap_add(t, wrap_mul(w.o, 15));
  t = wrap_add(t, wrap_mul(w.p, 16));
  t = wrap_add(t, wrap_mul(w.q, 17));
  vec_free(w.v);
  return t;
}

fn main() -> u64 {
  let s9 = sum9(mk9(1));
  let sm = summany(mkmany(2));
  if s9 == 1 + 101 + 2 + 3 * 2 + 4 * 3 + 5 * 4 + 6 * 5 + 7 * 6 + 8 * 7 + 9 * 8 && sm == 935 {
    return 0;
  }
  return 1;
}
