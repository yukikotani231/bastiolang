// The core library's little-endian stores and loads, as the native backends
// lower them (one store or load of 2, 4 or 8 bytes at any byte offset)
// expect-exit: 0
import "core/endian.bastio";

fn main() -> u64 {
  let mut b = balloc(32);
  store_le64(&mut b, 3, 1311768467294899695);      // 0x1234567890ABCDEF
  store_le32(&mut b, 13, 4023233417);              // 0xEFCDAB89
  store_le16(&mut b, 21, 43981);                   // 0xABCD
  store_le16(&mut b, 24, 0);
  let ok1 = bget(b, 3) == 239 && bget(b, 4) == 205 && bget(b, 5) == 171 && bget(b, 6) == 144
    && bget(b, 7) == 120 && bget(b, 8) == 86 && bget(b, 9) == 52 && bget(b, 10) == 18;
  let ok2 = bget(b, 13) == 137 && bget(b, 14) == 171 && bget(b, 15) == 205 && bget(b, 16) == 239;
  let ok3 = bget(b, 21) == 205 && bget(b, 22) == 171 && bget(b, 11) == 0 && bget(b, 23) == 0;
  let ok4 = load_le64(b, 3) == 1311768467294899695 && load_le32(b, 13) == 4023233417
    && load_le16(b, 21) == 43981 && load_le32(b, 5) == 1450741931 && load_le16(b, 24) == 0;
  bfree(b);
  if ok1 && ok2 && ok3 && ok4 { return 0; }
  return 1;
}
