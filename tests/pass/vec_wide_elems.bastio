// expect-exit: 2
// expect-stdout: 3
// expect-stdout: 3
// expect-stdout: 1
// expect-stdout: 3
// expect-stdout: 1
// expect-stdout: 3
// expect-stdout: 4
// expect-stdout: 10
// Vectors of elements seven words wide, which the native backend copies
// with `rep movsq`: push (which must still count the new element), get,
// set, swap and pop, and struct values copied between variables.

struct W { a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64 }

fn w(x: u64) -> W {
  return W { a: x, b: x, c: x, d: x, e: x, f: x, g: x };
}

fn main() -> u64 {
  let mut v: Vec[W] = vec_new[W]();
  vec_push(&mut v, w(1));
  vec_push(&mut v, w(2));
  vec_push(&mut v, w(3));
  print(vec_len(v));
  let mut x = w(0);
  if vec_len(v) == 3 {
    x = vec_get(v, 2);
    let o = vec_swap(&mut v, 0, w(10));
    x.g = o.g;
    vec_set(&mut v, 1, w(4));
  }
  print(x.a);
  print(x.g);
  let y = x;
  print(y.d);
  print(y.g);
  let mut n = 0;
  while vec_len(v) > 0
    invariant n < 3
  {
    let z = vec_pop(&mut v);
    print(z.f);
    n = n + 1;
    if n == 3 { vec_free(v); return 2; }
  }
  vec_free(v);
  return 0;
}
