// expect-exit: 7
fn poke(f: &mut Frame, i: u64, v: u64)
  requires i < 512
{
  frame_write(&mut f, i, v);
}

fn poke8(f: &mut Frame, i: u64, v: u8)
  requires i < 4096
{
  frame_write8(&mut f, i, v);
}

fn peek(f: &Frame, i: u64) -> u64
  requires i < 512
{
  return frame_read(f, i);
}

fn peek8(f: &Frame, i: u64) -> u8
  requires i < 4096
{
  return frame_read8(f, i);
}

fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 1 {
    return 99;
  }
  let mut a = pool_take(&mut pool, 0);
  poke(&mut a, 3, 258);
  poke8(&mut a, 40, 200);
  let mut r = 0;
  if peek(a, 3) == 258 {
    r = r + 1;
  }
  if peek8(a, 24) == 2 && peek8(a, 25) == 1 {
    r = r + 2;
  }
  if peek8(a, 40) == 200 {
    r = r + 4;
  }
  pool_give(&mut pool, a);
  return r;
}
