// expect-exit: 102
// An import that does not start with `.` or `/` is looked for next to the
// importing file, then in each directory above it: `lib/units.bastio` is
// found in tests/, and `core/option.bastio` at the top of the repository.
import "lib/units.bastio";
import "core/option.bastio";
// The same file by another path is still loaded once.
import "../lib/units.bastio";

fn main() -> u64 {
  let o = Option[u64]::Some(UNIT);         // UNIT = 10
  return scale(opt_or[u64](o, 0)) + 2;     // 100 + 2
}
