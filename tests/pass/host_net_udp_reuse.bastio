// stage1-only: net_udp_open_reuse
// backend: c
// expect-exit: 0
// Two UDP sockets can bind one port only when both ask for SO_REUSEADDR;
// net_udp_open alone does not. Targets without UDP fail the first open and
// the test stops there.
import "../../std/net.bastio";

fn main(h: &mut Host) -> u64 {
  let lo = net_ip4(127, 0, 0, 1);
  let mut bad = 0;
  match net_udp_open_reuse(h, lo, 0) {
    Option::Some(a) => {
      let p = net_port(h, a);
      match net_udp_open_reuse(h, lo, p) {
        Option::Some(b) => { net_close(h, b); },
        Option::None => { bad = 1; },
      }
      match net_udp_open(h, lo, p) {
        Option::Some(c) => { net_close(h, c); bad = 2; },
        Option::None => {},
      }
      net_close(h, a);
    },
    Option::None => {},
  }
  match net_udp_open(h, lo, 0) {
    Option::Some(a) => {
      let p = net_port(h, a);
      match net_udp_open(h, lo, p) {
        Option::Some(c) => { net_close(h, c); bad = 3; },
        Option::None => {},
      }
      net_close(h, a);
    },
    Option::None => {},
  }
  return bad;
}
