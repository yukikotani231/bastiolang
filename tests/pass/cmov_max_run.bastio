// expect-stdout: 6
// The longest run of non-multiples of 7: a running maximum, a select by an
// unsigned comparison whose arm is a copy of the loop counter.
fn longest(n: u64) -> u64 {
  let mut best = 0;
  let mut cur = 0;
  let mut i = 0;
  while i < n && i < 100000 {
    if i % 7 == 3 || i % 11 == 5 {
      cur = 0;
    } else {
      cur = wrap_add(cur, 1);
      if cur > best {
        best = cur;
      }
    }
    i = i + 1;
  }
  return best;
}

fn main() {
  print(longest(100));
  print(longest(20));
  print(longest(5000));
}
