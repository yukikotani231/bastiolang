// expect-exit: 0
// core/rows.bastio: a table of 4-word rows grows by 3 rows. The old rows
// keep their words and the new ones are zero, which is what lets a kernel
// grow its process table (state 0 is a free slot) without touching the
// code that indexes it.
import "core/rows.bastio";

fn main() -> u64 {
  let mut t = alloc(8);                 // two rows
  t = set(t, 5, 42);                    // row 1, field 1
  let mut ok = false;
  if rows_grow(&mut t, 4, 3) {
    assert len(t) == 20 && get(t, 5) == 42;
    assert get(t, 8 + 2 * 4 + 1) == 0;
    ok = get(t, 12) == 0 && get(t, 19) == 0 && get(t, 5) == 42;
  }
  free(t);
  if ok { return 0; }
  return 1;
}
