// A sum, difference or product taken `% 4294967296` (the iropt_wrap32 fusion
// into one 32-bit operation): in place, into another register, with an
// immediate, with a register, and with an immediate that does not fit.
// expect-exit: 0
// expect-stdout: 4273529060
fn step(x: u64, y: u64) -> u64
  requires x < 4294967296 && y < 4294967296
  ensures result < 4294967296
{
  let a = (x * 1103515245 + 12345) % 4294967296;
  let b = (a + y) % 4294967296;
  let c = (b * 2654435761) % 4294967296;
  let d = (c + 4294967295) % 4294967296;
  let e = (d + 4294967296 - y) % 4294967296;
  let f = (e * y) % 4294967296;
  return (f + x) % 4294967296;
}

fn main() -> u64 {
  let mut x = 1;
  let mut y = 7;
  let mut n = 0;
  let mut h = 0;
  while n < 1000
    invariant x < 4294967296 && y < 4294967296 && h < 4294967296
  {
    let z = step(x, y);
    y = x;
    x = z;
    h = (h + z) % 4294967296;
    n = n + 1;
  }
  print(h);
  return 0;
}
