// expect-exit: 0
// expect-stdout: 3333
// expect-stdout: 3334
// expect-stdout: 10000
// A struct passed by `&mut` to a function that is inlined into a loop and
// copies a field back unchanged on some paths and changes another field on
// others: the copies of the unchanged field go, the changed one stays.
struct S { a: u64, b: u64 }

fn step(s: &mut S, n: u64) -> u64
{
  if n % 3 == 0 {
    s.b = wrap_add(s.b, 1);
    return 1;
  }
  if n % 2 == 0 {
    return 0;
  }
  s.a = wrap_add(s.a, 1);
  return 2;
}

fn main() -> u64 {
  let mut s = S { a: 0, b: 0 };
  let mut i: u64 = 0;
  let mut t: u64 = 0;
  while i < 10000
    invariant i <= 10000
  {
    t = wrap_add(t, step(&mut s, i));
    i = i + 1;
  }
  print(s.a);
  print(s.b);
  print(t);
  return 0;
}
