// expect-exit: 0
// expect-stdout: 1817626295614639678
// `cur * k + (c - K)` with a constant K, for each multiplier that becomes
// one or two `lea`s: the subtraction rides in the displacement of the last
// one. The digit sums of 1 .. 300 in several bases, and the same with the
// subtrahend a register.
fn f2(cur: u64, c: u64) -> u64 { return wrap_add(wrap_mul(cur, 2), wrap_sub(c, 7)); }
fn f3(cur: u64, c: u64) -> u64 { return wrap_add(wrap_mul(cur, 3), wrap_sub(c, 48)); }
fn f4(cur: u64, c: u64) -> u64 { return wrap_add(wrap_mul(cur, 4), wrap_sub(c, 1)); }
fn f5(cur: u64, c: u64) -> u64 { return wrap_add(wrap_mul(cur, 5), wrap_sub(c, 100)); }
fn f6(cur: u64, c: u64) -> u64 { return wrap_add(wrap_mul(cur, 6), wrap_sub(c, 3)); }
fn f8(cur: u64, c: u64) -> u64 { return wrap_add(wrap_mul(cur, 8), wrap_sub(c, 65)); }
fn f9(cur: u64, c: u64) -> u64 { return wrap_add(wrap_mul(cur, 9), wrap_sub(c, 48)); }
fn f10(cur: u64, c: u64) -> u64 { return wrap_add(wrap_mul(cur, 10), wrap_sub(c, 48)); }
fn f18(cur: u64, c: u64) -> u64 { return wrap_add(wrap_mul(cur, 18), wrap_sub(c, 12345)); }
fn g10(cur: u64, c: u64, k: u64) -> u64 { return wrap_add(wrap_mul(cur, 10), wrap_sub(c, k)); }

fn main() -> u64 {
  let mut t = 0;
  let mut i = 0;
  while i < 300
    invariant i <= 300
  {
    let c = i % 10 + 48;
    t = wrap_add(wrap_mul(t, 31), f2(i, c));
    t = wrap_add(wrap_mul(t, 31), f3(i, c));
    t = wrap_add(wrap_mul(t, 31), f4(i, c));
    t = wrap_add(wrap_mul(t, 31), f5(i, c));
    t = wrap_add(wrap_mul(t, 31), f6(i, c));
    t = wrap_add(wrap_mul(t, 31), f8(i, c));
    t = wrap_add(wrap_mul(t, 31), f9(i, c));
    t = wrap_add(wrap_mul(t, 31), f10(i, c));
    t = wrap_add(wrap_mul(t, 31), f18(i, c));
    t = wrap_add(wrap_mul(t, 31), g10(i, c, 48));
    i = i + 1;
  }
  print(t);
  return 0;
}
