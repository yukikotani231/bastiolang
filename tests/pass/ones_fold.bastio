// expect-exit: 0
// expect-stdout: 65520
// expect-stdout: 18446744073709551615
// expect-stdout: 18446744073709551600
// expect-stdout: 1
// expect-stdout: 0
// expect-stdout: 1
// expect-stdout: 0
// expect-stdout: 123
// `!K`, `x & !K`, `x | !0`, `x & !0` and the comparisons of a constant with
// all ones give the same results with the constant folder as without it.
fn masked(x: u64) -> u64 {
  return x & !15;
}

fn all(x: u64) -> u64 {
  return x | !0;
}

fn not_k() -> u64 {
  return !15;
}

fn cmp_a() -> u64 {
  let a = 7;
  if a < 18446744073709551615 {
    return 1;
  }
  return 0;
}

fn cmp_b() -> u64 {
  let a = 7;
  if a == 18446744073709551615 {
    return 1;
  }
  return 0;
}

fn cmp_c() -> u64 {
  let a = 7;
  if 18446744073709551615 > a {
    return 1;
  }
  return 0;
}

fn cmp_d() -> u64 {
  let a = 7;
  if 18446744073709551615 <= a {
    return 1;
  }
  return 0;
}

fn keep(x: u64) -> u64 {
  return x & !0;
}

fn main() -> u64 {
  print(masked(65535));
  print(all(5));
  print(not_k());
  print(cmp_a());
  print(cmp_b());
  print(cmp_c());
  print(cmp_d());
  print(keep(123));
  return 0;
}
