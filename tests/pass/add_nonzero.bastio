// expect-exit: 0
// expect-stdout: 7
// expect-stdout: 2
// expect-stdout: 100
// expect-stdout: 121
// A sum with a positive constant that cannot wrap is not zero, so a test of
// `== 0` after it is decided; a wrapping sum can be zero, and the test stays.
fn wrapped(x: u64) -> u64 {
  let y = wrap_add(x, 1);
  if y == 0 {
    return 7;
  }
  return y;
}

fn counted(n: u64) -> u64
  ensures result <= 100
  {
  let mut t = n;
  let mut len = 0;
  while t > 0 && len < 20
    invariant len <= 20
  {
    t = t / 10;
    len = len + 1;
  }
  if len == 0 {
    return 100;
  }
  return len;
}

fn main() -> u64 {
  print(wrapped(18446744073709551615));
  print(wrapped(1));
  print(counted(0));
  print(counted(5) + counted(0) + counted(12345678901234567890));
  return 0;
}
