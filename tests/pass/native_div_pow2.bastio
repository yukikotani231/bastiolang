// native backend: division and remainder by a power of two are a shift or a
// mask in the result register, including 2^32 (a 32-bit move) and larger
// quotients
// expect-exit: 0
fn f(a: u64) -> u64 {
  let h = a / 4294967296;
  let l = a % 4294967296;
  let m = a / 1099511627776;
  let k = a % 2147483648;
  return wrap_add(wrap_add(h, l), wrap_add(m, k));
}
fn main() -> u64 {
  let r = f(0x123456789abcdef0);
  // h=0x12345678 l=0x9abcdef0 m=0x1234 k=0x1abcdef0
  let want = wrap_add(wrap_add(0x12345678, 0x9abcdef0), wrap_add(0x123456, 0x1abcdef0));
  if r == want { return 0; }
  return 1;
}
