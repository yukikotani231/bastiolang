// expect-exit: 0
// expect-stdout: 0
// expect-stdout: 45
// expect-stdout: 1275
// expect-stdout: 20
// expect-stdout: 3000000000
// A loop tested at the bottom must run the same passes as one tested at the
// top: no pass when the bound is zero, one pass, a nested loop, a loop with
// two ways back to the test, and a bound that needs several instructions.
fn count(n: u64) -> u64
  requires n < 1000
{
  let mut s = 0;
  let mut i = 0;
  while i < n
    invariant i <= n && s <= i
  {
    s = s + 1;
    i = i + 1;
  }
  return s;
}

fn tri(n: u64) -> u64
  requires n < 1000
{
  let mut s = 0;
  let mut i = 0;
  while i < n
    invariant i <= n && s <= i * 1000
  {
    s = s + i;
    i = i + 1;
  }
  return s;
}

fn nested(n: u64) -> u64
  requires n < 100
{
  let mut s = 0;
  let mut i = 0;
  while i < n
    invariant i <= n && s <= i * 100
  {
    let mut j = 0;
    while j <= i
      invariant j <= i + 1 && s <= i * 100 + j
    {
      s = s + 1;
      j = j + 1;
    }
    i = i + 1;
  }
  return s;
}

fn skip(n: u64) -> u64
  requires n < 1000
{
  let mut s = 0;
  let mut i = 0;
  while i < n
    invariant i <= n && s <= i
  {
    if i % 2 == 0 {
      s = s + 1;
      i = i + 1;
    } else {
      i = i + 1;
    }
  }
  return s;
}

fn big() -> u64 {
  let mut s = 0;
  let mut i = 0;
  while i < 3000000000
    invariant i <= 3000000000 && s == i && i % 1000000000 == 0
  {
    s = s + 1000000000;
    i = i + 1000000000;
  }
  return s;
}

fn main() -> u64 {
  print(count(0));
  print(tri(10));
  print(nested(50));
  print(skip(39));
  print(big());
  return 0;
}
