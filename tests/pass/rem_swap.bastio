// expect-exit: 0
// expect-stdout: 21
// expect-stdout: 9
// expect-stdout: 2000
// expect-stdout: 10055544
// A step of Euclid's algorithm (`t = x % y; x = y; y = t`) divides by the
// register of `y` and leaves the remainder in it; a remainder that is read
// again after the swap keeps its own register.
fn gcd(a: u64, b: u64) -> u64 {
  let mut x = a;
  let mut y = b;
  let mut k = 0;
  while y != 0 && k < 64
    invariant k <= 64
  {
    let t = x % y;
    x = y;
    y = t;
    k = k + 1;
  }
  return x;
}

fn steps(a: u64, b: u64) -> u64 {
  let mut x = a;
  let mut y = b;
  let mut k = 0;
  while y != 0 && k < 64
    invariant k <= 64
  {
    let t = x % y;
    x = y;
    y = t;
    k = k + 1;
  }
  return k;
}

fn twice(a: u64, b: u64) -> u64 {
  let mut x = a;
  let mut y = b;
  let mut acc: u64 = 0;
  let mut k = 0;
  while y != 0 && k < 64
    invariant k <= 64
  {
    let t = x % y;
    x = y;
    y = t;
    acc = wrap_add(acc, wrap_add(t, x));
    k = k + 1;
  }
  return acc;
}

fn main() -> u64 {
  print(gcd(1071, 462));
  print(steps(89, 55));
  let mut i = 1;
  let mut s: u64 = 0;
  let mut u: u64 = 0;
  while i <= 2000
    invariant i >= 1 && i <= 2001
  {
    s = wrap_add(s, gcd(i, 1000003 % i + i));
    u = wrap_add(u, twice(i, 1000003 % i + i));
    i = i + 1;
  }
  print(s);
  print(u);
  return 0;
}
