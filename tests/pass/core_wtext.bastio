// expect-exit: 0
// core/wtext.bastio: text kept one character a word, as a compiler keeps
// its source and output. Appends and comparisons are total: a position out
// of range is no match.
import "core/wtext.bastio";

fn main() -> u64 {
  let mut t = vec_new[u64]();
  wtext_push_str(&mut t, "mov ");
  wtext_push_u64(&mut t, 4096);
  wtext_push_str(&mut t, ", 0x");
  wtext_push_hex(&mut t, 255, 4);
  assert wtext_is_str_at(t, 0, "mov ");
  let mut ok = vec_len(t) == 16 && wtext_has_str_at(t, 0, "mov 4096, 0x00ff");
  ok = ok && !wtext_has_str_at(t, 14, "abc") && !wtext_has_str_at(t, 99, "a");
  let mut u = vec_new[u64]();
  wtext_push_span(&mut u, t, 4, 8);
  wtext_push_all(&mut u, t);
  ok = ok && vec_len(u) == 20 && wtext_has_str_at(u, 0, "4096mov 4096");
  ok = ok && wtext_same(u, 0, 8, 4) && !wtext_same(u, 0, 1, 4) && !wtext_same(u, 18, 0, 4);
  wtext_push_u64(&mut u, 0);
  wtext_push_u64(&mut u, 18446744073709551615);
  ok = ok && wtext_has_str_at(u, 20, "018446744073709551615");
  vec_free(u);
  vec_free(t);
  if ok { return 0; }
  return 1;
}
