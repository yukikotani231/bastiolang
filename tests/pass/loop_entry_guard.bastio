// expect-exit: 0
// expect-stdout: 5050
// expect-stdout: 3
// expect-stdout: 0
// expect-stdout: 45
// The test at the top of a loop whose counter starts at a constant below the
// bound is dropped; one that starts at or above the bound must still skip it.
fn sum_to(n: u64) -> u64
  requires n <= 1000
{
  let mut i = 1;
  let mut s = 0;
  while i <= n
    invariant i <= 1001
  {
    s = wrap_add(s, i);
    i = i + 1;
  }
  return s;
}

fn from(a: u64, b: u64) -> u64
  requires a <= 100 && b <= 100
{
  let mut i = a;
  let mut c = 0;
  while i < b
    invariant i <= 100
  {
    c = wrap_add(c, 1);
    i = i + 1;
  }
  return c;
}

fn main() -> u64 {
  print(sum_to(100));
  print(from(2, 5));
  print(from(7, 7));
  let mut j = 0;
  let mut t = 0;
  while j < 10
    invariant j <= 10
  {
    t = wrap_add(t, j);
    j = j + 1;
  }
  print(t);
  let mut k = 5;
  while k < 5
    invariant k <= 5
  {
    k = k + 1;
  }
  return 0;
}
