// stage1-only: vec_with
// expect-exit: 0
// `vec_with(v, i, f, args..)` lends element `i` of a vector to `f` in place,
// as `f`'s `&T` first argument: a linear element (here one holding a `Bytes`)
// is read without being taken out and put back. The prover knows which
// element `f` sees, so what `f` returns is known to the caller.
struct Wide { a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64 }
struct Named { name: Bytes, size: u64 }
enum Slot { Free, Full(Named) }

fn slot_size(s: &Slot) -> u64 {
  match s {
    Slot::Free => { return 0; },
    Slot::Full(f) => { return f.size; },
  }
}

fn slot_byte(s: &Slot, k: u64) -> u64 {
  match s {
    Slot::Free => { return 0; },
    Slot::Full(f) => {
      if k < blen(f.name) {
        return cast[u64](bget(f.name, k));
      }
      return 0;
    },
  }
}

fn wide_sum(w: &Wide, extra: u64) -> u64 {
  return wrap_add(w.a, wrap_add(w.g, extra));
}

fn word_plus(x: &u64, k: u64) -> u64 {
  return wrap_add(x, k);
}

struct Meta { size: u64, kind: u64, mode: u64 }

// The element's name compared with a name the caller holds (a `&Bytes`
// argument), then a wide result.
fn slot_named(s: &Slot, name: &Bytes, n: u64) -> bool {
  match s {
    Slot::Free => { return false; },
    Slot::Full(f) => {
      if blen(f.name) != n || n > blen(name) {
        return false;
      }
      let mut k = 0;
      while k < n
        invariant k <= n && n <= blen(name) && n == blen(f.name)
      {
        if bget(f.name, k) != bget(name, k) {
          return false;
        }
        k = k + 1;
      }
      return true;
    },
  }
}

fn slot_meta(s: &Slot, kind: u64) -> Meta {
  match s {
    Slot::Free => { return Meta { size: 0, kind: kind, mode: 1 }; },
    Slot::Full(f) => { return Meta { size: f.size, kind: kind, mode: 2 }; },
  }
}

fn named(text: Str, size: u64) -> Slot {
  let b = bfrom(text);
  return Slot::Full(Named { name: b, size: size });
}

fn main() -> u64 {
  let mut slots = vec_new[Slot]();
  vec_push(&mut slots, named("abc", 3));
  vec_push(&mut slots, Slot::Free);
  vec_push(&mut slots, named("hello world", 11));
  let mut bad = 0;
  if vec_with(slots, 0, slot_size) != 3 { bad = 1; }
  if vec_with(slots, 1, slot_size) != 0 { bad = 2; }
  if vec_with(slots, 2, slot_size) != 11 { bad = 3; }
  if vec_with(slots, 2, slot_byte, 4) != 111 { bad = 4; }        // 'o'
  if vec_with(slots, 0, slot_byte, 1) != 98 { bad = 5; }         // 'b'
  if vec_with(slots, 0, slot_byte, 3) != 0 { bad = 6; }
  let probe = bfrom("hello world");
  let other = bfrom("hello worle");
  if !vec_with(slots, 2, slot_named, probe, 11) { bad = 13; }
  if vec_with(slots, 2, slot_named, other, 11) { bad = 14; }
  if vec_with(slots, 0, slot_named, probe, 11) { bad = 15; }
  if vec_with(slots, 1, slot_named, probe, 11) { bad = 16; }
  bfree(probe);
  bfree(other);
  let m2 = vec_with(slots, 2, slot_meta, 7);
  let m1 = vec_with(slots, 1, slot_meta, 8);
  if m2.size != 11 || m2.kind != 7 || m2.mode != 2 { bad = 17; }
  if m1.size != 0 || m1.kind != 8 || m1.mode != 1 { bad = 18; }
  // Still all there: nothing was taken out.
  let s2 = vec_pop(&mut slots);
  let s1 = vec_pop(&mut slots);
  let s0 = vec_pop(&mut slots);
  match s2 {
    Slot::Free => { bad = 7; },
    Slot::Full(f) => { bfree(f.name); },
  }
  match s1 {
    Slot::Free => {},
    Slot::Full(f) => { bad = 8; bfree(f.name); },
  }
  match s0 {
    Slot::Free => { bad = 9; },
    Slot::Full(f) => { bfree(f.name); },
  }
  vec_free(slots);

  let mut ws = vec_new[Wide]();
  vec_push(&mut ws, Wide { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7 });
  vec_push(&mut ws, Wide { a: 10, b: 20, c: 30, d: 40, e: 50, f: 60, g: 70 });
  if vec_with(ws, 1, wide_sum, 100) != 180 { bad = 10; }
  if vec_with(ws, 0, wide_sum, 0) != 8 { bad = 11; }
  vec_free(ws);

  let mut xs = vec_new[u64]();
  vec_push(&mut xs, 5);
  vec_push(&mut xs, 6);
  if vec_with(xs, 1, word_plus, 40) != 46 { bad = 12; }
  vec_free(xs);
  return bad;
}
