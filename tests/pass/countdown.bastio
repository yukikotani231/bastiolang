// expect-exit: 0
// expect-stdout: 5000050000
// expect-stdout: 3000
// expect-stdout: 1048576
// expect-stdout: 15
// A loop whose counter nothing else reads counts down to zero instead
// (the subtraction sets the flags the branch wants): bounds that start
// above zero, a nested pair, and a counter that is also an index keep
// their meaning.
fn tri(n: u64) -> u64
  requires n <= 100000
{
  let mut s: u64 = 0;
  let mut k: u64 = 1;
  while k <= n
    invariant k <= n + 1 && s <= k * k
  {
    s = s + k;
    k = k + 1;
  }
  return s;
}

fn main() -> u64 {
  print(tri(100000));
  let mut a: u32 = 7;
  let mut i = 5;
  while i < 3005
    invariant i <= 3005
  {
    a = wrap_add(a, 1);
    i = i + 1;
  }
  print(wrap_sub(cast[u64](a), 7));
  let mut x: u64 = 0;
  let mut o = 0;
  while o < 1024
    invariant o <= 1024 && x == o * 1024
  {
    let mut q = 0;
    while q < 1024
      invariant q <= 1024 && x == o * 1024 + q
    {
      x = x + 1;
      q = q + 1;
    }
    o = o + 1;
  }
  print(x);
  let mut y: u64 = 0;
  let mut z = 0;
  while z < 6
    invariant z <= 6 && y <= z * z
  {
    y = y + z;
    z = z + 1;
  }
  print(y);
  return 0;
}
