// expect-exit: 0
// core/sort.bastio: merge sort and sort by key carry the same proof as the
// insertion sort (ascending, and a permutation of the input), so the
// binary search after `merge_sort_u64` needs no check, and every index a
// key sort returns is proved to be in bounds for the keys.
import "core/sort.bastio";
import "core/hashmap.bastio";

fn main() -> u64 {
  let mut v = vec_new[u64]();
  let mut i = 0;
  while i < 3000
    invariant i <= 3000
  {
    vec_push(&mut v, hash_u64(i) % 1000);
    i = i + 1;
  }
  vec_push(&mut v, 500);
  merge_sort_u64(&mut v);
  assert vcount(v, 500) >= 1;
  let n = vec_len(v);
  let mut ok = n == 3001 && sorted_contains_u64(v, 500);
  // Checked again by hand: the proof says so too.
  let mut j = 1;
  while j < vec_len(v)
    invariant j >= 1
  {
    if vec_get(v, j - 1) > vec_get(v, j) { ok = false; }
    j = j + 1;
  }
  vec_free(v);

  // Sort the indices 0..500 by a key each.
  let mut keys = vec_new[u64]();
  let mut idx = vec_new[u64]();
  let mut k = 0;
  while k < 500
    invariant vlen(keys) == k && vlen(idx) == k && all_indices_below(idx, k)
  {
    vec_push(&mut keys, hash_u64(k) % 97);
    vec_push(&mut idx, k);
    k = k + 1;
  }
  sort_by_key_u64(&mut idx, keys);
  ok = ok && vec_len(idx) == 500;
  let mut m = 1;
  while m < vec_len(idx)
    invariant m >= 1 && all_indices_below(idx, vlen(keys))
  {
    // No bounds check needed on `keys`: the sort proves every index in range.
    if vec_get(keys, vec_get(idx, m - 1)) > vec_get(keys, vec_get(idx, m)) { ok = false; }
    m = m + 1;
  }
  vec_free(idx);
  vec_free(keys);
  if ok { return 0; }
  return 1;
}
