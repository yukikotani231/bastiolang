// expect-exit: 0
// expect-stdout: n=42 i=-7 h=0xff s=[   12] ok
// core/print.bastio and core/endian.bastio, through the console.
import "../../core/print.bastio";
import "../../core/endian.bastio";

fn main(con: &mut Serial) -> u64 {
  let mut b = balloc(8);
  store_be32(&mut b, 0, 0x01020304);
  store_le16(&mut b, 4, 0xbeef);
  store_be16(&mut b, 6, 0xcafe);
  let ok = bget(b, 0) == 1 && bget(b, 3) == 4 && load_be32(b, 0) == 0x01020304
    && load_le32(b, 0) == 0x04030201 && load_le16(b, 4) == 0xbeef && bget(b, 4) == 0xef
    && load_be16(b, 6) == 0xcafe && load_be64(b, 0) == 0x01020304efbecafe;
  store_le64(&mut b, 0, 0x1122334455667788);
  let ok2 = load_le64(b, 0) == 0x1122334455667788 && bget(b, 0) == 0x88;
  store_be64(&mut b, 0, 0x1122334455667788);
  let ok3 = load_be64(b, 0) == 0x1122334455667788 && bget(b, 0) == 0x11;
  store_le32(&mut b, 4, 7);
  let ok4 = load_le32(b, 4) == 7;
  bfree(b);
  print_str(con, "n=");
  print_u64(con, 42);
  print_str(con, " i=");
  print_i64(con, -7);
  print_str(con, " h=");
  print_hex(con, 255);
  print_str(con, " s=[");
  print_u64_pad(con, 12, 5);
  print_str(con, "] ");
  if ok && ok2 && ok3 && ok4 {
    let w = bfrom("ok");
    print_bytes(con, w);
    bfree(w);
  }
  print_nl(con);
  return 0;
}
