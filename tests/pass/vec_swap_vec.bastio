// expect-exit: 0
// expect-stdout: 17
// vec_swap on a Vec of Vecs returns the old element, which is read through
// its header in the slot: the header is copied out before the store.
fn u_at(v: &Vec[u64], i: u64) -> u64 {
  if i < vec_len(v) {
    return vec_get(v, i);
  }
  return 0;
}

fn main() -> u64 {
  let mut vs = vec_new[Vec[u64]]();
  let mut a = vec_new[u64]();
  vec_push(&mut a, 7);
  vec_push(&mut a, 8);
  vec_push(&mut vs, a);
  let mut t = 0;
  let mut i = 0;
  while i < vec_len(vs) {
    let l = vec_swap(&mut vs, i, vec_new[u64]());
    t = wrap_add(t, vec_len(l));
    let mut k = 0;
    while k < vec_len(l) {
      t = wrap_add(t, u_at(l, k));
      k = k + 1;
    }
    let back = vec_swap(&mut vs, i, l);
    vec_free(back);
    i = i + 1;
  }
  print(t);
  while vec_len(vs) > 0 {
    let d = vec_pop(&mut vs);
    vec_free(d);
  }
  vec_free(vs);
  return 0;
}
