// expect-exit: 34
// A struct with a Buf field crosses between a function the IR lowers and one
// that stays with the old generator (a `Str` local keeps `total` there): the
// field is (length, data address) in both.
struct W { b: Buf }

fn mk(n: u64) -> W
  requires n >= 1 && n <= 100
  ensures len(result.b) == n
{
  let mut b = alloc(n);
  b = set(b, 0, 7);
  return W { b: b };
}

fn total(p: W) -> u64
  requires len(p.b) >= 1 && len(p.b) <= 100
{
  let s = "ab";
  let v = wrap_add(get(p.b, 0), wrap_add(len(p.b), slen(s)));
  free(p.b);
  return v;
}

fn main() -> u64 {
  return total(mk(25));
}
