// expect-exit: 0
// Small functions that return an enum from several places, called from a
// loop and matched at once. The native IR path inlines them and threads each
// return to the arm for its tag, so every tag, and a tag that is only known
// on some paths, must still take the right arm.
struct Pair { a: u64, b: u64 }
enum Step { Skip, Take(Pair), Stop(u64) }

fn step(i: u64, limit: u64) -> Step {
  if i >= limit {
    return Step::Stop(i);
  }
  if i % 3 == 0 {
    return Step::Skip;
  }
  let w = i % 7;
  if w == 5 {
    return Step::Take(Pair { a: i, b: w });
  }
  return Step::Take(Pair { a: w, b: i });
}

fn main() -> u64 {
  let mut i = 0;
  let mut sum = 0;
  let mut skipped = 0;
  let mut stop = 0;
  while i < 40 && stop == 0
    invariant i <= 40 && sum <= i * 80 && skipped <= i
  {
    match step(i, 30) {
      Step::Skip => { skipped = skipped + 1; }
      Step::Take(p) => {
        if p.a < 40 && p.b < 40 {
          sum = wrap_add(sum, wrap_add(p.a, p.b));
        }
      }
      Step::Stop(at) => { stop = wrap_add(at, 1); }
    }
    i = i + 1;
  }
  // 30 steps: 10 skipped; the takes add i + i % 7 for i % 7 == 5 and the
  // same sum otherwise (a + b is symmetric), then Stop at i = 30.
  let mut want = 0;
  let mut j = 0;
  while j < 30
    invariant j <= 30 && want <= j * 80
  {
    if j % 3 != 0 {
      want = wrap_add(want, wrap_add(j, j % 7));
    }
    j = j + 1;
  }
  if sum != want || skipped != 10 || stop != 31 {
    return 1;
  }
  return 0;
}
