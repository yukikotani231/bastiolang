// A word loaded and reduced to its low 32 bits, by `% 4294967296` or by a
// mask, is one `movl` from memory; the upper half of the word never reaches
// the result.
fn main() -> u64 {
  let mut a = alloc(8);
  a = set(a, 0, 1311768467294899695);
  a = set(a, 1, 18446744073709551615);
  a = set(a, 2, 4294967296);
  let lo = get(a, 0) % 4294967296;
  let m = get(a, 0) & 4294967295;
  let z = get(a, 2) % 4294967296;
  let all = get(a, 1);
  print(get(a, 0));
  print(lo);
  print(m);
  print(z);
  print(all);
  free(a);
  return 0;
}
