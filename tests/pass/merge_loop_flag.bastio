// expect-exit: 0
// A loop whose head tests only a flag that is set just before the loop on
// one path and cleared inside the loop. The jump from the branch that sets
// the flag must still leave the flag set for the back edge to read.
fn run(n: u64, cap: u64) -> u64
  requires n <= 1000 && cap <= 1000
{
  let mut m = n;
  if m > cap {
    m = cap;
  }
  let mut ok = true;
  let mut i = 0;
  let mut sum = 0;
  while ok
    invariant (ok ==> i <= m) && i <= m + 1 && m <= 1000 && sum <= i * 1000
  {
    if i < m {
      sum = wrap_add(sum, i);
      if i == 3 {
        ok = false;
      }
      i = i + 1;
    } else {
      ok = false;
      i = i + 1;
    }
  }
  return sum;
}

fn main() -> u64 {
  if run(10, 100) != 6 || run(10, 2) != 1 || run(2, 100) != 1 || run(0, 5) != 0 {
    return 1;
  }
  return 0;
}
