// stage1-only: branchless if (stage1/iropt.bastio iropt_ifconv)
// expect-exit: 0
// expect-stdout: 999965
// expect-stdout: 12
// expect-stdout: 3552545712
// expect-stdout: 3978429333
// expect-stdout: 3557942903
// expect-stdout: 633535628
// An `if` or `if`/`else` whose arms only compute registers runs both arms and
// selects with a mask on the native-ir backend. The cases: a bit test with
// both arms (the CRC step), an `if` with no `else`, the arm on the false
// side only, two variables written by one arm, a variable the arm reads
// after writing it, a bool written by an arm, and an arm with a division
// by a constant that a branch would guard.
fn crc_step(crc: u64) -> u64
  requires crc < 4294967296
  ensures result < 4294967296
{
  if crc % 2 == 1 {
    return (crc / 2 ^ 3988292384) % 4294967296;
  }
  return crc / 2;
}

fn run(n: u64) -> u64 {
  let mut crc = 4294967295;
  let mut hi = 0;
  let mut lo = 1000000;
  let mut even = 0;
  let mut odd = 0;
  let mut flag = false;
  let mut q = 0;
  let mut i = 0;
  while i < n
    invariant i <= n && crc < 4294967296 && hi < 1000000 && lo <= 1000000 && even < 4294967296 && odd < 4294967296 && q < 4294967296
  {
    crc = crc_step(crc);
    let v = crc % 1000000;
    if v > hi {
      hi = v;
    }
    if v < lo {
      lo = v;
    }
    if v % 2 == 0 {
      even = (even + v) % 4294967296;
    } else {
      odd = (odd + v / 3) % 4294967296;
    }
    if v % 3 != 0 {
      flag = true;
    } else {
      flag = false;
    }
    if flag {
      q = (q + 1) % 4294967296;
      if v > 500000 {
        q = (q + v / 7) % 4294967296;
      }
    }
    i = i + 1;
  }
  print(hi);
  print(lo);
  print(even);
  print(odd);
  print(q);
  print(crc);
  return 0;
}

fn main() -> u64 {
  return run(100000);
}
