// expect-exit: 0
// expect-stdout: 499500
// expect-stdout: 0
// expect-stdout: 999
// expect-stdout: 1000
// expect-stdout: 3005
// expect-stdout: 3005
// expect-stdout: 4004
// Two selects by one comparison share its mask: a binary search (both bounds
// move by the comparison) and a conditional swap (each select reads the value
// the other overwrites).
fn lower(a: &Buf, n: u64, key: u64) -> u64
  requires len(a) == n
  ensures result <= n
{
  let mut lo = 0;
  let mut hi = n;
  while lo < hi
    invariant lo <= hi && hi <= n && len(a) == n
  {
    let mid = lo + (hi - lo) / 2;
    if get(a, mid) < key {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo;
}

fn order(x0: u64, y0: u64) -> u64 {
  let mut x = x0;
  let mut y = y0;
  if y < x {
    let t = x;
    x = y;
    y = t;
  }
  return wrap_add(wrap_mul(x, 1000), y);
}

fn main() -> u64 {
  let mut a = alloc(1000);
  let mut i = 0;
  while i < 1000
    invariant i <= 1000 && len(a) == 1000
  {
    a = set(a, i, i * 7);
    i = i + 1;
  }
  let mut sum = 0;
  let mut q = 0;
  while q < 7000
    invariant q <= 7007 && len(a) == 1000 && sum <= q * 1000
  {
    sum = sum + lower(a, 1000, q);
    q = q + 7;
  }
  print(sum);
  print(lower(a, 1000, 0));
  print(lower(a, 1000, 6993));
  print(lower(a, 1000, 6994));
  print(order(5, 3));
  print(order(3, 5));
  print(order(4, 4));
  free(a);
  return 0;
}
