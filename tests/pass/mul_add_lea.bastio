// expect-exit: 0
// expect-stdout: 849128759266130452
// expect-stdout: 954326610
// expect-stdout: 18446744073709551340
// expect-stdout: 6187004593053284172
// A product by a small constant that an `add` reads is made by `lea` on
// native-ir: `x * 10 + y` is two of them. The cases cover every constant it
// handles, the sum going back to the multiplied variable, to another one, and
// to one the instructions between the two write.
fn horner(n: u64, k: u64) -> u64 {
  let mut cur = 0;
  let mut i = 0;
  while i < n
    invariant i <= n
  {
    let d = wrap_add(i, k) % 10;
    cur = wrap_add(wrap_mul(cur, 10), d);
    i = i + 1;
  }
  return cur;
}

fn scales(x: u64, y: u64) -> u64 {
  let a = wrap_add(wrap_mul(x, 2), y);
  let b = wrap_add(wrap_mul(x, 3), y);
  let c = wrap_add(wrap_mul(x, 4), y);
  let d = wrap_add(wrap_mul(x, 5), y);
  let e = wrap_add(wrap_mul(x, 6), y);
  let f = wrap_add(wrap_mul(x, 8), y);
  let g = wrap_add(wrap_mul(x, 9), y);
  let h = wrap_add(wrap_mul(x, 10), y);
  let j = wrap_add(wrap_mul(x, 18), y);
  return wrap_add(wrap_add(wrap_add(a, b), wrap_add(c, d)), wrap_add(wrap_add(wrap_mul(e, 7), wrap_mul(f, 11)), wrap_add(wrap_mul(g, 13), wrap_add(wrap_mul(h, 17), wrap_mul(j, 19)))));
}

// The addend is computed between the product and the sum, and the sum goes to
// the multiplied variable.
fn between(n: u64, c: u8) -> u64 {
  let mut cur = n;
  let mut i = 0;
  while i < 20
    invariant i <= 20
  {
    cur = wrap_mul(cur, 10);
    let t = wrap_sub(cast[u64](c), 48);
    cur = wrap_add(cur, wrap_add(t, i));
    i = i + 1;
  }
  return cur;
}

fn main() -> u64 {
  print(horner(30, 3));
  print(scales(1234567, 89));
  print(scales(18446744073709551615, 7));
  print(between(12, 55));
  return 0;
}
