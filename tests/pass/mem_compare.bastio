// expect-exit: 0
// expect-stdout: 13980
// expect-stdout: 9565
// expect-stdout: 7749
// A word compared with one loaded from memory, on either side and under each
// order: the load read straight from memory by the comparison, and an index
// `k - n` that follows a counter counting down by a register of its own.
const W: u64 = 300;

fn pass(dp: &mut Vec[u64], wt: u64, val: u64, mode: u64) -> u64
  requires vlen(dp) == W + 1 && wt >= 1 && wt <= 50 && mode < 6
{
  let mut changed = 0;
  let mut w = W;
  while w >= wt
    invariant w <= W && wt >= 1 && wt <= 50 && vlen(dp) == W + 1
  {
    let a = vec_get(dp, w);
    let b = wrap_add(vec_get(dp, w - wt), val);
    let mut upd = false;
    if mode == 0 {
      upd = b > a;
    } else if mode == 1 {
      upd = a < b;
    } else if mode == 2 {
      upd = b >= wrap_add(a, 1) && a < 1000000000000;
    } else if mode == 3 {
      upd = a <= b && a != b;
    } else if mode == 4 {
      upd = b != a && b > a;
    } else {
      upd = !(b <= a);
    }
    if upd {
      vec_set(&mut dp, w, b);
      changed = wrap_add(changed, 1);
    }
    w = w - 1;
  }
  return changed;
}

fn main() -> u64 {
  let mut dp = vec_new[u64]();
  let mut i = 0;
  while i <= W
    invariant i <= W + 1 && vlen(dp) == i
  {
    vec_push(&mut dp, 0);
    i = i + 1;
  }
  let mut x = 99;
  let mut it = 0;
  let mut ch = 0;
  while it < 60
    invariant it <= 60 && vlen(dp) == W + 1
  {
    x = wrap_add(wrap_mul(x, 6364136223846793005), 1442695040888963407);
    let wt = x / 4294967296 % 50 + 1;
    let val = x / 65536 % 1000 + 1;
    ch = wrap_add(ch, pass(&mut dp, wt, val, it % 6));
    it = it + 1;
  }
  print(vec_get(dp, W));
  print(vec_get(dp, W / 2));
  print(ch);
  vec_free(dp);
  return 0;
}
