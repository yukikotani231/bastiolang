// expect-exit: 0
// expect-stdout: 2669
// expect-stdout: 616
// Elements read and written at `t - K` are addressed off `t` with a negative
// displacement instead of a subtraction first.
fn mix(w: &mut Vec[u64]) -> u64
  requires vlen(w) == 40
  ensures vlen(w) == 40
{
  let mut t = 16;
  let mut acc: u64 = 0;
  while t < 40
    invariant t >= 16 && t <= 40 && vlen(w) == 40
  {
    let a = vec_get(w, t - 15);
    let b = vec_get(w, t - 2);
    vec_set(&mut w, t, wrap_add(a, b) % 1000);
    acc = wrap_add(acc, vec_get(w, t - 7) % 1000);
    t = t + 1;
  }
  return acc;
}

fn main() -> u64 {
  let mut w = vec_new[u64]();
  let mut i = 0;
  while i < 40
    invariant vlen(w) == i && i <= 40
  {
    vec_push(&mut w, i * 3 + 1);
    i = i + 1;
  }
  print(mix(&mut w));
  print(vec_get(w, 39));
  vec_free(w);
  return 0;
}
