// expect-exit: 0
// expect-stdout: 370002
// expect-stdout: 4749114222605721
// Divisions and remainders by constants (powers of two and not) in loops with
// many values live across them: the quotient and the values around it must
// not trade registers wrongly on any backend.
fn digit_sum(limit: u64) -> u64 {
  let mut s = 0;
  let mut i = 1;
  while i <= limit && i <= 100000
    invariant i >= 1
  {
    let mut v = i;
    while v > 0 {
      s = wrap_add(s, v % 10);
      v = v / 10;
    }
    i = i + 1;
  }
  return s;
}

fn mixed(n: u64) -> u64 {
  let mut m = 0;
  let mut x = 1;
  let mut keep1 = 3;
  let mut keep2 = 5;
  while x <= n && x <= 100000
    invariant x >= 1
  {
    let a = wrap_mul(x, 2654435761);
    let q7 = a / 7;
    let qb = a / 1000000007;
    let r8 = a % 8;
    let q4k = a / 4096;
    let r1k = a % 1000;
    m = wrap_add(m, wrap_add(wrap_add(q7, qb), wrap_add(wrap_add(r8, q4k), r1k)));
    keep1 = wrap_add(keep1, r8);
    keep2 = wrap_add(keep2, q7 & 1);
    x = x + 1;
  }
  if keep1 == 0 && keep2 == 0 {
    return 0;
  }
  return m;
}

fn main() -> u64 {
  print(digit_sum(20000));
  print(mixed(5000));
  return 0;
}
