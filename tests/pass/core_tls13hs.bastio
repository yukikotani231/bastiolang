// expect-exit: 0
// core/tls13hs: the ClientHello is the one a Python program assembles (with and
// without a server name, with a 255-byte one), a ServerHello made by Python
// yields its key share, and malformed ones (a retry request, another suite,
// version, compression or group, missing, repeated or unknown extensions, wrong
// lengths) and every truncation of a good one are refused.
import "core/tls13hs.bastio";

/// The value of the hex digit `c` (0 for anything else).
fn nib(c: u8) -> u8
  ensures result < 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 0;
}

/// The bytes written as hex digits in `s`.
fn unhex(s: Str) -> Bytes
  requires slen(s) < 100000
  ensures blen(result) == slen(s) / 2
{
  let n = slen(s) / 2;
  let mut b = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(b) == n && slen(s) >= 2 * n
  {
    bset(&mut b, i, nib(sget(s, 2 * i)) * 16 + nib(sget(s, 2 * i + 1)));
    i = i + 1;
  }
  return b;
}

/// 1 unless the ClientHello for these arguments is the hex string `want`.
fn client(random: Str, sid: Str, name: Str, key: Str, want: Str) -> u64
  requires slen(random) == 64 && slen(sid) == 64 && slen(key) == 64 && slen(name) <= 255 && slen(want) < 100000
  ensures result <= 1
{
  let r = unhex(random);
  let s = unhex(sid);
  let k = unhex(key);
  let w = unhex(want);
  let nb = bfrom(name);
  let got = tls13_client_hello(r, s, nb, k);
  bfree(nb);
  let same = bytes_eq(got, w);
  bfree(got);
  bfree(w);
  bfree(k);
  bfree(s);
  bfree(r);
  if same { return 0; }
  return 1;
}

/// 1 unless the ServerHello `hello` (hex) yields the key share `key` (hex).
fn accepted(hello: Str, key: Str) -> u64
  requires slen(key) == 64 && slen(hello) < 100000
  ensures result <= 1
{
  let h = unhex(hello);
  let k = unhex(key);
  let mut bad = 1;
  match tls13_parse_server_hello(h) {
    Option::Some(got) => {
      if bytes_eq(got, k) { bad = 0; }
      bfree(got);
    },
    Option::None => {},
  }
  bfree(k);
  bfree(h);
  return bad;
}

/// 1 unless the ServerHello `hello` (hex) is refused.
fn refused(hello: Str) -> u64
  requires slen(hello) < 100000
  ensures result <= 1
{
  let h = unhex(hello);
  let mut bad = 0;
  match tls13_parse_server_hello(h) {
    Option::Some(got) => { bfree(got); bad = 1; },
    Option::None => {},
  }
  bfree(h);
  return bad;
}

/// The number of proper prefixes of the ServerHello `hello` (hex) that are accepted.
fn truncations(hello: Str) -> u64
  requires slen(hello) < 100000
  ensures result <= 100000
{
  let h = unhex(hello);
  let mut bad = 0;
  let mut n = 0;
  while n < blen(h)
    invariant n <= blen(h) && bad <= n && blen(h) < 100000
  {
    let p = bytes_slice(h, 0, n);
    match tls13_parse_server_hello(p) {
      Option::Some(got) => { bfree(got); bad = bad + 1; },
      Option::None => {},
    }
    bfree(p);
    n = n + 1;
  }
  bfree(h);
  return bad;
}

fn clients() -> u64
  ensures result <= 4
{
  let mut bad = 0;
  bad = bad + client("454349e422f05297191ead13e21d3db520e5abef52055e4964b82fb213f593a1", "043a718774c572bd8a25adbeb1bfcd5c0256ae11cecf9f9c3f925d0e52beaf89", "example.com", "8254c329a92850f6d539dd376f4816ee2764517da5e0235514af433164480d7a", "");
