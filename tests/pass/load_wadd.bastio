// expect-stdout: 1275
// expect-stdout: 18446744073709551614
// expect-stdout: 248
// expect-stdout: 250
// A load that only a wrapping add reads is one `add` on memory; with a
// sized type the result is still brought back into range.
fn main() -> u64 {
  let mut a = alloc(51);
  let mut i = 0;
  while i < 51
    invariant i <= 51 && len(a) == 51
  {
    a = set(a, i, i);
    i = i + 1;
  }
  let mut s = 0;
  i = 0;
  while i < 51
    invariant i <= 51 && len(a) == 51
  {
    s = wrap_add(s, get(a, i));
    i = i + 1;
  }
  print(s);
  a = set(a, 0, 18446744073709551615);
  a = set(a, 1, 18446744073709551615);
  let mut t = 0;
  i = 0;
  while i < 2
    invariant i <= 2 && len(a) == 51
  {
    t = wrap_add(t, get(a, i));
    i = i + 1;
  }
  print(t);
  let mut b: u8 = 0;
  i = 0;
  while i < 51
    invariant i <= 51 && len(a) == 51
  {
    b = wrap_add(b, cast[u8](get(a, i) % 256));
    i = i + 1;
  }
  print(cast[u64](b));
  let mut c: u8 = 0;
  i = 2;
  while i < 51
    invariant i <= 51 && len(a) == 51
  {
    c = wrap_add(c, cast[u8](get(a, i) % 256));
    i = i + 1;
  }
  print(cast[u64](c));
  free(a);
  return 0;
}
