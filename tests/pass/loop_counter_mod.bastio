// expect-exit: 0
// expect-stdout: 276
// expect-stdout: 276
// expect-stdout: 100
// expect-stdout: 41
// A value made from a loop counter inside the loop is below the bound of the
// counter there, so `% m` of it may be dropped when the bound is below `m`;
// it must stay when the counter can reach `m` (the bound is exactly `m`), and
// after the counter has been written in the body.
fn rows(n: u64) -> u64
  requires n <= 1000
{
  let mut t = 0;
  let mut r = 0;
  while r < n
    invariant r <= n
  {
    let mut k = 0;
    while k < 8
      invariant k <= 8 && r <= n
    {
      t = wrap_add(t, (r * 8 + k) % 8000 % 100);
      k = k + 1;
    }
    r = r + 1;
  }
  return t;
}

fn edge(n: u64) -> u64
  requires n <= 1000
{
  let mut t = 0;
  let mut k = 0;
  while k < 10
    invariant k <= 10
  {
    t = wrap_add(t, (k + n) % 10 / 9);
    k = k + 1;
  }
  return t;
}

fn after_write(n: u64) -> u64
  requires n <= 7
{
  let mut k = n;
  let mut t = 0;
  while k < 8
    invariant k <= 100
  {
    k = k + 5;
    t = (k * 3) % 8;
    if t > 100 {
      t = 0;
    }
    k = k + 1;
  }
  return wrap_add(wrap_add(t, 29), k % 1);
}

fn main() -> u64 {
  print(rows(3));
  print(rows(3));
  print(wrap_mul(edge(1), 100));
  print(wrap_add(after_write(2), 7));
  return 0;
}
