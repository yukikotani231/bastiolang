// expect-exit: 0
// expect-stdout: 16485987748366197428
// expect-stdout: 32032
// expect-stdout: 5005
// A loop whose test is `a && b && c`, several comparisons with one exit,
// tested again at the bottom: the run length of a byte after a position,
// bounded by the buffer and by a cap, and a scan that reads a byte against a
// byte held in a register (a byte is compared as a byte).
const N: u64 = 4096;

fn run(b: &Bytes, i: u64, cap: u64) -> u64
  requires blen(b) == N && i < N && cap >= 1 && cap <= 255
  ensures result >= 1 && result <= 255 && i + result <= N
{
  let c = bget(b, i);
  let mut n = 1;
  while i + n < N && n < cap && bget(b, i + n) == c
    invariant n >= 1 && n <= cap && i + n <= N && blen(b) == N
  {
    n = n + 1;
  }
  return n;
}

fn count_lt(b: &Bytes, lim: u64) -> u64
  requires blen(b) == N
{
  let mut k = 0;
  let mut i = 0;
  while i < N && k < lim && bget(b, i) < 200
    invariant i <= N && k <= i && i < 1000000 && blen(b) == N
  {
    k = k + 1;
    i = i + 1;
  }
  return i * 1000 + k;
}

fn main() -> u64 {
  let mut b = balloc(N);
  let mut x = 7;
  let mut i = 0;
  while i < N
    invariant blen(b) == N && i <= N
  {
    x = wrap_add(wrap_mul(x, 6364136223846793005), 1442695040888963407);
    let r = x / 4294967296;
    let n = r % 9 + 1;
    let c = cast[u8](r / 16 % 250);
    let mut k = 0;
    while k < n && i < N
      invariant blen(b) == N && i <= N
    {
      bset(&mut b, i, c);
      i = i + 1;
      k = k + 1;
    }
  }
  let mut total = 0;
  let mut p = 0;
  while p < N
    invariant p <= N && blen(b) == N
  {
    let cap = p % 7 + 1;
    let r = run(b, p, cap);
    total = wrap_add(wrap_mul(total, 31), r);
    p = p + r;
  }
  print(total);
  print(count_lt(b, 3000));
  print(count_lt(b, 5));
  bfree(b);
  return 0;
}
