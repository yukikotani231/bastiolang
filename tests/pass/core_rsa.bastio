fn refuse6() -> u64
  ensures result <= 8
{
  return 0
    + refused("", "010001", 2, "68656c6c6f20776f726c64", "")
    + refused("", "010001", 2, "61", "");
}

fn small() -> u64
  ensures result <= 2
{
  return refused("c1dc41748c62f1b87b545f7da699a45541bdddad4bac61a1e825cf7d9b97f823a2b0b04255209f3184bbdb272ffb8ce4e6f51c101aa0bbcac9ece5a9f77d036d5f3744c50b169980285be0f579f26cf42a4025f4db412bb9037cde3b6d689676c747505f3287b76f9957f872288c4275b17cdcbe7e3e9711779ac9e921161bf3", "010001", 1, "68656c6c6f20776f726c64", "7b2634026bcc5f75a5403ae2d7b640517fad26ad3763114c905a02fd6d7b148233849730c51310cba4b558e83bdfbb359c62a107931f74d89f32ced55d265fb8bf6a4e9f45f225e5ecc65cea4de3ffc15ecc52438f000d375635b7c0246443b29f4f6687b896e7f4cebd1d991089d81ef2a8272f795af77f9108a1dcc3a164a8") + refused("c1dc41748c62f1b87b545f7da699a45541bdddad4bac61a1e825cf7d9b97f823a2b0b04255209f3184bbdb272ffb8ce4e6f51c101aa0bbcac9ece5a9f77d036d5f3744c50b169980285be0f579f26cf42a4025f4db412bb9037cde3b6d689676c747505f3287b76f9957f872288c4275b17cdcbe7e3e9711779ac9e921161bf3", "010001", 2, "68656c6c6f20776f726c64", "56c1d68e893a3c4beffb1ccd74cb5b351f9b8346c040f9f1dabe16b157311cdd261fac29279ec8f15bde7869f51a6c1c0f3e1abc220573c5272ccddca8779fa58efd8578ed047aa9a7c1da74f2155053a3523c61eb70d541bfee4e5c8013c4d79bf63aa466f872d3ec10aea9e76e933be98095112538615304a10c6b29cc9a02");
}

fn tamper() -> u64
  ensures result <= 2000000
{
  return tamper_sig("", "010001", 1, "61", "") + tamper_rest("", "010001", 1, "61", "") + lengths("", "010001", 1, "61", "") + tamper_sig("", "010001", 2, "61", "") + tamper_rest("", "010001", 2, "61", "") + lengths("", "010001", 2, "61", "");
}

/// Signatures with SHA-384 and SHA-512, and the refusal of a signature under another hash or padding.
fn hashes() -> u64
  ensures result <= 2000000
{
  return 0
    + check("", "010001", 3, "68617368206167696c697479", "")
    + check("", "010001", 6, "68617368206167696c697479", "")
    + check("", "010001", 4, "68617368206167696c697479", "")
    + check("", "010001", 5, "68617368206167696c697479", "")
    + refused("", "010001", 2, "68617368206167696c697479", "")
    + refused("", "010001", 4, "68617368206167696c697479", "")
    + refused("", "010001", 3, "68617368206167696c697479", "")
    + refused("", "010001", 1, "68617368206167696c697479", "")
    + refused("", "010001", 5, "68617368206167696c697479", "")
    + refused("", "010001", 4, "68617368206167696c697479", "")
    + refused("", "010001", 6, "68617368206167696c697479", "")
    + refused("", "010001", 2, "68617368206167696c697479", "")
    + tamper_sig("", "010001", 3, "68617368206167696c697479", "")
    + tamper_sig("", "010001", 4, "68617368206167696c697479", "");
}

fn main() -> u64 {
  let n = good0() + good1() + good2() + good3() + good4() + good5() + good6() + refuse0() + refuse1() + refuse2() + refuse3() + refuse4() + refuse5() + refuse6() + small() + tamper() + hashes();
  if n > 0 { return 1; }
  return 0;
}
