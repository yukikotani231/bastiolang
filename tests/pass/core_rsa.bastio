fn refuse0() -> u64
  ensures result <= 16
{
  return 0
    + refused("", "010001", 1, "68656c6c6f20776f726c64", "")
    + refused("", "010001", 1, "68656c6c6f20776f726c64", "")
    + refused("", "010001", 1, "68656c6c6f20776f726c64", "")
    + refused("", "010001", 1, "68656c6c6f20776f726c64", "");
}

fn refuse1() -> u64
  ensures result <= 16
{
  return 0
    + refused("", "010001", 1, "61", "")
    + refused("", "010001", 1, "68656c6c6f20776f726c64", "")
    + refused("", "010001", 2, "68656c6c6f20776f726c64", "")
    + refused("", "010001", 2, "68656c6c6f20776f726c64", "");
}

fn refuse2() -> u64
  ensures result <= 16
{
  return 0
    + refused("", "010001", 2, "68656c6c6f20776f726c64", "")
    + refused("", "010001", 2, "68656c6c6f20776f726c64", "")
    + refused("", "010001", 2, "68656c6c6f20776f726c64", "")
    + refused("", "010001", 2, "68656c6c6f20776f726c64", "");
}

