// expect-exit: 0
// core/rsa: signatures made by Python's `cryptography` (OpenSSL) verify, in both
// paddings (RSASSA-PSS with a 32-byte salt and PKCS#1 v1.5), with keys of 2048, 2049 (the
// encoded message is a byte shorter than the key), 3072 and 4096 bits and the exponents
// 65537 and 3; and what breaks a rule is refused: another salt length or padding, a
// bad trailer, nonzero padding, a wrong DigestInfo, short padding, another message, one-bit
// changes of the signature, message and key, a key of 1024 bits, an even or tiny exponent,
// and a signature that is not below the modulus or not as long as the key.
import "core/rsa.bastio";

/// The value of the hex digit `c` (0 for anything else).
fn nib(c: u8) -> u8
  ensures result < 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 0;
}

/// The bytes written as hex digits in `s`.
fn unhex(s: Str) -> Bytes
  requires slen(s) < 100000
  ensures blen(result) == slen(s) / 2
{
  let n = slen(s) / 2;
  let mut b = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(b) == n && slen(s) >= 2 * n
  {
    bset(&mut b, i, nib(sget(s, 2 * i)) * 16 + nib(sget(s, 2 * i + 1)));
    i = i + 1;
  }
  return b;
}

/// 0 if `sig` (hex) is a valid signature of `msg` (hex) under the key (`n`, `e`; hex) in the padding `kind` (1 PSS, 2 PKCS#1 v1.5 with SHA-256; 3 PSS, 4 PKCS#1 v1.5 with SHA-384; 5 PKCS#1 v1.5, 6 PSS with SHA-512), else 1.
fn check(n: Str, e: Str, kind: u64, msg: Str, sig: Str) -> u64
  requires slen(n) < 8192 && slen(e) < 100 && slen(msg) < 100000 && slen(sig) < 8192
  ensures result <= 1
{
  let nb = unhex(n);
  let eb = unhex(e);
  let m = unhex(msg);
  let sg = unhex(sig);
  let mut ok = false;
  if kind == 1 { ok = rsa_pss_sha256_verify(nb, eb, m, sg); }
  if kind == 2 { ok = rsa_pkcs1_sha256_verify(nb, eb, m, sg); }
  if kind == 3 { ok = rsa_pss_verify(nb, eb, m, sg, 48); }
  if kind == 4 { ok = rsa_pkcs1_verify(nb, eb, m, sg, 48); }
  if kind == 5 { ok = rsa_pkcs1_verify(nb, eb, m, sg, 64); }
  if kind == 6 { ok = rsa_pss_verify(nb, eb, m, sg, 64); }
  bfree(sg);
  bfree(m);
  bfree(eb);
  bfree(nb);
  if ok { return 0; }
  return 1;
}

/// 1 if the signature verifies although it should not.
fn refused(n: Str, e: Str, kind: u64, msg: Str, sig: Str) -> u64
  requires slen(n) < 8192 && slen(e) < 100 && slen(msg) < 100000 && slen(sig) < 8192
  ensures result <= 1
{
  return 1 - check(n, e, kind, msg, sig);
}

/// `b` with bit `i` toggled.
fn flip(b: &mut Bytes, i: u64)
  requires i / 8 < blen(b)
  ensures blen(b) == blen(old(b))
{
  let mask = cast[u8](1 << (i % 8));
  bset(&mut b, i / 8, bget(b, i / 8) ^ mask);
}

/// The number of one-bit changes (every 61st bit) of the signature that still verify.
fn tamper_sig(n: Str, e: Str, kind: u64, msg: Str, sig: Str) -> u64
  requires slen(n) < 8192 && slen(e) < 100 && slen(msg) < 100000 && slen(sig) < 8192
  ensures result <= 100000
{
  let nb = unhex(n);
  let eb = unhex(e);
  let m = unhex(msg);
  let mut sg = unhex(sig);
  let mut bad = 0;
  let mut i = 0;
  while i < 8 * blen(sg) && bad < 100
    invariant i <= 8 * blen(sg) + 61 && blen(sg) < 4096 && blen(nb) < 4096 && blen(eb) < 50 && blen(m) < 100000 && bad <= 100
  {
    flip(&mut sg, i);
    let mut ok = false;
    if kind == 1 { ok = rsa_pss_sha256_verify(nb, eb, m, sg); }
    if kind == 2 { ok = rsa_pkcs1_sha256_verify(nb, eb, m, sg); }
    if ok { bad = bad + 1; }
    flip(&mut sg, i);
    i = i + 61;
  }
  bfree(sg);
  bfree(m);
  bfree(eb);
  bfree(nb);
  return bad;
}

/// The number of changes of the message's first byte (every bit) and of the key (every 97th bit of the modulus; the exponent set to 1, 2, 4 and 2^32 + 1) that still verify.
fn tamper_rest(n: Str, e: Str, kind: u64, msg: Str, sig: Str) -> u64
  requires slen(n) < 8192 && slen(e) < 100 && slen(msg) >= 2 && slen(msg) < 100000 && slen(sig) < 8192
  ensures result <= 40010
{
  let mut nb = unhex(n);
  let eb = unhex(e);
  let mut m = unhex(msg);
  let sg = unhex(sig);
  let mut bad = 0;
  let mut i = 0;
  while i < 8
    invariant i <= 8 && blen(m) >= 1 && blen(m) < 100000 && blen(nb) < 4096 && blen(eb) < 50 && blen(sg) < 4096 && bad <= i
  {
    flip(&mut m, i);
    let mut ok = false;
    if kind == 1 { ok = rsa_pss_sha256_verify(nb, eb, m, sg); }
    if kind == 2 { ok = rsa_pkcs1_sha256_verify(nb, eb, m, sg); }
    if ok { bad = bad + 1; }
    flip(&mut m, i);
    i = i + 1;
  }
  i = 0;
  while i < 8 * blen(nb)
    invariant i <= 8 * blen(nb) + 97 && blen(nb) < 4096 && blen(eb) < 50 && blen(sg) < 4096 && blen(m) < 100000 && bad <= 8 + i
  {
    flip(&mut nb, i);
    let mut ok = false;
    if kind == 1 { ok = rsa_pss_sha256_verify(nb, eb, m, sg); }
    if kind == 2 { ok = rsa_pkcs1_sha256_verify(nb, eb, m, sg); }
    if ok { bad = bad + 1; }
    flip(&mut nb, i);
    i = i + 97;
  }
  let mut j = 0;
  while j < 4
    invariant j <= 4 && blen(nb) < 4096 && blen(sg) < 4096 && blen(m) < 100000 && bad <= 40000 + j
  {
    let mut ex = balloc(5);
    if j == 0 { bset(&mut ex, 4, 1); }
    if j == 1 { bset(&mut ex, 4, 2); }
    if j == 2 { bset(&mut ex, 4, 4); }
    if j == 3 { bset(&mut ex, 0, 1); bset(&mut ex, 4, 1); }
    let mut ok = false;
    if kind == 1 { ok = rsa_pss_sha256_verify(nb, ex, m, sg); }
    if kind == 2 { ok = rsa_pkcs1_sha256_verify(nb, ex, m, sg); }
    if ok { bad = bad + 1; }
    bfree(ex);
    j = j + 1;
  }
  bfree(sg);
  bfree(m);
  bfree(eb);
  bfree(nb);
  return bad;
}

/// The number of malformed signatures (the modulus itself, one byte short, one byte long, all ones) that verify.
fn lengths(n: Str, e: Str, kind: u64, msg: Str, sig: Str) -> u64
  requires slen(n) < 8192 && slen(e) < 100 && slen(msg) < 100000 && slen(sig) >= 4 && slen(sig) < 8192
  ensures result <= 4
{
  let nb = unhex(n);
  let eb = unhex(e);
  let m = unhex(msg);
  let sg = unhex(sig);
  let mut bad = 0;
  let mut j = 0;
  while j < 4
    invariant j <= 4 && blen(nb) < 4096 && blen(eb) < 50 && blen(m) < 100000 && blen(sg) >= 2 && blen(sg) < 4096 && bad <= j
  {
    let mut t = balloc(blen(sg));
    if j == 0 { bfree(t); t = bytes_slice(nb, 0, blen(nb)); }
    if j == 1 { bfree(t); t = bytes_slice(sg, 0, blen(sg) - 1); }
    if j == 2 { bfree(t); t = bytes_concat(sg, sg); }
    if j == 3 {
      let mut q = 0;
      while q < blen(t)
        invariant q <= blen(t)
      {
        bset(&mut t, q, 255);
        q = q + 1;
      }
    }
    let mut ok = false;
    if kind == 1 { ok = rsa_pss_sha256_verify(nb, eb, m, t); }
    if kind == 2 { ok = rsa_pkcs1_sha256_verify(nb, eb, m, t); }
    if ok { bad = bad + 1; }
    bfree(t);
    j = j + 1;
  }
  bfree(sg);
  bfree(m);
  bfree(eb);
  bfree(nb);
  return bad;
}

fn good0() -> u64
  ensures result <= 16
{
  return 0
    + check("", "010001", 1, "61", "")
    + check("", "010001", 2, "61", "")
    + check("", "010001", 1, "68656c6c6f20776f726c64", "")
    + check("", "010001", 2, "68656c6c6f20776f726c64", "");
}

fn good1() -> u64
  ensures result <= 16
{
  return 0
    + check("", "010001", 1, "", "")
    + check("", "010001", 2, "", "")
    + check("", "03", 1, "61", "")
    + check("", "03", 2, "61", "");
}

fn good2() -> u64
  ensures result <= 16
{
  return 0
    + check("", "03", 1, "68656c6c6f20776f726c64", "")
    + check("", "03", 2, "68656c6c6f20776f726c64", "")
    + check("", "03", 1, "", "")
    + check("", "03", 2, "", "");
}

fn good3() -> u64
  ensures result <= 16
