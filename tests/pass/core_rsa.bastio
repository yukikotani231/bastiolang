    + refused("", "010001", 2, "61", "")
    + refused("", "010001", 1, "68656c6c6f20776f726c64", "")
    + refused("", "010001", 1, "68656c6c6f20776f726c64", "")
    + refused("", "010001", 1, "68656c6c6f20776f726c64", "");
