// expect-exit: 0
// expect-stdout: 1
// expect-stdout: 9
// expect-stdout: 2
// expect-stdout: 2
// expect-stdout: 3
// expect-stdout: 5
// expect-stdout: 6
// expect-stdout: 4
// expect-stdout: 7
// expect-stdout: 100
// expect-stdout: 120
// expect-stdout: 0
// A register written more than once keeps what a branch said about it only
// where nothing writes it again: `n` below is set inside the first test, so
// the second test of 435 may not be skipped on that path, but the path that
// failed the first test never reaches it.
fn pick(n0: u64, a: u64) -> u64 {
  let mut n = n0;
  if n == 435 {
    if a > 3 {
      print(a);
      n = 60;
    }
  }
  if n == 435 {
    return 1;
  }
  if n == 60 {
    return 2;
  }
  if n < 100 {
    if n < 50 {
      return 3;
    }
    if n >= 80 {
      return 6;
    }
    return 5;
  }
  if n >= 100 {
    if n > 1000 {
      return 7;
    }
    return 4;
  }
  return 9;
}

fn climb(n0: u64) -> u64 {
  let mut n = n0;
  let mut s = 0;
  let mut i = 0;
  while i < 6 {
    if n == 3 {
      s = wrap_add(s, 100);
      n = 4;
    }
    if n == 3 {
      s = wrap_add(s, 1);
    }
    if n < 5 {
      n = wrap_add(n, 1);
    }
    if n < 5 {
      s = wrap_add(s, 10);
    }
    i = wrap_add(i, 1);
  }
  return s;
}

fn main() -> u64 {
  print(pick(435, 2));
  print(pick(435, 9));
  print(pick(60, 0));
  print(pick(7, 0));
  print(pick(55, 0));
  print(pick(90, 0));
  print(pick(100, 0));
  print(pick(2000, 0));
  print(climb(3));
  print(climb(1));
  print(climb(9));
  return 0;
}
