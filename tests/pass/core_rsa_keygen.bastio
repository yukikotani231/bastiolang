// expect-exit: 0
// core/rsa: key generation helpers. rsa_key_parts gives n, d, d mod (p-1), d mod (q-1) and q^-1 mod p equal
// to Python's big-integer arithmetic for 1024-bit and 2048-bit primes drawn by OpenSSL (public exponents 65537
// and 3); a swapped pair, an even prime and an exponent that divides p - 1 are refused. rsa_probable_prime
// accepts those primes and refuses composites: 25326001 (a strong pseudoprime to the bases 2, 3 and 5), a
// product of two primes, even numbers and a number with a small factor.
import "core/rsa.bastio";

/// The value of the hex digit `c` (0 for anything else).
fn nib(c: u8) -> u8
  ensures result < 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 0;
}

/// The bytes written as hex digits in `s`.
fn unhex(s: Str) -> Bytes
  requires slen(s) < 100000
  ensures blen(result) == slen(s) / 2
{
  let n = slen(s) / 2;
  let mut b = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(b) == n && slen(s) >= 2 * n
  {
    bset(&mut b, i, nib(sget(s, 2 * i)) * 16 + nib(sget(s, 2 * i + 1)));
    i = i + 1;
  }
  return b;
}

/// Whether `r` is `Some` of the bytes written as hex in `want`; consumes `r`.
fn is_hex(r: Option[Bytes], want: Str) -> bool
  requires slen(want) < 100000
{
  match r {
    Option::None => { return false; },
    Option::Some(b) => {
      let w = unhex(want);
      let same = bytes_eq(b, w);
      bfree(w);
      bfree(b);
      return same;
    },
  }
}

/// Whether `r` is `None`; consumes `r`.
fn is_none(r: Option[Bytes]) -> bool {
  match r {
    Option::None => { return true; },
    Option::Some(b) => {
      bfree(b);
      return false;
    },
  }
}

/// Whether `a` is prime by `rsa_probable_prime` with 8 rounds.
fn prime(hex: Str) -> bool
  requires slen(hex) < 100000
{
  let c = unhex(hex);
  let r = rsa_probable_prime(c, 8);
  bfree(c);
  return r;
}

fn key0() -> u64 {
  let p = unhex("dd6140835192fb8e9a711d6464b6d7929e763bd3c4c0d5aee3dd25f4aa38cce6596ccf6a1e2a55c5498bfc6c28efff08646489b81e5814c47e4aaa292bfe0fd5");
  let q = unhex("dc1d609aebac1fbcbc446a856c53d4a44f71145d8ecfb02a601a6871cdad41a3228b77c0a3cf40af3fa194ca7909ae7063998bdeb2d5cc9fe66be13648d2a1a5");
  let mut bad = 0;
  if !is_hex(rsa_key_parts(p, q, 65537), "") { bad = wrap_add(bad, 1); }
  if !is_none(rsa_key_parts(q, p, 65537)) { bad = wrap_add(bad, 1); }
  if !is_none(rsa_key_parts(p, p, 65537)) { bad = wrap_add(bad, 1); }
  if !is_none(rsa_key_parts(p, q, 5)) { bad = wrap_add(bad, 1); }
  if !rsa_key_prime(p, 65537) { bad = wrap_add(bad, 1); }
  if !rsa_key_prime(q, 65537) { bad = wrap_add(bad, 1); }
  if rsa_key_prime(p, 5) { bad = wrap_add(bad, 1); }
  if !prime("dd6140835192fb8e9a711d6464b6d7929e763bd3c4c0d5aee3dd25f4aa38cce6596ccf6a1e2a55c5498bfc6c28efff08646489b81e5814c47e4aaa292bfe0fd5") || !prime("dc1d609aebac1fbcbc446a856c53d4a44f71145d8ecfb02a601a6871cdad41a3228b77c0a3cf40af3fa194ca7909ae7063998bdeb2d5cc9fe66be13648d2a1a5") { bad = wrap_add(bad, 1); }
  if prime("be58faff9979ba6d1dc81a16c6ae7ef35262a2a9c56dfd4997a56dba732891c599683cf7b40555cfa242789837ef67fdbefa178d43f4436d645885f598bf7bd0de76b7e445ab91c66e698bcb83f0f2705bca5efa03ad3f9454bdc0e1492933a3daf54a19ba0eebf8a83fbfe030619b97cc704d1dae35da3c14d1a7ff076f2949") { bad = wrap_add(bad, 1); }
  let mut ev = unhex("dd6140835192fb8e9a711d6464b6d7929e763bd3c4c0d5aee3dd25f4aa38cce6596ccf6a1e2a55c5498bfc6c28efff08646489b81e5814c47e4aaa292bfe0fd5");
  bset(&mut ev, blen(ev) - 1, bget(ev, blen(ev) - 1) ^ 1);
  if rsa_probable_prime(ev, 8) { bad = wrap_add(bad, 1); }
  bset(&mut ev, blen(ev) - 1, bget(ev, blen(ev) - 1) ^ 3);
  if rsa_probable_prime(ev, 8) { bad = wrap_add(bad, 1); }
  bfree(ev);
  bfree(q);
  bfree(p);
  return bad;
}

fn key1() -> u64 {
  let p = unhex("d0b3f077574b7d223cd4a702b7ea0fd541d5b99d789f72c46bbc09fbbc01de845fbe8ac94439a3c1c65e0eb80473090845c690d27e288fb746d24407872c9a4cb3c42936e516c4bf600bf9fce76e47e48d522bf6c75e2a9c2b047758d7e0d1a89f966805c26dae733f60d488fc98abb459db9541f9945fd97e73151ab5f218f7");
  let q = unhex("bed5a0ab66b9a8fe9bb9a44f56fdc9e1e790a9d3cb1c0b071f5092758145570883314bb88e134a8ec772714fa29451182a4af5bc2f947438c4c8f9d309de73660e21db22d68a595fa0f46cfad7cc2fbecc27f075b6f00a937a317929b3886ee724ab87e47c7d1118f60e6ce955e26fce7d8058f8856ae5997f9eaaa58824072b");
  let mut bad = 0;
  if !is_hex(rsa_key_parts(p, q, 65537), "") { bad = wrap_add(bad, 1); }
  if !is_none(rsa_key_parts(q, p, 65537)) { bad = wrap_add(bad, 1); }
  if !is_none(rsa_key_parts(p, p, 65537)) { bad = wrap_add(bad, 1); }
  if !is_none(rsa_key_parts(p, q, 11)) { bad = wrap_add(bad, 1); }
  if !rsa_key_prime(p, 65537) { bad = wrap_add(bad, 1); }
  if !rsa_key_prime(q, 65537) { bad = wrap_add(bad, 1); }
  if rsa_key_prime(p, 11) { bad = wrap_add(bad, 1); }
  if !prime("d0b3f077574b7d223cd4a702b7ea0fd541d5b99d789f72c46bbc09fbbc01de845fbe8ac94439a3c1c65e0eb80473090845c690d27e288fb746d24407872c9a4cb3c42936e516c4bf600bf9fce76e47e48d522bf6c75e2a9c2b047758d7e0d1a89f966805c26dae733f60d488fc98abb459db9541f9945fd97e73151ab5f218f7") || !prime("bed5a0ab66b9a8fe9bb9a44f56fdc9e1e790a9d3cb1c0b071f5092758145570883314bb88e134a8ec772714fa29451182a4af5bc2f947438c4c8f9d309de73660e21db22d68a595fa0f46cfad7cc2fbecc27f075b6f00a937a317929b3886ee724ab87e47c7d1118f60e6ce955e26fce7d8058f8856ae5997f9eaaa58824072b") { bad = wrap_add(bad, 1); }
  if prime("") { bad = wrap_add(bad, 1); }
  let mut ev = unhex("d0b3f077574b7d223cd4a702b7ea0fd541d5b99d789f72c46bbc09fbbc01de845fbe8ac94439a3c1c65e0eb80473090845c690d27e288fb746d24407872c9a4cb3c42936e516c4bf600bf9fce76e47e48d522bf6c75e2a9c2b047758d7e0d1a89f966805c26dae733f60d488fc98abb459db9541f9945fd97e73151ab5f218f7");
  bset(&mut ev, blen(ev) - 1, bget(ev, blen(ev) - 1) ^ 1);
  if rsa_probable_prime(ev, 8) { bad = wrap_add(bad, 1); }
  bset(&mut ev, blen(ev) - 1, bget(ev, blen(ev) - 1) ^ 3);
  if rsa_probable_prime(ev, 8) { bad = wrap_add(bad, 1); }
  bfree(ev);
  bfree(q);
  bfree(p);
  return bad;
}

fn key2() -> u64 {
  let p = unhex("ef7addf5e0fba23d2c5e5c68e1c0edc4408f6d60b1f484b1fbe4f657fd0f9489de1984dfe4090c7f2945534f3440160421e21d26c76a8ee666d5c4aea3f8d015");
  let q = unhex("ce6acfbfa8073ba972e5a935a50a95d5dd15e5cd30f29701fb5a78068261386acb96aac143aaad3b0c1166fc4bf00d7a6045003f2c2bace078f488dc2ccc03a5");
  let mut bad = 0;
  if !is_hex(rsa_key_parts(p, q, 3), "") { bad = wrap_add(bad, 1); }
  if !is_none(rsa_key_parts(q, p, 3)) { bad = wrap_add(bad, 1); }
  if !is_none(rsa_key_parts(p, p, 3)) { bad = wrap_add(bad, 1); }
  if !is_none(rsa_key_parts(p, q, 5)) { bad = wrap_add(bad, 1); }
  if !rsa_key_prime(p, 3) { bad = wrap_add(bad, 1); }
  if !rsa_key_prime(q, 3) { bad = wrap_add(bad, 1); }
  if rsa_key_prime(p, 5) { bad = wrap_add(bad, 1); }
  if !prime("ef7addf5e0fba23d2c5e5c68e1c0edc4408f6d60b1f484b1fbe4f657fd0f9489de1984dfe4090c7f2945534f3440160421e21d26c76a8ee666d5c4aea3f8d015") || !prime("ce6acfbfa8073ba972e5a935a50a95d5dd15e5cd30f29701fb5a78068261386acb96aac143aaad3b0c1166fc4bf00d7a6045003f2c2bace078f488dc2ccc03a5") { bad = wrap_add(bad, 1); }
  if prime("c118c9d3662e75f1fd13d98280007da2fc8c2fb59f610a40a1a76212fd8e73c385a2812344f3a8d29c7bb9f95680b25eead2445392e8274a9baa2ed30626826efcb72d6db008506bff4bef7b18e9ba6780d340a64078ebb66a13aa44a8a3a153032e6ea7d1a310de2b4f8324638ac28d8a26d715b92f641cccd13891068a5c89") { bad = wrap_add(bad, 1); }
  let mut ev = unhex("ef7addf5e0fba23d2c5e5c68e1c0edc4408f6d60b1f484b1fbe4f657fd0f9489de1984dfe4090c7f2945534f3440160421e21d26c76a8ee666d5c4aea3f8d015");
  bset(&mut ev, blen(ev) - 1, bget(ev, blen(ev) - 1) ^ 1);
  if rsa_probable_prime(ev, 8) { bad = wrap_add(bad, 1); }
  bset(&mut ev, blen(ev) - 1, bget(ev, blen(ev) - 1) ^ 3);
  if rsa_probable_prime(ev, 8) { bad = wrap_add(bad, 1); }
  bfree(ev);
  bfree(q);
  bfree(p);
  return bad;
}

fn small() -> u64 {
  let mut bad = 0;
  if prime("0182b731") { bad = wrap_add(bad, 1); }
  if !prime("1fffffffffffffff") { bad = wrap_add(bad, 1); }
  if prime("1ffffffffffffffd") { bad = wrap_add(bad, 1); }
  if prime("bf8d6d57") { bad = wrap_add(bad, 1); }
  if prime("000102030405") { bad = wrap_add(bad, 1); }
  if prime("010203") { bad = wrap_add(bad, 1); }
  // 7919 * 104729 and 2^31 - 1 (prime), 2^32 - 5 (prime).
  if prime("316edc57") { bad = wrap_add(bad, 1); }
  if !prime("7fffffff") { bad = wrap_add(bad, 1); }
  if !prime("fffffffb") { bad = wrap_add(bad, 1); }
  return bad;
}

fn main() -> u64 {
  let mut bad = small();
  bad = wrap_add(bad, key0());
  bad = wrap_add(bad, key1());
  bad = wrap_add(bad, key2());
  return bad;
}
