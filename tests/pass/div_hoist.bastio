// expect-exit: 0
// expect-stdout: 87
// expect-stdout: 51
// expect-stdout: 0
// expect-stdout: 411217848
// expect-stdout: 430966297
// A division or remainder by a constant inside a loop uses a multiplier that
// is made once in front of the loop (here: odd, even, large and
// just-above-2^31 divisors; nested loops; a loop entered after a test).
fn digits(n: u64) -> u64 {
  let mut x = n;
  let mut s = 0;
  let mut k = 0;
  while x > 0 && k < 20
    invariant s <= 9 * k && k <= 20
  {
    s = s + x % 10;
    x = x / 10;
    k = k + 1;
  }
  return s;
}

fn mix(n: u64) -> u64
  requires n <= 100000
{
  let mut t: u64 = 0;
  let mut i: u64 = 0;
  while i < n
    invariant i <= n && t < 1000000007
  {
    let v = i * 2654435761 + 12345;
    t = (t + v / 3 + v % 7 + v / 641 + v % 1000 + v / 6 + v % 12 + v / 1000000007) % 1000000007;
    let mut j: u64 = 0;
    while j < 3
      invariant j <= 3 && t < 1000000007
    {
      t = (t + (v + j) / 12 + (v + j) % 2147483659) % 1000000007;
      j = j + 1;
    }
    i = i + 1;
  }
  return t;
}

fn main() -> u64 {
  print(digits(18446744073709551615));
  print(digits(1234567890123));
  print(mix(0));
  print(mix(1000));
  print(mix(100000));
  return 0;
}
