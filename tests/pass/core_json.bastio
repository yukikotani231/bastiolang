// expect-exit: 0
// The JSON scanner accepts what RFC 8259 accepts and refuses what it does
// not, without reading outside the buffer on any prefix of a document.
import "../../core/json.bastio";

// 0: the whole text is one valid value; 1: cut short; 2: invalid.
fn kind(src: Str) -> u64 {
  let b = bfrom(src);
  let mut r = 3;
  match json_value(b, 0) {
    Json::Ok(e) => {
      if json_ws(b, e) == blen(b) { r = 0; } else { r = 2; }
    },
    Json::Partial => { r = 1; },
    Json::Bad(x) => { r = 2; },
  }
  bfree(b);
  return r;
}

fn want(src: Str, k: u64) -> u64
  ensures result <= 1
{
  if kind(src) != k { return 1; }
  return 0;
}

// `n` opening brackets, `n` closing ones.
fn nested(n: u64) -> u64 {
  if n > 100 { return 9; }
  let mut t = text_new();
  let mut i = 0;
  while i < n
    invariant i <= n
  {
    text_push(&mut t, 91);
    i = i + 1;
  }
  i = 0;
  while i < n
    invariant i <= n
  {
    text_push(&mut t, 93);
    i = i + 1;
  }
  let b = text_finish(t);
  let mut r = 3;
  match json_value(b, 0) {
    Json::Ok(e) => { r = 0; },
    Json::Partial => { r = 1; },
    Json::Bad(x) => { r = 2; },
  }
  bfree(b);
  return r;
}


// The writer: what json_out_finish gives for `o` must be `want`, and a scan
// must take it whole.
fn out_is(o: JsonOut, want: Str) -> u64
  ensures result <= 1
{
  match json_out_finish(o) {
    Option::Some(b) => {
      let mut r = 0;
      if !bytes_eq_str(b, want) { r = 1; }
      match json_value(b, 0) {
        Json::Ok(e) => { if e != blen(b) { r = 1; } },
        Json::Partial => { r = 1; },
        Json::Bad(x) => { r = 1; },
      }
      bfree(b);
      return r;
    },
    Option::None => { return 1; },
  }
}

fn out_none(o: JsonOut) -> u64
  ensures result <= 1
{
  match json_out_finish(o) {
    Option::Some(b) => { bfree(b); return 1; },
    Option::None => { return 0; },
  }
}

fn key(o: &mut JsonOut, k: Str) {
  let b = bfrom(k);
  json_out_key(&mut o, b);
  bfree(b);
}

fn out_doc() -> u64
  ensures result <= 1
{
  let mut o = json_out_new();
  json_out_begin_obj(&mut o);
  key(&mut o, "id");
  json_out_u64(&mut o, 7);
  key(&mut o, "tags");
  json_out_begin_arr(&mut o);
  let a = bfrom("a");
  let q = bfrom("b\"c");
  json_out_str(&mut o, a);
  json_out_str(&mut o, q);
  bfree(a);
  bfree(q);
  json_out_end(&mut o);
  key(&mut o, "ok");
  json_out_bool(&mut o, true);
  key(&mut o, "none");
  json_out_null(&mut o);
  key(&mut o, "nested");
  json_out_begin_obj(&mut o);
  key(&mut o, "x");
  json_out_begin_arr(&mut o);
  json_out_end(&mut o);
  json_out_end(&mut o);
  json_out_end(&mut o);
  return out_is(o, "{\"id\":7,\"tags\":[\"a\",\"b\\\"c\"],\"ok\":true,\"none\":null,\"nested\":{\"x\":[]}}");
}

// Calls that do not fit the place they are made in: the writer goes bad.
fn out_misuse() -> u64
  ensures result <= 12
{
  let mut bad = 0;
  // a value in an object without a key
  let mut o1 = json_out_new();
  json_out_begin_obj(&mut o1);
  json_out_u64(&mut o1, 1);
  json_out_end(&mut o1);
  bad = bad + out_none(o1);
  // a key in an array
  let mut o2 = json_out_new();
  json_out_begin_arr(&mut o2);
  key(&mut o2, "k");
  json_out_end(&mut o2);
  bad = bad + out_none(o2);
  // two keys in a row
  let mut o3 = json_out_new();
  json_out_begin_obj(&mut o3);
  key(&mut o3, "a");
  key(&mut o3, "b");
  json_out_null(&mut o3);
  json_out_end(&mut o3);
  bad = bad + out_none(o3);
  // a key with no value at the end
  let mut o4 = json_out_new();
  json_out_begin_obj(&mut o4);
  key(&mut o4, "a");
  json_out_end(&mut o4);
  bad = bad + out_none(o4);
  // a key at the top level
  let mut o5 = json_out_new();
  key(&mut o5, "a");
  bad = bad + out_none(o5);
  // an end with nothing open
  let mut o6 = json_out_new();
  json_out_end(&mut o6);
  bad = bad + out_none(o6);
  // a container never closed, and nothing written
  let mut o7 = json_out_new();
  json_out_begin_arr(&mut o7);
  json_out_u64(&mut o7, 1);
  bad = bad + out_none(o7);
  bad = bad + out_none(json_out_new());
  // two top-level values, also after a container
  let mut o8 = json_out_new();
  json_out_begin_arr(&mut o8);
  json_out_end(&mut o8);
  json_out_null(&mut o8);
  bad = bad + out_none(o8);
  // a good call after a bad one does not bring it back
  let mut o9 = json_out_new();
  json_out_end(&mut o9);
  json_out_null(&mut o9);
  bad = bad + out_none(o9);
  return bad;
}

// Arrays nested n deep, each holding the next.
fn out_deep(n: u64) -> u64
  requires n <= 64
{
  let mut o = json_out_new();
  let mut i = 0;
  while i < n
    invariant i <= n
  {
    json_out_begin_arr(&mut o);
    i = i + 1;
  }
  i = 0;
  while i < n
    invariant i <= n
  {
    json_out_end(&mut o);
    i = i + 1;
  }
  match json_out_finish(o) {
    Option::Some(b) => {
      let mut r = 0;
      if blen(b) != 2 * n { r = 1; }
      match json_value(b, 0) {
        Json::Ok(e) => { if e != blen(b) { r = 1; } },
        Json::Partial => { r = 1; },
        Json::Bad(x) => { r = 1; },
      }
      bfree(b);
      return r;
    },
    Option::None => { return 2; },
  }
}

fn main() -> u64 {
  let mut bad = 0;
  bad = bad + want("0", 0);
  bad = bad + want("-0", 0);
  bad = bad + want("-12.5e+3", 0);
  bad = bad + want(" [ ] ", 0);
  bad = bad + want("{}", 0);
  bad = bad + want("{\"a\":[{}],\"b\":null}", 0);
  bad = bad + want("\"\\u00e9\\\"\"", 0);
  bad = bad + want("01", 2);
  bad = bad + want("1.", 1);
  bad = bad + want("1.e3", 2);
  bad = bad + want("+1", 2);
  bad = bad + want("[1,]", 2);
  bad = bad + want("[,1]", 2);
  bad = bad + want("{\"a\":1,}", 2);
  bad = bad + want("{a:1}", 2);
  bad = bad + want("{'a':1}", 2);
  bad = bad + want("[1 2]", 2);
  bad = bad + want("{\"a\" 1}", 2);
  bad = bad + want("[}", 2);
  bad = bad + want("{]", 2);
  bad = bad + want("\"a\tb\"", 2);
  bad = bad + want("\"\\x\"", 2);
  bad = bad + want("\"\\u12g4\"", 2);
  bad = bad + want("tru", 1);
  bad = bad + want("trux", 2);
  bad = bad + want("nul", 1);
  bad = bad + want("[1] 2", 2);
  bad = bad + want("", 1);

  bad = bad + out_doc();
  bad = bad + out_misuse();
  // The writer takes 32 levels and refuses 33, as the scanner does.
  if out_deep(32) != 0 { bad = bad + 1; }
  if out_deep(33) != 2 { bad = bad + 1; }

  // Nesting: 32 deep is accepted, 33 is refused.
  if nested(32) != 0 { bad = bad + 1; }
  if nested(33) != 2 { bad = bad + 1; }

  // What json_push_string writes, json_string reads back, for every ASCII byte.
  let mut all = balloc(128);
  let mut k = 0;
  while k < 128
    invariant k <= 128 && blen(all) == 128
  {
    bset(&mut all, k, cast[u8](k));
    k = k + 1;
  }
  let mut t = text_new();
  json_push_string(&mut t, all);
  let w = text_finish(t);
  match json_value(w, 0) {
    Json::Ok(e) => { if e != blen(w) { bad = bad + 1; } },
    Json::Partial => { bad = bad + 1; },
    Json::Bad(x) => { bad = bad + 1; },
  }
  match json_string(w, 0) {
    Option::Some(v) => { if !bytes_eq(v, all) { bad = bad + 1; } bfree(v); },
    Option::None => { bad = bad + 1; },
  }
  bfree(w);
  bfree(all);

  // Valid UTF-8 is copied and read back; a byte that starts no sequence is
  // written as U+FFFD; and raw invalid bytes in a document are refused.
  let u = bfrom("aé€😀b");
  let mut mixed = balloc(blen(u) + 1);
  let mut q = 0;
  while q < blen(u)
    invariant q <= blen(u) && blen(mixed) == blen(u) + 1
  {
    bset(&mut mixed, q, bget(u, q));
    q = q + 1;
  }
  bset(&mut mixed, blen(u), 255);
  let mut t2 = text_new();
  json_push_string(&mut t2, mixed);
  let w2 = text_finish(t2);
  match json_string(w2, 0) {
    Option::Some(v) => {
      if blen(v) != blen(u) + 3 {
        bad = bad + 1;
      } else {
        let head = bytes_slice(v, 0, blen(u));
        if !bytes_eq(head, u) { bad = bad + 1; }
        bfree(head);
      }
      bfree(v);
    },
    Option::None => { bad = bad + 1; },
  }
  bfree(w2);
  bfree(mixed);
  bfree(u);
  // 0xC3 0x28 inside a string is not UTF-8; 0xE2 0x82 at the end is cut short.
  let mut raw = bfrom("\"ab\"");
  bset(&mut raw, 1, 195);
  bset(&mut raw, 2, 40);
  match json_value(raw, 0) {
    Json::Bad(x) => {},
    Json::Ok(e) => { bad = bad + 1; },
    Json::Partial => { bad = bad + 1; },
  }
  bfree(raw);
  let mut half = bfrom("\"ab");
  bset(&mut half, 1, 226);
  bset(&mut half, 2, 130);
  match json_value(half, 0) {
    Json::Partial => {},
    Json::Ok(e) => { bad = bad + 1; },
    Json::Bad(x) => { bad = bad + 1; },
  }
  bfree(half);

  // Every prefix of a document is "cut short" or invalid, never a crash.
  let doc = bfrom("{\"k\": [1, {\"z\": \"\\u00e9\"}, false], \"n\": -1.5E2}");
  let mut miss = false;
  let mut cut = 0;
  while cut < blen(doc)
    invariant cut <= blen(doc)
  {
    let pre = bytes_slice(doc, 0, cut);
    match json_value(pre, 0) {
      Json::Ok(e) => { miss = true; },
      Json::Partial => {},
      Json::Bad(x) => { miss = true; },
    }
    bfree(pre);
    cut = cut + 1;
  }
  bfree(doc);
  if miss { bad = bad + 1; }
  return bad;
}
