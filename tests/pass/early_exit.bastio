// expect-exit: 0
// expect-stdout: 5702887
// expect-stdout: 1275
// expect-stdout: 161
// expect-stdout: 91
// A function that tests its parameters and returns a value computed from
// them at once is entered through a stub without a frame on native-ir; the
// rest of the function must see its parameters unchanged.
fn fib(n: u64) -> u64 {
  if n < 2 {
    return n;
  }
  return wrap_add(fib(n - 1), fib(n - 2));
}

// The return at once is on the other branch.
fn tri(n: u64, k: u64) -> u64
  requires n <= 100
{
  if n != 0 {
    return wrap_add(tri(n - 1, k), n);
  }
  return k;
}

// Two parameters in the test, a computed value returned, three parameters
// that the rest of the function reads after the test.
fn mix(a: u64, b: u64, c: u64) -> u64 {
  if wrap_add(a, b) > c {
    return a ^ wrap_add(b, 7);
  }
  let t = wrap_add(wrap_add(a, b), c);
  if t > 1000 {
    return t;
  }
  return wrap_add(mix(wrap_add(a, 100), wrap_add(b, 10), wrap_add(c, 1)), t);
}

// More than four parameters: no stub.
fn many(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64) -> u64 {
  if a > b {
    return wrap_add(c, d);
  }
  return wrap_add(wrap_add(a, b), wrap_add(wrap_add(c, d), wrap_add(e, f)));
}

fn main() -> u64 {
  print(fib(34));
  print(tri(50, 0));
  print(mix(3, 4, 40));
  print(wrap_add(many(1, 2, 3, 4, 5, 6), many(5, 1, 30, 40, 0, 0)));
  return 0;
}
