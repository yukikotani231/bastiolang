// expect-exit: 0
// expect-stdout: 1417643604
// expect-stdout: 2272563339
// expect-stdout: 2128580714
// expect-stdout: 2147483648
// expect-stdout: 1
// A rotation of a 32-bit word written as shifts and an or (a shift each way,
// the left one reduced to 32 bits) is one `roll`; the word that is rotated
// may be made by an xor into the register the rotation overwrites. Other
// shapes (a word that is also read elsewhere, a variable amount, a u64 word)
// keep the plain instructions.
fn rotl(x: u32, n: u64) -> u32
  requires n >= 1 && n <= 31
{
  return wrap[u32](cast[u64](x) << n) | (x >> (32 - n));
}

fn rotr7(x: u32) -> u32 {
  return (x >> 7) | wrap[u32](cast[u64](x) << 25);
}

fn mix(a: u32, b: u32) -> u32 {
  let t = a ^ b;
  let r = wrap[u32](cast[u64](t) << 13) | (t >> 19);
  return wrap_add(r, t);
}

fn main() -> u64 {
  let mut a: u32 = 305419896;
  let mut b: u32 = 2596069104;
  let mut c: u32 = 1;
  let mut i = 0;
  while i < 1000
    invariant i <= 1000
  {
    a = wrap_add(a, b); b = b ^ a; b = rotl(b, 16);
    c = wrap_add(c, b); a = a ^ c; a = wrap[u32](cast[u64](a) << 12) | (a >> 20);
    c = rotr7(c);
    a = mix(a, c);
    c = wrap_add(c, 1);
    i = i + 1;
  }
  print(cast[u64](a));
  print(cast[u64](b));
  print(cast[u64](c));
  print(cast[u64](rotl(1, 31)));
  print(cast[u64](rotl(2147483648, 1)));
  return 0;
}
