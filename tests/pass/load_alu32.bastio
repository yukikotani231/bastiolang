// Sums and differences modulo 2^32 and plain 64-bit operations with a table
// element as one operand are written with the element as a memory operand.
fn sums(a: &Vec[u32], b: &Vec[u32]) -> u64
  requires vlen(a) == 64 && vlen(b) == 64
{
  let mut i = 0;
  let mut h: u32 = 7;
  let mut acc: u64 = 0;
  while i < 64
    invariant i <= 64 && vlen(a) == 64 && vlen(b) == 64
  {
    let x = vec_get(a, i);
    let y = vec_get(b, i);
    let s = wrap_add(x, y);
    let d = wrap_sub(y, x);
    let e = wrap_sub(x, y);
    h = wrap_add(wrap_sub(h, y), wrap_add(s, d));
    acc = wrap_add(acc, cast[u64](wrap_add(e, h)));
    i = i + 1;
  }
  return acc;
}

fn once(a: &Vec[u32], b: &Vec[u32]) -> u64
  requires vlen(a) == 64 && vlen(b) == 64
{
  let mut i = 0;
  let mut h: u32 = 5;
  let mut g: u32 = 9;
  let mut k: u64 = 1;
  while i < 64
    invariant i <= 64 && vlen(a) == 64 && vlen(b) == 64
  {
    h = wrap_add(h, vec_get(a, i));
    h = wrap_sub(h, vec_get(b, i));
    g = wrap_sub(vec_get(a, i + 0), g);
    k = k ^ cast[u64](h);
    k = wrap_add(k, cast[u64](g));
    i = i + 1;
  }
  return k % 1000000007 + cast[u64](h) + cast[u64](g);
}

fn mixed(t: &Vec[u64]) -> u64
  requires vlen(t) == 16
{
  let mut i = 0;
  let mut x: u64 = 1;
  let mut y: u64 = 3;
  while i < 16
    invariant i <= 16 && vlen(t) == 16
  {
    let z = x ^ vec_get(t, i);
    y = wrap_add(y & vec_get(t, i), z | i);
    x = wrap_sub(vec_get(t, 15 - i), y);
    i = i + 1;
  }
  return x % 10000 + y % 10000;
}

fn main() -> u64 {
  let mut a = vec_new[u32]();
  let mut b = vec_new[u32]();
  let mut t = vec_new[u64]();
  let mut i = 0;
  while i < 64
    invariant vlen(a) == i && vlen(b) == i && i <= 64
  {
    vec_push(&mut a, cast[u32](i * 65537 + 3));
    vec_push(&mut b, cast[u32](4294967295 - i * 1000003));
    i = i + 1;
  }
  i = 0;
  while i < 16
    invariant vlen(t) == i && i <= 16
  {
    vec_push(&mut t, i * 2654435761 + 11);
    i = i + 1;
  }
  print(sums(a, b));
  print(cast[u64](vec_get(a, 63)));
  print(once(a, b));
  print(mixed(t) % 100000);
  vec_free(a);
  vec_free(b);
  vec_free(t);
  return 0;
}
