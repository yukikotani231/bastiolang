/// 1 unless the signature `sig` under `pubkey` of the message whose digest is `digest` (all in hex) verifies.
fn good_digest(pubkey: Str, digest: Str, sig: Str) -> u64
  requires slen(pubkey) == 194 && slen(digest) < 1000 && slen(sig) < 400
  ensures result <= 1
{
  let p = unhex(pubkey);
  let d = unhex(digest);
  let s = unhex(sig);
  let ok = ecdsa_p384_verify_digest(p, d, s);
  bfree(s);
  bfree(d);
  bfree(p);
  if ok { return 0; }
  return 1;
}

