// expect-exit: 0
// expect-stdout: 118
// expect-stdout: 3142
// expect-stdout: 91735
// A jump to a short join (the end of an `if`/`else` before the loop's test)
// is replaced by a copy of the join in the native backend; the result must be
// the same whichever arm ran.
fn steps(n: u64) -> u64 {
  let mut x = n;
  let mut c: u64 = 0;
  while x != 1 && c < 1000
    invariant c <= 1000
  {
    if x % 2 == 0 {
      x = x / 2;
    } else if x <= 384307168202282325 {
      x = 3 * x + 1;
    } else {
      x = 1;
    }
    c = c + 1;
  }
  return c;
}

// The join reads a value both arms make, then tests twice.
fn mix(n: u64) -> u64 {
  let mut y: u64 = 1;
  let mut k: u64 = 0;
  let mut acc: u64 = 0;
  while k < n && y != 0
    invariant k <= n
  {
    if k % 3 == 0 {
      y = wrap_add(y, 1);
    } else {
      y = wrap_add(wrap_mul(y, 2), k);
    }
    let z = y ^ k;
    acc = wrap_add(acc, z);
    k = k + 1;
  }
  return wrap_add(acc, y);
}

fn main() -> u64 {
  print(steps(97));
  let mut i: u64 = 1;
  let mut s: u64 = 0;
  while i <= 100
    invariant i >= 1 && i <= 101
  {
    s = wrap_add(s, steps(i));
    i = i + 1;
  }
  print(s);
  print(mix(500) % 100000);
  return 0;
}
