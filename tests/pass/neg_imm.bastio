// expect-exit: 0
// expect-stdout: 1048575
// expect-stdout: 18446744073709551615
// expect-stdout: 1047676
// `K - x` and `0 - x` where the result replaces x: a negation and an add.
fn mirror(x: u64) -> u64 {
  let m = x % 1048576;
  return wrap_sub(1048575, m);
}

fn neg(x: u64) -> u64 {
  return wrap_sub(0, x);
}

fn main() -> u64 {
  let mut x = mirror(0);
  print(x);
  x = neg(1);
  print(x);
  x = mirror(899);
  print(x);
  return 0;
}
