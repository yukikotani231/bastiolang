// expect-exit: 42
// I/O ports: a driver claims its ports from `Ports`, can touch only those,
// and gives them back. Hosted programs simulate the ports, each one
// remembering the last value written to it.

/// A device with eight byte-wide registers, like a 16550 UART.
struct Dev { io: PortIo }

fn dev_open(ports: &mut Ports, base: u64) -> Dev
  requires base + 8 <= 65536
  requires forall k: u64 :: base <= k && k < base + 8 ==> port_free(ports, k)
  ensures port_count(result.io) == 8 && port_base(result.io) == base
  ensures forall k: u64 :: port_free(ports, k) == (port_free(old(ports), k) && !(base <= k && k < base + 8))
{
  return Dev { io: port_claim(&mut ports, base, 8) };
}

fn dev_set(d: &mut Dev, reg: u64, v: u8)
  requires port_count(d.io) == 8 && reg < 8
  ensures port_count(d.io) == 8 && port_base(d.io) == port_base(old(d).io)
{
  pio_out8(&mut d.io, reg, v);
}

fn main(ports: &mut Ports) -> u64 {
  let mut a = dev_open(&mut ports, 0x3F8);
  // A second device on other ports is fine.
  let mut b = dev_open(&mut ports, 0x2F8);
  dev_set(&mut a, 7, 40);
  dev_set(&mut b, 7, 2);
  let x = cast[u64](pio_in8(&mut a.io, 7)) + cast[u64](pio_in8(&mut b.io, 7));
  // Wider accesses take two or four of the ports.
  pio_out16(&mut a.io, 0, 0xBEEF);
  pio_out32(&mut b.io, 4, 0xDEADBEEF);
  let y = pio_in16(&mut a.io, 0);
  let z = pio_in32(&mut b.io, 4);
  port_release(&mut ports, a.io);
  // Released ports can be claimed again.
  let c = port_claim(&mut ports, 0x3F8, 1);
  port_release(&mut ports, c);
  port_release(&mut ports, b.io);
  if y == 0xBEEF && z == 0xDEADBEEF {
    return x;
  }
  return 1;
}
