// expect-exit: 70
// Fill a buffer, then sum it. Every index and every addition is proved safe
// at compile time; the generated C has no runtime checks.

fn fill(mut b: Buf, v: u64) -> Buf
  ensures len(result) == len(b)
  ensures forall j: u64 :: j < len(result) ==> get(result, j) == v
{
  let mut i = 0;
  while i < len(b)
    invariant i <= len(b)
    invariant forall j: u64 :: j < i ==> get(b, j) == v
  {
    b = set(b, i, v);
    i = i + 1;
  }
  return b;
}

fn sum(b: &Buf) -> u64
  requires len(b) <= 1000
  requires forall j: u64 :: j < len(b) ==> get(b, j) <= 1000
  ensures result <= 1000000
{
  let mut s = 0;
  let mut i = 0;
  while i < len(b)
    invariant i <= len(b)
    invariant s <= i * 1000
  {
    s = s + get(b, i);
    i = i + 1;
  }
  return s;
}

fn main() -> u64 {
  let a = alloc(10);
  let b = fill(a, 7);
  let s = sum(b);
  free(b);
  return s;
}
