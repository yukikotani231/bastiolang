// expect-exit: 0
// expect-stdout: 390215
// A chain of six to eight equality tests of one value is tested one by one
// (iropt_switch keeps the halving compares for longer chains): with a
// repeated constant (the first test wins), a run of consecutive constants
// with one target, and a constant at the top of the range. Every value from
// 0 to 39 and the largest u64 are tried.
fn six(n: u64) -> u64 {
  if n == 4 { return 1; }
  if n == 9 { return 2; }
  if n == 9 { return 50; }
  if n == 2 { return 3; }
  if n == 30 { return 4; }
  if n == 7 { return 5; }
  if n == 18446744073709551615 { return 6; }
  return 0;
}

fn run3(n: u64) -> u64 {
  if n == 10 { return 1; }
  if n == 11 { return 1; }
  if n == 12 { return 1; }
  if n == 13 { return 2; }
  if n == 20 { return 3; }
  if n == 0 { return 4; }
  if n == 1 { return 5; }
  return 0;
}

fn main() -> u64 {
  let mut s = 0;
  let mut n = 0;
  while n < 40
    invariant n <= 40 && s < 1000003
  {
    s = wrap_add(wrap_add(wrap_mul(s, 3), wrap_mul(six(n), 7)), run3(n)) % 1000003;
    n = n + 1;
  }
  s = wrap_add(wrap_mul(s, 3), six(18446744073709551615)) % 1000003;
  print(s);
  return 0;
}
