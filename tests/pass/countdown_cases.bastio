// expect-exit: 0
// expect-stdout: 1000
// expect-stdout: 7
// expect-stdout: 0
// expect-stdout: 90
// expect-stdout: 405
// A loop whose counter only counts passes runs `sub; jne` on a counter that
// goes the other way. Checked: a start above zero, a loop that never runs, a
// step that only some passes take, a counter that is read in the body (it
// keeps counting up), and a loop inside another (the outer counter alone is
// changed).
fn main() -> u64 {
  let mut a = 0;
  let mut i = 0;
  while i < 1000
    invariant i <= 1000 && a == i
  {
    a = a + 1;
    i = i + 1;
  }
  print(a);
  let mut b = 0;
  let mut j = 3;
  while j < 10
    invariant j <= 10 && b + 3 == j
  {
    b = b + 1;
    j = j + 1;
  }
  print(b);
  let mut c = 0;
  let mut k = 10;
  while k < 10
    invariant k == 10 && c == 0
  {
    c = c + 1;
    k = k + 1;
  }
  print(c);
  let mut s = 0;
  let mut m = 0;
  while m < 10
    invariant m <= 10 && s <= m * 9
  {
    s = s + m;
    m = m + 1;
  }
  print(s * 2);
  let mut t = 0;
  let mut o = 0;
  while o < 9
    invariant o <= 9 && t <= o * 9
  {
    let mut q = 0;
    while q < 9
      invariant q <= 9 && t <= o * 9 + q
    {
      t = t + 1;
      q = q + 1;
    }
    o = o + 1;
  }
  print(t + 324);
  return 0;
}
