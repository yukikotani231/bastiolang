// stage1-only: host_net (sockets), std/http
// expect-exit: 0
// The strict request parser sits behind http_accept: a head it rejects is
// answered with 400 and never reaches the caller, and an accepted one gives
// the method and target.
import "std/http.bastio";

/// Sends `text` on a new connection to the listener `s` (on port `p`) and
/// returns the connection, if it was made and the text went.
fn client(h: &Host, p: u64, text: Str) -> Option[u64] {
  match net_connect(h, net_ip4(127, 0, 0, 1), p) {
    Option::Some(c) => {
      let b = bfrom(text);
      let ok = net_send_all(h, c, b);
      bfree(b);
      if ok {
        return Option[u64]::Some(c);
      }
      net_close(h, c);
      return Option[u64]::None;
    },
    Option::None => { return Option[u64]::None; },
  }
}

/// Sends `text` as a request, reads its body with `limit` as the bound and
/// returns the body (`None` if it was refused). With `close`, the client
/// closes its side after sending, as a peer that gives up does.
fn body_of(h: &Host, s: u64, p: u64, text: Str, limit: u64, close: bool) -> Option[Bytes] {
  match client(h, p, text) {
    Option::Some(c) => {
      if close { net_close(h, c); }
      match http_accept(h, s, 4096) {
        Option::Some(r) => {
          let b = http_req_body(h, r, limit);
          http_close(h, r);
          if !close { net_close(h, c); }
          return b;
        },
        Option::None => {
          if !close { net_close(h, c); }
          return Option[Bytes]::None;
        },
      }
    },
    Option::None => { return Option[Bytes]::None; },
  }
}

/// Counts 1 unless the body read from `text` is `want`, or, with `refused`,
/// the read is refused.
fn expect_body(h: &Host, s: u64, p: u64, text: Str, limit: u64, close: bool, want: Str, refused: bool) -> u64 {
  match body_of(h, s, p, text, limit, close) {
    Option::Some(b) => {
      let ok = !refused && bytes_eq_str(b, want);
      bfree(b);
      if ok { return 0; }
      return 1;
    },
    Option::None => {
      if refused { return 0; }
      return 1;
    },
  }
}

fn main(h: &mut Host) -> u64 {
  let mut bad = 0;
  match net_listen(h, net_ip4(127, 0, 0, 1), 0) {
    Option::Some(s) => {
      let p = net_port(h, s);
      // A bare LF ends the line: rejected, and the client is told so.
      match client(h, p, "GET / HTTP/1.1\nHost: x\n\n") {
        Option::Some(c) => {
          // A head needs CR LF CR LF to be read at all, so this one is never
          // complete: close the client side to let the server give up.
          net_close(h, c);
          match http_accept(h, s, 4096) {
            Option::Some(r) => { http_close(h, r); bad = bad + 1; },
            Option::None => {},
          }
        },
        Option::None => { bad = bad + 1; },
      }
      // Complete but invalid: a space before the colon of a field.
      match client(h, p, "GET / HTTP/1.1\r\nHost : x\r\n\r\n") {
        Option::Some(c) => {
          match http_accept(h, s, 4096) {
            Option::Some(r) => { http_close(h, r); bad = bad + 1; },
            Option::None => {},
          }
          match http_read_all(h, c, 4096) {
            Option::Some(m) => {
              if http_status(m) != 400 { bad = bad + 1; }
              bfree(m);
            },
            Option::None => { bad = bad + 1; },
          }
          net_close(h, c);
        },
        Option::None => { bad = bad + 1; },
      }
      // A good one: method and target.
      match client(h, p, "POST /a/b?c=d HTTP/1.1\r\nHost: x\r\n\r\n") {
        Option::Some(c) => {
          match http_accept(h, s, 4096) {
            Option::Some(r) => {
              let t = http_req_target(r);
              if !http_req_is(r, "POST") || http_req_is(r, "GET") || !bytes_eq_str(t, "/a/b?c=d") {
                bad = bad + 1;
              }
              bfree(t);
              http_close(h, r);
            },
            Option::None => { bad = bad + 1; },
          }
          net_close(h, c);
        },
        Option::None => { bad = bad + 1; },
      }
      // Bodies: a length, chunks, none, and the ways to be refused.
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello", 100, false, "hello", false) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhelloEXTRA", 100, false, "hello", false) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nhel\r\n2;ext=1\r\nlo\r\n0\r\nX: y\r\n\r\n", 100, false, "hello", false) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "GET / HTTP/1.1\r\nHost: x\r\n\r\n", 100, false, "", false) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello", 4, false, "", true) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nhel\r\n2\r\nlo\r\n0\r\n\r\n", 4, false, "", true) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nContent-Length: 5\r\n\r\nhello", 100, false, "", true) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n", 100, false, "", true) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 9\r\n\r\nhello", 100, true, "", true) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhel", 100, true, "", true) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n", 100, false, "", true) != 0 { bad = bad + 1; }
      net_close(h, s);
    },
    Option::None => { bad = bad + 1; },
  }
  return bad;
}
