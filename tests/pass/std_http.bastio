// stage1-only: host_net (sockets), std/http
// expect-exit: 0
// The strict request parser sits behind http_accept: a head it rejects is
// answered with 400 and never reaches the caller, and an accepted one gives
// the method and target.
import "std/http.bastio";

/// Sends `text` on a new connection to the listener `s` (on port `p`) and
/// returns the connection, if it was made and the text went.
fn client(h: &Host, p: u64, text: Str) -> Option[u64] {
  match net_connect(h, net_ip4(127, 0, 0, 1), p) {
    Option::Some(c) => {
      let b = bfrom(text);
      let ok = net_send_all(h, c, b);
      bfree(b);
      if ok {
        return Option[u64]::Some(c);
      }
      net_close(h, c);
      return Option[u64]::None;
    },
    Option::None => { return Option[u64]::None; },
  }
}

/// Sends `text` as a request, reads its body with `limit` as the bound and
/// returns the body (`None` if it was refused). With `close`, the client
/// closes its side after sending, as a peer that gives up does.
fn body_of(h: &Host, s: u64, p: u64, text: Str, limit: u64, close: bool) -> Option[Bytes] {
  match client(h, p, text) {
    Option::Some(c) => {
      if close { net_close(h, c); }
      match http_accept(h, s, 4096) {
        Option::Some(mut r) => {
          let b = http_req_body(h, &mut r, limit);
          http_close(h, r);
          if !close { net_close(h, c); }
          return b;
        },
        Option::None => {
          if !close { net_close(h, c); }
          return Option[Bytes]::None;
        },
      }
    },
    Option::None => { return Option[Bytes]::None; },
  }
}

/// Counts 1 unless the body read from `text` is `want`, or, with `refused`,
/// the read is refused.
fn expect_body(h: &Host, s: u64, p: u64, text: Str, limit: u64, close: bool, want: Str, refused: bool) -> u64 {
  match body_of(h, s, p, text, limit, close) {
    Option::Some(b) => {
      let ok = !refused && bytes_eq_str(b, want);
      bfree(b);
      if ok { return 0; }
      return 1;
    },
    Option::None => {
      if refused { return 0; }
      return 1;
    },
  }
}

/// Has the server side of a new connection send `text`, closes it, and reads
/// the response on the client side. Counts 1 unless the response ends with
/// `want` after its head, or, with `refused`, the read is refused.
fn expect_resp(h: &Host, s: u64, p: u64, text: Str, limit: u64, want: Str, refused: bool) -> u64
  ensures result <= 1
{
  let mut bad = 1;
  match net_connect(h, net_ip4(127, 0, 0, 1), p) {
    Option::Some(c) => {
      match net_accept(h, s) {
        Option::Some(a) => {
          let b = bfrom(text);
          let sent = net_send_all(h, a, b);
          bfree(b);
          net_close(h, a);
          match http_read_response(h, c, limit) {
            Option::Some(m) => {
              match http_body_start(m) {
                Option::Some(at) => {
                  if sent && !refused && at <= blen(m) && bytes_span_eq_str(m, at, blen(m), want) { bad = 0; }
                },
                Option::None => {},
              }
              bfree(m);
            },
            Option::None => {
              if refused { bad = 0; }
            },
          }
        },
        Option::None => {},
      }
      net_close(h, c);
    },
    Option::None => {},
  }
  return bad;
}

/// Sends `first` as a request, accepts it, sends `more` (which the server has
/// not seen yet), reads the body and says whether the connection may carry
/// another request. False also when anything failed.
fn body_keeps(h: &Host, s: u64, p: u64, first: Str, more: Str) -> bool {
  let mut keeps = false;
  match client(h, p, first) {
    Option::Some(c) => {
      match http_accept(h, s, 4096) {
        Option::Some(mut r) => {
          let b = bfrom(more);
          let sent = net_send_all(h, c, b);
          bfree(b);
          match http_req_body(h, &mut r, 100) {
            Option::Some(body) => {
              bfree(body);
              keeps = sent && http_req_keeps(r);
            },
            Option::None => {},
          }
          http_close(h, r);
        },
        Option::None => {},
      }
      net_close(h, c);
    },
    Option::None => {},
  }
  return keeps;
}

/// 1 unless `body_keeps` says `want`.
fn expect_keeps(h: &Host, s: u64, p: u64, first: Str, more: Str, want: bool) -> u64
  ensures result <= 1
{
  if body_keeps(h, s, p, first, more) == want { return 0; }
  return 1;
}

/// A POST with a body, answered with keep-alive, then a GET on the same
/// connection. Counts 1 unless the second request arrives.
fn post_then_get(h: &Host, s: u64, p: u64) -> u64
  ensures result <= 1
{
  let mut bad = 1;
  match client(h, p, "POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello") {
    Option::Some(c) => {
      match http_accept(h, s, 4096) {
        Option::Some(mut r) => {
          match http_req_body(h, &mut r, 100) {
            Option::Some(body) => {
              let reply = bfrom("ok\n");
              match http_answer(h, r, 200, "OK", "text/plain", reply) {
                Option::Some(k) => {
                  let g = bfrom("GET /b HTTP/1.1\r\nHost: x\r\n\r\n");
                  let sent = net_send_all(h, c, g);
                  bfree(g);
                  match http_read_request(h, k, 4096) {
                    Option::Some(r2) => {
                      let t = http_req_target(r2);
                      if sent && bytes_eq_str(body, "hello") && bytes_eq_str(t, "/b") { bad = 0; }
                      bfree(t);
                      http_close(h, r2);
                    },
                    Option::None => { net_close(h, k); },
                  }
                },
                Option::None => {},
              }
              bfree(reply);
              bfree(body);
            },
            Option::None => { http_close(h, r); },
          }
        },
        Option::None => {},
      }
      net_close(h, c);
    },
    Option::None => {},
  }
  return bad;
}

fn main(h: &mut Host) -> u64 {
  let mut bad = 0;
  match net_listen(h, net_ip4(127, 0, 0, 1), 0) {
    Option::Some(s) => {
      let p = net_port(h, s);
      // A bare LF ends the line: rejected, and the client is told so.
      match client(h, p, "GET / HTTP/1.1\nHost: x\n\n") {
        Option::Some(c) => {
          // A head needs CR LF CR LF to be read at all, so this one is never
          // complete: close the client side to let the server give up.
          net_close(h, c);
          match http_accept(h, s, 4096) {
            Option::Some(r) => { http_close(h, r); bad = bad + 1; },
            Option::None => {},
          }
        },
        Option::None => { bad = bad + 1; },
      }
      // Complete but invalid: a space before the colon of a field.
      match client(h, p, "GET / HTTP/1.1\r\nHost : x\r\n\r\n") {
        Option::Some(c) => {
          match http_accept(h, s, 4096) {
            Option::Some(r) => { http_close(h, r); bad = bad + 1; },
            Option::None => {},
          }
          match http_read_all(h, c, 4096) {
            Option::Some(m) => {
              if http_status(m) != 400 { bad = bad + 1; }
              bfree(m);
            },
            Option::None => { bad = bad + 1; },
          }
          net_close(h, c);
        },
        Option::None => { bad = bad + 1; },
      }
      // A good one: method and target.
      match client(h, p, "POST /a/b?c=d HTTP/1.1\r\nHost: x\r\n\r\n") {
        Option::Some(c) => {
          match http_accept(h, s, 4096) {
            Option::Some(r) => {
              let t = http_req_target(r);
              if !http_req_is(r, "POST") || http_req_is(r, "GET") || !bytes_eq_str(t, "/a/b?c=d") {
                bad = bad + 1;
              }
              bfree(t);
              http_close(h, r);
            },
            Option::None => { bad = bad + 1; },
          }
          net_close(h, c);
        },
        Option::None => { bad = bad + 1; },
      }
      // Bodies: a length, chunks, none, and the ways to be refused.
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello", 100, false, "hello", false) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhelloEXTRA", 100, false, "hello", false) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nhel\r\n2;ext=1\r\nlo\r\n0\r\nX: y\r\n\r\n", 100, false, "hello", false) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "GET / HTTP/1.1\r\nHost: x\r\n\r\n", 100, false, "", false) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello", 4, false, "", true) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nhel\r\n2\r\nlo\r\n0\r\n\r\n", 4, false, "", true) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nContent-Length: 5\r\n\r\nhello", 100, false, "", true) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n", 100, false, "", true) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 9\r\n\r\nhello", 100, true, "", true) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhel", 100, true, "", true) != 0 { bad = bad + 1; }
      if expect_body(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n", 100, false, "", true) != 0 { bad = bad + 1; }
      // Chunked responses are decoded; framing errors, a short stream and a
      // body over the limit are refused.
      bad = bad + expect_resp(h, s, p, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nhel\r\n2\r\nlo\r\n0\r\n\r\n", 100, "hello", false);
      bad = bad + expect_resp(h, s, p, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n", 100, "", false);
      bad = bad + expect_resp(h, s, p, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nA;ext=1\r\n0123456789\r\n0\r\n\r\n", 100, "0123456789", false);
      bad = bad + expect_resp(h, s, p, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhel", 100, "", true);
      bad = bad + expect_resp(h, s, p, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n", 100, "", true);
      bad = bad + expect_resp(h, s, p, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n9\r\n012345678\r\n0\r\n\r\n", 8, "", true);
      // A body read to its end leaves the connection for the next request,
      // unless the client asked to close, sent more than the body, or used
      // chunked framing.
      bad = bad + expect_keeps(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello", "", true);
      bad = bad + expect_keeps(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhe", "llo", true);
      bad = bad + expect_keeps(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\n", "hello", true);
      bad = bad + expect_keeps(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhelloGET", "", false);
      bad = bad + expect_keeps(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello", "", false);
      bad = bad + expect_keeps(h, s, p, "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n", "", false);
      bad = bad + post_then_get(h, s, p);
      // Keep-alive: a request that asks to close, a body or a second request
      // sent early gets its connection closed after the answer.
      match client(h, p, "GET / HTTP/1.1\r\nHost: x\r\n\r\nGET /2 HTTP/1.1\r\nHost: x\r\n\r\n") {
        Option::Some(c) => {
          match http_accept(h, s, 4096) {
            Option::Some(r) => {
              let b = bfrom("one\n");
              match http_answer(h, r, 200, "OK", "text/plain", b) {
                Option::Some(k) => { net_close(h, k); bad = bad + 1; },
                Option::None => {},
              }
              bfree(b);
            },
            Option::None => { bad = bad + 1; },
          }
          match http_read_all(h, c, 4096) {
            Option::Some(m) => {
              if http_status(m) != 200 { bad = bad + 1; }
              let pat = bfrom("Connection: close");
              match bytes_find(m, pat, 0) {
                Option::Some(i) => {},
                Option::None => { bad = bad + 1; },
              }
              bfree(pat);
              bfree(m);
            },
            Option::None => { bad = bad + 1; },
          }
          net_close(h, c);
        },
        Option::None => { bad = bad + 1; },
      }
      match client(h, p, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 2\r\n\r\nhi") {
        Option::Some(c) => {
          match http_accept(h, s, 4096) {
            Option::Some(r) => {
              let b = bfrom("one\n");
              match http_answer(h, r, 200, "OK", "text/plain", b) {
                Option::Some(k) => { net_close(h, k); bad = bad + 1; },
                Option::None => {},
              }
              bfree(b);
            },
            Option::None => { bad = bad + 1; },
          }
          net_close(h, c);
        },
        Option::None => { bad = bad + 1; },
      }
      net_close(h, s);
    },
    Option::None => { bad = bad + 1; },
  }
  return bad;
}
