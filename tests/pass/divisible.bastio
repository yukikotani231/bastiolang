// expect-exit: 0
// expect-stdout: 333334
// expect-stdout: 666666
// expect-stdout: 157
// expect-stdout: 1
// A remainder test against zero with an odd constant divisor needs no
// division: x % K == 0 is a multiply by the inverse of K and one compare.
fn count3(n: u64) -> u64 {
  let mut c: u64 = 0;
  let mut i: u64 = 0;
  while i < n
    invariant i <= n && c <= i
  {
    if i % 3 == 0 { c = c + 1; }
    i = i + 1;
  }
  return c;
}

fn not3(n: u64) -> u64 {
  let mut c: u64 = 0;
  let mut i: u64 = 0;
  while i < n
    invariant i <= n && c <= i
  {
    if i % 3 != 0 { c = c + 1; }
    i = i + 1;
  }
  return c;
}

fn big(n: u64) -> u64
  requires n <= 1000000
{
  let mut c: u64 = 0;
  let mut i: u64 = 0;
  while i < n
    invariant i <= n && c <= i
  {
    if (i * 7) % 641 == 0 { c = c + 1; }
    i = i + 1;
  }
  return c;
}

fn main() -> u64 {
  print(count3(1000000));
  print(not3(1000000));
  print(big(100000));
  let m: u64 = 1000000007 * 5;
  if m % 1000000007 == 0 { print(1); } else { print(0); }
  return 0;
}
