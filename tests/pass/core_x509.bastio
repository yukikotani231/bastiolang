// expect-exit: 0
// core/x509: certificates made by Python's `cryptography` (OpenSSL) are read (ECDSA P-256,
// RSA and Ed25519 keys and signatures, UTCTime and GeneralizedTime, basicConstraints,
// keyUsage, subjectAltName), a chain of three (EC root, RSA intermediate, EC leaf) and the
// Ed25519 pair verify, and everything else is refused: a certificate signed by another
// key, a leaf checked against the root, a critical extension that is not understood, a
// SHA-384 signature, a CA without keyCertSign, other names, wildcards that are not allowed,
// and a certificate with any one bit changed (every bit position, spaced).
import "core/x509.bastio";

/// The value of the hex digit `c` (0 for anything else).
fn nib(c: u8) -> u8
  ensures result < 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 0;
}

/// The bytes written as hex digits in `s`.
fn unhex(s: Str) -> Bytes
  requires slen(s) < 100000
  ensures blen(result) == slen(s) / 2
{
  let n = slen(s) / 2;
  let mut b = balloc(n);
  let mut i = 0;
  while i < n
    invariant i <= n && blen(b) == n && slen(s) >= 2 * n
  {
    bset(&mut b, i, nib(sget(s, 2 * i)) * 16 + nib(sget(s, 2 * i + 1)));
    i = i + 1;
  }
  return b;
}

/// 0 if `hex` is a certificate with these fields.
fn fields(hex: Str, sig_kind: u64, key_kind: u64, nb: u64, na: u64, ca: bool, ku: u64) -> u64
  requires slen(hex) < 10000 && na < 1000000000000
  ensures result <= 1
{
  let b = unhex(hex);
  let mut bad = 1;
  match x509_parse(b) {
    Option::Some(x) => {
      if x.sig_kind == sig_kind && x.key_kind == key_kind && x.not_before == nb && x.not_after == na && x.is_ca == ca && x.key_usage == ku && x509_valid_at(x, nb) && x509_valid_at(x, na) && !x509_valid_at(x, na + 1) && x509_can_sign(x) == (ca && (ku == 65535 || (ku & 4) != 0)) {
        bad = 0;
      }
    },
    Option::None => {},
  }
  bfree(b);
  return bad;
}

/// 0 if `chex` parses, `ihex` parses and the first was signed by the second.
fn signed(chex: Str, ihex: Str) -> u64
  requires slen(chex) < 10000 && slen(ihex) < 10000
  ensures result <= 1
{
  let cb = unhex(chex);
  let ib = unhex(ihex);
  let mut bad = 1;
  match x509_parse(cb) {
    Option::Some(x) => {
      match x509_parse(ib) {
        Option::Some(y) => {
          if x509_signed_by(cb, x, ib, y) { bad = 0; }
        },
        Option::None => {},
      }
    },
    Option::None => {},
  }
  bfree(ib);
  bfree(cb);
  return bad;
}

/// 1 if `chex` was signed by `ihex`.
fn unsigned(chex: Str, ihex: Str) -> u64
  requires slen(chex) < 10000 && slen(ihex) < 10000
  ensures result <= 1
{
  return 1 - signed(chex, ihex);
}

/// 0 if `x509_has_name(hex, name)` is `want`.
fn named(hex: Str, name: Str, want: bool) -> u64
  requires slen(hex) < 10000
  ensures result <= 1
{
  let b = unhex(hex);
  let mut bad = 1;
  match x509_parse(b) {
    Option::Some(x) => {
      let nb = bfrom(name);
      if x509_has_name(b, x, nb) == want { bad = 0; }
      bfree(nb);
    },
    Option::None => {},
  }
  bfree(b);
  return bad;
}

/// 1 if `hex` is read as a certificate.
fn readable(hex: Str) -> u64
  requires slen(hex) < 10000
  ensures result <= 1
{
  let b = unhex(hex);
  let mut bad = 0;
  match x509_parse(b) {
    Option::Some(x) => { bad = 1; },
    Option::None => {},
  }
  bfree(b);
  return bad;
}

/// `b` with bit `i` toggled.
fn flip(b: &mut Bytes, i: u64)
  requires i / 8 < blen(b)
  ensures blen(b) == blen(old(b))
{
  let mask = cast[u8](1 << (i % 8));
  bset(&mut b, i / 8, bget(b, i / 8) ^ mask);
}

/// The number of one-bit changes of the certificate `chex` (about 60 of them, spread over all of it) that still read and verify against `ihex`.
fn tamper(chex: Str, ihex: Str) -> u64
  requires slen(chex) < 10000 && slen(ihex) < 10000
  ensures result <= 100000
{
  let mut cb = unhex(chex);
  let ib = unhex(ihex);
  let mut bad = 0;
  match x509_parse(ib) {
    Option::None => { bad = 1; },
    Option::Some(y) => {
      let step = 8 * blen(cb) / 60 + 1;
      let mut i = 0;
      while i < 8 * blen(cb)
        invariant i <= 8 * blen(cb) + step && blen(cb) < 5000 && step >= 1 && bad <= i
      {
        flip(&mut cb, i);
        match x509_parse(cb) {
          Option::Some(x) => {
            if x509_signed_by(cb, x, ib, y) { bad = bad + 1; }
          },
          Option::None => {},
        }
        flip(&mut cb, i);
        i = i + step;
      }
    },
  }
  bfree(ib);
  bfree(cb);
  return bad;
}

fn fld0() -> u64
  ensures result <= 3
{
  return fields("", 2, 2, 1577836800, 2208988800, true, 6) + fields("", 2, 1, 1577836800, 2208988800, true, 6) + fields("", 1, 2, 1577836800, 2208988800, false, 128);
}

fn fld1() -> u64
  ensures result <= 3
{
  return fields("", 3, 3, 1577836800, 2208988800, true, 6) + fields("", 3, 3, 1577836800, 2208988800, false, 65535) + fields("", 1, 1, 1577836800, 2208988800, true, 65535);
}

fn fld2() -> u64
  ensures result <= 3
{
  return fields("", 2, 2, 946684799, 2569233600, false, 65535) + fields("", 2, 2, 1577836800, 2208988800, false, 65535) + fields("", 2, 2, 1577836800, 2208988800, false, 65535);
}

fn fld3() -> u64
  ensures result <= 3
{
  return fields("", 2, 1, 1577836800, 2208988800, false, 128) + fields("", 2, 1, 1577836800, 2208988800, true, 128) + fields("", 2, 2, 1577836800, 2208988800, false, 65535);
}

fn sgn0() -> u64
  ensures result <= 3
{
  return signed("", "") + signed("", "") + signed("", "");
}

fn sgn1() -> u64
  ensures result <= 3
{
  return signed("", "") + signed("", "") + signed("", "");
}

fn sgn2() -> u64
  ensures result <= 3
{
  return signed("", "") + signed("", "") + signed("", "");
}

fn sgn3() -> u64
  ensures result <= 2
{
  return signed("", "") + signed("", "");
}

fn uns0() -> u64
  ensures result <= 3
{
  return unsigned("", "") + unsigned("", "") + unsigned("", "");
}

fn uns1() -> u64
  ensures result <= 3
{
  return unsigned("", "") + unsigned("", "") + unsigned("", "");
}

fn uns2() -> u64
  ensures result <= 3
{
  return unsigned("", "") + unsigned("", "") + unsigned("", "");
}

fn uns3() -> u64
  ensures result <= 1
{
  return unsigned("", "");
}

fn nam0() -> u64
  ensures result <= 3
{
  return named("", "example.com", true) + named("", "EXAMPLE.COM", true) + named("", "www.example.com", false);
}

fn nam1() -> u64
  ensures result <= 3
{
  return named("", "example.org", false) + named("", "a.example.org", true) + named("", "A.Example.ORG", true);
}

fn nam2() -> u64
  ensures result <= 3
{
  return named("", "a.b.example.org", false) + named("", ".example.org", false) + named("", "www.example.net", true);
}

fn nam3() -> u64
  ensures result <= 3
{
  return named("", "example.net", false) + named("", "", false) + named("", "com", false);
}

fn nam4() -> u64
  ensures result <= 3
{
  return named("", "example.com", false) + named("", "a.com", false) + named("", "com", false);
}

fn nam5() -> u64
  ensures result <= 3
{
  return named("", "anything", false) + named("", "foo.example.net", false) + named("", "foobar.example.net", false);
}

fn nam6() -> u64
  ensures result <= 3
{
  return named("", "a.b.example.net", false) + named("", "x.b.example.org", true) + named("", "b.example.org", false);
}

fn nam7() -> u64
  ensures result <= 3
{
  return named("", "example.org", true) + named("", "EXAMPLE.org", true) + named("", "t.example", true);
}

fn nam8() -> u64
  ensures result <= 2
{
  return named("", "x", false) + named("", "ed.example", true);
}

fn rdg0() -> u64
  ensures result <= 3
{
  return readable("") + readable("") + readable("");
}

fn rdg1() -> u64
  ensures result <= 2
{
  return readable("3000") + readable("");
}

fn tmp0() -> u64
  ensures result <= 300000
{
  return tamper("", "") + tamper("", "") + tamper("", "");
}

fn tmp1() -> u64
  ensures result <= 200000
{
  return tamper("", "") + tamper("", "");
}

fn main() -> u64 {
  let n = fld0() + fld1() + fld2() + fld3() + sgn0() + sgn1() + sgn2() + sgn3() + uns0() + uns1() + uns2() + uns3() + nam0() + nam1() + nam2() + nam3() + nam4() + nam5() + nam6() + nam7() + nam8() + rdg0() + rdg1() + tmp0() + tmp1();
  if n > 0 { return 1; }
  return 0;
}
