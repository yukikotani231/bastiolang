// expect-exit: 14
// A `Box[T]` (stage1/ir.bastio) is one register, the address of its
// allocation: `box` allocates and copies the contents in, a field through a
// box is a field of the struct it points to, and `unbox` copies the contents
// out and frees.
struct Pair { a: u64, b: u64 }
struct Cell { p: Box[Pair], tag: u64 }

fn make(a: u64, b: u64) -> Box[Pair] {
  return box(Pair { a: a, b: b });
}

fn sum(p: &Box[Pair]) -> u64 {
  return wrap_add(p.a, p.b);
}

fn main() -> u64 {
  let b = make(3, 4);
  let s = sum(b);
  let c = Cell { p: b, tag: s };
  let q = unbox(c.p);
  return wrap_add(wrap_add(q.a, q.b), c.tag);
}
