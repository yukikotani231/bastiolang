// expect-exit: 0
// A vector variable assigned from another vector variable that is made
// afresh on every pass of a loop. Both names stand for headers in the
// frame, so the assignment must move the words: the header of the vector
// made on the next pass is written again before the old one is used.
fn keep(src: &Vec[u64], skip: u64) -> Vec[u64] {
  let mut out = vec_new[u64]();
  let mut k = 0;
  while k < vec_len(src) {
    if vec_get(src, k) != skip {
      vec_push(&mut out, vec_get(src, k));
    }
    k = k + 1;
  }
  return out;
}

fn main() -> u64 {
  let mut cur = vec_new[u64]();
  vec_push(&mut cur, 1);
  vec_push(&mut cur, 2);
  vec_push(&mut cur, 3);
  vec_push(&mut cur, 4);
  let mut i = 0;
  while i < 3
    invariant i <= 3
  {
    let mut next = vec_new[u64]();
    let mut k = 0;
    while k < vec_len(cur) {
      if vec_get(cur, k) != i + 1 {
        vec_push(&mut next, vec_get(cur, k));
      }
      k = k + 1;
    }
    vec_free(cur);
    cur = next;
    i = i + 1;
  }
  let ok = vec_len(cur) == 1 && vec_get(cur, 0) == 4;
  vec_free(cur);
  if ok {
    return 0;
  }
  return 1;
}
