// expect-exit: 7
// `match` through a `&mut` parameter: the arms move the value out, the
// function puts a new one back, and the caller learns which variant it is.
enum Slot { Full(Buf), Vacant }
fn take(s: &mut Slot) -> u64
  ensures s is Slot::Vacant
  ensures old(s) is Slot::Full ==> result == len(old(s).Full)
{
  let mut n = 0;
  match s {
    Slot::Full(b) => { n = len(b); free(b); },
    Slot::Vacant => {},
  }
  s = Slot::Vacant;
  return n;
}
fn main() -> u64 { let mut s = Slot::Full(alloc(7)); let n = take(&mut s); assert n == 7; assert s is Slot::Vacant; match s { Slot::Full(b) => {free(b);}, Slot::Vacant => {}, } return n; }
