// expect-exit: 7
// Copies to and from a page lent to a device are bracketed by `fence dma`.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 1 {
    return 0;
  }
  let mut msg = balloc(8);
  bset(&mut msg, 0, 7);
  let mut d = dma_lend(pool_take(&mut pool, 0));
  bytes_to_dma(&mut d, 16, msg, 0, 8);
  let mut got = balloc(8);
  dma_to_bytes(&mut got, 0, &mut d, 16, 8);
  let r = cast[u64](bget(got, 0));
  pool_give(&mut pool, dma_take(d));
  bfree(msg);
  bfree(got);
  return r;
}
