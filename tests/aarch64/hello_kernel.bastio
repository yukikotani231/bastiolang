// stage1-only: the AArch64 kernel target
// The smallest kernel the native AArch64 backend builds (tests/aarch64.sh):
// the console on the PL011 UART and the allocator (a Vec and Bytes that
// grow), no pool, tables or processor yet. Booted with the test platform.
import "core/print.bastio";

fn main(con: &mut Serial) -> u64 {
  print_str(con, "hello from the native AArch64 kernel\n");
  let mut v = vec_new[u64]();
  let mut i = 0;
  while i < 1000
    invariant vlen(v) == i
  {
    vec_push(&mut v, i * i);
    i = i + 1;
  }
  let mut sum = 0;
  i = 0;
  while i < vec_len(v)
    invariant i <= vlen(v)
  {
    sum = wrap_add(sum, vec_get(v, i));
    i = i + 1;
  }
  vec_free(v);
  print_str(con, "sum of squares: ");
  print_u64(con, sum);
  print_str(con, "\n");
  let mut b = balloc(40);
  i = 0;
  while i < 40
    invariant i <= 40 && blen(b) == 40
  {
    bset(&mut b, i, cast[u8](65 + i % 26));
    i = i + 1;
  }
  i = 0;
  while i < 40
    invariant i <= 40 && blen(b) == 40
  {
    serial_write(con, bget(b, i));
    i = i + 1;
  }
  bfree(b);
  print_str(con, "\n");
  print_hex(con, 0xDEADBEEF);
  print_str(con, "\n");
  return 0;
}
