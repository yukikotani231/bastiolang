// expect-error: E-VERIFY-OWN
// Taking a page dirty takes it out of the pool like pool_take: it cannot be
// handed out a second time.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 1 {
    return 0;
  }
  let d = pool_take_dirty(&mut pool, 0);
  let f = pool_take(&mut pool, 0);
  pool_give(&mut pool, dirty_zero(d));
  pool_give(&mut pool, f);
  return 0;
}
