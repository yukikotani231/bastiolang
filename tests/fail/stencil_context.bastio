// expect-error: E-TYPE
// stage1-only: stencil (machine code from plans)
// expect-text: one context type
// Every stencil gets the context `code_call` lends, so all must take the
// same type.
struct Vm { acc: u64 }
struct Other { acc: u64 }

fn op_a(vm: &mut Vm, a: u64, b: u64, c: u64, d: u64) -> u64 { return 0; }
fn op_b(o: &mut Other, a: u64, b: u64, c: u64, d: u64) -> u64 { return 0; }

fn main(host: &mut Host) -> u64 {
  let a = stencil(op_a);
  let b = stencil(op_b);
  return wrap_add(a, b);
}
