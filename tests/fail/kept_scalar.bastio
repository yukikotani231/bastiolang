// expect-error: E-VERIFY-ASSERT
// A field the callee assigns is not kept, though the rest of the struct is.
struct Ring { buf: Buf, head: u64 }

fn bump(r: &mut Ring) requires r.head < 100 {
  r.head = r.head + 1;
}

fn main() -> u64 {
  let mut r = Ring { buf: alloc(8), head: 0 };
  bump(&mut r);
  assert r.head == 0;
  free(r.buf);
  return 0;
}
