// expect-error: E-VERIFY-BOUNDS
// The page has the bytes, but the destination buffer is too short for them.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 1 {
    return 0;
  }
  let mut d = dma_lend(pool_take(&mut pool, 0));
  let mut b = balloc(8);
  dma_to_bytes(&mut b, 1, &mut d, 0, 8);
  pool_give(&mut pool, dma_take(d));
  bfree(b);
  return 0;
}
