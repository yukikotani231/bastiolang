// expect-error: E-LINEAR-USE
// stage1-only: thread_spawn
// The buffer moves to the new thread: using it here while that thread may
// write it would be a data race, and is a use after move.
fn fill(b: Buf) -> Buf
  requires len(b) == 4
{
  return set(b, 0, 7);
}

fn main() -> u64 {
  let b = alloc(4);
  let t = thread_spawn(fill, b);
  let x = get(b, 0);
  free(thread_join(t));
  return x;
}
