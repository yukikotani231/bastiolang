// expect-error: E-VERIFY-OWN
// Mapping a page over a slot that already maps one would lose that page.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) > 2 {
    let mut t = pt_new(pool_take(&mut pool, 0), 1);
    pt_put_frame(&mut t, 5, pool_take(&mut pool, 1), true);
    pt_put_frame(&mut t, 5, pool_take(&mut pool, 2), true);
    pool_give(&mut pool, pt_take_frame(&mut t, 5));
    pool_give(&mut pool, pt_free(t));
  }
  return 0;
}
