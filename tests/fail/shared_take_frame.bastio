// expect-error: E-VERIFY-SHARED
// A slot that maps a shared page holds one reference, not the page: taking
// it out as a Frame would let its owner free a page other tables still map.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 2 {
    return 0;
  }
  let mut t = pt_new(pool_take(&mut pool, 0), 1);
  pt_put_shared(&mut t, 1, shared_new(pool_take(&mut pool, 1)), true);
  pool_give(&mut pool, pt_take_frame(&mut t, 1));
  pool_give(&mut pool, pt_free(t));
  return 0;
}
