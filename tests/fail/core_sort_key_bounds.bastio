// expect-error: E-VERIFY-REQUIRES
// sort_by_key_u64 sorts indices into the key vector: an index past its end
// is rejected at the call, so the sort never reads outside `keys`.
import "core/sort.bastio";

fn main() -> u64 {
  let mut keys = vec_new[u64]();
  vec_push(&mut keys, 5);
  let mut idx = vec_new[u64]();
  vec_push(&mut idx, 0);
  vec_push(&mut idx, 1);
  sort_by_key_u64(&mut idx, keys);
  vec_free(idx);
  vec_free(keys);
  return 0;
}
