// expect-error: E-VERIFY-ASSERT
// stage1-only: code_call (machine code from plans)
// The machine code may call any stencil, and each may change the context:
// nothing proved about it before the call holds after.
struct Vm { acc: u64 }

fn op_set(vm: &mut Vm, a: u64, b: u64, c: u64, d: u64) -> u64 {
  vm.acc = a;
  return 0;
}

fn main(host: &mut Host) -> u64 {
  let mut vm = Vm { acc: 5 };
  let s = stencil(op_set);
  let mut plan = vec_new[u64]();
  vec_push(&mut plan, 7);
  vec_push(&mut plan, 2);
  let code = code_build(host, plan);
  vec_free(plan);
  let r = code_call(code, &mut vm, 0);
  code_free(host, code);
  assert vm.acc == 5;
  return wrap_add(r, s);
}
