// expect-error: E-VERIFY-LOCKINV
// A locked section must leave the invariant holding for the next processor
// that takes the lock: here the index can step past the end of the buffer.
struct Ring { buf: Buf, at: u64 } invariant at < len(buf);
fn step(r: &mut Ring) requires r.at < len(r.buf) { r.at = r.at + 1; }
fn main() -> u64 {
  let l = lock_new(Ring { buf: alloc(4), at: 0 });
  locked(l, step);
  let r = lock_end(l);
  free(r.buf);
  return 0;
}
