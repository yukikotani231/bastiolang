// expect-error: E-VERIFY-BOUNDS
// dirty_fill copies a whole page from the source: 4096 bytes from `at`
// must be there.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 1 {
    return 0;
  }
  let b = balloc(8192);
  let f = dirty_fill(pool_take_dirty(&mut pool, 0), b, 4097);
  pool_give(&mut pool, f);
  bfree(b);
  return 0;
}
