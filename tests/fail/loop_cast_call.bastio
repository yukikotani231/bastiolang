// expect-error: E-VERIFY-ASSERT
// A loop forgets what its body may change, including through a call
// inside `cast[T](..)`. (Once, the argument of a builtin with type
// arguments was not looked at, so `c.x` kept its value from before the
// loop and the false assert below was proved.)
struct Counter { x: u64 }

fn bump(c: &mut Counter) -> u64
  requires c.x < 100
{
  c.x = c.x + 1;
  return 0;
}

fn main() -> u64 {
  let mut c = Counter { x: 0 };
  let mut i = 0;
  while i < 3
    invariant i <= 3
  {
    if c.x < 100 {
      let y = cast[u64](bump(&mut c));
    }
    i = i + 1;
  }
  assert c.x == 0;
  return c.x;
}
