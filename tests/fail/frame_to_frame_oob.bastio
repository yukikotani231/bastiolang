// expect-error: E-VERIFY-BOUNDS
// stage1-only: frame_to_frame
// The source range fits in its page, but the destination range runs one byte past the end of its page.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 2 {
    return 0;
  }
  let mut a = pool_take(&mut pool, 0);
  let mut b = pool_take(&mut pool, 1);
  frame_to_frame(&mut b, 4090, a, 0, 7);
  pool_give(&mut pool, a);
  pool_give(&mut pool, b);
  return 0;
}
