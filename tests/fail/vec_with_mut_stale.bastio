// stage1-only: vec_with_mut
// expect-error: E-VERIFY-ENSURES
// After vec_with_mut the element is what `f` left, not what it was before.
struct P { a: u64 }

fn set_a(p: &mut P, x: u64)
  ensures p.a == x
{
  p.a = x;
}

fn read_a(p: &P) -> u64
  ensures result == p.a
{
  return p.a;
}

fn run(v: &mut Vec[P]) -> u64
  requires vlen(v) > 0 && vget(v, 0).a == 1
  ensures result == 1
{
  vec_with_mut(&mut v, 0, set_a, 2);
  return vec_with(v, 0, read_a);
}

fn main() -> u64 {
  let mut v = vec_new[P]();
  vec_push(&mut v, P { a: 1 });
  let r = run(&mut v);
  vec_free(v);
  return r;
}
