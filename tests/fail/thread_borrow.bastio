// expect-error: E-TYPE
// stage1-only: thread_spawn
// A thread may outlive the caller's variables, so its function takes no
// borrows: two threads could otherwise both write `b`.
fn fill(b: &mut Buf) {}

fn main() -> u64 {
  let mut b = alloc(4);
  let t = thread_spawn(fill, &mut b);
  thread_join(t);
  free(b);
  return 0;
}
