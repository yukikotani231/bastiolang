// expect-error: E-TYPE
// stage1-only: stencil (machine code from plans)
// expect-text: it must take `&mut T` for a struct `T`, then four `u64`
// A stencil is called with the context and four numbers, nothing else.
struct Vm { acc: u64 }

fn op_inc(vm: &mut Vm, a: u64) -> u64 {
  vm.acc = wrap_add(vm.acc, a);
  return 0;
}

fn main(host: &mut Host) -> u64 {
  return stencil(op_inc);
}
