// expect-error: E-VERIFY-REQUIRES
// slots_set replaces a value; it may not be used on a free slot (that is
// what slots_alloc is for, so the slot cannot be handed out twice).
import "core/slots.bastio";

fn main() -> u64 {
  let mut s = slots_new[u64]();
  let i = slots_alloc[u64](&mut s, 0, 8, 1);
  slots_set[u64](&mut s, 5, 2);
  slots_free[u64](s);
  return i;
}
