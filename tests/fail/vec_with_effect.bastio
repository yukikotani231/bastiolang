// stage1-only: vec_with
// expect-error: E-LINEAR-USE
// The element is lent after the arguments are evaluated, so an argument that
// calls a function (which could change the vector) is refused.
struct Named { name: Bytes, size: u64 }

fn size_of(n: &Named, k: u64) -> u64 {
  return n.size + k;
}

fn bump(v: &mut Vec[Named]) -> u64 {
  let x = vec_pop(&mut v);
  bfree(x.name);
  return 1;
}

fn main() -> u64 {
  let mut v = vec_new[Named]();
  vec_push(&mut v, Named { name: balloc(1), size: 1 });
  let s = vec_with(v, 0, size_of, bump(&mut v));
  vec_free(v);
  return s;
}
