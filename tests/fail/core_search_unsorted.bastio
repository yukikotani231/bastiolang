// expect-error: E-VERIFY-REQUIRES
// Binary search needs a sorted vector, and that is proved, not assumed:
// sort_u64 would establish it.
import "core/sort.bastio";

fn main() -> u64 {
  let mut v = vec_new[u64]();
  vec_push(&mut v, 3);
  vec_push(&mut v, 1);
  let i = lower_bound_u64(v, 2);
  vec_free(v);
  return i;
}
