// expect-error: E-VERIFY-ASSERT
// The same through a box: a lock holding a `Box[i64]` hands back a box
// whose contents can be negative.
fn neg(r: &mut Box[i64]) {
  let x = unbox(r);
  let m: i64 = -1;
  r = box(m);
}

fn main() -> u64 {
  let z: i64 = 0;
  let l = lock_new(box(z));
  locked(l, neg);
  let b = lock_end(l);
  let v = unbox(b);
  assert v >= 0;
  return 0;
}
