// expect-error: E-VERIFY-PT
// The access is 0 (none), 1 (read) or 2 (read and write); nothing else.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 2 {
    return 0;
  }
  let mut t = pt_new(pool_take(&mut pool, 0), 1);
  pt_put_frame(&mut t, 1, pool_take(&mut pool, 1), true);
  pt_set_access(&mut t, 1, 3);
  pool_give(&mut pool, pt_take_frame(&mut t, 1));
  pool_give(&mut pool, pt_free(t));
  return 0;
}
