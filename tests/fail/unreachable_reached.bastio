// expect-error: E-VERIFY-UNREACHABLE
// Without knowing the slot is empty, the `Full` arm can run, and dropping
// its buffer there would leak it.
enum Slot { Empty, Full(Buf) }

fn fill(v: &mut Vec[Slot], i: u64, b: Buf)
  requires i < vlen(v)
{
  match vec_swap(&mut v, i, Slot::Full(b)) {
    Slot::Empty => {},
    Slot::Full(_old) => { unreachable; },
  }
}

fn main() -> u64 {
  let mut v = vec_new[Slot]();
  vec_push(&mut v, Slot::Empty);
  fill(&mut v, 0, alloc(8));
  match vec_pop(&mut v) {
    Slot::Empty => {},
    Slot::Full(b) => { free(b); },
  }
  vec_free(v);
  return 0;
}
