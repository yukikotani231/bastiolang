// expect-error: E-LINEAR-USE
// The contents of a lock are reachable only inside `locked`: lending the
// struct that holds the lock as `&mut` in the same call would let `g` reach
// the lock (and its contents) a second way.
struct C { n: u64 }
struct S { l: Lock[C], m: u64 }
fn g(c: &mut C, s: &mut S) { s.m = 1; }
fn main() -> u64 {
  let mut s = S { l: lock_new(C { n: 0 }), m: 0 };
  locked(s.l, g, &mut s);
  let c = lock_end(s.l);
  return s.m;
}
