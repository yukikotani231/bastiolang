// expect-error: E-VERIFY-BOUNDS
// A recursive function that replaces the buffer in one branch does not keep
// its length, though the other branch only recurses.
fn shrink(b: &mut Buf, n: u64) {
  if n == 0 {
    free(b);
    b = alloc(1);
  } else {
    shrink(&mut b, n - 1);
  }
}

fn main() -> u64 {
  let mut b = alloc(8);
  shrink(&mut b, 3);
  let x = get(b, 7);
  free(b);
  return x;
}
