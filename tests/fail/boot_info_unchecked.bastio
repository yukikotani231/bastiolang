// expect-error: E-VERIFY-CAST
// target: kernel
// `boot_info` promises nothing about its answer: even a query the platform
// documents as a byte must be checked before it is used as one.
fn main(cpu: &mut Cpu) -> u64 {
  let ok = boot_info(cpu, 0, 0);
  if ok < 256 {
    let a = cast[u8](ok);
  }
  let b = cast[u8](boot_info(cpu, 0, 1));
  return 0;
}
