// expect-error: E-VERIFY-PT
// Only a last-level table maps pages, so only its slots have a writable
// bit worth asking about.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) == 0 {
    return 0;
  }
  let t = pt_new(pool_take(&mut pool, 0), 2);
  let mut r = 0;
  if pt_writable(t, 0) {
    r = 1;
  }
  pool_give(&mut pool, pt_free(t));
  return r;
}
