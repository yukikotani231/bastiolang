// expect-error: E-VERIFY-REQUIRES
// target: kernel
// The other processors start `f` with the kernel's own tables in CR3, so a
// precondition about this processor's address space does not carry over.
// (`tally` is fine: what it needs holds on every processor.)
struct Count { n: u64 } invariant n < 1000000;
fn add(c: &mut Count) requires c.n < 1000000 ensures c.n < 1000000 { if c.n < 999999 { c.n = c.n + 1; } }
fn tally(cpu: &mut Cpu, l: &Lock[Count]) { locked(l, add); }
fn on_user(cpu: &mut Cpu, mmu: &mut Mmu, l: &Lock[Count]) requires mmu_root(mmu) != 262144 { locked(l, add); }
fn main(cpu: &mut Cpu, mmu: &mut Mmu) -> u64 {
  let l = lock_new(Count { n: 0 });
  smp_run(tally, &mut cpu, l);
  smp_run(on_user, &mut cpu, &mut mmu, l);
  let c = lock_end(l);
  return c.n;
}
