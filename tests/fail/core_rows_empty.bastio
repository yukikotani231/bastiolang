// expect-error: E-VERIFY-REQUIRES
// A template row must have at least one word: a zero-word row would make
// every "new row" the same place.
import "core/rows.bastio";

fn main() -> u64 {
  let mut t = alloc(8);
  let row = alloc(0);
  let ok = rows_grow(&mut t, row, 3);
  free(row);
  free(t);
  if ok { return 0; }
  return 1;
}
