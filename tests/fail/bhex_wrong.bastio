// expect-error: E-VERIFY-ASSERT
// "a0" is 160, not 100: `a` is ten, not a decimal digit.
fn main() -> u64 {
  let mut b = balloc(2);
  bset(&mut b, 0, 97);
  bset(&mut b, 1, 48);
  assert bhex(b, 0, 1) == 10;         // proved
  assert bhex(b, 0, 2) == 100;        // 160
  bfree(b);
  return 0;
}
