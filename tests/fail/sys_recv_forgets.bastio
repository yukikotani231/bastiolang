// expect-error: E-VERIFY-ASSERT
// target: user
// After sys_recv the kernel may have overwritten every byte: nothing written
// before the call is still known.
fn main() -> u64 {
  let mut b = balloc(4);
  bset(&mut b, 0, 7);
  let r = sys_recv(13, 3, &mut b);
  assert bget(b, 0) == 7;
  bfree(b);
  return r;
}
