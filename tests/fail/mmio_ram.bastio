// expect-error: E-VERIFY-BOUNDS
// target: kernel
// Ordinary memory is not a device: claims must lie in the device window,
// so a driver can never reach pages the allocator owns.
fn main(win: &mut MmioSpace) -> u64 {
  let r = mmio_claim(&mut win, 0x100000, 4096);
  mmio_release(&mut win, r);
  return 0;
}
