// expect-error: E-VERIFY-LOCKINV
// Without the bound check, a full count could be stored as 1025 and every
// processor reading it would assume n <= 1024.
struct Pending { n: u64 } invariant n <= 1024;

fn reserve(a: &Atomic[Pending]) -> bool {
  let x = atomic_load(a);
  return atomic_cas(a, x, Pending { n: x.n + 1 });
}

fn main() -> u64 {
  let p = atomic_new(Pending { n: 0 });
  let ok = reserve(p);
  let v = atomic_end(p);
  return 0;
}
