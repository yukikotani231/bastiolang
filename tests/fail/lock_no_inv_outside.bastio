// expect-error: E-VERIFY-BOUNDS
// Without an invariant, nothing is known about a lock's contents when it is
// taken: another processor may have changed them since.
struct Ring { buf: Buf, at: u64 }
fn peek(r: &mut Ring) -> u64 { return get(r.buf, r.at); }
fn main() -> u64 {
  let l = lock_new(Ring { buf: alloc(4), at: 0 });
  let x = locked(l, peek);
  let r = lock_end(l);
  free(r.buf);
  return x;
}
