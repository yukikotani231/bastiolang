// expect-error: E-TYPE
// `old(..)` in a loop invariant means the value at the call, which only
// parameters have: a local has none.
fn count(n: u64) -> u64 {
  let mut i = 0;
  while i < n
    invariant i <= n && i >= old(i)
  {
    i = i + 1;
  }
  return i;
}

fn main() -> u64 {
  return count(3);
}
