// expect-error: E-VERIFY-BOUNDS
// Devices read descriptor fields whole; an unaligned store could be torn.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 8 {
    return 0;
  }
  let mut d = dma_lend(pool_take(&mut pool, 0));
  dma_write64(&mut d, 12, 7);
  pool_give(&mut pool, dma_take(d));
  return 0;
}
