// expect-error: E-TYPE
// A local may share a function's name, but where a function is passed by
// name (`locked`, `smp_run`) such a local would make the name ambiguous,
// so it is rejected.
struct Count { n: u64 } invariant n < 1000;

fn bump(c: &mut Count) requires c.n < 1000 ensures c.n < 1000 {
  if c.n < 999 { c.n = c.n + 1; }
}

fn main() -> u64 {
  let bump = 1;
  let l = lock_new(Count { n: 0 });
  locked(l, bump);
  let c = lock_end(l);
  return c.n + bump;
}
