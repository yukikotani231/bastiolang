// expect-error: E-VERIFY-ENSURES
// Equal in one field is not equal.
struct Point { x: u64, y: u64 }

fn shifted(p: Point) -> Point
  requires p.x == 1 && p.y == 2
  ensures result == p
{
  return Point { x: p.x, y: p.y + 1 };
}

fn main() -> u64 {
  let q = shifted(Point { x: 1, y: 2 });
  return q.x;
}
