// expect-error: E-VERIFY-REQUIRES
// A packed map's entries are numbered below its size: entry 64 of a map of
// 64 entries is rejected at the call, though its word could hold it.
import "core/bitmap.bastio";

fn main() -> u64 {
  let mut b = bits_new(64);
  bits_set(&mut b, 64);
  bits_free(b);
  return 0;
}
