// expect-error: E-TYPE
// The element is lent as `&T`, not `&mut T`: the function cannot change it.
struct Named { name: Bytes, size: u64 }

fn grow(n: &mut Named) -> u64 {
  n.size = n.size + 1;
  return n.size;
}

fn main() -> u64 {
  let mut v = vec_new[Named]();
  vec_push(&mut v, Named { name: balloc(1), size: 1 });
  let s = vec_with(v, 0, grow);
  let n = vec_pop(&mut v);
  bfree(n.name);
  vec_free(v);
  return s;
}
