// expect-error: E-TYPE
// A dirty page may hold another owner's data: it cannot be mapped (or read,
// or given back) as a Frame before it is overwritten whole.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 2 {
    return 0;
  }
  let mut t = pt_new(pool_take(&mut pool, 0), 1);
  pt_put_frame(&mut t, 1, pool_take_dirty(&mut pool, 1), true);
  pool_give(&mut pool, pt_take_frame(&mut t, 1));
  pool_give(&mut pool, pt_free(t));
  return 0;
}
