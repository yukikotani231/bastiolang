// expect-error: E-VERIFY-OVERFLOW
// `3 * w` overflows u16 for a w that comes from wrapping an i16 to i64 and
// then to u16. Z3 4.8.12 once ran forever on this query, past its resource
// limit, because of how a signed wrap was written for it; the fuzzer found
// it (`tests/fuzz.py --seed 1`).
fn f(p0: i16) -> u8 {
  let v2: i64 = wrap[i64](p0);
  let v3: u8 = wrap[u8](1 % (3 * wrap[u16](v2)));
  return v3;
}

fn main() -> u64 {
  let a: i16 = 1;
  return cast[u64](f(a));
}
