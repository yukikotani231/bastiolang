// expect-error: E-TYPE
// target: kernel
// The verifier assumes `main` starts with the whole page pool. If another
// function could call `main`, the nested run would take pages the outer
// run still owns, and two owners would hold the same page.
fn again(pool: &mut Pool, mmu: &mut Mmu) {
  main(&mut pool, &mut mmu);
}

fn main(pool: &mut Pool, mmu: &mut Mmu) {
  if pool_size(pool) > 0 {
    let f = pool_take(&mut pool, 0);
    again(&mut pool, &mut mmu);
    pool_give(&mut pool, f);
  }
}
