// expect-error: E-VERIFY-OWN
// Capability ghost state lives on inside structs: a slot taken from a
// table held in a field is empty, so taking it again is rejected.
struct Space { root: PageTable, pages: u64 }
fn twice(s: &mut Space, pool: &mut Pool) -> Frame
  requires pt_level(s.root) == 1 && pt_used(s.root, 3) && !pt_shared(s.root, 3)
{
  pool_give(&mut pool, pt_take_frame(&mut s.root, 3));
  return pt_take_frame(&mut s.root, 3);
}
fn main() -> u64 { return 0; }
