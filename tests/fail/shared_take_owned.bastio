// expect-error: E-VERIFY-SHARED
// A page the table owns outright is no reference: taking it out as a
// Shared would let its count drop below the mappings of it.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 2 {
    return 0;
  }
  let mut t = pt_new(pool_take(&mut pool, 0), 1);
  pt_put_frame(&mut t, 1, pool_take(&mut pool, 1), true);
  let d = shared_drop(&mut pool, pt_take_shared(&mut t, 1));
  pool_give(&mut pool, pt_free(t));
  return d;
}
