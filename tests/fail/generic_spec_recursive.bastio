// expect-error: E-TYPE
// A spec fn may only call the spec fns before it, so expansion ends. An
// instance of a generic spec fn calling itself is still recursion.
spec fn same_len[T](x: &Vec[T], y: &Vec[T]) -> bool { vlen(x) == vlen(y) }
spec fn r[T](x: &Vec[T]) -> bool { r[T](x) }
fn main() -> u64 { let x = vec_new[u64](); assert r[u64](x); vec_free(x); return 0; }
