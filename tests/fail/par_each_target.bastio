// expect-error: E-TARGET
// target: kernel
// stage1-only: par_each
// There are no POSIX threads in the kernel: it runs code on other
// processors with `smp_run`.
struct Job { n: u64 }

fn step(j: &mut Job) {
  j.n = 1;
}

fn main() -> u64 {
  let mut jobs = vec_new[Job]();
  vec_push(&mut jobs, Job { n: 1 });
  par_each(&mut jobs, step);
  vec_free(jobs);
  return 0;
}
