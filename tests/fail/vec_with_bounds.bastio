// stage1-only: vec_with
// expect-error: E-VERIFY-BOUNDS
// `vec_with` needs the index to be in bounds, as `vec_get` does.
struct Named { name: Bytes, size: u64 }

fn size_of(n: &Named) -> u64 {
  return n.size;
}

fn main() -> u64 {
  let mut v = vec_new[Named]();
  vec_push(&mut v, Named { name: balloc(1), size: 1 });
  let s = vec_with(v, 1, size_of);
  let n = vec_pop(&mut v);
  bfree(n.name);
  vec_free(v);
  return s;
}
