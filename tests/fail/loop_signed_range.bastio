// expect-error: E-VERIFY-ASSERT
// A loop that changes a signed variable forgets its value but keeps its
// type's range, which includes negative numbers. (Once, it was given the
// range of u64 instead: with this invariant that left only x == 0, and the
// false assert below was proved.)
fn main() -> u64 {
  let mut x: i64 = 0;
  let mut i: i64 = 0;
  while i < 3
    invariant i >= 0 && i <= 3 && x + i == 0
  {
    x = x - 1;
    i = i + 1;
  }
  assert x == 0;
  return 0;
}
