// expect-error: E-VERIFY-REQUIRES
// core's preconditions are proved at each call: a slice past the end of
// the bytes is rejected.
import "../../core/bytes.bastio";

fn main() -> u64 {
  let b = bfrom("hello");
  let s = bytes_slice(b, 2, 9);
  let n = blen(s);
  bfree(s);
  bfree(b);
  return n;
}
