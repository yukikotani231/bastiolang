// expect-error: E-VERIFY-REQUIRES
// Rounding an address from outside up to a page needs a bound first: near
// the top of the address space the result would not fit a u64.
import "core/num.bastio";

fn round(addr: u64) -> u64 {
  return align_up_u64(addr, 4096);
}

fn main() -> u64 {
  return round(5) % 2;
}
