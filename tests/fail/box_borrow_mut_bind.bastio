// expect-error: E-TYPE
// A payload bound out of a shared borrow is itself a shared borrow: it cannot be `mut`.
enum T { Some(Box[u64]), None }
fn f(t: &T) -> u64 {
  match t {
    T::Some(mut b) => { return 1; },
    T::None => { return 0; },
  }
}
fn main() -> u64 {
  let t = T::None;
  let r = f(t);
  match t { T::Some(b) => { let v = unbox(b); }, T::None => {}, }
  return r;
}
