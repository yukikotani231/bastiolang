// expect-error: E-VERIFY-REQUIRES
// Sorting spans main are not known to lie inside the text is rejected.
import "core/strsort.bastio";

fn main() -> u64 {
  let b = bfrom("ab");
  let mut spans = vec_new[Span]();
  vec_push(&mut spans, Span { start: 0, end: 40 });
  let order = spans_order(b, spans);
  vec_free(order);
  vec_free(spans);
  bfree(b);
  return 0;
}
