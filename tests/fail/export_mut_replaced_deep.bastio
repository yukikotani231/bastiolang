// expect-error: E-EXPORT
// The same, two calls down: the summary of what each function may do to its
// `&mut` arguments carries the replacement up to the exported function.
fn regrow(b: &mut Bytes) {
  let n = blen(b);
  bfree(b);
  b = balloc(n);
}

fn fill(b: &mut Bytes) {
  if blen(b) > 0 {
    bset(&mut b, 0, 1);
  }
  regrow(&mut b);
}

export fn write_one(out: &mut Bytes) {
  fill(&mut out);
}
