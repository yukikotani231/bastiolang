// stage1-only: vec_with
// expect-error: E-LINEAR-USE
// The vector is borrowed for the call: it cannot also be lent as `&mut` to
// the function, which could then drop the element it is looking at.
struct Named { name: Bytes, size: u64 }

fn shrink(n: &Named, v: &mut Vec[Named]) -> u64 {
  let x = vec_pop(&mut v);
  bfree(x.name);
  return n.size;
}

fn main() -> u64 {
  let mut v = vec_new[Named]();
  vec_push(&mut v, Named { name: balloc(1), size: 1 });
  let s = vec_with(v, 0, shrink, &mut v);
  vec_free(v);
  return s;
}
