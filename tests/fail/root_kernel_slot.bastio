// expect-error: E-VERIFY-PT
// target: kernel
// Slot 0 of a top-level table maps the kernel; user tables cannot go there.
fn main(pool: &mut Pool, mmu: &mut Mmu) {
  if pool_size(pool) > 1 {
    let mut root = pt_new(pool_take(&mut pool, 0), 4);
    pt_put(&mut root, 0, pt_new(pool_take(&mut pool, 1), 3));
    pool_give(&mut pool, pt_free(pt_take(&mut root, 0)));
    pool_give(&mut pool, pt_free_root(mmu, root));
  }
}
