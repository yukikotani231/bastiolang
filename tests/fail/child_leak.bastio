// expect-error: E-LINEAR-LEAK
// A child process must be waited for: dropping it would leave a zombie and
// two open pipes.
fn main(h: &mut Host) -> u64 {
  let mut argv = vec_new[Bytes]();
  vec_push(&mut argv, bfrom("true"));
  let c = host_spawn(h, argv);
  bfree(vec_pop(&mut argv));
  vec_free(argv);
  return 0;
}
