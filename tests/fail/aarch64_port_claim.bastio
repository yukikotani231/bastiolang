// expect-error: E-TARGET
// stage1-only: the AArch64 kernel target
// target: kernel
// arch: aarch64
// Nor can it use the port builtins (this program is fine on x86-64).
fn probe(ports: &mut Ports) -> u64
  requires forall k: u64 :: 1016 <= k && k < 1024 ==> port_free(ports, k)
{
  let io = port_claim(&mut ports, 1016, 8);
  port_release(&mut ports, io);
  return 0;
}

fn main(con: &mut Serial) -> u64 {
  return 0;
}
