// expect-error: E-VERIFY-OWN
// pt_set_access changes what the program may do with a page the table
// owns; an empty slot has none, and marking it would make pt_has claim a
// page that is not there.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) == 0 {
    return 0;
  }
  let mut t = pt_new(pool_take(&mut pool, 0), 1);
  pt_set_access(&mut t, 5, 0);
  pool_give(&mut pool, pt_free(t));
  return 0;
}
