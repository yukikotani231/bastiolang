// expect-error: E-VERIFY-BOUNDS
// target: kernel
// `cpu_count` is known to be between 1 (the processor running the code) and
// 4096, so a per-processor buffer of that length can be allocated and its
// last element is at `n - 1` without underflow. `n` itself is out of bounds.
fn main(cpu: &mut Cpu) -> u64 {
  let n = cpu_count(cpu);
  let b = alloc(n);
  let x = get(b, n - 1);
  let y = get(b, n);
  free(b);
  return y;
}
