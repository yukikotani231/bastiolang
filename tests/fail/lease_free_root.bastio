// expect-error: E-VERIFY-LEASE
// target: kernel
// Loading the kernel's tables does not give a lease back: the table stays
// counted (another processor may hold the lease), so it cannot be freed.
fn main(pool: &mut Pool, mmu: &mut Mmu) {
  if pool_size(pool) > 1 {
    let mut root = pt_new(pool_take(&mut pool, 0), 4);
    let l = mmu_enter(&mut mmu, &mut root);
    mmu_kernel(&mut mmu);
    pool_give(&mut pool, pt_free_root(mmu, root));
    let mut other = pt_new(pool_take(&mut pool, 1), 4);
    mmu_exit(&mut mmu, l);
    pool_give(&mut pool, pt_free_root(mmu, other));
  }
}
