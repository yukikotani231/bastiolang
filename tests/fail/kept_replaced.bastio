// expect-error: E-VERIFY-BOUNDS
// A callee that puts a different buffer back does not keep the length, even
// two calls down: `outer` only lends `r` to `swap_in`, which replaces it.
struct Ring { buf: Buf, head: u64 }

fn swap_in(r: &mut Ring) {
  free(r.buf);
  r.buf = alloc(1);
}

fn outer(r: &mut Ring) {
  swap_in(&mut r);
}

fn main() -> u64 {
  let mut r = Ring { buf: alloc(8), head: 0 };
  outer(&mut r);
  let x = get(r.buf, 7);
  free(r.buf);
  return x;
}
