// expect-error: E-VERIFY-CAST
// target: kernel
// `boot_acpi` answers a byte of the table, or 256 past its end: 256 does not
// fit a `u8`, so the program must look for it first.
fn main(cpu: &mut Cpu) -> u64 {
  let sig = 0x50434146;                 // "FACP"
  let ok = boot_acpi(cpu, sig, 0);
  if ok < 256 {
    let a = cast[u8](ok);
  }
  let b = cast[u8](boot_acpi(cpu, sig, 1));
  return 0;
}
