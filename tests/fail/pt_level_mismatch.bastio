// expect-error: E-VERIFY-PT
// A level-1 table placed directly under a level-3 table: the hardware would
// read the level-1 entries as level-2 ones.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) > 1 {
    let mut t3 = pt_new(pool_take(&mut pool, 0), 3);
    pt_put(&mut t3, 0, pt_new(pool_take(&mut pool, 1), 1));
    pool_give(&mut pool, pt_free(pt_take(&mut t3, 0)));
    pool_give(&mut pool, pt_free(t3));
  }
  return 0;
}
