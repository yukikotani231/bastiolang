// expect-error: E-VERIFY-BOUNDS
// Generic bodies are verified (once per copy): this read may be out of bounds.
struct Wrap[T] { v: T, b: Buf }
fn first[T](w: &Wrap[T]) -> u64 {
  return get(w.b, 0);
}
fn main() -> u64 {
  let w = Wrap[u64] { v: 1, b: alloc(0) };
  let r = first[u64](w);
  free(w.b);
  return r;
}
