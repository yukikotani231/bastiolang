// expect-error: E-TYPE
// stage1-only: stencil (machine code from plans)
// expect-text: it has a `requires`
// Machine code passes a stencil whatever numbers its plan holds, so a
// stencil cannot rely on a precondition.
struct Vm { regs: Vec[u64] }

fn op_get(vm: &mut Vm, a: u64, b: u64, c: u64, d: u64) -> u64
  requires a < vlen(vm.regs)
{
  return vec_get(vm.regs, a);
}

fn main(host: &mut Host) -> u64 {
  return stencil(op_get);
}
