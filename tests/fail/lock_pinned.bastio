// expect-error: E-PIN
// target: kernel
// A processor's `Mmu` describes that processor's CR3; another processor that
// took the lock would switch the wrong address space.
struct Space { mmu: Mmu }
fn share(s: Space) -> Lock[Space] { return lock_new(s); }
fn main(cpu: &mut Cpu) -> u64 { return 0; }
