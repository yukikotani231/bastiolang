// expect-error: E-LINEAR-LEAK
// target: kernel
// A page holding a user's FPU state is owned like any other: saving into it
// does not consume it, so it must still go back to the pool.
fn main(pool: &mut Pool, cpu: &mut Cpu) {
  if pool_size(pool) > 0 {
    let mut f = pool_take(&mut pool, 0);
    cpu_fpu_save(&mut cpu, &mut f);
    cpu_fpu_load(&mut cpu, f);
  }
}
