// expect-error: E-VERIFY-BOUNDS
// After a loop that pushes, the length is whatever the invariant says: here nothing.
fn main() -> u64 {
  let mut v = vec_new[u64]();
  let mut i = 0;
  while i < 3
    invariant i <= 3
  {
    vec_push(&mut v, i);
    i = i + 1;
  }
  let x = vec_get(v, 0);
  vec_free(v);
  return x;
}
