// expect-error: E-VERIFY-BOUNDS
// A `&mut` loan on the right of `&&` changes the value whenever that side
// runs; the prover must not keep using the old length afterwards.
fn shrink(b: &mut Buf) -> bool
  ensures len(b) == 1
{
  free(b);
  b = alloc(1);
  return true;
}
fn main() -> u64 {
  let mut b = alloc(10);
  let t = len(b) == 10;
  let ok = t && shrink(&mut b);
  let v = get(b, 5);
  free(b);
  return v;
}
