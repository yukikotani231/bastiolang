// expect-error: E-VERIFY-REQUIRES
// target: kernel
// A table `pt_borrow` lends is as live as the tree it is in: it has the
// tree's leases. Here the tree is leased, so the borrowed level-3 table
// cannot unlink its child, even for a moment (`relink` needs it not live,
// as `pt_take` does).
fn relink(t: &mut PageTable)
  requires pt_level(t) == 3 && pt_leases(t) == 0
{
  if pt_has(t, 0) {
    let c = pt_take(&mut t, 0);
    pt_put(&mut t, 0, c);
  }
}

fn main(pool: &mut Pool, mmu: &mut Mmu) {
  if pool_size(pool) > 2 {
    let mut root = pt_new(pool_take(&mut pool, 0), 4);
    let mut l3 = pt_new(pool_take(&mut pool, 1), 3);
    pt_put(&mut l3, 0, pt_new(pool_take(&mut pool, 2), 2));
    pt_put(&mut root, 1, l3);
    let l = mmu_enter(&mut mmu, &mut root);
    pt_borrow(&mut root, 1, relink);
    let ok = mmu_exit(&mut mmu, &mut root, l);
    let back = pt_take(&mut root, 1);
    pool_give(&mut pool, pt_free(back));
    pool_give(&mut pool, pt_free_root(mmu, root));
  }
}
