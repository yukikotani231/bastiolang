// expect-error: E-VERIFY-BOUNDS
// A `&mut` loan inside a struct literal in a loop body must be seen by the
// loop havoc: `shrink` may replace `b` with a shorter buffer. (Accepted before
// 2026-10-10, which let this read past the end of `b`.)
struct P { a: u64, b: u64 }
fn shrink(x: &mut Buf) -> u64 { let o = x; free(o); x = alloc(1); return 1; }
fn main() -> u64 {
  let mut b = alloc(8);
  let mut i = 0;
  while i < 2 invariant i <= 2 {
    let p = P { a: shrink(&mut b), b: 0 };
    i = i + 1;
  }
  let r = get(b, 5);
  free(b);
  return r;
}
