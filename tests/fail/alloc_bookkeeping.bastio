// expect-error: E-VERIFY-ENSURES
// An allocator that forgets to mark the page as used: its bitmap no longer
// matches the pool, and the proof of its postcondition fails.
spec fn tracks(bm: &Buf, pool: &Pool) -> bool {
  len(bm) == pool_size(pool)
  && (forall i: u64 :: i < len(bm) ==> ((get(bm, i) == 1) == pool_has(pool, i)))
  && (forall i: u64 :: pool_has(pool, i) ==> i < pool_size(pool))
}

fn take_page(bm: &mut Buf, pool: &mut Pool, i: u64) -> Frame
  requires tracks(bm, pool) && i < len(bm) && get(bm, i) == 1
  ensures tracks(bm, pool)
{
  return pool_take(&mut pool, i);
}

fn main() -> u64 { return 0; }
