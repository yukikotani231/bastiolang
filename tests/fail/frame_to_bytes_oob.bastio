// expect-error: E-VERIFY-BOUNDS
// Reading 4096 bytes from offset 1 would read the first byte of the next page.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 1 {
    return 0;
  }
  let f = pool_take(&mut pool, 0);
  let mut b = balloc(4096);
  frame_to_bytes(&mut b, 0, f, 1, 4096);
  pool_give(&mut pool, f);
  bfree(b);
  return 0;
}
