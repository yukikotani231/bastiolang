// expect-error: E-PIN
// target: kernel
// `smp_run` runs `f` on every processor at once: a `&mut` buffer would be
// written by all of them.
fn fill(cpu: &mut Cpu, b: &mut Buf) { b = set(b, 0, 1); }
fn main(cpu: &mut Cpu) -> u64 {
  let mut b = alloc(1);
  smp_run(fill, &mut cpu, &mut b);
  free(b);
  return 0;
}
