// expect-error: E-VERIFY-BOUNDS
// After room for two, a third `vec_push_within` would write past the
// storage: only `vec_push` may grow it.
fn main() -> u64 {
  let mut v = vec_new[u64]();
  if vec_try_reserve(&mut v, 2) {
    vec_push_within(&mut v, 1);
    vec_push_within(&mut v, 2);
    vec_push_within(&mut v, 3);
  }
  let n = vec_len(v);
  while vec_len(v) > 0
    invariant true
  {
    let x = vec_pop(&mut v);
  }
  vec_free(v);
  return n;
}
