// expect-error: E-LINEAR-USE
// What `pt_borrow` lends is only borrowed: it stays linked in the tree, so
// the callback cannot free it (or move it into another table).
fn steal(t: &mut PageTable, pool: &mut Pool) {
  pool_give(&mut pool, pt_free(t));
}

fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 2 {
    return 1;
  }
  let mut l2 = pt_new(pool_take(&mut pool, 0), 2);
  pt_put(&mut l2, 0, pt_new(pool_take(&mut pool, 1), 1));
  pt_borrow(&mut l2, 0, steal, &mut pool);
  pool_give(&mut pool, pt_free(pt_take(&mut l2, 0)));
  pool_give(&mut pool, pt_free(l2));
  return 0;
}
