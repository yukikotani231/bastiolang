// expect-error: E-LINEAR-USE
// Matching an owned linear enum moves it.
enum Slot { Full(Buf), Vacant }
fn main() -> u64 {
  let s = Slot::Full(alloc(4));
  match s {
    Slot::Full(b) => { free(b); },
    Slot::Vacant => {},
  }
  match s {
    Slot::Full(b) => { free(b); },
    Slot::Vacant => {},
  }
  return 0;
}
