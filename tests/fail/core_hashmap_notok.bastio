// expect-error: E-VERIFY-REQUIRES
// Every map function needs `hmap_ok`: a map built by hand with no slots
// would make the probe divide by zero, and is rejected at the first call.
// (A loop that changes a map without `invariant hmap_ok(m)` is rejected
// the same way.)
import "../../core/hashmap.bastio";

fn main() -> u64 {
  let mut m = HashMap { keys: vec_new[u64](), vals: vec_new[u64](), tags: vec_new[u8](), len: 0, used: 0 };
  let r = hmap_insert(&mut m, 1, 1);
  hmap_free(m);
  return 0;
}
