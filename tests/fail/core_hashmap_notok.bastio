// expect-error: E-VERIFY-REQUIRES
// Every map function needs `hmap_ok`: a map built by hand with no slots
// would make the probe divide by zero, and is rejected at the first call.
// (A loop that changes a map without `invariant hmap_ok[u64](m)` is rejected
// the same way.)
import "core/hashmap.bastio";

fn main() -> u64 {
  let mut m = HashMap[u64] { keys: vec_new[u64](), vals: vec_new[Option[u64]](), tags: vec_new[u8](), len: 0, used: 0 };
  let r = hmap_insert[u64](&mut m, 1, 1);
  hmap_free[u64](m);
  return 0;
}
