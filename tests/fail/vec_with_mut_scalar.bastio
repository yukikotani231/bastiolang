// stage1-only: vec_with_mut
// expect-error: E-TYPE
// vec_with_mut lends a struct or an enum element in place; a scalar element is
// written with vec_set.
fn bump(x: &mut u64) { x = 1; }

fn main() -> u64 {
  let mut v = vec_new[u64]();
  vec_push(&mut v, 3);
  vec_with_mut(&mut v, 0, bump);
  vec_free(v);
  return 0;
}
