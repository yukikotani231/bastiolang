// expect-error: E-VERIFY-ASSERT
// What comes out of a lock is unknown apart from its invariants, but it
// keeps its type: an i64 can be negative. (Once, `lock_new` read the type
// from the value, which does not say which integer type it has, so the
// contents were taken for a u64 and the false assert below was proved.)
fn neg(r: &mut i64) {
  r = -1;
}

fn main() -> u64 {
  let z: i64 = 0;
  let l = lock_new(z);
  locked(l, neg);
  let v = lock_end(l);
  assert v >= 0;
  return 0;
}
