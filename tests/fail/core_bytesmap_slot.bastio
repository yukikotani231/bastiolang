// expect-error: E-VERIFY-REQUIRES
// bmap_key copies a key out of a slot, which must hold one: slot 0 of a
// new map is empty, so its start and length name nothing in the arena and
// the call is rejected.
import "core/bytesmap.bastio";

fn main() -> u64 {
  let m = bmap_new[u64]();
  let k = bmap_key[u64](m, 0);
  let n = blen(k);
  bfree(k);
  bmap_free[u64](m);
  return n;
}
