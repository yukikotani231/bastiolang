// expect-error: E-LINEAR-USE
// Each copy of a generic function is checked: `dup[u64]` is fine, but
// `dup[Buf]` would use one buffer twice.
struct Pair[A, B] { a: A, b: B }
fn dup[T](x: T) -> Pair[T, T] {
  return Pair[T, T] { a: x, b: x };
}
fn main() -> u64 {
  let p = dup[u64](3);
  let q = dup[Buf](alloc(1));
  free(q.a);
  free(q.b);
  return p.a;
}
