// expect-error: E-VERIFY-ENSURES
// The verifier follows the tag: on the `None` arm the payload of `Some` means nothing.
enum Opt { Some(u64), None }
fn unwrap(o: Opt) -> u64
  ensures result == o.Some
{
  match o {
    Opt::Some(v) => { return v; },
    Opt::None => { return 0; },
  }
}
fn main() -> u64 {
  return unwrap(Opt::Some(1));
}
