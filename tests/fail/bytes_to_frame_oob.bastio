// expect-error: E-VERIFY-BOUNDS
// The page has room, but the source buffer is one byte short.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 1 {
    return 0;
  }
  let mut f = pool_take(&mut pool, 0);
  let b = balloc(10);
  bytes_to_frame(&mut f, 0, b, 0, 11);
  pool_give(&mut pool, f);
  bfree(b);
  return 0;
}
