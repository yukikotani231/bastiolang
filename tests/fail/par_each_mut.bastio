// expect-error: E-TYPE
// stage1-only: par_each
// Every call of `f` runs at once with the same arguments after the
// element, so a `&mut` there would let two threads write `total` together.
struct Job { n: u64 }

fn add(j: &mut Job, total: &mut Job) {
  total.n = j.n;
}

fn main() -> u64 {
  let mut jobs = vec_new[Job]();
  vec_push(&mut jobs, Job { n: 1 });
  vec_push(&mut jobs, Job { n: 2 });
  let mut total = Job { n: 0 };
  par_each(&mut jobs, add, &mut total);
  vec_free(jobs);
  return total.n;
}
