// expect-error: E-VERIFY-ASSERT
// Outside core/ring.bastio, `queue_at` is opaque: its contracts are known,
// its body (the slot it reads) is not.
import "core/ring.bastio";

fn main() -> u64 {
  let mut q = queue_new(4);
  queue_push(&mut q, 7);
  assert queue_at(q, 0) == 7;                    // from the contract
  assert queue_at(q, 0) == get(q.q, q.r.h);       // the body: not known here
  queue_free(q);
  return 0;
}
