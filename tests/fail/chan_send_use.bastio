// expect-error: E-LINEAR-USE
// stage1-only: Chan
// A value sent on a channel belongs to whoever receives it: reading it
// after the send would race with the receiver.
fn main() -> u64 {
  let c = chan_new(vec_new[Bytes]());
  let b = balloc(4);
  chan_send(c, b);
  let n = blen(b);
  let left = chan_drop(c);
  while vec_len(left) > 0 invariant true { bfree(vec_pop(&mut left)); }
  vec_free(left);
  return n;
}
