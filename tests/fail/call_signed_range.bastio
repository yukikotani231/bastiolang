// expect-error: E-VERIFY-ASSERT
// A call forgets what it may change through `&mut`, but a changed i64
// field is still an i64: it can be negative, so `c.x >= 0` is not known
// afterwards. (Once, it was given the range of u64 instead, and the false
// assert below was proved.)
struct Counter {
  x: i64,
}

fn down(c: &mut Counter)
  requires c.x == 0
{
  c.x = -1;
}

fn main() -> u64 {
  let mut c = Counter { x: 0 };
  down(&mut c);
  assert c.x >= 0;
  return 0;
}
