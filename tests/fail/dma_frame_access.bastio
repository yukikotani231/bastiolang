// expect-error: E-TYPE
// While lent, the page is reached only through volatile Dma accesses; plain
// Frame reads (which the C compiler may cache or reorder) are not allowed.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 8 {
    return 0;
  }
  let d = dma_lend(pool_take(&mut pool, 0));
  let v = frame_read8(d, 0);
  pool_give(&mut pool, dma_take(d));
  return v;
}
