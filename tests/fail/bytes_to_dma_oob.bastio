// expect-error: E-VERIFY-BOUNDS
// Writing past the end of a lent page would hit whatever page comes next.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 1 {
    return 0;
  }
  let mut d = dma_lend(pool_take(&mut pool, 0));
  let b = balloc(16);
  bytes_to_dma(&mut d, 4090, b, 0, 16);
  pool_give(&mut pool, dma_take(d));
  bfree(b);
  return 0;
}
