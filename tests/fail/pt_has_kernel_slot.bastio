// expect-error: E-VERIFY-UNREACHABLE
// target: kernel
// Slot 0 of a top-level table maps the kernel, so at run time `pt_has`
// says it is present even though the table owns nothing there. The proof
// must not assume it is empty.
fn main(pool: &mut Pool, mmu: &mut Mmu) {
  if pool_size(pool) > 0 {
    let root = pt_new(pool_take(&mut pool, 0), 4);
    if pt_has(root, 0) {
      unreachable;
    }
    pool_give(&mut pool, pt_free_root(mmu, root));
  }
}
