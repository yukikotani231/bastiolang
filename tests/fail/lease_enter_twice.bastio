// expect-error: E-VERIFY-MMU
// target: kernel
// A processor loads one table at a time: entering a second one without
// giving the first lease back would leave the first counted forever.
fn main(pool: &mut Pool, mmu: &mut Mmu) {
  if pool_size(pool) > 1 {
    let mut a = pt_new(pool_take(&mut pool, 0), 4);
    let mut b = pt_new(pool_take(&mut pool, 1), 4);
    let la = mmu_enter(&mut mmu, &mut a);
    let lb = mmu_enter(&mut mmu, &mut b);
    mmu_exit(&mut mmu, lb);
    mmu_exit(&mut mmu, la);
    pool_give(&mut pool, pt_free_root(mmu, a));
    pool_give(&mut pool, pt_free_root(mmu, b));
  }
}
