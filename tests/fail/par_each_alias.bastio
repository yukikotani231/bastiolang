// expect-error: E-LINEAR-USE
// stage1-only: par_each
// The vector is lent mutably for the whole call, so it cannot also be
// read through a shared borrow by the threads.
struct Job { n: u64 }

fn look(j: &mut Job, all: &Vec[Job]) {
  j.n = vec_len(all);
}

fn main() -> u64 {
  let mut jobs = vec_new[Job]();
  vec_push(&mut jobs, Job { n: 1 });
  par_each(&mut jobs, look, jobs);
  vec_free(jobs);
  return 0;
}
