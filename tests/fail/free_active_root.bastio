// expect-error: E-VERIFY-MMU
// target: kernel
// Freeing the address space the MMU is using would leave CR3 pointing at a
// page that is about to be reused.
fn main(pool: &mut Pool, mmu: &mut Mmu) {
  if pool_size(pool) > 0 {
    let mut root = pt_new(pool_take(&mut pool, 0), 4);
    let l = mmu_enter(&mut mmu, &mut root);
    pool_give(&mut pool, pt_free_root(mmu, root));
    mmu_exit(&mut mmu, l);
  }
}
