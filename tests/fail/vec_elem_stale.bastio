// expect-error: E-VERIFY-BOUNDS
// The prover knows each element's buffer length: after a short buffer is
// put at index 0, an index valid for the old buffer is out of bounds.
struct Slot { id: u64, page: Buf }

fn main() -> u64 {
  let mut v = vec_new[Slot]();
  vec_push(&mut v, Slot { id: 1, page: alloc(4096) });
  let prev = vec_swap(&mut v, 0, Slot { id: 2, page: alloc(1) });
  free(prev.page);
  let s = vec_pop(&mut v);
  let x = get(s.page, 4095);
  free(s.page);
  vec_free(v);
  return x;
}
