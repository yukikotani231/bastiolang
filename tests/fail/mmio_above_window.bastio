// expect-error: E-VERIFY-BOUNDS
// target: kernel
// The window ends at 2^46: the platform maps nothing above it, so a claim
// that crosses the end is rejected.
fn main(win: &mut MmioSpace) -> u64 {
  let r = mmio_claim(&mut win, 0x400000000000 - 4096, 8192);
  mmio_release(&mut win, r);
  return 0;
}
