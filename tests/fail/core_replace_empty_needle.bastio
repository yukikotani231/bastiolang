// expect-error: E-VERIFY-REQUIRES
// Replacing the empty string would loop forever, so the precondition
// `blen(needle) > 0` is proved at each call.
import "core/format.bastio";

fn main() -> u64 {
  let hay = bfrom("abc");
  let needle = balloc(0);
  let with = bfrom("x");
  let mut t = text_new();
  fmt_replace_all(&mut t, hay, needle, with);
  vec_free(t);
  bfree(with);
  bfree(needle);
  bfree(hay);
  return 0;
}
