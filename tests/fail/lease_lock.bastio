// expect-error: E-PIN
// target: kernel
// A lease stands for this processor running on a table; given to another
// processor (here through a lock), that one could give it back while this
// one still runs there.
fn main(pool: &mut Pool, mmu: &mut Mmu) {
  if pool_size(pool) > 0 {
    let mut root = pt_new(pool_take(&mut pool, 0), 4);
    let l = lock_new(mmu_enter(&mut mmu, &mut root));
    let ok = mmu_exit(&mut mmu, &mut root, lock_end(l));
    pool_give(&mut pool, pt_free_root(mmu, root));
  }
}
