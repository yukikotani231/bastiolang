// expect-error: E-VERIFY-OWN
// Two drivers claiming overlapping ports: both could drive the device.
fn main(ports: &mut Ports) -> u64 {
  let a = port_claim(&mut ports, 0x3F8, 8);
  let b = port_claim(&mut ports, 0x3FC, 2);
  port_release(&mut ports, a);
  port_release(&mut ports, b);
  return 0;
}
