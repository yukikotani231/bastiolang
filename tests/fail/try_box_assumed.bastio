// expect-error: E-VERIFY-ASSERT
// `try_box` may run out of memory on any call, so the prover never
// assumes that it gave back a box.
import "core/boxed.bastio";

fn main() -> u64 {
  let r = try_box[u64](5);
  assert r is Boxed::Ok;
  match r {
    Boxed::Ok(b) => { return unbox(b); },
    Boxed::Full(x) => { return x; },
  }
}
