// expect-error: E-TYPE
// stage1-only: Share
// share_with lends the shared value as `&T`: other threads read it at the
// same time, so a function that would change it cannot be given it.
struct Count { n: u64 }

fn bump(c: &mut Count) { c.n = 1; }

fn main() -> u64 {
  let s = share_new(Count { n: 0 });
  share_with(s, bump);
  let v = share_drop(s);
  vec_free(v);
  return 0;
}
