// expect-error: E-VERIFY-BOUNDS
// The destination range fits in its page, but the source range runs one byte past the end of its page.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 2 {
    return 0;
  }
  let mut a = pool_take(&mut pool, 0);
  let mut b = pool_take(&mut pool, 1);
  frame_to_frame(&mut b, 0, a, 4090, 7);
  pool_give(&mut pool, a);
  pool_give(&mut pool, b);
  return 0;
}
