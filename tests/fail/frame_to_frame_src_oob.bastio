// stage1-only: frame_to_frame
// expect-error: E-VERIFY-BOUNDS
// Reading 4096 bytes from offset 1 of the source page would read past it.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 2 {
    return 0;
  }
  let a = pool_take(&mut pool, 0);
  let mut b = pool_take(&mut pool, 1);
  frame_to_frame(&mut b, 0, a, 1, 4096);
  pool_give(&mut pool, a);
  pool_give(&mut pool, b);
  return 0;
}
