// expect-error: E-VERIFY-LOCKINV
// stage1-only: Share
// Every thread that reads a shared value relies on its invariants, so they
// are proved where it is shared.
struct Range { lo: u64, hi: u64 } invariant lo <= hi;

fn main() -> u64 {
  let s = share_new(Range { lo: 5, hi: 2 });
  let v = share_drop(s);
  vec_free(v);
  return 0;
}
