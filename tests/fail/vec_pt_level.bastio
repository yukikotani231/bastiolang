// expect-error: E-VERIFY-ENSURES
// target: kernel
// A table of processes that own page tables: the invariant "every row's root
// is a level-4 table" holds through a swap, but the swapped-out row's level
// is 4, not 3.
struct Proc { pid: u64, root: PageTable }

fn swap_in(v: &mut Vec[Proc], i: u64, p: Proc) -> Proc
  requires i < vlen(v) && pt_level(p.root) == 4
  requires forall k: u64 :: k < vlen(v) ==> pt_level(vget(v, k).root) == 4
  ensures forall k: u64 :: k < vlen(v) ==> pt_level(vget(v, k).root) == 4
  ensures pt_level(result.root) == 3
{
  return vec_swap(&mut v, i, p);
}

fn main(pool: &mut Pool, mmu: &mut Mmu) { }
