// expect-error: E-TYPE
// stage1-only: code_field members (machine code from plans)
// expect-text: `code_field` names a field
// A member of the elements must be a `bool`, an unsigned integer or a
// `Vec[u64]`: a signed integer (or a struct) would need a width and a sign
// the plan items do not have.
struct Obj { delta: i32, n: u64 }
struct Vm { objs: Vec[Obj] }

fn op_a(vm: &mut Vm, a: u64, b: u64, c: u64, d: u64) -> u64 { return 0; }

fn main(host: &mut Host) -> u64 {
  let a = stencil(op_a);
  let f = code_field(objs, delta);
  return wrap_add(a, f);
}
