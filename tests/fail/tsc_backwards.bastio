// expect-error: E-VERIFY-UNDERFLOW
// target: kernel
// The proof knows nothing about `cpu_tsc`, not even that a later read is
// not smaller: the counter is the hardware's, and on another processor it
// may lag. So the time between two reads is not provably a u64.
fn main(cpu: &mut Cpu) -> u64 {
  let a = cpu_tsc(cpu);
  let b = cpu_tsc(cpu);
  return b - a;
}
