// expect-error: E-VERIFY-LEAK
// stage1-only: Chan
// What chan_drop gives back may still hold values: nothing is known of how
// many, so they must be taken out before the vector is freed.
fn main() -> u64 {
  let c = chan_new(vec_new[Bytes]());
  chan_send(c, balloc(1));
  let left = chan_drop(c);
  vec_free(left);
  return 0;
}
