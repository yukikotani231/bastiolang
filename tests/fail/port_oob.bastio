// expect-error: E-VERIFY-BOUNDS
// A 16-bit access at the last claimed port would also touch the next port,
// which this driver does not own.
fn main(ports: &mut Ports) -> u64 {
  let mut io = port_claim(&mut ports, 0x40, 4);
  pio_out16(&mut io, 3, 0);
  port_release(&mut ports, io);
  return 0;
}
