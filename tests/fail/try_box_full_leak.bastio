// expect-error: E-LINEAR-LEAK
// When `try_box` runs out of memory, the value comes back in
// `Boxed::Full`, and it is still owned: dropping it is a leak.
import "core/boxed.bastio";

fn keep(b: Bytes) -> Box[Bytes] {
  let r = try_box[Bytes](b);
  match r {
    Boxed::Ok(x) => { return x; },
    Boxed::Full(y) => { return box(balloc(0)); },
  }
}

fn main() -> u64 {
  let x = unbox(keep(balloc(4)));
  bfree(x);
  return 0;
}
