// expect-error: E-TYPE
// stage1-only: par_each
// A linear value cannot be handed to every call: each would own it.
struct Job { n: u64 }

fn take(j: &mut Job, b: Buf) {
  free(b);
}

fn main() -> u64 {
  let mut jobs = vec_new[Job]();
  vec_push(&mut jobs, Job { n: 1 });
  par_each(&mut jobs, take, alloc(4));
  vec_free(jobs);
  return 0;
}
