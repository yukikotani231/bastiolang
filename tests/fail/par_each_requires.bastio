// expect-error: E-VERIFY-REQUIRES
// stage1-only: par_each
// `f`'s precondition must hold for every element; nothing is known of an
// element but its type's invariants.
struct Job { n: u64 }

fn step(j: &mut Job)
  requires j.n < 10
{
  j.n = j.n + 1;
}

fn main() -> u64 {
  let mut jobs = vec_new[Job]();
  vec_push(&mut jobs, Job { n: 1 });
  par_each(&mut jobs, step);
  vec_free(jobs);
  return 0;
}
