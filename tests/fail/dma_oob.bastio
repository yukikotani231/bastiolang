// expect-error: E-VERIFY-BOUNDS
// A lent page is one page: an access past its end would hit whatever page
// comes next.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 8 {
    return 0;
  }
  let mut d = dma_lend(pool_take(&mut pool, 0));
  dma_write32(&mut d, 4094, 7);
  pool_give(&mut pool, dma_take(d));
  return 0;
}
