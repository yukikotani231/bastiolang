// expect-error: E-VERIFY-OWN
// Dropping one reference of several does not give the page back: the pool
// has it only when shared_drop says it was the last.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 1 {
    return 0;
  }
  let s = shared_new(pool_take(&mut pool, 0));
  let keep = shared_dup(s);
  let d = shared_drop(&mut pool, s);
  pool_give(&mut pool, pool_take(&mut pool, 0));
  let e = shared_drop(&mut pool, keep);
  return d + e;
}
