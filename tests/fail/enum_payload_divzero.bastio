// expect-error: E-VERIFY-DIVZERO
// A payload is only what the producer promised: `Some(0)` is possible here.
enum Opt { Some(u64), None }
fn parse(x: u64) -> Opt
  ensures result is Opt::Some ==> result.Some <= x
{
  if x > 100 {
    return Opt::None;
  }
  return Opt::Some(x);
}
fn main() -> u64 {
  match parse(0) {
    Opt::Some(v) => { return 100 / v; },
    Opt::None => { return 0; },
  }
}
