// expect-error: E-VERIFY-REQUIRES
// A span the caller made up is not known to lie inside the path, so asking
// for its extension is rejected.
import "core/path.bastio";

fn main() -> u64 {
  let p = bfrom("a.c");
  let bogus = Span { start: 0, end: 50 };
  let e = path_ext(p, bogus);
  bfree(p);
  return 0;
}
