// expect-error: E-VERIFY-OWN
// Freeing a table that still maps a page would lose the page.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) > 1 {
    let mut t = pt_new(pool_take(&mut pool, 0), 1);
    pt_put_frame(&mut t, 9, pool_take(&mut pool, 1), true);
    pool_give(&mut pool, pt_free(t));
  }
  return 0;
}
