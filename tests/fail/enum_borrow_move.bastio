// expect-error: E-LINEAR-USE
// A borrowed enum is only inspected: its buffer cannot be moved out.
enum Slot { Full(Buf), Vacant }
fn steal(s: &Slot) -> u64 {
  match s {
    Slot::Full(b) => { free(b); return 1; },
    Slot::Vacant => { return 0; },
  }
}
fn main() -> u64 {
  let s = Slot::Vacant;
  let r = steal(s);
  match s {
    Slot::Full(b) => { free(b); },
    Slot::Vacant => {},
  }
  return r;
}
