// expect-error: E-VERIFY-ENSURES
// Setting bit k changes bit k: a contract that says it does not is
// rejected, so `has_bit` facts cannot prove a wrong bit.
fn bit_on(w: u64, k: u64) -> u64
  requires k < 64
  ensures has_bit(result, k) == has_bit(w, k)
{
  return w | (1 << k);
}

fn main() -> u64 {
  return bit_on(0, 3) & 0;
}
