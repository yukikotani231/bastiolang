// expect-error: E-VERIFY-ASSERT
// A signed enum payload a loop changes keeps its type's range.
enum E { V(i32), W }

fn main() -> u64 {
  let mut e = E::V(0);
  let mut i = 0;
  while i < 2
    invariant i <= 2
  {
    e = E::V(-7);
    i = i + 1;
  }
  match e {
    E::V(x) => { assert x >= 0; },
    E::W => {},
  }
  return 0;
}
