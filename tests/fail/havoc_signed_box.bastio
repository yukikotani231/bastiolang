// expect-error: E-VERIFY-ASSERT
// A signed value in a box a loop changes keeps its type's range.
fn main() -> u64 {
  let n: i16 = -3;
  let mut bx = box(n);
  let mut i = 0;
  while i < 2
    invariant i <= 2
  {
    let o = unbox(bx);
    bx = box(o);
    i = i + 1;
  }
  let q: i16 = unbox(bx);
  assert q >= 0;
  return 0;
}
