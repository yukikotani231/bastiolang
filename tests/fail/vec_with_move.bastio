// stage1-only: vec_with
// expect-error: E-LINEAR-USE
// The function gets a shared borrow of the element: it cannot move the
// buffer out of it, which would leave the vector holding a freed one.
struct Named { name: Bytes, size: u64 }

fn steal(n: &Named) -> u64 {
  bfree(n.name);
  return 0;
}

fn main() -> u64 {
  let mut v = vec_new[Named]();
  vec_push(&mut v, Named { name: balloc(1), size: 1 });
  let s = vec_with(v, 0, steal);
  let n = vec_pop(&mut v);
  bfree(n.name);
  vec_free(v);
  return s;
}
