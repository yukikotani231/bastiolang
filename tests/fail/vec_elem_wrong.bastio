// expect-error: E-VERIFY-ASSERT
// Each element is tracked separately: element 0 is not the last one pushed.
enum State { Free, Used(u64) }

fn main() -> u64 {
  let mut st = vec_new[State]();
  vec_push(&mut st, State::Used(1));
  vec_push(&mut st, State::Used(2));
  assert vget(st, 0).Used == 2;
  vec_free(st);
  return 0;
}
