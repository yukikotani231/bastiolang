// expect-error: E-VERIFY-REQUIRES
// Spans of one text cannot be joined from another: the pieces are not known
// to lie inside `other`.
import "core/format.bastio";

fn main() -> u64 {
  let src = bfrom("a,b,c,d,e,f");
  let other = bfrom("ab");
  let parts = bytes_split(src, 44);
  let sep = bfrom(" ");
  let mut t = text_new();
  fmt_join(&mut t, other, parts, sep);
  vec_free(t);
  bfree(sep);
  vec_free(parts);
  bfree(other);
  bfree(src);
  return 0;
}
