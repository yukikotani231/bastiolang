// expect-error: E-TYPE
// A page lent to a device cannot go back to the pool (or anywhere a Frame
// goes) until it is taken back: the device may still write it.
fn main(pool: &mut Pool) -> u64 {
  if pool_size(pool) < 8 {
    return 0;
  }
  let d = dma_lend(pool_take(&mut pool, 0));
  pool_give(&mut pool, d);
  return 0;
}
