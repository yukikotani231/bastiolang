// Imports units.bastio, which import.bastio also imports: it is loaded once.
import "units.bastio";

const SIDE: u64 = UNIT + 2;          // constants from an import can be used

struct Rect { w: u64, h: u64 }

fn area(r: Rect) -> u64
  requires r.w <= 1000 && r.h <= 1000
  ensures result == r.w * r.h
{
  return r.w * r.h;
}
