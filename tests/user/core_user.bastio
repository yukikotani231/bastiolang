// core/ needs no operating system: a BastiOS user program can use all of it.
import "core/print.bastio";
import "core/endian.bastio";
import "core/hashmap.bastio";
import "core/sort.bastio";
import "core/ring.bastio";
import "core/bitmap.bastio";
import "core/csum.bastio";

fn main(con: &mut Serial) -> u64 {
  let mut m = hmap_new[u64]();
  let r = hmap_insert[u64](&mut m, 7, 49);
  print_str(con, "7*7 = ");
  print_u64(con, hmap_get_or[u64](m, 7, 0));
  print_nl(con);
  hmap_free[u64](m);
  let mut v = vec_new[u64]();
  vec_push(&mut v, 2);
  vec_push(&mut v, 1);
  sort_u64(&mut v);
  let first = vec_get(v, 0);
  vec_free(v);
  let mut q = queue_new(4);
  queue_push(&mut q, first);
  let got = queue_pop(&mut q);
  queue_free(q);
  let mut map = balloc(16);
  let slot = map_take(&mut map, 1, 16, 0);
  let c = crc32(map, 0, 16);
  bfree(map);
  if slot != 1 || c == 0 {
    return 99;
  }
  return got;
}
