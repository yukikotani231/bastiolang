// std/http.bastio: HTTP/1.1 over std/net.bastio, for programs on the hosted
// target: a client that fetches a page, and the building blocks of a server
// (accept a request, answer it). Every message is sent with
// `Connection: close`, so a body ends where the connection does and no
// chunked transfer is needed. A parser for a request head that is safe
// against hostile input is examples/http/http.bastio, and `http_accept`
// uses it: a request whose head it rejects is answered with 400 and never
// reaches the caller.
//
// What is proved: no read or write is out of bounds, and every buffer is
// freed. Not proved: that a peer speaks HTTP, that what is read stays within
// the limit given (the socket call's result is opaque to the prover), or
// that a response is complete.
import "net.bastio";
import "../examples/http/http.bastio";
import "../core/num.bastio";

/// A request that has been read: the connection it came on, the bytes read
/// so far (the head, and possibly the start of a body) and where the strict
/// parser found the method, the target and the fields in them.
struct HttpReq { conn: u64, head: Bytes, req: Req, body_read: bool }

/// The request for `GET path` from `host`.
/// ```
/// let r = http_get_request("example.org", "/index.html");
/// let want = bfrom("GET /index.html HTTP/1.1\r\nHost: example.org\r\nConnection: close\r\n\r\n");
/// let ok = bytes_eq(r, want);
/// bfree(r);
/// bfree(want);
/// if !ok { return 1; }
/// ```
fn http_get_request(host: Str, path: Str) -> Bytes {
  let mut t = text_new();
  text_push_str(&mut t, "GET ");
  text_push_str(&mut t, path);
  text_push_str(&mut t, " HTTP/1.1\r\nHost: ");
  text_push_str(&mut t, host);
  text_push_str(&mut t, "\r\nConnection: close\r\n\r\n");
  return text_finish(t);
}

/// A response with status `status`, reason phrase `reason`, content type
/// `ctype` and body `body`.
/// ```
/// let body = bfrom("hi");
/// let r = http_response(200, "OK", "text/plain", body);
/// let want = bfrom("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi");
/// let ok = bytes_eq(r, want);
/// bfree(r);
/// bfree(want);
/// bfree(body);
/// if !ok { return 1; }
/// ```
fn http_response(status: u64, reason: Str, ctype: Str, body: &Bytes) -> Bytes {
  return http_response_with(status, reason, ctype, body, false);
}

/// Internal: `http_response` with `Connection: keep-alive` when `keep`.
fn http_response_with(status: u64, reason: Str, ctype: Str, body: &Bytes, keep: bool) -> Bytes {
  let mut t = text_new();
  text_push_str(&mut t, "HTTP/1.1 ");
  fmt_u64(&mut t, status);
  text_push_str(&mut t, " ");
  text_push_str(&mut t, reason);
  text_push_str(&mut t, "\r\nContent-Type: ");
  text_push_str(&mut t, ctype);
  text_push_str(&mut t, "\r\nContent-Length: ");
  fmt_u64(&mut t, blen(body));
  if keep {
    text_push_str(&mut t, "\r\nConnection: keep-alive\r\n\r\n");
  } else {
    text_push_str(&mut t, "\r\nConnection: close\r\n\r\n");
  }
  text_push_bytes(&mut t, body);
  return text_finish(t);
}

/// Where the body starts: just past the empty line that ends the head.
/// ```
/// let m = bfrom("HTTP/1.1 200 OK\r\nA: b\r\n\r\nbody");
/// let mut ok = false;
/// match http_body_start(m) {
///   Option::Some(i) => { ok = i == 25; },
///   Option::None => {},
/// }
/// bfree(m);
/// if !ok { return 1; }
/// ```
fn http_body_start(m: &Bytes) -> Option[u64] {
  let end = bfrom("\r\n\r\n");
  let r = bytes_find(m, end, 0);
  bfree(end);
  match r {
    Option::Some(i) => { return Option[u64]::Some(i + 4); },
    Option::None => { return Option[u64]::None; },
  }
}

/// The status code of a response (0 if the status line is not
/// `HTTP/1.x NNN`).
/// ```
/// let m = bfrom("HTTP/1.1 404 Not Found\r\n\r\n");
/// let s = http_status(m);
/// bfree(m);
/// if s != 404 { return 1; }
/// ```
fn http_status(m: &Bytes) -> u64 {
  if blen(m) < 12 {
    return 0;
  }
  if !bytes_span_eq_str(m, 0, 7, "HTTP/1.") || bget(m, 8) != 32 {
    return 0;
  }
  match parse_u64(m, 9, 12) {
    Option::Some(s) => { return s; },
    Option::None => { return 0; },
  }
}

/// Reads from `sock` until the bytes read hold a whole head (an empty line),
/// or fails if the peer closes first or the head is longer than `limit`. The
/// result may end with the first bytes of a body.
/// ```
/// // The head ends at the empty line; a peer that stops sooner is an error.
/// let lo = net_ip4(127, 0, 0, 1);
/// let mut bad = 1;
/// match net_listen(host, lo, 0) {
///   Option::Some(s) => {
///     let p = net_port(host, s);
///     match net_connect(host, lo, p) {
///       Option::Some(c) => {
///         match net_accept(host, s) {
///           Option::Some(a) => {
///             let part = bfrom("GET / HTTP/1.1\r\nHost: x\r\n");
///             let sent = net_send_all(host, c, part);
///             bfree(part);
///             net_close(host, c);
///             match http_read_head(host, a, 4096) {
///               Option::Some(m) => { bfree(m); },
///               Option::None => { if sent { bad = 0; } },
///             }
///             net_close(host, a);
///           },
///           Option::None => { net_close(host, c); },
///         }
///       },
///       Option::None => {},
///     }
///     net_close(host, s);
///   },
///   Option::None => {},
/// }
/// if bad != 0 { return 1; }
/// ```
fn http_read_head(h: &Host, sock: u64, limit: u64) -> Option[Bytes] {
  if limit > 1073741824 {
    return Option[Bytes]::None;
  }
  let mut acc = balloc(0);
  let mut chunk = balloc(0);
  let mut done = false;
  let mut ok = true;
  while !done && ok {
    match http_body_start(acc) {
      Option::Some(i) => { done = true; },
      Option::None => {
        if blen(acc) >= limit {
          ok = false;
        } else {
          match net_recv(h, sock, limit - blen(acc), &mut chunk) {
            Option::Some(n) => {
              if n == 0 || blen(chunk) == 0 || blen(chunk) > limit {
                ok = false;
              } else {
                let joined = bytes_concat(acc, chunk);
                bfree(acc);
                acc = joined;
              }
            },
            Option::None => { ok = false; },
          }
        }
      },
    }
  }
  bfree(chunk);
  if ok {
    return Option[Bytes]::Some(acc);
  }
  bfree(acc);
  return Option[Bytes]::None;
}

/// Reads from `sock` until the peer closes it, or fails if more than `limit`
/// bytes arrive.
/// ```
/// // Everything the peer sends, up to its close.
/// let lo = net_ip4(127, 0, 0, 1);
/// let mut bad = 1;
/// match net_listen(host, lo, 0) {
///   Option::Some(s) => {
///     let p = net_port(host, s);
///     match net_connect(host, lo, p) {
///       Option::Some(c) => {
///         match net_accept(host, s) {
///           Option::Some(a) => {
///             let msg = bfrom("abcdef");
///             let sent = net_send_all(host, a, msg);
///             bfree(msg);
///             net_close(host, a);
///             match http_read_all(host, c, 100) {
///               Option::Some(m) => { if sent && bytes_eq_str(m, "abcdef") { bad = 0; } bfree(m); },
///               Option::None => {},
///             }
///           },
///           Option::None => {},
///         }
///         net_close(host, c);
///       },
///       Option::None => {},
///     }
///     net_close(host, s);
///   },
///   Option::None => {},
/// }
/// if bad != 0 { return 1; }
/// ```
fn http_read_all(h: &Host, sock: u64, limit: u64) -> Option[Bytes] {
  if limit > 1073741824 {
    return Option[Bytes]::None;
  }
  let mut acc = balloc(0);
  let mut chunk = balloc(0);
  let mut done = false;
  let mut ok = true;
  while !done && ok {
    if blen(acc) >= limit {
      ok = false;
    } else {
      match net_recv(h, sock, limit - blen(acc), &mut chunk) {
        Option::Some(n) => {
          if n == 0 || blen(chunk) == 0 {
            done = true;
          } else if blen(chunk) > limit {
            ok = false;
          } else {
            let joined = bytes_concat(acc, chunk);
            bfree(acc);
            acc = joined;
          }
        },
        Option::None => { ok = false; },
      }
    }
  }
  bfree(chunk);
  if ok {
    return Option[Bytes]::Some(acc);
  }
  bfree(acc);
  return Option[Bytes]::None;
}

/// Internal: the decoded body of a chunked message. `first` holds the bytes
/// that followed the head when it was read; the rest comes from `sock` until
/// the last chunk. The decoded body is at most `limit` bytes. `tight` says
/// whether the data read ends with the last chunk's trailers.
fn http_read_chunked(h: &Host, sock: u64, first: &Bytes, limit: u64, tight: &mut bool) -> Option[Bytes]
  ensures result is Option::Some ==> blen(result.Some) <= limit && limit <= 1073741824
{
  if limit > 1073741824 || blen(first) > 1073741824 {
    return Option[Bytes]::None;
  }
  let mut acc = bytes_slice(first, 0, blen(first));
  let mut chunk = balloc(0);
  let mut out = balloc(0);
  let mut ok = true;
  // The framing is bounded too: a body of one-byte chunks is seven bytes
  // to the byte of data.
  let cap = limit * 8 + 65536;
  let mut pos: u64 = 0;
  let mut done = false;
  if blen(acc) > cap {
    ok = false;
  }
  while ok && !done
    invariant !ok || (pos <= blen(acc) && blen(acc) <= cap)
    invariant blen(out) <= limit && cap <= 8589934592 + 65536
  {
    match http_chunk(acc, pos) {
      Chunk::Ok(c) => {
        if c.size > limit - blen(out) {
          ok = false;
        } else {
          let piece = bytes_slice(acc, c.data, c.data + c.size);
          let joined = bytes_concat(out, piece);
          bfree(piece);
          bfree(out);
          out = joined;
          pos = c.next;
        }
      },
      Chunk::Last(x) => {
        done = true;
        // Nothing of the next message was read with this one.
        tight = x == blen(acc);
      },
      Chunk::Bad(x) => { ok = false; },
      Chunk::Partial => {
        if blen(acc) >= cap {
          ok = false;
        } else {
          match net_recv(h, sock, cap - blen(acc), &mut chunk) {
            Option::Some(n) => {
              if n == 0 || blen(chunk) == 0 || blen(chunk) > cap - blen(acc) {
                ok = false;
              } else {
                let joined = bytes_concat(acc, chunk);
                bfree(acc);
                acc = joined;
              }
            },
            Option::None => { ok = false; },
          }
        }
      },
    }
  }
  bfree(acc);
  bfree(chunk);
  if ok {
    return Option[Bytes]::Some(out);
  }
  bfree(out);
  return Option[Bytes]::None;
}

/// Reads one response from `sock` and returns it whole, status line and
/// headers included, without waiting for the peer to close: the head, then
/// the `Content-Length` bytes it names. A response with no `Content-Length`
/// is read to the peer's close, as `http_read_all` does it; a chunked one
/// is read to its last chunk and returned with the body decoded after the
/// head, which is left as it came. A head that is not a valid response head,
/// a message longer than `limit` and a peer that closes early give `None`.
/// ```
/// // A response on a connection that stays open.
/// let lo = net_ip4(127, 0, 0, 1);
/// let mut bad = 1;
/// match net_listen(host, lo, 0) {
///   Option::Some(s) => {
///     let p = net_port(host, s);
///     match net_connect(host, lo, p) {
///       Option::Some(c) => {
///         match net_accept(host, s) {
///           Option::Some(a) => {
///             let body = bfrom("hello");
///             let resp = http_response_with(200, "OK", "text/plain", body, true);
///             let sent = net_send_all(host, a, resp);
///             bfree(resp);
///             bfree(body);
///             // The connection is still open: this returns at once.
///             match http_read_response(host, c, 4096) {
///               Option::Some(m) => {
///                 if sent && http_status(m) == 200 { bad = 0; }
///                 bfree(m);
///               },
///               Option::None => {},
///             }
///             // A chunked response on the same connection comes back decoded.
///             let ch = bfrom("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nhel\r\n2\r\nlo\r\n0\r\n\r\n");
///             let sent2 = net_send_all(host, a, ch);
///             bfree(ch);
///             match http_read_response(host, c, 4096) {
///               Option::Some(m) => {
///                 match http_body_start(m) {
///                   Option::Some(at) => {
///                     if !sent2 || at > blen(m) || !bytes_span_eq_str(m, at, blen(m), "hello") { bad = 1; }
///                   },
///                   Option::None => { bad = 1; },
///                 }
///                 bfree(m);
///               },
///               Option::None => { bad = 1; },
///             }
///             net_close(host, a);
///           },
///           Option::None => {},
///         }
///         net_close(host, c);
///       },
///       Option::None => {},
///     }
///     net_close(host, s);
///   },
///   Option::None => {},
/// }
/// if bad != 0 { return 1; }
/// ```
fn http_read_response(h: &Host, sock: u64, limit: u64) -> Option[Bytes] {
  if limit > 1073741824 {
    return Option[Bytes]::None;
  }
  match http_read_head(h, sock, limit) {
    Option::Some(head) => {
      let mut want: u64 = 0;
      let mut rest = false;
      let mut chunked = false;
      let mut ok = true;
      let mut hend: u64 = 0;
      match http_parse_response(head) {
        RespHead::Ok(q) => {
          if q.head_end > blen(head) || q.fields > blen(head) {
            ok = false;
          } else {
            hend = q.head_end;
            match http_body(head, q.fields) {
              Body::None => { rest = true; },
              Body::Length(n) => {
                if n > limit || q.head_end > limit - n {
                  ok = false;
                } else {
                  want = q.head_end + n;
                }
              },
              Body::Chunked => { chunked = true; },
              Body::Bad(x) => { ok = false; },
            }
          }
        },
        RespHead::Partial => { ok = false; },
        RespHead::Bad(x) => { ok = false; },
      }
      if blen(head) > 1073741824 {
        ok = false;
      }
      if chunked && ok && hend <= blen(head) {
        // The head, then the decoded body in its place.
        let first = bytes_slice(head, hend, blen(head));
        let lead = bytes_slice(head, 0, hend);
        bfree(head);
        let mut tight = false;
        match http_read_chunked(h, sock, first, limit, &mut tight) {
          Option::Some(d) => {
            let both = bytes_concat(lead, d);
            bfree(d);
            bfree(lead);
            bfree(first);
            return Option[Bytes]::Some(both);
          },
          Option::None => {
            bfree(lead);
            bfree(first);
            return Option[Bytes]::None;
          },
        }
      }
      let mut acc = head;
      let mut chunk = balloc(0);
      while ok && (rest || blen(acc) < want)
        invariant !ok || blen(acc) <= 2147483648
      {
        if blen(acc) >= limit {
          ok = false;
        } else {
          match net_recv(h, sock, limit - blen(acc), &mut chunk) {
            Option::Some(n) => {
              if n == 0 || blen(chunk) == 0 {
                if !rest { ok = false; }
                rest = false;
                want = blen(acc);
              } else if blen(chunk) > limit || blen(acc) > limit {
                ok = false;
              } else {
                let joined = bytes_concat(acc, chunk);
                bfree(acc);
                acc = joined;
              }
            },
            Option::None => { ok = false; },
          }
        }
      }
      bfree(chunk);
      if ok {
        return Option[Bytes]::Some(acc);
      }
      bfree(acc);
      return Option[Bytes]::None;
    },
    Option::None => { return Option[Bytes]::None; },
  }
}

/// Sends `GET path` to `ip`:`port` (the `Host` header says `host`) and
/// returns the whole response, at most `limit` bytes, status line and
/// headers included. Check it with `http_status`; the body starts at
/// `http_body_start`.
/// ```
/// // Nothing listens on port 1, so there is no response.
/// let mut none = true;
/// match http_get(host, net_ip4(127, 0, 0, 1), 1, "localhost", "/", 65536) {
///   Option::Some(r) => { bfree(r); none = false; },
///   Option::None => {},
/// }
/// if !none { return 1; }
/// ```
fn http_get(h: &Host, ip: u64, port: u64, host: Str, path: Str, limit: u64) -> Option[Bytes] {
  match net_connect(h, ip, port) {
    Option::Some(s) => {
      let req = http_get_request(host, path);
      let sent = net_send_all(h, s, req);
      bfree(req);
      if !sent {
        net_close(h, s);
        return Option[Bytes]::None;
      }
      let r = http_read_all(h, s, limit);
      net_close(h, s);
      return r;
    },
    Option::None => { return Option[Bytes]::None; },
  }
}

/// The request for `POST path` from `host`, with `body` as its content of
/// type `ctype`.
/// ```
/// let body = bfrom("{\"a\":1}");
/// let r = http_post_request("example.org", "/api", "application/json", body);
/// let want = bfrom("POST /api HTTP/1.1\r\nHost: example.org\r\nContent-Type: application/json\r\nContent-Length: 7\r\nConnection: close\r\n\r\n{\"a\":1}");
/// let ok = bytes_eq(r, want);
/// bfree(r);
/// bfree(want);
/// bfree(body);
/// if !ok { return 1; }
/// ```
fn http_post_request(host: Str, path: Str, ctype: Str, body: &Bytes) -> Bytes {
  let mut t = text_new();
  text_push_str(&mut t, "POST ");
  text_push_str(&mut t, path);
  text_push_str(&mut t, " HTTP/1.1\r\nHost: ");
  text_push_str(&mut t, host);
  text_push_str(&mut t, "\r\nContent-Type: ");
  text_push_str(&mut t, ctype);
  text_push_str(&mut t, "\r\nContent-Length: ");
  fmt_u64(&mut t, blen(body));
  text_push_str(&mut t, "\r\nConnection: close\r\n\r\n");
  text_push_bytes(&mut t, body);
  return text_finish(t);
}

/// Sends `POST path` with `body` (of type `ctype`) to `ip`:`port` and
/// returns the whole response, as `http_get` does.
/// ```
/// // Nothing listens on port 1, so there is no response.
/// let body = bfrom("x");
/// let mut none = true;
/// match http_post(host, net_ip4(127, 0, 0, 1), 1, "localhost", "/", "text/plain", body, 65536) {
///   Option::Some(r) => { bfree(r); none = false; },
///   Option::None => {},
/// }
/// bfree(body);
/// if !none { return 1; }
/// ```
fn http_post(h: &Host, ip: u64, port: u64, host: Str, path: Str, ctype: Str, body: &Bytes, limit: u64) -> Option[Bytes] {
  match net_connect(h, ip, port) {
    Option::Some(s) => {
      let req = http_post_request(host, path, ctype, body);
      let sent = net_send_all(h, s, req);
      bfree(req);
      if !sent {
        net_close(h, s);
        return Option[Bytes]::None;
      }
      let r = http_read_all(h, s, limit);
      net_close(h, s);
      return r;
    },
    Option::None => { return Option[Bytes]::None; },
  }
}

/// Accepts a connection on the listening socket `sock` and reads its request
/// head (at most `limit` bytes). A connection that sends no whole head in
/// that much is closed and gives `None`.
/// ```
/// // The request goes through a loopback connection made in the example.
/// let lo = net_ip4(127, 0, 0, 1);
/// let mut bad = 1;
/// match net_listen(host, lo, 0) {
///   Option::Some(s) => {
///     let p = net_port(host, s);
///     match net_connect(host, lo, p) {
///       Option::Some(c) => {
///         let req = http_get_request("localhost", "/hello");
///         let sent = net_send_all(host, c, req);
///         bfree(req);
///         match http_accept(host, s, 4096) {
///           Option::Some(r) => {
///             let t = http_req_target(r);
///             if sent && bytes_eq_str(t, "/hello") { bad = 0; }
///             bfree(t);
///             http_close(host, r);
///           },
///           Option::None => {},
///         }
///         net_close(host, c);
///       },
///       Option::None => {},
///     }
///     net_close(host, s);
///   },
///   Option::None => {},
/// }
/// if bad != 0 { return 1; }
/// ```
fn http_accept(h: &Host, sock: u64, limit: u64) -> Option[HttpReq] {
  match net_accept(h, sock) {
    Option::Some(c) => { return http_read_request(h, c, limit); },
    Option::None => { return Option[HttpReq]::None; },
  }
}

/// Reads the next request head (at most `limit` bytes) from the connection
/// `conn`, which `http_accept` or an earlier answer left open. A peer that
/// closes it, or sends no whole head, or a head the strict parser rejects
/// (answered with 400) gives `None`, and the connection is closed.
/// ```
/// // Two requests, one after the other, on one connection.
/// let lo = net_ip4(127, 0, 0, 1);
/// let mut bad = 1;
/// match net_listen(host, lo, 0) {
///   Option::Some(s) => {
///     let p = net_port(host, s);
///     match net_connect(host, lo, p) {
///       Option::Some(c) => {
///         match net_accept(host, s) {
///           Option::Some(a) => {
///             let r1 = http_get_request("x", "/one");
///             let sent = net_send_all(host, c, r1);
///             bfree(r1);
///             match http_read_request(host, a, 4096) {
///               Option::Some(q) => {
///                 let t = http_req_target(q);
///                 if sent && bytes_eq_str(t, "/one") { bad = 0; }
///                 bfree(t);
///                 http_close(host, q);
///               },
///               Option::None => {},
///             }
///           },
///           Option::None => {},
///         }
///         net_close(host, c);
///       },
///       Option::None => {},
///     }
///     net_close(host, s);
///   },
///   Option::None => {},
/// }
/// if bad != 0 { return 1; }
/// ```
fn http_read_request(h: &Host, c: u64, limit: u64) -> Option[HttpReq] {
  match http_read_head(h, c, limit) {
    Option::Some(head) => {
      match http_parse_head(head) {
        Head::Ok(q) => {
          return Option[HttpReq]::Some(HttpReq { conn: c, head: head, req: q, body_read: false });
        },
        Head::Partial => {
          let body = bfrom("bad request\n");
          let resp = http_response(400, "Bad Request", "text/plain", body);
          net_send_all(h, c, resp);
          bfree(resp);
          bfree(body);
          net_close(h, c);
          bfree(head);
          return Option[HttpReq]::None;
        },
        Head::Bad(x) => {
          let body = bfrom("bad request\n");
          let resp = http_response(400, "Bad Request", "text/plain", body);
          net_send_all(h, c, resp);
          bfree(resp);
          bfree(body);
          net_close(h, c);
          bfree(head);
          return Option[HttpReq]::None;
        },
      }
    },
    Option::None => {
      net_close(h, c);
      return Option[HttpReq]::None;
    },
  }
}

/// The request target of `r` (the path and query of `GET /a?b HTTP/1.1`), or
/// empty if the request line has none.
fn http_req_target(r: &HttpReq) -> Bytes {
  if r.req.target < r.req.target_end && r.req.target_end <= blen(r.head) {
    return bytes_slice(r.head, r.req.target, r.req.target_end);
  }
  return balloc(0);
}

/// Is the request method the literal `m`?
/// ```
/// let lo = net_ip4(127, 0, 0, 1);
/// let mut bad = 1;
/// match net_listen(host, lo, 0) {
///   Option::Some(s) => {
///     let p = net_port(host, s);
///     match net_connect(host, lo, p) {
///       Option::Some(c) => {
///         let req = http_get_request("localhost", "/");
///         let sent = net_send_all(host, c, req);
///         bfree(req);
///         match http_accept(host, s, 4096) {
///           Option::Some(r) => {
///             if sent && http_req_is(r, "GET") && !http_req_is(r, "POST") { bad = 0; }
///             http_close(host, r);
///           },
///           Option::None => {},
///         }
///         net_close(host, c);
///       },
///       Option::None => {},
///     }
///     net_close(host, s);
///   },
///   Option::None => {},
/// }
/// if bad != 0 { return 1; }
/// ```
fn http_req_is(r: &HttpReq, m: Str) -> bool {
  return r.req.method_end == slen(m) && r.req.method_end <= blen(r.head) && bytes_span_eq_str(r.head, 0, r.req.method_end, m);
}

/// Reads the body of the request `r` from its connection and returns it,
/// decoded: `Content-Length` bytes, or the data of a chunked body without the
/// framing, or nothing if the request has neither field. Gives `None` if the
/// framing is ambiguous or invalid (a repeated `Content-Length`, both
/// fields, a transfer coding other than a lone `chunked`: see `http_body`),
/// if the body is longer than `limit` bytes, or if the peer closes or fails
/// before the body is whole. The request stays open for the answer; after a
/// `Content-Length` body or a chunked one (through its trailers) that ends
/// the data read, `http_req_keeps` allows another request on the connection.
/// ```
/// // A POST with a Content-Length body, then one with a chunked body.
/// let lo = net_ip4(127, 0, 0, 1);
/// let mut bad = 1;
/// match net_listen(host, lo, 0) {
///   Option::Some(s) => {
///     let p = net_port(host, s);
///     let mut n = 0;
///     while n < 2 {
///       match net_connect(host, lo, p) {
///         Option::Some(c) => {
///           let mut req = bfrom("POST /x HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello");
///           if n == 1 {
///             bfree(req);
///             req = bfrom("POST /x HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nhel\r\n2\r\nlo\r\n0\r\n\r\n");
///           }
///           let sent = net_send_all(host, c, req);
///           bfree(req);
///           match http_accept(host, s, 4096) {
///             Option::Some(mut r) => {
///               match http_req_body(host, &mut r, 4096) {
///                 Option::Some(b) => {
///                   if sent && bytes_eq_str(b, "hello") { bad = 0; }
///                   bfree(b);
///                 },
///                 Option::None => { bad = 1; },
///               }
///               http_close(host, r);
///             },
///             Option::None => { bad = 1; },
///           }
///           net_close(host, c);
///         },
///         Option::None => { bad = 1; },
///       }
///       n = n + 1;
///     }
///     net_close(host, s);
///   },
///   Option::None => {},
/// }
/// if bad != 0 { return 1; }
/// ```
fn http_req_body(h: &Host, r: &mut HttpReq, limit: u64) -> Option[Bytes] {
  if limit > 1073741824 || blen(r.head) > 1073741824 || r.req.head_end > blen(r.head) {
    return Option[Bytes]::None;
  }
  // What came with the head, then what the loops below read.
  let mut acc = bytes_slice(r.head, r.req.head_end, blen(r.head));
  let mut chunk = balloc(0);
  let mut out = balloc(0);
  let mut ok = true;
  match http_body(r.head, r.req.fields) {
    Body::None => {},
    Body::Bad(x) => { ok = false; },
    Body::Length(want) => {
      if want > limit {
        ok = false;
      }
      while ok && blen(acc) < want
        invariant blen(acc) <= 2147483648
      {
        match net_recv(h, r.conn, want - blen(acc), &mut chunk) {
          Option::Some(n) => {
            if n == 0 || blen(chunk) == 0 || blen(chunk) > limit || blen(acc) > limit {
              ok = false;
            } else {
              let joined = bytes_concat(acc, chunk);
              bfree(acc);
              acc = joined;
            }
          },
          Option::None => { ok = false; },
        }
      }
      if ok && want <= blen(acc) {
        bfree(out);
        out = bytes_slice(acc, 0, want);
        // Nothing of the next request was read with this one.
        r.body_read = blen(acc) == want;
      }
    },
    Body::Chunked => {
      let mut tight = false;
      match http_read_chunked(h, r.conn, acc, limit, &mut tight) {
        Option::Some(d) => {
          bfree(out);
          out = d;
          r.body_read = tight;
        },
        Option::None => { ok = false; },
      }
    },
  }
  bfree(acc);
  bfree(chunk);
  if ok {
    return Option[Bytes]::Some(out);
  }
  bfree(out);
  return Option[Bytes]::None;
}

/// Internal: does `s[a..b)` spell "connection", ignoring case?
fn http_is_connection(s: &Bytes, a: u64, b: u64) -> bool
  requires a <= b && b <= blen(s)
{
  if b - a != 10 { return false; }
  let mut i = 0;
  while i < 10
    invariant i <= 10 && a + 10 == b
  {
    if http_lower(bget(s, a + i)) != sget("connection", i) { return false; }
    i = i + 1;
  }
  return true;
}

/// Internal: does `s[a..b)` contain "close", ignoring case?
fn http_has_close(s: &Bytes, a: u64, b: u64) -> bool
  requires a <= b && b <= blen(s)
{
  let mut i = a;
  while i + 5 <= b
    invariant a <= i && i <= b
  {
    let mut k = 0;
    while k < 5 && http_lower(bget(s, i + k)) == sget("close", k)
      invariant k <= 5 && i + 5 <= b
    {
      k = k + 1;
    }
    if k == 5 { return true; }
    i = i + 1;
  }
  return false;
}

/// May the connection of `r` carry another request once it is answered? Yes
/// for HTTP/1.1 without `Connection: close` when the request has no body, or
/// a `Content-Length` or chunked body that `http_req_body` has read to its
/// last byte,
/// and nothing of the next request was read with it (a client that sent the
/// next request early gets the connection closed after the answer instead,
/// and so does one with an unread body).
/// ```
/// // HTTP/1.1 keeps; asking to close, or HTTP/1.0, does not.
/// let lo = net_ip4(127, 0, 0, 1);
/// let mut bad = 1;
/// match net_listen(host, lo, 0) {
///   Option::Some(s) => {
///     let p = net_port(host, s);
///     bad = 0;
///     let mut n = 0;
///     while n < 3 {
///       match net_connect(host, lo, p) {
///         Option::Some(c) => {
///           let mut req = bfrom("GET / HTTP/1.1\r\nHost: x\r\n\r\n");
///           if n == 1 {
///             bfree(req);
///             req = bfrom("GET / HTTP/1.1\r\nHost: x\r\nConnection: Keep-Alive, CLOSE\r\n\r\n");
///           }
///           if n == 2 {
///             bfree(req);
///             req = bfrom("GET / HTTP/1.0\r\nHost: x\r\n\r\n");
///           }
///           let sent = net_send_all(host, c, req);
///           bfree(req);
///           match http_accept(host, s, 4096) {
///             Option::Some(r) => {
///               if !sent || http_req_keeps(r) != (n == 0) { bad = 1; }
///               http_close(host, r);
///             },
///             Option::None => { bad = 1; },
///           }
///           net_close(host, c);
///         },
///         Option::None => { bad = 1; },
///       }
///       n = n + 1;
///     }
///     net_close(host, s);
///   },
///   Option::None => {},
/// }
/// if bad != 0 { return 1; }
/// ```
fn http_req_keeps(r: &HttpReq) -> bool {
  if r.req.minor != 1 || r.req.fields > blen(r.head) {
    return false;
  }
  match http_body(r.head, r.req.fields) {
    Body::None => { if r.req.head_end != blen(r.head) { return false; } },
    Body::Length(x) => { if !r.body_read { return false; } },
    Body::Chunked => { if !r.body_read { return false; } },
    Body::Bad(x) => { return false; },
  }
  let n = blen(r.head);
  let mut at = r.req.fields;
  while at < n
    invariant r.req.fields <= at && at <= n
  {
    match http_field(r.head, at) {
      Next::Partial => { return false; }
      Next::Bad(x) => { return false; }
      Next::End(x) => { return true; }
      Next::Ok(f) => {
        if http_is_connection(r.head, at, f.name_end) && http_has_close(r.head, f.value, f.value_end) {
          return false;
        }
        at = f.next;
      }
    }
  }
  return false;
}

/// Answers `r` with a response made from `status`, `reason`, `ctype` and
/// `body`, and frees the request. The response says `Connection:
/// keep-alive` and the connection is returned, still open, when
/// `http_req_keeps` allows it; otherwise it says `Connection: close` and the
/// connection is closed (also when the answer could not be sent) and the
/// result is `None`. The next request on a returned connection is read with
/// `http_read_request`.
/// ```
/// // Two requests on one connection: the first is answered with keep-alive,
/// // the second asks to close.
/// let lo = net_ip4(127, 0, 0, 1);
/// let mut bad = 1;
/// match net_listen(host, lo, 0) {
///   Option::Some(s) => {
///     let p = net_port(host, s);
///     match net_connect(host, lo, p) {
///       Option::Some(c) => {
///         match net_accept(host, s) {
///           Option::Some(a) => {
///             let r1 = bfrom("GET /one HTTP/1.1\r\nHost: x\r\n\r\n");
///             let sent1 = net_send_all(host, c, r1);
///             bfree(r1);
///             let body = bfrom("ok\n");
///             let mut kept = 0;
///             match http_read_request(host, a, 4096) {
///               Option::Some(q) => {
///                 match http_answer(host, q, 200, "OK", "text/plain", body) {
///                   Option::Some(k) => { kept = k; },
///                   Option::None => {},
///                 }
///               },
///               Option::None => {},
///             }
///             let r2 = http_get_request("x", "/two");
///             let sent2 = net_send_all(host, c, r2);
///             bfree(r2);
///             if sent1 && sent2 && kept != 0 {
///               match http_read_request(host, kept, 4096) {
///                 Option::Some(q) => {
///                   // Connection: close in the request, so no keep-alive.
///                   match http_answer(host, q, 200, "OK", "text/plain", body) {
///                     Option::Some(k) => { net_close(host, k); },
///                     Option::None => { bad = 0; },
///                   }
///                 },
///                 Option::None => {},
///               }
///             }
///             bfree(body);
///           },
///           Option::None => {},
///         }
///         net_close(host, c);
///       },
///       Option::None => {},
///     }
///     net_close(host, s);
///   },
///   Option::None => {},
/// }
/// if bad != 0 { return 1; }
/// ```
fn http_answer(h: &Host, r: HttpReq, status: u64, reason: Str, ctype: Str, body: &Bytes) -> Option[u64] {
  let keep = http_req_keeps(r);
  let resp = http_response_with(status, reason, ctype, body, keep);
  let ok = net_send_all(h, r.conn, resp);
  bfree(resp);
  let c = r.conn;
  bfree(r.head);
  if ok && keep {
    return Option[u64]::Some(c);
  }
  net_close(h, c);
  return Option[u64]::None;
}

/// Sends `resp` (build it with `http_response`) on the request's connection,
/// closes the connection and frees the request.
/// ```
/// // A whole exchange in one process: the client's request is already in the
/// // socket's buffer when the server reads it, and the answer is when the
/// // client does.
/// let lo = net_ip4(127, 0, 0, 1);
/// let mut bad = 1;
/// match net_listen(host, lo, 0) {
///   Option::Some(s) => {
///     let p = net_port(host, s);
///     match net_connect(host, lo, p) {
///       Option::Some(c) => {
///         let req = http_get_request("localhost", "/hi");
///         let sent = net_send_all(host, c, req);
///         bfree(req);
///         match http_accept(host, s, 4096) {
///           Option::Some(r) => {
///             let body = bfrom("hello");
///             let resp = http_response(200, "OK", "text/plain", body);
///             let ok = http_reply(host, r, resp);
///             bfree(resp);
///             bfree(body);
///             match http_read_all(host, c, 4096) {
///               Option::Some(m) => {
///                 let mut at = 0;
///                 match http_body_start(m) { Option::Some(i) => { at = i; }, Option::None => {} }
///                 if sent && ok && http_status(m) == 200 && at <= blen(m) && blen(m) - at == 5 { bad = 0; }
///                 bfree(m);
///               },
///               Option::None => {},
///             }
///           },
///           Option::None => {},
///         }
///         net_close(host, c);
///       },
///       Option::None => {},
///     }
///     net_close(host, s);
///   },
///   Option::None => {},
/// }
/// if bad != 0 { return 1; }
/// ```
fn http_reply(h: &Host, r: HttpReq, resp: &Bytes) -> bool {
  let ok = net_send_all(h, r.conn, resp);
  http_close(h, r);
  return ok;
}

/// Closes the request's connection and frees the request.
/// ```
/// // See `http_accept`.
/// ```
fn http_close(h: &Host, r: HttpReq) {
  net_close(h, r.conn);
  bfree(r.head);
}
