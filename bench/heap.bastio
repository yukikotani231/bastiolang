// A binary min-heap in one Buf of 2^18 words (slot 0 unused): 262144
// pseudo-random keys are pushed and then popped in order, four times, and the
// popped keys are folded into a checksum. Each push and pop is a walk along
// one branch of the tree with a data-dependent compare at every level.
const N: u64 = 262144;

fn push(mut h: Buf, n: u64, v: u64) -> Buf
  requires len(h) == N + 1 && n < N
  ensures len(result) == N + 1
{
  let mut i = n + 1;
  while i > 1 && get(h, i / 2) > v
    invariant 1 <= i && i <= N && len(h) == N + 1
  {
    h = set(h, i, get(h, i / 2));
    i = i / 2;
  }
  h = set(h, i, v);
  return h;
}

// Removes the root of a heap of `n` keys; the caller has read it.
fn pop(mut h: Buf, n: u64) -> Buf
  requires len(h) == N + 1 && 1 <= n && n <= N
  ensures len(result) == N + 1
{
  let v = get(h, n);
  let m = n - 1;
  let mut i = 1;
  let mut go = true;
  while go && 2 * i <= m
    invariant 1 <= i && i <= N && len(h) == N + 1 && m < N
  {
    let mut c = 2 * i;
    if c + 1 <= m && get(h, c + 1) < get(h, c) {
      c = c + 1;
    }
    let w = get(h, c);
    if w >= v {
      go = false;
    } else {
      h = set(h, i, w);
      i = c;
    }
  }
  h = set(h, i, v);
  return h;
}

fn main() -> u64 {
  let mut h = alloc(N + 1);
  let mut x = 12345;
  let mut sum = 0;
  let mut round = 0;
  while round < 4
    invariant round <= 4 && len(h) == N + 1 && x < 4294967296
  {
    let mut n = 0;
    while n < N
      invariant n <= N && len(h) == N + 1 && x < 4294967296
    {
      x = (x * 1103515245 + 12345) % 4294967296;
      h = push(h, n, x);
      n = n + 1;
    }
    while n > 0
      invariant n <= N && len(h) == N + 1
    {
      sum = wrap_add(wrap_mul(sum, 31), get(h, 1));
      h = pop(h, n);
      n = n - 1;
    }
    round = round + 1;
  }
  print(sum);
  free(h);
  return 0;
}
