// Insertion sort of 16384 pseudo-random u64 values in a Buf, then a checksum
// that weights each value by its position (so a wrong order changes it).
fn main() -> u64 {
  let mut a = alloc(16384);
  let mut x = 12345;
  let mut i = 0;
  while i < 16384
    invariant i <= 16384 && len(a) == 16384 && x < 4294967296
  {
    x = (x * 1103515245 + 12345) % 4294967296;
    a = set(a, i, x);
    i = i + 1;
  }
  i = 1;
  while i < 16384
    invariant i >= 1 && i <= 16384 && len(a) == 16384
  {
    let v = get(a, i);
    let mut j = i;
    while j > 0 && get(a, j - 1) > v
      invariant j <= i && i < 16384 && len(a) == 16384
    {
      a = set(a, j, get(a, j - 1));
      j = j - 1;
    }
    a = set(a, j, v);
    i = i + 1;
  }
  let mut sum = 0;
  i = 0;
  while i < 16384
    invariant i <= 16384 && len(a) == 16384
  {
    sum = wrap_add(sum, wrap_mul(get(a, i), i));
    i = i + 1;
  }
  print(sum);
  free(a);
  return 0;
}
