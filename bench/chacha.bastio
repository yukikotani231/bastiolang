// The ChaCha quarter round on four u32 words, 2^24 times: modular u32 adds,
// xors and rotations (a rotation is a shift each way on the widened word).
// The final words are the checksum.
fn rotl(x: u32, n: u64) -> u32
  requires n >= 1 && n <= 31
{
  return wrap[u32](cast[u64](x) << n) | (x >> (32 - n));
}

fn main() -> u64 {
  let mut a: u32 = 1634760805;
  let mut b: u32 = 857760878;
  let mut c: u32 = 2036477234;
  let mut d: u32 = 1797285236;
  let mut i = 0;
  while i < 16777216
    invariant i <= 16777216
  {
    a = wrap_add(a, b); d = d ^ a; d = rotl(d, 16);
    c = wrap_add(c, d); b = b ^ c; b = rotl(b, 12);
    a = wrap_add(a, b); d = d ^ a; d = rotl(d, 8);
    c = wrap_add(c, d); b = b ^ c; b = rotl(b, 7);
    i = i + 1;
  }
  print(cast[u64](a));
  print(cast[u64](b));
  print(cast[u64](c));
  print(cast[u64](d));
  return 0;
}
