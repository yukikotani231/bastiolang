// Binary search: 4 million pseudo-random queries into a sorted table of 2^20
// words. A short loop with a data-dependent branch, one load per step.
const N: u64 = 1048576;

fn lower(a: &Buf, key: u64) -> u64
  requires len(a) == N
  ensures result <= N
{
  let mut lo = 0;
  let mut hi = N;
  while lo < hi
    invariant lo <= hi && hi <= N && len(a) == N
  {
    let mid = lo + (hi - lo) / 2;
    if get(a, mid) < key {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo;
}

fn main() -> u64 {
  let mut a = alloc(N);
  let mut i = 0;
  while i < N
    invariant i <= N && len(a) == N
  {
    a = set(a, i, i * 3);
    i = i + 1;
  }
  let mut x = 12345;
  let mut sum = 0;
  let mut q = 0;
  while q < 4000000
    invariant q <= 4000000 && len(a) == N && x < 4294967296 && sum <= q * N
  {
    x = (x * 1103515245 + 12345) % 4294967296;
    sum = sum + lower(a, x % (N * 3));
    q = q + 1;
  }
  print(sum);
  free(a);
  return 0;
}
