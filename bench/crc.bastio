// Bitwise CRC-32 (reflected, polynomial 0xEDB88320) over a 1 MiB buffer, 8 passes.
fn main() -> u64 {
  let mut b = balloc(1048576);
  let mut x = 12345;
  let mut i = 0;
  while i < 1048576
    invariant i <= 1048576 && blen(b) == 1048576 && x < 4294967296
  {
    x = (x * 1103515245 + 12345) % 4294967296;
    bset(&mut b, i, cast[u8](x / 65536 % 256));
    i = i + 1;
  }
  let mut crc = 4294967295;
  let mut pass = 0;
  while pass < 8
    invariant pass <= 8 && blen(b) == 1048576 && crc < 4294967296
  {
    i = 0;
    while i < 1048576
      invariant i <= 1048576 && blen(b) == 1048576 && crc < 4294967296
    {
      crc = (crc ^ cast[u64](bget(b, i))) % 4294967296;
      let mut k = 0;
      while k < 8
        invariant k <= 8 && crc < 4294967296
      {
        if crc % 2 == 1 {
          crc = (crc / 2 ^ 3988292384) % 4294967296;
        } else {
          crc = crc / 2;
        }
        k = k + 1;
      }
      i = i + 1;
    }
    pass = pass + 1;
  }
  print(crc ^ 4294967295);
  bfree(b);
  return 0;
}
