// A Fenwick tree (binary indexed tree) over 2^20 counters: 2^21 pseudo-random
// point updates and prefix sums; the sum of the sums is the checksum.
const N: u64 = 1048576;

fn main() -> u64 {
  let mut t = alloc(N + 1);
  let mut x = 12345;
  let mut total = 0;
  let mut k = 0;
  while k < 2097152
    invariant k <= 2097152 && len(t) == N + 1 && x < 4294967296
  {
    x = (x * 1103515245 + 12345) % 4294967296;
    let mut i = x / 16 % N + 1;
    let v = x / 4096 % 100;
    while i <= N
      invariant len(t) == N + 1 && i >= 1
    {
      t = set(t, i, wrap_add(get(t, i), v));
      i = wrap_add(i, i & wrap_sub(0, i));
    }
    x = (x * 1103515245 + 12345) % 4294967296;
    let mut j = x / 16 % N + 1;
    let mut s = 0;
    while j > 0
      invariant len(t) == N + 1 && j <= N
    {
      s = wrap_add(s, get(t, j));
      j = j & (j - 1);
    }
    total = wrap_add(total, s);
    k = k + 1;
  }
  print(total);
  free(t);
  return 0;
}
