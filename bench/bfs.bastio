// Breadth-first search over a pseudo-random graph of 2^18 nodes with 8 edges
// each (compressed rows: an offsets array and an edge array), from 16 sources;
// the sum of the distances reached is the checksum.
const NODES: u64 = 262144;
const DEG: u64 = 8;
const EDGES: u64 = 2097152;

fn main() -> u64 {
  // Every node has DEG edges, so the offset of node v is v * DEG.
  let mut edge = alloc(EDGES);
  let mut x = 12345;
  let mut i = 0;
  while i < EDGES
    invariant i <= EDGES && len(edge) == EDGES && x < 4294967296
  {
    x = (x * 1103515245 + 12345) % 4294967296;
    edge = set(edge, i, x / 16 % NODES);
    i = i + 1;
  }
  let mut dist = alloc(NODES);
  let mut queue = alloc(NODES);
  let mut total = 0;
  let mut src = 0;
  while src < 16
    invariant src <= 16 && len(edge) == EDGES && len(dist) == NODES && len(queue) == NODES
  {
    let mut j = 0;
    while j < NODES
      invariant j <= NODES && len(dist) == NODES
    {
      dist = set(dist, j, 4294967295);
      j = j + 1;
    }
    let s = src * 16411 % NODES;
    dist = set(dist, s, 0);
    queue = set(queue, 0, s);
    let mut head = 0;
    let mut tail = 1;
    while head < tail
      invariant head <= tail && tail <= NODES && len(edge) == EDGES && len(dist) == NODES && len(queue) == NODES
    {
      let v = get(queue, head) % NODES;
      head = head + 1;
      let d = get(dist, v);
      let mut k = 0;
      while k < DEG
        invariant k <= DEG && tail <= NODES && head <= tail && len(edge) == EDGES && len(dist) == NODES && len(queue) == NODES
      {
        let w = get(edge, (v * DEG + k) % EDGES) % NODES;
        if get(dist, w) == 4294967295 && tail < NODES {
          dist = set(dist, w, wrap_add(d, 1));
          queue = set(queue, tail, w);
          tail = tail + 1;
        }
        k = k + 1;
      }
      total = wrap_add(total, d);
    }
    src = src + 1;
  }
  print(total);
  free(edge);
  free(dist);
  free(queue);
  return 0;
}
