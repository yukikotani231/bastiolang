// Decimal formatting of 4M numbers into a byte buffer, digit by digit with a
// division by ten, and a checksum over the bytes written: short loops with a
// data-dependent trip count and byte stores.
const BUF: u64 = 64;

fn fmt(out: &mut Bytes, n: u64) -> u64
  requires blen(out) == BUF
  ensures blen(out) == BUF && result <= 20
{
  let mut tmp = n;
  let mut len = 0;
  while tmp > 0 && len < 20
    invariant len <= 20
  {
    tmp = tmp / 10;
    len = len + 1;
  }
  if len == 0 {
    bset(&mut out, 0, 48);
    return 1;
  }
  let mut v = n;
  let mut k = len;
  while k > 0
    invariant k <= len && len <= 20 && blen(out) == BUF
  {
    k = k - 1;
    bset(&mut out, k, cast[u8](48 + v % 10));
    v = v / 10;
  }
  return len;
}

fn main() -> u64 {
  let mut out = balloc(BUF);
  let mut x = 12345;
  let mut sum = 0;
  let mut i = 0;
  while i < 4194304
    invariant i <= 4194304 && blen(out) == BUF
  {
    x = wrap_add(wrap_mul(x, 6364136223846793005), 1442695040888963407);
    let n = x / 1024 % 1000000007;
    let len = fmt(&mut out, n);
    let mut j = 0;
    while j < len
      invariant j <= len && len <= 20 && blen(out) == BUF
    {
      sum = wrap_add(sum, cast[u64](bget(out, j)));
      j = j + 1;
    }
    i = i + 1;
  }
  print(sum);
  bfree(out);
  return 0;
}
