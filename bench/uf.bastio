// Union-find with path halving over 2^20 elements: 2^21 pseudo-random unions,
// then a find for every element; the number of roots and the sum of the roots
// are the checksum.
const N: u64 = 1048576;

fn main() -> u64 {
  let mut p = alloc(N);
  let mut i = 0;
  while i < N
    invariant i <= N && len(p) == N
  {
    p = set(p, i, i);
    i = i + 1;
  }
  let mut x = 12345;
  let mut k = 0;
  while k < 2097152
    invariant k <= 2097152 && len(p) == N && x < 4294967296
  {
    x = (x * 1103515245 + 12345) % 4294967296;
    let mut ra = x / 16 % N;
    x = (x * 1103515245 + 12345) % 4294967296;
    let mut rb = x / 16 % N;
    while get(p, ra) % N != ra
      invariant len(p) == N && ra < N
    {
      let gg = get(p, get(p, ra) % N) % N;
      p = set(p, ra, gg);
      ra = gg;
    }
    while get(p, rb) % N != rb
      invariant len(p) == N && rb < N
    {
      let gg = get(p, get(p, rb) % N) % N;
      p = set(p, rb, gg);
      rb = gg;
    }
    if ra != rb {
      p = set(p, ra, rb);
    }
    k = k + 1;
  }
  let mut roots = 0;
  let mut sum = 0;
  let mut j = 0;
  while j < N
    invariant j <= N && len(p) == N
  {
    let mut r = j;
    while get(p, r) % N != r
      invariant len(p) == N && r < N
    {
      let gg = get(p, get(p, r) % N) % N;
      p = set(p, r, gg);
      r = gg;
    }
    if r == j {
      roots = wrap_add(roots, 1);
    }
    sum = wrap_add(sum, r);
    j = j + 1;
  }
  print(roots);
  print(sum);
  free(p);
  return 0;
}
