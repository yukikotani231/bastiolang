// Sieve of Eratosthenes over a Buf of 0/1 flags.
fn sieve(mut b: Buf) -> Buf
  requires len(b) <= 1073741824
  ensures len(result) == len(b)
{
  let n = len(b);
  let mut i = 2;
  while i * i < n
    invariant len(b) == n && i <= n + 2
  {
    if get(b, i) == 0 {
      let mut j = i * i;
      while j < n
        invariant len(b) == n && i * i < n && j < n + i
      {
        b = set(b, j, 1);
        j = j + i;
      }
    }
    i = i + 1;
  }
  return b;
}

fn count(b: &Buf) -> u64
  requires len(b) <= 1073741824
  ensures result <= len(b)
{
  let mut c = 0;
  let mut i = 2;
  while i < len(b)
    invariant c + 2 <= i && (i <= len(b) || c == 0)
  {
    if get(b, i) == 0 { c = c + 1; }
    i = i + 1;
  }
  return c;
}

fn main() -> u64 {
  let mut t = 0;
  let mut r = 0;
  while r < 5
    invariant r <= 5 && t <= r * 100000000
  {
    let b = sieve(alloc(100000000));
    t = t + count(b);
    free(b);
    r = r + 1;
  }
  print(t);
  return 0;
}
