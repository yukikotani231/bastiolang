// 400 x 400 matrix product over Bufs of u64, row-major, wrapping.
fn init(mut a: Buf, m: u64) -> Buf
  requires len(a) == 160000 && m < 1000
  ensures len(result) == 160000
{
  let mut i = 0;
  while i < 400
    invariant i <= 400 && len(a) == 160000
  {
    let mut j = 0;
    while j < 400
      invariant j <= 400 && i < 400 && len(a) == 160000
    {
      a = set(a, i * 400 + j, (i * m + j) % 10);
      j = j + 1;
    }
    i = i + 1;
  }
  return a;
}

fn mul(a: &Buf, b: &Buf, mut c: Buf) -> Buf
  requires len(a) == 160000 && len(b) == 160000 && len(c) == 160000
  ensures len(result) == 160000
{
  let mut i = 0;
  while i < 400
    invariant i <= 400 && len(c) == 160000
  {
    let mut j = 0;
    while j < 400
      invariant j <= 400 && i < 400 && len(c) == 160000
    {
      let mut s = 0;
      let mut k = 0;
      while k < 400
        invariant k <= 400 && i < 400 && j < 400
      {
        s = wrap_add(s, wrap_mul(get(a, i * 400 + k), get(b, k * 400 + j)));
        k = k + 1;
      }
      c = set(c, i * 400 + j, s);
      j = j + 1;
    }
    i = i + 1;
  }
  return c;
}

fn main() -> u64 {
  let a = init(alloc(160000), 3);
  let b = init(alloc(160000), 7);
  let mut c = alloc(160000);
  let mut t = 0;
  let mut r = 0;
  while r < 3
    invariant r <= 3 && len(a) == 160000 && len(b) == 160000 && len(c) == 160000
  {
    c = mul(a, b, c);
    t = wrap_add(t, get(c, 12345 + r));
    r = r + 1;
  }
  print(t);
  free(a);
  free(b);
  free(c);
  return 0;
}
