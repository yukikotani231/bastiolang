// 65536 particles, each a struct of position and velocity, in one Vec: 200
// steps move every particle and bounce it off the walls of a 2^20 box. The
// work is struct loads and stores through a Vec, with a compare per axis.
struct P { x: u64, y: u64, vx: u64, vy: u64 }

const N: u64 = 65536;
const BOX: u64 = 1048576;

fn step(ps: &mut Vec[P])
  requires vlen(ps) == N
  ensures vlen(ps) == N
{
  let mut i = 0;
  while i < vec_len(ps)
    invariant i <= N && vlen(ps) == N
  {
    let p = vec_get(ps, i);
    let mut x = wrap_add(p.x, p.vx);
    let mut vx = p.vx;
    if x >= BOX {
      x = wrap_sub(BOX - 1, x % BOX);
      vx = wrap_sub(0, vx);
    }
    let mut y = wrap_add(p.y, p.vy);
    let mut vy = p.vy;
    if y >= BOX {
      y = wrap_sub(BOX - 1, y % BOX);
      vy = wrap_sub(0, vy);
    }
    vec_set(&mut ps, i, P { x: x, y: y, vx: vx, vy: vy });
    i = i + 1;
  }
}

fn main() -> u64 {
  let mut ps = vec_new[P]();
  let mut s = 12345;
  let mut i = 0;
  while i < N
    invariant i <= N && vlen(ps) == i && s < 4294967296
  {
    s = (s * 1103515245 + 12345) % 4294967296;
    let a = s / 65536 % 4096;
    s = (s * 1103515245 + 12345) % 4294967296;
    let b = s / 65536 % 4096;
    vec_push(&mut ps, P { x: a * 256, y: b * 256, vx: a % 61 + 1, vy: b % 53 + 1 });
    i = i + 1;
  }
  let mut r = 0;
  while r < 200
    invariant r <= 200 && vlen(ps) == N
  {
    step(&mut ps);
    r = r + 1;
  }
  let mut t = 0;
  i = 0;
  while i < N
    invariant i <= N && vlen(ps) == N
  {
    let p = vec_get(ps, i);
    t = wrap_add(t, wrap_add(p.x, wrap_mul(p.y, 3)));
    i = i + 1;
  }
  print(t);
  vec_free(ps);
  return 0;
}
