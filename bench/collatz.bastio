// Collatz step counts for 1 to 2^20, a gcd by division and a bit-by-bit
// popcount for every number: branches on data, a division by a variable and
// shift loops. The sum of the three results is the checksum.
const N: u64 = 1048576;

fn steps(n: u64) -> u64
  requires n >= 1 && n <= N
{
  let mut x = n;
  let mut c = 0;
  while x != 1 && c < 1000
    invariant x >= 1 && x <= 1152921504606846976 && c <= 1000
  {
    if x % 2 == 0 {
      x = x / 2;
    } else if x <= 384307168202282325 {
      x = 3 * x + 1;
    } else {
      x = 1;
    }
    c = c + 1;
  }
  return c;
}

fn gcd(a: u64, b: u64) -> u64 {
  let mut x = a;
  let mut y = b;
  let mut k = 0;
  while y != 0 && k < 64
    invariant k <= 64
  {
    let t = x % y;
    x = y;
    y = t;
    k = k + 1;
  }
  return x;
}

fn pop(n: u64) -> u64 {
  let mut x = n;
  let mut c = 0;
  let mut k = 0;
  while k < 64
    invariant k <= 64 && c <= k
  {
    c = c + (x & 1);
    x = x >> 1;
    k = k + 1;
  }
  return c;
}

fn main() -> u64 {
  let mut t = 0;
  let mut i = 1;
  while i <= N
    invariant i >= 1 && i <= N + 1
  {
    t = wrap_add(t, steps(i));
    t = wrap_add(t, gcd(i, 1000003 % i + i));
    t = wrap_add(t, pop(i * 2654435761));
    i = i + 1;
  }
  print(t);
  return 0;
}
