// Longest common subsequence of two pseudo-random 4096-symbol strings with
// two rolling rows: a table walk with a compare, a max and three loads per cell.
fn main() -> u64 {
  let mut s = alloc(4096);
  let mut t = alloc(4096);
  let mut x = 12345;
  let mut i = 0;
  while i < 4096
    invariant i <= 4096 && len(s) == 4096 && len(t) == 4096 && x < 4294967296
  {
    x = (x * 1103515245 + 12345) % 4294967296;
    s = set(s, i, x / 65536 % 4);
    x = (x * 1103515245 + 12345) % 4294967296;
    t = set(t, i, x / 65536 % 4);
    i = i + 1;
  }
  let mut prev = alloc(4097);
  let mut cur = alloc(4097);
  i = 0;
  while i < 4096
    invariant i <= 4096 && len(s) == 4096 && len(t) == 4096 && len(prev) == 4097 && len(cur) == 4097
  {
    cur = set(cur, 0, 0);
    let a = get(s, i);
    let mut j = 0;
    while j < 4096
      invariant j <= 4096 && i < 4096 && len(t) == 4096 && len(prev) == 4097 && len(cur) == 4097
    {
      let mut v = 0;
      if a == get(t, j) {
        v = wrap_add(get(prev, j), 1);
      } else {
        let up = get(prev, j + 1);
        let left = get(cur, j);
        if up > left { v = up; } else { v = left; }
      }
      cur = set(cur, j + 1, v);
      j = j + 1;
    }
    let tmp = prev;
    prev = cur;
    cur = tmp;
    i = i + 1;
  }
  print(get(prev, 4096));
  free(s);
  free(t);
  free(prev);
  free(cur);
  return 0;
}
