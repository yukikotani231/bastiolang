// UTF-8 validation (examples/utf8) over 16 MiB of mixed text, 20 times,
// then one decode to UTF-32.
// The text is mostly ASCII with 2-, 3- and 4-byte sequences, drawn from a
// fixed pseudo-random sequence so utf8.c builds exactly the same bytes.
import "../examples/utf8/utf8.bastio";

const SIZE: u64 = 16777216;

fn text() -> Bytes
  ensures blen(result) == SIZE
{
  let mut b = balloc(SIZE);
  let mut x = 12345;
  let mut i = 0;
  while i + 4 <= SIZE
    invariant blen(b) == SIZE && i <= SIZE
  {
    x = wrap_add(wrap_mul(x, 6364136223846793005), 1442695040888963407);
    let r = x / 4294967296;
    let k = r % 16;
    if k < 13 {
      bset(&mut b, i, cast[u8](32 + r / 16 % 95));
      i = i + 1;
    } else if k == 13 {
      bset(&mut b, i, 195);
      bset(&mut b, i + 1, 169);
      i = i + 2;
    } else if k == 14 {
      bset(&mut b, i, 228);
      bset(&mut b, i + 1, 184);
      bset(&mut b, i + 2, 173);
      i = i + 3;
    } else {
      bset(&mut b, i, 240);
      bset(&mut b, i + 1, 159);
      bset(&mut b, i + 2, 152);
      bset(&mut b, i + 3, 128);
      i = i + 4;
    }
  }
  // The tail (fewer than 4 bytes) stays zero, which is ASCII NUL.
  return b;
}

fn main() -> u64 {
  let b = text();
  let mut total = 0;
  let mut round = 0;
  while round < 20
    invariant round <= 20 && total <= round * SIZE && blen(b) == SIZE
  {
    match utf8_validate(b) {
      Utf8::Valid(c) => { total = total + c; }
      Utf8::Invalid(at) => { total = total + 0; }
    }
    round = round + 1;
  }
  let mut out = balloc(4 * SIZE);
  match utf8_decode_into(b, &mut out) {
    Decoded32::Ok(c) => { total = total + c; }
    Decoded32::Invalid(at) => { total = total + 0; }
    Decoded32::TooSmall(need) => { total = total + 0; }
  }
  bfree(out);
  bfree(b);
  print(total);
  return 0;
}
