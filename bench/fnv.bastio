// FNV-1a over a 4 MiB byte buffer, 8 passes, plus a byte histogram.
fn main() -> u64 {
  let mut b = balloc(4194304);
  let mut x = 12345;
  let mut i = 0;
  while i < 4194304
    invariant i <= 4194304 && blen(b) == 4194304 && x < 4294967296
  {
    x = (x * 1103515245 + 12345) % 4294967296;
    bset(&mut b, i, cast[u8](x / 65536 % 256));
    i = i + 1;
  }
  let mut h = 14695981039346656037;
  let mut pass = 0;
  while pass < 8
    invariant pass <= 8 && blen(b) == 4194304
  {
    i = 0;
    while i < 4194304
      invariant i <= 4194304 && blen(b) == 4194304
    {
      h = wrap_mul(h ^ cast[u64](bget(b, i)), 1099511628211);
      i = i + 1;
    }
    pass = pass + 1;
  }
  print(h);
  bfree(b);
  return 0;
}
