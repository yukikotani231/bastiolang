// N-queens by bit masks: the number of placements on a 13 x 13 board, found by
// recursion over the free columns (lowest set bit first), with the diagonals
// carried as shifted masks.
const FULL: u64 = 8191;

fn solve(cols: u64, d1: u64, d2: u64) -> u64
  requires cols <= FULL && d1 <= FULL && d2 <= FULL
  ensures result <= 100000000
{
  if cols == FULL {
    return 1;
  }
  let mut avail = FULL - ((cols | d1 | d2) & FULL);
  let mut n = 0;
  let mut guard = 0;
  while avail != 0 && guard < 13
    invariant avail <= FULL && n <= 100000000 && guard <= 13
  {
    let bit = avail & wrap_sub(0, avail);
    if bit <= avail {
      avail = avail & wrap_sub(avail, 1);
      let c = solve((cols | bit) & FULL, ((d1 | bit) << 1) & FULL, ((d2 | bit) >> 1) & FULL);
      if n + c <= 100000000 {
        n = n + c;
      }
    } else {
      avail = 0;
    }
    guard = guard + 1;
  }
  return n;
}

fn main() -> u64 {
  print(solve(0, 0, 0));
  return 0;
}
