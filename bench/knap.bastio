// A 0/1 knapsack by dynamic programming: 5000 items of weight 1 to 200 and
// value 1 to 1000 into a bag of 20000, one row of the table updated in place
// from the top down.
const W: u64 = 20000;
const N: u64 = 5000;

fn main() -> u64 {
  let mut dp = vec_new[u64]();
  let mut i = 0;
  while i <= W
    invariant i <= W + 1 && vlen(dp) == i
  {
    vec_push(&mut dp, 0);
    i = i + 1;
  }
  let mut x = 12345;
  let mut it = 0;
  while it < N
    invariant it <= N && vlen(dp) == W + 1
  {
    x = wrap_add(wrap_mul(x, 6364136223846793005), 1442695040888963407);
    let wt = x / 4294967296 % 200 + 1;
    let val = x / 65536 % 1000 + 1;
    let mut w = W;
    while w >= wt
      invariant w <= W && wt >= 1 && wt <= 200 && vlen(dp) == W + 1
    {
      let a = vec_get(dp, w);
      let b = wrap_add(vec_get(dp, w - wt), val);
      if b > a {
        vec_set(&mut dp, w, b);
      }
      w = w - 1;
    }
    it = it + 1;
  }
  print(vec_get(dp, W));
  vec_free(dp);
  return 0;
}
