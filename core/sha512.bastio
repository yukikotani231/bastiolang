/// Internal: `x` rotated right by `n` bits, 1 to 63.
fn sha512_rotr(x: u64, n: u64) -> u64
  requires n >= 1 && n <= 63
{
  return (x >> n) | wrap_mul(x, 1 << (64 - n));
}

/// Internal: the eight state words after the 128-byte block at `at` of `m`.
fn sha512_block(h: &mut Vec[u64], k: &Vec[u64], w: &mut Vec[u64], m: &Bytes, at: u64)
  requires vlen(h) == 8 && vlen(k) == 80 && vlen(w) == 80 && at + 128 <= blen(m)
  ensures vlen(h) == 8 && vlen(w) == 80
{
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(w) == 80 && at + 128 <= blen(m)
  {
    vec_set(&mut w, i, load_be64(m, at + 8 * i));
    i = i + 1;
  }
  while i < 80
    invariant 16 <= i && i <= 80 && vlen(w) == 80
  {
    let w15 = vec_get(w, i - 15);
    let w2 = vec_get(w, i - 2);
    let s0 = sha512_rotr(w15, 1) ^ sha512_rotr(w15, 8) ^ (w15 >> 7);
    let s1 = sha512_rotr(w2, 19) ^ sha512_rotr(w2, 61) ^ (w2 >> 6);
    vec_set(&mut w, i, wrap_add(wrap_add(vec_get(w, i - 16), s0), wrap_add(vec_get(w, i - 7), s1)));
    i = i + 1;
  }
  let mut a = vec_get(h, 0);
  let mut b = vec_get(h, 1);
  let mut c = vec_get(h, 2);
  let mut d = vec_get(h, 3);
  let mut e = vec_get(h, 4);
  let mut f = vec_get(h, 5);
  let mut g = vec_get(h, 6);
  let mut hh = vec_get(h, 7);
  let mut r = 0;
  while r < 80
    invariant r <= 80 && vlen(w) == 80 && vlen(k) == 80
  {
    let big1 = sha512_rotr(e, 14) ^ sha512_rotr(e, 18) ^ sha512_rotr(e, 41);
    let ch = (e & f) ^ ((e ^ 18446744073709551615) & g);
    let t1 = wrap_add(wrap_add(wrap_add(hh, big1), wrap_add(ch, vec_get(k, r))), vec_get(w, r));
    let big0 = sha512_rotr(a, 28) ^ sha512_rotr(a, 34) ^ sha512_rotr(a, 39);
    let maj = (a & b) ^ (a & c) ^ (b & c);
    let t2 = wrap_add(big0, maj);
    hh = g;
    g = f;
    f = e;
    e = wrap_add(d, t1);
    d = c;
    c = b;
    b = a;
    a = wrap_add(t1, t2);
    r = r + 1;
  }
  vec_set(&mut h, 0, wrap_add(vec_get(h, 0), a));
  vec_set(&mut h, 1, wrap_add(vec_get(h, 1), b));
  vec_set(&mut h, 2, wrap_add(vec_get(h, 2), c));
  vec_set(&mut h, 3, wrap_add(vec_get(h, 3), d));
  vec_set(&mut h, 4, wrap_add(vec_get(h, 4), e));
  vec_set(&mut h, 5, wrap_add(vec_get(h, 5), f));
  vec_set(&mut h, 6, wrap_add(vec_get(h, 6), g));
  vec_set(&mut h, 7, wrap_add(vec_get(h, 7), hh));
}

/// The SHA-512 digest of `m`: 64 bytes.
/// ```
/// let m = bfrom("abc");
/// let d = sha512(m);
/// let first = bget(d, 0);          // dd af 35 a1 ... a5 4c
/// let last = bget(d, 63);
/// let n = blen(d);
/// bfree(d);
/// bfree(m);
/// if n != 64 || first != 221 || last != 159 { return 1; }
/// ```
fn sha512(m: &Bytes) -> Bytes
  ensures blen(result) == 64
{
  let n = blen(m);
  let k = sha512_k();
  let mut w = vec_new[u64]();
  let mut h = vec_new[u64]();
  let mut i = 0;
  while i < 80
    invariant i <= 80 && vlen(w) == i
  {
    vec_push(&mut w, 0);
    i = i + 1;
  }
  vec_push(&mut h, 7640891576956012808);
  vec_push(&mut h, 13503953896175478587);
  vec_push(&mut h, 4354685564936845355);
  vec_push(&mut h, 11912009170470909681);
  vec_push(&mut h, 5840696475078001361);
  vec_push(&mut h, 11170449401992604703);
  vec_push(&mut h, 2270897969802886507);
  vec_push(&mut h, 6620516959819538809);
  // The whole blocks straight from the message.
  let whole = n / 128 * 128;
  let mut at = 0;
  while at < whole
    invariant at <= whole && whole <= n && n == blen(m) && at % 128 == 0 && vlen(h) == 8 && vlen(k) == 80 && vlen(w) == 80
  {
    sha512_block(&mut h, k, &mut w, m, at);
    at = at + 128;
  }
  // The rest, a 1 bit, zeros and the length in bits (mod 2^64; the upper 64
  // bits of the 128-bit field stay zero) in one or two more blocks.
  let rem = n - whole;
  let mut tail = balloc(256);
  bytes_copy_span(&mut tail, 0, m, whole, n);
  bset(&mut tail, rem, 128);
  let mut tlen = 128;
  if rem >= 112 {
    tlen = 256;
  }
  store_be64(&mut tail, tlen - 8, wrap_mul(n, 8));
  sha512_block(&mut h, k, &mut w, tail, 0);
  if tlen == 256 {
    sha512_block(&mut h, k, &mut w, tail, 128);
  }
  let mut out = balloc(64);
  let mut j = 0;
  while j < 8
    invariant j <= 8 && vlen(h) == 8 && blen(out) == 64
  {
    store_be64(&mut out, 8 * j, vec_get(h, j));
    j = j + 1;
  }
  bfree(tail);
  vec_free(k);
  vec_free(w);
  vec_free(h);
  return out;
}
