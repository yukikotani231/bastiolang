// core/sha512.bastio: SHA-512 (FIPS 180-4).
//
// What is proved: every access is in bounds, nothing leaks, and a digest is
// 64 bytes. Not proved: that the digest is SHA-512's (the tests check the
// FIPS 180-4 vectors, the block-boundary lengths 111, 112, 127, 128 and 129,
// and a million `a`s), or that the code takes the same time for
// every input (it does not branch on its data, but nothing checks that).
import "bytes.bastio";
import "endian.bastio";
import "text.bastio";

/// Internal: the round constants.
fn sha512_k() -> Vec[u64]
  ensures vlen(result) == 80
{
  let mut k = vec_new[u64]();
  vec_push(&mut k, 4794697086780616226);
  vec_push(&mut k, 8158064640168781261);
  vec_push(&mut k, 13096744586834688815);
  vec_push(&mut k, 16840607885511220156);
  vec_push(&mut k, 4131703408338449720);
  vec_push(&mut k, 6480981068601479193);
  vec_push(&mut k, 10538285296894168987);
  vec_push(&mut k, 12329834152419229976);
  vec_push(&mut k, 15566598209576043074);
  vec_push(&mut k, 1334009975649890238);
  vec_push(&mut k, 2608012711638119052);
  vec_push(&mut k, 6128411473006802146);
  vec_push(&mut k, 8268148722764581231);
  vec_push(&mut k, 9286055187155687089);
  vec_push(&mut k, 11230858885718282805);
  vec_push(&mut k, 13951009754708518548);
  vec_push(&mut k, 16472876342353939154);
  vec_push(&mut k, 17275323862435702243);
  vec_push(&mut k, 1135362057144423861);
  vec_push(&mut k, 2597628984639134821);
  vec_push(&mut k, 3308224258029322869);
  vec_push(&mut k, 5365058923640841347);
  vec_push(&mut k, 6679025012923562964);
  vec_push(&mut k, 8573033837759648693);
  vec_push(&mut k, 10970295158949994411);
  vec_push(&mut k, 12119686244451234320);
  vec_push(&mut k, 12683024718118986047);
  vec_push(&mut k, 13788192230050041572);
  vec_push(&mut k, 14330467153632333762);
  vec_push(&mut k, 15395433587784984357);
  vec_push(&mut k, 489312712824947311);
  vec_push(&mut k, 1452737877330783856);
  vec_push(&mut k, 2861767655752347644);
  vec_push(&mut k, 3322285676063803686);
  vec_push(&mut k, 5560940570517711597);
  vec_push(&mut k, 5996557281743188959);
  vec_push(&mut k, 7280758554555802590);
  vec_push(&mut k, 8532644243296465576);
  vec_push(&mut k, 9350256976987008742);
  vec_push(&mut k, 10552545826968843579);
  vec_push(&mut k, 11727347734174303076);
  vec_push(&mut k, 12113106623233404929);
  vec_push(&mut k, 14000437183269869457);
  vec_push(&mut k, 14369950271660146224);
  vec_push(&mut k, 15101387698204529176);
  vec_push(&mut k, 15463397548674623760);
  vec_push(&mut k, 17586052441742319658);
  vec_push(&mut k, 1182934255886127544);
  vec_push(&mut k, 1847814050463011016);
  vec_push(&mut k, 2177327727835720531);
  vec_push(&mut k, 2830643537854262169);
  vec_push(&mut k, 3796741975233480872);
  vec_push(&mut k, 4115178125766777443);
  vec_push(&mut k, 5681478168544905931);
  vec_push(&mut k, 6601373596472566643);
  vec_push(&mut k, 7507060721942968483);
  vec_push(&mut k, 8399075790359081724);
  vec_push(&mut k, 8693463985226723168);
  vec_push(&mut k, 9568029438360202098);
  vec_push(&mut k, 10144078919501101548);
  vec_push(&mut k, 10430055236837252648);
  vec_push(&mut k, 11840083180663258601);
  vec_push(&mut k, 13761210420658862357);
  vec_push(&mut k, 14299343276471374635);
  vec_push(&mut k, 14566680578165727644);
  vec_push(&mut k, 15097957966210449927);
  vec_push(&mut k, 16922976911328602910);
  vec_push(&mut k, 17689382322260857208);
  vec_push(&mut k, 500013540394364858);
  vec_push(&mut k, 748580250866718886);
