// core/hashmap.bastio: a hash map from `u64` keys to `u64` values.
//
// Open addressing with linear probing and tombstones. To map keys to
// linear values (buffers, structs owning pages), keep the values in a
// `Vec[T]` and map each key to its index: the map itself holds only plain
// numbers, so it can be read through a shared borrow and freed at any time.
//
// What is proved: every index is in bounds, no counter overflows, a slot
// that a lookup returns holds the key asked for, and after `hmap_insert`
// the map holds the key with the new value. Not proved: that a lookup finds
// every key present (that needs an invariant about runs of probed slots)
// and that `len` counts the keys (the prover cannot count; see
// docs/core.md, "Gaps").
import "option.bastio";

struct HashMap {
  keys: Vec[u64],
  vals: Vec[u64],
  tags: Vec[u8],   // 0 empty, 1 removed (a tombstone), 2 holds a key
  len: u64,        // slots holding a key
  used: u64,       // slots holding a key or a tombstone
}

/// What every map function needs and keeps: the vectors have one length,
/// the capacity is in range, and some slot is still empty. A loop that
/// changes a map carries `invariant hmap_ok(m)`.
spec fn hmap_ok(m: &HashMap) -> bool {
  vlen(m.tags) == vlen(m.keys) && vlen(m.vals) == vlen(m.keys)
    && 8 <= vlen(m.keys) && vlen(m.keys) <= 1152921504606846976
    && m.len <= m.used && m.used < vlen(m.keys)
}

/// The map holds key `k` with value `v`.
spec fn hmap_maps(m: &HashMap, k: u64, v: u64) -> bool {
  !(forall i: u64 :: i < vlen(m.keys) ==>
      !(vget(m.tags, i) == 2 && vget(m.keys, i) == k && vget(m.vals, i) == v))
}

/// The map holds key `k`.
spec fn hmap_has(m: &HashMap, k: u64) -> bool {
  !(forall i: u64 :: i < vlen(m.keys) ==> !(vget(m.tags, i) == 2 && vget(m.keys, i) == k))
}

/// A 64-bit mixing function (the finalizer of MurmurHash3), so that keys
/// that differ only in high bits still spread over the table.
fn hash_u64(k: u64) -> u64 {
  let a = wrap_mul(k ^ (k >> 33), 0xff51afd7ed558ccd);
  let b = wrap_mul(a ^ (a >> 33), 0xc4ceb9fe1a85ec53);
  return b ^ (b >> 33);
}

/// An empty map with room for `cap` slots (at least 8).
fn hmap_with_cap(cap: u64) -> HashMap
  requires 8 <= cap && cap <= 1152921504606846976
  ensures hmap_ok(result) && result.len == 0 && vlen(result.keys) == cap
{
  let mut keys = vec_new[u64]();
  let mut vals = vec_new[u64]();
  let mut tags = vec_new[u8]();
  let mut i = 0;
  while i < cap
    invariant i <= cap && vlen(keys) == i && vlen(vals) == i && vlen(tags) == i
  {
    vec_push(&mut keys, 0);
    vec_push(&mut vals, 0);
    vec_push(&mut tags, 0);
    i = i + 1;
  }
  return HashMap { keys: keys, vals: vals, tags: tags, len: 0, used: 0 };
}

fn hmap_new() -> HashMap
  ensures hmap_ok(result) && result.len == 0
{
  return hmap_with_cap(8);
}

/// The number of keys in the map.
fn hmap_len(m: &HashMap) -> u64
  ensures result == m.len
{
  return m.len;
}

/// The slot holding `k`, or the capacity if `k` is not in the map.
fn hmap_find(m: &HashMap, k: u64) -> u64
  requires hmap_ok(m)
  ensures result <= vlen(m.keys)
  ensures result < vlen(m.keys) ==> vget(m.tags, result) == 2 && vget(m.keys, result) == k
{
  let cap = vec_len(m.keys);
  let start = hash_u64(k) % cap;
  let mut n = 0;
  while n < cap
    invariant n <= cap
  {
    let i = (start + n) % cap;
    let t = vec_get(m.tags, i);
    if t == 0 {
      return cap;
    }
    if t == 2 && vec_get(m.keys, i) == k {
      return i;
    }
    n = n + 1;
  }
  return cap;
}

/// `k` is in the map.
fn hmap_contains(m: &HashMap, k: u64) -> bool
  requires hmap_ok(m)
  ensures result ==> hmap_has(m, k)
{
  return hmap_find(m, k) < vec_len(m.keys);
}

/// The value of `k`.
fn hmap_get(m: &HashMap, k: u64) -> Option[u64]
  requires hmap_ok(m)
  ensures result is Option::Some ==> hmap_maps(m, k, result.Some)
{
  let i = hmap_find(m, k);
  if i < vec_len(m.keys) {
    return Option[u64]::Some(vec_get(m.vals, i));
  }
  return Option[u64]::None;
}

/// The value of `k`, or `d` if `k` is not in the map.
fn hmap_get_or(m: &HashMap, k: u64, d: u64) -> u64
  requires hmap_ok(m)
  ensures result == d || hmap_maps(m, k, result)
{
  let i = hmap_find(m, k);
  if i < vec_len(m.keys) {
    return vec_get(m.vals, i);
  }
  return d;
}

/// Rebuilds the table without tombstones, doubling it when at least half
/// of it holds keys.
fn hmap_grow(m: &mut HashMap)
  requires hmap_ok(m)
  ensures hmap_ok(m)
{
  let old_cap = vec_len(m.keys);
  let mut cap = old_cap;
  if m.len * 2 >= old_cap && old_cap <= 576460752303423488 {
    cap = old_cap * 2;
  }
  let mut fresh = hmap_with_cap(cap);
  let mut i = 0;
  while i < old_cap
    invariant i <= old_cap && hmap_ok(fresh)
    invariant vlen(m.keys) == old_cap && vlen(m.vals) == old_cap && vlen(m.tags) == old_cap
  {
    if vec_get(m.tags, i) == 2 {
      hmap_put_new(&mut fresh, vec_get(m.keys, i), vec_get(m.vals, i));
    }
    i = i + 1;
  }
  vec_free(m.keys);
  vec_free(m.vals);
  vec_free(m.tags);
  m.keys = fresh.keys;
  m.vals = fresh.vals;
  m.tags = fresh.tags;
  m.len = fresh.len;
  m.used = fresh.used;
}

/// Puts `k`, known not to be in the map, into the first empty slot of its
/// probe sequence, growing the table first if it is three quarters used.
fn hmap_put_new(m: &mut HashMap, k: u64, v: u64)
  requires hmap_ok(m)
  ensures hmap_ok(m) && hmap_maps(m, k, v)
{
  let cap = vec_len(m.keys);
  if (m.used + 1) * 4 > cap * 3 {
    hmap_grow(&mut m);
    hmap_put_new(&mut m, k, v);
    return;
  }
  let start = hash_u64(k) % cap;
  let mut n = 0;
  while n < cap
    invariant n <= cap && hmap_ok(m) && vlen(m.keys) == cap
    invariant (m.used + 1) * 4 <= cap * 3
  {
    let i = (start + n) % cap;
    if vec_get(m.tags, i) == 0 {
      vec_set(&mut m.tags, i, 2);
      vec_set(&mut m.keys, i, k);
      vec_set(&mut m.vals, i, v);
      m.used = m.used + 1;
      m.len = m.len + 1;
      return;
    }
    n = n + 1;
  }
  // Not reached: `used < cap` leaves an empty slot, but the prover cannot
  // count slots, so a table found full is grown instead.
  hmap_grow(&mut m);
  hmap_put_new(&mut m, k, v);
}

/// Sets the value of `k` to `v`. Returns the value it replaces, if `k` was
/// already in the map.
fn hmap_insert(m: &mut HashMap, k: u64, v: u64) -> Option[u64]
  requires hmap_ok(m)
  ensures hmap_ok(m) && hmap_maps(m, k, v)
{
  let i = hmap_find(m, k);
  if i < vec_len(m.keys) {
    let prev = vec_get(m.vals, i);
    vec_set(&mut m.vals, i, v);
    return Option[u64]::Some(prev);
  }
  hmap_put_new(&mut m, k, v);
  return Option[u64]::None;
}

/// Takes `k` out of the map. Returns its value, if it was there.
fn hmap_remove(m: &mut HashMap, k: u64) -> Option[u64]
  requires hmap_ok(m)
  ensures hmap_ok(m)
{
  let i = hmap_find(m, k);
  if i < vec_len(m.keys) {
    vec_set(&mut m.tags, i, 1);
    if m.len > 0 {
      // Always true while the counters are right. The prover cannot count
      // keys, so this decrement is guarded instead of proved.
      m.len = m.len - 1;
    }
    return Option[u64]::Some(vec_get(m.vals, i));
  }
  return Option[u64]::None;
}

/// The keys in the map, in slot order.
fn hmap_keys(m: &HashMap) -> Vec[u64]
  requires hmap_ok(m)
  ensures forall j: u64 :: j < vlen(result) ==> hmap_has(m, vget(result, j))
{
  let mut out = vec_new[u64]();
  let mut i = 0;
  while i < vec_len(m.keys)
    invariant i <= vlen(m.keys)
    invariant forall j: u64 :: j < vlen(out) ==> hmap_has(m, vget(out, j))
  {
    if vec_get(m.tags, i) == 2 {
      vec_push(&mut out, vec_get(m.keys, i));
    }
    i = i + 1;
  }
  return out;
}

fn hmap_free(m: HashMap) {
  vec_free(m.keys);
  vec_free(m.vals);
  vec_free(m.tags);
}
