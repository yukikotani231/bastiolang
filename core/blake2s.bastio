/// Internal: the initial state, SHA-256's.
fn blake2s_iv() -> Vec[u32]
  ensures vlen(result) == 8
{
  let mut h = vec_new[u32]();
  vec_push(&mut h, 1779033703);
  vec_push(&mut h, 3144134277);
  vec_push(&mut h, 1013904242);
  vec_push(&mut h, 2773480762);
  vec_push(&mut h, 1359893119);
  vec_push(&mut h, 2600822924);
  vec_push(&mut h, 528734635);
  vec_push(&mut h, 1541459225);
  return h;
}

/// Internal: `x` rotated right by `n` bits, 1 to 31.
fn blake2s_rotr(x: u32, n: u64) -> u32
  requires n >= 1 && n <= 31
{
  return (x >> n) | wrap[u32](cast[u64](x) << (32 - n));
}

/// Internal: the mixing function G on words a, b, c, d of v.
fn blake2s_g(v: &mut Vec[u32], a: u64, b: u64, c: u64, d: u64, x: u32, y: u32)
  requires vlen(v) == 16 && a < 16 && b < 16 && c < 16 && d < 16
  ensures vlen(v) == 16
{
  vec_set(&mut v, a, wrap_add(wrap_add(vec_get(v, a), vec_get(v, b)), x));
  vec_set(&mut v, d, blake2s_rotr(vec_get(v, d) ^ vec_get(v, a), 16));
  vec_set(&mut v, c, wrap_add(vec_get(v, c), vec_get(v, d)));
  vec_set(&mut v, b, blake2s_rotr(vec_get(v, b) ^ vec_get(v, c), 12));
  vec_set(&mut v, a, wrap_add(wrap_add(vec_get(v, a), vec_get(v, b)), y));
  vec_set(&mut v, d, blake2s_rotr(vec_get(v, d) ^ vec_get(v, a), 8));
  vec_set(&mut v, c, wrap_add(vec_get(v, c), vec_get(v, d)));
  vec_set(&mut v, b, blake2s_rotr(vec_get(v, b) ^ vec_get(v, c), 7));
}

/// Internal: the state after the 64-byte block at `at` of `m`; `t` bytes
/// have been hashed once it is counted, and `last` marks the final block.
fn blake2s_block(h: &mut Vec[u32], iv: &Vec[u32], sigma: &Vec[u32], m: &Bytes, at: u64, t: u64, last: bool)
  requires vlen(h) == 8 && vlen(iv) == 8 && vlen(sigma) == 160 && at + 64 <= blen(m)
  ensures vlen(h) == 8
{
  let mut mw = vec_new[u32]();
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(mw) == i && at + 64 <= blen(m)
  {
    vec_push(&mut mw, load_le32(m, at + 4 * i));
    i = i + 1;
  }
  let mut v = vec_new[u32]();
  i = 0;
  while i < 8
    invariant i <= 8 && vlen(v) == i && vlen(h) == 8 && vlen(iv) == 8
  {
    vec_push(&mut v, vec_get(h, i));
    i = i + 1;
  }
  i = 0;
  while i < 8
    invariant i <= 8 && vlen(v) == 8 + i && vlen(iv) == 8
  {
    vec_push(&mut v, vec_get(iv, i));
    i = i + 1;
  }
  vec_set(&mut v, 12, vec_get(v, 12) ^ wrap[u32](t));
  vec_set(&mut v, 13, vec_get(v, 13) ^ wrap[u32](t >> 32));
  if last {
    vec_set(&mut v, 14, vec_get(v, 14) ^ 4294967295);
  }
  let mut r = 0;
  while r < 10
    invariant r <= 10 && vlen(v) == 16 && vlen(mw) == 16 && vlen(sigma) == 160
  {
    let s = r * 16;
    // The index of a message word is a sigma entry: below 16 by construction,
    // which the compiler cannot see, so it is clamped.
    blake2s_g(&mut v, 0, 4, 8, 12, vec_get(mw, cast[u64](vec_get(sigma, s)) % 16), vec_get(mw, cast[u64](vec_get(sigma, s + 1)) % 16));
    blake2s_g(&mut v, 1, 5, 9, 13, vec_get(mw, cast[u64](vec_get(sigma, s + 2)) % 16), vec_get(mw, cast[u64](vec_get(sigma, s + 3)) % 16));
    blake2s_g(&mut v, 2, 6, 10, 14, vec_get(mw, cast[u64](vec_get(sigma, s + 4)) % 16), vec_get(mw, cast[u64](vec_get(sigma, s + 5)) % 16));
    blake2s_g(&mut v, 3, 7, 11, 15, vec_get(mw, cast[u64](vec_get(sigma, s + 6)) % 16), vec_get(mw, cast[u64](vec_get(sigma, s + 7)) % 16));
    blake2s_g(&mut v, 0, 5, 10, 15, vec_get(mw, cast[u64](vec_get(sigma, s + 8)) % 16), vec_get(mw, cast[u64](vec_get(sigma, s + 9)) % 16));
    blake2s_g(&mut v, 1, 6, 11, 12, vec_get(mw, cast[u64](vec_get(sigma, s + 10)) % 16), vec_get(mw, cast[u64](vec_get(sigma, s + 11)) % 16));
    blake2s_g(&mut v, 2, 7, 8, 13, vec_get(mw, cast[u64](vec_get(sigma, s + 12)) % 16), vec_get(mw, cast[u64](vec_get(sigma, s + 13)) % 16));
    blake2s_g(&mut v, 3, 4, 9, 14, vec_get(mw, cast[u64](vec_get(sigma, s + 14)) % 16), vec_get(mw, cast[u64](vec_get(sigma, s + 15)) % 16));
    r = r + 1;
  }
  i = 0;
  while i < 8
    invariant i <= 8 && vlen(v) == 16 && vlen(h) == 8
  {
    vec_set(&mut h, i, vec_get(h, i) ^ vec_get(v, i) ^ vec_get(v, i + 8));
    i = i + 1;
  }
  vec_free(mw);
  vec_free(v);
}

/// The BLAKE2s digest of `m` under `key` (empty for none, at most 32 bytes),
/// `outlen` bytes long (1 to 32). A key or length out of range gives a
/// 32-byte digest of nothing: callers check first.
/// ```
/// let m = bfrom("abc");
/// let k = balloc(0);
/// let d = blake2s(m, k, 32);
/// let first = bget(d, 0);          // 50 8c 5e 8c ... 82
/// let last = bget(d, 31);
/// bfree(d);
/// bfree(k);
/// bfree(m);
/// if first != 80 || last != 130 { return 1; }
/// ```
fn blake2s(m: &Bytes, key: &Bytes, outlen: u64) -> Bytes
  requires outlen >= 1 && outlen <= 32 && blen(key) <= 32 && blen(m) <= 576460752303423488
  ensures blen(result) == outlen
{
  let iv = blake2s_iv();
  let sigma = blake2s_sigma();
  let mut h = blake2s_iv();
  vec_set(&mut h, 0, vec_get(h, 0) ^ 16842752 ^ wrap[u32](blen(key) << 8) ^ wrap[u32](outlen));
  let kl = blen(key);
  let n = blen(m);
  // The input as one buffer: the key padded to a block, then the message,
  // padded with zeros to a whole block (at least one block, even if empty).
  let mut klen = 0;
  if kl > 0 {
    klen = 64;
  }
  let total = klen + n;
  let mut padded = (total + 63) / 64 * 64;
  if padded == 0 {
    padded = 64;
  }
  let mut buf = balloc(padded);
  if kl > 0 {
    bytes_copy_into(&mut buf, 0, key);
  }
  bytes_copy_into(&mut buf, klen, m);
  let mut at = 0;
  while at + 64 < padded
    invariant at + 64 <= padded && at % 64 == 0 && padded % 64 == 0 && padded == blen(buf) && vlen(h) == 8 && vlen(iv) == 8 && vlen(sigma) == 160
  {
    blake2s_block(&mut h, iv, sigma, buf, at, at + 64, false);
    at = at + 64;
  }
  blake2s_block(&mut h, iv, sigma, buf, at, total, true);
  let mut full = balloc(32);
  let mut j = 0;
  while j < 8
    invariant j <= 8 && vlen(h) == 8 && blen(full) == 32
  {
    store_le32(&mut full, 4 * j, vec_get(h, j));
    j = j + 1;
  }
  let mut out = balloc(outlen);
  bytes_copy_span(&mut out, 0, full, 0, outlen);
  bfree(full);
  bfree(buf);
  vec_free(h);
  vec_free(iv);
  vec_free(sigma);
  return out;
}

/// HMAC-BLAKE2s-256 of `msg` under `key` (any length): 32 bytes. WireGuard's
/// key derivation is built on this (block size 64).
/// ```
/// let key = bfrom("key");
/// let msg = bfrom("msg");
/// let mac = hmac_blake2s(key, msg);
/// let n = blen(mac);
/// bfree(mac);
/// bfree(key);
/// bfree(msg);
/// if n != 32 { return 1; }
/// ```
fn hmac_blake2s(key: &Bytes, msg: &Bytes) -> Bytes
  requires blen(msg) <= 288230376151711744 && blen(key) <= 288230376151711744
  ensures blen(result) == 32
{
  let none = balloc(0);
  let mut k0 = balloc(64);
  if blen(key) > 64 {
    let hk = blake2s(key, none, 32);
    bytes_copy_into(&mut k0, 0, hk);
    bfree(hk);
  } else {
    bytes_copy_into(&mut k0, 0, key);
  }
  let mut inner = text_new();
  let mut outer = text_new();
  let mut i = 0;
  while i < 64
    invariant i <= 64 && blen(k0) == 64 && vlen(inner) == i && vlen(outer) == i
  {
    text_push(&mut inner, bget(k0, i) ^ 54);
    text_push(&mut outer, bget(k0, i) ^ 92);
    i = i + 1;
  }
  text_push_bytes(&mut inner, msg);
  let ib = text_finish(inner);
  let ih = blake2s(ib, none, 32);
  text_push_bytes(&mut outer, ih);
  let ob = text_finish(outer);
  let r = blake2s(ob, none, 32);
  bfree(k0);
  bfree(ib);
  bfree(ih);
  bfree(ob);
  bfree(none);
  return r;
}
