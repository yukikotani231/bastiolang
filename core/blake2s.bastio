  vec_push(&mut s, 15);
  vec_push(&mut s, 14);
  vec_push(&mut s, 10);
  vec_push(&mut s, 4);
  vec_push(&mut s, 8);
  vec_push(&mut s, 9);
  vec_push(&mut s, 15);
  vec_push(&mut s, 13);
  vec_push(&mut s, 6);
  vec_push(&mut s, 1);
  vec_push(&mut s, 12);
  vec_push(&mut s, 0);
  vec_push(&mut s, 2);
  vec_push(&mut s, 11);
  vec_push(&mut s, 7);
  vec_push(&mut s, 5);
  vec_push(&mut s, 3);
  vec_push(&mut s, 11);
  vec_push(&mut s, 8);
  vec_push(&mut s, 12);
  vec_push(&mut s, 0);
  vec_push(&mut s, 5);
