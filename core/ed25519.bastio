// core/ed25519.bastio: Ed25519 key derivation, signing (RFC 8032 sections
// 5.1.5 and 5.1.6) and signature verification (section
// 5.1.7), on the field arithmetic of core/x25519.bastio and the hash of
// core/sha512.bastio.
//
// What is proved: every access is in bounds, nothing leaks, and the
// functions return what their types say. Not proved: that `ed25519_verify`
// accepts exactly the signatures RFC 8032 accepts (the tests check the
// RFC's vectors, signatures made by another implementation, and every
// single-bit change of a signature, a message and a key being refused).
// Verification works on public data only, so nothing there is constant time.
// Signing and `ed25519_public` handle a secret and are not constant time
// either (the point multiplication and the scalar arithmetic branch and index
// on the secret): do not use them where a local attacker can time them.
//
// A point is a `Vec[u64]` of 64 limbs: the extended coordinates X, Y, Z and
// T, 16 limbs each, with x = X/Z, y = Y/Z and x * y = T/Z.
import "x25519.bastio";
import "sha512.bastio";
import "bytes.bastio";

/// Internal: the nibble of the hex digit `c`.
fn ed_nib(c: u8) -> u8
  ensures result < 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 0;
}

/// Internal: the field element whose 32 little-endian bytes are the 64 hex
/// digits of `s`.
fn ed_const(s: Str) -> Vec[u64]
  requires slen(s) == 64
  ensures vlen(result) == 16
{
  let mut b = balloc(32);
  let mut i = 0;
  while i < 32
    invariant i <= 32 && blen(b) == 32 && slen(s) == 64
  {
    bset(&mut b, i, ed_nib(sget(s, 2 * i)) * 16 + ed_nib(sget(s, 2 * i + 1)));
    i = i + 1;
  }
  let f = fe_unpack(b);
  bfree(b);
  return f;
}

/// Internal: limbs `16 * k..16 * k + 16` of `p` (a coordinate), copied.
fn ed_get(p: &Vec[u64], k: u64) -> Vec[u64]
  requires vlen(p) == 64 && k < 4
  ensures vlen(result) == 16
{
  let mut r = fe_zero();
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(r) == 16 && vlen(p) == 64 && k < 4
  {
    vec_set(&mut r, i, vec_get(p, 16 * k + i));
    i = i + 1;
  }
  return r;
}

/// Internal: the point with the coordinates `x`, `y`, `z` and `t`.
fn ed_make(x: &Vec[u64], y: &Vec[u64], z: &Vec[u64], t: &Vec[u64]) -> Vec[u64]
  requires vlen(x) == 16 && vlen(y) == 16 && vlen(z) == 16 && vlen(t) == 16
  ensures vlen(result) == 64
{
  let mut r = vec_new[u64]();
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(r) == i && vlen(x) == 16
  {
    vec_push(&mut r, vec_get(x, i));
    i = i + 1;
  }
  i = 0;
  while i < 16
    invariant i <= 16 && vlen(r) == 16 + i && vlen(y) == 16
  {
    vec_push(&mut r, vec_get(y, i));
    i = i + 1;
  }
  i = 0;
  while i < 16
    invariant i <= 16 && vlen(r) == 32 + i && vlen(z) == 16
  {
    vec_push(&mut r, vec_get(z, i));
    i = i + 1;
  }
  i = 0;
  while i < 16
    invariant i <= 16 && vlen(r) == 48 + i && vlen(t) == 16
  {
    vec_push(&mut r, vec_get(t, i));
    i = i + 1;
  }
  return r;
}

/// Internal: the neutral point (0, 1).
fn ed_identity() -> Vec[u64]
  ensures vlen(result) == 64
{
  let x = fe_zero();
  let mut y = fe_zero();
  vec_set(&mut y, 0, 1);
  let z = fe_copy(y);
  let t = fe_zero();
  let r = ed_make(x, y, z, t);
  vec_free(x);
  vec_free(y);
  vec_free(z);
  vec_free(t);
  return r;
}

/// Internal: the sum of the points `p` and `q` (the complete addition law of
/// the twisted Edwards curve, which also doubles).
fn ed_add(p: &Vec[u64], q: &Vec[u64]) -> Vec[u64]
  requires vlen(p) == 64 && vlen(q) == 64
  ensures vlen(result) == 64
{
  let x1 = ed_get(p, 0);
  let y1 = ed_get(p, 1);
  let z1 = ed_get(p, 2);
  let t1 = ed_get(p, 3);
  let x2 = ed_get(q, 0);
  let y2 = ed_get(q, 1);
  let z2 = ed_get(q, 2);
  let t2 = ed_get(q, 3);
  let d2 = ed_const("59f1b226949bd6eb56b183829a14e00030d1f3eef2808e19e7fcdf56dcd90624");
  let ym1 = fe_sub(y1, x1);
  let ym2 = fe_sub(y2, x2);
  let yp1 = fe_add(y1, x1);
  let yp2 = fe_add(y2, x2);
  let a = fe_mul(ym1, ym2);
  let b = fe_mul(yp1, yp2);
  let t12 = fe_mul(t1, t2);
  let c = fe_mul(t12, d2);
  let zz = fe_mul(z1, z2);
  let d = fe_add(zz, zz);
  let e = fe_sub(b, a);
  let f = fe_sub(d, c);
  let g = fe_add(d, c);
  let h = fe_add(b, a);
  let x3 = fe_mul(e, f);
  let y3 = fe_mul(g, h);
  let t3 = fe_mul(e, h);
  let z3 = fe_mul(f, g);
  let r = ed_make(x3, y3, z3, t3);
  vec_free(x1);
  vec_free(y1);
  vec_free(z1);
  vec_free(t1);
  vec_free(x2);
  vec_free(y2);
  vec_free(z2);
  vec_free(t2);
  vec_free(d2);
  vec_free(ym1);
  vec_free(ym2);
  vec_free(yp1);
  vec_free(yp2);
  vec_free(a);
  vec_free(b);
  vec_free(t12);
  vec_free(c);
  vec_free(zz);
  vec_free(d);
  vec_free(e);
  vec_free(f);
  vec_free(g);
  vec_free(h);
  vec_free(x3);
  vec_free(y3);
  vec_free(t3);
  vec_free(z3);
  return r;
}

/// Internal: the scalar `k` (little-endian bytes) times the point `p`, by
/// doubling and adding from the top bit down.
fn ed_mul(p: &Vec[u64], k: &Bytes) -> Vec[u64]
  requires vlen(p) == 64 && blen(k) < 1000
  ensures vlen(result) == 64
{
  let mut r = ed_identity();
  let mut i = 8 * blen(k);
  while i > 0
    invariant i <= 8 * blen(k) && blen(k) < 1000 && vlen(r) == 64 && vlen(p) == 64
  {
    i = i - 1;
    let dbl = ed_add(r, r);
    vec_free(r);
    r = dbl;
    if ((cast[u64](bget(k, i / 8)) >> (i % 8)) & 1) == 1 {
      let sum = ed_add(r, p);
      vec_free(r);
      r = sum;
    }
  }
  return r;
}

/// Internal: the base point.
fn ed_base() -> Vec[u64]
  ensures vlen(result) == 64
{
  let x = ed_const("1ad5258f602d56c9b2a7259560c72c695cdcd6fd31e2a4c0fe536ecdd3366921");
  let y = ed_const("5866666666666666666666666666666666666666666666666666666666666666");
  let mut z = fe_zero();
  vec_set(&mut z, 0, 1);
  let t = fe_mul(x, y);
  let r = ed_make(x, y, z, t);
  vec_free(x);
  vec_free(y);
  vec_free(z);
  vec_free(t);
  return r;
}

/// Internal: `a` to the power (p - 5) / 8 = 2^252 - 3.
fn fe_pow2523(a: &Vec[u64]) -> Vec[u64]
  requires vlen(a) == 16
  ensures vlen(result) == 16
{
  let mut c = fe_copy(a);
  let mut n = 0;
  while n < 251
    invariant n <= 251 && vlen(c) == 16 && vlen(a) == 16
  {
    let sq = fe_mul(c, c);
    vec_free(c);
    c = sq;
    // The exponent 2^252 - 3 has every bit set except bit 1.
    if n != 249 {
      let m = fe_mul(c, a);
      vec_free(c);
      c = m;
    }
    n = n + 1;
  }
  return c;
}

/// Internal: the bytes of the field element `a`, reduced.
fn ed_bytes(a: &Vec[u64]) -> Bytes
  requires vlen(a) == 16
  ensures blen(result) == 32
{
  return fe_pack(a);
}

/// Internal: the point whose compressed form is the 32 bytes `b` (y, then the
/// parity of x in the top bit), or nothing if there is no such point.
fn ed_decompress(b: &Bytes) -> Option[Vec[u64]]
  requires blen(b) == 32
  ensures result is Option::Some ==> vlen(result.Some) == 64
{
  let y = fe_unpack(b);
  // y must be below p: packing it again must give the bytes back.
  let yb = ed_bytes(y);
  let mut canonical = (bget(b, 31) & 127) == bget(yb, 31);
  let mut i = 0;
  while i < 31
    invariant i <= 31 && blen(b) == 32 && blen(yb) == 32
  {
    if bget(b, i) != bget(yb, i) { canonical = false; }
    i = i + 1;
  }
  bfree(yb);
  let sign = cast[u64](bget(b, 31) >> 7);
  let mut one = fe_zero();
  vec_set(&mut one, 0, 1);
  let d = ed_const("a3785913ca4deb75abd841414d0a700098e879777940c78c73fe6f2bee6c0352");
  let yy = fe_mul(y, y);
  let u = fe_sub(yy, one);
  let dyy = fe_mul(d, yy);
  let v = fe_add(dyy, one);
  // x = u v^3 (u v^7)^((p - 5) / 8)
  let v2 = fe_mul(v, v);
  let v3 = fe_mul(v2, v);
  let v4 = fe_mul(v2, v2);
  let v7 = fe_mul(v4, v3);
  let uv3 = fe_mul(u, v3);
  let uv7 = fe_mul(u, v7);
  let pw = fe_pow2523(uv7);
  let mut x = fe_mul(uv3, pw);
  // v x^2 must be u, or -u (then x is multiplied by the square root of -1).
  let xx = fe_mul(x, x);
  let vxx = fe_mul(v, xx);
  let diff = fe_sub(vxx, u);
  let sum = fe_add(vxx, u);
  let dz = ed_bytes(diff);
  let sz = ed_bytes(sum);
  let mut diff_zero = true;
  let mut sum_zero = true;
  i = 0;
  while i < 32
    invariant i <= 32 && blen(dz) == 32 && blen(sz) == 32
  {
    if bget(dz, i) != 0 { diff_zero = false; }
    if bget(sz, i) != 0 { sum_zero = false; }
    i = i + 1;
  }
  bfree(dz);
  bfree(sz);
  let mut valid = canonical && (diff_zero || sum_zero);
  if !diff_zero && sum_zero {
    let sqm1 = ed_const("b0a00e4a271beec478e42fad0618432fa7d7fb3d99004d2b0bdfc14f8024832b");
    let x2 = fe_mul(x, sqm1);
    vec_free(x);
    vec_free(sqm1);
    x = x2;
  }
  // The sign: x = 0 with the sign bit set is not a point; otherwise negate x
  // if its parity is not the sign.
  let xb = ed_bytes(x);
  let mut x_zero = true;
  i = 0;
  while i < 32
    invariant i <= 32 && blen(xb) == 32
  {
    if bget(xb, i) != 0 { x_zero = false; }
    i = i + 1;
  }
  let parity = cast[u64](bget(xb, 0) & 1);
  bfree(xb);
  if x_zero && sign == 1 { valid = false; }
  let zero = fe_zero();
  if parity != sign {
    let nx = fe_sub(zero, x);
    vec_free(x);
    x = nx;
  }
  let t = fe_mul(x, y);
  let p = ed_make(x, y, one, t);
  vec_free(zero);
  vec_free(t);
  vec_free(sum);
  vec_free(diff);
  vec_free(vxx);
  vec_free(xx);
  vec_free(x);
  vec_free(pw);
  vec_free(uv7);
  vec_free(uv3);
  vec_free(v7);
  vec_free(v4);
  vec_free(v3);
  vec_free(v2);
  vec_free(v);
  vec_free(dyy);
  vec_free(u);
  vec_free(yy);
  vec_free(d);
  vec_free(one);
  vec_free(y);
  if valid {
    return Option[Vec[u64]]::Some(p);
  }
  vec_free(p);
  return Option[Vec[u64]]::None;
}

/// Internal: the compressed form of the point `p`: 32 bytes.
fn ed_compress(p: &Vec[u64]) -> Bytes
  requires vlen(p) == 64
  ensures blen(result) == 32
{
  let x = ed_get(p, 0);
  let y = ed_get(p, 1);
  let z = ed_get(p, 2);
  let zi = fe_inv(z);
  let xa = fe_mul(x, zi);
  let ya = fe_mul(y, zi);
  let xb = ed_bytes(xa);
  let mut out = ed_bytes(ya);
  bset(&mut out, 31, bget(out, 31) | ((bget(xb, 0) & 1) << 7));
  bfree(xb);
  vec_free(ya);
  vec_free(xa);
  vec_free(zi);
  vec_free(z);
  vec_free(y);
  vec_free(x);
  return out;
}

/// Internal: the scalar `s` (32 little-endian bytes) is below the group order
/// L = 2^252 + 27742317777372353535851937790883648493.
fn ed_below_l(s: &Bytes, off: u64) -> bool
  requires blen(s) >= 32 && off <= blen(s) - 32
{
  let l = ed_const("edd3f55c1a631258d69cf7a2def9de1400000000000000000000000000000010");
  // L's bytes, by comparing from the top byte down.
  let lb = ed_bytes(l);
  vec_free(l);
  let mut i = 32;
  let mut less = false;
  let mut decided = false;
  while i > 0
    invariant i <= 32 && blen(lb) == 32 && blen(s) >= 32 && off <= blen(s) - 32
  {
    i = i - 1;
    if !decided {
      if bget(s, off + i) < bget(lb, i) {
        less = true;
        decided = true;
      } else {
        if bget(s, off + i) > bget(lb, i) { decided = true; }
      }
    }
  }
  bfree(lb);
  return less;
}

/// Whether `sig` (64 bytes: R, then S) is a valid Ed25519 signature of `msg`
/// under the public key `pubkey` (32 bytes). The signature is refused if S is
/// not below the group order or the key is not a point.
/// ```
/// let pubkey = balloc(32);
/// let sig = balloc(64);
/// let msg = bfrom("hello");
/// // All zeros is not a signature of anything.
/// let ok = ed25519_verify(pubkey, msg, sig);
/// bfree(msg);
/// bfree(sig);
/// bfree(pubkey);
/// if ok { return 1; }
/// ```
fn ed25519_verify(pubkey: &Bytes, msg: &Bytes, sig: &Bytes) -> bool
  requires blen(pubkey) == 32 && blen(sig) == 64 && blen(msg) < 1000000000
{
  if !ed_below_l(sig, 32) {
    return false;
  }
  match ed_decompress(pubkey) {
    Option::None => { return false; },
    Option::Some(a) => {
      // h = SHA-512(R || A || M), taken as a 512-bit little-endian number.
      let mut data = text_new();
      text_push_span(&mut data, sig, 0, 32);
      text_push_bytes(&mut data, pubkey);
      text_push_bytes(&mut data, msg);
      let db = text_finish(data);
      let h = sha512(db);
      bfree(db);
      // [S]B - [h]A, which must be R.
      let zero = fe_zero();
      let ax = ed_get(a, 0);
      let ay = ed_get(a, 1);
      let az = ed_get(a, 2);
      let at = ed_get(a, 3);
      let nax = fe_sub(zero, ax);
      let nat = fe_sub(zero, at);
      let na = ed_make(nax, ay, az, nat);
      let s = bytes_slice(sig, 32, 64);
      let base = ed_base();
      let sb = ed_mul(base, s);
      let ha = ed_mul(na, h);
      let sum = ed_add(sb, ha);
      let enc = ed_compress(sum);
      let rb = bytes_slice(sig, 0, 32);
      let same = bytes_eq(enc, rb);
      bfree(rb);
      bfree(enc);
      vec_free(sum);
      vec_free(ha);
      vec_free(sb);
      vec_free(base);
      bfree(s);
      vec_free(na);
      vec_free(nat);
      vec_free(nax);
      vec_free(at);
      vec_free(az);
      vec_free(ay);
      vec_free(ax);
      vec_free(zero);
      bfree(h);
      vec_free(a);
      return same;
    },
  }
}

/// Internal: the 64-byte little-endian number `x` modulo the group order L, as
/// 32 bytes (a binary long division: not constant time).
fn ed_sc_reduce(x: &Bytes) -> Bytes
  requires blen(x) == 64
  ensures blen(result) == 32
{
  let l = ed_const("edd3f55c1a631258d69cf7a2def9de1400000000000000000000000000000010");
  let lb = ed_bytes(l);
  vec_free(l);
  let mut r = balloc(33);
  let mut i = 512;
  while i > 0
    invariant i <= 512 && blen(r) == 33 && blen(lb) == 32 && blen(x) == 64
  {
    i = i - 1;
    // r = 2 * r + the next bit of x.
    let mut carry = cast[u64]((bget(x, i / 8) >> cast[u8](i % 8)) & 1);
    let mut j = 0;
    while j < 33
      invariant j <= 33 && blen(r) == 33
    {
      let v = wrap_add(wrap_mul(cast[u64](bget(r, j)), 2), carry);
      bset(&mut r, j, cast[u8](v & 255));
      carry = v >> 8;
      j = j + 1;
    }
    // r >= L?
    let mut ge = true;
    let mut decided = false;
    let mut k = 33;
    while k > 0
      invariant k <= 33 && blen(r) == 33 && blen(lb) == 32
    {
      k = k - 1;
      if !decided {
        let mut lk = 0;
        if k < 32 {
          lk = cast[u64](bget(lb, k));
        }
        let rk = cast[u64](bget(r, k));
        if rk > lk {
          decided = true;
        } else {
          if rk < lk {
            ge = false;
            decided = true;
          }
        }
      }
    }
    if ge {
      let mut borrow = 0;
      let mut m = 0;
      while m < 33
        invariant m <= 33 && borrow <= 1 && blen(r) == 33 && blen(lb) == 32
      {
        let mut lm = 0;
        if m < 32 {
          lm = cast[u64](bget(lb, m));
        }
        let rm = cast[u64](bget(r, m));
        let sub = wrap_add(lm, borrow);
        if rm >= sub {
          bset(&mut r, m, cast[u8](rm - sub));
          borrow = 0;
        } else {
          bset(&mut r, m, cast[u8](rm + 256 - sub));
          borrow = 1;
        }
        m = m + 1;
      }
    }
  }
  let out = bytes_slice(r, 0, 32);
  bfree(r);
  bfree(lb);
  return out;
}

/// Internal: the 64-byte little-endian product of the 32-byte numbers `a` and
/// `b`.
fn ed_sc_mul(a: &Bytes, b: &Bytes) -> Bytes
  requires blen(a) == 32 && blen(b) == 32
  ensures blen(result) == 64
{
  let mut acc = vec_new[u64]();
  let mut n = 0;
  while n < 64
    invariant n <= 64 && vlen(acc) == n
  {
    vec_push(&mut acc, 0);
    n = n + 1;
  }
  let mut i = 0;
  while i < 32
    invariant i <= 32 && vlen(acc) == 64 && blen(a) == 32 && blen(b) == 32
  {
    let mut j = 0;
    while j < 32
      invariant j <= 32 && i < 32 && vlen(acc) == 64 && blen(a) == 32 && blen(b) == 32
    {
      let at = i + j;
      vec_set(&mut acc, at, wrap_add(vec_get(acc, at), wrap_mul(cast[u64](bget(a, i)), cast[u64](bget(b, j)))));
      j = j + 1;
    }
    i = i + 1;
  }
  let mut out = balloc(64);
  let mut carry = 0;
  let mut k = 0;
  while k < 64
    invariant k <= 64 && vlen(acc) == 64 && blen(out) == 64
  {
    let v = wrap_add(vec_get(acc, k), carry);
    bset(&mut out, k, cast[u8](v & 255));
    carry = v >> 8;
    k = k + 1;
  }
  vec_free(acc);
  return out;
}

/// Internal: the 64-byte number `p` plus the 32-byte number `r` (little
/// endian; the sum must fit 64 bytes, which it does for the values used).
fn ed_sc_add(p: &Bytes, r: &Bytes) -> Bytes
  requires blen(p) == 64 && blen(r) == 32
  ensures blen(result) == 64
{
  let mut out = balloc(64);
  let mut carry = 0;
  let mut k = 0;
  while k < 64
    invariant k <= 64 && blen(p) == 64 && blen(r) == 32 && blen(out) == 64
  {
    let mut rk = 0;
    if k < 32 {
      rk = cast[u64](bget(r, k));
    }
    let v = wrap_add(wrap_add(cast[u64](bget(p, k)), rk), carry);
    bset(&mut out, k, cast[u8](v & 255));
    carry = v >> 8;
    k = k + 1;
  }
  return out;
}

/// Internal: SHA-512 of the 32-byte seed with the first half clamped into the
/// secret scalar `a` (in place) and the second half left as the prefix.
fn ed_expand(seed: &Bytes) -> Bytes
  requires blen(seed) == 32
  ensures blen(result) == 64
{
  let mut h = sha512(seed);
  bset(&mut h, 0, bget(h, 0) & 248);
  bset(&mut h, 31, (bget(h, 31) & 127) | 64);
  return h;
}

/// The public key (32 bytes) of the 32-byte secret `seed` (RFC 8032 section
/// 5.1.5). A seed is 32 random bytes, so this is also key generation.
/// ```
/// let seed = balloc(32);
/// let pubkey = ed25519_public(seed);
/// let n = blen(pubkey);
/// bfree(pubkey);
/// bfree(seed);
/// if n != 32 { return 1; }
/// ```
fn ed25519_public(seed: &Bytes) -> Bytes
  requires blen(seed) == 32
  ensures blen(result) == 32
{
  let h = ed_expand(seed);
  let a = bytes_slice(h, 0, 32);
  let base = ed_base();
  let pt = ed_mul(base, a);
  let out = ed_compress(pt);
  vec_free(pt);
  vec_free(base);
  bfree(a);
  bfree(h);
  return out;
}

/// The Ed25519 signature (64 bytes) of `msg` under the 32-byte secret `seed`
/// (RFC 8032 section 5.1.6). Signatures are deterministic.
/// ```
/// let seed = balloc(32);
/// let pubkey = ed25519_public(seed);
/// let msg = bfrom("hello");
/// let sig = ed25519_sign(seed, msg);
/// let ok = ed25519_verify(pubkey, msg, sig);
/// bfree(sig);
/// bfree(msg);
/// bfree(pubkey);
/// bfree(seed);
/// if !ok { return 1; }
/// ```
fn ed25519_sign(seed: &Bytes, msg: &Bytes) -> Bytes
  requires blen(seed) == 32 && blen(msg) < 1000000000
  ensures blen(result) == 64
{
  let h = ed_expand(seed);
  let a = bytes_slice(h, 0, 32);
  let base = ed_base();
  let apt = ed_mul(base, a);
  let pubkey = ed_compress(apt);
  // r = SHA-512(prefix || M) mod L; R = [r]B.
  let mut d1 = text_new();
  text_push_span(&mut d1, h, 32, 64);
  text_push_bytes(&mut d1, msg);
  let d1b = text_finish(d1);
  let rh = sha512(d1b);
  bfree(d1b);
  let r = ed_sc_reduce(rh);
  bfree(rh);
  let rpt = ed_mul(base, r);
  let rb = ed_compress(rpt);
  // k = SHA-512(R || A || M) mod L; S = (r + k * a) mod L.
  let mut d2 = text_new();
  text_push_bytes(&mut d2, rb);
  text_push_bytes(&mut d2, pubkey);
  text_push_bytes(&mut d2, msg);
  let d2b = text_finish(d2);
  let kh = sha512(d2b);
  bfree(d2b);
  let k = ed_sc_reduce(kh);
  bfree(kh);
  let ka = ed_sc_mul(k, a);
  let sum = ed_sc_add(ka, r);
  let s = ed_sc_reduce(sum);
  let mut sig = text_new();
  text_push_bytes(&mut sig, rb);
  text_push_bytes(&mut sig, s);
  let out = text_finish(sig);
  bfree(s);
  bfree(sum);
  bfree(ka);
  bfree(k);
  vec_free(rpt);
  bfree(rb);
  bfree(r);
  bfree(pubkey);
  vec_free(apt);
  vec_free(base);
  bfree(a);
  bfree(h);
  return out;
}
