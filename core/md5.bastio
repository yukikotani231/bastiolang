  vec_push(&mut k, 2336552879);
  vec_push(&mut k, 4294925233);
  vec_push(&mut k, 2304563134);
  vec_push(&mut k, 1804603682);
  vec_push(&mut k, 4254626195);
  vec_push(&mut k, 2792965006);
  vec_push(&mut k, 1236535329);
  vec_push(&mut k, 4129170786);
  vec_push(&mut k, 3225465664);
  vec_push(&mut k, 643717713);
  vec_push(&mut k, 3921069994);
  vec_push(&mut k, 3593408605);
  vec_push(&mut k, 38016083);
  vec_push(&mut k, 3634488961);
  vec_push(&mut k, 3889429448);
  vec_push(&mut k, 568446438);
  vec_push(&mut k, 3275163606);
  vec_push(&mut k, 4107603335);
  vec_push(&mut k, 1163531501);
  vec_push(&mut k, 2850285829);
  vec_push(&mut k, 4243563512);
  vec_push(&mut k, 1735328473);
  vec_push(&mut k, 2368359562);
  vec_push(&mut k, 4294588738);
  vec_push(&mut k, 2272392833);
  vec_push(&mut k, 1839030562);
  vec_push(&mut k, 4259657740);
  vec_push(&mut k, 2763975236);
  vec_push(&mut k, 1272893353);
  vec_push(&mut k, 4139469664);
  vec_push(&mut k, 3200236656);
  vec_push(&mut k, 681279174);
  vec_push(&mut k, 3936430074);
  vec_push(&mut k, 3572445317);
  vec_push(&mut k, 76029189);
  vec_push(&mut k, 3654602809);
  vec_push(&mut k, 3873151461);
  vec_push(&mut k, 530742520);
  vec_push(&mut k, 3299628645);
