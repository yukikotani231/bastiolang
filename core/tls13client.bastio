// core/tls13client.bastio: a TLS 1.3 client that does no input or output of
// its own. The caller reads bytes from a connection and passes them to
// `tls13c_feed`; whatever the client wants to send is appended to a buffer
// the caller writes to the connection, and the data received from the peer is
// appended to another. So the same code runs over a socket, a pipe or a test.
//
// It speaks three suites, TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384 and
// TLS_CHACHA20_POLY1305_SHA256, with X25519, and checks
// the server: the certificate chain against the trusted roots the caller
// gives (X.509 with RSA, ECDSA (P-256 and P-384) and Ed25519 signatures made
// with SHA-256, SHA-384 or SHA-512, validity, host name, CA flags and key
// usage), the CertificateVerify signature (ed25519, ecdsa_secp256r1_sha256,
// ecdsa_secp384r1_sha384, rsa_pss_rsae_sha256 or rsa_pss_rsae_sha384) and
// the Finished message. It sends no client
// certificate, offers no resumption or early data, and accepts a KeyUpdate
// and NewSessionTicket messages.
//
// What is proved: every access is in bounds, nothing leaks, and the keys and
// secrets the state holds always have the lengths the record layer needs.
// Not proved: that the protocol is followed; the tests run a handshake with
// an OpenSSL server (tests/tls.sh) and feed damaged and truncated flights.
// Not done: certificate path length and name constraints, extended key usage
// and revocation checks; session tickets; a
// check that the random values are random (the caller supplies them).
import "bytes.bastio";
import "option.bastio";
import "sha256.bastio";
import "sha512.bastio";
import "text.bastio";
import "tls13.bastio";
import "tls13hs.bastio";
import "tls13record.bastio";
import "x25519.bastio";
import "x509.bastio";
import "ed25519.bastio";
import "p256.bastio";
import "rsa.bastio";

/// The state of one connection. `state` is 0 waiting for the ServerHello, 1
/// for EncryptedExtensions, 2 for the Certificate, 3 for CertificateVerify, 4
/// for the server's Finished, 5 connected, 6 closed by the peer, 7 failed.
/// `verify` is false when a chain the roots do not vouch for is accepted
/// anyway (`verdict` then says why it would have been refused); `alpn` holds
/// the protocols offered, then the one the server chose. `sent_close` is true
/// once `tls13c_shutdown` has said goodbye: nothing more is sent, but what the
/// server still sends is read. `allow12` offers TLS 1.2 too; `v12` is true
/// once the server chose it (cipher suite `cs12`); `step` is then where the
/// TLS 1.2 handshake is (0 Certificate, 1 ServerKeyExchange, 2
/// ServerHelloDone, 3 the server's ChangeCipherSpec, 4 its Finished), `rnd`
/// the client and then the server random, `ms` the premaster and then the
/// master secret, `ems` whether it is an extended master secret. The
/// server of core/tls13server keeps its signing key in `sk_kind` (0 none, 1
/// RSA with the modulus in `sk_a` and the private exponent in `sk_b`, 2
/// ECDSA P-256 with the scalar in `sk_a`).
struct Tls13Client {
  state: u64, priv_key: Bytes, name: Bytes, transcript: Bytes,
  hs_secret: Bytes, c_hs: Bytes, s_hs: Bytes,
  suite: u64, c_suite: u64, s_suite: u64,
  c_key: Bytes, c_iv: Bytes, s_key: Bytes, s_iv: Bytes,
  c_secret: Bytes, s_secret: Bytes, c_seq: u64, s_seq: u64,
  inbuf: Bytes, hsbuf: Bytes, leaf: Bytes,
  verify: bool, verdict: u64, alpn: Bytes, sent_close: bool,
  allow12: bool, only12: bool, v12: bool, step: u64, rnd: Bytes, ms: Bytes, ems: bool, cs12: u64,
  sk_kind: u64, sk_a: Bytes, sk_b: Bytes,
  creq: u64, croots: Bytes, cleaf: Bytes, cnow: u64, cverdict: u64,
  ck_kind: u64, ck_nonce: Bytes
}

/// Internal: the handshake and traffic secrets of `c` all have `n` bytes, the
/// output length of the hash of the cipher suite (32 for SHA-256, 48 for
/// SHA-384).
spec fn tls13c_secrets(c: &Tls13Client, n: u64) -> bool {
  blen(c.hs_secret) == n && blen(c.c_hs) == n && blen(c.s_hs) == n && blen(c.c_secret) == n && blen(c.s_secret) == n
}

/// Internal: the sizes of the keys and secrets the record layer needs.
spec fn tls13c_ok(c: &Tls13Client) -> bool {
  c.state <= 9 && blen(c.priv_key) == 32
    && ((c.suite == 4866 && tls13c_secrets(c, 48)) || ((c.suite == 4865 || c.suite == 4867) && tls13c_secrets(c, 32)))
    && ((c.c_suite == 4867 && blen(c.c_key) == 32) || (c.c_suite == 4866 && blen(c.c_key) == 32) || (c.c_suite == 4865 && blen(c.c_key) == 16))
    && ((c.s_suite == 4867 && blen(c.s_key) == 32) || (c.s_suite == 4866 && blen(c.s_key) == 32) || (c.s_suite == 4865 && blen(c.s_key) == 16))
    && blen(c.c_iv) == 12 && blen(c.s_iv) == 12
    && blen(c.name) <= 255
    && blen(c.transcript) < 1073741824 && blen(c.inbuf) < 1073741824 && blen(c.hsbuf) < 1073741824 && blen(c.leaf) < 1048576
    && blen(c.alpn) <= 256 && blen(c.rnd) <= 64 && blen(c.ms) <= 48
    && blen(c.sk_a) < 65536 && blen(c.sk_b) < 65536
    && blen(c.croots) < 274877906944 && blen(c.cleaf) < 1048576 && blen(c.ck_nonce) < 1024
}

/// Internal: the 9 as a field element, the base point of X25519.
fn tls13c_base() -> Bytes
  ensures blen(result) == 32
{
  let mut b = balloc(32);
  bset(&mut b, 0, 9);
  return b;
}

/// Internal: the record of type `ty` (with the legacy version 0x0303, or
/// 0x0301 for `legacy` = 1) around `body`.
fn tls13c_plain_record(t: &mut Vec[u8], ty: u8, body: &Bytes)
  requires blen(body) <= 16384
  ensures vlen(t) == vlen(old(t)) + 5 + blen(body)
{
  text_push(&mut t, ty);
  text_push(&mut t, 3);
  text_push(&mut t, 1);
  text_push(&mut t, cast[u8](blen(body) / 256));
  text_push(&mut t, cast[u8](blen(body) % 256));
  text_push_bytes(&mut t, body);
}

/// Starts a connection to the server named `name` (at most 255 bytes): the
/// ClientHello, as a record, is appended to `out`. `random`, `session_id`
/// and `priv_key` are 32 bytes each and must be unpredictable and not used
/// again; the private key stays in the client.
/// ```
/// let r = balloc(32);
/// let s = balloc(32);
/// let k = balloc(32);
/// let name = bfrom("example.com");
/// let mut out = text_new();
/// let c = tls13c_new(r, s, k, name, &mut out);
/// let first = vec_get(out, 0);
/// let st = tls13c_state(c);
/// tls13c_free(c);
/// vec_free(out);
/// bfree(name);
/// bfree(k);
/// bfree(s);
/// bfree(r);
/// if first != 22 || st != 0 { return 1; }
/// ```
fn tls13c_new(random: &Bytes, session_id: &Bytes, priv_key: &Bytes, name: &Bytes, out: &mut Vec[u8]) -> Tls13Client
  requires blen(random) == 32 && blen(session_id) == 32 && blen(priv_key) == 32 && blen(name) <= 255
  ensures tls13c_ok(result) && result.state == 0
  ensures vlen(out) > vlen(old(out))
{
  let none = balloc(0);
  let c = tls13c_new_opts(random, session_id, priv_key, name, none, 0, &mut out);
  bfree(none);
  return c;
}

/// `tls13c_new` that also offers the application protocols `alpn` (RFC
/// 7301; the ProtocolNameList without its length, each name behind a one-byte
/// length, at most 256 bytes, empty for none; `tls13c_alpn` tells which one
/// the server chose). With `verify` false a certificate chain that the roots
/// do not vouch for, or that is for another name, is accepted (the server
/// must still prove it holds the key of its certificate); `tls13c_verdict`
/// then says what was wrong with it.
/// ```
/// let r = balloc(32);
/// let s = balloc(32);
/// let k = balloc(32);
/// let name = bfrom("example.com");
/// let mut a = text_new();
/// text_push(&mut a, 2);
/// text_push_str(&mut a, "h2");
/// let alpn = text_finish(a);
/// let mut out = text_new();
/// let c = tls13c_new_with(r, s, k, name, alpn, false, &mut out);
/// let st = tls13c_state(c);
/// let chosen = tls13c_alpn(c);
/// let none = blen(chosen) == 0;
/// bfree(chosen);
/// tls13c_free(c);
/// vec_free(out);
/// bfree(alpn);
/// bfree(name);
/// bfree(k);
/// bfree(s);
/// bfree(r);
/// if st != 0 || !none { return 1; }
/// ```
fn tls13c_new_with(random: &Bytes, session_id: &Bytes, priv_key: &Bytes, name: &Bytes, alpn: &Bytes, verify: bool, out: &mut Vec[u8]) -> Tls13Client
  requires blen(random) == 32 && blen(session_id) == 32 && blen(priv_key) == 32 && blen(name) <= 255 && blen(alpn) <= 256
  ensures tls13c_ok(result) && result.state == 0
  ensures vlen(out) > vlen(old(out))
{
  let mut opts = 0;
  if !verify { opts = 1; }
  return tls13c_new_opts(random, session_id, priv_key, name, alpn, opts, &mut out);
}

/// `tls13c_new_with` with options as bits: 8 offers TLS 1.2 only (a server
/// that answers with TLS 1.3 fails the connection), 1 accepts a chain the roots do not
/// vouch for (`verify` false), 2 offers TLS 1.2 as well (for servers and
/// proxies that do not speak TLS 1.3: ECDHE with X25519, AES-GCM or
/// ChaCha20-Poly1305, the extended master secret when the server has it, no
/// renegotiation; a TLS 1.3 server that is made to fall back is noticed by
/// the value RFC 8446 puts at the end of its random).
/// ```
/// let r = balloc(32);
/// let s = balloc(32);
/// let k = balloc(32);
/// let name = bfrom("example.com");
/// let alpn = balloc(0);
/// let mut out = text_new();
/// let c = tls13c_new_opts(r, s, k, name, alpn, 2, &mut out);
/// let st = tls13c_state(c);
/// let v = tls13c_version(c);
/// tls13c_free(c);
/// vec_free(out);
/// bfree(alpn);
/// bfree(name);
/// bfree(k);
/// bfree(s);
/// bfree(r);
/// if st != 0 || v != 772 { return 1; }
/// ```
fn tls13c_new_opts(random: &Bytes, session_id: &Bytes, priv_key: &Bytes, name: &Bytes, alpn: &Bytes, opts: u64, out: &mut Vec[u8]) -> Tls13Client
  requires blen(random) == 32 && blen(session_id) == 32 && blen(priv_key) == 32 && blen(name) <= 255 && blen(alpn) <= 256
  ensures tls13c_ok(result) && result.state == 0
  ensures vlen(out) > vlen(old(out))
{
  let base = tls13c_base();
  let pubkey = x25519(priv_key, base);
  let only12 = (opts & 8) != 0;
  let allow12 = (opts & 2) != 0 || only12;
  let mut hello = balloc(0);
  if allow12 {
    bfree(hello);
    hello = tls13_client_hello_v12(random, session_id, name, pubkey, alpn, (opts & 8) != 0);
  } else {
    bfree(hello);
    hello = tls13_client_hello_alpn(random, session_id, name, pubkey, alpn);
  }
  tls13c_plain_record(&mut out, 22, hello);
  bfree(pubkey);
  bfree(base);
  return Tls13Client {
    state: 0, priv_key: bytes_slice(priv_key, 0, 32), name: bytes_slice(name, 0, blen(name)), transcript: hello,
    hs_secret: balloc(32), c_hs: balloc(32), s_hs: balloc(32),
    suite: 4867, c_suite: 4867, s_suite: 4867,
    c_key: balloc(32), c_iv: balloc(12), s_key: balloc(32), s_iv: balloc(12),
    c_secret: balloc(32), s_secret: balloc(32), c_seq: 0, s_seq: 0,
    inbuf: balloc(0), hsbuf: balloc(0), leaf: balloc(0),
    verify: (opts & 1) == 0, verdict: 0, alpn: bytes_slice(alpn, 0, blen(alpn)), sent_close: false,
    allow12: allow12, only12: only12, v12: false, step: 0, rnd: bytes_slice(random, 0, 32), ms: balloc(0), ems: false, cs12: 0,
    sk_kind: 0, sk_a: balloc(0), sk_b: balloc(0),
    creq: 0, croots: balloc(0), cleaf: balloc(0), cnow: 0, cverdict: 0,
    ck_kind: 0, ck_nonce: balloc(0)
  };
}

/// A client that has already failed (state 7) and holds no keys or secrets:
/// a placeholder for a slot whose connection is gone. Callers use it instead
/// of building the struct, so new fields do not break them.
/// ```
/// let c = tls13c_blank();
/// let st = tls13c_state(c);
/// tls13c_free(c);
/// if st != 7 { return 1; }
/// ```
fn tls13c_blank() -> Tls13Client
  ensures result.state == 7
{
  return Tls13Client {
    state: 7, priv_key: balloc(0), name: balloc(0), transcript: balloc(0),
    hs_secret: balloc(0), c_hs: balloc(0), s_hs: balloc(0),
    suite: 4867, c_suite: 4867, s_suite: 4867,
    c_key: balloc(0), c_iv: balloc(0), s_key: balloc(0), s_iv: balloc(0),
    c_secret: balloc(0), s_secret: balloc(0), c_seq: 0, s_seq: 0,
    inbuf: balloc(0), hsbuf: balloc(0), leaf: balloc(0),
    verify: true, verdict: 0, alpn: balloc(0), sent_close: false,
    allow12: false, only12: false, v12: false, step: 0, rnd: balloc(0), ms: balloc(0), ems: false, cs12: 0,
    sk_kind: 0, sk_a: balloc(0), sk_b: balloc(0),
    creq: 0, croots: balloc(0), cleaf: balloc(0), cnow: 0, cverdict: 0,
    ck_kind: 0, ck_nonce: balloc(0)
  };
}

/// Frees a client.
fn tls13c_free(c: Tls13Client) {
  bfree(c.priv_key);
  bfree(c.name);
  bfree(c.transcript);
  bfree(c.hs_secret);
  bfree(c.c_hs);
  bfree(c.s_hs);
  bfree(c.c_key);
  bfree(c.c_iv);
  bfree(c.s_key);
  bfree(c.s_iv);
  bfree(c.c_secret);
  bfree(c.s_secret);
  bfree(c.inbuf);
  bfree(c.hsbuf);
  bfree(c.leaf);
  bfree(c.alpn);
  bfree(c.rnd);
  bfree(c.ms);
  bfree(c.sk_a);
  bfree(c.sk_b);
  bfree(c.croots);
  bfree(c.cleaf);
  bfree(c.ck_nonce);
}

/// The protocol version in use: 772 (TLS 1.3), or 771 once a server chose
/// TLS 1.2.
/// ```
/// let c = tls13c_blank();
/// let v = tls13c_version(c);
/// tls13c_free(c);
/// if v != 772 { return 1; }
/// ```
fn tls13c_version(c: &Tls13Client) -> u64 {
  if c.v12 { return 771; }
  return 772;
}

/// The cipher suite in use (its IANA number, 0x1301.. for TLS 1.3 or
/// 0xC02B.. for TLS 1.2); 0 before the ServerHello.
/// ```
/// let c = tls13c_blank();
/// let s = tls13c_suite(c);
/// tls13c_free(c);
/// if s != 0 { return 1; }
/// ```
fn tls13c_suite(c: &Tls13Client) -> u64 {
  if c.v12 { return c.cs12; }
  if c.state == 0 || c.state == 7 && blen(c.transcript) == 0 { return 0; }
  return c.suite;
}

/// Whether `c` has the sizes and states the other functions require
/// (`tls13c_ok`): true for a client made by `tls13c_new` or
/// `tls13c_new_with` and kept by these functions, false for a blank one.
/// Callers that keep clients in a vector use it after taking one out.
/// ```
/// let c = tls13c_blank();
/// let ok = tls13c_check(c);
/// tls13c_free(c);
/// if ok { return 1; }
/// ```
fn tls13c_check(c: &Tls13Client) -> bool
  ensures result ==> tls13c_ok(c)
{
  if c.state > 9 || blen(c.priv_key) != 32 { return false; }
  let mut sec = 0;
  if c.suite == 4866 { sec = 48; } else if c.suite == 4865 || c.suite == 4867 { sec = 32; } else { return false; }
  if blen(c.hs_secret) != sec || blen(c.c_hs) != sec || blen(c.s_hs) != sec || blen(c.c_secret) != sec || blen(c.s_secret) != sec { return false; }
  if c.c_suite == 4865 { if blen(c.c_key) != 16 { return false; } }
  else if c.c_suite == 4866 || c.c_suite == 4867 { if blen(c.c_key) != 32 { return false; } }
  else { return false; }
  if c.s_suite == 4865 { if blen(c.s_key) != 16 { return false; } }
  else if c.s_suite == 4866 || c.s_suite == 4867 { if blen(c.s_key) != 32 { return false; } }
  else { return false; }
  if blen(c.c_iv) != 12 || blen(c.s_iv) != 12 { return false; }
  if blen(c.name) > 255 || blen(c.alpn) > 256 || blen(c.rnd) > 64 || blen(c.ms) > 48 { return false; }
  if blen(c.sk_a) >= 65536 || blen(c.sk_b) >= 65536 { return false; }
  if blen(c.croots) >= 274877906944 || blen(c.cleaf) >= 1048576 || blen(c.ck_nonce) >= 1024 { return false; }
  if blen(c.transcript) >= 1073741824 || blen(c.inbuf) >= 1073741824 || blen(c.hsbuf) >= 1073741824 || blen(c.leaf) >= 1048576 { return false; }
  return true;
}

/// The application protocol the server chose (a copy; empty when it chose
/// none or has not answered yet).
/// ```
/// let c = tls13c_blank();
/// let a = tls13c_alpn(c);
/// let n = blen(a);
/// bfree(a);
/// tls13c_free(c);
/// if n != 0 { return 1; }
/// ```
fn tls13c_alpn(c: &Tls13Client) -> Bytes {
  if c.state <= 1 { return balloc(0); }
  return bytes_slice(c.alpn, 0, blen(c.alpn));
}

/// 0 when the server's certificate chain was checked and good; otherwise 10
/// when only the host name is not the certificate's, or 6 (the code a client
/// that verifies fails with in both cases; a client that verifies keeps the
/// refused certificate and this verdict too, after the failure).
/// ```
/// let c = tls13c_blank();
/// let v = tls13c_verdict(c);
/// tls13c_free(c);
/// if v != 0 { return 1; }
/// ```
fn tls13c_verdict(c: &Tls13Client) -> u64 {
  return c.verdict;
}

/// The server's own certificate (DER, a copy), once the client has it
/// (state 3 or later); empty before.
/// ```
/// let c = tls13c_blank();
/// let p = tls13c_peer_cert(c);
/// let n = blen(p);
/// bfree(p);
/// tls13c_free(c);
/// if n != 0 { return 1; }
/// ```
fn tls13c_peer_cert(c: &Tls13Client) -> Bytes {
  return bytes_slice(c.leaf, 0, blen(c.leaf));
}

/// The state of `c`: 0 waiting for the ServerHello, 1 for the
/// EncryptedExtensions, 2 for the Certificate, 3 for the CertificateVerify, 4
/// for the Finished, 5 connected, 6 closed by the peer, 7 failed. A server
/// still waiting for the client's certificate is in state 4 too.
fn tls13c_state(c: &Tls13Client) -> u64 {
  if c.state == 8 || c.state == 9 { return 4; }
  return c.state;
}

/// Internal: marks `c` failed and returns `code`.
fn tls13c_fail(c: &mut Tls13Client, code: u64) -> u64
  requires tls13c_ok(c) && code >= 1
  ensures tls13c_ok(c) && result == code && c.state == 7
{
  c.state = 7;
  return code;
}

/// Internal: replaces `buf` with `buf` followed by `more`.
fn tls13c_append(buf: Bytes, more: &Bytes) -> Bytes
  requires blen(buf) < 1073741824 && blen(more) < 1073741824
  ensures blen(result) == blen(buf) + blen(more)
{
  let r = bytes_concat(buf, more);
  bfree(buf);
  return r;
}

/// Internal: the hash of the handshake messages so far.
fn tls13c_hash(c: &Tls13Client) -> Bytes
  requires tls13c_ok(c)
  ensures blen(result) == blen(c.hs_secret)
{
  if c.suite == 4866 { return sha384(c.transcript); }
  return sha256(c.transcript);
}

/// Internal: adds the handshake message `msg` to the transcript.
fn tls13c_note(c: &mut Tls13Client, msg: &Bytes) -> bool
  requires tls13c_ok(c) && blen(msg) < 1048576
  ensures tls13c_ok(c)
{
  if blen(c.transcript) > 1048576 { return false; }
  let t = tls13c_append(c.transcript, msg);
  c.transcript = t;
  return true;
}

/// Internal: the 24-bit number at `b[at..at+3]`.
fn tls13c_u24(b: &Bytes, at: u64) -> u64
  requires at + 3 <= blen(b)
  ensures result < 16777216
{
  return cast[u64](bget(b, at)) * 65536 + cast[u64](bget(b, at + 1)) * 256 + cast[u64](bget(b, at + 2));
}

/// Internal: the 16-bit number at `b[at..at+2]`.
fn tls13c_u16(b: &Bytes, at: u64) -> u64
  requires at + 2 <= blen(b)
  ensures result < 65536
{
  return cast[u64](bget(b, at)) * 256 + cast[u64](bget(b, at + 1));
}

/// Internal: whether the certificate of `inner` (a span of `msg`) was signed
/// by the one of `outer`, both are valid at `now` and `outer` may sign.
fn tls13c_link(msg: &Bytes, inner: Span, outer: Span, now: u64) -> bool
  requires inner.start <= inner.end && inner.end <= blen(msg) && outer.start <= outer.end && outer.end <= blen(msg) && blen(msg) < 274877906944
{
  let ib = bytes_slice(msg, inner.start, inner.end);
  let ob = bytes_slice(msg, outer.start, outer.end);
  let mut ok = false;
  match x509_parse(ib) {
    Option::None => {},
    Option::Some(i) => {
      match x509_parse(ob) {
        Option::None => {},
        Option::Some(o) => {
          ok = x509_valid_at(i, now) && x509_valid_at(o, now) && x509_can_sign(o) && x509_signed_by(ib, i, ob, o);
        },
      }
    },
  }
  bfree(ob);
  bfree(ib);
  return ok;
}

/// Internal: whether the last certificate of the chain (the span `last` of
/// `msg`) is one of the trusted `roots` (certificates one after the other) or
/// was signed by one that may sign and is valid at `now`.
fn tls13c_anchored(msg: &Bytes, last: Span, roots: &Bytes, now: u64) -> bool
  requires last.start <= last.end && last.end <= blen(msg) && blen(msg) < 274877906944 && blen(roots) < 274877906944
{
  let lb = bytes_slice(msg, last.start, last.end);
  let mut found = false;
  match x509_parse(lb) {
    Option::None => {},
    Option::Some(l) => {
      let mut at = 0;
      while at < blen(roots) && !found
        invariant at <= blen(roots)
      {
        let it = x509_item(roots, at, blen(roots));
        if it.tag == 0 {
          at = blen(roots);
        } else {
          let rb = bytes_slice(roots, at, it.content.end);
          match x509_parse(rb) {
            Option::None => {},
            Option::Some(r) => {
              if x509_valid_at(r, now) {
                if blen(rb) == blen(lb) && bytes_eq(rb, lb) { found = true; }
                if x509_can_sign(r) && x509_signed_by(lb, l, rb, r) { found = true; }
              }
            },
          }
          bfree(rb);
          at = it.content.end;
        }
      }
    },
  }
  bfree(lb);
  return found;
}

/// Internal: checks the Certificate message `msg` (with its header) for a
/// server named `name` at time `now` against `roots`, and returns the
/// server's own certificate if it is good.
fn tls13c_chain(msg: &Bytes, name: &Bytes, roots: &Bytes, now: u64) -> Option[Bytes]
  requires blen(msg) < 1048576 && blen(name) <= 255 && blen(roots) < 274877906944
  ensures result is Option::Some ==> blen(result.Some) < 1048576
{
  return tls13c_chain_for(msg, name, true, roots, now);
}

/// Internal: `tls13c_chain`, with the check of the host name only when
/// `check_name`.
fn tls13c_chain_for(msg: &Bytes, name: &Bytes, check_name: bool, roots: &Bytes, now: u64) -> Option[Bytes]
  requires blen(msg) < 1048576 && blen(name) <= 255 && blen(roots) < 274877906944
  ensures result is Option::Some ==> blen(result.Some) < 1048576
{
  let n = blen(msg);
  // type, 24-bit length, empty request context, 24-bit list length
  if n < 8 || bget(msg, 0) != 11 || tls13c_u24(msg, 1) + 4 != n || bget(msg, 4) != 0 {
    return Option[Bytes]::None;
  }
  let list_len = tls13c_u24(msg, 5);
  if list_len + 8 != n { return Option[Bytes]::None; }
  let mut spans = vec_new[Span]();
  let mut at = 8;
  let mut ok = true;
  while at < n && ok
    invariant at <= n && n == blen(msg) && vlen(spans) <= 8
    invariant forall k: u64 :: k < vlen(spans) ==> vget(spans, k).start <= vget(spans, k).end && vget(spans, k).end <= n
  {
    if n - at < 3 || vec_len(spans) >= 8 {
      ok = false;
    } else {
      let cl = tls13c_u24(msg, at);
      let start = at + 3;
      if cl == 0 || n - start < cl || n - start - cl < 2 {
        ok = false;
      } else {
        let ext = tls13c_u16(msg, start + cl);
        if n - (start + cl + 2) < ext {
          ok = false;
        } else {
          vec_push(&mut spans, Span { start: start, end: start + cl });
          at = start + cl + 2 + ext;
        }
      }
    }
  }
  if !ok || vec_len(spans) == 0 {
    vec_free(spans);
    return Option[Bytes]::None;
  }
  let count = vec_len(spans);
  // The chain is good up to the first certificate a root vouches for (or
  // that is a root): a chain may go on past it, as when the server sends a
  // root cross-signed by an older one the trust store no longer has.
  let mut i = 0;
  let mut anchored = false;
  while i < count && ok && !anchored
    invariant i <= count && count == vlen(spans) && n == blen(msg) && n < 1048576 && blen(roots) < 274877906944
    invariant forall k: u64 :: k < vlen(spans) ==> vget(spans, k).start <= vget(spans, k).end && vget(spans, k).end <= n
  {
    if tls13c_anchored(msg, vec_get(spans, i), roots, now) {
      anchored = true;
    } else if i + 1 < count {
      ok = tls13c_link(msg, vec_get(spans, i), vec_get(spans, i + 1), now);
      i = i + 1;
    } else {
      ok = false;
    }
  }
  ok = ok && anchored;
  let first = vec_get(spans, 0);
  vec_free(spans);
  if !ok { return Option[Bytes]::None; }
  let leaf = bytes_slice(msg, first.start, first.end);
  let mut good = false;
  match x509_parse(leaf) {
    Option::None => {},
    Option::Some(x) => {
      // The leaf must be valid now, be for the host, and not forbid signing.
      good = x509_valid_at(x, now) && (!check_name || x509_has_name(leaf, x, name)) && (x.key_usage == 65535 || (x.key_usage & 128) != 0);
    },
  }
  if good { return Option[Bytes]::Some(leaf); }
  bfree(leaf);
  return Option[Bytes]::None;
}

/// Internal: the first certificate of the Certificate message `msg` (the
/// server's own), if it is one x509_parse reads.
fn tls13c_first_cert(msg: &Bytes) -> Option[Bytes]
  requires blen(msg) < 1048576
  ensures result is Option::Some ==> blen(result.Some) < 1048576
{
  let n = blen(msg);
  if n < 11 || bget(msg, 0) != 11 || bget(msg, 4) != 0 { return Option[Bytes]::None; }
  let cl = tls13c_u24(msg, 8);
  if cl == 0 || n - 11 < cl { return Option[Bytes]::None; }
  let leaf = bytes_slice(msg, 11, 11 + cl);
  let mut good = false;
  match x509_parse(leaf) {
    Option::None => {},
    Option::Some(x) => { good = true; },
  }
  if good { return Option[Bytes]::Some(leaf); }
  bfree(leaf);
  return Option[Bytes]::None;
}

/// Internal: 1 if all of `b` is zero.
fn tls13c_all_zero(b: &Bytes) -> bool {
  let mut i = 0;
  while i < blen(b)
    invariant i <= blen(b)
  {
    if bget(b, i) != 0 { return false; }
    i = i + 1;
  }
  return true;
}

/// Internal: installs the traffic keys for the client's writing (`write`) or
/// reading side from the `secret` (as long as the hash of the suite).
fn tls13c_keys(c: &mut Tls13Client, secret: &Bytes, write: bool)
  requires tls13c_ok(c) && blen(secret) == blen(c.hs_secret)
  ensures tls13c_ok(c)
{
  let mut n = 32;
  if c.suite == 4865 {
    n = 16;
  }
  let key = tls13_traffic_key(secret, n);
  let iv = tls13_traffic_iv(secret);
  if write {
    bfree(c.c_key);
    bfree(c.c_iv);
    c.c_key = key;
    c.c_iv = iv;
    c.c_suite = c.suite;
    c.c_seq = 0;
  } else {
    bfree(c.s_key);
    bfree(c.s_iv);
    c.s_key = key;
    c.s_iv = iv;
    c.s_suite = c.suite;
    c.s_seq = 0;
  }
}

/// Internal: switches `c` to the cipher suite `suite`, which fixes the hash
/// and so the length of the secrets: they are replaced by zeros of the right
/// length (they are made anew from the key exchange right after).
fn tls13c_set_suite(c: &mut Tls13Client, suite: u64)
  requires tls13c_ok(c) && (suite == 4865 || suite == 4866 || suite == 4867)
  ensures tls13c_ok(c) && c.suite == suite
{
  let mut hl = 32;
  if suite == 4866 { hl = 48; }
  bfree(c.hs_secret);
  bfree(c.c_hs);
  bfree(c.s_hs);
  bfree(c.c_secret);
  bfree(c.s_secret);
  c.hs_secret = balloc(hl);
  c.c_hs = balloc(hl);
  c.s_hs = balloc(hl);
  c.c_secret = balloc(hl);
  c.s_secret = balloc(hl);
  c.suite = suite;
}

/// Internal: the handshake secrets from the server's key share `share`
/// (32 bytes), with the ServerHello already in the transcript.
fn tls13c_handshake_keys(c: &mut Tls13Client, share: &Bytes) -> bool
  requires tls13c_ok(c) && blen(share) == 32
  ensures tls13c_ok(c)
{
  let shared = x25519(c.priv_key, share);
  if tls13c_all_zero(shared) {
    bfree(shared);
    return false;
  }
  let mut early = tls13_early_secret();
  if c.suite == 4866 {
    bfree(early);
    early = tls13_early_secret384();
  }
  let hs = tls13_next_secret(early, shared);
  let h = tls13c_hash(c);
  let ch = tls13_derive_secret(hs, "c hs traffic", h);
  let sh = tls13_derive_secret(hs, "s hs traffic", h);
  bfree(c.hs_secret);
  bfree(c.c_hs);
  bfree(c.s_hs);
  c.hs_secret = hs;
  c.c_hs = ch;
  c.s_hs = sh;
  let k1 = bytes_slice(c.c_hs, 0, blen(c.c_hs));
  tls13c_keys(&mut c, k1, true);
  bfree(k1);
  let k2 = bytes_slice(c.s_hs, 0, blen(c.s_hs));
  tls13c_keys(&mut c, k2, false);
  bfree(k2);
  bfree(h);
  bfree(early);
  bfree(shared);
  return true;
}

/// Internal: the application traffic secrets and keys, with the server's
/// Finished already in the transcript.
fn tls13c_application_keys(c: &mut Tls13Client)
  requires tls13c_ok(c)
  ensures tls13c_ok(c)
{
  let h = tls13c_hash(c);
  tls13c_application_keys_for(&mut c, h);
  bfree(h);
}

/// Internal: the application keys for the transcript hash `h` (through the
/// server's Finished).
fn tls13c_application_keys_for(c: &mut Tls13Client, h: &Bytes)
  requires tls13c_ok(c) && blen(h) == blen(c.hs_secret)
  ensures tls13c_ok(c)
{
  let zeros = balloc(blen(c.hs_secret));
  let master = tls13_next_secret(c.hs_secret, zeros);
  let ca = tls13_derive_secret(master, "c ap traffic", h);
  let sa = tls13_derive_secret(master, "s ap traffic", h);
  bfree(c.c_secret);
  bfree(c.s_secret);
  c.c_secret = ca;
  c.s_secret = sa;
  let k1 = bytes_slice(c.c_secret, 0, blen(c.c_secret));
  tls13c_keys(&mut c, k1, true);
  bfree(k1);
  let k2 = bytes_slice(c.s_secret, 0, blen(c.s_secret));
  tls13c_keys(&mut c, k2, false);
  bfree(k2);
  bfree(master);
  bfree(zeros);
}

/// Internal: handles a ServerHello `msg` (state 0).
fn tls13c_server_hello(c: &mut Tls13Client, msg: &Bytes) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576
  ensures tls13c_ok(c)
{
  match tls13_parse_server_hello(msg) {
    Option::None => { return tls13c_fail(&mut c, 3); },
    Option::Some(share) => {
      if !tls13c_note(&mut c, msg) {
        bfree(share);
        return tls13c_fail(&mut c, 1);
      }
      let chosen = tls13_server_hello_suite(msg);
      if chosen == 4865 {
        tls13c_set_suite(&mut c, 4865);
      } else if chosen == 4866 {
        tls13c_set_suite(&mut c, 4866);
      } else {
        tls13c_set_suite(&mut c, 4867);
      }
      let ok = tls13c_handshake_keys(&mut c, share);
      bfree(share);
      if !ok { return tls13c_fail(&mut c, 4); }
      c.state = 1;
      return 0;
    },
  }
}

/// Internal: whether `name` is one of the names of the ProtocolNameList
/// contents `list` (each behind a one-byte length).
fn tls13c_offered(list: &Bytes, name: &Bytes) -> bool {
  let n = blen(list);
  let mut at = 0;
  while at < n
    invariant at <= n && n == blen(list)
  {
    let l = cast[u64](bget(list, at));
    if l == 0 || n - at - 1 < l { return false; }
    if l == blen(name) {
      let it = bytes_slice(list, at + 1, at + 1 + l);
      let same = bytes_eq(it, name);
      bfree(it);
      if same { return true; }
    }
    at = at + 1 + l;
  }
  return false;
}

/// Internal: handles EncryptedExtensions `msg` (state 1): the extensions are
/// read for their lengths and not used.
fn tls13c_encrypted_extensions(c: &mut Tls13Client, msg: &Bytes) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576
  ensures tls13c_ok(c)
{
  let n = blen(msg);
  if n < 6 || bget(msg, 0) != 8 || tls13c_u24(msg, 1) + 4 != n || tls13c_u16(msg, 4) + 6 != n {
    return tls13c_fail(&mut c, 1);
  }
  let mut at = 6;
  let mut chosen = balloc(0);
  while at < n
    invariant at <= n && n == blen(msg) && tls13c_ok(c) && blen(chosen) <= 255
  {
    if n - at < 4 { bfree(chosen); return tls13c_fail(&mut c, 1); }
    let ty = tls13c_u16(msg, at);
    let l = tls13c_u16(msg, at + 2);
    if n - at - 4 < l { bfree(chosen); return tls13c_fail(&mut c, 1); }
    if ty == 16 {
      // application_layer_protocol_negotiation: exactly one name, one the
      // client offered, and only once.
      if l < 4 || blen(chosen) != 0 { bfree(chosen); return tls13c_fail(&mut c, 1); }
      let nl = cast[u64](bget(msg, at + 6));
      if tls13c_u16(msg, at + 4) != l - 2 || nl + 3 != l || nl == 0 { bfree(chosen); return tls13c_fail(&mut c, 1); }
      let name = bytes_slice(msg, at + 7, at + 7 + nl);
      if !tls13c_offered(c.alpn, name) { bfree(name); bfree(chosen); return tls13c_fail(&mut c, 2); }
      bfree(chosen);
      chosen = name;
    }
    at = at + 4 + l;
  }
  bfree(c.alpn);
  c.alpn = chosen;
  if !tls13c_note(&mut c, msg) { return tls13c_fail(&mut c, 1); }
  c.state = 2;
  return 0;
}

/// Internal: handles the Certificate `msg` (state 2).
fn tls13c_certificate(c: &mut Tls13Client, msg: &Bytes, roots: &Bytes, now: u64) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576 && blen(roots) < 274877906944
  ensures tls13c_ok(c)
{
  match tls13c_chain(msg, c.name, roots, now) {
    Option::None => {
      if c.verify {
        // Keep the refused certificate and why (10: only the name is wrong),
        // so the caller can tell a bad name from an untrusted issuer.
        match tls13c_first_cert(msg) {
          Option::None => {},
          Option::Some(leaf0) => {
            bfree(c.leaf);
            c.leaf = leaf0;
            c.verdict = 6;
            match tls13c_chain_for(msg, c.name, false, roots, now) {
              Option::Some(l3) => { bfree(l3); c.verdict = 10; },
              Option::None => {},
            }
          },
        }
        return tls13c_fail(&mut c, 6);
      }
      // Not verified, as the caller asked: go on with the server's own
      // certificate, whose key must still sign the CertificateVerify.
      match tls13c_first_cert(msg) {
        Option::None => { return tls13c_fail(&mut c, 6); },
        Option::Some(leaf) => {
          bfree(c.leaf);
          c.leaf = leaf;
          // 10 when only the name is wrong (the chain itself is good).
          c.verdict = 6;
          match tls13c_chain_for(msg, c.name, false, roots, now) {
            Option::Some(l2) => { bfree(l2); c.verdict = 10; },
            Option::None => {},
          }
          if !tls13c_note(&mut c, msg) { return tls13c_fail(&mut c, 1); }
          c.state = 3;
          return 0;
        },
      }
    },
    Option::Some(leaf) => {
      bfree(c.leaf);
      c.leaf = leaf;
      if !tls13c_note(&mut c, msg) { return tls13c_fail(&mut c, 1); }
      c.state = 3;
      return 0;
    },
  }
}

/// Internal: what the server signs in its CertificateVerify (RFC 8446
/// section 4.4.3): 64 spaces, a label, a zero byte and the transcript hash.
fn tls13c_signed_content(h: &Bytes) -> Bytes
  requires blen(h) == 32 || blen(h) == 48
  ensures blen(result) == 98 + blen(h)
{
  let mut t = text_new();
  let mut i = 0;
  while i < 64
    invariant i <= 64 && vlen(t) == i
  {
    text_push(&mut t, 32);
    i = i + 1;
  }
  text_push_str(&mut t, "TLS 1.3, server CertificateVerify");
  text_push(&mut t, 0);
  text_push_bytes(&mut t, h);
  return text_finish(t);
}

/// Internal: handles the CertificateVerify `msg` (state 3).
fn tls13c_certificate_verify(c: &mut Tls13Client, msg: &Bytes) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576
  ensures tls13c_ok(c)
{
  let n = blen(msg);
  if n < 8 || bget(msg, 0) != 15 || tls13c_u24(msg, 1) + 4 != n || tls13c_u16(msg, 6) + 8 != n {
    return tls13c_fail(&mut c, 1);
  }
  let scheme = tls13c_u16(msg, 4);
  let sig = bytes_slice(msg, 8, n);
  let h = tls13c_hash(c);
  let content = tls13c_signed_content(h);
  let mut ok = false;
  match x509_parse(c.leaf) {
    Option::None => {},
    Option::Some(x) => {
      let ka = bytes_slice(c.leaf, x.key_a.start, x.key_a.end);
      let kb = bytes_slice(c.leaf, x.key_b.start, x.key_b.end);
      if scheme == 2055 && x.key_kind == 3 && blen(ka) == 32 && blen(sig) == 64 {
        ok = ed25519_verify(ka, content, sig);
      }
      if scheme == 1027 && x.key_kind == 2 && blen(sig) < 274877906944 {
        ok = ecdsa_p256_verify(ka, content, sig);
      }
      if scheme == 1283 && x.key_kind == 4 && blen(sig) < 274877906944 {
        ok = ecdsa_p384_verify(ka, content, sig);
      }
      if scheme == 2053 && x.key_kind == 1 && blen(ka) < 65536 && blen(kb) < 65536 && blen(sig) < 65536 {
        ok = rsa_pss_verify(ka, kb, content, sig, 48);
      }
      if scheme == 2052 && x.key_kind == 1 && blen(ka) < 65536 && blen(kb) < 65536 && blen(sig) < 65536 {
        ok = rsa_pss_sha256_verify(ka, kb, content, sig);
      }
      bfree(kb);
      bfree(ka);
    },
  }
  bfree(content);
  bfree(h);
  bfree(sig);
  if !ok { return tls13c_fail(&mut c, 7); }
  if !tls13c_note(&mut c, msg) { return tls13c_fail(&mut c, 1); }
  c.state = 4;
  return 0;
}

/// Internal: appends a record of type `ty` carrying `plain`, sealed with
/// the client's keys, to `out`.
fn tls13c_send_record(c: &mut Tls13Client, ty: u8, plain: &Bytes, out: &mut Vec[u8]) -> bool
  requires tls13c_ok(c) && blen(plain) <= 16384
  ensures tls13c_ok(c)
{
  if c.v12 { return tls12c_seal(&mut c, ty, plain, &mut out); }
  if c.c_seq >= 4611686018427387904 { return false; }
  let rec = tls13_seal(c.c_suite, c.c_key, c.c_iv, c.c_seq, ty, plain, 0);
  c.c_seq = c.c_seq + 1;
  text_push_bytes(&mut out, rec);
  bfree(rec);
  return true;
}

/// Internal: adds the handshake message `msg` to the transcript and sends it,
/// sealed with the client's keys, in as many records as it takes.
fn tls13c_send_message(c: &mut Tls13Client, msg: &Bytes, out: &mut Vec[u8]) -> bool
  requires tls13c_ok(c) && blen(msg) < 1048576
  ensures tls13c_ok(c)
{
  if !tls13c_note(&mut c, msg) { return false; }
  let mut at = 0;
  while at < blen(msg)
    invariant at <= blen(msg) && tls13c_ok(c) && blen(msg) < 1048576
  {
    let mut end = blen(msg);
    if end - at > 16384 { end = at + 16384; }
    let piece = bytes_slice(msg, at, end);
    let sent = tls13c_send_record(&mut c, 22, piece, &mut out);
    bfree(piece);
    if !sent { return false; }
    at = end;
  }
  return true;
}

/// Internal: sends the client's Certificate, and its CertificateVerify when
/// the server asked for a certificate and the client has one that fits.
fn tls13c_client_flight(c: &mut Tls13Client, out: &mut Vec[u8]) -> u64
  requires tls13c_ok(c)
  ensures tls13c_ok(c)
{
  let scheme = c.creq;
  let mut have = false;
  let mut cm = balloc(0);
  if (scheme == 1027 || scheme == 2052) && blen(c.cleaf) > 0 {
    match tls13_certificate_msg(c.cleaf) {
      Option::Some(m) => { bfree(cm); cm = m; have = true; },
      Option::None => {},
    }
  }
  if !have {
    bfree(cm);
    let mut e = text_new();
    text_push(&mut e, 0);
    text_push(&mut e, 0);
    text_push(&mut e, 0);
    text_push(&mut e, 0);
    cm = tls13_wrap(11, text_finish(e));
  }
  let ok = blen(cm) < 1048576 && tls13c_send_message(&mut c, cm, &mut out);
  bfree(cm);
  if !ok { return tls13c_fail(&mut c, 1); }
  if !have { return 0; }
  let hh = tls13c_hash(c);
  let content = tls13_client_signed_content(hh);
  bfree(hh);
  match tls13_sign(c.ck_kind, c.sk_a, c.sk_b, c.ck_nonce, content, scheme) {
    Option::None => { bfree(content); return tls13c_fail(&mut c, 7); },
    Option::Some(sig) => {
      bfree(content);
      let mut t = text_new();
      tls13_push_u16(&mut t, scheme);
      tls13_push_block16(&mut t, sig);
      bfree(sig);
      let cv = tls13_wrap(15, text_finish(t));
      let sent = blen(cv) < 1048576 && tls13c_send_message(&mut c, cv, &mut out);
      bfree(cv);
      if !sent { return tls13c_fail(&mut c, 1); }
    },
  }
  return 0;
}

/// Internal: handles the server's Finished `msg` (state 4), sends the
/// client's, and switches to the application keys.
fn tls13c_finished(c: &mut Tls13Client, msg: &Bytes, out: &mut Vec[u8]) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576
  ensures tls13c_ok(c)
{
  let n = blen(msg);
  let hl = blen(c.s_hs);
  if n != 4 + hl || bget(msg, 0) != 20 || tls13c_u24(msg, 1) != hl { return tls13c_fail(&mut c, 1); }
  let h = tls13c_hash(c);
  let want = tls13_finished(c.s_hs, h);
  let got = bytes_slice(msg, 4, 4 + hl);
  let same = bytes_eq(want, got);
  bfree(got);
  bfree(want);
  bfree(h);
  if !same { return tls13c_fail(&mut c, 8); }
  if !tls13c_note(&mut c, msg) { return tls13c_fail(&mut c, 1); }
  // The application secrets cover the transcript up to the server's
  // Finished; a client certificate, if asked for, goes before the client's own.
  let happ = tls13c_hash(c);
  // A change cipher spec record for middleboxes, then the rest.
  text_push(&mut out, 20);
  text_push(&mut out, 3);
  text_push(&mut out, 3);
  text_push(&mut out, 0);
  text_push(&mut out, 1);
  text_push(&mut out, 1);
  if c.creq > 0 {
    let code = tls13c_client_flight(&mut c, &mut out);
    if code != 0 { bfree(happ); return code; }
  }
  // The client's Finished covers the transcript up to the end of the flight.
  let h2 = tls13c_hash(c);
  let mine = tls13_finished(c.c_hs, h2);
  bfree(h2);
  let mut fm = text_new();
  text_push(&mut fm, 20);
  text_push(&mut fm, 0);
  text_push(&mut fm, 0);
  text_push(&mut fm, cast[u8](hl));
  text_push_bytes(&mut fm, mine);
  let fin = text_finish(fm);
  bfree(mine);
  let sent = tls13c_send_record(&mut c, 22, fin, &mut out);
  bfree(fin);
  if !sent { bfree(happ); return tls13c_fail(&mut c, 1); }
  tls13c_application_keys_for(&mut c, happ);
  bfree(happ);
  c.state = 5;
  return 0;
}

/// Internal: the next traffic secret after `secret` (RFC 8446 section 7.2).
fn tls13c_update_secret(secret: &Bytes) -> Bytes
  requires blen(secret) == 32 || blen(secret) == 48
  ensures blen(result) == blen(secret)
{
  let empty = balloc(0);
  let r = tls13_expand_label(secret, "traffic upd", empty, blen(secret));
  bfree(empty);
  return r;
}

/// Internal: handles a handshake message `msg` after the handshake (state 5):
/// NewSessionTicket is ignored and KeyUpdate changes the keys.
fn tls13c_after(c: &mut Tls13Client, msg: &Bytes, out: &mut Vec[u8]) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576
  ensures tls13c_ok(c)
{
  let n = blen(msg);
  if n >= 4 && bget(msg, 0) == 4 { return 0; }
  if n != 5 || bget(msg, 0) != 24 || tls13c_u24(msg, 1) != 1 || bget(msg, 4) > 1 {
    return tls13c_fail(&mut c, 2);
  }
  let next = tls13c_update_secret(c.s_secret);
  bfree(c.s_secret);
  c.s_secret = next;
  let k3 = bytes_slice(c.s_secret, 0, blen(c.s_secret));
  tls13c_keys(&mut c, k3, false);
  bfree(k3);
  if bget(msg, 4) == 1 && !c.sent_close {
    // The peer asked for the client's keys to change too: say so is not
    // needed, send an update that asks for nothing, then change.
    let mut up = text_new();
    text_push(&mut up, 24);
    text_push(&mut up, 0);
    text_push(&mut up, 0);
    text_push(&mut up, 1);
    text_push(&mut up, 0);
    let ub = text_finish(up);
    let sent = tls13c_send_record(&mut c, 22, ub, &mut out);
    bfree(ub);
    if !sent { return tls13c_fail(&mut c, 1); }
    let cn = tls13c_update_secret(c.c_secret);
    bfree(c.c_secret);
    c.c_secret = cn;
    let k4 = bytes_slice(c.c_secret, 0, blen(c.c_secret));
    tls13c_keys(&mut c, k4, true);
    bfree(k4);
  }
  return 0;
}

/// Internal: handles a CertificateRequest `msg` (state 2): the client picks
/// a signature scheme for its own key, or none.
fn tls13c_cert_request(c: &mut Tls13Client, msg: &Bytes) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576
  ensures tls13c_ok(c)
{
  let n = blen(msg);
  if n < 7 || bget(msg, 0) != 13 || tls13c_u24(msg, 1) + 4 != n || bget(msg, 4) != 0 || tls13c_u16(msg, 5) + 7 != n {
    return tls13c_fail(&mut c, 1);
  }
  let mut at = 7;
  let mut pick = 1;
  while at < n
    invariant at <= n && n == blen(msg) && tls13c_ok(c) && (pick == 1 || pick == 1027 || pick == 2052)
  {
    if n - at < 4 { return tls13c_fail(&mut c, 1); }
    let ty = tls13c_u16(msg, at);
    let l = tls13c_u16(msg, at + 2);
    if n - at - 4 < l { return tls13c_fail(&mut c, 1); }
    if ty == 13 {
      if l < 2 || tls13c_u16(msg, at + 4) + 2 != l { return tls13c_fail(&mut c, 1); }
      let e = at + 4 + l;
      let mut q = at + 6;
      while q + 2 <= e
        invariant q <= e + 1 && e <= n && n == blen(msg) && tls13c_ok(c) && (pick == 1 || pick == 1027 || pick == 2052)
      {
        let sc = tls13c_u16(msg, q);
        if sc == 1027 && c.ck_kind == 2 { pick = 1027; }
        if sc == 2052 && c.ck_kind == 1 && pick == 1 { pick = 2052; }
        q = q + 2;
      }
    }
    at = at + 4 + l;
  }
  if !tls13c_note(&mut c, msg) { return tls13c_fail(&mut c, 1); }
  c.creq = pick;
  return 0;
}

/// Gives the client a certificate to show if the server asks for one (TLS
/// 1.3): `chain` is the DER certificates, the client's own first, `kind` 1 for
/// an RSA key (`ka` the modulus, `kb` the private exponent, signing with
/// rsa_pss_rsae_sha256) or 2 for an ECDSA P-256 key (`ka` the scalar), and
/// `nonce` 32 unpredictable bytes. A server that asks and a client without a
/// usable key get an empty Certificate.
/// ```
/// let mut c = tls13c_blank();
/// let chain = balloc(0);
/// let ka = balloc(32);
/// let kb = balloc(0);
/// let nonce = balloc(32);
/// if tls13c_check(c) { tls13c_identity(&mut c, chain, 2, ka, kb, nonce); }
/// bfree(nonce);
/// bfree(kb);
/// bfree(ka);
/// bfree(chain);
/// tls13c_free(c);
/// ```
fn tls13c_identity(c: &mut Tls13Client, chain: &Bytes, kind: u64, ka: &Bytes, kb: &Bytes, nonce: &Bytes)
  requires tls13c_ok(c) && blen(chain) < 1048576 && blen(ka) < 65536 && blen(kb) < 65536 && blen(nonce) < 1024
  ensures tls13c_ok(c)
{
  bfree(c.cleaf);
  bfree(c.sk_a);
  bfree(c.sk_b);
  bfree(c.ck_nonce);
  c.cleaf = bytes_slice(chain, 0, blen(chain));
  c.sk_a = bytes_slice(ka, 0, blen(ka));
  c.sk_b = bytes_slice(kb, 0, blen(kb));
  c.ck_nonce = bytes_slice(nonce, 0, blen(nonce));
  if kind == 1 || kind == 2 { c.ck_kind = kind; } else { c.ck_kind = 0; }
}

/// Internal: handles the handshake message `msg` for the state of `c`.
fn tls13c_message(c: &mut Tls13Client, msg: &Bytes, roots: &Bytes, now: u64, out: &mut Vec[u8]) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576 && blen(roots) < 274877906944
  ensures tls13c_ok(c)
{
  if c.state == 1 { return tls13c_encrypted_extensions(&mut c, msg); }
  if c.state == 2 {
    if blen(msg) > 0 && bget(msg, 0) == 13 && c.creq == 0 { return tls13c_cert_request(&mut c, msg); }
    return tls13c_certificate(&mut c, msg, roots, now);
  }
  if c.state == 3 { return tls13c_certificate_verify(&mut c, msg); }
  if c.state == 4 { return tls13c_finished(&mut c, msg, &mut out); }
  if c.state == 5 { return tls13c_after(&mut c, msg, &mut out); }
  return tls13c_fail(&mut c, 2);
}

/// Internal: handles the handshake bytes `plain` that arrived in a record:
/// they are joined to what is left of earlier ones and cut into messages.
fn tls13c_handshake_data(c: &mut Tls13Client, plain: &Bytes, roots: &Bytes, now: u64, out: &mut Vec[u8]) -> u64
  requires tls13c_ok(c) && blen(plain) <= 16640 && blen(roots) < 274877906944
  ensures tls13c_ok(c)
{
  if blen(c.hsbuf) > 131072 { return tls13c_fail(&mut c, 1); }
  let joined = tls13c_append(c.hsbuf, plain);
  c.hsbuf = joined;
  let mut more = true;
  while more
    invariant tls13c_ok(c)
  {
    more = false;
    if blen(c.hsbuf) >= 4 {
      let len = tls13c_u24(c.hsbuf, 1);
      if len > 65536 { return tls13c_fail(&mut c, 1); }
      if blen(c.hsbuf) >= 4 + len {
        let msg = bytes_slice(c.hsbuf, 0, 4 + len);
        let rest = bytes_slice(c.hsbuf, 4 + len, blen(c.hsbuf));
        bfree(c.hsbuf);
        c.hsbuf = rest;
        let code = tls13c_message(&mut c, msg, roots, now, &mut out);
        bfree(msg);
        if code != 0 { return code; }
        more = true;
      }
    }
  }
  return 0;
}

/// Internal: handles one whole record `rec` (with its header).
fn tls13c_record(c: &mut Tls13Client, rec: &Bytes, roots: &Bytes, now: u64, out: &mut Vec[u8], app: &mut Vec[u8]) -> u64
  requires tls13c_ok(c) && blen(rec) >= 5 && blen(rec) <= 16645 && blen(roots) < 274877906944
  ensures tls13c_ok(c)
{
  if c.v12 { return tls12c_record(&mut c, rec, roots, now, &mut out, &mut app); }
  let ty = bget(rec, 0);
  let n = blen(rec) - 5;
  if ty == 22 && c.state == 0 && c.allow12 {
    // The ServerHello of a client that offered TLS 1.2 too, perhaps with the
    // rest of a TLS 1.2 server's first flight behind it.
    let body = bytes_slice(rec, 5, blen(rec));
    let code = tls12c_handshake_data(&mut c, body, roots, now, &mut out);
    bfree(body);
    return code;
  }
  if ty == 20 {
    // Change cipher spec, only for middleboxes, once the handshake is under way.
    if c.state >= 1 && c.state <= 4 && n == 1 && bget(rec, 5) == 1 { return 0; }
    return tls13c_fail(&mut c, 2);
  }
  if ty == 21 { return tls13c_fail(&mut c, 9); }
  if ty == 22 {
    if c.state != 0 { return tls13c_fail(&mut c, 2); }
    let msg = bytes_slice(rec, 5, blen(rec));
    let mut code = 1;
    if n >= 4 && tls13c_u24(msg, 1) + 4 == n {
      code = tls13c_server_hello(&mut c, msg);
    } else {
      code = tls13c_fail(&mut c, 1);
    }
    bfree(msg);
    return code;
  }
  if ty == 23 && c.state >= 1 && c.state <= 5 {
    if c.s_seq >= 4611686018427387904 { return tls13c_fail(&mut c, 5); }
    match tls13_open(c.s_suite, c.s_key, c.s_iv, c.s_seq, rec) {
      Option::None => { return tls13c_fail(&mut c, 5); },
      Option::Some(r) => {
        c.s_seq = c.s_seq + 1;
        let mut code = 0;
        if r.content_type == 22 {
          code = tls13c_handshake_data(&mut c, r.data, roots, now, &mut out);
        } else if r.content_type == 21 {
          // An alert: close_notify ends the connection, any other one is an error.
          if blen(r.data) == 2 && bget(r.data, 1) == 0 && c.state == 5 {
            c.state = 6;
          } else {
            code = tls13c_fail(&mut c, 9);
          }
        } else if r.content_type == 23 && c.state == 5 {
          text_push_bytes(&mut app, r.data);
        } else {
          code = tls13c_fail(&mut c, 2);
        }
        bfree(r.data);
        return code;
      },
    }
  }
  return tls13c_fail(&mut c, 2);
}

/// Gives the client the bytes `data` that arrived from the server. Whole
/// records are handled in turn; what they ask the client to send is appended
/// to `out`, application data from the server to `app`. `roots` are the
/// trusted certificates (DER, one after the other) and `now` the time in
/// seconds since 1970. Returns 0, or an error code once the connection has
/// failed (and `tls13c_state` is 7): 1 malformed, 2 unexpected message, 3 bad
/// ServerHello, 4 bad key exchange, 5 decryption failed, 6 certificate
/// rejected, 7 bad signature, 8 bad Finished, 9 alert from the server.
/// ```
/// let r = balloc(32);
/// let s = balloc(32);
/// let k = balloc(32);
/// let name = bfrom("example.com");
/// let mut out = text_new();
/// let mut app = text_new();
/// let mut c = tls13c_new(r, s, k, name, &mut out);
/// let junk = balloc(8);
/// let roots = balloc(0);
/// let code = tls13c_feed(&mut c, junk, roots, 1800000000, &mut out, &mut app);
/// let st = tls13c_state(c);
/// tls13c_free(c);
/// vec_free(app);
/// vec_free(out);
/// bfree(roots);
/// bfree(junk);
/// bfree(name);
/// bfree(k);
/// bfree(s);
/// bfree(r);
/// if code == 0 || st != 7 { return 1; }
/// ```
fn tls13c_feed(c: &mut Tls13Client, data: &Bytes, roots: &Bytes, now: u64, out: &mut Vec[u8], app: &mut Vec[u8]) -> u64
  requires tls13c_ok(c) && blen(data) < 1048576 && blen(roots) < 274877906944
  ensures tls13c_ok(c)
{
  if c.state == 7 { return 1; }
  if c.state == 6 { return 0; }
  if blen(c.inbuf) + blen(data) >= 67108864 { return tls13c_fail(&mut c, 1); }
  let joined = tls13c_append(c.inbuf, data);
  c.inbuf = joined;
  let mut more = true;
  while more
    invariant tls13c_ok(c)
  {
    more = false;
    if c.state <= 5 && blen(c.inbuf) >= 5 {
      let len = tls13c_u16(c.inbuf, 3);
      if len > 16640 || len == 0 {
        return tls13c_fail(&mut c, 1);
      }
      if blen(c.inbuf) >= 5 + len {
        let rec = bytes_slice(c.inbuf, 0, 5 + len);
        let rest = bytes_slice(c.inbuf, 5 + len, blen(c.inbuf));
        bfree(c.inbuf);
        c.inbuf = rest;
        let code = tls13c_record(&mut c, rec, roots, now, &mut out, &mut app);
        bfree(rec);
        if code != 0 { return code; }
        more = true;
      }
    }
  }
  return 0;
}

/// Seals `data` as application data records and appends them to `out`. False
/// unless the handshake is complete.
/// ```
/// let r = balloc(32);
/// let s = balloc(32);
/// let k = balloc(32);
/// let name = bfrom("example.com");
/// let mut out = text_new();
/// let mut c = tls13c_new(r, s, k, name, &mut out);
/// let data = bfrom("hello");
/// let sent = tls13c_send(&mut c, data, &mut out);
/// tls13c_free(c);
/// vec_free(out);
/// bfree(data);
/// bfree(name);
/// bfree(k);
/// bfree(s);
/// bfree(r);
/// if sent { return 1; }
/// ```
fn tls13c_send(c: &mut Tls13Client, data: &Bytes, out: &mut Vec[u8]) -> bool
  requires tls13c_ok(c) && blen(data) < 1073741824
{
  // After the peer's close_notify (state 6) the sending side stays open, as in
  // OpenSSL: a client may send a request and close, and still read the answer.
  if (c.state != 5 && c.state != 6) || c.sent_close { return false; }
  let mut at = 0;
  while at < blen(data)
    invariant at <= blen(data) && tls13c_ok(c) && blen(data) < 1073741824
  {
    let mut end = blen(data);
    if end - at > 16384 { end = at + 16384; }
    let piece = bytes_slice(data, at, end);
    let sent = tls13c_send_record(&mut c, 23, piece, &mut out);
    bfree(piece);
    if !sent { return false; }
    at = end;
  }
  return true;
}

/// Appends a close_notify alert to `out` and closes the connection on this
/// side. False unless the handshake is complete.
/// ```
/// let r = balloc(32);
/// let s = balloc(32);
/// let k = balloc(32);
/// let name = bfrom("example.com");
/// let mut out = text_new();
/// let mut c = tls13c_new(r, s, k, name, &mut out);
/// let closed = tls13c_close(&mut c, &mut out);
/// tls13c_free(c);
/// vec_free(out);
/// bfree(name);
/// bfree(k);
/// bfree(s);
/// bfree(r);
/// if closed { return 1; }
/// ```
fn tls13c_close(c: &mut Tls13Client, out: &mut Vec[u8]) -> bool
  requires tls13c_ok(c)
{
  if c.state != 5 || c.sent_close { return false; }
  let mut al = text_new();
  text_push(&mut al, 1);
  text_push(&mut al, 0);
  let ab = text_finish(al);
  let sent = tls13c_send_record(&mut c, 21, ab, &mut out);
  bfree(ab);
  c.state = 6;
  return sent;
}

/// Appends a close_notify alert to `out` and closes the sending side only:
/// `tls13c_send` refuses from now on, but `tls13c_feed` still takes what the
/// server sends until it closes too (state 6). False unless the handshake is
/// complete (or it was already shut).
/// ```
/// let r = balloc(32);
/// let s = balloc(32);
/// let k = balloc(32);
/// let name = bfrom("example.com");
/// let mut out = text_new();
/// let mut c = tls13c_new(r, s, k, name, &mut out);
/// let shut = tls13c_shutdown(&mut c, &mut out);
/// tls13c_free(c);
/// vec_free(out);
/// bfree(name);
/// bfree(k);
/// bfree(s);
/// bfree(r);
/// if shut { return 1; }
/// ```
fn tls13c_shutdown(c: &mut Tls13Client, out: &mut Vec[u8]) -> bool
  requires tls13c_ok(c)
  ensures tls13c_ok(c)
{
  if c.state != 5 || c.sent_close { return false; }
  let mut al = text_new();
  text_push(&mut al, 1);
  text_push(&mut al, 0);
  let ab = text_finish(al);
  let sent = tls13c_send_record(&mut c, 21, ab, &mut out);
  bfree(ab);
  c.sent_close = true;
  return sent;
}

// ---- TLS 1.2 (RFC 5246, 5289, 7905, 7627) for a client made with option 2 ----

/// Internal: an HMAC with SHA-384 when `big`, else with SHA-256.
fn tls12c_hmac(big: bool, key: &Bytes, msg: &Bytes) -> Bytes
  ensures blen(result) == 32 || blen(result) == 48
{
  if big { return hmac_sha384(key, msg); }
  return hmac_sha256(key, msg);
}

/// Internal: the TLS 1.2 PRF (P_SHA256, or P_SHA384 when `big`): `n` bytes
/// from `secret`, the `label` and `seed`.
fn tls12c_prf(big: bool, secret: &Bytes, label: Str, seed: &Bytes, n: u64) -> Bytes
  requires n <= 256 && slen(label) <= 64 && blen(seed) <= 1024
  ensures blen(result) == n
{
  let mut t = text_new();
  text_push_str(&mut t, label);
  text_push_bytes(&mut t, seed);
  let ls = text_finish(t);
  let mut a = tls12c_hmac(big, secret, ls);
  let mut out = text_new();
  let mut rounds = 0;
  while vec_len(out) < n && rounds < 16
    invariant rounds <= 16 && vlen(out) <= rounds * 48 && (blen(a) == 32 || blen(a) == 48) && blen(ls) <= 1088
  {
    let x = bytes_concat(a, ls);
    let b = tls12c_hmac(big, secret, x);
    text_push_bytes(&mut out, b);
    bfree(b);
    bfree(x);
    let a2 = tls12c_hmac(big, secret, a);
    bfree(a);
    a = a2;
    rounds = rounds + 1;
  }
  bfree(a);
  bfree(ls);
  let o = text_finish(out);
  if blen(o) < n {
    bfree(o);
    return balloc(n);
  }
  let r = bytes_slice(o, 0, n);
  bfree(o);
  return r;
}

/// Internal: the additional data of a TLS 1.2 AEAD record: the sequence
/// number, the type, the version and the length of the plaintext.
fn tls12c_aad(seq: u64, ty: u8, len: u64) -> Bytes
  requires len < 65536
  ensures blen(result) == 13
{
  let mut t = text_new();
  let mut i = 0;
  while i < 8
    invariant i <= 8 && vlen(t) == i
  {
    text_push(&mut t, cast[u8]((seq >> (56 - 8 * i)) & 255));
    i = i + 1;
  }
  text_push(&mut t, ty);
  text_push(&mut t, 3);
  text_push(&mut t, 3);
  text_push(&mut t, cast[u8](len / 256));
  text_push(&mut t, cast[u8](len % 256));
  return text_finish(t);
}

/// Internal: appends a TLS 1.2 record of type `ty` with `body` as it is.
fn tls12c_plain(out: &mut Vec[u8], ty: u8, body: &Bytes)
  requires blen(body) < 65536
{
  text_push(&mut out, ty);
  text_push(&mut out, 3);
  text_push(&mut out, 3);
  text_push(&mut out, cast[u8](blen(body) / 256));
  text_push(&mut out, cast[u8](blen(body) % 256));
  text_push_bytes(&mut out, body);
}

/// Internal: seals `plain` as a TLS 1.2 record of type `ty` with the
/// client's keys (AES-GCM with the sequence number as the explicit nonce, or
/// ChaCha20-Poly1305 with the nonce of RFC 7905) and appends it to `out`.
fn tls12c_seal(c: &mut Tls13Client, ty: u8, plain: &Bytes, out: &mut Vec[u8]) -> bool
  requires tls13c_ok(c) && blen(plain) <= 16384
  ensures tls13c_ok(c)
{
  if c.c_seq >= 4611686018427387904 { return false; }
  let seq = c.c_seq;
  let nonce = tls13_nonce(c.c_iv, seq);
  let aad = tls12c_aad(seq, ty, blen(plain));
  let ct = tls13_aead_seal(c.c_suite, c.c_key, nonce, aad, plain);
  let gcm = c.c_suite != 4867;
  let mut n = blen(ct);
  if gcm { n = n + 8; }
  text_push(&mut out, ty);
  text_push(&mut out, 3);
  text_push(&mut out, 3);
  text_push(&mut out, cast[u8](n / 256));
  text_push(&mut out, cast[u8](n % 256));
  if gcm {
    let mut i = 0;
    while i < 8
      invariant i <= 8
    {
      text_push(&mut out, cast[u8]((seq >> (56 - 8 * i)) & 255));
      i = i + 1;
    }
  }
  text_push_bytes(&mut out, ct);
  bfree(ct);
  bfree(aad);
  bfree(nonce);
  c.c_seq = seq + 1;
  return true;
}

/// Internal: opens the TLS 1.2 record `rec` (with its header) with the
/// server's keys; the plaintext, or None if it is not genuine.
fn tls12c_open(c: &mut Tls13Client, rec: &Bytes) -> Option[Bytes]
  requires tls13c_ok(c) && blen(rec) >= 5 && blen(rec) <= 16645
  ensures tls13c_ok(c)
  ensures result is Option::Some ==> blen(result.Some) <= 16640
{
  if c.s_seq >= 4611686018427387904 { return Option[Bytes]::None; }
  let ty = bget(rec, 0);
  let n = blen(rec);
  let gcm = c.s_suite != 4867;
  let mut nonce = balloc(0);
  let mut ct = balloc(0);
  if gcm {
    if n < 5 + 8 + 16 { bfree(nonce); bfree(ct); return Option[Bytes]::None; }
    let salt = bytes_slice(c.s_iv, 0, 4);
    let explicit = bytes_slice(rec, 5, 13);
    bfree(nonce);
    nonce = bytes_concat(salt, explicit);
    bfree(explicit);
    bfree(salt);
    bfree(ct);
    ct = bytes_slice(rec, 13, n);
  } else {
    if n < 5 + 16 { bfree(nonce); bfree(ct); return Option[Bytes]::None; }
    bfree(nonce);
    nonce = tls13_nonce(c.s_iv, c.s_seq);
    bfree(ct);
    ct = bytes_slice(rec, 5, n);
  }
  let aad = tls12c_aad(c.s_seq, ty, blen(ct) - 16);
  let r = tls13_aead_open(c.s_suite, c.s_key, nonce, aad, ct);
  bfree(aad);
  bfree(ct);
  bfree(nonce);
  match r {
    Option::None => { return Option[Bytes]::None; },
    Option::Some(p) => {
      c.s_seq = c.s_seq + 1;
      return Option[Bytes]::Some(p);
    },
  }
}

/// Internal: does the signature `sig` with the scheme `scheme` (a TLS
/// SignatureScheme) over `content` check out with the key of the
/// certificate `leaf`?
fn tls12c_signed(leaf: &Bytes, scheme: u64, content: &Bytes, sig: &Bytes) -> bool
  requires blen(content) < 1048576 && blen(sig) < 65536 && blen(leaf) < 1048576
{
  let mut ok = false;
  match x509_parse(leaf) {
    Option::None => {},
    Option::Some(x) => {
      let ka = bytes_slice(leaf, x.key_a.start, x.key_a.end);
      let kb = bytes_slice(leaf, x.key_b.start, x.key_b.end);
      if scheme == 2055 && x.key_kind == 3 && blen(ka) == 32 && blen(sig) == 64 {
        ok = ed25519_verify(ka, content, sig);
      }
      if scheme == 1027 && x.key_kind == 2 {
        ok = ecdsa_p256_verify(ka, content, sig);
      }
      if scheme == 1283 && x.key_kind == 4 {
        ok = ecdsa_p384_verify(ka, content, sig);
      }
      if x.key_kind == 1 && blen(ka) < 65536 && blen(kb) < 65536 {
        if scheme == 2052 { ok = rsa_pss_sha256_verify(ka, kb, content, sig); }
        if scheme == 2053 { ok = rsa_pss_verify(ka, kb, content, sig, 48); }
        if scheme == 1025 { ok = rsa_pkcs1_verify(ka, kb, content, sig, 32); }
        if scheme == 1281 { ok = rsa_pkcs1_verify(ka, kb, content, sig, 48); }
        if scheme == 1537 { ok = rsa_pkcs1_verify(ka, kb, content, sig, 64); }
      }
      bfree(kb);
      bfree(ka);
    },
  }
  return ok;
}

/// Internal: the ServerHello `msg` if it is one for TLS 1.2 (no
/// supported_versions extension); returns 1000 when it is not, for the TLS
/// 1.3 path to take it.
fn tls12c_server_hello(c: &mut Tls13Client, msg: &Bytes) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576
  ensures tls13c_ok(c)
{
  let n = blen(msg);
  if n < 42 || bget(msg, 0) != 2 || tls13c_u24(msg, 1) + 4 != n || tls13c_u16(msg, 4) != 771 { return 1000; }
  let sl = cast[u64](bget(msg, 38));
  if sl > 32 || n < 39 + sl + 3 { return 1000; }
  let at = 39 + sl;
  let suite = tls13c_u16(msg, at);
  let comp = bget(msg, at + 2);
  let mut p = at + 3;
  let mut end = n;
  if n > p {
    if n - p < 2 { return 1000; }
    if tls13c_u16(msg, p) + p + 2 != n { return 1000; }
    p = p + 2;
  }
  // Is it TLS 1.3 (supported_versions)? Then it is not ours.
  let mut q = p;
  while q < end
    invariant q <= end && end == n && n == blen(msg) && tls13c_ok(c)
  {
    if end - q < 4 { return 1000; }
    let ty = tls13c_u16(msg, q);
    let l = tls13c_u16(msg, q + 2);
    if end - q - 4 < l { return 1000; }
    if ty == 43 {
      if c.only12 { return tls13c_fail(&mut c, 3); }
      return 1000;
    }
    q = q + 4 + l;
  }
  if !c.allow12 { return 1000; }
  // A TLS 1.3 server that was made to fall back says so in its random (a
  // client that offered only TLS 1.2 did not ask for 1.3 and does not look).
  if !c.only12 && bytes_span_eq_str(msg, 30, 37, "DOWNGRD") { return tls13c_fail(&mut c, 3); }
  if comp != 0 { return tls13c_fail(&mut c, 3); }
  let mut aead = 0;
  if suite == 49195 || suite == 49199 { aead = 4865; }
  if suite == 49196 || suite == 49200 { aead = 4866; }
  if suite == 52393 || suite == 52392 { aead = 4867; }
  if aead == 0 { return tls13c_fail(&mut c, 3); }
  let mut ems = false;
  let mut reneg = false;
  let mut chosen = balloc(0);
  while p < end
    invariant p <= end && end == n && n == blen(msg) && blen(chosen) <= 255 && tls13c_ok(c)
  {
    if end - p < 4 { bfree(chosen); return tls13c_fail(&mut c, 3); }
    let ty = tls13c_u16(msg, p);
    let l = tls13c_u16(msg, p + 2);
    if end - p - 4 < l { bfree(chosen); return tls13c_fail(&mut c, 3); }
    if ty == 23 {
      if l != 0 || ems { bfree(chosen); return tls13c_fail(&mut c, 3); }
      ems = true;
    } else if ty == 65281 {
      // renegotiation_info: empty in a first handshake.
      if l != 1 || bget(msg, p + 4) != 0 || reneg { bfree(chosen); return tls13c_fail(&mut c, 3); }
      reneg = true;
    } else if ty == 16 {
      if l < 4 || blen(chosen) != 0 { bfree(chosen); return tls13c_fail(&mut c, 3); }
      let nl = cast[u64](bget(msg, p + 6));
      if tls13c_u16(msg, p + 4) != l - 2 || nl + 3 != l || nl == 0 { bfree(chosen); return tls13c_fail(&mut c, 3); }
      let name = bytes_slice(msg, p + 7, p + 7 + nl);
      if !tls13c_offered(c.alpn, name) { bfree(name); bfree(chosen); return tls13c_fail(&mut c, 3); }
      bfree(chosen);
      chosen = name;
    } else if ty == 11 || (ty == 0 && l == 0) {
      // ec_point_formats, or the server saw the name.
    } else {
      bfree(chosen);
      return tls13c_fail(&mut c, 3);
    }
    p = p + 4 + l;
  }
  if blen(c.rnd) != 32 { bfree(chosen); return tls13c_fail(&mut c, 3); }
  let sr = bytes_slice(msg, 6, 38);
  let both = tls13c_append(c.rnd, sr);
  c.rnd = both;
  bfree(sr);
  bfree(c.alpn);
  c.alpn = chosen;
  tls13c_set_suite(&mut c, aead);
  if !tls13c_note(&mut c, msg) { return tls13c_fail(&mut c, 1); }
  c.v12 = true;
  c.cs12 = suite;
  c.ems = ems;
  c.step = 0;
  c.state = 1;
  return 0;
}

/// Internal: the TLS 1.2 Certificate `msg`, checked as `tls13c_certificate`
/// checks a TLS 1.3 one (it is rewritten in that form first).
fn tls12c_certificate(c: &mut Tls13Client, msg: &Bytes, roots: &Bytes, now: u64) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576 && blen(roots) < 274877906944
  ensures tls13c_ok(c)
{
  let n = blen(msg);
  if n < 7 || bget(msg, 0) != 11 || tls13c_u24(msg, 1) + 4 != n || tls13c_u24(msg, 4) + 7 != n {
    return tls13c_fail(&mut c, 1);
  }
  let mut list = text_new();
  let mut at = 7;
  let mut count = 0;
  while at < n
    invariant at <= n && n == blen(msg) && count <= 9 && vlen(list) <= at + 2 * count && tls13c_ok(c)
  {
    if n - at < 3 || count >= 9 { vec_free(list); return tls13c_fail(&mut c, 6); }
    let cl = tls13c_u24(msg, at);
    if n - at - 3 < cl { vec_free(list); return tls13c_fail(&mut c, 1); }
    let cert = bytes_slice(msg, at, at + 3 + cl);
    text_push_bytes(&mut list, cert);
    bfree(cert);
    text_push(&mut list, 0);
    text_push(&mut list, 0);
    at = at + 3 + cl;
    count = count + 1;
  }
  let ln = vec_len(list);
  let mut m = text_new();
  text_push(&mut m, 11);
  text_push(&mut m, cast[u8](((ln + 4) >> 16) & 255));
  text_push(&mut m, cast[u8](((ln + 4) >> 8) & 255));
  text_push(&mut m, cast[u8]((ln + 4) & 255));
  text_push(&mut m, 0);
  text_push(&mut m, cast[u8]((ln >> 16) & 255));
  text_push(&mut m, cast[u8]((ln >> 8) & 255));
  text_push(&mut m, cast[u8](ln & 255));
  let lb = text_finish(list);
  text_push_bytes(&mut m, lb);
  bfree(lb);
  let m13 = text_finish(m);
  if blen(m13) >= 1048576 { bfree(m13); return tls13c_fail(&mut c, 1); }
  let mut leaf = balloc(0);
  let mut good = false;
  match tls13c_chain(m13, c.name, roots, now) {
    Option::Some(l) => { bfree(leaf); leaf = l; good = true; },
    Option::None => {},
  }
  if !good && !c.verify {
    match tls13c_first_cert(m13) {
      Option::Some(l) => {
        bfree(leaf);
        leaf = l;
        good = true;
        c.verdict = 6;
        match tls13c_chain_for(m13, c.name, false, roots, now) {
          Option::Some(l2) => { bfree(l2); c.verdict = 10; },
          Option::None => {},
        }
      },
      Option::None => {},
    }
  }
  if !good {
    match tls13c_first_cert(m13) {
      Option::None => {},
      Option::Some(l0) => {
        bfree(c.leaf);
        c.leaf = l0;
        c.verdict = 6;
        match tls13c_chain_for(m13, c.name, false, roots, now) {
          Option::Some(l2) => { bfree(l2); c.verdict = 10; },
          Option::None => {},
        }
      },
    }
  }
  bfree(m13);
  if !good { bfree(leaf); return tls13c_fail(&mut c, 6); }
  bfree(c.leaf);
  c.leaf = leaf;
  if !tls13c_note(&mut c, msg) { return tls13c_fail(&mut c, 1); }
  c.step = 1;
  return 0;
}

/// Internal: the ServerKeyExchange `msg`: an X25519 share signed with the
/// key of the server's certificate over both randoms and the parameters.
fn tls12c_key_exchange(c: &mut Tls13Client, msg: &Bytes) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576
  ensures tls13c_ok(c)
{
  let n = blen(msg);
  if n < 44 || bget(msg, 0) != 12 || tls13c_u24(msg, 1) + 4 != n { return tls13c_fail(&mut c, 1); }
  if bget(msg, 4) != 3 || tls13c_u16(msg, 5) != 29 || bget(msg, 7) != 32 { return tls13c_fail(&mut c, 4); }
  let scheme = tls13c_u16(msg, 40);
  let sl = tls13c_u16(msg, 42);
  if sl + 44 != n { return tls13c_fail(&mut c, 1); }
  if blen(c.rnd) != 64 { return tls13c_fail(&mut c, 4); }
  let params = bytes_slice(msg, 4, 40);
  let content = bytes_concat(c.rnd, params);
  let sig = bytes_slice(msg, 44, n);
  let ok = tls12c_signed(c.leaf, scheme, content, sig);
  bfree(sig);
  bfree(content);
  bfree(params);
  if !ok { return tls13c_fail(&mut c, 7); }
  let share = bytes_slice(msg, 8, 40);
  let shared = x25519(c.priv_key, share);
  bfree(share);
  if tls13c_all_zero(shared) { bfree(shared); return tls13c_fail(&mut c, 4); }
  bfree(c.ms);
  c.ms = shared;
  if !tls13c_note(&mut c, msg) { return tls13c_fail(&mut c, 1); }
  c.step = 2;
  return 0;
}

/// Internal: the key block from the master secret: the write keys and IVs
/// (an AES-GCM salt of 4 bytes is kept as the first 4 of 12, then zeros, so
/// tls13_nonce puts the sequence number behind it).
fn tls12c_keys(c: &mut Tls13Client)
  requires tls13c_ok(c) && blen(c.rnd) == 64 && blen(c.ms) == 48
  ensures tls13c_ok(c)
{
  let mut kl = 32;
  if c.suite == 4865 { kl = 16; }
  let mut il = 4;
  if c.suite == 4867 { il = 12; }
  let sr = bytes_slice(c.rnd, 32, 64);
  let cr = bytes_slice(c.rnd, 0, 32);
  let seed = bytes_concat(sr, cr);
  let kb = tls12c_prf(c.suite == 4866, c.ms, "key expansion", seed, 2 * kl + 2 * il);
  let ck = bytes_slice(kb, 0, kl);
  let sk = bytes_slice(kb, kl, 2 * kl);
  let ci = bytes_slice(kb, 2 * kl, 2 * kl + il);
  let si = bytes_slice(kb, 2 * kl + il, 2 * kl + 2 * il);
  let pad = balloc(12 - il);
  let civ = bytes_concat(ci, pad);
  let siv = bytes_concat(si, pad);
  bfree(c.c_key);
  bfree(c.s_key);
  bfree(c.c_iv);
  bfree(c.s_iv);
  c.c_key = ck;
  c.s_key = sk;
  c.c_iv = civ;
  c.s_iv = siv;
  c.c_suite = c.suite;
  c.s_suite = c.suite;
  c.c_seq = 0;
  c.s_seq = 0;
  bfree(pad);
  bfree(si);
  bfree(ci);
  bfree(kb);
  bfree(seed);
  bfree(cr);
  bfree(sr);
}

/// Internal: the ServerHelloDone `msg`: the client sends its share, changes
/// to the new keys and sends its Finished.
fn tls12c_hello_done(c: &mut Tls13Client, msg: &Bytes, out: &mut Vec[u8]) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576
  ensures tls13c_ok(c)
{
  if blen(msg) != 4 || bget(msg, 0) != 14 || bget(msg, 1) != 0 || bget(msg, 2) != 0 || bget(msg, 3) != 0 { return tls13c_fail(&mut c, 1); }
  if !tls13c_note(&mut c, msg) { return tls13c_fail(&mut c, 1); }
  if blen(c.ms) != 32 || blen(c.rnd) != 64 { return tls13c_fail(&mut c, 4); }
  let base = tls13c_base();
  let pubkey = x25519(c.priv_key, base);
  bfree(base);
  let mut k = text_new();
  text_push(&mut k, 16);
  text_push(&mut k, 0);
  text_push(&mut k, 0);
  text_push(&mut k, 33);
  text_push(&mut k, 32);
  text_push_bytes(&mut k, pubkey);
  bfree(pubkey);
  let cke = text_finish(k);
  if !tls13c_note(&mut c, cke) { bfree(cke); return tls13c_fail(&mut c, 1); }
  let big = c.suite == 4866;
  let mut ms = balloc(0);
  if c.ems {
    let h = tls13c_hash(c);
    bfree(ms);
    ms = tls12c_prf(big, c.ms, "extended master secret", h, 48);
    bfree(h);
  } else {
    bfree(ms);
    ms = tls12c_prf(big, c.ms, "master secret", c.rnd, 48);
  }
  bfree(c.ms);
  c.ms = ms;
  tls12c_keys(&mut c);
  tls12c_plain(&mut out, 22, cke);
  bfree(cke);
  let mut cs = text_new();
  text_push(&mut cs, 1);
  let ccs = text_finish(cs);
  tls12c_plain(&mut out, 20, ccs);
  bfree(ccs);
  let h2 = tls13c_hash(c);
  let vd = tls12c_prf(big, c.ms, "client finished", h2, 12);
  bfree(h2);
  let mut f = text_new();
  text_push(&mut f, 20);
  text_push(&mut f, 0);
  text_push(&mut f, 0);
  text_push(&mut f, 12);
  text_push_bytes(&mut f, vd);
  bfree(vd);
  let fin = text_finish(f);
  if !tls13c_note(&mut c, fin) { bfree(fin); return tls13c_fail(&mut c, 1); }
  let sent = tls12c_seal(&mut c, 22, fin, &mut out);
  bfree(fin);
  if !sent { return tls13c_fail(&mut c, 1); }
  c.step = 3;
  return 0;
}

/// Internal: the server's Finished `msg` (after its ChangeCipherSpec).
fn tls12c_finished(c: &mut Tls13Client, msg: &Bytes) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576
  ensures tls13c_ok(c)
{
  if blen(msg) != 16 || bget(msg, 0) != 20 || tls13c_u24(msg, 1) != 12 { return tls13c_fail(&mut c, 8); }
  let h = tls13c_hash(c);
  let want = tls12c_prf(c.suite == 4866, c.ms, "server finished", h, 12);
  bfree(h);
  let got = bytes_slice(msg, 4, 16);
  let same = bytes_eq(want, got);
  bfree(got);
  bfree(want);
  if !same { return tls13c_fail(&mut c, 8); }
  if !tls13c_note(&mut c, msg) { return tls13c_fail(&mut c, 1); }
  c.state = 5;
  return 0;
}

/// Internal: a handshake message for a client that offered TLS 1.2 (the
/// ServerHello, then the TLS 1.2 flight when the server chose it).
fn tls12c_message(c: &mut Tls13Client, msg: &Bytes, roots: &Bytes, now: u64, out: &mut Vec[u8]) -> u64
  requires tls13c_ok(c) && blen(msg) < 1048576 && blen(roots) < 274877906944
  ensures tls13c_ok(c)
{
  if c.state == 0 {
    let r = tls12c_server_hello(&mut c, msg);
    if r != 1000 { return r; }
    return tls13c_server_hello(&mut c, msg);
  }
  if !c.v12 || blen(msg) < 4 { return tls13c_fail(&mut c, 2); }
  let ty = bget(msg, 0);
  if c.state == 5 {
    // A HelloRequest asks for a renegotiation, which this client does not do.
    if ty == 0 { return 0; }
    return tls13c_fail(&mut c, 2);
  }
  if c.step == 0 && ty == 11 { return tls12c_certificate(&mut c, msg, roots, now); }
  if c.step == 1 && ty == 12 { return tls12c_key_exchange(&mut c, msg); }
  if c.step == 2 && ty == 14 { return tls12c_hello_done(&mut c, msg, &mut out); }
  if c.step == 4 && ty == 20 { return tls12c_finished(&mut c, msg); }
  return tls13c_fail(&mut c, 2);
}

/// Internal: handshake bytes for `tls12c_message`, cut into messages.
fn tls12c_handshake_data(c: &mut Tls13Client, plain: &Bytes, roots: &Bytes, now: u64, out: &mut Vec[u8]) -> u64
  requires tls13c_ok(c) && blen(plain) <= 16640 && blen(roots) < 274877906944
  ensures tls13c_ok(c)
{
  if blen(c.hsbuf) > 131072 { return tls13c_fail(&mut c, 1); }
  let joined = tls13c_append(c.hsbuf, plain);
  c.hsbuf = joined;
  let mut more = true;
  while more
    invariant tls13c_ok(c)
  {
    more = false;
    if blen(c.hsbuf) >= 4 {
      let len = tls13c_u24(c.hsbuf, 1);
      if len > 65536 { return tls13c_fail(&mut c, 1); }
      if blen(c.hsbuf) >= 4 + len {
        let msg = bytes_slice(c.hsbuf, 0, 4 + len);
        let rest = bytes_slice(c.hsbuf, 4 + len, blen(c.hsbuf));
        bfree(c.hsbuf);
        c.hsbuf = rest;
        let code = tls12c_message(&mut c, msg, roots, now, &mut out);
        bfree(msg);
        if code != 0 { return code; }
        more = true;
      }
    }
  }
  // A TLS 1.3 server's ServerHello ends its record.
  if !c.v12 && c.state == 1 && blen(c.hsbuf) != 0 { return tls13c_fail(&mut c, 2); }
  return 0;
}

/// Internal: one whole record `rec` for a client that is in TLS 1.2.
fn tls12c_record(c: &mut Tls13Client, rec: &Bytes, roots: &Bytes, now: u64, out: &mut Vec[u8], app: &mut Vec[u8]) -> u64
  requires tls13c_ok(c) && blen(rec) >= 5 && blen(rec) <= 16645 && blen(roots) < 274877906944
  ensures tls13c_ok(c)
{
  let ty = bget(rec, 0);
  let n = blen(rec) - 5;
  if ty == 20 {
    if c.step == 3 && n == 1 && bget(rec, 5) == 1 { c.step = 4; return 0; }
    return tls13c_fail(&mut c, 2);
  }
  if c.step < 4 {
    // Before the server's ChangeCipherSpec everything is in the clear.
    if ty == 22 && c.step <= 2 {
      let body = bytes_slice(rec, 5, blen(rec));
      let code = tls12c_handshake_data(&mut c, body, roots, now, &mut out);
      bfree(body);
      return code;
    }
    if ty == 21 { return tls13c_fail(&mut c, 9); }
    return tls13c_fail(&mut c, 2);
  }
  match tls12c_open(&mut c, rec) {
    Option::None => { return tls13c_fail(&mut c, 5); },
    Option::Some(data) => {
      let mut code = 0;
      if ty == 22 {
        code = tls12c_handshake_data(&mut c, data, roots, now, &mut out);
      } else if ty == 21 {
        if blen(data) == 2 && bget(data, 1) == 0 && c.state == 5 {
          c.state = 6;
        } else if blen(data) == 2 && bget(data, 0) == 1 && c.state == 5 {
          // A warning (no_renegotiation and the like): the connection goes on.
        } else {
          code = tls13c_fail(&mut c, 9);
        }
      } else if ty == 23 && c.state == 5 {
        text_push_bytes(&mut app, data);
      } else {
        code = tls13c_fail(&mut c, 2);
      }
      bfree(data);
      return code;
    },
  }
}
