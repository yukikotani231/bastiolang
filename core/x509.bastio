// core/x509.bastio: reading X.509 certificates (RFC 5280) and checking their
// signatures, for the chain a TLS 1.3 server sends.
//
// What is proved: every access is in bounds, nothing leaks, and every span a
// certificate holds lies inside the bytes it was read from. What is read: the
// signed part, the signature, the issuer and subject names (as the bytes of
// their DER, to be compared as bytes), the validity times, the public key
// (RSA, ECDSA P-256, ECDSA P-384 or Ed25519), and the extensions basicConstraints,
// keyUsage and subjectAltName. A critical extension of any other kind makes
// the certificate unreadable, as RFC 5280 requires. The signature algorithms
// are sha256, sha384 and sha512WithRSAEncryption, ecdsa-with-SHA256,
// ecdsa-with-SHA384 and ecdsa-with-SHA512 (on either curve) and Ed25519. Not proved:
// that a certificate accepted here is a valid one; the tests check
// certificates made by OpenSSL, and that damaged ones, other signers and
// other names are refused. Not done: certificate policies, name constraints,
// revocation, and the curves other than P-256 and P-384.
import "bytes.bastio";
import "der.bastio";
import "ed25519.bastio";
import "option.bastio";
import "p256.bastio";
import "p384.bastio";
import "rsa.bastio";
import "sha256.bastio";
import "sha512.bastio";

/// A certificate read from some bytes. Every span is a range of those bytes.
/// `tbs` is the signed part including its header; `sig_kind` the signature
/// algorithm (1 sha256WithRSAEncryption, 2 ecdsa-with-SHA256, 3 Ed25519,
/// 4 sha384WithRSAEncryption, 5 sha512WithRSAEncryption, 6 ecdsa-with-SHA384,
/// 7 ecdsa-with-SHA512) and
/// `sig` the signature; `issuer` and `subject` are the DER of the names;
/// `not_before` and `not_after` are in seconds since 1970; `key_kind` the key
/// (1 RSA, 2 ECDSA P-256, 3 Ed25519, 4 ECDSA P-384), for RSA `key_a` the
/// modulus and `key_b` the exponent, for the others `key_a` the key (65, 32
/// or 97 bytes). `key_usage`
/// is the first byte of the keyUsage bits (digitalSignature 128, keyCertSign
/// 4) or 65535 when the extension is missing; `is_ca` is the cA flag of
/// basicConstraints; `san` the subjectAltName's list of names, if `has_san`.
struct X509 {
  tbs: Span, sig_kind: u64, sig: Span, issuer: Span, subject: Span,
  not_before: u64, not_after: u64, key_kind: u64, key_a: Span, key_b: Span,
  key_usage: u64, is_ca: bool, has_san: bool, san: Span
}

/// Internal: the element at `at` before `limit`, or one with the tag 0 and
/// an empty content at `at` when there is none.
fn x509_item(b: &Bytes, at: u64, limit: u64) -> DerItem
  requires limit <= blen(b) && at <= limit
  ensures result.content.start <= result.content.end && result.content.end <= limit && at <= result.content.start
  ensures result.tag != 0 ==> at + 2 <= result.content.start
{
  match der_item(b, at, limit) {
    Option::Some(it) => {
      if it.tag == 0 {
        return DerItem { tag: 0, content: Span { start: at, end: at } };
      }
      return it;
    },
    Option::None => {
      return DerItem { tag: 0, content: Span { start: at, end: at } };
    },
  }
}

/// Internal: the value of the hex digit `c` (0 for anything else).
fn x509_nib(c: u8) -> u8
  ensures result < 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 0;
}

/// Internal: whether the content of `it` is the bytes written as hex in `hex`.
fn x509_is(b: &Bytes, it: DerItem, hex: Str) -> bool
  requires it.content.end <= blen(b) && it.content.start <= it.content.end && slen(hex) < 1000
{
  if slen(hex) != 2 * (it.content.end - it.content.start) { return false; }
  let n = it.content.end - it.content.start;
  let mut i = 0;
  while i < n
    invariant i <= n && slen(hex) == 2 * n && n == it.content.end - it.content.start && it.content.end <= blen(b)
  {
    let v = x509_nib(sget(hex, 2 * i)) * 16 + x509_nib(sget(hex, 2 * i + 1));
    if bget(b, it.content.start + i) != v { return false; }
    i = i + 1;
  }
  return true;
}

/// Internal: whether `b[s1.start..s1.end]` and `b[s2.start..s2.end]` are the same bytes.
fn x509_same(b: &Bytes, s1: Span, s2: Span) -> bool
  requires s1.start <= s1.end && s1.end <= blen(b) && s2.start <= s2.end && s2.end <= blen(b)
{
  if s1.end - s1.start != s2.end - s2.start { return false; }
  return bytes_span_eq(b, s1.start, b, s2.start, s1.end - s1.start);
}

/// Internal: the days from 1970-01-01 to the civil date, for years 1970 to
/// 9999 (Howard Hinnant's algorithm).
fn x509_days(y: u64, m: u64, d: u64) -> u64
  requires y >= 1970 && y <= 9999 && m >= 1 && m <= 12 && d >= 1 && d <= 31
  ensures result < 3000000
{
  let mut yy = y;
  if m <= 2 { yy = y - 1; }
  let era = yy / 400;
  let yoe = yy - era * 400;
  let mut mp = m + 9;
  if m > 2 { mp = m - 3; }
  let doy = (153 * mp + 2) / 5 + d - 1;
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  return era * 146097 + doe - 719468;
}

/// Internal: the digits `b[at..at+n]` as a number, or 99999 for anything else.
fn x509_digits(b: &Bytes, at: u64, n: u64) -> u64
  requires at + n <= blen(b) && n <= 4
  ensures result < 10000 || result == 99999
{
  let mut v = 0;
  let mut i = 0;
  while i < n
    invariant i <= n && n <= 4 && at + n <= blen(b) && (v < 10000 || v == 99999) && (i == 0 ==> v == 0) && (i <= 1 ==> v < 10) && (i <= 2 ==> v < 100) && (i <= 3 ==> v < 1000) && v < 10000
  {
    let c = bget(b, at + i);
    if c < 48 || c > 57 { return 99999; }
    v = v * 10 + (cast[u64](c) - 48);
    i = i + 1;
  }
  return v;
}

/// Internal: a UTCTime (tag 23) or GeneralizedTime (tag 24) in the form
/// `...Z` as seconds since 1970, or 0 for anything else (before 1970, an
/// impossible date, no `Z`, fractions or an offset).
fn x509_time(b: &Bytes, it: DerItem) -> u64
  requires it.content.end <= blen(b) && it.content.start <= it.content.end
  ensures result < 300000000000
{
  let n = it.content.end - it.content.start;
  let mut at = it.content.start;
  let mut year = 0;
  if it.tag == 23 && n == 13 {
    let yy = x509_digits(b, at, 2);
    if yy == 99999 { return 0; }
    year = 2000 + yy;
    if yy >= 50 { year = 1900 + yy; }
    at = at + 2;
  } else if it.tag == 24 && n == 15 {
    year = x509_digits(b, at, 4);
    at = at + 4;
  } else {
    return 0;
  }
  let mo = x509_digits(b, at, 2);
  let d = x509_digits(b, at + 2, 2);
  let h = x509_digits(b, at + 4, 2);
  let mi = x509_digits(b, at + 6, 2);
  let s = x509_digits(b, at + 8, 2);
  if bget(b, at + 10) != 90 { return 0; }
  if year < 1970 || year > 9999 || mo < 1 || mo > 12 || d < 1 || d > 31 || h > 23 || mi > 59 || s > 60 {
    return 0;
  }
  return x509_days(year, mo, d) * 86400 + h * 3600 + mi * 60 + s;
}

/// Internal: the signature algorithm in the AlgorithmIdentifier whose
/// content is `alg` (see `X509`), or 0.
fn x509_sig_kind(b: &Bytes, alg: Span) -> u64
  requires alg.start <= alg.end && alg.end <= blen(b)
{
  let oid = x509_item(b, alg.start, alg.end);
  if oid.tag != 6 { return 0; }
  let rest = oid.content.end;
  if x509_is(b, oid, "2a864886f70d01010b") || x509_is(b, oid, "2a864886f70d01010c") || x509_is(b, oid, "2a864886f70d01010d") {
    // The parameters are NULL.
    let p = x509_item(b, rest, alg.end);
    if p.tag == 5 && p.content.end == p.content.start && p.content.end == alg.end {
      if x509_is(b, oid, "2a864886f70d01010c") { return 4; }
      if x509_is(b, oid, "2a864886f70d01010d") { return 5; }
      return 1;
    }
    return 0;
  }
  if x509_is(b, oid, "2a8648ce3d040302") {
    if rest == alg.end { return 2; }
    return 0;
  }
  if x509_is(b, oid, "2a8648ce3d040303") {
    if rest == alg.end { return 6; }
    return 0;
  }
  if x509_is(b, oid, "2a8648ce3d040304") {
    if rest == alg.end { return 7; }
    return 0;
  }
  if x509_is(b, oid, "2b6570") {
    if rest == alg.end { return 3; }
    return 0;
  }
  return 0;
}

/// Internal: a public key: `kind` as in `X509` (0 when unreadable), and the
/// spans `a` and `b`.
struct X509Key { kind: u64, a: Span, b: Span }

/// Internal: the unreadable key.
fn x509_no_key() -> X509Key
  ensures result.a.start <= result.a.end && result.a.end == 0 && result.b.start <= result.b.end && result.b.end == 0
{
  return X509Key { kind: 0, a: Span { start: 0, end: 0 }, b: Span { start: 0, end: 0 } };
}

/// Internal: the SubjectPublicKeyInfo whose content is `spki`.
fn x509_key(b: &Bytes, spki: Span) -> X509Key
  requires spki.start <= spki.end && spki.end <= blen(b)
  ensures result.a.start <= result.a.end && result.a.end <= spki.end
  ensures result.b.start <= result.b.end && result.b.end <= spki.end
{
  let alg = x509_item(b, spki.start, spki.end);
  if alg.tag != 48 { return x509_no_key(); }
  let bits = x509_item(b, alg.content.end, spki.end);
  if bits.tag != 3 || bits.content.end != spki.end || bits.content.end == bits.content.start { return x509_no_key(); }
  if bget(b, bits.content.start) != 0 { return x509_no_key(); }
  let key = Span { start: bits.content.start + 1, end: bits.content.end };
  let oid = x509_item(b, alg.content.start, alg.content.end);
  if oid.tag != 6 { return x509_no_key(); }
  if x509_is(b, oid, "2a864886f70d010101") {
    // rsaEncryption, parameters NULL; the key is SEQUENCE { INTEGER n, INTEGER e }.
    let p = x509_item(b, oid.content.end, alg.content.end);
    if p.tag != 5 || p.content.end != alg.content.end || p.content.start != p.content.end { return x509_no_key(); }
    let seq = x509_item(b, key.start, key.end);
    if seq.tag != 48 || seq.content.end != key.end { return x509_no_key(); }
    let n = x509_item(b, seq.content.start, seq.content.end);
    if n.tag != 2 { return x509_no_key(); }
    let e = x509_item(b, n.content.end, seq.content.end);
    if e.tag != 2 || e.content.end != seq.content.end { return x509_no_key(); }
    return X509Key { kind: 1, a: n.content, b: e.content };
  }
  if x509_is(b, oid, "2a8648ce3d0201") {
    // id-ecPublicKey with the named curve prime256v1 or secp384r1; the key is an uncompressed point.
    let c = x509_item(b, oid.content.end, alg.content.end);
    if c.tag != 6 || c.content.end != alg.content.end { return x509_no_key(); }
    if x509_is(b, c, "2a8648ce3d030107") {
      if key.end - key.start != 65 || bget(b, key.start) != 4 { return x509_no_key(); }
      return X509Key { kind: 2, a: key, b: Span { start: key.end, end: key.end } };
    }
    if x509_is(b, c, "2b81040022") {
      if key.end - key.start != 97 || bget(b, key.start) != 4 { return x509_no_key(); }
      return X509Key { kind: 4, a: key, b: Span { start: key.end, end: key.end } };
    }
    return x509_no_key();
  }
  if x509_is(b, oid, "2b6570") {
    if oid.content.end != alg.content.end || key.end - key.start != 32 { return x509_no_key(); }
    return X509Key { kind: 3, a: key, b: Span { start: key.end, end: key.end } };
  }
  return x509_no_key();
}

/// Internal: what the extensions of a certificate say.
struct X509Exts { ok: bool, key_usage: u64, is_ca: bool, has_san: bool, san: Span }

/// Internal: the Extensions SEQUENCE whose content is `ext`.
fn x509_exts(b: &Bytes, ext: Span) -> X509Exts
  requires ext.start <= ext.end && ext.end <= blen(b)
  ensures result.san.start <= result.san.end && result.san.end <= ext.end
{
  let empty = Span { start: 0, end: 0 };
  let mut out = X509Exts { ok: true, key_usage: 65535, is_ca: false, has_san: false, san: empty };
  let mut at = ext.start;
  while at < ext.end && out.ok
    invariant at <= ext.end && ext.end <= blen(b) && out.key_usage <= 65535 && out.san.start <= out.san.end && out.san.end <= ext.end
  {
    let e = x509_item(b, at, ext.end);
    if e.tag != 48 {
      out.ok = false;
      return out;
    }
    at = e.content.end;
    let oid = x509_item(b, e.content.start, e.content.end);
    if oid.tag != 6 {
      out.ok = false;
      return out;
    }
    let mut next = oid.content.end;
    let mut critical = false;
    let flag = x509_item(b, next, e.content.end);
    if flag.tag == 1 {
      if flag.content.end - flag.content.start != 1 {
        out.ok = false;
        return out;
      }
      critical = bget(b, flag.content.start) == 255;
      next = flag.content.end;
    }
    let value = x509_item(b, next, e.content.end);
    if value.tag != 4 || value.content.end != e.content.end {
      out.ok = false;
      return out;
    }
    if x509_is(b, oid, "551d13") {
      // basicConstraints: SEQUENCE { BOOLEAN cA DEFAULT FALSE, INTEGER pathLen OPTIONAL }
      let seq = x509_item(b, value.content.start, value.content.end);
      if seq.tag != 48 || seq.content.end != value.content.end {
        out.ok = false;
        return out;
      }
      let ca = x509_item(b, seq.content.start, seq.content.end);
      if ca.tag == 1 {
        if ca.content.end - ca.content.start != 1 {
          out.ok = false;
          return out;
        }
        out.is_ca = bget(b, ca.content.start) == 255;
      }
    } else if x509_is(b, oid, "551d0f") {
      // keyUsage: BIT STRING
      let bits = x509_item(b, value.content.start, value.content.end);
      if bits.tag != 3 || bits.content.end != value.content.end || bits.content.end - bits.content.start < 2 {
        out.ok = false;
        return out;
      }
      out.key_usage = cast[u64](bget(b, bits.content.start + 1));
    } else if x509_is(b, oid, "551d11") {
      // subjectAltName: SEQUENCE OF GeneralName
      let seq = x509_item(b, value.content.start, value.content.end);
      if seq.tag != 48 || seq.content.end != value.content.end {
        out.ok = false;
        return out;
      }
      out.has_san = true;
      out.san = seq.content;
    } else if critical && !x509_is(b, oid, "551d25") {
      // An extension this reader does not understand, marked critical (the
      // extended key usage is read by the caller, not here).
      out.ok = false;
      return out;
    }
  }
  return out;
}

/// The certificate in `b` (the DER of one `Certificate`, with nothing after
/// it), if it is well formed and of the kinds listed for `X509`: version 3
/// (or 1 without extensions), the signature algorithm the same in both
/// places, the times readable, the key readable and the extensions readable.
/// ```
/// let b = bfrom("not a certificate");
/// let mut bad = 1;
/// match x509_parse(b) {
///   Option::Some(c) => {},
///   Option::None => { bad = 0; },
/// }
/// bfree(b);
/// if bad != 0 { return 1; }
/// ```
fn x509_parse(b: &Bytes) -> Option[X509]
  requires blen(b) < 274877906944
  ensures result is Option::Some ==> result.Some.tbs.start <= result.Some.tbs.end && result.Some.tbs.end <= blen(b)
  ensures result is Option::Some ==> result.Some.sig.start <= result.Some.sig.end && result.Some.sig.end <= blen(b)
  ensures result is Option::Some ==> result.Some.issuer.start <= result.Some.issuer.end && result.Some.issuer.end <= blen(b)
  ensures result is Option::Some ==> result.Some.subject.start <= result.Some.subject.end && result.Some.subject.end <= blen(b)
  ensures result is Option::Some ==> result.Some.key_a.start <= result.Some.key_a.end && result.Some.key_a.end <= blen(b)
  ensures result is Option::Some ==> result.Some.key_b.start <= result.Some.key_b.end && result.Some.key_b.end <= blen(b)
  ensures result is Option::Some ==> result.Some.san.start <= result.Some.san.end && result.Some.san.end <= blen(b)
{
  let n = blen(b);
  let cert = x509_item(b, 0, n);
  if cert.tag != 48 || cert.content.end != n { return Option[X509]::None; }
  let tbs = x509_item(b, cert.content.start, cert.content.end);
  if tbs.tag != 48 { return Option[X509]::None; }
  let sigalg = x509_item(b, tbs.content.end, cert.content.end);
  if sigalg.tag != 48 { return Option[X509]::None; }
  let sigbits = x509_item(b, sigalg.content.end, cert.content.end);
  if sigbits.tag != 3 || sigbits.content.end != cert.content.end || sigbits.content.end == sigbits.content.start {
    return Option[X509]::None;
  }
  if bget(b, sigbits.content.start) != 0 { return Option[X509]::None; }
  let sig_kind = x509_sig_kind(b, sigalg.content);
  if sig_kind == 0 { return Option[X509]::None; }
  let end = tbs.content.end;
  // The fields of TBSCertificate.
  let mut at = tbs.content.start;
  let mut versioned = false;
  let v = x509_item(b, at, end);
  if v.tag == 160 {
    let vi = x509_item(b, v.content.start, v.content.end);
    if vi.tag != 2 || vi.content.end != v.content.end || vi.content.end - vi.content.start != 1 || bget(b, vi.content.start) != 2 {
      return Option[X509]::None;
    }
    versioned = true;
    at = v.content.end;
  }
  let serial = x509_item(b, at, end);
  if serial.tag != 2 { return Option[X509]::None; }
  let alg2 = x509_item(b, serial.content.end, end);
  if alg2.tag != 48 || !x509_same(b, alg2.content, sigalg.content) { return Option[X509]::None; }
  let issuer_start = alg2.content.end;
  let issuer = x509_item(b, issuer_start, end);
  if issuer.tag != 48 { return Option[X509]::None; }
  let validity = x509_item(b, issuer.content.end, end);
  if validity.tag != 48 { return Option[X509]::None; }
  let nb = x509_item(b, validity.content.start, validity.content.end);
  let na = x509_item(b, nb.content.end, validity.content.end);
  if na.content.end != validity.content.end { return Option[X509]::None; }
  let not_before = x509_time(b, nb);
  let not_after = x509_time(b, na);
  if not_before == 0 || not_after == 0 { return Option[X509]::None; }
  let subject_start = validity.content.end;
  let subject = x509_item(b, subject_start, end);
  if subject.tag != 48 { return Option[X509]::None; }
  let spki = x509_item(b, subject.content.end, end);
  if spki.tag != 48 { return Option[X509]::None; }
  let key = x509_key(b, spki.content);
  if key.kind == 0 { return Option[X509]::None; }
  at = spki.content.end;
  // Unique identifiers (not used), then the extensions.
  let mut u = x509_item(b, at, end);
  if u.tag == 129 {
    at = u.content.end;
    u = x509_item(b, at, end);
  }
  if u.tag == 130 {
    at = u.content.end;
    u = x509_item(b, at, end);
  }
  let mut key_usage = 65535;
  let mut is_ca = false;
  let mut has_san = false;
  let mut san = Span { start: 0, end: 0 };
  if u.tag == 163 {
    if !versioned { return Option[X509]::None; }
    let seq = x509_item(b, u.content.start, u.content.end);
    if seq.tag != 48 || seq.content.end != u.content.end { return Option[X509]::None; }
    let ex = x509_exts(b, seq.content);
    if !ex.ok { return Option[X509]::None; }
    key_usage = ex.key_usage;
    is_ca = ex.is_ca;
    has_san = ex.has_san;
    san = ex.san;
    at = u.content.end;
  }
  if at != end { return Option[X509]::None; }
  // The element's own bytes, header included, for the names and the signed part.
  let tbs_full = Span { start: cert.content.start, end: tbs.content.end };
  let issuer_full = Span { start: issuer_start, end: issuer.content.end };
  let subject_full = Span { start: subject_start, end: subject.content.end };
  return Option[X509]::Some(X509 {
    tbs: tbs_full, sig_kind: sig_kind,
    sig: Span { start: sigbits.content.start + 1, end: sigbits.content.end },
    issuer: issuer_full, subject: subject_full, not_before: not_before, not_after: not_after,
    key_kind: key.kind, key_a: key.a, key_b: key.b,
    key_usage: key_usage, is_ca: is_ca, has_san: has_san, san: san
  });
}

/// Internal: whether a signature algorithm (`sig_kind` of `X509`) can be made
/// with a key (`key_kind`): RSA signatures need an RSA key, ECDSA ones a P-256
/// or P-384 key (the hash is independent of the curve), Ed25519 an Ed25519
/// key.
fn x509_sig_fits(sig_kind: u64, key_kind: u64) -> bool {
  if sig_kind == 1 || sig_kind == 4 || sig_kind == 5 { return key_kind == 1; }
  if sig_kind == 2 || sig_kind == 6 || sig_kind == 7 { return key_kind == 2 || key_kind == 4; }
  if sig_kind == 3 { return key_kind == 3; }
  return false;
}

/// Whether `c`, read from `cb`, was signed by the holder of the key of
/// `issuer`, read from `ib`: the signature algorithm and the key must agree,
/// the issuer name of `c` must be the subject name of `issuer` byte for byte,
/// and the signature over the signed part of `c` must verify. Whether
/// `issuer` may sign certificates is for `x509_can_sign` to say.
/// ```
/// let b = bfrom("not a certificate");
/// let mut ok = true;
/// match x509_parse(b) {
///   Option::Some(c) => { ok = x509_signed_by(b, c, b, c); },
///   Option::None => { ok = false; },
/// }
/// bfree(b);
/// if ok { return 1; }
/// ```
fn x509_signed_by(cb: &Bytes, c: X509, ib: &Bytes, issuer: X509) -> bool
  requires span_in(c.tbs, cb) && span_in(c.sig, cb) && span_in(c.issuer, cb)
  requires span_in(issuer.subject, ib) && span_in(issuer.key_a, ib) && span_in(issuer.key_b, ib)
  requires blen(cb) < 274877906944 && blen(ib) < 274877906944
{
  if c.issuer.end - c.issuer.start != issuer.subject.end - issuer.subject.start { return false; }
  if !bytes_span_eq(cb, c.issuer.start, ib, issuer.subject.start, c.issuer.end - c.issuer.start) { return false; }
  if !x509_sig_fits(c.sig_kind, issuer.key_kind) { return false; }
  let msg = bytes_slice(cb, c.tbs.start, c.tbs.end);
  let sig = bytes_slice(cb, c.sig.start, c.sig.end);
  let ka = bytes_slice(ib, issuer.key_a.start, issuer.key_a.end);
  let kb = bytes_slice(ib, issuer.key_b.start, issuer.key_b.end);
  let mut ok = false;
  if (c.sig_kind == 1 || c.sig_kind == 4 || c.sig_kind == 5) && blen(ka) < 65536 && blen(kb) < 65536 && blen(sig) < 65536 {
    let mut hl = 32;
    if c.sig_kind == 4 { hl = 48; }
    if c.sig_kind == 5 { hl = 64; }
    ok = rsa_pkcs1_verify(ka, kb, msg, sig, hl);
  }
  if (c.sig_kind == 2 || c.sig_kind == 6 || c.sig_kind == 7) && blen(sig) < 65536 && blen(msg) < 274877906944 {
    let mut digest = sha256(msg);
    if c.sig_kind == 6 {
      bfree(digest);
      digest = sha384(msg);
    }
    if c.sig_kind == 7 {
      bfree(digest);
      digest = sha512(msg);
    }
    if issuer.key_kind == 2 { ok = ecdsa_p256_verify_digest(ka, digest, sig); }
    if issuer.key_kind == 4 { ok = ecdsa_p384_verify_digest(ka, digest, sig); }
    bfree(digest);
  }
  if c.sig_kind == 3 && blen(ka) == 32 && blen(sig) == 64 && blen(msg) < 1000000000 {
    ok = ed25519_verify(ka, msg, sig);
  }
  bfree(kb);
  bfree(ka);
  bfree(sig);
  bfree(msg);
  return ok;
}

/// Whether `c` may sign certificates: its cA flag is set and, if it has a
/// keyUsage, that includes keyCertSign.
/// ```
/// let b = bfrom("not a certificate");
/// let mut ok = true;
/// match x509_parse(b) {
///   Option::Some(c) => { ok = x509_can_sign(c); },
///   Option::None => { ok = false; },
/// }
/// bfree(b);
/// if ok { return 1; }
/// ```
fn x509_can_sign(c: X509) -> bool {
  if !c.is_ca { return false; }
  if c.key_usage == 65535 { return true; }
  return (c.key_usage & 4) != 0;
}

/// Whether `now` (seconds since 1970) is within the validity of `c`.
/// ```
/// let b = bfrom("not a certificate");
/// let mut ok = true;
/// match x509_parse(b) {
///   Option::Some(c) => { ok = x509_valid_at(c, 1800000000); },
///   Option::None => { ok = false; },
/// }
/// bfree(b);
/// if ok { return 1; }
/// ```
fn x509_valid_at(c: X509, now: u64) -> bool {
  return c.not_before <= now && now <= c.not_after;
}

/// Internal: `c` in lower case.
fn x509_lower(c: u8) -> u8 {
  if c >= 65 && c <= 90 { return c + 32; }
  return c;
}

/// Internal: whether the DNS name pattern `b[p.start..p.end]` matches `name`:
/// a case-insensitive match, where a pattern may start with `*.` to stand for
/// exactly one label of the name (and only if at least two labels follow it).
fn x509_name_match(b: &Bytes, p: Span, name: &Bytes) -> bool
  requires p.start <= p.end && p.end <= blen(b)
{
  let mut ps = p.start;
  let mut ns = 0;
  if p.end - p.start >= 2 && bget(b, p.start) == 42 && bget(b, p.start + 1) == 46 {
    // The wildcard: the name's first label is non-empty and has no dot.
    let mut dot = 0;
    while dot < blen(name) && bget(name, dot) != 46
      invariant dot <= blen(name)
    {
      dot = dot + 1;
    }
    if dot == 0 || dot >= blen(name) { return false; }
    // Something with a dot must follow the `*.`.
    let mut has_dot = false;
    let mut i = p.start + 2;
    while i < p.end
      invariant i <= p.end && p.end <= blen(b)
    {
      if bget(b, i) == 46 { has_dot = true; }
      i = i + 1;
    }
    if !has_dot { return false; }
    ps = p.start + 1;
    ns = dot;
  }
  if p.end - ps != blen(name) - ns { return false; }
  let n = p.end - ps;
  let mut i = 0;
  while i < n
    invariant i <= n && n == p.end - ps && n == blen(name) - ns && p.end <= blen(b) && ps <= p.end && ns <= blen(name)
  {
    if x509_lower(bget(b, ps + i)) != x509_lower(bget(name, ns + i)) { return false; }
    i = i + 1;
  }
  return n > 0;
}

/// Whether `c` has a dNSName in its subjectAltName that matches `name`
/// (case-insensitively; a name like `*.example.org` stands for one label).
/// ```
/// let b = bfrom("not a certificate");
/// let name = bfrom("example.org");
/// let mut ok = true;
/// match x509_parse(b) {
///   Option::Some(c) => { ok = x509_has_name(b, c, name); },
///   Option::None => { ok = false; },
/// }
/// bfree(name);
/// bfree(b);
/// if ok { return 1; }
/// ```
fn x509_has_name(b: &Bytes, c: X509, name: &Bytes) -> bool
  requires span_in(c.san, b)
{
  if !c.has_san { return false; }
  let mut at = c.san.start;
  while at < c.san.end
    invariant at <= c.san.end && c.san.end <= blen(b)
  {
    let g = x509_item(b, at, c.san.end);
    if g.tag == 0 { return false; }
    if g.tag == 130 && x509_name_match(b, g.content, name) { return true; }
    at = g.content.end;
  }
  return false;
}
