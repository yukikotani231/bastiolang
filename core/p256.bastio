// core/p256.bastio: ECDSA signatures over the curve P-256 (secp256r1) with
// SHA-256, verification only (FIPS 186-4, RFC 6979 is for signing), for the
// ecdsa_secp256r1_sha256 scheme of TLS 1.3 certificates.
//
// What is proved: every access is in bounds, nothing leaks, and the numbers
// the arithmetic works on have 16 limbs. Not proved: that the arithmetic is
// right; the tests check signatures made by OpenSSL, many one-bit changes of
// the signature, key and message being refused, and out-of-range values. The
// code is not constant time and does not need to be: verification handles
// only public values.
//
// A number is a `Vec[u64]` of 16 limbs of 16 bits, least significant first,
// below 2^256. Products are built by doubling and adding, which is slow (a
// verification takes about as long as a few thousand field multiplications of
// 256 steps each) but short enough to read.
import "bytes.bastio";
import "der.bastio";
import "option.bastio";
import "sha256.bastio";

/// Internal: the value of the hex digit `c` (0 for anything else).
fn p256_nib(c: u8) -> u64
  ensures result < 16
{
  if c >= 48 && c <= 57 { return cast[u64](c) - 48; }
  if c >= 97 && c <= 102 { return cast[u64](c) - 87; }
  return 0;
}

/// Internal: the number 0.
fn bn_zero() -> Vec[u64]
  ensures vlen(result) == 16
{
  let mut r = vec_new[u64]();
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(r) == i
  {
    vec_push(&mut r, 0);
    i = i + 1;
  }
  return r;
}

/// Internal: a copy of `a`.
fn bn_copy(a: &Vec[u64]) -> Vec[u64]
  requires vlen(a) == 16
  ensures vlen(result) == 16
{
  let mut r = vec_new[u64]();
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(r) == i && vlen(a) == 16
  {
    vec_push(&mut r, vec_get(a, i));
    i = i + 1;
  }
  return r;
}

/// Internal: the number `v` (below 65536).
fn bn_small(v: u64) -> Vec[u64]
  requires v < 65536
  ensures vlen(result) == 16
{
  let mut r = bn_zero();
  vec_set(&mut r, 0, v);
  return r;
}

/// Internal: the number written as the 64 hex digits of `s`.
fn bn_hex(s: Str) -> Vec[u64]
  requires slen(s) == 64
  ensures vlen(result) == 16
{
  let mut r = bn_zero();
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(r) == 16 && slen(s) == 64
  {
    let k = 60 - 4 * i;
    let v = p256_nib(sget(s, k)) * 4096 + p256_nib(sget(s, k + 1)) * 256 + p256_nib(sget(s, k + 2)) * 16 + p256_nib(sget(s, k + 3));
    vec_set(&mut r, i, v);
    i = i + 1;
  }
  return r;
}

/// Internal: the big-endian number in the 32 bytes `b[at..at+32]`.
fn bn_from_bytes(b: &Bytes, at: u64) -> Vec[u64]
  requires at + 32 <= blen(b) && at < 274877906944
  ensures vlen(result) == 16
{
  let mut r = bn_zero();
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(r) == 16 && at + 32 <= blen(b)
  {
    let hi = cast[u64](bget(b, at + 30 - 2 * i));
    let lo = cast[u64](bget(b, at + 31 - 2 * i));
    vec_set(&mut r, i, hi * 256 + lo);
    i = i + 1;
  }
  return r;
}

/// Internal: whether `a >= b`.
fn bn_ge(a: &Vec[u64], b: &Vec[u64]) -> bool
  requires vlen(a) == 16 && vlen(b) == 16
{
  let mut k = 0;
  while k < 16
    invariant k <= 16 && vlen(a) == 16 && vlen(b) == 16
  {
    let x = vec_get(a, 15 - k);
    let y = vec_get(b, 15 - k);
    if x > y { return true; }
    if x < y { return false; }
    k = k + 1;
  }
  return true;
}

/// Internal: whether `a == b`.
fn bn_eq(a: &Vec[u64], b: &Vec[u64]) -> bool
  requires vlen(a) == 16 && vlen(b) == 16
{
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(a) == 16 && vlen(b) == 16
  {
    if vec_get(a, i) != vec_get(b, i) { return false; }
    i = i + 1;
  }
  return true;
}

/// Internal: whether `a == 0`.
fn bn_is_zero(a: &Vec[u64]) -> bool
  requires vlen(a) == 16
{
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(a) == 16
  {
    if vec_get(a, i) != 0 { return false; }
    i = i + 1;
  }
  return true;
}

/// Internal: `a + b` modulo 2^256, and in the 17th limb the carry.
fn bn_add17(a: &Vec[u64], b: &Vec[u64]) -> Vec[u64]
  requires vlen(a) == 16 && vlen(b) == 16
  ensures vlen(result) == 17
{
  let mut r = vec_new[u64]();
  let mut carry = 0;
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(r) == i && vlen(a) == 16 && vlen(b) == 16 && carry <= 1
  {
    let s = wrap_add(wrap_add(vec_get(a, i), vec_get(b, i)), carry);
    vec_push(&mut r, s & 65535);
    carry = (s >> 16) & 1;
    i = i + 1;
  }
  vec_push(&mut r, carry);
  return r;
}

/// Internal: `a + b` modulo 2^256.
fn bn_add_wrap(a: &Vec[u64], b: &Vec[u64]) -> Vec[u64]
  requires vlen(a) == 16 && vlen(b) == 16
  ensures vlen(result) == 16
{
  let s = bn_add17(a, b);
  let mut r = bn_zero();
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(r) == 16 && vlen(s) == 17
  {
    vec_set(&mut r, i, vec_get(s, i));
    i = i + 1;
  }
  vec_free(s);
  return r;
}

/// Internal: `a - b` modulo 2^256.
fn bn_sub_wrap(a: &Vec[u64], b: &Vec[u64]) -> Vec[u64]
  requires vlen(a) == 16 && vlen(b) == 16
  ensures vlen(result) == 16
{
  let mut r = bn_zero();
  let mut borrow = 0;
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(r) == 16 && vlen(a) == 16 && vlen(b) == 16 && borrow <= 1
  {
    let d = wrap_sub(wrap_sub(wrap_add(vec_get(a, i), 65536), vec_get(b, i)), borrow);
    vec_set(&mut r, i, d & 65535);
    borrow = 1 - ((d >> 16) & 1);
    i = i + 1;
  }
  return r;
}

/// Internal: a prime modulus `m` with what Montgomery multiplication needs:
/// `r2` is 2^512 modulo `m` and `minv` is -1/m modulo 2^16.
struct Modulus { m: Vec[u64], r2: Vec[u64], minv: u64 }

/// Internal: the modulus has 16 limbs, like its `r2`.
spec fn mod_ok(m: &Modulus) -> bool {
  vlen(m.m) == 16 && vlen(m.r2) == 16
}

/// Internal: `a + b` modulo `m` (for `a` and `b` below `m`).
fn mod_add(a: &Vec[u64], b: &Vec[u64], m: &Modulus) -> Vec[u64]
  requires vlen(a) == 16 && vlen(b) == 16 && mod_ok(m)
  ensures vlen(result) == 16
{
  let s = bn_add17(a, b);
  let mut low = bn_zero();
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(low) == 16 && vlen(s) == 17
  {
    vec_set(&mut low, i, vec_get(s, i));
    i = i + 1;
  }
  let over = vec_get(s, 16) > 0 || bn_ge(low, m.m);
  vec_free(s);
  if over {
    let r = bn_sub_wrap(low, m.m);
    vec_free(low);
    return r;
  }
  return low;
}

/// Internal: `a - b` modulo `m` (for `a` and `b` below `m`).
fn mod_sub(a: &Vec[u64], b: &Vec[u64], m: &Modulus) -> Vec[u64]
  requires vlen(a) == 16 && vlen(b) == 16 && mod_ok(m)
  ensures vlen(result) == 16
{
  let d = bn_sub_wrap(a, b);
  if bn_ge(a, b) { return d; }
  let r = bn_add_wrap(d, m.m);
  vec_free(d);
  return r;
}

/// Internal: bit `i` of `a` (0 or 1).
fn bn_bit(a: &Vec[u64], i: u64) -> u64
  requires vlen(a) == 16 && i < 256
  ensures result <= 1
{
  return (vec_get(a, i / 16) >> (i % 16)) & 1;
}

/// Internal: `a * b / 2^256` modulo `m` (Montgomery multiplication, for `a`
/// and `b` below `m`).
fn mont_mul(a: &Vec[u64], b: &Vec[u64], m: &Modulus) -> Vec[u64]
  requires vlen(a) == 16 && vlen(b) == 16 && mod_ok(m)
  ensures vlen(result) == 16
{
  let mut t = vec_new[u64]();
  let mut k = 0;
  while k < 18
    invariant k <= 18 && vlen(t) == k
  {
    vec_push(&mut t, 0);
    k = k + 1;
  }
  let mut i = 0;
  while i < 16
    invariant i <= 16 && vlen(t) == 18 && vlen(a) == 16 && vlen(b) == 16 && mod_ok(m)
  {
    let ai = vec_get(a, i);
    let mut c = 0;
    let mut j = 0;
    while j < 16
      invariant j <= 16 && vlen(t) == 18 && vlen(b) == 16
    {
      let x = wrap_add(wrap_add(vec_get(t, j), wrap_mul(ai, vec_get(b, j))), c);
      vec_set(&mut t, j, x & 65535);
      c = x >> 16;
      j = j + 1;
    }
    let x16 = wrap_add(vec_get(t, 16), c);
    vec_set(&mut t, 16, x16 & 65535);
    vec_set(&mut t, 17, x16 >> 16);
    let q = wrap_mul(vec_get(t, 0), m.minv) & 65535;
    c = 0;
    j = 0;
    while j < 16
      invariant j <= 16 && vlen(t) == 18 && vlen(m.m) == 16
    {
      let y = wrap_add(wrap_add(vec_get(t, j), wrap_mul(q, vec_get(m.m, j))), c);
      if j > 0 { vec_set(&mut t, j - 1, y & 65535); }
      c = y >> 16;
      j = j + 1;
    }
    let y16 = wrap_add(vec_get(t, 16), c);
    vec_set(&mut t, 15, y16 & 65535);
    vec_set(&mut t, 16, wrap_add(vec_get(t, 17), y16 >> 16));
    vec_set(&mut t, 17, 0);
    i = i + 1;
  }
  let mut low = bn_zero();
  i = 0;
  while i < 16
    invariant i <= 16 && vlen(low) == 16 && vlen(t) == 18
  {
    vec_set(&mut low, i, vec_get(t, i));
    i = i + 1;
  }
  let over = vec_get(t, 16) > 0 || bn_ge(low, m.m);
  vec_free(t);
  if over {
    let r = bn_sub_wrap(low, m.m);
    vec_free(low);
    return r;
  }
  return low;
}

/// Internal: `a * b` modulo `m` (for `a` and `b` below `m`).
fn mod_mul(a: &Vec[u64], b: &Vec[u64], m: &Modulus) -> Vec[u64]
  requires vlen(a) == 16 && vlen(b) == 16 && mod_ok(m)
  ensures vlen(result) == 16
{
  let t = mont_mul(a, b, m);
  let r = mont_mul(t, m.r2, m);
  vec_free(t);
  return r;
}

/// Internal: the modulus for the odd number `m`.
fn mod_new(m: Vec[u64]) -> Modulus
  requires vlen(m) == 16
  ensures mod_ok(result)
{
  // Newton's iteration for 1/m modulo 2^16, then its negative.
  let m0 = vec_get(m, 0);
  let mut inv = 1;
  let mut k = 0;
  while k < 5
    invariant k <= 5
  {
    inv = wrap_mul(inv, wrap_sub(2, wrap_mul(m0, inv))) & 65535;
    k = k + 1;
  }
  let minv = wrap_sub(65536, inv) & 65535;
  // 2^512 modulo m: 1 doubled 512 times (m is a prime well above 2).
  let mut r2 = bn_small(1);
  let mut stub = Modulus { m: m, r2: bn_zero(), minv: minv };
  k = 0;
  while k < 512
    invariant k <= 512 && vlen(r2) == 16 && mod_ok(stub)
  {
    let d = mod_add(r2, r2, stub);
    vec_free(r2);
    r2 = d;
    k = k + 1;
  }
  vec_free(stub.r2);
  stub.r2 = r2;
  return stub;
}

/// Internal: frees `m`.
fn mod_free(m: Modulus) {
  vec_free(m.m);
  vec_free(m.r2);
}

/// Internal: `a` to the power `e`, modulo `m`.
fn mod_pow(a: &Vec[u64], e: &Vec[u64], m: &Modulus) -> Vec[u64]
  requires vlen(a) == 16 && vlen(e) == 16 && mod_ok(m)
  ensures vlen(result) == 16
{
  let mut r = bn_small(1);
  let mut k = 0;
  while k < 256
    invariant k <= 256 && vlen(r) == 16 && vlen(a) == 16 && vlen(e) == 16 && mod_ok(m)
  {
    let sq = mod_mul(r, r, m);
    vec_free(r);
    r = sq;
    if bn_bit(e, 255 - k) == 1 {
      let p = mod_mul(r, a, m);
      vec_free(r);
      r = p;
    }
    k = k + 1;
  }
  return r;
}

/// Internal: the inverse of `a` modulo the prime `m` (0 for 0).
fn mod_inv(a: &Vec[u64], m: &Modulus) -> Vec[u64]
  requires vlen(a) == 16 && mod_ok(m)
  ensures vlen(result) == 16
{
  let two = bn_small(2);
  let e = bn_sub_wrap(m.m, two);
  let r = mod_pow(a, e, m);
  vec_free(e);
  vec_free(two);
  return r;
}

/// Internal: a point in Jacobian coordinates, (X / Z^2, Y / Z^3); Z = 0 is
/// the point at infinity.
struct P256Point { x: Vec[u64], y: Vec[u64], z: Vec[u64] }

/// Internal: frees `q`.
fn p256_free(q: P256Point) {
  vec_free(q.x);
  vec_free(q.y);
  vec_free(q.z);
}

/// Internal: the point at infinity.
fn p256_infinity() -> P256Point
  ensures vlen(result.x) == 16 && vlen(result.y) == 16 && vlen(result.z) == 16
{
  return P256Point { x: bn_small(1), y: bn_small(1), z: bn_zero() };
}

/// Internal: a copy of `q`.
fn p256_copy(q: &P256Point) -> P256Point
  requires vlen(q.x) == 16 && vlen(q.y) == 16 && vlen(q.z) == 16
  ensures vlen(result.x) == 16 && vlen(result.y) == 16 && vlen(result.z) == 16
{
  return P256Point { x: bn_copy(q.x), y: bn_copy(q.y), z: bn_copy(q.z) };
}

/// Internal: `a * a` modulo `p`.
fn p256_sq(a: &Vec[u64], p: &Modulus) -> Vec[u64]
  requires vlen(a) == 16 && mod_ok(p)
  ensures vlen(result) == 16
{
  return mod_mul(a, a, p);
}

/// Internal: `2 * q`.
fn p256_double(q: &P256Point, p: &Modulus) -> P256Point
  requires vlen(q.x) == 16 && vlen(q.y) == 16 && vlen(q.z) == 16 && mod_ok(p)
  ensures vlen(result.x) == 16 && vlen(result.y) == 16 && vlen(result.z) == 16
{
  if bn_is_zero(q.z) { return p256_infinity(); }
  let delta = p256_sq(q.z, p);
  let gamma = p256_sq(q.y, p);
  let beta = mod_mul(q.x, gamma, p);
  let t1 = mod_sub(q.x, delta, p);
  let t2 = mod_add(q.x, delta, p);
  let t3 = mod_mul(t1, t2, p);
  let t3b = mod_add(t3, t3, p);
  let alpha = mod_add(t3b, t3, p);
  let a2 = p256_sq(alpha, p);
  let b2 = mod_add(beta, beta, p);
  let b4 = mod_add(b2, b2, p);
  let b8 = mod_add(b4, b4, p);
  let x3 = mod_sub(a2, b8, p);
  let yz = mod_add(q.y, q.z, p);
  let yz2 = p256_sq(yz, p);
  let z1 = mod_sub(yz2, gamma, p);
  let z3 = mod_sub(z1, delta, p);
  let t4 = mod_sub(b4, x3, p);
  let t5 = mod_mul(alpha, t4, p);
  let g2 = p256_sq(gamma, p);
  let g4 = mod_add(g2, g2, p);
  let g8 = mod_add(g4, g4, p);
  let g16 = mod_add(g8, g8, p);
  let y3 = mod_sub(t5, g16, p);
  vec_free(g16);
  vec_free(g8);
  vec_free(g4);
  vec_free(g2);
  vec_free(t5);
  vec_free(t4);
  vec_free(z1);
  vec_free(yz2);
  vec_free(yz);
  vec_free(b2);
  vec_free(b8);
  vec_free(a2);
  vec_free(alpha);
  vec_free(t3b);
  vec_free(t3);
  vec_free(t2);
  vec_free(t1);
  vec_free(beta);
  vec_free(gamma);
  vec_free(delta);
  vec_free(b4);
  return P256Point { x: x3, y: y3, z: z3 };
}

/// Internal: `q1 + q2`.
fn p256_add(q1: &P256Point, q2: &P256Point, p: &Modulus) -> P256Point
  requires vlen(q1.x) == 16 && vlen(q1.y) == 16 && vlen(q1.z) == 16
  requires vlen(q2.x) == 16 && vlen(q2.y) == 16 && vlen(q2.z) == 16 && mod_ok(p)
  ensures vlen(result.x) == 16 && vlen(result.y) == 16 && vlen(result.z) == 16
{
  if bn_is_zero(q1.z) { return p256_copy(q2); }
  if bn_is_zero(q2.z) { return p256_copy(q1); }
  let z1z1 = p256_sq(q1.z, p);
  let z2z2 = p256_sq(q2.z, p);
  let u1 = mod_mul(q1.x, z2z2, p);
  let u2 = mod_mul(q2.x, z1z1, p);
  let y1z2 = mod_mul(q1.y, q2.z, p);
  let s1 = mod_mul(y1z2, z2z2, p);
  let y2z1 = mod_mul(q2.y, q1.z, p);
  let s2 = mod_mul(y2z1, z1z1, p);
  let h = mod_sub(u2, u1, p);
  let r = mod_sub(s2, s1, p);
  let mut out = p256_infinity();
  if bn_is_zero(h) {
    if bn_is_zero(r) {
      p256_free(out);
      out = p256_double(q1, p);
    }
  } else {
    let h2 = p256_sq(h, p);
    let h3 = mod_mul(h2, h, p);
    let u1h2 = mod_mul(u1, h2, p);
    let r2 = p256_sq(r, p);
    let x1 = mod_sub(r2, h3, p);
    let u1h2x2 = mod_add(u1h2, u1h2, p);
    let x3 = mod_sub(x1, u1h2x2, p);
    let y1 = mod_sub(u1h2, x3, p);
    let y2 = mod_mul(r, y1, p);
    let s1h3 = mod_mul(s1, h3, p);
    let y3 = mod_sub(y2, s1h3, p);
    let z12 = mod_mul(q1.z, q2.z, p);
    let z3 = mod_mul(z12, h, p);
    vec_free(z12);
    vec_free(s1h3);
    vec_free(y2);
    vec_free(y1);
    vec_free(u1h2x2);
    vec_free(x1);
    vec_free(r2);
    vec_free(u1h2);
    vec_free(h3);
    vec_free(h2);
    p256_free(out);
    out = P256Point { x: x3, y: y3, z: z3 };
  }
  vec_free(r);
  vec_free(h);
  vec_free(s2);
  vec_free(y2z1);
  vec_free(s1);
  vec_free(y1z2);
  vec_free(u2);
  vec_free(u1);
  vec_free(z2z2);
  vec_free(z1z1);
  return out;
}

/// Internal: `k * q`.
fn p256_mul(k: &Vec[u64], q: &P256Point, p: &Modulus) -> P256Point
  requires vlen(k) == 16 && vlen(q.x) == 16 && vlen(q.y) == 16 && vlen(q.z) == 16 && mod_ok(p)
  ensures vlen(result.x) == 16 && vlen(result.y) == 16 && vlen(result.z) == 16
{
  let mut r = p256_infinity();
  let mut i = 0;
  while i < 256
    invariant i <= 256 && vlen(k) == 16 && mod_ok(p)
    invariant vlen(r.x) == 16 && vlen(r.y) == 16 && vlen(r.z) == 16
    invariant vlen(q.x) == 16 && vlen(q.y) == 16 && vlen(q.z) == 16
  {
    let d = p256_double(r, p);
    p256_free(r);
    r = d;
    if bn_bit(k, 255 - i) == 1 {
      let s = p256_add(r, q, p);
      p256_free(r);
      r = s;
    }
    i = i + 1;
  }
  return r;
}

/// Internal: whether (x, y) is on the curve y^2 = x^3 - 3x + b, with both
/// coordinates below `p`.
fn p256_on_curve(x: &Vec[u64], y: &Vec[u64], p: &Modulus) -> bool
  requires vlen(x) == 16 && vlen(y) == 16 && mod_ok(p)
{
  if bn_ge(x, p.m) || bn_ge(y, p.m) { return false; }
  let b = bn_hex("5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b");
  let lhs = p256_sq(y, p);
  let x2 = p256_sq(x, p);
  let x3 = mod_mul(x2, x, p);
  let t1 = mod_sub(x3, x, p);
  let t2 = mod_sub(t1, x, p);
  let t3 = mod_sub(t2, x, p);
  let rhs = mod_add(t3, b, p);
  let same = bn_eq(lhs, rhs);
  vec_free(rhs);
  vec_free(t3);
  vec_free(t2);
  vec_free(t1);
  vec_free(x3);
  vec_free(x2);
  vec_free(lhs);
  vec_free(b);
  return same;
}

/// Internal: the signature number in the INTEGER `item` of `sig` as 32
/// bytes, if it is a positive DER integer of at most 256 bits in the shortest
/// form.
fn p256_der_uint(sig: &Bytes, start: u64, end: u64) -> Option[Bytes]
  requires start <= end && end <= blen(sig)
  ensures result is Option::Some ==> blen(result.Some) == 32
{
  if end - start < 1 || end - start > 33 { return Option[Bytes]::None; }
  let first = bget(sig, start);
  if first >= 128 { return Option[Bytes]::None; }
  let mut from = start;
  if end - start > 1 && first == 0 {
    if bget(sig, start + 1) < 128 { return Option[Bytes]::None; }
    from = start + 1;
  }
  if end - from > 32 { return Option[Bytes]::None; }
  let n = end - from;
  let mut out = balloc(32);
  let mut i = 0;
  while i < n
    invariant i <= n && n == end - from && n <= 32 && blen(out) == 32 && end <= blen(sig) && from <= end
  {
    bset(&mut out, 32 - n + i, bget(sig, from + i));
    i = i + 1;
  }
  return Option[Bytes]::Some(out);
}

/// Internal: checks the signature (`r`, `s`) of the hash `e` under the key
/// (`qx`, `qy`), all as numbers.
fn p256_verify_numbers(qx: &Vec[u64], qy: &Vec[u64], e: &Vec[u64], r: &Vec[u64], s: &Vec[u64]) -> bool
  requires vlen(qx) == 16 && vlen(qy) == 16 && vlen(e) == 16 && vlen(r) == 16 && vlen(s) == 16
{
  let p = mod_new(bn_hex("ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"));
  let n = mod_new(bn_hex("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"));
  let mut ok = false;
  if !bn_is_zero(r) && !bn_ge(r, n.m) && !bn_is_zero(s) && !bn_ge(s, n.m) && p256_on_curve(qx, qy, p) {
    let mut e1 = bn_copy(e);
    if bn_ge(e1, n.m) {
      let d = bn_sub_wrap(e1, n.m);
      vec_free(e1);
      e1 = d;
    }
    let w = mod_inv(s, n);
    let u1 = mod_mul(e1, w, n);
    let u2 = mod_mul(r, w, n);
    let gx = bn_hex("6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296");
    let gy = bn_hex("4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5");
    let g = P256Point { x: gx, y: gy, z: bn_small(1) };
    let q = P256Point { x: bn_copy(qx), y: bn_copy(qy), z: bn_small(1) };
    let a = p256_mul(u1, g, p);
    let b = p256_mul(u2, q, p);
    let sum = p256_add(a, b, p);
    if !bn_is_zero(sum.z) {
      let zi = mod_inv(sum.z, p);
      let zi2 = p256_sq(zi, p);
      let ax = mod_mul(sum.x, zi2, p);
      let mut v = bn_copy(ax);
      if bn_ge(v, n.m) {
        let d2 = bn_sub_wrap(v, n.m);
        vec_free(v);
        v = d2;
      }
      ok = bn_eq(v, r);
      vec_free(v);
      vec_free(ax);
      vec_free(zi2);
      vec_free(zi);
    }
    p256_free(sum);
    p256_free(b);
    p256_free(a);
    p256_free(q);
    p256_free(g);
    vec_free(u2);
    vec_free(u1);
    vec_free(w);
    vec_free(e1);
  }
  mod_free(n);
  mod_free(p);
  return ok;
}

/// Whether `sig` is a valid ECDSA signature of `msg` under the public key
/// `pubkey`, with the curve P-256 and SHA-256. `pubkey` is the 65 bytes of
/// an uncompressed point (0x04, x, y) and `sig` the DER encoding of
/// SEQUENCE { INTEGER r, INTEGER s } that X.509 and TLS use. A key that is
/// not on the curve, an `r` or `s` outside 1..n-1 and any other encoding are
/// refused.
/// ```
/// let key = balloc(65);
/// let msg = bfrom("hello");
/// let sig = balloc(8);
/// let ok = ecdsa_p256_verify(key, msg, sig);
/// bfree(sig);
/// bfree(msg);
/// bfree(key);
/// if ok { return 1; }
/// ```
fn ecdsa_p256_verify(pubkey: &Bytes, msg: &Bytes, sig: &Bytes) -> bool
  requires blen(msg) < 274877906944 && blen(sig) < 274877906944 && blen(pubkey) < 274877906944
{
  if blen(pubkey) != 65 || bget(pubkey, 0) != 4 { return false; }
  let n = blen(sig);
  match der_item(sig, 0, n) {
    Option::None => { return false; },
    Option::Some(seq) => {
      if seq.tag != 48 || seq.content.end != n { return false; }
      match der_item(sig, seq.content.start, seq.content.end) {
        Option::None => { return false; },
        Option::Some(ri) => {
          if ri.tag != 2 { return false; }
          match der_item(sig, ri.content.end, seq.content.end) {
            Option::None => { return false; },
            Option::Some(si) => {
              if si.tag != 2 || si.content.end != seq.content.end { return false; }
              match p256_der_uint(sig, ri.content.start, ri.content.end) {
                Option::None => { return false; },
                Option::Some(rb) => {
                  match p256_der_uint(sig, si.content.start, si.content.end) {
                    Option::None => {
                      bfree(rb);
                      return false;
                    },
                    Option::Some(sb) => {
                      let digest = sha256(msg);
                      let e = bn_from_bytes(digest, 0);
                      let r = bn_from_bytes(rb, 0);
                      let s = bn_from_bytes(sb, 0);
                      let qx = bn_from_bytes(pubkey, 1);
                      let qy = bn_from_bytes(pubkey, 33);
                      let ok = p256_verify_numbers(qx, qy, e, r, s);
                      vec_free(qy);
                      vec_free(qx);
                      vec_free(s);
                      vec_free(r);
                      vec_free(e);
                      bfree(digest);
                      bfree(sb);
                      bfree(rb);
                      return ok;
                    },
                  }
                },
              }
            },
          }
        },
      }
    },
  }
}
