// core/print.bastio: writing text and numbers to the serial console. Works
// on every target: the console is standard output on the hosted target and
// COM1 under a kernel.
import "num.bastio";

/// The bytes of a literal.
/// ```
/// print_str(con, "pid ");
/// print_u64(con, 42);
/// print_str(con, ", offset ");
/// print_i64(con, -16);
/// print_str(con, ", flags ");
/// print_hex(con, 255);   // 0xff
/// print_nl(con);
/// print_u64_pad(con, 7, 4);
/// print_nl(con);
/// ```
fn print_str(con: &Serial, s: Str) {
  let mut i = 0;
  while i < slen(s)
    invariant i <= slen(s)
  {
    serial_write(con, sget(s, i));
    i = i + 1;
  }
}

/// Bytes `from..to` of `b`.
/// ```
/// let line = bfrom("key=value");
/// print_span(con, line, 4, 9);   // value
/// print_nl(con);
/// print_bytes(con, line);
/// print_nl(con);
/// let mut t = text_new();
/// text_push_str(&mut t, "a text");
/// print_text(con, t);
/// print_nl(con);
/// vec_free(t);
/// bfree(line);
/// ```
fn print_span(con: &Serial, b: &Bytes, from: u64, to: u64)
  requires from <= to && to <= blen(b)
{
  let mut i = from;
  while i < to
    invariant from <= i && i <= to
  {
    serial_write(con, bget(b, i));
    i = i + 1;
  }
}

/// All of `b`.
fn print_bytes(con: &Serial, b: &Bytes) {
  print_span(con, b, 0, blen(b));
}

/// A text built with core/text.bastio.
fn print_text(con: &Serial, t: &Vec[u8]) {
  let mut i = 0;
  while i < vec_len(t)
    invariant i <= vlen(t)
  {
    serial_write(con, vec_get(t, i));
    i = i + 1;
  }
}

/// A newline.
fn print_nl(con: &Serial) {
  serial_write(con, 10);
}

/// `x` in decimal.
fn print_u64(con: &Serial, x: u64) {
  let mut t = text_new();
  fmt_u64(&mut t, x);
  print_text(con, t);
  vec_free(t);
}

/// `x` in decimal, padded on the left with spaces to `width` bytes.
fn print_u64_pad(con: &Serial, x: u64, width: u64) {
  let mut t = text_new();
  fmt_u64_pad(&mut t, x, width);
  print_text(con, t);
  vec_free(t);
}

/// `x` in decimal, with a `-` when negative.
fn print_i64(con: &Serial, x: i64) {
  let mut t = text_new();
  fmt_i64(&mut t, x);
  print_text(con, t);
  vec_free(t);
}

/// `x` in hexadecimal with a `0x` prefix.
fn print_hex(con: &Serial, x: u64) {
  let mut t = text_new();
  text_push_str(&mut t, "0x");
  fmt_hex_u64(&mut t, x, 1);
  print_text(con, t);
  vec_free(t);
}
