// core/json.bastio: JSON (RFC 8259) read from bytes that cannot be trusted.
// Nothing is allocated to check a document: `json_value` returns where the
// value that starts at an offset ends, and the readers return offsets into
// the same buffer. Objects and arrays nest at most 32 deep.
//
// What is proved: no read is outside the buffer, no arithmetic overflows, and
// every offset returned lies inside the buffer and after the one it came
// from. Not proved: that exactly the documents of RFC 8259 are accepted. The
// scanner is strict (no comments, no trailing commas, no leading zeros, no
// control characters in strings, no single quotes), but it does not check
// that the bytes of a string are UTF-8 and it accepts an escaped surrogate on
// its own (`json_string` refuses it). A key with an escape in it is compared
// by the bytes as written.
import "option.bastio";
import "bytes.bastio";
import "text.bastio";
import "num.bastio";

/// What `json_value` found.
enum Json {
  // The value ends here (the offset after its last byte).
  Ok(u64),
  // The input ends inside the value.
  Partial,
  // The value is invalid at this offset.
  Bad(u64),
}

/// The first offset at or after `at` that is not JSON whitespace (space, tab,
/// line feed, carriage return).
/// ```
/// let b = bfrom(" \t\r\n[1]");
/// let i = json_ws(b, 0);
/// let j = json_ws(b, i);
/// bfree(b);
/// if i != 4 || j != 4 { return 1; }
/// ```
fn json_ws(s: &Bytes, at: u64) -> u64
  requires at <= blen(s)
  ensures at <= result && result <= blen(s)
{
  let n = blen(s);
  let mut i = at;
  while i < n && (bget(s, i) == 32 || bget(s, i) == 9 || bget(s, i) == 10 || bget(s, i) == 13)
    invariant at <= i && i <= n
  {
    i = i + 1;
  }
  return i;
}

/// Internal: the end of the string whose opening quote is at `p`.
fn json_str_end(s: &Bytes, p: u64) -> Json
  requires p < blen(s)
  ensures result is Json::Ok ==> p + 2 <= result.Ok && result.Ok <= blen(s)
  ensures result is Json::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  let mut i = p + 1;
  while i < n
    invariant p < i && i <= n
  {
    let c = bget(s, i);
    if c == 34 {
      return Json::Ok(i + 1);
    }
    if c < 32 {
      return Json::Bad(i);
    }
    if c == 92 {
      if i + 1 >= n {
        return Json::Partial;
      }
      let e = bget(s, i + 1);
      if e == 117 {
        let mut k = 0;
        while k < 4
          invariant k <= 4 && i + 2 + k <= n && i + 1 < n
        {
          if i + 2 + k >= n {
            return Json::Partial;
          }
          if hex_value(bget(s, i + 2 + k)) == 16 {
            return Json::Bad(i + 2 + k);
          }
          k = k + 1;
        }
        i = i + 6;
      } else if e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116 {
        i = i + 2;
      } else {
        return Json::Bad(i + 1);
      }
    } else {
      i = i + 1;
    }
  }
  return Json::Partial;
}

/// Internal: the end of the number that starts at `p`.
fn json_num_end(s: &Bytes, p: u64) -> Json
  requires p < blen(s)
  ensures result is Json::Ok ==> p < result.Ok && result.Ok <= blen(s)
  ensures result is Json::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  let mut i = p;
  if bget(s, i) == 45 {
    i = i + 1;
    if i >= n {
      return Json::Partial;
    }
  }
  let c = bget(s, i);
  if c == 48 {
    i = i + 1;
  } else if c >= 49 && c <= 57 {
    i = i + 1;
    while i < n && bget(s, i) >= 48 && bget(s, i) <= 57
      invariant p < i && i <= n
    {
      i = i + 1;
    }
  } else {
    return Json::Bad(i);
  }
  if i < n && bget(s, i) == 46 {
    i = i + 1;
    if i >= n {
      return Json::Partial;
    }
    if bget(s, i) < 48 || bget(s, i) > 57 {
      return Json::Bad(i);
    }
    while i < n && bget(s, i) >= 48 && bget(s, i) <= 57
      invariant p < i && i <= n
    {
      i = i + 1;
    }
  }
  if i < n && (bget(s, i) == 101 || bget(s, i) == 69) {
    i = i + 1;
    if i < n && (bget(s, i) == 43 || bget(s, i) == 45) {
      i = i + 1;
    }
    if i >= n {
      return Json::Partial;
    }
    if bget(s, i) < 48 || bget(s, i) > 57 {
      return Json::Bad(i);
    }
    while i < n && bget(s, i) >= 48 && bget(s, i) <= 57
      invariant p < i && i <= n
    {
      i = i + 1;
    }
  }
  return Json::Ok(i);
}

/// Internal: the end of the literal `lit` (`true`, `false`, `null`) at `p`.
fn json_lit_end(s: &Bytes, p: u64, lit: Str) -> Json
  requires p < blen(s)
  ensures result is Json::Ok ==> p < result.Ok && result.Ok <= blen(s)
  ensures result is Json::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  let l = slen(lit);
  let mut k = 0;
  while k < l
    invariant k <= l && l == slen(lit) && p < n && p + k <= n
  {
    if p + k >= n {
      return Json::Partial;
    }
    if bget(s, p + k) != sget(lit, k) {
      return Json::Bad(p + k);
    }
    k = k + 1;
  }
  if l == 0 {
    return Json::Bad(p);
  }
  return Json::Ok(p + l);
}

/// Where the value that starts at the first non-blank byte at or after `at`
/// ends, past the blanks that follow it. The whole value is checked, nested objects and arrays included.
/// ```
/// let b = bfrom(" {\"a\": [1, 2.5e3, true, null], \"b\": \"x\\n\"} tail");
/// let mut e = 0;
/// match json_value(b, 0) {
///   Json::Ok(x) => { e = x; },
///   Json::Partial => {},
///   Json::Bad(x) => {},
/// }
/// let cut = bfrom("[1, 2");
/// let bad = bfrom("[1,]");
/// let mut p = false;
/// match json_value(cut, 0) { Json::Partial => { p = true; }, Json::Ok(x) => {}, Json::Bad(x) => {} }
/// let mut q = 99;
/// match json_value(bad, 0) { Json::Bad(x) => { q = x; }, Json::Ok(x) => {}, Json::Partial => {} }
/// bfree(b);
/// bfree(cut);
/// bfree(bad);
/// if e != 43 || !p || q != 3 { return 1; }
/// ```
fn json_value(s: &Bytes, at: u64) -> Json
  requires at <= blen(s)
  ensures result is Json::Ok ==> at < result.Ok && result.Ok <= blen(s)
  ensures result is Json::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  let mut p = json_ws(s, at);
  // The kinds of the open containers, innermost in bit 0: 1 for an object.
  let mut stack: u64 = 0;
  let mut depth: u64 = 0;
  // 0: a value is next; 1: a value has just ended; 2: just after `{` or
  // `[`; 3: a key is next.
  let mut state: u64 = 0;
  while true
    invariant at <= p && p <= n && depth <= 32 && state <= 3 && (state < 2 || depth > 0) && (depth > 0 || state != 1 || p > at)
  {
    if state == 1 && depth == 0 {
      return Json::Ok(json_ws(s, p));
    }
    if p >= n {
      return Json::Partial;
    }
    let c = bget(s, p);
    if state == 1 {
      if c == 44 {
        p = json_ws(s, p + 1);
        if (stack & 1) == 1 {
          state = 3;
        } else {
          state = 0;
        }
      } else if (c == 125 && (stack & 1) == 1) || (c == 93 && (stack & 1) == 0) {
        depth = depth - 1;
        stack = stack >> 1;
        p = json_ws(s, p + 1);
      } else {
        return Json::Bad(p);
      }
    } else if state == 3 || (state == 2 && (stack & 1) == 1 && c != 125) {
      if c != 34 {
        return Json::Bad(p);
      }
      match json_str_end(s, p) {
        Json::Ok(e) => { p = json_ws(s, e); },
        Json::Partial => { return Json::Partial; },
        Json::Bad(x) => { return Json::Bad(x); },
      }
      if p >= n {
        return Json::Partial;
      }
      if bget(s, p) != 58 {
        return Json::Bad(p);
      }
      p = json_ws(s, p + 1);
      state = 0;
    } else if state == 2 {
      // `{` followed by `}`, or `[` followed by a value or `]`.
      if (c == 125 && (stack & 1) == 1) || c == 93 {
        if (c == 125) != ((stack & 1) == 1) {
          return Json::Bad(p);
        }
        depth = depth - 1;
        stack = stack >> 1;
        p = json_ws(s, p + 1);
        state = 1;
      } else {
        state = 0;
      }
    } else {
      if c == 123 || c == 91 {
        if depth >= 32 {
          return Json::Bad(p);
        }
        depth = depth + 1;
        stack = (stack & 0x7FFFFFFFFFFFFFFF) << 1;
        if c == 123 {
          stack = stack + 1;
        }
        p = json_ws(s, p + 1);
        state = 2;
      } else if c == 34 {
        match json_str_end(s, p) {
          Json::Ok(e) => { p = e; },
          Json::Partial => { return Json::Partial; },
          Json::Bad(x) => { return Json::Bad(x); },
        }
        state = 1;
      } else if c == 45 || (c >= 48 && c <= 57) {
        match json_num_end(s, p) {
          Json::Ok(e) => { p = e; },
          Json::Partial => { return Json::Partial; },
          Json::Bad(x) => { return Json::Bad(x); },
        }
        state = 1;
      } else if c == 116 {
        match json_lit_end(s, p, "true") {
          Json::Ok(e) => { p = e; },
          Json::Partial => { return Json::Partial; },
          Json::Bad(x) => { return Json::Bad(x); },
        }
        state = 1;
      } else if c == 102 {
        match json_lit_end(s, p, "false") {
          Json::Ok(e) => { p = e; },
          Json::Partial => { return Json::Partial; },
          Json::Bad(x) => { return Json::Bad(x); },
        }
        state = 1;
      } else if c == 110 {
        match json_lit_end(s, p, "null") {
          Json::Ok(e) => { p = e; },
          Json::Partial => { return Json::Partial; },
          Json::Bad(x) => { return Json::Bad(x); },
        }
        state = 1;
      } else {
        return Json::Bad(p);
      }
    }
  }
  return Json::Partial;
}

/// The offset of the value of the member `key` of the object that starts at
/// the first non-blank byte at or after `at`, or `None` when there is no such
/// member or the document is damaged. The first member of that name wins. Keys
/// are compared by the bytes as written, so a key written with an escape
/// does not match its unescaped spelling.
/// ```
/// let b = bfrom("{\"a\": 1, \"b\": {\"a\": 2}, \"c\": [true]}");
/// let mut c = 0;
/// match json_member(b, 0, "c") { Option::Some(x) => { c = x; }, Option::None => {} }
/// let gone = json_member(b, 0, "d");
/// let onearr = json_member(b, c, "a");   // `c` is an array, not an object
/// bfree(b);
/// if c != 29 || gone is Option::Some || onearr is Option::Some { return 1; }
/// ```
fn json_member(s: &Bytes, at: u64, key: Str) -> Option[u64]
  requires at <= blen(s)
  ensures result is Option::Some ==> at < result.Some && result.Some < blen(s)
{
  let n = blen(s);
  let mut p = json_ws(s, at);
  if p >= n {
    return Option[u64]::None;
  }
  if bget(s, p) != 123 {
    return Option[u64]::None;
  }
  p = json_ws(s, p + 1);
  while p < n && bget(s, p) == 34
    invariant at <= p && p <= n
  {
    let mut ke = 0;
    match json_str_end(s, p) {
      Json::Ok(x) => { ke = x; },
      Json::Partial => { return Option[u64]::None; },
      Json::Bad(x) => { return Option[u64]::None; },
    }
    if ke < p + 2 || ke > n {
      return Option[u64]::None;
    }
    let q = json_ws(s, ke);
    if q >= n {
      return Option[u64]::None;
    }
    if bget(s, q) != 58 {
      return Option[u64]::None;
    }
    let vs = json_ws(s, q + 1);
    if bytes_span_eq_str(s, p + 1, ke - 1, key) {
      if vs < n {
        return Option[u64]::Some(vs);
      }
      return Option[u64]::None;
    }
    let mut ve = 0;
    match json_value(s, vs) {
      Json::Ok(x) => { ve = x; },
      Json::Partial => { return Option[u64]::None; },
      Json::Bad(x) => { return Option[u64]::None; },
    }
    if ve > n {
      return Option[u64]::None;
    }
    let r = json_ws(s, ve);
    if r >= n {
      return Option[u64]::None;
    }
    if bget(s, r) != 44 {
      return Option[u64]::None;
    }
    p = json_ws(s, r + 1);
  }
  return Option[u64]::None;
}

/// The offset of element number `idx` (from 0) of the array that starts at the
/// first non-blank byte at or after `at`, or `None` when there are fewer
/// elements or the document is damaged.
/// ```
/// let b = bfrom("[10, [1, 2], \"x\", null]");
/// let mut third = 0;
/// match json_element(b, 0, 2) { Option::Some(x) => { third = x; }, Option::None => {} }
/// let past = json_element(b, 0, 4);
/// bfree(b);
/// if third != 13 || past is Option::Some { return 1; }
/// ```
fn json_element(s: &Bytes, at: u64, idx: u64) -> Option[u64]
  requires at <= blen(s)
  ensures result is Option::Some ==> at < result.Some && result.Some < blen(s)
{
  let n = blen(s);
  let mut p = json_ws(s, at);
  if p >= n {
    return Option[u64]::None;
  }
  if bget(s, p) != 91 {
    return Option[u64]::None;
  }
  p = json_ws(s, p + 1);
  let mut k = 0;
  while p < n && bget(s, p) != 93
    invariant at < p && p <= n && k <= idx
  {
    if k == idx {
      return Option[u64]::Some(p);
    }
    let mut ve = 0;
    match json_value(s, p) {
      Json::Ok(x) => { ve = x; },
      Json::Partial => { return Option[u64]::None; },
      Json::Bad(x) => { return Option[u64]::None; },
    }
    if ve > n {
      return Option[u64]::None;
    }
    let r = json_ws(s, ve);
    if r >= n {
      return Option[u64]::None;
    }
    if bget(s, r) != 44 {
      return Option[u64]::None;
    }
    p = json_ws(s, r + 1);
    k = k + 1;
  }
  return Option[u64]::None;
}

/// The value at the first non-blank byte at or after `at`, read as a JSON
/// number made only of digits (no sign, fraction or exponent) that fits in a
/// `u64`.
/// ```
/// let b = bfrom("[42, -1, 1.5, 18446744073709551616]");
/// let mut a = 0;
/// match json_u64(b, 1) { Option::Some(x) => { a = x; }, Option::None => {} }
/// let neg = json_u64(b, 5);
/// let frac = json_u64(b, 9);
/// let big = json_u64(b, 14);
/// bfree(b);
/// if a != 42 || neg is Option::Some || frac is Option::Some || big is Option::Some { return 1; }
/// ```
fn json_u64(s: &Bytes, at: u64) -> Option[u64]
  requires at <= blen(s)
{
  let n = blen(s);
  let p = json_ws(s, at);
  if p >= n {
    return Option[u64]::None;
  }
  match json_num_end(s, p) {
    Json::Ok(e) => {
      if e > n || e <= p {
        return Option[u64]::None;
      }
      return parse_u64(s, p, e);
    },
    Json::Partial => { return Option[u64]::None; },
    Json::Bad(x) => { return Option[u64]::None; },
  }
}

/// Internal: the four hexadecimal digits at `i`, or `None`.
fn json_hex4(s: &Bytes, i: u64) -> Option[u64]
  requires i + 4 <= blen(s)
  ensures result is Option::Some ==> result.Some <= 65535
{
  let a = hex_value(bget(s, i));
  let b = hex_value(bget(s, i + 1));
  let c = hex_value(bget(s, i + 2));
  let d = hex_value(bget(s, i + 3));
  if a == 16 || b == 16 || c == 16 || d == 16 {
    return Option[u64]::None;
  }
  return Option[u64]::Some(a * 4096 + b * 256 + c * 16 + d);
}

/// Internal: appends the UTF-8 encoding of the code point `cp`.
fn json_put_utf8(t: &mut Vec[u8], cp: u64)
  requires cp <= 1114111
{
  if cp < 128 {
    text_push(&mut t, cast[u8](cp));
  } else if cp < 2048 {
    text_push(&mut t, cast[u8](192 + cp / 64));
    text_push(&mut t, cast[u8](128 + cp % 64));
  } else if cp < 65536 {
    text_push(&mut t, cast[u8](224 + cp / 4096));
    text_push(&mut t, cast[u8](128 + (cp / 64) % 64));
    text_push(&mut t, cast[u8](128 + cp % 64));
  } else {
    text_push(&mut t, cast[u8](240 + cp / 262144));
    text_push(&mut t, cast[u8](128 + (cp / 4096) % 64));
    text_push(&mut t, cast[u8](128 + (cp / 64) % 64));
    text_push(&mut t, cast[u8](128 + cp % 64));
  }
}

/// The string at the first non-blank byte at or after `at`, with its escapes
/// decoded (`\u` escapes become UTF-8; a surrogate pair becomes one code
/// point). `None` when it is not a string, is cut short, has a bad escape or
/// holds a surrogate without its partner. The bytes between the escapes are
/// copied as they are.
/// ```
/// let b = bfrom("\"a\\n\\u00e9\\ud83d\\ude00\"");
/// let mut ok = false;
/// match json_string(b, 0) {
///   Option::Some(v) => { ok = blen(v) == 8 && bget(v, 1) == 10 && bget(v, 2) == 195 && bget(v, 3) == 169 && bget(v, 4) == 240 && bget(v, 7) == 128; bfree(v); },
///   Option::None => {},
/// }
/// let lone = bfrom("\"\\ud800\"");
/// let mut refused = true;
/// match json_string(lone, 0) {
///   Option::Some(v) => { refused = false; bfree(v); },
///   Option::None => {},
/// }
/// bfree(b);
/// bfree(lone);
/// if !ok || !refused { return 1; }
/// ```
fn json_string(s: &Bytes, at: u64) -> Option[Bytes]
  requires at <= blen(s)
{
  let n = blen(s);
  let p = json_ws(s, at);
  if p >= n {
    return Option[Bytes]::None;
  }
  if bget(s, p) != 34 {
    return Option[Bytes]::None;
  }
  let mut end = 0;
  match json_str_end(s, p) {
    Json::Ok(x) => { end = x; },
    Json::Partial => { return Option[Bytes]::None; },
    Json::Bad(x) => { return Option[Bytes]::None; },
  }
  if end < p + 2 || end > n {
    return Option[Bytes]::None;
  }
  let stop = end - 1;
  let mut t = text_new();
  let mut i = p + 1;
  let mut ok = true;
  while ok && i < stop
    invariant p < i && i <= stop && stop < n
  {
    let c = bget(s, i);
    if c != 92 {
      text_push(&mut t, c);
      i = i + 1;
    } else if i + 1 >= stop {
      ok = false;
    } else {
      let e = bget(s, i + 1);
      if e == 117 {
        if i + 6 > stop {
          ok = false;
        } else {
          match json_hex4(s, i + 2) {
            Option::None => { ok = false; },
            Option::Some(u) => {
              if u >= 55296 && u < 56320 {
                // A high surrogate needs `\u` and a low surrogate next.
                if i + 12 > stop || bget(s, i + 6) != 92 || bget(s, i + 7) != 117 {
                  ok = false;
                } else {
                  match json_hex4(s, i + 8) {
                    Option::None => { ok = false; },
                    Option::Some(w) => {
                      if w >= 56320 && w < 57344 {
                        json_put_utf8(&mut t, 65536 + (u - 55296) * 1024 + (w - 56320));
                        i = i + 12;
                      } else {
                        ok = false;
                      }
                    },
                  }
                }
              } else if u >= 56320 && u < 57344 {
                ok = false;
              } else {
                json_put_utf8(&mut t, u);
                i = i + 6;
              }
            },
          }
        }
      } else {
        if e == 34 || e == 92 || e == 47 {
          text_push(&mut t, e);
        } else if e == 98 {
          text_push(&mut t, 8);
        } else if e == 102 {
          text_push(&mut t, 12);
        } else if e == 110 {
          text_push(&mut t, 10);
        } else if e == 114 {
          text_push(&mut t, 13);
        } else if e == 116 {
          text_push(&mut t, 9);
        } else {
          ok = false;
        }
        i = i + 2;
      }
    }
  }
  if ok {
    return Option[Bytes]::Some(text_finish(t));
  }
  vec_free(t);
  return Option[Bytes]::None;
}
