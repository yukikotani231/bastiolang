// core/json.bastio: JSON (RFC 8259) read from bytes that cannot be trusted.
// Nothing is allocated to check a document: `json_value` returns where the
// value that starts at an offset ends, and the readers return offsets into
// the same buffer. Objects and arrays nest at most 32 deep. `JsonOut` (the
// `json_out_*` calls) writes a document the other way: it tracks commas, keys
// and nesting, so what `json_out_finish` returns is well-formed or `None`.
//
// What is proved: no read is outside the buffer, no arithmetic overflows, and
// every offset returned lies inside the buffer and after the one it came
// from. Not proved: that exactly the documents of RFC 8259 are accepted. The
// scanner is strict (no comments, no trailing commas, no leading zeros, no
// control characters in strings, no single quotes, and the bytes of a string
// must be valid UTF-8), but it accepts an escaped surrogate on its own
// (`json_string` refuses it). A key with an escape in it is compared as
// the string it stands for.
import "option.bastio";
import "bytes.bastio";
import "text.bastio";
import "num.bastio";
import "utf8.bastio";

/// What `json_value` found.
enum Json {
  // The value ends here (the offset after its last byte).
  Ok(u64),
  // The input ends inside the value.
  Partial,
  // The value is invalid at this offset.
  Bad(u64),
}

/// The first offset at or after `at` that is not JSON whitespace (space, tab,
/// line feed, carriage return).
/// ```
/// let b = bfrom(" \t\r\n[1]");
/// let i = json_ws(b, 0);
/// let j = json_ws(b, i);
/// bfree(b);
/// if i != 4 || j != 4 { return 1; }
/// ```
fn json_ws(s: &Bytes, at: u64) -> u64
  requires at <= blen(s)
  ensures at <= result && result <= blen(s)
{
  let n = blen(s);
  let mut i = at;
  while i < n && (bget(s, i) == 32 || bget(s, i) == 9 || bget(s, i) == 10 || bget(s, i) == 13)
    invariant at <= i && i <= n
  {
    i = i + 1;
  }
  return i;
}

/// Internal: the end of the string whose opening quote is at `p`.
fn json_str_end(s: &Bytes, p: u64) -> Json
  requires p < blen(s)
  ensures result is Json::Ok ==> p + 2 <= result.Ok && result.Ok <= blen(s)
  ensures result is Json::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  let mut i = p + 1;
  while i < n
    invariant p < i && i <= n
  {
    let c = bget(s, i);
    if c == 34 {
      return Json::Ok(i + 1);
    }
    if c < 32 {
      return Json::Bad(i);
    }
    if c == 92 {
      if i + 1 >= n {
        return Json::Partial;
      }
      let e = bget(s, i + 1);
      if e == 117 {
        let mut k = 0;
        while k < 4
          invariant k <= 4 && i + 2 + k <= n && i + 1 < n
        {
          if i + 2 + k >= n {
            return Json::Partial;
          }
          if hex_value(bget(s, i + 2 + k)) == 16 {
            return Json::Bad(i + 2 + k);
          }
          k = k + 1;
        }
        i = i + 6;
      } else if e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116 {
        i = i + 2;
      } else {
        return Json::Bad(i + 1);
      }
    } else if c >= 128 {
      // Bytes of a character must form valid UTF-8 (RFC 8259, section 8.1).
      let k = utf8_seq_len(s, i);
      if k == 0 {
        // A lead byte followed only by continuation bytes up to the end of
        // the input may still be completed.
        let mut cutoff = c >= 194 && c <= 244 && i + 4 > n;
        let mut j = i + 1;
        while j < n && cutoff
          invariant i < j && j <= n
        {
          if bget(s, j) < 128 || bget(s, j) > 191 {
            cutoff = false;
          }
          j = j + 1;
        }
        if cutoff {
          return Json::Partial;
        }
        return Json::Bad(i);
      }
      i = i + k;
    } else {
      i = i + 1;
    }
  }
  return Json::Partial;
}

/// Internal: the end of the number that starts at `p`.
fn json_num_end(s: &Bytes, p: u64) -> Json
  requires p < blen(s)
  ensures result is Json::Ok ==> p < result.Ok && result.Ok <= blen(s)
  ensures result is Json::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  let mut i = p;
  if bget(s, i) == 45 {
    i = i + 1;
    if i >= n {
      return Json::Partial;
    }
  }
  let c = bget(s, i);
  if c == 48 {
    i = i + 1;
  } else if c >= 49 && c <= 57 {
    i = i + 1;
    while i < n && bget(s, i) >= 48 && bget(s, i) <= 57
      invariant p < i && i <= n
    {
      i = i + 1;
    }
  } else {
    return Json::Bad(i);
  }
  if i < n && bget(s, i) == 46 {
    i = i + 1;
    if i >= n {
      return Json::Partial;
    }
    if bget(s, i) < 48 || bget(s, i) > 57 {
      return Json::Bad(i);
    }
    while i < n && bget(s, i) >= 48 && bget(s, i) <= 57
      invariant p < i && i <= n
    {
      i = i + 1;
    }
  }
  if i < n && (bget(s, i) == 101 || bget(s, i) == 69) {
    i = i + 1;
    if i < n && (bget(s, i) == 43 || bget(s, i) == 45) {
      i = i + 1;
    }
    if i >= n {
      return Json::Partial;
    }
    if bget(s, i) < 48 || bget(s, i) > 57 {
      return Json::Bad(i);
    }
    while i < n && bget(s, i) >= 48 && bget(s, i) <= 57
      invariant p < i && i <= n
    {
      i = i + 1;
    }
  }
  return Json::Ok(i);
}

/// Internal: the end of the literal `lit` (`true`, `false`, `null`) at `p`.
fn json_lit_end(s: &Bytes, p: u64, lit: Str) -> Json
  requires p < blen(s)
  ensures result is Json::Ok ==> p < result.Ok && result.Ok <= blen(s)
  ensures result is Json::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  let l = slen(lit);
  let mut k = 0;
  while k < l
    invariant k <= l && l == slen(lit) && p < n && p + k <= n
  {
    if p + k >= n {
      return Json::Partial;
    }
    if bget(s, p + k) != sget(lit, k) {
      return Json::Bad(p + k);
    }
    k = k + 1;
  }
  if l == 0 {
    return Json::Bad(p);
  }
  return Json::Ok(p + l);
}

/// Where the value that starts at the first non-blank byte at or after `at`
/// ends, past the blanks that follow it. The whole value is checked, nested objects and arrays included.
/// ```
/// let b = bfrom(" {\"a\": [1, 2.5e3, true, null], \"b\": \"x\\n\"} tail");
/// let mut e = 0;
/// match json_value(b, 0) {
///   Json::Ok(x) => { e = x; },
///   Json::Partial => {},
///   Json::Bad(x) => {},
/// }
/// let cut = bfrom("[1, 2");
/// let bad = bfrom("[1,]");
/// let mut p = false;
/// match json_value(cut, 0) { Json::Partial => { p = true; }, Json::Ok(x) => {}, Json::Bad(x) => {} }
/// let mut q = 99;
/// match json_value(bad, 0) { Json::Bad(x) => { q = x; }, Json::Ok(x) => {}, Json::Partial => {} }
/// bfree(b);
/// bfree(cut);
/// bfree(bad);
/// if e != 43 || !p || q != 3 { return 1; }
/// ```
fn json_value(s: &Bytes, at: u64) -> Json
  requires at <= blen(s)
  ensures result is Json::Ok ==> at < result.Ok && result.Ok <= blen(s)
  ensures result is Json::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  let mut p = json_ws(s, at);
  // The kinds of the open containers, innermost in bit 0: 1 for an object.
  let mut stack: u64 = 0;
  let mut depth: u64 = 0;
  // 0: a value is next; 1: a value has just ended; 2: just after `{` or
  // `[`; 3: a key is next.
  let mut state: u64 = 0;
  while true
    invariant at <= p && p <= n && depth <= 32 && state <= 3 && (state < 2 || depth > 0) && (depth > 0 || state != 1 || p > at)
  {
    if state == 1 && depth == 0 {
      return Json::Ok(json_ws(s, p));
    }
    if p >= n {
      return Json::Partial;
    }
    let c = bget(s, p);
    if state == 1 {
      if c == 44 {
        p = json_ws(s, p + 1);
        if (stack & 1) == 1 {
          state = 3;
        } else {
          state = 0;
        }
      } else if (c == 125 && (stack & 1) == 1) || (c == 93 && (stack & 1) == 0) {
        depth = depth - 1;
        stack = stack >> 1;
        p = json_ws(s, p + 1);
      } else {
        return Json::Bad(p);
      }
    } else if state == 3 || (state == 2 && (stack & 1) == 1 && c != 125) {
      if c != 34 {
        return Json::Bad(p);
      }
      match json_str_end(s, p) {
        Json::Ok(e) => { p = json_ws(s, e); },
        Json::Partial => { return Json::Partial; },
        Json::Bad(x) => { return Json::Bad(x); },
      }
      if p >= n {
        return Json::Partial;
      }
      if bget(s, p) != 58 {
        return Json::Bad(p);
      }
      p = json_ws(s, p + 1);
      state = 0;
    } else if state == 2 {
      // `{` followed by `}`, or `[` followed by a value or `]`.
      if (c == 125 && (stack & 1) == 1) || c == 93 {
        if (c == 125) != ((stack & 1) == 1) {
          return Json::Bad(p);
        }
        depth = depth - 1;
        stack = stack >> 1;
        p = json_ws(s, p + 1);
        state = 1;
      } else {
        state = 0;
      }
    } else {
      if c == 123 || c == 91 {
        if depth >= 32 {
          return Json::Bad(p);
        }
        depth = depth + 1;
        stack = (stack & 0x7FFFFFFFFFFFFFFF) << 1;
        if c == 123 {
          stack = stack + 1;
        }
        p = json_ws(s, p + 1);
        state = 2;
      } else if c == 34 {
        match json_str_end(s, p) {
          Json::Ok(e) => { p = e; },
          Json::Partial => { return Json::Partial; },
          Json::Bad(x) => { return Json::Bad(x); },
        }
        state = 1;
      } else if c == 45 || (c >= 48 && c <= 57) {
        match json_num_end(s, p) {
          Json::Ok(e) => { p = e; },
          Json::Partial => { return Json::Partial; },
          Json::Bad(x) => { return Json::Bad(x); },
        }
        state = 1;
      } else if c == 116 {
        match json_lit_end(s, p, "true") {
          Json::Ok(e) => { p = e; },
          Json::Partial => { return Json::Partial; },
          Json::Bad(x) => { return Json::Bad(x); },
        }
        state = 1;
      } else if c == 102 {
        match json_lit_end(s, p, "false") {
          Json::Ok(e) => { p = e; },
          Json::Partial => { return Json::Partial; },
          Json::Bad(x) => { return Json::Bad(x); },
        }
        state = 1;
      } else if c == 110 {
        match json_lit_end(s, p, "null") {
          Json::Ok(e) => { p = e; },
          Json::Partial => { return Json::Partial; },
          Json::Bad(x) => { return Json::Bad(x); },
        }
        state = 1;
      } else {
        return Json::Bad(p);
      }
    }
  }
  return Json::Partial;
}

/// The offset of the value of the member `key` of the object that starts at
/// the first non-blank byte at or after `at`, or `None` when there is no such
/// member or the document is damaged. The first member of that name wins. A key
/// written with escapes is compared as the string it stands for (RFC 8259,
/// section 4), so `"\u0061"` is the key `a`.
/// ```
/// let b = bfrom("{\"a\": 1, \"b\": {\"a\": 2}, \"c\": [true]}");
/// let mut c = 0;
/// match json_member(b, 0, "c") { Option::Some(x) => { c = x; }, Option::None => {} }
/// let gone = json_member(b, 0, "d");
/// let onearr = json_member(b, c, "a");   // `c` is an array, not an object
/// let e = bfrom("{\"a\\u0062\": 7}");           // the key is written with an escape: ab
/// let mut seven = 0;
/// match json_member(e, 0, "ab") { Option::Some(x) => { seven = x; }, Option::None => {} }
/// let raw = json_member(e, 0, "a\\u0062");   // not the spelling in the file
/// bfree(e);
/// bfree(b);
/// if c != 29 || gone is Option::Some || onearr is Option::Some || seven != 12 || raw is Option::Some { return 1; }
/// ```
fn json_member(s: &Bytes, at: u64, key: Str) -> Option[u64]
  requires at <= blen(s)
  ensures result is Option::Some ==> at < result.Some && result.Some < blen(s)
{
  let n = blen(s);
  let mut p = json_ws(s, at);
  if p >= n {
    return Option[u64]::None;
  }
  if bget(s, p) != 123 {
    return Option[u64]::None;
  }
  p = json_ws(s, p + 1);
  while p < n && bget(s, p) == 34
    invariant at <= p && p <= n
  {
    let mut ke = 0;
    match json_str_end(s, p) {
      Json::Ok(x) => { ke = x; },
      Json::Partial => { return Option[u64]::None; },
      Json::Bad(x) => { return Option[u64]::None; },
    }
    if ke < p + 2 || ke > n {
      return Option[u64]::None;
    }
    let q = json_ws(s, ke);
    if q >= n {
      return Option[u64]::None;
    }
    if bget(s, q) != 58 {
      return Option[u64]::None;
    }
    let vs = json_ws(s, q + 1);
    let mut esc = false;
    let mut i = p + 1;
    while i < ke - 1
      invariant p < i && i <= ke - 1
    {
      if bget(s, i) == 92 {
        esc = true;
      }
      i = i + 1;
    }
    let mut hit = false;
    if esc {
      match json_string(s, p) {
        Option::Some(k) => {
          hit = bytes_eq_str(k, key);
          bfree(k);
        },
        Option::None => {},
      }
    } else {
      hit = bytes_span_eq_str(s, p + 1, ke - 1, key);
    }
    if hit {
      if vs < n {
        return Option[u64]::Some(vs);
      }
      return Option[u64]::None;
    }
    let mut ve = 0;
    match json_value(s, vs) {
      Json::Ok(x) => { ve = x; },
      Json::Partial => { return Option[u64]::None; },
      Json::Bad(x) => { return Option[u64]::None; },
    }
    if ve > n {
      return Option[u64]::None;
    }
    let r = json_ws(s, ve);
    if r >= n {
      return Option[u64]::None;
    }
    if bget(s, r) != 44 {
      return Option[u64]::None;
    }
    p = json_ws(s, r + 1);
  }
  return Option[u64]::None;
}

/// The offset of element number `idx` (from 0) of the array that starts at the
/// first non-blank byte at or after `at`, or `None` when there are fewer
/// elements or the document is damaged.
/// ```
/// let b = bfrom("[10, [1, 2], \"x\", null]");
/// let mut third = 0;
/// match json_element(b, 0, 2) { Option::Some(x) => { third = x; }, Option::None => {} }
/// let past = json_element(b, 0, 4);
/// bfree(b);
/// if third != 13 || past is Option::Some { return 1; }
/// ```
fn json_element(s: &Bytes, at: u64, idx: u64) -> Option[u64]
  requires at <= blen(s)
  ensures result is Option::Some ==> at < result.Some && result.Some < blen(s)
{
  let n = blen(s);
  let mut p = json_ws(s, at);
  if p >= n {
    return Option[u64]::None;
  }
  if bget(s, p) != 91 {
    return Option[u64]::None;
  }
  p = json_ws(s, p + 1);
  let mut k = 0;
  while p < n && bget(s, p) != 93
    invariant at < p && p <= n && k <= idx
  {
    if k == idx {
      return Option[u64]::Some(p);
    }
    let mut ve = 0;
    match json_value(s, p) {
      Json::Ok(x) => { ve = x; },
      Json::Partial => { return Option[u64]::None; },
      Json::Bad(x) => { return Option[u64]::None; },
    }
    if ve > n {
      return Option[u64]::None;
    }
    let r = json_ws(s, ve);
    if r >= n {
      return Option[u64]::None;
    }
    if bget(s, r) != 44 {
      return Option[u64]::None;
    }
    p = json_ws(s, r + 1);
    k = k + 1;
  }
  return Option[u64]::None;
}

/// The value at the first non-blank byte at or after `at`, read as a JSON
/// number made only of digits (no sign, fraction or exponent) that fits in a
/// `u64`.
/// ```
/// let b = bfrom("[42, -1, 1.5, 18446744073709551616]");
/// let mut a = 0;
/// match json_u64(b, 1) { Option::Some(x) => { a = x; }, Option::None => {} }
/// let neg = json_u64(b, 5);
/// let frac = json_u64(b, 9);
/// let big = json_u64(b, 14);
/// bfree(b);
/// if a != 42 || neg is Option::Some || frac is Option::Some || big is Option::Some { return 1; }
/// ```
fn json_u64(s: &Bytes, at: u64) -> Option[u64]
  requires at <= blen(s)
{
  let n = blen(s);
  let p = json_ws(s, at);
  if p >= n {
    return Option[u64]::None;
  }
  match json_num_end(s, p) {
    Json::Ok(e) => {
      if e > n || e <= p {
        return Option[u64]::None;
      }
      return parse_u64(s, p, e);
    },
    Json::Partial => { return Option[u64]::None; },
    Json::Bad(x) => { return Option[u64]::None; },
  }
}

/// The value at the first non-blank byte at or after `at`, read as a JSON
/// number made only of an optional `-` and digits (no fraction or exponent)
/// that fits in an `i64`.
/// ```
/// let b = bfrom("[42, -7, -9223372036854775808, 9223372036854775808, 1.5]");
/// let mut a: i64 = 0;
/// let mut m: i64 = 0;
/// let mut lo: i64 = 0;
/// match json_i64(b, 1) { Option::Some(x) => { a = x; }, Option::None => {} }
/// match json_i64(b, 5) { Option::Some(x) => { m = x; }, Option::None => {} }
/// match json_i64(b, 9) { Option::Some(x) => { lo = x; }, Option::None => {} }
/// let big = json_i64(b, 31);
/// let frac = json_i64(b, 52);
/// bfree(b);
/// let min: i64 = -9223372036854775807;
/// if a != 42 || m != -7 || lo != min - 1 { return 1; }
/// if big is Option::Some || frac is Option::Some { return 1; }
/// ```
fn json_i64(s: &Bytes, at: u64) -> Option[i64]
  requires at <= blen(s)
{
  let n = blen(s);
  let p = json_ws(s, at);
  if p >= n {
    return Option[i64]::None;
  }
  match json_num_end(s, p) {
    Json::Ok(e) => {
      if e > n || e <= p {
        return Option[i64]::None;
      }
      return parse_i64(s, p, e);
    },
    Json::Partial => { return Option[i64]::None; },
    Json::Bad(x) => { return Option[i64]::None; },
  }
}

/// Internal: the four hexadecimal digits at `i`, or `None`.
fn json_hex4(s: &Bytes, i: u64) -> Option[u64]
  requires i + 4 <= blen(s)
  ensures result is Option::Some ==> result.Some <= 65535
{
  let a = hex_value(bget(s, i));
  let b = hex_value(bget(s, i + 1));
  let c = hex_value(bget(s, i + 2));
  let d = hex_value(bget(s, i + 3));
  if a == 16 || b == 16 || c == 16 || d == 16 {
    return Option[u64]::None;
  }
  return Option[u64]::Some(a * 4096 + b * 256 + c * 16 + d);
}

/// Internal: appends the UTF-8 encoding of the code point `cp`.
fn json_put_utf8(t: &mut Vec[u8], cp: u64)
  requires cp <= 1114111
{
  if cp < 128 {
    text_push(&mut t, cast[u8](cp));
  } else if cp < 2048 {
    text_push(&mut t, cast[u8](192 + cp / 64));
    text_push(&mut t, cast[u8](128 + cp % 64));
  } else if cp < 65536 {
    text_push(&mut t, cast[u8](224 + cp / 4096));
    text_push(&mut t, cast[u8](128 + (cp / 64) % 64));
    text_push(&mut t, cast[u8](128 + cp % 64));
  } else {
    text_push(&mut t, cast[u8](240 + cp / 262144));
    text_push(&mut t, cast[u8](128 + (cp / 4096) % 64));
    text_push(&mut t, cast[u8](128 + (cp / 64) % 64));
    text_push(&mut t, cast[u8](128 + cp % 64));
  }
}

/// The string at the first non-blank byte at or after `at`, with its escapes
/// decoded (`\u` escapes become UTF-8; a surrogate pair becomes one code
/// point). `None` when it is not a string, is cut short, has a bad escape or
/// holds a surrogate without its partner. The bytes between the escapes are
/// copied as they are.
/// ```
/// let b = bfrom("\"a\\n\\u00e9\\ud83d\\ude00\"");
/// let mut ok = false;
/// match json_string(b, 0) {
///   Option::Some(v) => { ok = blen(v) == 8 && bget(v, 1) == 10 && bget(v, 2) == 195 && bget(v, 3) == 169 && bget(v, 4) == 240 && bget(v, 7) == 128; bfree(v); },
///   Option::None => {},
/// }
/// let lone = bfrom("\"\\ud800\"");
/// let mut refused = true;
/// match json_string(lone, 0) {
///   Option::Some(v) => { refused = false; bfree(v); },
///   Option::None => {},
/// }
/// bfree(b);
/// bfree(lone);
/// if !ok || !refused { return 1; }
/// ```
fn json_string(s: &Bytes, at: u64) -> Option[Bytes]
  requires at <= blen(s)
{
  let n = blen(s);
  let p = json_ws(s, at);
  if p >= n {
    return Option[Bytes]::None;
  }
  if bget(s, p) != 34 {
    return Option[Bytes]::None;
  }
  let mut end = 0;
  match json_str_end(s, p) {
    Json::Ok(x) => { end = x; },
    Json::Partial => { return Option[Bytes]::None; },
    Json::Bad(x) => { return Option[Bytes]::None; },
  }
  if end < p + 2 || end > n {
    return Option[Bytes]::None;
  }
  let stop = end - 1;
  let mut t = text_new();
  let mut i = p + 1;
  let mut ok = true;
  while ok && i < stop
    invariant p < i && i <= stop && stop < n
  {
    let c = bget(s, i);
    if c != 92 {
      text_push(&mut t, c);
      i = i + 1;
    } else if i + 1 >= stop {
      ok = false;
    } else {
      let e = bget(s, i + 1);
      if e == 117 {
        if i + 6 > stop {
          ok = false;
        } else {
          match json_hex4(s, i + 2) {
            Option::None => { ok = false; },
            Option::Some(u) => {
              if u >= 55296 && u < 56320 {
                // A high surrogate needs `\u` and a low surrogate next.
                if i + 12 > stop || bget(s, i + 6) != 92 || bget(s, i + 7) != 117 {
                  ok = false;
                } else {
                  match json_hex4(s, i + 8) {
                    Option::None => { ok = false; },
                    Option::Some(w) => {
                      if w >= 56320 && w < 57344 {
                        json_put_utf8(&mut t, 65536 + (u - 55296) * 1024 + (w - 56320));
                        i = i + 12;
                      } else {
                        ok = false;
                      }
                    },
                  }
                }
              } else if u >= 56320 && u < 57344 {
                ok = false;
              } else {
                json_put_utf8(&mut t, u);
                i = i + 6;
              }
            },
          }
        }
      } else {
        if e == 34 || e == 92 || e == 47 {
          text_push(&mut t, e);
        } else if e == 98 {
          text_push(&mut t, 8);
        } else if e == 102 {
          text_push(&mut t, 12);
        } else if e == 110 {
          text_push(&mut t, 10);
        } else if e == 114 {
          text_push(&mut t, 13);
        } else if e == 116 {
          text_push(&mut t, 9);
        } else {
          ok = false;
        }
        i = i + 2;
      }
    }
  }
  if ok {
    return Option[Bytes]::Some(text_finish(t));
  }
  vec_free(t);
  return Option[Bytes]::None;
}

/// Appends `b` to `t` as a JSON string: in quotes, with `"` and `\` escaped,
/// and the control characters below 32 as `\n`, `\r`, `\t` or `\u00XX`. Valid
/// UTF-8 is copied as it is; a byte that starts no valid sequence is written
/// as U+FFFD, so the result is always a string `json_value` accepts.
/// ```
/// let mut v = bfrom("a\"b\\\n.");
/// bset(&mut v, 5, 1);
/// let mut t = text_new();
/// json_push_string(&mut t, v);
/// let out = text_finish(t);
/// let ok = bytes_eq_str(out, "\"a\\\"b\\\\\\n\\u0001\"");
/// bfree(v);
/// bfree(out);
/// if !ok { return 1; }
/// ```
fn json_push_string(t: &mut Vec[u8], b: &Bytes)
{
  text_push(&mut t, 34);
  let mut i = 0;
  while i < blen(b)
    invariant i <= blen(b)
  {
    let c = bget(b, i);
    if c == 34 || c == 92 {
      text_push(&mut t, 92);
      text_push(&mut t, c);
    } else if c == 10 {
      text_push_str(&mut t, "\\n");
    } else if c == 13 {
      text_push_str(&mut t, "\\r");
    } else if c == 9 {
      text_push_str(&mut t, "\\t");
    } else if c < 32 {
      text_push_str(&mut t, "\\u00");
      text_push(&mut t, hex_char(cast[u64](c) / 16));
      text_push(&mut t, hex_char(cast[u64](c) % 16));
    } else if c >= 128 {
      // Valid UTF-8 is copied; a byte that starts no valid sequence becomes
      // U+FFFD, so what is written is a string the scanner accepts.
      let k = utf8_seq_len(b, i);
      if k == 0 {
        text_push(&mut t, 239);
        text_push(&mut t, 191);
        text_push(&mut t, 189);
      } else {
        let mut j = 0;
        while j < k
          invariant j <= k && i + k <= blen(b)
        {
          text_push(&mut t, bget(b, i + j));
          j = j + 1;
        }
        i = i + (k - 1);
      }
    } else {
      text_push(&mut t, c);
    }
    i = i + 1;
  }
  text_push(&mut t, 34);
}

/// A JSON document being written. Build it with the `json_out_*` calls and
/// take it with `json_out_finish`; the writer keeps track of where commas go
/// and which values may come next, so what comes out is a well-formed
/// document or nothing. A call that does not fit the place it is made (a
/// value in an object without a key before it, a key in an array, an end with
/// nothing open, nesting deeper than 32, a second top-level value) writes
/// nothing and makes `json_out_finish` return `None`.
struct JsonOut {
  text: Vec[u8],
  // Bit `d` is 1 when the container at depth `d` is an object.
  obj: u64,
  // Bit `d` is 1 when the container at depth `d` already has an element.
  full: u64,
  // How many containers are open (at most 32).
  depth: u64,
  // A key was written and its value has not been.
  key: bool,
  // The top-level value is complete.
  done: bool,
  // Some call did not fit.
  bad: bool,
}

/// A new, empty writer.
/// ```
/// let mut o = json_out_new();
/// json_out_begin_obj(&mut o);
/// let k = bfrom("n");
/// json_out_key(&mut o, k);
/// json_out_u64(&mut o, 7);
/// json_out_end(&mut o);
/// bfree(k);
/// match json_out_finish(o) {
///   Option::Some(b) => {
///     let ok = bytes_eq_str(b, "{\"n\":7}");
///     bfree(b);
///     if !ok { return 1; }
///   },
///   Option::None => { return 1; },
/// }
/// ```
fn json_out_new() -> JsonOut
{
  return JsonOut { text: text_new(), obj: 0, full: 0, depth: 0, key: false, done: false, bad: false };
}

/// Internal: makes room for a value at the current place: writes the comma
/// an array element needs, and returns false (and marks the writer bad) when
/// no value may come here. At the top level the value counts as done; a
/// container resets that until it is closed.
fn json_out_slot(o: &mut JsonOut) -> bool
{
  if o.bad || o.done || o.depth > 32 {
    o.bad = true;
    return false;
  }
  if o.depth == 0 {
    o.done = true;
    return true;
  }
  let d = (o.depth - 1) % 64;
  if ((o.obj >> d) & 1) == 1 {
    // In an object a value needs the key written before it.
    if !o.key {
      o.bad = true;
      return false;
    }
    o.key = false;
    o.full = o.full | (1 << d);
    return true;
  }
  if ((o.full >> d) & 1) == 1 {
    text_push(&mut o.text, 44);
  }
  o.full = o.full | (1 << d);
  return true;
}

/// Internal: opens a container (`open` is `{` or `[`, `is_obj` says which).
fn json_out_open(o: &mut JsonOut, open: u8, is_obj: bool)
{
  if o.depth >= 32 {
    o.bad = true;
    return;
  }
  let was_top = o.depth == 0;
  if json_out_slot(&mut o) {
    text_push(&mut o.text, open);
    let d = o.depth % 64;
    if is_obj {
      o.obj = o.obj | (1 << d);
    } else {
      o.obj = o.obj & (18446744073709551615 - (1 << d));
    }
    o.full = o.full & (18446744073709551615 - (1 << d));
    o.depth = o.depth + 1;
    if was_top {
      o.done = false;
    }
  }
}

/// Opens an object (`{`).
/// ```
/// let mut o = json_out_new();
/// json_out_begin_arr(&mut o);
/// json_out_begin_obj(&mut o);
/// json_out_end(&mut o);
/// json_out_begin_obj(&mut o);
/// json_out_end(&mut o);
/// json_out_end(&mut o);
/// match json_out_finish(o) {
///   Option::Some(b) => {
///     let ok = bytes_eq_str(b, "[{},{}]");
///     bfree(b);
///     if !ok { return 1; }
///   },
///   Option::None => { return 1; },
/// }
/// ```
fn json_out_begin_obj(o: &mut JsonOut)
{
  json_out_open(&mut o, 123, true);
}

/// Opens an array (`[`).
/// ```
/// let mut o = json_out_new();
/// json_out_begin_arr(&mut o);
/// json_out_u64(&mut o, 1);
/// json_out_begin_arr(&mut o);
/// json_out_end(&mut o);
/// json_out_end(&mut o);
/// match json_out_finish(o) {
///   Option::Some(b) => {
///     let ok = bytes_eq_str(b, "[1,[]]");
///     bfree(b);
///     if !ok { return 1; }
///   },
///   Option::None => { return 1; },
/// }
/// ```
fn json_out_begin_arr(o: &mut JsonOut)
{
  json_out_open(&mut o, 91, false);
}

/// Closes the innermost object or array. With nothing open, or after a key
/// that has no value yet, the writer goes bad.
/// ```
/// let mut o = json_out_new();
/// json_out_begin_arr(&mut o);
/// json_out_end(&mut o);
/// json_out_end(&mut o);   // nothing is open
/// match json_out_finish(o) {
///   Option::Some(b) => { bfree(b); return 1; },
///   Option::None => {},
/// }
/// ```
fn json_out_end(o: &mut JsonOut)
{
  if o.bad || o.depth == 0 || o.depth > 32 || o.key {
    o.bad = true;
    return;
  }
  let d = (o.depth - 1) % 64;
  if ((o.obj >> d) & 1) == 1 {
    text_push(&mut o.text, 125);
  } else {
    text_push(&mut o.text, 93);
  }
  o.depth = o.depth - 1;
  if o.depth == 0 {
    o.done = true;
  }
}

/// Writes the key of the next member of the open object.
/// ```
/// let mut o = json_out_new();
/// json_out_begin_obj(&mut o);
/// let a = bfrom("a\"b");
/// let c = bfrom("c");
/// json_out_key(&mut o, a);
/// json_out_bool(&mut o, true);
/// json_out_key(&mut o, c);
/// json_out_null(&mut o);
/// json_out_end(&mut o);
/// bfree(a);
/// bfree(c);
/// match json_out_finish(o) {
///   Option::Some(b) => {
///     let ok = bytes_eq_str(b, "{\"a\\\"b\":true,\"c\":null}");
///     bfree(b);
///     if !ok { return 1; }
///   },
///   Option::None => { return 1; },
/// }
/// ```
fn json_out_key(o: &mut JsonOut, k: &Bytes)
{
  if o.bad || o.depth == 0 || o.depth > 32 || o.key {
    o.bad = true;
    return;
  }
  let d = (o.depth - 1) % 64;
  if ((o.obj >> d) & 1) == 0 {
    o.bad = true;
    return;
  }
  if ((o.full >> d) & 1) == 1 {
    text_push(&mut o.text, 44);
  }
  json_push_string(&mut o.text, k);
  text_push(&mut o.text, 58);
  o.key = true;
}

/// Writes a string value, escaped as `json_push_string` does.
/// ```
/// let mut o = json_out_new();
/// let s = bfrom("line\nbreak");
/// json_out_str(&mut o, s);
/// bfree(s);
/// match json_out_finish(o) {
///   Option::Some(b) => {
///     let ok = bytes_eq_str(b, "\"line\\nbreak\"");
///     bfree(b);
///     if !ok { return 1; }
///   },
///   Option::None => { return 1; },
/// }
/// ```
fn json_out_str(o: &mut JsonOut, b: &Bytes)
{
  if json_out_slot(&mut o) {
    json_push_string(&mut o.text, b);
  }
}

/// Writes a number value, `x` in decimal.
/// ```
/// let mut o = json_out_new();
/// json_out_u64(&mut o, 18446744073709551615);
/// match json_out_finish(o) {
///   Option::Some(b) => {
///     let ok = bytes_eq_str(b, "18446744073709551615");
///     bfree(b);
///     if !ok { return 1; }
///   },
///   Option::None => { return 1; },
/// }
/// ```
fn json_out_u64(o: &mut JsonOut, x: u64)
{
  if json_out_slot(&mut o) {
    fmt_u64(&mut o.text, x);
  }
}

/// Writes a signed integer.
/// ```
/// let mut o = json_out_new();
/// json_out_begin_arr(&mut o);
/// json_out_i64(&mut o, -7);
/// json_out_i64(&mut o, 0);
/// let min: i64 = -9223372036854775807;
/// json_out_i64(&mut o, min - 1);
/// json_out_end(&mut o);
/// match json_out_finish(o) {
///   Option::Some(b) => {
///     let ok = bytes_eq_str(b, "[-7,0,-9223372036854775808]");
///     bfree(b);
///     if !ok { return 1; }
///   },
///   Option::None => { return 1; },
/// }
/// ```
fn json_out_i64(o: &mut JsonOut, x: i64)
{
  if json_out_slot(&mut o) {
    fmt_i64(&mut o.text, x);
  }
}

/// Writes `true` or `false`.
/// ```
/// let mut o = json_out_new();
/// json_out_begin_arr(&mut o);
/// json_out_bool(&mut o, true);
/// json_out_bool(&mut o, false);
/// json_out_end(&mut o);
/// match json_out_finish(o) {
///   Option::Some(b) => {
///     let ok = bytes_eq_str(b, "[true,false]");
///     bfree(b);
///     if !ok { return 1; }
///   },
///   Option::None => { return 1; },
/// }
/// ```
fn json_out_bool(o: &mut JsonOut, v: bool)
{
  if json_out_slot(&mut o) {
    if v {
      text_push_str(&mut o.text, "true");
    } else {
      text_push_str(&mut o.text, "false");
    }
  }
}

/// Writes `null`.
/// ```
/// let mut o = json_out_new();
/// json_out_null(&mut o);
/// json_out_null(&mut o);   // a second top-level value does not fit
/// match json_out_finish(o) {
///   Option::Some(b) => { bfree(b); return 1; },
///   Option::None => {},
/// }
/// ```
fn json_out_null(o: &mut JsonOut)
{
  if json_out_slot(&mut o) {
    text_push_str(&mut o.text, "null");
  }
}

/// The finished document, or `None` when a call did not fit or the document
/// is not complete (a container still open, nothing written).
/// ```
/// let mut o = json_out_new();
/// json_out_begin_arr(&mut o);   // never closed
/// match json_out_finish(o) {
///   Option::Some(b) => { bfree(b); return 1; },
///   Option::None => {},
/// }
/// ```
fn json_out_finish(o: JsonOut) -> Option[Bytes]
{
  let ok = !o.bad && o.done && o.depth == 0 && !o.key;
  if ok {
    return Option[Bytes]::Some(text_finish(o.text));
  }
  vec_free(o.text);
  return Option[Bytes]::None;
}
