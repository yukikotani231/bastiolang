// core/sort.bastio: sorting and searching vectors of `u64`.

/// Elements `0..n` of `v` are in ascending order.
spec fn sorted_upto(v: &Vec[u64], n: u64) -> bool {
  forall a: u64 :: forall b: u64 :: a < b && b < n ==> vget(v, a) <= vget(v, b)
}

/// `v` is in ascending order.
spec fn sorted(v: &Vec[u64]) -> bool {
  sorted_upto(v, vlen(v))
}

/// Sorts `v` in ascending order (insertion sort: fast for short or nearly
/// sorted vectors, quadratic in the worst case). That the result is a
/// permutation of the input is not stated: see docs/core.md, "Gaps".
fn sort_u64(v: &mut Vec[u64])
  ensures vlen(v) == vlen(old(v)) && sorted(v)
{
  let n = vec_len(v);
  let mut i = 1;
  while i < n
    invariant 1 <= i && vlen(v) == n && (n > 0 ==> i <= n) && sorted_upto(v, i)
  {
    let x = vec_get(v, i);
    let mut j = i;
    while j > 0 && vec_get(v, j - 1) > x
      invariant j <= i && vlen(v) == n
      invariant forall a: u64 :: forall b: u64 :: a < b && b < j ==> vget(v, a) <= vget(v, b)
      invariant forall a: u64 :: forall b: u64 :: j < a && a < b && b <= i ==> vget(v, a) <= vget(v, b)
      invariant forall a: u64 :: j < a && a <= i ==> vget(v, a) > x
      invariant j > 0 && j < i ==> vget(v, j - 1) <= vget(v, j + 1)
    {
      vec_set(&mut v, j, vec_get(v, j - 1));
      j = j - 1;
    }
    vec_set(&mut v, j, x);
    i = i + 1;
  }
}

/// The first index whose element is at least `x` (`vlen(v)` if none is):
/// where `x` is, or would be inserted, in a sorted vector.
fn lower_bound_u64(v: &Vec[u64], x: u64) -> u64
  requires sorted(v)
  ensures result <= vlen(v)
  ensures forall k: u64 :: k < result ==> vget(v, k) < x
  ensures forall k: u64 :: result <= k && k < vlen(v) ==> vget(v, k) >= x
{
  let mut lo = 0;
  let mut hi = vec_len(v);
  while lo < hi
    invariant lo <= hi && hi <= vlen(v)
    invariant forall k: u64 :: k < lo ==> vget(v, k) < x
    invariant forall k: u64 :: hi <= k && k < vlen(v) ==> vget(v, k) >= x
  {
    let mid = lo + (hi - lo) / 2;
    if vec_get(v, mid) < x {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo;
}

/// `x` is an element of the sorted vector `v`.
fn sorted_contains_u64(v: &Vec[u64], x: u64) -> bool
  requires sorted(v)
  ensures result == !(forall k: u64 :: k < vlen(v) ==> vget(v, k) != x)
{
  let i = lower_bound_u64(v, x);
  return i < vec_len(v) && vec_get(v, i) == x;
}

/// `x` is an element of `v` (a linear scan; `v` need not be sorted).
fn vec_contains_u64(v: &Vec[u64], x: u64) -> bool
  ensures result == !(forall k: u64 :: k < vlen(v) ==> vget(v, k) != x)
{
  let mut i = 0;
  while i < vec_len(v)
    invariant i <= vlen(v) && (forall k: u64 :: k < i ==> vget(v, k) != x)
  {
    if vec_get(v, i) == x {
      return true;
    }
    i = i + 1;
  }
  return false;
}
