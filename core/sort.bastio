// core/sort.bastio: sorting and searching vectors of `u64`, and sorting
// indices by a key.

/// Elements `0..n` of `v` are in ascending order.
spec fn sorted_upto(v: &Vec[u64], n: u64) -> bool {
  forall a: u64 :: forall b: u64 :: a < b && b < n ==> vget(v, a) <= vget(v, b)
}

/// `v` is in ascending order.
spec fn sorted(v: &Vec[u64]) -> bool {
  sorted_upto(v, vlen(v))
}

/// `a` and `b` hold the same elements, each as many times: one is a
/// permutation of the other.
spec fn same_elems(a: &Vec[u64], b: &Vec[u64]) -> bool {
  vlen(a) == vlen(b) && forall x: u64 :: vcount(a, x) == vcount(b, x)
}

/// Sorts `v` in ascending order (insertion sort: fast for short or nearly
/// sorted vectors, quadratic in the worst case). The result is proved
/// sorted and a permutation of the input.
fn sort_u64(v: &mut Vec[u64])
  ensures same_elems(v, old(v)) && sorted(v)
{
  let n = vec_len(v);
  let mut i = 1;
  while i < n
    invariant 1 <= i && vlen(v) == n && (n > 0 ==> i <= n) && sorted_upto(v, i)
    invariant same_elems(v, old(v))
  {
    // Move element i down by swaps until the one before it is not larger.
    let mut j = i;
    while j > 0 && vec_get(v, j - 1) > vec_get(v, j)
      invariant j <= i && i < n && vlen(v) == n
      invariant same_elems(v, old(v))
      invariant forall a: u64 :: forall b: u64 :: a < b && b < j ==> vget(v, a) <= vget(v, b)
      invariant forall a: u64 :: forall b: u64 :: j < a && a < b && b <= i ==> vget(v, a) <= vget(v, b)
      invariant forall a: u64 :: j < a && a <= i ==> vget(v, a) > vget(v, j)
      invariant j > 0 && j < i ==> vget(v, j - 1) <= vget(v, j + 1)
    {
      let below = vec_get(v, j - 1);
      let here = vec_swap(&mut v, j, below);
      vec_set(&mut v, j - 1, here);
      j = j - 1;
    }
    i = i + 1;
  }
}

/// `v` is in descending order.
spec fn sorted_desc(v: &Vec[u64]) -> bool {
  forall a: u64 :: forall b: u64 :: a < b && b < vlen(v) ==> vget(v, a) >= vget(v, b)
}

/// Every element of `v` is at most `x`.
spec fn all_at_most(v: &Vec[u64], x: u64) -> bool {
  forall k: u64 :: k < vlen(v) ==> vget(v, k) <= x
}

/// Sorts `v` in ascending order in O(n log n) time (merge sort, with
/// insertion sort below 16 elements). Proved sorted and a permutation of
/// the input, as `sort_u64` is. Uses `n` words of extra memory.
fn merge_sort_u64(v: &mut Vec[u64])
  ensures same_elems(v, old(v)) && sorted(v)
{
  let n = vec_len(v);
  if n <= 16 {
    sort_u64(&mut v);
    return;
  }
  // Deal the elements out into two halves.
  let mut a = vec_new[u64]();
  let mut b = vec_new[u64]();
  while vec_len(v) > 0
    invariant vlen(v) + vlen(a) + vlen(b) == n
    invariant forall x: u64 :: vcount(v, x) + vcount(a, x) + vcount(b, x) == vcount(old(v), x)
  {
    let x = vec_pop(&mut v);
    if vec_len(a) <= vec_len(b) {
      vec_push(&mut a, x);
    } else {
      vec_push(&mut b, x);
    }
  }
  merge_sort_u64(&mut a);
  merge_sort_u64(&mut b);
  // Merge from the tails: the larger tail goes first, so `out` descends.
  let mut out = vec_new[u64]();
  while vec_len(a) > 0 || vec_len(b) > 0
    invariant vlen(v) == 0 && vlen(out) + vlen(a) + vlen(b) == n
    invariant forall x: u64 :: vcount(out, x) + vcount(a, x) + vcount(b, x) == vcount(old(v), x)
    invariant sorted(a) && sorted(b) && sorted_desc(out)
    invariant vlen(out) > 0 ==> all_at_most(a, vget(out, vlen(out) - 1)) && all_at_most(b, vget(out, vlen(out) - 1))
  {
    let la = vec_len(a);
    let lb = vec_len(b);
    if lb == 0 || (la > 0 && vec_get(a, la - 1) >= vec_get(b, lb - 1)) {
      let x = vec_pop(&mut a);
      vec_push(&mut out, x);
    } else {
      let x = vec_pop(&mut b);
      vec_push(&mut out, x);
    }
  }
  vec_free(a);
  vec_free(b);
  // Pour `out` back into `v`, smallest first.
  while vec_len(out) > 0
    invariant vlen(v) + vlen(out) == n
    invariant forall x: u64 :: vcount(v, x) + vcount(out, x) == vcount(old(v), x)
    invariant sorted(v) && sorted_desc(out)
    invariant vlen(v) > 0 && vlen(out) > 0 ==> vget(v, vlen(v) - 1) <= vget(out, vlen(out) - 1)
  {
    let x = vec_pop(&mut out);
    vec_push(&mut v, x);
  }
  vec_free(out);
}

/// Every element of `v` is less than `n` (an index into a vector of length `n`).
spec fn all_indices_below(v: &Vec[u64], n: u64) -> bool {
  forall k: u64 :: k < vlen(v) ==> vget(v, k) < n
}

/// Index `x` comes no later than index `y` when sorting by `keys`: a
/// smaller key first, and on equal keys the smaller index.
spec fn key_le(keys: &Vec[u64], x: u64, y: u64) -> bool {
  vget(keys, x) < vget(keys, y) || (vget(keys, x) == vget(keys, y) && x <= y)
}

/// The elements of `v` are indices into `keys`, in ascending order of key,
/// and indices with equal keys in ascending order.
spec fn sorted_by_key(v: &Vec[u64], keys: &Vec[u64]) -> bool {
  all_indices_below(v, vlen(keys)) &&
  (forall a: u64 :: forall b: u64 :: a < b && b < vlen(v) ==> key_le(keys, vget(v, a), vget(v, b)))
}

/// The same, in descending order.
spec fn sorted_by_key_desc(v: &Vec[u64], keys: &Vec[u64]) -> bool {
  all_indices_below(v, vlen(keys)) &&
  (forall a: u64 :: forall b: u64 :: a < b && b < vlen(v) ==> key_le(keys, vget(v, b), vget(v, a)))
}

/// Every element of `v` comes no later than index `x`.
spec fn all_keys_at_most(v: &Vec[u64], keys: &Vec[u64], x: u64) -> bool {
  forall k: u64 :: k < vlen(v) ==> key_le(keys, vget(v, k), x)
}

/// Sorts `v`, a vector of indices into `keys`, by key: afterwards
/// `keys[v[0]] <= keys[v[1]] <= ...`, indices with equal keys ascend, and
/// `v` holds the same indices. Sorting `0..n` this way is a stable sort of
/// n records by a field. Merge sort, O(n log n).
fn sort_by_key_u64(v: &mut Vec[u64], keys: &Vec[u64])
  requires all_indices_below(v, vlen(keys))
  ensures same_elems(v, old(v)) && sorted_by_key(v, keys)
{
  let n = vec_len(v);
  if n <= 1 {
    return;
  }
  // Deal the elements out into two halves.
  let mut a = vec_new[u64]();
  let mut b = vec_new[u64]();
  while vec_len(v) > 0
    invariant vlen(v) + vlen(a) + vlen(b) == n
    invariant forall x: u64 :: vcount(v, x) + vcount(a, x) + vcount(b, x) == vcount(old(v), x)
    invariant all_indices_below(v, vlen(keys)) && all_indices_below(a, vlen(keys)) && all_indices_below(b, vlen(keys))
  {
    let x = vec_pop(&mut v);
    if vec_len(a) <= vec_len(b) {
      vec_push(&mut a, x);
    } else {
      vec_push(&mut b, x);
    }
  }
  sort_by_key_u64(&mut a, keys);
  sort_by_key_u64(&mut b, keys);
  // Merge from the tails: the later of the two tails (larger key, or equal
  // key and larger index) goes first, so `out` descends.
  let mut out = vec_new[u64]();
  while vec_len(a) > 0 || vec_len(b) > 0
    invariant vlen(v) == 0 && vlen(out) + vlen(a) + vlen(b) == n
    invariant forall x: u64 :: vcount(out, x) + vcount(a, x) + vcount(b, x) == vcount(old(v), x)
    invariant sorted_by_key(a, keys) && sorted_by_key(b, keys) && sorted_by_key_desc(out, keys)
    invariant vlen(out) > 0 ==> all_keys_at_most(a, keys, vget(out, vlen(out) - 1)) && all_keys_at_most(b, keys, vget(out, vlen(out) - 1))
  {
    let la = vec_len(a);
    let lb = vec_len(b);
    let mut take_a = lb == 0;
    if la > 0 && lb > 0 {
      let x = vec_get(a, la - 1);
      let y = vec_get(b, lb - 1);
      let kx = vec_get(keys, x);
      let ky = vec_get(keys, y);
      take_a = kx > ky || (kx == ky && x >= y);
    }
    if take_a {
      let x = vec_pop(&mut a);
      vec_push(&mut out, x);
    } else {
      let x = vec_pop(&mut b);
      vec_push(&mut out, x);
    }
  }
  vec_free(a);
  vec_free(b);
  // Pour `out` back into `v`, smallest key first.
  while vec_len(out) > 0
    invariant vlen(v) + vlen(out) == n
    invariant forall x: u64 :: vcount(v, x) + vcount(out, x) == vcount(old(v), x)
    invariant sorted_by_key(v, keys) && sorted_by_key_desc(out, keys)
    invariant vlen(v) > 0 && vlen(out) > 0 ==> key_le(keys, vget(v, vlen(v) - 1), vget(out, vlen(out) - 1))
  {
    let x = vec_pop(&mut out);
    vec_push(&mut v, x);
  }
  vec_free(out);
}

/// The first index whose element is at least `x` (`vlen(v)` if none is):
/// where `x` is, or would be inserted, in a sorted vector.
fn lower_bound_u64(v: &Vec[u64], x: u64) -> u64
  requires sorted(v)
  ensures result <= vlen(v)
  ensures forall k: u64 :: k < result ==> vget(v, k) < x
  ensures forall k: u64 :: result <= k && k < vlen(v) ==> vget(v, k) >= x
{
  let mut lo = 0;
  let mut hi = vec_len(v);
  while lo < hi
    invariant lo <= hi && hi <= vlen(v)
    invariant forall k: u64 :: k < lo ==> vget(v, k) < x
    invariant forall k: u64 :: hi <= k && k < vlen(v) ==> vget(v, k) >= x
  {
    let mid = lo + (hi - lo) / 2;
    if vec_get(v, mid) < x {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo;
}

/// `x` is an element of the sorted vector `v`.
fn sorted_contains_u64(v: &Vec[u64], x: u64) -> bool
  requires sorted(v)
  ensures result == !(forall k: u64 :: k < vlen(v) ==> vget(v, k) != x)
{
  let i = lower_bound_u64(v, x);
  return i < vec_len(v) && vec_get(v, i) == x;
}

/// `x` is an element of `v` (a linear scan; `v` need not be sorted).
fn vec_contains_u64(v: &Vec[u64], x: u64) -> bool
  ensures result == !(forall k: u64 :: k < vlen(v) ==> vget(v, k) != x)
{
  let mut i = 0;
  while i < vec_len(v)
    invariant i <= vlen(v) && (forall k: u64 :: k < i ==> vget(v, k) != x)
  {
    if vec_get(v, i) == x {
      return true;
    }
    i = i + 1;
  }
  return false;
}
