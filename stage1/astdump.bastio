// Prints the parse of a source file in the format of `bastioc0 --dump-ast`
// (see stage0/src/dump.rs), for differential testing against stage0.
import "parser.bastio";
import "out.bastio";

fn text(con: &Serial, p: &Parser, s: u64, e: u64) {
  if s <= e && e <= blen(p.src) {
    put_text(con, p.src, s, e);
  }
}

fn name_of(con: &Serial, p: &Parser, n: Node) {
  text(con, p, n.s, n.e);
}

fn pos_of(con: &Serial, n: Node) {
  put_pos(con, n.line, n.col);
}

fn op_text(con: &Serial, op: u64) {
  if op == P_IMPLIES { put(con, "==>"); }
  else if op == P_EQEQ { put(con, "=="); }
  else if op == P_NE { put(con, "!="); }
  else if op == P_LE { put(con, "<="); }
  else if op == P_GE { put(con, ">="); }
  else if op == P_ANDAND { put(con, "&&"); }
  else if op == P_OROR { put(con, "||"); }
  else if op == P_PLUS { put(con, "+"); }
  else if op == P_MINUS { put(con, "-"); }
  else if op == P_STAR { put(con, "*"); }
  else if op == P_SLASH { put(con, "/"); }
  else if op == P_PERCENT { put(con, "%"); }
  else if op == P_LT { put(con, "<"); }
  else if op == P_GT { put(con, ">"); }
}

fn dump_type(con: &Serial, p: &Parser, i: u64) {
  let n = node_at(p.nodes, i);
  if n.kind == T_NAMED {
    name_of(con, p, n);
  } else if n.kind == T_GENERIC {
    name_of(con, p, n);
    put(con, "[");
    let mut k = n.a;
    while k != 0 {
      dump_type(con, p, k);
      k = next_of(p, k);
      if k != 0 {
        put(con, ", ");
      }
    }
    put(con, "]");
  } else if n.kind == T_REF {
    put(con, "&");
    dump_type(con, p, n.a);
  } else if n.kind == T_MUTREF {
    put(con, "&mut ");
    dump_type(con, p, n.a);
  } else if n.kind == T_UNIT {
    put(con, "()");
  }
}

/// The names of a list, separated by `sep`.
fn dump_names(con: &Serial, p: &Parser, i: u64, sep: Str) {
  let mut k = i;
  while k != 0 {
    let n = node_at(p.nodes, k);
    name_of(con, p, n);
    k = n.next;
    if k != 0 {
      put(con, sep);
    }
  }
}

/// `(kind L:C`
fn begin(con: &Serial, kind: Str, n: Node) {
  put(con, "(");
  put(con, kind);
  put(con, " ");
  pos_of(con, n);
}

/// Each expression of a list, each after a space.
fn dump_exprs(con: &Serial, p: &Parser, i: u64) {
  let mut k = i;
  while k != 0 {
    put(con, " ");
    dump_expr(con, p, k);
    k = next_of(p, k);
  }
}

fn dump_expr(con: &Serial, p: &Parser, i: u64) {
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_INT {
    begin(con, "int", n);
    put(con, " ");
    put_num(con, n.v);
  } else if k == E_BOOL {
    begin(con, "bool", n);
    if n.v == 1 { put(con, " true"); } else { put(con, " false"); }
  } else if k == E_STR {
    begin(con, "str", n);
    put(con, " ");
    if n.s <= n.e && n.e <= blen(p.src) {
      put_str_hex(con, p.src, n.s, n.e);
    }
  } else if k == E_BLOB {
    begin(con, "blob", n);
    put(con, " ");
    put_num(con, n.v);
  } else if k == E_MUTBORROW {
    begin(con, "mutborrow", n);
    put(con, " ");
    dump_names(con, p, n.a, ".");
  } else if k == E_FIELD {
    begin(con, "field", n);
    put(con, " ");
    dump_expr(con, p, n.a);
    put(con, " ");
    name_of(con, p, n);
  } else if k == E_SLIT {
    begin(con, "slit", n);
    put(con, " ");
    name_of(con, p, n);
    let mut f = n.a;
    while f != 0 {
      let fi = node_at(p.nodes, f);
      put(con, " (");
      name_of(con, p, fi);
      put(con, " ");
      dump_expr(con, p, fi.a);
      put(con, ")");
      f = fi.next;
    }
  } else if k == E_VARIANT {
    begin(con, "variant", n);
    put(con, " ");
    name_of(con, p, n);
    put(con, " ");
    text(con, p, n.s2, n.e2);
    if n.a != 0 {
      put(con, " ");
      dump_expr(con, p, n.a);
    }
  } else if k == E_IS {
    begin(con, "is", n);
    put(con, " ");
    dump_expr(con, p, n.a);
    put(con, " ");
    name_of(con, p, n);
    put(con, " ");
    text(con, p, n.s2, n.e2);
  } else if k == E_VAR {
    begin(con, "var", n);
    put(con, " ");
    name_of(con, p, n);
  } else if k == E_NOT {
    begin(con, "not", n);
    put(con, " ");
    dump_expr(con, p, n.a);
  } else if k == E_BIN {
    begin(con, "bin", n);
    put(con, " ");
    op_text(con, n.v);
    put(con, " ");
    dump_expr(con, p, n.a);
    put(con, " ");
    dump_expr(con, p, n.b);
  } else if k == E_CALL {
    begin(con, "call", n);
    put(con, " ");
    name_of(con, p, n);
    dump_exprs(con, p, n.a);
  } else if k == E_FORALL {
    begin(con, "forall", n);
    put(con, " ");
    name_of(con, p, n);
    put(con, " ");
    dump_expr(con, p, n.a);
  } else if k == E_TAPP {
    begin(con, "tapp", n);
    put(con, " [");
    let mut t = n.a;
    while t != 0 {
      dump_type(con, p, t);
      t = next_of(p, t);
      if t != 0 {
        put(con, " ");
      }
    }
    put(con, "] ");
    dump_expr(con, p, n.b);
  }
  put(con, ")");
}

fn dump_block(con: &Serial, p: &Parser, i: u64) {
  put(con, "(block");
  let mut k = i;
  while k != 0 {
    put(con, " ");
    dump_stmt(con, p, k);
    k = next_of(p, k);
  }
  put(con, ")");
}

fn dump_stmt(con: &Serial, p: &Parser, i: u64) {
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == S_LET {
    begin(con, "let", n);
    put(con, " ");
    if n.v == 1 { put(con, "mut "); }
    name_of(con, p, n);
    put(con, " ");
    if n.a == 0 { put(con, "_"); } else { dump_type(con, p, n.a); }
    put(con, " ");
    dump_expr(con, p, n.b);
  } else if k == S_ASSIGN {
    begin(con, "assign", n);
    put(con, " ");
    dump_names(con, p, n.a, ".");
    put(con, " ");
    dump_expr(con, p, n.b);
  } else if k == S_IF {
    begin(con, "if", n);
    put(con, " ");
    dump_expr(con, p, n.a);
    put(con, " ");
    dump_block(con, p, n.b);
    put(con, " ");
    dump_block(con, p, n.c);
  } else if k == S_WHILE {
    begin(con, "while", n);
    put(con, " ");
    dump_expr(con, p, n.a);
    let mut v = n.b;
    while v != 0 {
      put(con, " (inv ");
      dump_expr(con, p, v);
      put(con, ")");
      v = next_of(p, v);
    }
    put(con, " ");
    dump_block(con, p, n.c);
  } else if k == S_RETURN {
    begin(con, "return", n);
    if n.a != 0 {
      put(con, " ");
      dump_expr(con, p, n.a);
    }
  } else if k == S_UNREACHABLE {
    begin(con, "unreachable", n);
  } else if k == S_ASSERT {
    begin(con, "assert", n);
    put(con, " ");
    dump_expr(con, p, n.a);
  } else if k == S_EXPR {
    begin(con, "expr", n);
    put(con, " ");
    dump_expr(con, p, n.a);
  } else if k == S_MATCH {
    begin(con, "match", n);
    put(con, " ");
    dump_expr(con, p, n.a);
    let mut a = n.b;
    while a != 0 {
      let arm = node_at(p.nodes, a);
      put(con, " ");
      begin(con, "arm", arm);
      put(con, " ");
      if arm.v == PAT_WILD {
        put(con, "_");
      } else {
        name_of(con, p, arm);
        put(con, "::");
        text(con, p, arm.s2, arm.e2);
        if arm.v != PAT_VARIANT {
          put(con, "(");
          if arm.v == PAT_BIND_MUT { put(con, "mut "); }
          name_of(con, p, node_at(p.nodes, arm.a));
          put(con, ")");
        }
      }
      put(con, " ");
      dump_block(con, p, arm.c);
      put(con, ")");
      a = arm.next;
    }
  }
  put(con, ")");
}

fn dump_tparams(con: &Serial, p: &Parser, i: u64) {
  put(con, " [");
  dump_names(con, p, i, " ");
  put(con, "]");
}

fn dump_params(con: &Serial, p: &Parser, i: u64) {
  put(con, " (params");
  let mut k = i;
  while k != 0 {
    let n = node_at(p.nodes, k);
    put(con, " ");
    begin(con, "p", n);
    put(con, " ");
    if n.v == 1 { put(con, "mut "); }
    name_of(con, p, n);
    put(con, " ");
    dump_type(con, p, n.a);
    put(con, ")");
    k = n.next;
  }
  put(con, ")");
}

fn dump_program(con: &Serial, p: &Parser) {
  let mut k = p.structs;
  while k != 0 {
    let n = node_at(p.nodes, k);
    begin(con, "struct", n);
    put(con, " ");
    name_of(con, p, n);
    dump_tparams(con, p, n.v);
    let mut f = n.a;
    while f != 0 {
      let fd = node_at(p.nodes, f);
      put(con, " (");
      name_of(con, p, fd);
      put(con, " ");
      dump_type(con, p, fd.a);
      put(con, ")");
      f = fd.next;
    }
    put(con, ")\n");
    k = n.next;
  }
  k = p.enums;
  while k != 0 {
    let n = node_at(p.nodes, k);
    begin(con, "enum", n);
    put(con, " ");
    name_of(con, p, n);
    dump_tparams(con, p, n.v);
    let mut v = n.a;
    while v != 0 {
      let vd = node_at(p.nodes, v);
      put(con, " (");
      name_of(con, p, vd);
      if vd.a != 0 {
        put(con, " ");
        dump_type(con, p, vd.a);
      }
      put(con, ")");
      v = vd.next;
    }
    put(con, ")\n");
    k = n.next;
  }
  k = p.specs;
  while k != 0 {
    let n = node_at(p.nodes, k);
    begin(con, "spec", n);
    put(con, " ");
    name_of(con, p, n);
    dump_params(con, p, n.a);
    put(con, " ");
    dump_type(con, p, n.b);
    put(con, " ");
    dump_expr(con, p, n.c);
    put(con, ")\n");
    k = n.next;
  }
  k = p.fns;
  while k != 0 {
    let n = node_at(p.nodes, k);
    begin(con, "fn", n);
    put(con, " ");
    name_of(con, p, n);
    dump_tparams(con, p, n.v);
    dump_params(con, p, n.a);
    put(con, " ");
    dump_type(con, p, n.b);
    let mut r = n.c;
    while r != 0 {
      put(con, " (requires ");
      dump_expr(con, p, r);
      put(con, ")");
      r = next_of(p, r);
    }
    let mut e = n.d;
    while e != 0 {
      put(con, " (ensures ");
      dump_expr(con, p, e);
      put(con, ")");
      e = next_of(p, e);
    }
    put(con, " ");
    dump_block(con, p, n.x);
    put(con, ")\n");
    k = n.next;
  }
}

fn put_error(con: &Serial, line: u64, col: u64) {
  put(con, "error ");
  put_pos(con, line, col);
  put(con, "\n");
}

/// The bytes of a string token's text, escapes decoded.
fn decode(src: &Bytes, s: u64, e: u64) -> Bytes
  requires s <= e && e <= blen(src)
{
  // First count, then fill.
  let mut n = 0;
  let mut i = s;
  while i < e
    invariant s <= i && i <= e && e <= blen(src) && n <= i - s
  {
    if bget(src, i) == 92 && i + 1 < e { i = i + 2; } else { i = i + 1; }
    n = n + 1;
  }
  let mut out = balloc(n);
  let mut k = 0;
  i = s;
  while i < e && k < n
    invariant s <= i && i <= e && e <= blen(src) && k <= n && blen(out) == n
  {
    let c = bget(src, i);
    if c == 92 && i + 1 < e {
      let x = bget(src, i + 1);
      if x == 110 { bset(&mut out, k, 10); }
      else if x == 114 { bset(&mut out, k, 13); }
      else if x == 116 { bset(&mut out, k, 9); }
      else if x == 48 { bset(&mut out, k, 0); }
      else { bset(&mut out, k, x); }
      i = i + 2;
    } else {
      bset(&mut out, k, c);
      i = i + 1;
    }
    k = k + 1;
  }
  return out;
}

/// `dir` joined with `path`, as Rust's `Path::join` does: an absolute
/// `path` replaces `dir`.
fn join(dir: &Bytes, path: &Bytes) -> Bytes {
  let a = blen(dir);
  let b = blen(path);
  if a == 0 || (b > 0 && bget(path, 0) == 47) || a > SRC_MAX || b > SRC_MAX {
    return copy_bytes(path);
  }
  let mut sep = 1;
  if bget(dir, a - 1) == 47 {
    sep = 0;
  }
  let mut out = balloc(a + sep + b);
  let mut k = 0;
  while k < a
    invariant k <= a && blen(out) == a + sep + b && a == blen(dir)
  {
    bset(&mut out, k, bget(dir, k));
    k = k + 1;
  }
  if sep == 1 {
    bset(&mut out, a, 47);
  }
  k = 0;
  while k < b
    invariant k <= b && blen(out) == a + sep + b && b == blen(path)
  {
    bset(&mut out, a + sep + k, bget(path, k));
    k = k + 1;
  }
  return out;
}

fn copy_bytes(b: &Bytes) -> Bytes {
  let n = blen(b);
  if n > SRC_MAX {
    return balloc(0);
  }
  let mut out = balloc(n);
  let mut k = 0;
  while k < n
    invariant k <= n && blen(out) == n && n == blen(b)
  {
    bset(&mut out, k, bget(b, k));
    k = k + 1;
  }
  return out;
}

/// The directory part of `path`, as Rust's `Path::parent` gives it.
fn parent(path: &Bytes) -> Bytes {
  let n = blen(path);
  let mut k = n;
  let mut slash = U64_MAX;
  while k > 0 && slash == U64_MAX
    invariant k <= n && n == blen(path) && (slash == U64_MAX || slash < n)
  {
    k = k - 1;
    if bget(path, k) == 47 {
      slash = k;
    }
  }
  if slash == U64_MAX || n > SRC_MAX {
    return balloc(0);
  }
  let mut plen = slash;
  if slash == 0 {
    plen = 1;                        // the root directory
  }
  let mut out = balloc(plen);
  let mut i = 0;
  while i < plen
    invariant i <= plen && blen(out) == plen && plen <= n && n == blen(path)
  {
    bset(&mut out, i, bget(path, i));
    i = i + 1;
  }
  return out;
}

/// Reads the file of every `include_bytes`, in source order, and records
/// its length. Returns the index of the first that cannot be read, or 0.
fn read_blobs(host: &Host, p: &mut Parser, dir: &Bytes) -> u64 {
  let mut k = 0;
  while k < vec_len(p.blobs)
    invariant k <= vlen(p.blobs)
  {
    let i = vec_get(p.blobs, k);
    let mut n = node_at(p.nodes, i);
    if !(n.s <= n.e && n.e <= blen(p.src)) {
      return i;
    }
    let rel = decode(p.src, n.s, n.e);
    let full = join(dir, rel);
    let mut data = balloc(0);
    let ok = host_read(host, full, &mut data);
    n.v = blen(data);
    bfree(data);
    bfree(full);
    bfree(rel);
    if !ok || i >= vec_len(p.nodes) {
      return i;
    }
    vec_set(&mut p.nodes, i, n);
    k = k + 1;
  }
  return 0;
}

fn main(con: &mut Serial, host: &mut Host) -> u64 {
  let path = host_arg(host, 1);
  let mut src = balloc(0);
  let ok = host_read(host, path, &mut src);
  if !ok || blen(src) > SRC_MAX {
    put(con, "astdump: cannot read the file\n");
    bfree(path);
    bfree(src);
    return 2;
  }
  let dir = parent(path);
  bfree(path);
  let mut toks = vec_new[Tok]();
  let last = lex(src, &mut toks);
  if last.kind == K_ERROR {
    put_error(con, last.line, last.col);
    vec_free(toks);
    bfree(src);
    bfree(dir);
    return 1;
  }
  // Leading `import "path";` lines are printed, not followed.
  let mut i = 0;
  let mut bad = false;
  while !bad && is_kw(tok_at(toks, i), KW_IMPORT) && i < SRC_MAX
    invariant i <= SRC_MAX + 2
  {
    let t = tok_at(toks, i);
    let name = tok_at(toks, i + 1);
    let semi = tok_at(toks, i + 2);
    if name.kind != K_STR {
      put_error(con, name.line, name.col);
      bad = true;
    } else if !is_p(semi, P_SEMI) {
      put_error(con, semi.line, semi.col);
      bad = true;
    } else {
      put(con, "(import ");
      put_pos(con, t.line, t.col);
      put(con, " ");
      if name.start <= name.end && name.end <= blen(src) {
        put_str_hex(con, src, name.start, name.end);
      }
      put(con, ")\n");
      i = i + 3;
    }
  }
  if bad {
    vec_free(toks);
    bfree(src);
    bfree(dir);
    return 1;
  }
  let mut p = parser_new(src, toks, i);
  program(&mut p);
  let mut code = 0;
  let blob = read_blobs(host, &mut p, dir);
  if blob != 0 {
    // stage0 reads each file as it parses, so a failed read comes first.
    let n = node_at(p.nodes, blob);
    put_error(con, n.line, n.col);
    code = 1;
  } else if p.failed {
    put_error(con, p.eline, p.ecol);
    code = 1;
  } else {
    dump_program(con, p);
  }
  bfree(dir);
  bfree(parser_free(p));
  return code;
}
