// Prints the tokens of a source file in the format of `bastioc0
// --dump-tokens`, for differential testing against stage0.
import "lexer.bastio";
import "out.bastio";

fn main(con: &mut Serial, host: &mut Host) -> u64 {
  let path = host_arg(host, 1);
  let mut src = balloc(0);
  let ok = host_read(host, path, &mut src);
  bfree(path);
  if !ok || blen(src) > SRC_MAX {
    put(con, "lexdump: cannot read the file\n");
    bfree(src);
    return 2;
  }
  let mut toks = vec_new[Tok]();
  let last = lex(src, &mut toks);
  let mut k = 0;
  let mut code = 0;
  if last.kind == K_ERROR {
    // stage0 prints only the error.
    put(con, "error ");
    put_num(con, last.line);
    put(con, ":");
    put_num(con, last.col);
    put(con, "\n");
    k = vec_len(toks);
    code = 1;
  }
  while k < vec_len(toks)
    invariant k <= vlen(toks)
  {
    let t = vec_get(toks, k);
    put_num(con, t.line);
    put(con, ":");
    put_num(con, t.col);
    put(con, " ");
    if t.start <= t.end && t.end <= blen(src) {
      if t.kind == K_INT {
        put(con, "int ");
        put_num(con, t.val);
      } else if t.kind == K_STR {
        put(con, "str ");
        put_str_hex(con, src, t.start, t.end);
      } else if t.kind == K_IDENT {
        put(con, "ident ");
        put_text(con, src, t.start, t.end);
      } else if t.kind == K_EOF {
        put(con, "eof");
      } else {
        put_text(con, src, t.start, t.end);
      }
    }
    put(con, "\n");
    k = k + 1;
  }
  vec_free(toks);
  bfree(src);
  return code;
}
