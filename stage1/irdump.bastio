// Prints the IR (stage1/ir.bastio) of every function of a program that is in
// the first subset; a function outside it gets a comment line with the first
// thing that stopped the lowering. Type and linearity checking run first, as
// for asmdump; nothing is verified or generated.
//   usage: irdump [--lib DIR] [--opt | --where | --user | --kernel] FILE
// With --opt, the passes of iropt.bastio have run first; --user and --kernel
// check for that target (hosted otherwise).
import "loader.bastio";
import "out.bastio";
import "ir.bastio";
import "iropt.bastio";

fn main(con: &mut Serial, host: &mut Host) -> u64 {
  let mut ld = loader_new();
  let mut base = 1;
  let mut opt = false;
  let mut where = false;
  let mut target = TARGET_HOSTED;
  let mut more = true;
  while more && base < 990 && base + 2 < host_argc(host)
    invariant base <= 1000
  {
    let a = host_arg(host, base);
    more = spells(a, 0, blen(a), "--lib");
    if more {
      loader_lib(&mut ld, host_arg(host, base + 1));
      base = base + 2;
    }
    bfree(a);
  }
  // Flags up to the last argument, which is the file.
  let last = wrap_sub(host_argc(host), 1);
  while base < last && base < 999
    invariant base <= 1000
  {
    let flag = host_arg(host, base);
    if spells(flag, 0, blen(flag), "--opt") {
      opt = true;
    }
    if spells(flag, 0, blen(flag), "--where") {
      where = true;
    }
    if spells(flag, 0, blen(flag), "--user") {
      target = TARGET_USER;
    }
    if spells(flag, 0, blen(flag), "--kernel") {
      target = TARGET_KERNEL;
    }
    bfree(flag);
    base = base + 1;
  }
  let file_arg = last;
  let path = host_arg(host, file_arg);
  let mut p = parser_new(balloc(0), vec_new[Tok](), 0);
  let r = load(host, &mut p, &mut ld, path, 0, 0, 0, false);
  bfree(path);
  loader_free(ld);
  let mut code = 0;
  if r != 0 {
    put(con, "error\n");
    code = 1;
  } else {
    let mut m = mono_new();
    monomorphize(&mut m, p);
    if m.failed {
      put(con, "error\n");
      code = 1;
    } else {
      let mut c = checker_new(&mut m, p, target);
      check_program(&mut c, &mut m, p);
      if c.failed {
        put(con, "error\n");
        code = 1;
      } else {
        let mut k = 0;
        while k < vec_len(m.fns) {
          let x = u_at(m.fns, k);
          let mut f = ir_lower(c, &mut m, p, x);
          let mut text = vec_new[u64]();
          if f.failed {
            w_s(&mut text, "# ");
            ir_w_name(&mut text, m, p, x);
            w_s(&mut text, ": not in the first subset: ");
            w_append(&mut text, f.why);
            if where {
              w_s(&mut text, " @");
              w_num(&mut text, f.at);
            }
            w_s(&mut text, "\n");
          } else {
            if opt {
              iropt_slots(&mut f);
              iropt_copies(&mut f);
              iropt_dce(&mut f);
              iropt_thread(&mut f);
            }
            ir_print(&mut text, f, m, p);
          }
          let mut j = 0;
          while j < vec_len(text) {
            let ch = u_at(text, j);
            if ch <= 255 {
              serial_write(con, cast[u8](ch));
            }
            j = j + 1;
          }
          vec_free(text);
          ir_free(f);
          k = k + 1;
        }
      }
      checker_free(c);
    }
    mono_free(m);
  }
  bfree(parser_free(p));
  return code;
}
