// Register allocation over the IR (stage1/ir.bastio, docs/ir.md): which
// virtual registers share a machine register, which live in the frame.
//
// Liveness is computed on basic blocks (a block starts at a label or after
// a jump, branch or return) by the usual backward dataflow; the virtual
// registers are not in SSA form, so a register that is assigned in a loop is
// simply live all around it. Each register gets one interval, from its
// first position to its last (extended to whole blocks where it is live
// into or out of them), and a linear scan hands out machine registers in
// order of interval start.
//
// Two pools are modelled: callee-saved registers, which survive a call, and
// caller-saved ones, which do not. An interval that is live across a call
// (`call`, or one of the runtime operations that call the runtime: `alloc`,
// `free`, `print`, `vgrow`) can only take a callee-saved register; any other
// takes a caller-saved register first. When the pools are empty the new
// interval goes to the frame. The emitter keeps a few registers for itself
// (the accumulator, the division and shift registers), so the pools given
// here are the rest.
//
// The allocation is target independent; `ra_print` writes it with the names
// of the x86-64 registers the first emitter will use.
import "ir.bastio";

// Where a virtual register lives.
const RA_NONE: u64 = 0;      // never written or read
const RA_CALLEE: u64 = 1;    // callee-saved register number `idx`
const RA_CALLER: u64 = 2;    // caller-saved register number `idx`
const RA_SPILL: u64 = 3;     // frame spill slot `idx`

struct IrAlloc {
  cls: Vec[u64],
  idx: Vec[u64],
  /// With `ra_alloc_const`: 1 for a register that is a constant (written
  /// once, by an `IR_CONST`), which takes no machine register; its value.
  cst: Vec[u64],
  cv: Vec[u64],
  /// Spill slots used.
  nspill: u64,
  /// Callee-saved registers used (the first `ncallee_used` of the pool).
  ncallee_used: u64
}

fn ra_free(a: IrAlloc) {
  vec_free(a.cls);
  vec_free(a.idx);
  vec_free(a.cst);
  vec_free(a.cv);
}

fn ra_set(v: &mut Vec[u64], i: u64, x: u64) {
  if i < vec_len(v) {
    vec_set(&mut v, i, x);
  }
}

// ---- What an instruction reads and writes ----

fn ra_is_binary(op: u64) -> bool {
  return (op >= IR_ADD && op <= IR_SAR) || (op >= IR_EQ && op <= IR_SGE);
}

/// The registers instruction `q` reads, appended to `out`.
fn ra_reads(f: &IrFn, q: IrIns, out: &mut Vec[u64]) {
  let op = q.op;
  if ra_is_binary(op) {
    vec_push(&mut out, q.a);
    vec_push(&mut out, q.b);
    if (op == IR_DIV || op == IR_REM) && q.c >= 2 {
      // The multiplier of a division by a constant, made in front of the loop (`ix_divhoist`).
      vec_push(&mut out, wrap_sub(q.c, 2));
    }
  } else if op == IR_MOV || op == IR_NOT || op == IR_NEG || op == IR_WRAP || op == IR_ALLOC || op == IR_FREE || op == IR_PRINT || op == IR_PUTC || op == IR_VGROW || op == IR_RT || op == IR_ZERO || op == IR_PIN || op == IR_DEVR || op == IR_LOCKINC || op == IR_LOCKDEC || op == IR_LOCKACQ {
    vec_push(&mut out, q.a);
  } else if op == IR_CAS || op == IR_COPY || op == IR_FILL {
    vec_push(&mut out, q.a);
    vec_push(&mut out, q.b);
    vec_push(&mut out, q.c);
  } else if op == IR_CP16 {
    vec_push(&mut out, q.a);
    vec_push(&mut out, q.b);
    vec_push(&mut out, q.c);
    vec_push(&mut out, q.d);
  } else if op == IR_DEVW || op == IR_POUT || op == IR_MMCHK || op == IR_COPYPAGE || op == IR_PCALL || op == IR_XCHG {
    vec_push(&mut out, q.a);
    vec_push(&mut out, q.b);
  } else if op == IR_BR {
    vec_push(&mut out, q.a);
  } else if op == IR_RET && q.c > 0 && q.a == IR_NONE {
    let mut j = 0;
    while j < q.c && j < 4096 {
      vec_push(&mut out, u_at(f.args, wrap_add(q.b, j)));
      j = j + 1;
    }
  } else if op == IR_RET {
    if q.a != IR_NONE {
      vec_push(&mut out, q.a);
    }
    if q.b != IR_NONE {
      vec_push(&mut out, q.b);
    }
  } else if op == IR_LOAD {
    vec_push(&mut out, q.a);
    vec_push(&mut out, q.b);
  } else if op == IR_STORE {
    vec_push(&mut out, q.d);
    vec_push(&mut out, q.a);
    vec_push(&mut out, q.b);
  } else if op == IR_CALL || op == IR_CALLM {
    let mut j = 0;
    while j < q.c && j < 4096 {
      vec_push(&mut out, u_at(f.args, wrap_add(q.b, j)));
      j = j + 1;
    }
  }
}

/// The registers instruction `q` writes, appended to `out`.
fn ra_writes(q: IrIns, out: &mut Vec[u64]) {
  let op = q.op;
  if ra_is_binary(op) || op == IR_CONST || op == IR_MOV || op == IR_NOT || op == IR_NEG || op == IR_WRAP
    || op == IR_LOAD || op == IR_ALLOC || op == IR_SLOT || op == IR_CALLM || op == IR_STRLIT || op == IR_GETC || op == IR_RT || op == IR_GLOBAL || op == IR_PIN || op == IR_DEVR || op == IR_TSC || op == IR_PCALL || op == IR_LOCKDEC || op == IR_XCHG || op == IR_CAS {
    vec_push(&mut out, q.d);
  } else if op == IR_CALL {
    if q.d != IR_NONE {
      vec_push(&mut out, q.d);
    }
    if q.ty != IR_NONE && q.ty != 0 && q.d != IR_NONE {
      vec_push(&mut out, q.ty);
    }
  }
}

/// A parameter is defined before the first instruction, so a call at
/// position 0 is crossed by a parameter that is used after it.
fn ra_is_param(f: &IrFn, r: u64) -> bool {
  let mut p = 0;
  let mut found = false;
  while p < vec_len(f.params) {
    if vec_get(f.params, p) == r {
      found = true;
    }
    p = p + 1;
  }
  return found;
}

/// Does instruction `q` call the runtime or another function (so that
/// caller-saved registers do not survive it)?
fn ra_calls(q: IrIns) -> bool {
  let op = q.op;
  // `cpu_get` and `cpu_set` (PCALL 3 and 6) are a few instructions on %rax, %rdi and %rsi.
  if op == IR_PCALL && (q.c == 3 || q.c == 6) {
    return false;
  }
  return op == IR_CALL || op == IR_CALLM || op == IR_ALLOC || op == IR_FREE || op == IR_PRINT || op == IR_PUTC || op == IR_GETC || op == IR_VGROW || op == IR_PCALL;
}

// ---- Blocks ----

/// A basic block: instructions `s .. e`, and the blocks that can follow it
/// (block number + 1; 0: none).
struct IrBlock { s: u64, e: u64, n1: u64, n2: u64 }

fn ra_is_end(op: u64) -> bool {
  return op == IR_JMP || op == IR_BR || op == IR_RET || op == IR_UNREACH;
}

/// The block that starts at label `l` (number + 1), from `lb`.
fn ra_label_block(lb: &Vec[u64], l: u64) -> u64 {
  return u_at(lb, l);
}

fn ra_blocks(f: &IrFn) -> Vec[IrBlock] {
  let n = vec_len(f.ins);
  let mut bl = vec_new[IrBlock]();
  let mut lb = vec_new[u64]();
  let mut k = 0;
  while k < f.nlabel && k < 100000000 {
    vec_push(&mut lb, 0);
    k = k + 1;
  }
  // Leaders: the first instruction, labels, and what follows an end.
  let mut s = 0;
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_LABEL && i > s {
      vec_push(&mut bl, IrBlock { s: s, e: i, n1: 0, n2: 0 });
      s = i;
    }
    if q.op == IR_LABEL {
      ra_set(&mut lb, q.a, vec_len(bl) + 1);
    }
    if ra_is_end(q.op) {
      vec_push(&mut bl, IrBlock { s: s, e: i + 1, n1: 0, n2: 0 });
      s = i + 1;
    }
    i = i + 1;
  }
  if s < n {
    vec_push(&mut bl, IrBlock { s: s, e: n, n1: 0, n2: 0 });
  }
  // A label opens a block, so the label table above pointed at the block
  // about to be pushed; fix up the successors now that all exist.
  let mut b = 0;
  while b < vec_len(bl) {
    let blk = vec_get(bl, b);
    let mut n1 = 0;
    let mut n2 = 0;
    if blk.e > blk.s && blk.e <= n {
      let last = vec_get(f.ins, blk.e - 1);
      if last.op == IR_JMP {
        n1 = ra_label_block(lb, last.a);
      } else if last.op == IR_BR {
        n1 = ra_label_block(lb, last.b);
        n2 = ra_label_block(lb, last.c);
      } else if last.op != IR_RET && last.op != IR_UNREACH {
        if b + 1 < vec_len(bl) {
          n1 = b + 2;
        }
      }
    }
    vec_set(&mut bl, b, IrBlock { s: blk.s, e: blk.e, n1: n1, n2: n2 });
    b = b + 1;
  }
  vec_free(lb);
  return bl;
}

// ---- Liveness ----

/// Live-in and live-out sets of every block, as bit sets: register `r` of
/// block `b` is bit `r % 64` of word `b * nw + r / 64`. `bit` holds the 64
/// single-bit masks.
struct IrLive { inn: Vec[u64], out: Vec[u64], nw: u64, bit: Vec[u64] }

fn ra_has(lv: &IrLive, set: &Vec[u64], b: u64, r: u64) -> bool {
  return (u_at(set, wrap_add(wrap_mul(b, lv.nw), r / 64)) & u_at(lv.bit, r % 64)) != 0;
}

fn ra_in(lv: &IrLive, b: u64, r: u64) -> bool {
  return ra_has(lv, lv.inn, b, r);
}

fn ra_out(lv: &IrLive, b: u64, r: u64) -> bool {
  return ra_has(lv, lv.out, b, r);
}

fn ra_live(f: &IrFn, bl: &Vec[IrBlock]) -> IrLive {
  let nb = vec_len(bl);
  let nr = f.nreg;
  let nw = wrap_add(nr / 64, 1);
  let total = wrap_mul(nb, nw);
  let mut bit = vec_new[u64]();
  let mut m = 1;
  let mut k = 0;
  while k < 64 {
    vec_push(&mut bit, m);
    m = wrap_add(m, m);
    k = k + 1;
  }
  let mut use_ = vec_new[u64]();
  let mut def_ = vec_new[u64]();
  let mut inn = vec_new[u64]();
  let mut out = vec_new[u64]();
  let mut z = 0;
  while z < total && z < 1000000000 {
    vec_push(&mut use_, 0);
    vec_push(&mut def_, 0);
    vec_push(&mut inn, 0);
    vec_push(&mut out, 0);
    z = z + 1;
  }
  // use: read before written in the block; def: written in the block.
  let mut b = 0;
  while b < nb {
    let blk = vec_get(bl, b);
    let mut i = blk.s;
    while i < blk.e && i < vec_len(f.ins) {
      let q = vec_get(f.ins, i);
      let mut rs = vec_new[u64]();
      ra_reads(f, q, &mut rs);
      let mut j = 0;
      while j < vec_len(rs) {
        let r = vec_get(rs, j);
        if r < nr {
          let at = wrap_add(wrap_mul(b, nw), r / 64);
          let mask = u_at(bit, r % 64);
          if (u_at(def_, at) & mask) == 0 {
            ra_set(&mut use_, at, u_at(use_, at) | mask);
          }
        }
        j = j + 1;
      }
      vec_free(rs);
      let mut ws = vec_new[u64]();
      ra_writes(q, &mut ws);
      j = 0;
      while j < vec_len(ws) {
        let r = vec_get(ws, j);
        if r < nr {
          let at = wrap_add(wrap_mul(b, nw), r / 64);
          ra_set(&mut def_, at, u_at(def_, at) | u_at(bit, r % 64));
        }
        j = j + 1;
      }
      vec_free(ws);
      i = i + 1;
    }
    b = b + 1;
  }
  // Backward to a fixed point: out = union of the successors' in;
  // in = use + (out - def).
  let mut changed = true;
  let mut rounds = 0;
  while changed && rounds < 100000 {
    changed = false;
    let mut bb = nb;
    while bb > 0
      invariant bb <= vlen(bl) && nb == vlen(bl)
    {
      bb = bb - 1;
      let blk = vec_get(bl, bb);
      let mut w = 0;
      while w < nw {
        let at = wrap_add(wrap_mul(bb, nw), w);
        let mut o = 0;
        if blk.n1 != 0 {
          o = o | u_at(inn, wrap_add(wrap_mul(blk.n1 - 1, nw), w));
        }
        if blk.n2 != 0 {
          o = o | u_at(inn, wrap_add(wrap_mul(blk.n2 - 1, nw), w));
        }
        let iv = u_at(use_, at) | (o & !u_at(def_, at));
        if o != u_at(out, at) {
          ra_set(&mut out, at, o);
          changed = true;
        }
        if iv != u_at(inn, at) {
          ra_set(&mut inn, at, iv);
          changed = true;
        }
        w = w + 1;
      }
    }
    rounds = rounds + 1;
  }
  vec_free(use_);
  vec_free(def_);
  return IrLive { inn: inn, out: out, nw: nw, bit: bit };
}

// ---- Intervals ----

/// The interval of every register: first and last instruction position
/// (`lo` is IR_NONE for a register that never appears).
struct IrIntervals { lo: Vec[u64], hi: Vec[u64] }

fn ra_touch(iv: &mut IrIntervals, r: u64, pos: u64) {
  let lo = u_at(iv.lo, r);
  if r < vec_len(iv.lo) && (lo == IR_NONE || pos < lo) {
    vec_set(&mut iv.lo, r, pos);
  }
  let hi = u_at(iv.hi, r);
  if r < vec_len(iv.hi) && (hi == IR_NONE || pos > hi) {
    vec_set(&mut iv.hi, r, pos);
  }
}

fn ra_intervals(f: &IrFn, bl: &Vec[IrBlock], lv: &IrLive) -> IrIntervals {
  let nr = f.nreg;
  let mut iv = IrIntervals { lo: vec_new[u64](), hi: vec_new[u64]() };
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut iv.lo, IR_NONE);
    vec_push(&mut iv.hi, IR_NONE);
    r = r + 1;
  }
  let mut p = 0;
  while p < vec_len(f.params) {
    ra_touch(&mut iv, vec_get(f.params, p), 0);
    p = p + 1;
  }
  let mut b = 0;
  while b < vec_len(bl) {
    let blk = vec_get(bl, b);
    let mut i = blk.s;
    while i < blk.e && i < vec_len(f.ins) {
      let q = vec_get(f.ins, i);
      let mut rs = vec_new[u64]();
      ra_reads(f, q, &mut rs);
      ra_writes(q, &mut rs);
      let mut j = 0;
      while j < vec_len(rs) {
        ra_touch(&mut iv, vec_get(rs, j), i);
        j = j + 1;
      }
      vec_free(rs);
      i = i + 1;
    }
    // Live into the block: from its first instruction; live out: to its
    // last.
    let mut rr = 0;
    while rr < nr {
      if ra_in(lv, b, rr) {
        ra_touch(&mut iv, rr, blk.s);
      }
      if ra_out(lv, b, rr) && blk.e > 0 {
        ra_touch(&mut iv, rr, blk.e - 1);
      }
      rr = rr + 1;
    }
    b = b + 1;
  }
  return iv;
}

// ---- Spill costs ----

/// 8 to the power `d` (at most 4).
fn ra_pow16(d: u64) -> u64 {
  if d == 0 { return 1; }
  if d == 1 { return 16; }
  if d == 2 { return 256; }
  if d == 3 { return 4096; }
  return 65536;
}

/// How many loops contain each instruction (at most 4), where a loop is the
/// stretch from a label to a jump or branch back to it.
fn ra_depths(f: &IrFn) -> Vec[u64] {
  let n = vec_len(f.ins);
  let mut lpos = vec_new[u64]();
  let mut k = 0;
  while k < f.nlabel && k < 100000000 {
    vec_push(&mut lpos, IR_NONE);
    k = k + 1;
  }
  let mut depth = vec_new[u64]();
  let mut i = 0;
  while i < n {
    vec_push(&mut depth, 0);
    let q = vec_get(f.ins, i);
    if q.op == IR_LABEL {
      ra_set(&mut lpos, q.a, i);
    }
    i = i + 1;
  }
  let mut j = 0;
  while j < n {
    let q = vec_get(f.ins, j);
    let mut t1 = IR_NONE;
    let mut t2 = IR_NONE;
    if q.op == IR_JMP {
      t1 = q.a;
    } else if q.op == IR_BR {
      t1 = q.b;
      t2 = q.c;
    }
    let mut w = 0;
    while w < 2 {
      let mut t = t1;
      if w == 1 {
        t = t2;
      }
      if t != IR_NONE && t < vec_len(lpos) {
        let at = vec_get(lpos, t);
        if at != IR_NONE && at < j {
          let mut x = at;
          while x <= j && x < n {
            let dd = u_at(depth, x);
            if dd < 4 {
              ra_set(&mut depth, x, dd + 1);
            }
            x = x + 1;
          }
        }
      }
      w = w + 1;
    }
    j = j + 1;
  }
  vec_free(lpos);
  return depth;
}

/// Number of instructions an interval spans.
fn ra_len(iv: &IrIntervals, v: u64) -> u64 {
  let l = wrap_add(wrap_sub(u_at(iv.hi, v), u_at(iv.lo, v)), 1);
  if l > 16 { return 16; }
  return l;
}

/// What it costs to keep each register in the frame: its reads and writes,
/// each counted 8 times more for every loop around it.

fn ra_costs(f: &IrFn, depth: &Vec[u64]) -> Vec[u64] {
  let mut cost = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut cost, 0);
    r = r + 1;
  }
  let mut i = 0;
  while i < vec_len(f.ins) {
    let q = vec_get(f.ins, i);
    let mut rs = vec_new[u64]();
    ra_reads(f, q, &mut rs);
    ra_writes(q, &mut rs);
    let w = ra_pow16(u_at(depth, i));
    let mut j = 0;
    while j < vec_len(rs) {
      let x = vec_get(rs, j);
      ra_set(&mut cost, x, wrap_add(u_at(cost, x), w));
      j = j + 1;
    }
    vec_free(rs);
    i = i + 1;
  }
  return cost;
}

// ---- Linear scan ----

/// Allocates the registers of `f` with `ncallee` callee-saved and `ncaller`
/// caller-saved machine registers.

// ---- Live segments ----

/// The stretches of instructions where each register is live, as sorted
/// lists: register `v` has the segments `head[v]`, `nxt[head[v]]`, ... (a
/// segment is positions `sa ..= sb`; IR_NONE ends a list). Unlike the
/// interval (first to last position) these have holes, where the register
/// is dead and its machine register can serve another.
struct IrSegs { head: Vec[u64], tail: Vec[u64], nxt: Vec[u64], sa: Vec[u64], sb: Vec[u64] }

fn ra_seg_add(sg: &mut IrSegs, v: u64, a: u64, b: u64) {
  if v >= vec_len(sg.head) {
    return;
  }
  let t = u_at(sg.tail, v);
  if t != IR_NONE && wrap_add(u_at(sg.sb, t), 1) >= a {
    if b > u_at(sg.sb, t) {
      ra_set(&mut sg.sb, t, b);
    }
  } else {
    let k = vec_len(sg.sa);
    vec_push(&mut sg.sa, a);
    vec_push(&mut sg.sb, b);
    vec_push(&mut sg.nxt, IR_NONE);
    if t == IR_NONE {
      ra_set(&mut sg.head, v, k);
    } else {
      ra_set(&mut sg.nxt, t, k);
    }
    ra_set(&mut sg.tail, v, k);
  }
}

fn ra_segments(f: &IrFn, bl: &Vec[IrBlock], lv: &IrLive) -> IrSegs {
  let nr = f.nreg;
  let mut sg = IrSegs { head: vec_new[u64](), tail: vec_new[u64](), nxt: vec_new[u64](), sa: vec_new[u64](), sb: vec_new[u64]() };
  let mut bf = vec_new[u64]();
  let mut bs = vec_new[u64]();
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut sg.head, IR_NONE);
    vec_push(&mut sg.tail, IR_NONE);
    vec_push(&mut bf, IR_NONE);
    vec_push(&mut bs, IR_NONE);
    r = r + 1;
  }
  let mut p = 0;
  while p < vec_len(f.params) {
    ra_seg_add(&mut sg, vec_get(f.params, p), 0, 0);
    p = p + 1;
  }
  let mut b = 0;
  while b < vec_len(bl) {
    let blk = vec_get(bl, b);
    let mut touched = vec_new[u64]();
    let mut i = blk.s;
    while i < blk.e && i < vec_len(f.ins) {
      let q = vec_get(f.ins, i);
      let mut rs = vec_new[u64]();
      ra_reads(f, q, &mut rs);
      ra_writes(q, &mut rs);
      let mut j = 0;
      while j < vec_len(rs) {
        let x = vec_get(rs, j);
        if x < nr {
          if u_at(bf, x) == IR_NONE {
            ra_set(&mut bf, x, i);
            vec_push(&mut touched, x);
          }
          ra_set(&mut bs, x, i);
        }
        j = j + 1;
      }
      vec_free(rs);
      i = i + 1;
    }
    let mut rr = 0;
    while rr < nr {
      let li = ra_in(lv, b, rr);
      let lo = ra_out(lv, b, rr) && blk.e > 0;
      if li || lo {
        if u_at(bf, rr) == IR_NONE {
          ra_set(&mut bf, rr, blk.s);
          ra_set(&mut bs, rr, blk.s);
          vec_push(&mut touched, rr);
        }
        if li {
          ra_set(&mut bf, rr, blk.s);
        }
        if lo {
          ra_set(&mut bs, rr, blk.e - 1);
        }
      }
      rr = rr + 1;
    }
    let mut k = 0;
    while k < vec_len(touched) {
      let x = vec_get(touched, k);
      ra_seg_add(&mut sg, x, u_at(bf, x), u_at(bs, x));
      ra_set(&mut bf, x, IR_NONE);
      ra_set(&mut bs, x, IR_NONE);
      k = k + 1;
    }
    vec_free(touched);
    b = b + 1;
  }
  vec_free(bf);
  vec_free(bs);
  return sg;
}

fn ra_segs_free(sg: IrSegs) {
  vec_free(sg.head);
  vec_free(sg.tail);
  vec_free(sg.nxt);
  vec_free(sg.sa);
  vec_free(sg.sb);
}

/// `ra_overlap`, except that the two may meet at the single position `okp`
/// (a copy between them: the value is read there and written there).
fn ra_overlap_at(sg: &IrSegs, v: u64, w: u64, okp: u64) -> bool {
  if v >= vec_len(sg.head) || w >= vec_len(sg.head) {
    return false;
  }
  let mut i = u_at(sg.head, v);
  let mut j = u_at(sg.head, w);
  let mut hit = false;
  let mut steps = 0;
  while i != IR_NONE && j != IR_NONE && !hit && steps < 1000000 {
    let a1 = u_at(sg.sa, i);
    let b1 = u_at(sg.sb, i);
    let a2 = u_at(sg.sa, j);
    let b2 = u_at(sg.sb, j);
    if a1 <= b2 && a2 <= b1 {
      let mut lo = a1;
      if a2 > lo { lo = a2; }
      let mut hi = b1;
      if b2 < hi { hi = b2; }
      if !(lo == okp && hi == okp) {
        hit = true;
      }
    }
    if b1 < b2 {
      i = u_at(sg.nxt, i);
    } else {
      j = u_at(sg.nxt, j);
    }
    steps = steps + 1;
  }
  return hit;
}

/// Do registers `v` and `w` ever live together? With `touch`, `w` may end
/// where `v` begins (the emitter reads every operand before it writes the
/// result).
fn ra_overlap(sg: &IrSegs, v: u64, w: u64, touch: bool) -> bool {
  if v >= vec_len(sg.head) || w >= vec_len(sg.head) {
    return false;
  }
  let hv = u_at(sg.head, v);
  let mut i = hv;
  let mut j = u_at(sg.head, w);
  let mut hit = false;
  let mut steps = 0;
  while i != IR_NONE && j != IR_NONE && !hit && steps < 1000000 {
    let a1 = u_at(sg.sa, i);
    let b1 = u_at(sg.sb, i);
    let a2 = u_at(sg.sa, j);
    let b2 = u_at(sg.sb, j);
    if a1 <= b2 && a2 <= b1 {
      if !(touch && i == hv && b2 == a1) {
        hit = true;
      }
    }
    if b1 < b2 {
      i = u_at(sg.nxt, i);
    } else {
      j = u_at(sg.nxt, j);
    }
    steps = steps + 1;
  }
  return hit;
}

// ---- Copies that may share a machine register ----

/// Where each register is written: `nd[r]` writes in all (a parameter
/// counts as one), `dpos[r]` the instruction of the last one, and for the
/// instructions that write `r`, `wh[r]` the first of a chain through `wn`
/// of positions in `wp`.
struct IrDefs { nd: Vec[u64], dpos: Vec[u64], wh: Vec[u64], wn: Vec[u64], wp: Vec[u64] }

fn ra_defs(f: &IrFn) -> IrDefs {
  let nr = f.nreg;
  let mut ds = IrDefs { nd: vec_new[u64](), dpos: vec_new[u64](), wh: vec_new[u64](), wn: vec_new[u64](), wp: vec_new[u64]() };
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut ds.nd, 0);
    vec_push(&mut ds.dpos, IR_NONE);
    vec_push(&mut ds.wh, IR_NONE);
    r = r + 1;
  }
  let mut j = 0;
  while j < vec_len(f.params) {
    let pr = vec_get(f.params, j);
    ra_set(&mut ds.nd, pr, wrap_add(u_at(ds.nd, pr), 1));
    j = j + 1;
  }
  let n = vec_len(f.ins);
  let mut i = 0;
  while i < n {
    let mut ws = vec_new[u64]();
    ra_writes(vec_get(f.ins, i), &mut ws);
    let mut w = 0;
    while w < vec_len(ws) {
      let wr = vec_get(ws, w);
      if wr < nr {
        ra_set(&mut ds.nd, wr, wrap_add(u_at(ds.nd, wr), 1));
        ra_set(&mut ds.dpos, wr, i);
        let k = vec_len(ds.wp);
        vec_push(&mut ds.wp, i);
        vec_push(&mut ds.wn, u_at(ds.wh, wr));
        ra_set(&mut ds.wh, wr, k);
      }
      w = w + 1;
    }
    vec_free(ws);
    i = i + 1;
  }
  return ds;
}

fn ra_defs_free(ds: IrDefs) {
  vec_free(ds.nd);
  vec_free(ds.dpos);
  vec_free(ds.wh);
  vec_free(ds.wn);
  vec_free(ds.wp);
}

/// Is `v` a copy of `u` that can stay in `u`'s machine register? `v` is
/// written once, by `v = mov u`, and `u` is not written anywhere `v` is live,
/// so the two hold one value for as long as `v` lives.
fn ra_copy_ok(f: &IrFn, ds: &IrDefs, sg: &IrSegs, v: u64, u: u64) -> bool {
  if v >= f.nreg || u >= f.nreg || v == u || u_at(ds.nd, v) != 1 {
    return false;
  }
  let p0 = u_at(ds.dpos, v);
  if p0 >= vec_len(f.ins) {
    return false;
  }
  let q = vec_get(f.ins, p0);
  if q.op != IR_MOV || q.d != v || q.a != u {
    return false;
  }
  let mut k = u_at(ds.wh, u);
  let mut steps = 0;
  while k != IR_NONE && steps < 1000000 {
    let p = u_at(ds.wp, k);
    let mut sgi = u_at(sg.head, v);
    let mut ns = 0;
    while sgi != IR_NONE && ns < 1000000 {
      if u_at(sg.sa, sgi) <= p && p <= u_at(sg.sb, sgi) {
        return false;
      }
      sgi = u_at(sg.nxt, sgi);
      ns = ns + 1;
    }
    k = u_at(ds.wn, k);
    steps = steps + 1;
  }
  return true;
}

// ---- Which registers live across a call ----

/// For every register, 1 when it is live just after some call instruction
/// and is not written by it, 0 otherwise. Unlike the interval, this ignores
/// a call in a stretch of the interval where the register is dead.
fn ra_cross(f: &IrFn, bl: &Vec[IrBlock], lv: &IrLive) -> Vec[u64] {
  let nr = f.nreg;
  let nw = lv.nw;
  let mut mark = vec_new[u64]();
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut mark, 0);
    r = r + 1;
  }
  let mut b = 0;
  while b < vec_len(bl) {
    let blk = vec_get(bl, b);
    let mut cur = vec_new[u64]();
    let mut w = 0;
    while w < nw && w < 1000000000 {
      vec_push(&mut cur, u_at(lv.out, wrap_add(wrap_mul(b, nw), w)));
      w = w + 1;
    }
    let mut p = blk.e;
    while p > blk.s && p <= vec_len(f.ins) {
      p = p - 1;
      let q = vec_get(f.ins, p);
      let mut ws = vec_new[u64]();
      ra_writes(q, &mut ws);
      let mut k = 0;
      while k < vec_len(ws) {
        let x = vec_get(ws, k);
        if x < nr {
          ra_set(&mut cur, x / 64, u_at(cur, x / 64) & wrap_sub(18446744073709551615, u_at(lv.bit, x % 64)));
        }
        k = k + 1;
      }
      vec_free(ws);
      if ra_calls(q) {
        let mut wi = 0;
        while wi < nw && wi < vec_len(cur) {
          let word = vec_get(cur, wi);
          if word != 0 {
            let mut bi = 0;
            while bi < 64 {
              if (word & u_at(lv.bit, bi)) != 0 {
                ra_set(&mut mark, wrap_add(wrap_mul(wi, 64), bi), 1);
              }
              bi = bi + 1;
            }
          }
          wi = wi + 1;
        }
      }
      let mut rs = vec_new[u64]();
      ra_reads(f, q, &mut rs);
      k = 0;
      while k < vec_len(rs) {
        let x = vec_get(rs, k);
        if x < nr {
          ra_set(&mut cur, x / 64, u_at(cur, x / 64) | u_at(lv.bit, x % 64));
        }
        k = k + 1;
      }
      vec_free(rs);
    }
    vec_free(cur);
    b = b + 1;
  }
  return mark;
}

/// Which of %rdx (bit 0) and %rcx (bit 1) does instruction `q` use as scratch,
/// in some form the x86 emitter has for it? Only the plain moves, loads,
/// stores, jumps and the additive and logical operations and comparisons use
/// neither; a shift by a variable count uses %rcx alone; the others
/// (division, calls, the runtime's operations) use both.
fn ra_dc_clob(q: IrIns, small: &Vec[u64]) -> u64 {
  let op = q.op;
  if op == IR_SHL || op == IR_SHR || op == IR_SAR {
    // A count that is a constant below 64 is an immediate.
    if q.b < vec_len(small) && u_at(small, q.b) == 1 {
      return 0;
    }
    return 2;
  }
  if op == IR_LABEL || op == IR_JMP || op == IR_BR || op == IR_CONST || op == IR_MOV || op == IR_LOAD || op == IR_STORE
    || op == IR_ADD || op == IR_SUB || op == IR_MUL || op == IR_AND || op == IR_OR || op == IR_XOR || (op >= IR_EQ && op <= IR_SGE)
    || op == IR_NOT || op == IR_NEG || op == IR_WRAP || op == IR_GLOBAL || op == IR_STRLIT || op == IR_SLOT {
    return 0;
  }
  return 3;
}

/// For each register, 1 when it is written once, by a constant below 64.
fn ra_small_consts(f: &IrFn) -> Vec[u64] {
  let nr = f.nreg;
  let mut nd = vec_new[u64]();
  let mut sm = vec_new[u64]();
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut nd, 0);
    vec_push(&mut sm, 0);
    r = r + 1;
  }
  let mut j = 0;
  while j < vec_len(f.params) {
    let pr = vec_get(f.params, j);
    if pr < nr {
      ra_set(&mut nd, pr, 2);
    }
    j = j + 1;
  }
  let mut i = 0;
  while i < vec_len(f.ins) {
    let q = vec_get(f.ins, i);
    let mut ws = vec_new[u64]();
    ra_writes(q, &mut ws);
    j = 0;
    while j < vec_len(ws) {
      let w = vec_get(ws, j);
      if w < nr {
        ra_set(&mut nd, w, wrap_add(u_at(nd, w), 1));
        if q.op == IR_CONST && q.a < 64 {
          ra_set(&mut sm, w, 1);
        }
      }
      j = j + 1;
    }
    vec_free(ws);
    i = i + 1;
  }
  r = 0;
  while r < nr && r < 1000000000 {
    if u_at(nd, r) != 1 {
      ra_set(&mut sm, r, 0);
    }
    r = r + 1;
  }
  vec_free(nd);
  return sm;
}

/// For every register, the union of `ra_dc_clob` over the instructions it is
/// live just after, read by or written by: it may not be kept in %rdx (bit 0)
/// or %rcx (bit 1) if the bit is set.
fn ra_dcmark(f: &IrFn, bl: &Vec[IrBlock], lv: &IrLive) -> Vec[u64] {
  let small = ra_small_consts(f);
  let nr = f.nreg;
  let nw = lv.nw;
  let mut mark = vec_new[u64]();
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut mark, 0);
    r = r + 1;
  }
  let mut b = 0;
  while b < vec_len(bl) {
    let blk = vec_get(bl, b);
    let mut cur = vec_new[u64]();
    let mut w = 0;
    while w < nw && w < 1000000000 {
      vec_push(&mut cur, u_at(lv.out, wrap_add(wrap_mul(b, nw), w)));
      w = w + 1;
    }
    let mut p = blk.e;
    while p > blk.s && p <= vec_len(f.ins) {
      p = p - 1;
      let q = vec_get(f.ins, p);
      let mut ws = vec_new[u64]();
      ra_writes(q, &mut ws);
      let mut k = 0;
      while k < vec_len(ws) {
        let x = vec_get(ws, k);
        if x < nr {
          ra_set(&mut cur, x / 64, u_at(cur, x / 64) & wrap_sub(18446744073709551615, u_at(lv.bit, x % 64)));
        }
        k = k + 1;
      }
      vec_free(ws);
      let clob = ra_dc_clob(q, small);
      if clob != 0 {
        let mut wi = 0;
        while wi < nw && wi < vec_len(cur) {
          let word = vec_get(cur, wi);
          if word != 0 {
            let mut bi = 0;
            while bi < 64 {
              if (word & u_at(lv.bit, bi)) != 0 {
                ra_set(&mut mark, wrap_add(wrap_mul(wi, 64), bi), u_at(mark, wrap_add(wrap_mul(wi, 64), bi)) | clob);
              }
              bi = bi + 1;
            }
          }
          wi = wi + 1;
        }
      }
      let mut rs = vec_new[u64]();
      ra_reads(f, q, &mut rs);
      if clob != 0 {
        k = 0;
        while k < vec_len(rs) {
          if vec_get(rs, k) < nr {
            ra_set(&mut mark, vec_get(rs, k), u_at(mark, vec_get(rs, k)) | clob);
          }
          k = k + 1;
        }
        let mut ws2 = vec_new[u64]();
        ra_writes(q, &mut ws2);
        k = 0;
        while k < vec_len(ws2) {
          if vec_get(ws2, k) < nr {
            ra_set(&mut mark, vec_get(ws2, k), u_at(mark, vec_get(ws2, k)) | clob);
          }
          k = k + 1;
        }
        vec_free(ws2);
      }
      k = 0;
      while k < vec_len(rs) {
        let x = vec_get(rs, k);
        if x < nr {
          ra_set(&mut cur, x / 64, u_at(cur, x / 64) | u_at(lv.bit, x % 64));
        }
        k = k + 1;
      }
      vec_free(rs);
    }
    vec_free(cur);
    b = b + 1;
  }
  vec_free(small);
  return mark;
}

/// May value `v` not live in caller-saved register `m`, one of the last `nres`
/// of `nm`? The first of them is %rdx and the second %rcx (bits 0 and 1 of
/// `dcm`), and a parameter is never given either.
fn ra_restricted(dcm: &Vec[u64], v: u64, m: u64, nm: u64, nres: u64, f: &IrFn) -> bool {
  if ra_is_param(f, v) {
    return true;
  }
  let bit = wrap_sub(m, wrap_sub(nm, nres));
  let mut mask = 1;
  if bit != 0 {
    mask = 2;
  }
  return (u_at(dcm, v) & mask) != 0;
}

fn ra_alloc(f: &IrFn, ncallee: u64, ncaller: u64) -> IrAlloc {
  return ra_alloc_with(f, ncallee, ncaller, false, 0, 0);
}

/// `ra_alloc`, except that a register written once, by a constant, is left
/// out and recorded in `cst` and `cv` for the emitter to use as an
/// immediate.
fn ra_alloc_const(f: &IrFn, ncallee: u64, ncaller: u64) -> IrAlloc {
  return ra_alloc_with(f, ncallee, ncaller, true, 0, 0);
}

/// `ra_alloc_const`, except that a constant too wide for one instruction
/// (`bigk`: 16 bits on AArch64) that a loop reads stays in a register, so the
/// loop does not build it again on every pass.
fn ra_alloc_const_loops(f: &IrFn, ncallee: u64, ncaller: u64) -> IrAlloc {
  return ra_alloc_with(f, ncallee, ncaller, true, 65536, 0);
}

/// `ra_alloc_const`, except that a constant that needs a 64-bit move on x86
/// and that a loop reads stays in a register (a power of two stays an
/// immediate: the emitter makes a shift or a mask of it).
fn ra_alloc_const_wide(f: &IrFn, ncallee: u64, ncaller: u64) -> IrAlloc {
  return ra_alloc_with(f, ncallee, ncaller, true, 2147483648, 0);
}

/// `ra_alloc_const_wide`, with the last `nres` of the `ncaller` caller-saved
/// registers kept for the registers that `ra_dcmark` leaves free (a parameter
/// is never given one: the prologue reads the argument registers in turn).
fn ra_alloc_const_wide_res(f: &IrFn, ncallee: u64, ncaller: u64, nres: u64) -> IrAlloc {
  return ra_alloc_with(f, ncallee, ncaller, true, 2147483648, nres);
}

/// Copies between registers: `cph[r]` heads a chain through `cpn` of the
/// copies that read or write `r`, each with the other register in `cpr` and
/// its instruction in `cpp`.
struct IrCopies { cph: Vec[u64], cpn: Vec[u64], cpr: Vec[u64], cpp: Vec[u64] }

fn ra_copies(f: &IrFn) -> IrCopies {
  let mut cp = IrCopies { cph: vec_new[u64](), cpn: vec_new[u64](), cpr: vec_new[u64](), cpp: vec_new[u64]() };
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut cp.cph, IR_NONE);
    r = r + 1;
  }
  let n = vec_len(f.ins);
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_MOV && q.a != q.d && q.a < f.nreg && q.d < f.nreg {
      vec_push(&mut cp.cpr, q.a);
      vec_push(&mut cp.cpp, i);
      vec_push(&mut cp.cpn, u_at(cp.cph, q.d));
      ra_set(&mut cp.cph, q.d, wrap_sub(vec_len(cp.cpr), 1));
      vec_push(&mut cp.cpr, q.d);
      vec_push(&mut cp.cpp, i);
      vec_push(&mut cp.cpn, u_at(cp.cph, q.a));
      ra_set(&mut cp.cph, q.a, wrap_sub(vec_len(cp.cpr), 1));
    }
    i = i + 1;
  }
  return cp;
}

fn ra_copies_free(cp: IrCopies) {
  vec_free(cp.cph);
  vec_free(cp.cpn);
  vec_free(cp.cpr);
  vec_free(cp.cpp);
}

/// Can `x` use frame slot `s`? It can when no register already there lives
/// with it, except at the position `okp` of a copy between it and `w`.
fn ra_slot_free(sg: &IrSegs, al: &IrAlloc, x: u64, s: u64, w: u64, okp: u64) -> bool {
  let mut ok = true;
  let mut m = 0;
  while m < vec_len(al.cls) && ok {
    if m != x && u_at(al.cls, m) == RA_SPILL && u_at(al.idx, m) == s {
      let mut clash = false;
      if m == w {
        clash = ra_overlap_at(sg, x, m, okp);
      } else {
        clash = ra_overlap(sg, x, m, false);
      }
      if clash {
        ok = false;
      }
    }
    m = m + 1;
  }
  return ok;
}

/// The frame slot for `x`, which stays in the frame: the slot of a register
/// `w` that has one and is copied to or from `x` when the two never live
/// together (apart from the copy), which makes the copy a no-op; else the
/// slot of `u` when `x = mov u` is the last use of `u`, else a new one.
fn ra_spill_slot(f: &IrFn, iv: &IrIntervals, sg: &IrSegs, cp: &IrCopies, al: &mut IrAlloc, x: u64, share: bool) -> u64 {
  if share && x < vec_len(cp.cph) {
    let mut c = u_at(cp.cph, x);
    let mut steps = 0;
    while c != IR_NONE && steps < 64 {
      let w = u_at(cp.cpr, c);
      if w < vec_len(al.cls) && u_at(al.cst, w) == 0 && u_at(al.cls, w) == RA_SPILL {
        let s = u_at(al.idx, w);
        if ra_slot_free(sg, al, x, s, w, u_at(cp.cpp, c)) {
          return s;
        }
      }
      c = u_at(cp.cpn, c);
      steps = steps + 1;
    }
  }
  let lo = u_at(iv.lo, x);
  if share && lo > 0 && lo < vec_len(f.ins) {
    let q = vec_get(f.ins, lo);
    if q.op == IR_MOV && q.d == x && q.a != x && q.a < vec_len(al.cls) && u_at(iv.hi, q.a) <= lo && u_at(al.cst, q.a) == 0 && u_at(al.cls, q.a) == RA_SPILL {
      return u_at(al.idx, q.a);
    }
  }
  let s = al.nspill;
  al.nspill = wrap_add(al.nspill, 1);
  return s;
}

fn ra_alloc_with(f: &IrFn, ncallee: u64, ncaller: u64, consts: bool, bigk: u64, nres: u64) -> IrAlloc {
  let bl = ra_blocks(f);
  let lv = ra_live(f, bl);
  let iv = ra_intervals(f, bl, lv);
  let xmark = ra_cross(f, bl, lv);
  let dcm = ra_dcmark(f, bl, lv);
  let nr = f.nreg;
  let n = vec_len(f.ins);
  // Call positions, to tell which intervals cross a call.
  let mut calls = vec_new[u64]();
  let mut i = 0;
  while i < n {
    if ra_calls(vec_get(f.ins, i)) {
      vec_push(&mut calls, i);
    }
    i = i + 1;
  }
  let mut al = IrAlloc { cls: vec_new[u64](), idx: vec_new[u64](), cst: vec_new[u64](), cv: vec_new[u64](), nspill: 0, ncallee_used: 0 };
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut al.cls, RA_NONE);
    vec_push(&mut al.idx, 0);
    vec_push(&mut al.cst, 0);
    vec_push(&mut al.cv, 0);
    r = r + 1;
  }
  if consts {
    // Registers written once, by a constant (a parameter is a write too).
    let mut ndef = vec_new[u64]();
    r = 0;
    while r < nr && r < 1000000000 {
      vec_push(&mut ndef, 0);
      r = r + 1;
    }
    let mut j = 0;
    while j < vec_len(f.params) {
      let pr = vec_get(f.params, j);
      ra_set(&mut ndef, pr, wrap_add(u_at(ndef, pr), 1));
      j = j + 1;
    }
    j = 0;
    while j < n {
      let mut ws = vec_new[u64]();
      ra_writes(vec_get(f.ins, j), &mut ws);
      let mut w = 0;
      while w < vec_len(ws) {
        let wr = vec_get(ws, w);
        ra_set(&mut ndef, wr, wrap_add(u_at(ndef, wr), 1));
        w = w + 1;
      }
      vec_free(ws);
      j = j + 1;
    }
    j = 0;
    while j < n {
      let q = vec_get(f.ins, j);
      if q.op == IR_CONST && u_at(ndef, q.d) == 1 {
        ra_set(&mut al.cst, q.d, 1);
        ra_set(&mut al.cv, q.d, q.a);
      }
      j = j + 1;
    }
    vec_free(ndef);
    if bigk > 0 {
      let dp = ra_depths(f);
      j = 0;
      while j < n {
        if u_at(dp, j) > 0 {
          let mut rs = vec_new[u64]();
          ra_reads(f, vec_get(f.ins, j), &mut rs);
          let mut w = 0;
          while w < vec_len(rs) {
            let x = vec_get(rs, w);
            if x < nr && u_at(al.cst, x) == 1 && u_at(al.cv, x) >= bigk && u_at(al.cv, x) < wrap_sub(0, bigk) && (u_at(al.cv, x) & wrap_sub(u_at(al.cv, x), 1)) != 0 {
              ra_set(&mut al.cst, x, 0);
            }
            w = w + 1;
          }
          vec_free(rs);
        }
        j = j + 1;
      }
      vec_free(dp);
    }
  }
  let depth = ra_depths(f);
  let cost = ra_costs(f, depth);
  vec_free(depth);
  // Registers by order of interval start.
  let mut order = vec_new[u64]();
  let mut pos = 0;
  while pos <= n && pos < 1000000000 {
    let mut v = 0;
    while v < nr {
      if u_at(iv.lo, v) == pos && u_at(al.cst, v) == 0 {
        vec_push(&mut order, v);
      }
      v = v + 1;
    }
    pos = pos + 1;
  }
  // The registers that hold a machine register now or may again (those whose
  // interval has not ended): `hv[k]` holds machine register `hm[k]`, numbered
  // from 0 for the first callee-saved one, `ncallee` for the first
  // caller-saved (IR_NONE: given up).
  let mut hv = vec_new[u64]();
  let mut hm = vec_new[u64]();
  let sg = ra_segments(f, bl, lv);
  let ds = ra_defs(f);
  let cp = ra_copies(f);
  let nm = wrap_add(ncallee, ncaller);
  // For the emitter (`consts`): a register may take the machine register of
  // one whose last use is the instruction that writes it, as the emitter
  // reads every operand of an instruction before it writes the result.
  let touch = consts;
  let mut o = 0;
  while o < vec_len(order) {
    let v = vec_get(order, o);
    let lo = u_at(iv.lo, v);
    let hi = u_at(iv.hi, v);
    let crosses = u_at(xmark, v) != 0;
    // Forget what has ended.
    let mut keep_v = vec_new[u64]();
    let mut keep_m = vec_new[u64]();
    let mut h = 0;
    while h < vec_len(hv) && h < vec_len(hm) {
      let w = vec_get(hv, h);
      if u_at(hm, h) != IR_NONE && u_at(iv.hi, w) >= lo {
        vec_push(&mut keep_v, w);
        vec_push(&mut keep_m, u_at(hm, h));
      }
      h = wrap_add(h, 1);
    }
    vec_free(hv);
    vec_free(hm);
    hv = keep_v;
    hm = keep_m;
    // The register may take the machine register of one whose last use is
    // the instruction that first writes it, if that instruction does not
    // read it too.
    let mut tv = false;
    if touch && (lo > 0 || !ra_is_param(f, v)) && lo < n {
      let qt = vec_get(f.ins, lo);
      let mut wsv = vec_new[u64]();
      ra_writes(qt, &mut wsv);
      let mut rsv = vec_new[u64]();
      ra_reads(f, qt, &mut rsv);
      let mut iw = false;
      let mut ir = false;
      let mut e = 0;
      while e < vec_len(wsv) {
        if vec_get(wsv, e) == v {
          iw = true;
        }
        e = e + 1;
      }
      e = 0;
      while e < vec_len(rsv) {
        if vec_get(rsv, e) == v {
          ir = true;
        }
        e = e + 1;
      }
      vec_free(wsv);
      vec_free(rsv);
      tv = iw && !ir;
    }
    // Which machine registers v can have, in order of preference: the one
    // of `u` in `v = mov u` where `u` dies, the caller-saved ones, the
    // callee-saved ones (not across a call: caller-saved only).
    let mut placed = false;
    let mut want = IR_NONE;
    if touch && (lo > 0 || !ra_is_param(f, v)) && lo < n {
      let q0 = vec_get(f.ins, lo);
      if q0.op == IR_MOV && q0.d == v && q0.a != v && q0.a < nr && u_at(iv.hi, q0.a) <= lo && u_at(al.cst, q0.a) == 0 {
        let cu = u_at(al.cls, q0.a);
        let iu = u_at(al.idx, q0.a);
        if cu == RA_CALLER && !crosses {
          want = wrap_add(ncallee, iu);
        } else if cu == RA_CALLEE {
          want = iu;
        }
      }
    }
    // The result of a two-operand instruction may take the machine register
    // of its first operand when that dies there: the emitter then has no
    // copy to make before the operation.
    if want == IR_NONE && touch && (lo > 0 || !ra_is_param(f, v)) && lo < n {
      let q2 = vec_get(f.ins, lo);
      if ra_is_binary(q2.op) && q2.d == v && q2.a != v && q2.b != v && q2.a != q2.b && q2.a < nr && u_at(iv.hi, q2.a) <= lo && u_at(al.cst, q2.a) == 0 {
        let cu2 = u_at(al.cls, q2.a);
        let iu2 = u_at(al.idx, q2.a);
        if cu2 == RA_CALLER && !crosses {
          want = wrap_add(ncallee, iu2);
        } else if cu2 == RA_CALLEE {
          want = iu2;
        }
      }
    }
    // A copy of a register that stays live beside it takes its machine
    // register too, when nothing writes that register while the copy lives.
    let mut cpu = IR_NONE;
    if want == IR_NONE && touch && (lo > 0 || !ra_is_param(f, v)) && lo < n {
      let q1 = vec_get(f.ins, lo);
      if q1.op == IR_MOV && q1.d == v && q1.a < nr && u_at(al.cst, q1.a) == 0 && ra_copy_ok(f, ds, sg, v, q1.a) {
        let cu1 = u_at(al.cls, q1.a);
        let iu1 = u_at(al.idx, q1.a);
        if cu1 == RA_CALLER && !crosses {
          want = wrap_add(ncallee, iu1);
          cpu = q1.a;
        } else if cu1 == RA_CALLEE {
          want = iu1;
          cpu = q1.a;
        }
      }
    }
    let mut pass = 0;
    while pass < 3 && !placed {
      let mut m = 0;
      while m < nm && !placed {
        let mut cand = false;
        if pass == 0 {
          cand = want != IR_NONE && m == want;
        } else if pass == 1 {
          cand = m >= ncallee && !crosses;
        } else {
          // A callee-saved register nobody has used yet costs a save and a
          // restore in every call of the function: only worth it for a
          // register that is referenced a few times at least.
          cand = m < ncallee && (!touch || m < al.ncallee_used || u_at(cost, v) >= 6);
        }
        if cand && nres > 0 && m >= wrap_sub(nm, nres) && (u_at(dcm, v) != 0 || ra_is_param(f, v)) {
          cand = false;
        }
        if cand {
          let mut clash = false;
          let mut h2 = 0;
          while h2 < vec_len(hv) && !clash {
            if u_at(hm, h2) == m && vec_get(hv, h2) != cpu && ra_overlap(sg, v, vec_get(hv, h2), tv) {
              clash = true;
            }
            h2 = h2 + 1;
          }
          if !clash {
            vec_push(&mut hv, v);
            vec_push(&mut hm, m);
            if m < ncallee {
              ra_set(&mut al.cls, v, RA_CALLEE);
              ra_set(&mut al.idx, v, m);
              if m + 1 > al.ncallee_used {
                al.ncallee_used = m + 1;
              }
            } else {
              ra_set(&mut al.cls, v, RA_CALLER);
              ra_set(&mut al.idx, v, m - ncallee);
            }
            placed = true;
          }
        }
        m = m + 1;
      }
      pass = pass + 1;
    }
    if !placed {
      // Every register is taken: the cheapest register to keep in the frame
      // gives up its machine register if it costs less than this one. Only
      // a machine register with a single register in v's way can be freed.
      let cv = u_at(cost, v);
      let mut best = IR_NONE;
      let mut best_cost = cv;
      let mut best_len = wrap_add(wrap_sub(hi, lo), 1);
      if best_len > 16 { best_len = 16; }
      let mut best_m = 0;
      let mut m = 0;
      while m < nm {
        if (m < ncallee || !crosses) && !(nres > 0 && m >= wrap_sub(nm, nres) && ra_restricted(dcm, v, m, nm, nres, f)) {
          let mut nclash = 0;
          let mut who = IR_NONE;
          let mut h2 = 0;
          while h2 < vec_len(hv) {
            if u_at(hm, h2) == m && ra_overlap(sg, v, vec_get(hv, h2), tv) {
              nclash = wrap_add(nclash, 1);
              who = vec_get(hv, h2);
            }
            h2 = h2 + 1;
          }
          if nclash == 1 && who != IR_NONE {
            if wrap_mul(u_at(cost, who), best_len) < wrap_mul(best_cost, ra_len(iv, who)) {
              best = who;
              best_cost = u_at(cost, who);
              best_len = ra_len(iv, who);
              best_m = m;
            }
          }
        }
        m = m + 1;
      }
      if best != IR_NONE {
        let slot = ra_spill_slot(f, iv, sg, cp, &mut al, best, touch);
        ra_set(&mut al.cls, best, RA_SPILL);
        ra_set(&mut al.idx, best, slot);
        let mut h2 = 0;
        while h2 < vec_len(hv) {
          if vec_get(hv, h2) == best {
            ra_set(&mut hm, h2, IR_NONE);
          }
          h2 = h2 + 1;
        }
        vec_push(&mut hv, v);
        vec_push(&mut hm, best_m);
        if best_m < ncallee {
          ra_set(&mut al.cls, v, RA_CALLEE);
          ra_set(&mut al.idx, v, best_m);
        } else {
          ra_set(&mut al.cls, v, RA_CALLER);
          ra_set(&mut al.idx, v, best_m - ncallee);
        }
        placed = true;
      }
    }
    if !placed {
      let slot = ra_spill_slot(f, iv, sg, cp, &mut al, v, touch);
      ra_set(&mut al.cls, v, RA_SPILL);
      ra_set(&mut al.idx, v, slot);
    }
    o = o + 1;
  }
  ra_segs_free(sg);
  ra_defs_free(ds);
  ra_copies_free(cp);
  vec_free(hv);
  vec_free(hm);
  vec_free(order);
  vec_free(cost);
  vec_free(calls);
  vec_free(xmark);
  vec_free(dcm);
  vec_free(iv.lo);
  vec_free(iv.hi);
  vec_free(lv.inn);
  vec_free(lv.out);
  vec_free(lv.bit);
  vec_free(bl);
  return al;
}

// ---- A check of the result ----

// ---- Splitting a register in the frame around a loop ----

/// Can the reads of `op` be rewritten by `ra_subst`?
fn ra_substable(op: u64) -> bool {
  return ra_is_binary(op) || op == IR_LOAD || op == IR_STORE || op == IR_BR || op == IR_MOV || op == IR_NOT || op == IR_NEG || op == IR_WRAP || op == IR_CAS || op == IR_COPY || op == IR_FILL || op == IR_CP16 || op == IR_DEVW || op == IR_POUT || op == IR_MMCHK || op == IR_COPYPAGE || op == IR_PCALL || op == IR_XCHG || op == IR_ZERO || op == IR_PIN || op == IR_DEVR || op == IR_LOCKINC || op == IR_LOCKDEC || op == IR_LOCKACQ || op == IR_RT;
}

/// Instruction `q` with every read of `v` replaced by `t`.
fn ra_subst(q: IrIns, v: u64, t: u64) -> IrIns {
  let mut r = q;
  let op = q.op;
  if ra_is_binary(op) || op == IR_LOAD || op == IR_DEVW || op == IR_POUT || op == IR_MMCHK || op == IR_COPYPAGE || op == IR_PCALL || op == IR_XCHG {
    if r.a == v { r.a = t; }
    if r.b == v { r.b = t; }
  } else if op == IR_MOV || op == IR_NOT || op == IR_NEG || op == IR_WRAP || op == IR_BR || op == IR_ZERO || op == IR_PIN || op == IR_DEVR || op == IR_LOCKINC || op == IR_LOCKDEC || op == IR_LOCKACQ || op == IR_RT {
    if r.a == v { r.a = t; }
  } else if op == IR_STORE {
    if r.a == v { r.a = t; }
    if r.b == v { r.b = t; }
    if r.d == v { r.d = t; }
  } else if op == IR_CAS || op == IR_COPY || op == IR_FILL {
    if r.a == v { r.a = t; }
    if r.b == v { r.b = t; }
    if r.c == v { r.c = t; }
  } else if op == IR_CP16 {
    if r.a == v { r.a = t; }
    if r.b == v { r.b = t; }
    if r.c == v { r.c = t; }
    if r.d == v { r.d = t; }
  }
  return r;
}

fn ra_in_list(xs: &Vec[u64], v: u64) -> bool {
  let mut hit = false;
  let mut k = 0;
  while k < vec_len(xs) {
    if vec_get(xs, k) == v {
      hit = true;
    }
    k = k + 1;
  }
  return hit;
}

fn ra_reads_has(f: &IrFn, q: IrIns, v: u64) -> bool {
  let mut rs = vec_new[u64]();
  ra_reads(f, q, &mut rs);
  let hit = ra_in_list(rs, v);
  vec_free(rs);
  return hit;
}

fn ra_writes_has(q: IrIns, v: u64) -> bool {
  let mut ws = vec_new[u64]();
  ra_writes(q, &mut ws);
  let hit = ra_in_list(ws, v);
  vec_free(ws);
  return hit;
}

/// `q` with `t` for `v` in what it reads and what it writes.
fn ra_rename(q: IrIns, v: u64, t: u64) -> IrIns {
  let mut r = ra_subst(q, v, t);
  if q.op != IR_STORE && q.d == v && ra_writes_has(q, v) {
    r.d = t;
  }
  return r;
}

/// The position of each label (IR_NONE: not placed).
fn ra_lpos(f: &IrFn) -> Vec[u64] {
  let mut lp = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut lp, IR_NONE);
    l = l + 1;
  }
  let mut i = 0;
  while i < vec_len(f.ins) && i < 1000000000 {
    let q = vec_get(f.ins, i);
    if q.op == IR_LABEL && q.a < f.nlabel {
      ra_set(&mut lp, q.a, i);
    }
    i = i + 1;
  }
  return lp;
}

/// How many times positions `h ..= e` read or write `v`, or 0 when they
/// cannot be rewritten (a call, or a read in an operand `ra_subst` cannot
/// reach).
fn ra_loop_refs(f: &IrFn, h: u64, e: u64, v: u64) -> u64 {
  let mut refs = 0;
  let mut p = h;
  while p <= e && p < vec_len(f.ins) && p < 1000000000 {
    let q = vec_get(f.ins, p);
    if ra_calls(q) {
      return 0;
    }
    if ra_reads_has(f, q, v) {
      if !ra_substable(q.op) {
        return 0;
      }
      refs = wrap_add(refs, 1);
    }
    if ra_writes_has(q, v) {
      refs = wrap_add(refs, 1);
    }
    p = p + 1;
  }
  return refs;
}

/// A loop `h ..= e` (its first label to its last jump back) that reads or
/// writes `v` often and has no call: its references go to a copy `t`, made
/// where the loop is entered and written back where it is left.
fn ra_split_once(f: &mut IrFn, v: u64, minrefs: u64) -> bool {
  let n = vec_len(f.ins);
  let lp = ra_lpos(f);
  let mut lh = vec_new[u64]();
  let mut le = vec_new[u64]();
  let mut e = 0;
  while e < n && e < vec_len(f.ins) && e < 1000000000 {
    let q = vec_get(f.ins, e);
    let mut k = 0;
    while k < 2 {
      let mut tgt = IR_NONE;
      if q.op == IR_JMP && k == 0 {
        tgt = q.a;
      }
      if q.op == IR_BR {
        if k == 0 {
          tgt = q.b;
        } else {
          tgt = q.c;
        }
      }
      if tgt < f.nlabel && tgt < vec_len(lp) {
        let hp = vec_get(lp, tgt);
        if hp < e {
          let mut found = IR_NONE;
          let mut x = 0;
          while x < vec_len(lh) {
            if vec_get(lh, x) == hp {
              found = x;
            }
            x = x + 1;
          }
          if found == IR_NONE {
            vec_push(&mut lh, hp);
            vec_push(&mut le, e);
          } else if e > u_at(le, found) {
            ra_set(&mut le, found, e);
          }
        }
      }
      k = k + 1;
    }
    e = e + 1;
  }
  // The smallest loop that qualifies.
  let mut best = IR_NONE;
  let mut best_size = 400;
  let mut x = 0;
  while x < vec_len(lh) {
    let h = vec_get(lh, x);
    let e2 = u_at(le, x);
    if e2 >= h {
      let size = wrap_sub(e2, h);
      if size < best_size && ra_loop_refs(f, h, e2, v) >= minrefs {
        best = x;
        best_size = size;
      }
    }
    x = x + 1;
  }
  if best == IR_NONE {
    vec_free(lp);
    vec_free(lh);
    vec_free(le);
    return false;
  }
  let h = u_at(lh, best);
  let e2 = u_at(le, best);
  vec_free(lh);
  vec_free(le);
  let mut wrote = false;
  let mut p = h;
  while p <= e2 && p < vec_len(f.ins) && p < 1000000000 {
    if ra_writes_has(vec_get(f.ins, p), v) {
      wrote = true;
    }
    p = p + 1;
  }
  let t = ir_reg(&mut f);
  let mut out = vec_new[IrIns]();
  let mut i = 0;
  while i < n && i < vec_len(f.ins) && i < 1000000000 {
    let q0 = vec_get(f.ins, i);
    let inside = i >= h && i <= e2;
    if i == h {
      let mut falls = true;
      if i > 0 {
        let pr = vec_get(f.ins, i - 1);
        falls = !ra_is_end(pr.op);
      }
      if falls {
        vec_push(&mut out, IrIns { op: IR_MOV, d: t, a: v, b: 0, c: 0, ty: 0 });
      }
    }
    let mut q = q0;
    if inside {
      q = ra_rename(q0, v, t);
    }
    if q.op == IR_JMP && q.a < vec_len(lp) {
      let tp = vec_get(lp, q.a);
      let tin = tp >= h && tp <= e2;
      if inside && !tin && wrote {
        vec_push(&mut out, IrIns { op: IR_MOV, d: v, a: t, b: 0, c: 0, ty: 0 });
      }
      if !inside && tin {
        vec_push(&mut out, IrIns { op: IR_MOV, d: t, a: v, b: 0, c: 0, ty: 0 });
      }
    }
    // A branch into or out of the loop goes through a block of its own,
    // placed right after it (so no jump of it goes back).
    let mut tl = vec_new[u64]();
    let mut tt = vec_new[u64]();
    let mut tk = vec_new[u64]();
    if q.op == IR_BR {
      let mut k = 0;
      while k < 2 {
        let mut lab = q.b;
        if k == 1 {
          lab = q.c;
        }
        if lab < vec_len(lp) {
          let tp = vec_get(lp, lab);
          let tin = tp >= h && tp <= e2;
          let mut kind = 0;
          if inside && !tin && wrote {
            kind = 2;
          }
          if !inside && tin {
            kind = 1;
          }
          if kind != 0 {
            let nl = ir_label(&mut f);
            vec_push(&mut tl, nl);
            vec_push(&mut tt, lab);
            vec_push(&mut tk, kind);
            if k == 0 {
              q.b = nl;
            } else {
              q.c = nl;
            }
          }
        }
        k = k + 1;
      }
    }
    vec_push(&mut out, q);
    let mut y = 0;
    while y < vec_len(tl) {
      vec_push(&mut out, IrIns { op: IR_LABEL, d: IR_NONE, a: vec_get(tl, y), b: 0, c: 0, ty: 0 });
      if u_at(tk, y) == 1 {
        vec_push(&mut out, IrIns { op: IR_MOV, d: t, a: v, b: 0, c: 0, ty: 0 });
      } else {
        vec_push(&mut out, IrIns { op: IR_MOV, d: v, a: t, b: 0, c: 0, ty: 0 });
      }
      vec_push(&mut out, IrIns { op: IR_JMP, d: IR_NONE, a: u_at(tt, y), b: 0, c: 0, ty: 0 });
      y = y + 1;
    }
    vec_free(tl);
    vec_free(tt);
    vec_free(tk);
    i = i + 1;
  }
  vec_free(lp);
  vec_free(f.ins);
  f.ins = out;
  return true;
}

/// Splits every register `al` keeps in the frame around the loops that use
/// it `minrefs` times or more. Returns how many splits were made.
fn ra_split_loops(f: &mut IrFn, al: &IrAlloc, minrefs: u64) -> u64 {
  let nr = f.nreg;
  let n = vec_len(f.ins);
  // Registers that hold a frame slot's address stay as they are: the
  // emitter follows them through their copies.
  let mut sl = vec_new[u64]();
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut sl, 0);
    r = r + 1;
  }
  let mut again = true;
  while again {
    again = false;
    let mut k = 0;
    while k < n && k < vec_len(f.ins) {
      let q = vec_get(f.ins, k);
      if q.d < nr && u_at(sl, q.d) == 0 {
        if q.op == IR_SLOT || (q.op == IR_MOV && q.a < nr && u_at(sl, q.a) == 1) {
          ra_set(&mut sl, q.d, 1);
          again = true;
        }
      }
      k = k + 1;
    }
  }
  let mut made = 0;
  let mut v = 0;
  while v < nr && v < vec_len(al.cls) && v < 1000000000 {
    if u_at(al.cls, v) == RA_SPILL && u_at(al.cst, v) == 0 && u_at(sl, v) == 0 {
      let mut tries = 0;
      while tries < 8 && ra_split_once(&mut f, v, minrefs) {
        made = wrap_add(made, 1);
        tries = tries + 1;
      }
    }
    v = v + 1;
  }
  vec_free(sl);
  let mut rounds = 0;
  while made > 0 && rounds < 3 && ra_dead_movs(&mut f) > 0 {
    rounds = wrap_add(rounds, 1);
  }
  return made;
}

/// Removes the copies whose result is dead where they stand: no path from
/// the copy reads the register before it is written again. The entry copies
/// `ra_split_loops` makes for every loop a branch enters are the usual ones.
/// Returns how many copies it removed.
fn ra_dead_movs(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  if n > 200000 || f.nreg > 100000000 || f.nlabel > 100000000 {
    return 0;
  }
  let nr = f.nreg;
  let bl = ra_blocks(f);
  let lv = ra_live(f, bl);
  let nb = vec_len(bl);
  let nw = lv.nw;
  let mut dead = vec_new[u64]();
  let mut i = 0;
  while i < n {
    vec_push(&mut dead, 0);
    i = wrap_add(i, 1);
  }
  let mut cur = vec_new[u64]();
  let mut w = 0;
  while w < nw {
    vec_push(&mut cur, 0);
    w = wrap_add(w, 1);
  }
  let mut count = 0;
  let mut b = 0;
  while b < nb {
    let blk = vec_get(bl, b);
    w = 0;
    while w < nw {
      ra_set(&mut cur, w, u_at(lv.out, wrap_add(wrap_mul(b, nw), w)));
      w = wrap_add(w, 1);
    }
    let mut j = blk.e;
    while j > blk.s && j <= vec_len(f.ins) {
      j = wrap_sub(j, 1);
      let q = vec_get(f.ins, j);
      let mut ws = vec_new[u64]();
      ra_writes(q, &mut ws);
      let mut isdead = false;
      if q.op == IR_MOV && q.d < nr && vec_len(ws) == 1 {
        isdead = (u_at(cur, q.d / 64) & u_at(lv.bit, q.d % 64)) == 0;
      }
      if isdead {
        ra_set(&mut dead, j, 1);
        count = wrap_add(count, 1);
      } else {
        let mut x = 0;
        while x < vec_len(ws) {
          let r = vec_get(ws, x);
          if r < nr {
            ra_set(&mut cur, r / 64, u_at(cur, r / 64) & !u_at(lv.bit, r % 64));
          }
          x = wrap_add(x, 1);
        }
        let mut rs = vec_new[u64]();
        ra_reads(f, q, &mut rs);
        x = 0;
        while x < vec_len(rs) {
          let r = vec_get(rs, x);
          if r < nr {
            ra_set(&mut cur, r / 64, u_at(cur, r / 64) | u_at(lv.bit, r % 64));
          }
          x = wrap_add(x, 1);
        }
        vec_free(rs);
      }
      vec_free(ws);
    }
    b = wrap_add(b, 1);
  }
  vec_free(cur);
  vec_free(lv.inn);
  vec_free(lv.out);
  vec_free(lv.bit);
  vec_free(bl);
  if count > 0 {
    let mut out = vec_new[IrIns]();
    i = 0;
    while i < n {
      if u_at(dead, i) == 0 {
        vec_push(&mut out, vec_get(f.ins, i));
      }
      i = wrap_add(i, 1);
    }
    vec_free(f.ins);
    f.ins = out;
  }
  vec_free(dead);
  return count;
}

/// Do two registers that share a machine register ever live together, or
/// does a register that lives across a call sit in a caller-saved one?
/// Recomputed from the instructions, so it is independent of the scan.
fn ra_valid(f: &IrFn, a: &IrAlloc) -> bool {
  let bl = ra_blocks(f);
  let lv = ra_live(f, bl);
  let iv = ra_intervals(f, bl, lv);
  let xmark = ra_cross(f, bl, lv);
  let sg = ra_segments(f, bl, lv);
  let ds = ra_defs(f);
  let nr = f.nreg;
  let n = vec_len(f.ins);
  let mut ok = true;
  let mut x = 0;
  while x < nr && x < 100000 {
    let cx = u_at(a.cls, x);
    if cx == RA_CALLER && u_at(xmark, x) != 0 {
      ok = false;
    }
    if cx == RA_CALLEE || cx == RA_CALLER || cx == RA_SPILL {
      let mut y = x + 1;
      while y < nr && y < 100000 {
        if u_at(a.cls, y) == cx && u_at(a.idx, y) == u_at(a.idx, x) {
          if ra_overlap(sg, x, y, false) && !ra_copy_ok(f, ds, sg, x, y) && !ra_copy_ok(f, ds, sg, y, x) {
            ok = false;
          }
        }
        y = y + 1;
      }
    }
    x = x + 1;
  }
  vec_free(xmark);
  ra_segs_free(sg);
  ra_defs_free(ds);
  vec_free(iv.lo);
  vec_free(iv.hi);
  vec_free(lv.inn);
  vec_free(lv.out);
  vec_free(lv.bit);
  vec_free(bl);
  return ok;
}

// ---- The text form ----

/// The x86-64 names of the pools: callee-saved %rbx, %r12-%r15; caller-saved
/// %r8-%r11, %rsi, %rdi.
fn ra_callee_name(i: u64) -> Str {
  if i == 0 { return "%rbx"; }
  if i == 1 { return "%r12"; }
  if i == 2 { return "%r13"; }
  if i == 3 { return "%r14"; }
  return "%r15";
}

fn ra_caller_name(i: u64) -> Str {
  if i == 0 { return "%r8"; }
  if i == 1 { return "%r9"; }
  if i == 2 { return "%r10"; }
  if i == 3 { return "%r11"; }
  if i == 4 { return "%rsi"; }
  return "%rdi";
}

fn ra_print(out: &mut Vec[u64], f: &IrFn, a: &IrAlloc, m: &Mono, p: &Parser) {
  w_s(&mut out, "alloc ");
  ir_w_name(&mut out, m, p, f.x);
  w_s(&mut out, " {\n");
  let mut r = 0;
  while r < f.nreg {
    let cls = u_at(a.cls, r);
    if cls != RA_NONE {
      w_s(&mut out, "  ");
      ir_w_reg(&mut out, r);
      w_s(&mut out, " -> ");
      if cls == RA_CALLEE {
        w_s(&mut out, ra_callee_name(u_at(a.idx, r)));
      } else if cls == RA_CALLER {
        w_s(&mut out, ra_caller_name(u_at(a.idx, r)));
      } else {
        w_s(&mut out, "slot");
        w_num(&mut out, u_at(a.idx, r));
      }
      w_s(&mut out, "\n");
    }
    r = r + 1;
  }
  w_s(&mut out, "}\n");
}
