// Assembly for macOS (Mach-O) from the assembly the AArch64 native backend
// writes for Linux (ELF).
//
// The code is the same; the assembler's dialect and the C library's names
// are not. This pass rewrites the text of a finished hosted program line by
// line, in one place, so the emitter does not need a macOS branch at every
// address it writes:
//
// - `adrp xN, sym` / `add xN, xN, :lo12:sym` / `[xN, :lo12:sym]` become
//   `sym@PAGE` and `sym@PAGEOFF`; `:got:` and `:got_lo12:` become
//   `@GOTPAGE` and `@GOTPAGEOFF`.
// - A symbol of the C library gets the underscore the platform puts in
//   front of every C name (`bl calloc` is `bl _calloc`), and `main` too;
//   `stdout`, `stderr` and `environ` are `___stdoutp`, `___stderrp` and
//   `_environ`. Names of the program and the runtime keep theirs.
// - `.type` and `.size` lines and the GNU-stack note are dropped; read-only
//   data goes to `__TEXT,__const` and `.bss` to `.data` (Mach-O has no `.bss`
//   directive, and the zeros cost file size only).
//
// Part of the trusted base like the runtime text it rewrites.
import "irx86.bastio";

/// A character of an assembler name.
fn mo_ident(c: u64) -> bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 46 || c == 36;
}

/// Does the name `s` (and no longer one) begin at `i`?
fn mo_name_at(v: &Vec[u64], i: u64, s: Str) -> bool {
  return ix_has_at(v, i, s) && !mo_ident(u_at(v, wrap_add(i, slen(s))));
}

/// Is the name at `i` a C library function the runtime calls?
fn mo_ext(v: &Vec[u64], i: u64) -> bool {
  return mo_name_at(v, i, "abort") || mo_name_at(v, i, "aligned_alloc") || mo_name_at(v, i, "calloc")
    || mo_name_at(v, i, "close") || mo_name_at(v, i, "exit") || mo_name_at(v, i, "fclose")
    || mo_name_at(v, i, "fcntl") || mo_name_at(v, i, "fdopen") || mo_name_at(v, i, "fflush")
    || mo_name_at(v, i, "free") || mo_name_at(v, i, "fwrite") || mo_name_at(v, i, "getc")
    || mo_name_at(v, i, "getchar") || mo_name_at(v, i, "getenv") || mo_name_at(v, i, "malloc")
    || mo_name_at(v, i, "memcpy") || mo_name_at(v, i, "memmove") || mo_name_at(v, i, "memset")
    || mo_name_at(v, i, "open") || mo_name_at(v, i, "pipe") || mo_name_at(v, i, "posix_spawn_file_actions_addclose")
    || mo_name_at(v, i, "posix_spawn_file_actions_adddup2") || mo_name_at(v, i, "posix_spawn_file_actions_destroy")
    || mo_name_at(v, i, "posix_spawn_file_actions_init") || mo_name_at(v, i, "posix_spawnp")
    || mo_name_at(v, i, "printf") || mo_name_at(v, i, "putchar") || mo_name_at(v, i, "read")
    || mo_name_at(v, i, "realloc") || mo_name_at(v, i, "signal") || mo_name_at(v, i, "strlen")
    || mo_name_at(v, i, "sysconf") || mo_name_at(v, i, "waitpid") || mo_name_at(v, i, "write");
}

/// Writes the name at `i` as macOS spells it and returns where it ends.
fn mo_name(out: &mut Vec[u64], v: &Vec[u64], i: u64) -> u64 {
  let mut e = i;
  while mo_ident(u_at(v, e)) && e < vec_len(v) {
    e = wrap_add(e, 1);
  }
  if mo_name_at(v, i, "stdout") {
    w_s(&mut out, "___stdoutp");
  } else if mo_name_at(v, i, "stderr") {
    w_s(&mut out, "___stderrp");
  } else if mo_name_at(v, i, "environ") {
    w_s(&mut out, "_environ");
  } else {
    if mo_ext(v, i) {
      vec_push(&mut out, 95);
    }
    let mut k = i;
    while k < e {
      vec_push(&mut out, u_at(v, k));
      k = wrap_add(k, 1);
    }
  }
  return e;
}

/// Copies `v[from .. to]` to `out`.
fn mo_copy(out: &mut Vec[u64], v: &Vec[u64], from: u64, to: u64) {
  let mut k = from;
  while k < to && k < vec_len(v) {
    vec_push(&mut out, vec_get(v, k));
    k = wrap_add(k, 1);
  }
}

/// One line `v[s .. e]` (without its newline), or nothing for a line that
/// macOS does not want.
fn mo_line(out: &mut Vec[u64], v: &Vec[u64], s: u64, e: u64) {
  let mut t = s;
  // A label in front of the instruction (`2:\tbl calloc`).
  let mut q = s;
  while q < e && mo_ident(u_at(v, q)) {
    q = wrap_add(q, 1);
  }
  if q > s && q < e && u_at(v, q) == 58 {
    t = wrap_add(q, 1);
  }
  while t < e && (u_at(v, t) == 9 || u_at(v, t) == 32) {
    t = wrap_add(t, 1);
  }
  if ix_has_at(v, t, ".type ") || ix_has_at(v, t, ".size ") || ix_has_at(v, t, ".section .note") {
    return;
  }
  if ix_has_at(v, t, ".section .rodata") {
    w_s(&mut out, "\t.section __TEXT,__const\n");
    return;
  }
  if mo_name_at(v, t, ".bss") {
    w_s(&mut out, "\t.data\n");
    return;
  }
  if ix_has_at(v, s, "main:") {
    w_s(&mut out, "_main:");
    mo_copy(&mut out, v, wrap_add(s, 5), e);
    vec_push(&mut out, 10);
    return;
  }
  if mo_name_at(v, t, ".globl") && ix_has_at(v, wrap_add(t, 7), "main") && !mo_ident(u_at(v, wrap_add(t, 11))) {
    w_s(&mut out, "\t.globl _main\n");
    return;
  }
  if ix_has_at(v, t, "adrp ") {
    // adrp xN, [:got:]sym
    let mut k = wrap_add(t, 5);
    while k < e && u_at(v, k) != 44 {
      k = wrap_add(k, 1);
    }
    k = wrap_add(k, 1);
    while k < e && u_at(v, k) == 32 {
      k = wrap_add(k, 1);
    }
    mo_copy(&mut out, v, s, k);
    if ix_has_at(v, k, ":got:") {
      let n = mo_name(&mut out, v, wrap_add(k, 5));
      w_s(&mut out, "@GOTPAGE");
      mo_copy(&mut out, v, n, e);
    } else {
      let n = mo_name(&mut out, v, k);
      w_s(&mut out, "@PAGE");
      mo_copy(&mut out, v, n, e);
    }
    vec_push(&mut out, 10);
    return;
  }
  if (ix_has_at(v, t, "bl ") || ix_has_at(v, t, "b ")) && !ix_has_at(v, t, "b.") {
    // A call or jump to a name: the C library's get their underscore.
    let mut k = t;
    while k < e && u_at(v, k) != 32 {
      k = wrap_add(k, 1);
    }
    k = wrap_add(k, 1);
    mo_copy(&mut out, v, s, k);
    let n = mo_name(&mut out, v, k);
    mo_copy(&mut out, v, n, e);
    vec_push(&mut out, 10);
    return;
  }
  let mut k = s;
  while k < e {
    if ix_has_at(v, k, ":lo12:") {
      let n = mo_name(&mut out, v, wrap_add(k, 6));
      w_s(&mut out, "@PAGEOFF");
      k = n;
    } else if ix_has_at(v, k, ":got_lo12:") {
      let n = mo_name(&mut out, v, wrap_add(k, 10));
      w_s(&mut out, "@GOTPAGEOFF");
      k = n;
    } else {
      vec_push(&mut out, u_at(v, k));
      k = wrap_add(k, 1);
    }
  }
  vec_push(&mut out, 10);
}

/// The Mach-O spelling of the assembly text `v`.
fn macho_text(v: &Vec[u64]) -> Vec[u64] {
  let mut out = vec_new[u64]();
  let n = vec_len(v);
  let mut s = 0;
  while s < n {
    let mut e = s;
    while e < n && vec_get(v, e) != 10 {
      e = wrap_add(e, 1);
    }
    mo_line(&mut out, v, s, e);
    s = wrap_add(e, 1);
  }
  return out;
}

/// One line of x86-64 assembly (AT&T syntax) for Apple's assembler: the C
/// library's names behind `@PLT` and `@GOTPCREL` get the platform's spelling,
/// and the numbers that differ between Linux and macOS are the macOS ones.
fn mo_line_x86(out: &mut Vec[u64], v: &Vec[u64], s: u64, e: u64) {
  let mut t = s;
  while t < e && (u_at(v, t) == 9 || u_at(v, t) == 32) {
    t = wrap_add(t, 1);
  }
  if ix_has_at(v, t, ".type ") || ix_has_at(v, t, ".size ") || ix_has_at(v, t, ".section .note") {
    return;
  }
  if ix_has_at(v, t, ".section .rodata") {
    w_s(&mut out, "\t.section __TEXT,__const\n");
    return;
  }
  if mo_name_at(v, t, ".bss") {
    w_s(&mut out, "\t.data\n");
    return;
  }
  if ix_has_at(v, s, "main:") {
    w_s(&mut out, "_main:");
    mo_copy(&mut out, v, wrap_add(s, 5), e);
    vec_push(&mut out, 10);
    return;
  }
  if mo_name_at(v, t, ".globl") && ix_has_at(v, wrap_add(t, 7), "main") && !mo_ident(u_at(v, wrap_add(t, 11))) {
    w_s(&mut out, "\t.globl _main\n");
    return;
  }
  if ix_has_at(v, t, "mov $0x241, %esi") {
    // O_WRONLY | O_CREAT | O_TRUNC
    w_s(&mut out, "\tmov $0x601, %esi");
    mo_copy(&mut out, v, wrap_add(t, 16), e);
    vec_push(&mut out, 10);
    return;
  }
  if ix_has_at(v, t, "mov $84, %edi") {
    // _SC_NPROCESSORS_ONLN
    w_s(&mut out, "\tmov $58, %edi");
    mo_copy(&mut out, v, wrap_add(t, 13), e);
    vec_push(&mut out, 10);
    return;
  }
  let mut k = s;
  while k < e {
    let c = u_at(v, k);
    if mo_ident(c) && (k == s || !mo_ident(u_at(v, wrap_sub(k, 1)))) {
      let mut n = k;
      while n < e && mo_ident(u_at(v, n)) {
        n = wrap_add(n, 1);
      }
      if ix_has_at(v, n, "@PLT") {
        mo_name(&mut out, v, k);
        k = wrap_add(n, 4);
      } else if ix_has_at(v, n, "@GOTPCREL") {
        mo_name(&mut out, v, k);
        k = n;
      } else {
        mo_copy(&mut out, v, k, n);
        k = n;
      }
    } else {
      vec_push(&mut out, c);
      k = wrap_add(k, 1);
    }
  }
  vec_push(&mut out, 10);
}

/// The Mach-O spelling of the x86-64 assembly text `v`.
fn macho_text_x86(v: &Vec[u64]) -> Vec[u64] {
  let mut out = vec_new[u64]();
  let n = vec_len(v);
  let mut s = 0;
  while s < n {
    let mut e = s;
    while e < n && vec_get(v, e) != 10 {
      e = wrap_add(e, 1);
    }
    mo_line_x86(&mut out, v, s, e);
    s = wrap_add(e, 1);
  }
  return out;
}
