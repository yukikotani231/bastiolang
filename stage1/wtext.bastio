// Text in a `Vec[u64]`, one character per element: the buffer every phase
// of bastioc1 writes its output, messages and generated code into. These
// are the single copies of the helpers each phase used to carry its own
// version of (`cg_s`, `rd_s`, `out_str`, `x86_num`, ...). They write
// exactly what those did, so the differential test (difftest.sh) still
// compares stage1 with stage0 byte for byte.
//
// stage1 does not import core/: stage0 is frozen and stage1 must build with
// what stage0 builds, so these stay here rather than in core/text.bastio.

/// Appends the bytes of `s`.
fn w_s(out: &mut Vec[u64], s: Str) {
  let mut k = 0;
  while k < slen(s)
    invariant k <= slen(s)
  {
    vec_push(&mut out, cast[u64](sget(s, k)));
    k = k + 1;
  }
}

/// Appends `x` in decimal.
fn w_num(out: &mut Vec[u64], x: u64) {
  let mut d = vec_new[u64]();
  let mut y = x;
  vec_push(&mut d, 48 + y % 10);
  y = y / 10;
  while y > 0 {
    vec_push(&mut d, 48 + y % 10);
    y = y / 10;
  }
  let mut k = vec_len(d);
  while k > 0
    invariant k <= vlen(d)
  {
    k = k - 1;
    vec_push(&mut out, vec_get(d, k));
  }
  vec_free(d);
}

/// Appends `x` in lowercase hexadecimal, without leading zeros.
fn w_hex(out: &mut Vec[u64], x: u64) {
  let mut d = vec_new[u64]();
  let mut y = x;
  vec_push(&mut d, y % 16);
  y = y / 16;
  while y > 0 {
    vec_push(&mut d, y % 16);
    y = y / 16;
  }
  let mut k = vec_len(d);
  while k > 0
    invariant k <= vlen(d)
  {
    k = k - 1;
    let h = vec_get(d, k);
    if h < 10 {
      vec_push(&mut out, 48 + h);
    } else if h < 16 {
      vec_push(&mut out, 87 + h);
    }
  }
  vec_free(d);
}

/// Appends every element of `v`.
fn w_append(out: &mut Vec[u64], v: &Vec[u64]) {
  let mut k = 0;
  while k < vec_len(v) {
    vec_push(&mut out, vec_get(v, k));
    k = k + 1;
  }
}

/// Element `i` of `v`, or 0 past its end.
fn u_at(v: &Vec[u64], i: u64) -> u64 {
  if i < vec_len(v) {
    return vec_get(v, i);
  }
  return 0;
}

/// Whether `x` is an element of `v`.
fn has_id(v: &Vec[u64], x: u64) -> bool {
  let mut k = 0;
  while k < vec_len(v) {
    if vec_get(v, k) == x {
      return true;
    }
    k = k + 1;
  }
  return false;
}

/// A copy of `v`.
fn copy_set(v: &Vec[u64]) -> Vec[u64] {
  let mut out = vec_new[u64]();
  w_append(&mut out, v);
  return out;
}
