// Instances requested from instances, in queue order.
struct P[A, B] { a: A, b: B }
enum Opt[T] { Some(T), None }
fn pair[T](x: T) -> Opt[P[T, T]] { return Opt[P[T, T]]::Some(P[T, T] { a: x, b: x }); }
fn twice[T](x: T) -> Opt[P[Opt[P[T, T]], Opt[P[T, T]]]] { return pair[Opt[P[T, T]]](pair[T](x)); }
fn main() -> u64 {
  let v = vec_new[Opt[u64]]();
  vec_free(v);
  let o = twice[u64](3);
  return 0;
}
