// Inlining at the IR (docs/ir.md, "Passes"): a call of a small function is
// replaced by the callee's own instructions, so the allocator sees the
// callee's values next to the caller's and a result that would travel
// through memory (a struct of more than two words) stays in registers.
//
// The callee is lowered (and run through the other passes) on its own, then
// copied into the caller with its registers, labels and argument positions
// shifted past the caller's. Its parameters become `mov`s from the call's
// argument registers; each `ret` becomes moves into the call's result
// registers (or, for a `callm`, stores into the frame slot that call named)
// and a jump to a label placed after the copy.
//
// A callee that does not lower, that is bigger than the limits below, that
// is the function itself, or whose parameters do not match the call word for
// word, stays a call. A call inside a loop may be bigger (it runs often); one
// outside takes only a small body. Bodies copied in are scanned again for
// calls, up to IRI_ROUNDS deep.
import "iropt.bastio";

/// The largest callee, in instructions, that is inlined at a call outside a
/// loop, and at one inside a loop.
const IRI_SMALL: u64 = 40;
const IRI_LOOP: u64 = 160;
/// A caller that has grown past this many instructions inlines no more.
const IRI_GROWN: u64 = 1500;
/// Bodies this small are inlined whatever the size of the caller.
const IRI_TINY: u64 = 20;
const IRI_ROUNDS: u64 = 3;
/// A body that only compares and branches (a predicate over constants, like
/// `n == 3 || n == 7`) is inlined up to this size whatever the size of the
/// caller: it is a few compares after the switch pass, and the call, the
/// frame and the materialised `bool` cost more.
const IRI_PRED: u64 = 120;
/// A body that only reads (calls, loads and arithmetic between constants, and
/// branches that go forward; no store, other effect or loop) is inlined up to
/// this size: the getter of one field of a record returns the whole record
/// through memory, and inlined, only the word the caller reads is loaded.
const IRI_GET: u64 = 100;
/// A callee with exactly one call site in the whole program (`iri_count`) is
/// inlined up to this size, into a caller of fewer than IRI_ONCE_CALLER
/// instructions: the program gains the call's cost and the body is not copied
/// to a second place. Much larger bodies made the later passes, whose cost
/// grows faster than the size of a function, take ten times as long on the
/// BastiOS kernel.
const IRI_ONCE: u64 = 150;
const IRI_ONCE_CALLER: u64 = 3000;
/// A function inlined into itself (once, in the first round) is at most this big.
const IRI_SELF: u64 = 80;

fn iri_r(r: u64, rb: u64) -> u64 {
  if r == IR_NONE {
    return r;
  }
  return wrap_add(r, rb);
}

/// Instruction `q` of a callee with its registers moved up by `rb`, its
/// labels by `lb` and its positions in `args` by `ab`. (`ret` is rewritten
/// by the caller of this.)
fn iri_shift(q: IrIns, rb: u64, lb: u64, ab: u64) -> IrIns {
  let mut r = q;
  let op = q.op;
  if ra_is_binary(op) || op == IR_LOAD || op == IR_STORE || op == IR_PCALL || op == IR_XCHG {
    r.d = iri_r(q.d, rb);
    r.a = iri_r(q.a, rb);
    r.b = iri_r(q.b, rb);
  } else if op == IR_CONST || op == IR_SLOT || op == IR_STRLIT || op == IR_GETC || op == IR_GLOBAL || op == IR_TSC {
    r.d = iri_r(q.d, rb);
  } else if op == IR_MOV || op == IR_NOT || op == IR_NEG || op == IR_WRAP || op == IR_ALLOC || op == IR_RT || op == IR_PIN || op == IR_DEVR || op == IR_LOCKDEC {
    r.d = iri_r(q.d, rb);
    r.a = iri_r(q.a, rb);
  } else if op == IR_FREE || op == IR_PRINT || op == IR_PUTC || op == IR_VGROW || op == IR_ZERO || op == IR_LOCKINC || op == IR_LOCKACQ {
    r.a = iri_r(q.a, rb);
  } else if op == IR_CAS || op == IR_COPY || op == IR_FILL {
    r.d = iri_r(q.d, rb);
    r.a = iri_r(q.a, rb);
    r.b = iri_r(q.b, rb);
    r.c = iri_r(q.c, rb);
  } else if op == IR_DEVW || op == IR_POUT || op == IR_MMCHK || op == IR_COPYPAGE {
    r.a = iri_r(q.a, rb);
    r.b = iri_r(q.b, rb);
  } else if op == IR_LABEL || op == IR_JMP {
    r.a = wrap_add(q.a, lb);
  } else if op == IR_BR {
    r.a = iri_r(q.a, rb);
    r.b = wrap_add(q.b, lb);
    r.c = wrap_add(q.c, lb);
  } else if op == IR_CALL {
    r.d = iri_r(q.d, rb);
    if q.ty != 0 && q.ty != IR_NONE {
      r.ty = wrap_add(q.ty, rb);
    }
    r.b = wrap_add(q.b, ab);
  } else if op == IR_CALLM {
    r.d = iri_r(q.d, rb);
    r.b = wrap_add(q.b, ab);
  }
  return r;
}

/// Is position `pos` of `f` inside a loop: after a label that a later
/// instruction jumps back to?
fn iri_in_loop(f: &IrFn, pos: u64) -> bool {
  let n = vec_len(f.ins);
  let mut i = 0;
  while i < pos && i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_LABEL {
      let mut j = pos;
      while j < n {
        let t = vec_get(f.ins, j);
        if (t.op == IR_JMP && t.a == q.a) || (t.op == IR_BR && (t.b == q.a || t.c == q.a)) {
          return true;
        }
        j = j + 1;
      }
    }
    i = i + 1;
  }
  return false;
}

/// Can the body of `g` stand in for the call `q`? Every `ret` must fit the
/// call: one or two words for a `call`, a wide result for a `callm`.
fn iri_fits(g: &IrFn, q: IrIns) -> bool {
  if q.c != vec_len(g.params) {
    return false;
  }
  let mut ok = true;
  let mut i = 0;
  while i < vec_len(g.ins) {
    let t = vec_get(g.ins, i);
    if t.op == IR_RET {
      if q.op == IR_CALL && t.c > 0 {
        ok = false;
      }
      if q.op == IR_CALLM && (t.c == 0 || t.c > q.ty) {
        ok = false;
      }
    }
    i = i + 1;
  }
  return ok;
}

/// One word `j` of a wide result: `store q.d[j] = v`.
fn iri_store_word(f: &mut IrFn, out: &mut Vec[IrIns], slot: u64, j: u64, v: u64) {
  let t = ir_reg(&mut f);
  vec_push(&mut out, IrIns { op: IR_CONST, d: t, a: j, b: 0, c: 0, ty: 0 });
  vec_push(&mut out, IrIns { op: IR_STORE, d: v, a: slot, b: t, c: 8, ty: 0 });
}

/// Copies the body of `g` into `out` in place of the call `q` of `f`.
fn iri_splice(f: &mut IrFn, out: &mut Vec[IrIns], g: &IrFn, q: IrIns) {
  let rb = wrap_add(f.nreg, 1);
  f.nreg = wrap_add(rb, g.nreg);
  let lb = f.nlabel;
  f.nlabel = wrap_add(lb, g.nlabel);
  let end = ir_label(&mut f);
  let ab = vec_len(f.args);
  let mut k = 0;
  while k < vec_len(g.args) {
    vec_push(&mut f.args, iri_r(vec_get(g.args, k), rb));
    k = k + 1;
  }
  if q.op == IR_CALLM {
    vec_push(&mut out, IrIns { op: IR_SLOT, d: q.d, a: 0, b: 0, c: q.ty, ty: 0 });
  }
  k = 0;
  while k < vec_len(g.params) {
    vec_push(&mut out, IrIns { op: IR_MOV, d: wrap_add(vec_get(g.params, k), rb), a: u_at(f.args, wrap_add(q.b, k)), b: 0, c: 0, ty: 0 });
    k = k + 1;
  }
  k = 0;
  while k < vec_len(g.nz) {
    vec_push(&mut f.nz, wrap_add(vec_get(g.nz, k), rb));
    k = k + 1;
  }
  k = 0;
  while k < vec_len(g.ins) {
    let t = vec_get(g.ins, k);
    if t.op == IR_RET {
      if q.op == IR_CALL {
        if t.a != IR_NONE && q.d != IR_NONE {
          vec_push(&mut out, IrIns { op: IR_MOV, d: q.d, a: iri_r(t.a, rb), b: 0, c: 0, ty: 0 });
        }
        if t.b != IR_NONE && q.ty != 0 && q.ty != IR_NONE && q.d != IR_NONE {
          vec_push(&mut out, IrIns { op: IR_MOV, d: q.ty, a: iri_r(t.b, rb), b: 0, c: 0, ty: 0 });
        }
      } else if t.a == IR_NONE {
        // `ret regs`: the words are held in registers.
        let mut j = 0;
        while j < t.c && j < 4096 {
          let v = iri_r(u_at(g.args, wrap_add(t.b, j)), rb);
          iri_store_word(&mut f, &mut out, q.d, j, v);
          j = j + 1;
        }
      } else {
        // `ret mem`: the words are at address a.
        let mut j = 0;
        while j < t.c && j < 4096 {
          let ix = ir_reg(&mut f);
          let v = ir_reg(&mut f);
          vec_push(&mut out, IrIns { op: IR_CONST, d: ix, a: j, b: 0, c: 0, ty: 0 });
          vec_push(&mut out, IrIns { op: IR_LOAD, d: v, a: iri_r(t.a, rb), b: ix, c: 8, ty: 0 });
          vec_push(&mut out, IrIns { op: IR_STORE, d: v, a: q.d, b: ix, c: 8, ty: 0 });
          j = j + 1;
        }
      }
      vec_push(&mut out, IrIns { op: IR_JMP, d: IR_NONE, a: end, b: 0, c: 0, ty: 0 });
    } else {
      vec_push(&mut out, iri_shift(t, rb, lb, ab));
    }
    k = k + 1;
  }
  vec_push(&mut out, IrIns { op: IR_LABEL, d: IR_NONE, a: end, b: 0, c: 0, ty: 0 });
}

/// Fills `m.ncall` with the number of call sites of each instance, by
/// lowering every function once (before any pass, so a body inlined
/// elsewhere does not count twice).
fn iri_count(c: &Checker, m: &mut Mono, p: &Parser) {
  vec_free(m.ncall);
  m.ncall = vec_new[u64]();
  let mut i = 0;
  while i < vec_len(m.insts) && i < 1000000000 {
    vec_push(&mut m.ncall, 0);
    i = i + 1;
  }
  let mut k = 0;
  while k < vec_len(m.fns) {
    let x = u_at(m.fns, k);
    let g = ir_lower(c, &mut m, p, x);
    let mut j = 0;
    while !g.failed && j < vec_len(g.ins) {
      let t = vec_get(g.ins, j);
      if (t.op == IR_CALL || t.op == IR_CALLM) && t.a < vec_len(m.ncall) {
        ra_set(&mut m.ncall, t.a, wrap_add(u_at(m.ncall, t.a), 1));
      }
      j = j + 1;
    }
    ir_free(g);
    k = k + 1;
  }
}

/// Does `g` only compute with registers: no call, memory access or other
/// effect, only constants, moves, arithmetic, comparisons and branches?
fn iri_predicate(g: &IrFn) -> bool {
  let mut i = 0;
  while i < vec_len(g.ins) {
    let t = vec_get(g.ins, i);
    let op = t.op;
    if !(op == IR_CONST || op == IR_MOV || op == IR_LABEL || op == IR_JMP || op == IR_BR || op == IR_RET || (op >= IR_EQ && op <= IR_SGE) || op == IR_AND || op == IR_OR || op == IR_NOT) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// Does `g` only read memory, compute and call, with no loop? (see IRI_GET)
fn iri_getter(g: &IrFn, x: u64) -> bool {
  let lp = ra_lpos(g);
  let mut ok = true;
  let mut i = 0;
  while ok && i < vec_len(g.ins) {
    let t = vec_get(g.ins, i);
    let op = t.op;
    if op == IR_JMP {
      if t.a >= vec_len(lp) || u_at(lp, t.a) <= i {
        ok = false;
      }
    } else if op == IR_BR {
      if t.b >= vec_len(lp) || t.c >= vec_len(lp) || u_at(lp, t.b) <= i || u_at(lp, t.c) <= i {
        ok = false;
      }
    } else if op == IR_CALL || op == IR_CALLM {
      if t.a == x {
        ok = false;
      }
    } else if !(op == IR_CONST || op == IR_MOV || op == IR_LABEL || op == IR_RET || op == IR_LOAD || op == IR_NOT || op == IR_NEG || op == IR_WRAP || (ra_is_binary(op) && op != IR_DIV && op != IR_REM && op != IR_SDIV && op != IR_SREM)) {
      ok = false;
    }
    i = i + 1;
  }
  vec_free(lp);
  return ok;
}

/// Does the body of `g`, the instance `x`, call `x` itself?
fn iri_recursive(g: &IrFn, x: u64) -> bool {
  let mut i = 0;
  while i < vec_len(g.ins) {
    let t = vec_get(g.ins, i);
    if (t.op == IR_CALL || t.op == IR_CALLM) && t.a == x {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// One round: every call that can be inlined is. Returns how many were.
fn iri_round(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, selfok: bool, norec: bool, deep: bool) -> u64 {
  let mut out = vec_new[IrIns]();
  let n = vec_len(f.ins);
  let mut done = 0;
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    let mut spliced = false;
    if (q.op == IR_CALL || q.op == IR_CALLM) && (q.a != f.x || selfok) {
      let mut g = ir_lower(c, &mut m, p, q.a);
      // A caller that has grown past IRI_GROWN still takes the bodies of a
      // few instructions (a state getter and the like): they cost less
      // than the call.
      let once = vec_len(out) < IRI_ONCE_CALLER && q.a < vec_len(m.ncall) && u_at(m.ncall, q.a) == 1 && q.a != f.x && vec_len(g.ins) <= IRI_ONCE;
      let room = once || vec_len(out) < IRI_GROWN || vec_len(g.ins) <= IRI_TINY || (vec_len(g.ins) <= IRI_PRED && iri_predicate(g));
      if room && !g.failed && (once || vec_len(g.ins) <= IRI_LOOP) && !(norec && (iri_recursive(g, q.a) || !iri_in_loop(f, i))) {
        iropt_slots(&mut g);
        iropt_copies(&mut g);
        iropt_thread(&mut g);
        if q.a == f.x && deep {
          iropt_accrec(&mut g);
        }
        let mut limit = IRI_SMALL;
        if iri_in_loop(f, i) {
          limit = IRI_LOOP;
        }
        if limit < IRI_PRED && iri_predicate(g) {
          limit = IRI_PRED;
        }
        if limit < IRI_GET && iri_getter(g, q.a) {
          limit = IRI_GET;
        }
        if once {
          limit = IRI_ONCE;
        }
        if q.a == f.x && limit > IRI_SELF {
          limit = IRI_SELF;
        }
        if vec_len(g.ins) <= limit && iri_fits(g, q) {
          iri_splice(&mut f, &mut out, g, q);
          spliced = true;
          done = wrap_add(done, 1);
        }
      }
      ir_free(g);
    }
    if !spliced {
      vec_push(&mut out, q);
    }
    i = i + 1;
  }
  vec_free(f.ins);
  f.ins = out;
  return done;
}

/// Inlines the calls of `f` that qualify, up to IRI_ROUNDS deep (with `deep`,
/// a function `iropt_accrec` made a loop takes its own body in all rounds, not
/// only the first, since the loop leaves one call to carry the recursion) (a body
/// copied in is searched for calls in the next round). Returns how many.
fn iropt_inline(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, deep: bool) -> u64 {
  let mut total = 0;
  let mut round = 0;
  let mut rounds = IRI_ROUNDS;
  if deep {
    rounds = 5;
  }
  while round < rounds {
    let k = iri_round(&mut f, c, &mut m, p, round < 2 || (deep && round < 5), false, deep);
    total = wrap_add(total, k);
    if k == 0 {
      round = rounds;
    } else {
      round = round + 1;
    }
  }
  // A recursive callee copied in by the last rounds brings calls that no
  // round is left to inline: take the calls in loops of those copies, never
  // a recursive callee again.
  round = 0;
  while round < IRI_ROUNDS {
    let k = iri_round(&mut f, c, &mut m, p, false, true, false);
    total = wrap_add(total, k);
    if k == 0 {
      round = IRI_ROUNDS;
    } else {
      round = round + 1;
    }
  }
  return total;
}
