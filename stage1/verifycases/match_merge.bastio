// Verifier cases: matches where several arms fall through and some return,
// with bindings, a wildcard and facts learned inside arms; `&&` and `||`
// whose right side lends a variable as `&mut`.

enum Op { Add(u64), Sub(u64), Mul(u64), Reset, Stop }

fn bump(n: &mut u64) -> bool
  requires n < 1000
  ensures n == old(n) + 1
  ensures result == (n > 5)
{
  n = n + 1;
  return n > 5;
}

fn step(acc: u64, op: Op) -> u64
  requires acc < 1000
  ensures result < 2000
{
  let mut r = acc;
  match op {
    Op::Add(k) => {
      if k >= 1000 { return 0; }
      assert k < 1000;
      r = acc + k;
    },
    Op::Sub(k) => {
      if k > acc { return 0; }
      r = acc - k;
    },
    Op::Stop => { return acc; },
    _ => { r = 0; },
  }
  return r;
}

fn chain(a: u64, b: u64) -> u64
  requires a < 100 && b < 100
{
  let mut x = a;
  let mut y = b;
  let mut n = 0;
  if x > 3 && bump(&mut x) {
    n = 1;
  }
  if y == 0 || bump(&mut y) {
    n = n + 2;
  }
  return n + x + y;
}

fn main() -> u64 {
  let s = step(5, Op::Add(3)) + step(5, Op::Sub(9)) + step(5, Op::Mul(2)) + step(5, Op::Reset);
  return s % 1000 + chain(4, 0) % 1000;
}
