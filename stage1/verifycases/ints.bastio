// Verifier cases: sized integers. Overflow bounds per type, the range facts
// of fresh u8/u16/u32 values (parameters, fields havocked by a loop, vector
// elements), cast and wrap, wrap_add/sub/mul, and spec fns over u8.

struct Px { r: u8, g: u16, n: u32 }

spec fn small(x: u8) -> bool { x < 200 }

fn mix(a: u16, b: u16) -> u16
  requires a < 1000 && b < 1000
{
  return a + b;
}

fn halve(x: u8) -> u8
  ensures small(result)
{
  return x / 2;
}

fn bump(p: &mut Px) {
  if p.n < 4000000000 {
    p.n = p.n + 1;
  }
}

fn main() -> u64 {
  let mut p = Px { r: 1, g: 2, n: 3 };
  let mut i = 0;
  while i < 10
    invariant i <= 10
  {
    bump(&mut p);
    p.r = wrap_add(p.r, cast[u8](7));
    i = i + 1;
  }
  let w = wrap[u8](300);
  let s = wrap_sub(cast[u16](1), cast[u16](2));
  let m = wrap_mul(p.g, p.g);
  let mut v = vec_new[u8]();
  vec_push(&mut v, w);
  let e = vec_get(v, 0);
  vec_free(v);
  let h = halve(p.r);
  let t = mix(cast[u16](10), cast[u16](20));
  return cast[u64](e) + cast[u64](h) + cast[u64](t) + cast[u64](s) + cast[u64](m);
}
