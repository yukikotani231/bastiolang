// The runtime preludes: the C each generated program starts with, one
// function per part. They are copies of the preludes of stage0's C backend
// (stage0/src/codegen.rs), and the differential test (difftest.sh, `c`)
// keeps them identical: what bastioc1 emits must match what bastioc0 emits
// byte for byte. Like those, they are the trusted runtime of each target
// (ROADMAP invariant 3).

import "wtext.bastio";

fn cg_prelude_common(out: &mut Vec[u64]) {
  w_s(&mut out, "/* generated by bastioc0 -- do not edit */\n");
  w_s(&mut out, "#include <stdint.h>\n");
  w_s(&mut out, "#include <stdbool.h>\n");
  w_s(&mut out, "#include <stddef.h>\n");
  w_s(&mut out, "typedef struct { uint64_t len; uint64_t *data; } bst_buf;\n");
  w_s(&mut out, "typedef struct { uint64_t len; const unsigned char *data; } bst_str;\n");
  w_s(&mut out, "typedef struct { uint64_t len; unsigned char *data; } bst_bytes;\n");
  w_s(&mut out, "typedef int bst_serial, bst_mmu, bst_cpu, bst_host;   /* capability tokens: no data */\n");
  w_s(&mut out, "typedef uint64_t bst_frame, bst_pt;         /* a page's physical address */\n");
  w_s(&mut out, "typedef struct { uint64_t base, size; } bst_pool;\n");
  w_s(&mut out, "typedef int bst_ports;                      /* capability token: no data */\n");
  w_s(&mut out, "typedef struct { uint64_t base, count; } bst_portio;\n");
  w_s(&mut out, "typedef int bst_mmiospace;                  /* capability token: no data */\n");
  w_s(&mut out, "typedef struct { uint64_t base, len; } bst_mmio;\n");
  w_s(&mut out, "typedef uint64_t bst_dma;                   /* a lent page's physical address */\n");
  w_s(&mut out, "typedef uint64_t bst_lease;                 /* the address of the table it holds */\n");
  w_s(&mut out, "/* Lock[T]: a lock word followed by the T. A spin lock; acquire and release\n");
  w_s(&mut out, " * order the accesses to the contents between processors. A processor that\n");
  w_s(&mut out, " * has to wait first gives up a parked address space (bst_mmu_exit), as a\n");
  w_s(&mut out, " * processor holding a lease never waits, and one that lets go of its last\n");
  w_s(&mut out, " * lock gives it up too, unless it entered the table again meanwhile\n");
  w_s(&mut out, " * (bst_lock_depth). */\n");
  w_s(&mut out, "static inline void bst_mmu_settle(void);    /* defined per target */\n");
  w_s(&mut out, "static inline void bst_lock_depth(int d);   /* defined per target */\n");
  w_s(&mut out, "#ifndef BST_SPIN_PLAIN\n#define BST_SPIN_PLAIN 4096u\n#endif\n");
  w_s(&mut out, "#ifdef BST_LOCKSTAT\n");
  w_s(&mut out, "/* Diagnostic build (-DBST_LOCKSTAT): per lock, how many times it was taken,\n");
  w_s(&mut out, " * how many of those had to wait, and the time spent waiting and holding,\n");
  w_s(&mut out, " * in TSC ticks. Read bst_lockstat from a debugger. */\n");
  w_s(&mut out, "struct bst_ls { uint64_t *w; uint64_t acq, contended, wait, hold, t0; };\n");
  w_s(&mut out, "struct bst_ls bst_lockstat[8];\n");
  w_s(&mut out, "static inline struct bst_ls *bst_ls_of(uint64_t *w) {\n");
  w_s(&mut out, "    for (int i = 0; i < 8; i++) {\n");
  w_s(&mut out, "        uint64_t *o = 0;\n");
  w_s(&mut out, "        if (__atomic_load_n(&bst_lockstat[i].w, __ATOMIC_ACQUIRE) == w) return &bst_lockstat[i];\n");
  w_s(&mut out, "        if (__atomic_compare_exchange_n(&bst_lockstat[i].w, &o, w, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return &bst_lockstat[i];\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return &bst_lockstat[7];\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static inline void bst_lock_acquire(uint64_t *w) {\n");
  w_s(&mut out, "#ifdef BST_LOCKSTAT\n");
  w_s(&mut out, "    uint64_t bst_t0 = __builtin_ia32_rdtsc();\n");
  w_s(&mut out, "    int bst_waited = 0;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    while (__atomic_exchange_n(w, 1, __ATOMIC_ACQUIRE)) {\n");
  w_s(&mut out, "#ifdef BST_LOCKSTAT\n");
  w_s(&mut out, "        bst_waited = 1;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        bst_mmu_settle();\n");
  w_s(&mut out, "        unsigned bst_spins = 0;\n");
  w_s(&mut out, "        while (__atomic_load_n(w, __ATOMIC_RELAXED)) {\n");
  w_s(&mut out, "#if defined(__x86_64__) || defined(__i386__)\n");
  w_s(&mut out, "            if (++bst_spins > BST_SPIN_PLAIN) __asm__ volatile (\"pause\");\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#ifdef BST_LOCKSTAT\n");
  w_s(&mut out, "    { struct bst_ls *l = bst_ls_of(w); uint64_t t = __builtin_ia32_rdtsc();\n");
  w_s(&mut out, "      l->acq++; l->contended += bst_waited; l->wait += t - bst_t0; l->t0 = t; }\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    bst_lock_depth(1);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_lock_release(uint64_t *w) {\n");
  w_s(&mut out, "#ifdef BST_LOCKSTAT\n");
  w_s(&mut out, "    { struct bst_ls *l = bst_ls_of(w); l->hold += __builtin_ia32_rdtsc() - l->t0; }\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    __atomic_store_n(w, 0, __ATOMIC_RELEASE); bst_lock_depth(-1);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_buf bst_set(bst_buf b, uint64_t i, uint64_t v) { b.data[i] = v; return b; }\n");
}

fn cg_prelude_hosted(out: &mut Vec[u64]) {
  w_s(&mut out, "#include <stdio.h>\n");
  w_s(&mut out, "#include <stdlib.h>\n");
  w_s(&mut out, "#include <string.h>\n");
  w_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) { (void)s; putchar((int)b); if (b == '\\n') fflush(stdout); }\n");
  w_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) { (void)s; fflush(stdout); int c = getchar(); return c == EOF ? 4 : (uint64_t)c; }\n");
  w_s(&mut out, "static inline void bst_mmu_settle(void) { }\n");
  w_s(&mut out, "static inline void bst_lock_depth(int d) { (void)d; }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf b;\n");
  w_s(&mut out, "    b.len = n;\n");
  w_s(&mut out, "    b.data = (uint64_t *)calloc(n ? n : 1, sizeof(uint64_t));\n");
  w_s(&mut out, "    if (!b.data) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_buf bst_try_alloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf b;\n");
  w_s(&mut out, "    b.data = (uint64_t *)calloc(n ? n : 1, sizeof(uint64_t));\n");
  w_s(&mut out, "    __asm__ volatile (\"\" : \"+r\"(b.data)); /* clang drops a calloc that is only freed, and with it the failure */\n");
  w_s(&mut out, "    b.len = b.data ? n : 0;\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_free(bst_buf b) { free(b.data); }\n");
  w_s(&mut out, "/* Grow a block of `old` words to `n` words, keeping its contents; the new\n");
  w_s(&mut out, " * words are not zeroed (only Vec uses it, and never reads past its length). */\n");
  w_s(&mut out, "static uint64_t *bst_try_regrow(uint64_t *p, uint64_t old, uint64_t n) {\n");
  w_s(&mut out, "    (void)old;\n");
  w_s(&mut out, "    return (uint64_t *)realloc(p, (n ? n : 1) * sizeof(uint64_t));\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t *bst_regrow(uint64_t *p, uint64_t old, uint64_t n) {\n");
  w_s(&mut out, "    uint64_t *q = bst_try_regrow(p, old, n);\n");
  w_s(&mut out, "    if (!q) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    return q;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_print(uint64_t v) { printf(\"%llu\\n\", (unsigned long long)v); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "static bst_bytes bst_balloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_bytes b;\n");
  w_s(&mut out, "    b.len = n;\n");
  w_s(&mut out, "    b.data = (unsigned char *)calloc(n ? n : 1, 1);\n");
  w_s(&mut out, "    if (!b.data) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_bytes bst_try_balloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_bytes b;\n");
  w_s(&mut out, "    b.data = (unsigned char *)calloc(n ? n : 1, 1);\n");
  w_s(&mut out, "    __asm__ volatile (\"\" : \"+r\"(b.data)); /* clang drops a calloc that is only freed, and with it the failure */\n");
  w_s(&mut out, "    b.len = b.data ? n : 0;\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bfree(bst_bytes b) { free(b.data); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* The Host capability: command-line arguments and whole-file I/O. */\n");
  w_s(&mut out, "static int bst_argc;\n");
  w_s(&mut out, "static char **bst_argv;\n");
  w_s(&mut out, "static uint64_t bst_host_argc(bst_host h) { (void)h; return (uint64_t)bst_argc; }\n");
  w_s(&mut out, "static bst_bytes bst_host_arg(bst_host h, uint64_t i) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    if (i >= (uint64_t)bst_argc) return bst_balloc(0);\n");
  w_s(&mut out, "    const char *a = bst_argv[i];\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    if (i == 0 && _pgmptr) a = _pgmptr;   /* argv[0] may lack the .exe that opens the file */\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    size_t n = strlen(a);\n");
  w_s(&mut out, "    bst_bytes b = bst_balloc(n);\n");
  w_s(&mut out, "    memcpy(b.data, a, n);\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static char *bst_cpath(bst_bytes p) {   /* a NUL-terminated copy; a NUL inside ends the path */\n");
  w_s(&mut out, "    char *c = (char *)malloc(p.len + 1);\n");
  w_s(&mut out, "    if (!c) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    memcpy(c, p.data, p.len);\n");
  w_s(&mut out, "    c[p.len] = 0;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    if (p.len == 9 && memcmp(c, \"/dev/null\", 9) == 0) memcpy(c, \"NUL\", 4);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    return c;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bool bst_host_read(bst_host h, bst_bytes path, bst_bytes *out) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    char *c = bst_cpath(path);\n");
  w_s(&mut out, "    FILE *f = fopen(c, \"rb\");\n");
  w_s(&mut out, "    free(c);\n");
  w_s(&mut out, "    if (!f) return false;\n");
  w_s(&mut out, "    size_t cap = 4096, n = 0;\n");
  w_s(&mut out, "    unsigned char *d = (unsigned char *)malloc(cap);\n");
  w_s(&mut out, "    if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    size_t got;\n");
  w_s(&mut out, "    while ((got = fread(d + n, 1, cap - n, f)) > 0) {\n");
  w_s(&mut out, "        n += got;\n");
  w_s(&mut out, "        if (n == cap) {\n");
  w_s(&mut out, "            cap *= 2;\n");
  w_s(&mut out, "            d = (unsigned char *)realloc(d, cap);\n");
  w_s(&mut out, "            if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bool ok = !ferror(f);\n");
  w_s(&mut out, "    fclose(f);\n");
  w_s(&mut out, "    if (!ok) { free(d); return false; }\n");
  w_s(&mut out, "    free(out->data);\n");
  w_s(&mut out, "    out->len = n;\n");
  w_s(&mut out, "    out->data = d;\n");
  w_s(&mut out, "    return true;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bool bst_host_write(bst_host h, bst_bytes path, bst_bytes data) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    char *c = bst_cpath(path);\n");
  w_s(&mut out, "    FILE *f = fopen(c, \"wb\");\n");
  w_s(&mut out, "    free(c);\n");
  w_s(&mut out, "    if (!f) return false;\n");
  w_s(&mut out, "    bool ok = fwrite(data.data, 1, data.len, f) == data.len;\n");
  w_s(&mut out, "    return fclose(f) == 0 && ok;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_host_eprint(bst_host h, bst_bytes b) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    fflush(stdout);\n");
  w_s(&mut out, "    fwrite(b.data, 1, b.len, stderr);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Simulated physical memory: a pool of page-aligned pages from the heap,\n");
  w_s(&mut out, " * one run of RAM (see the kernel's bst_pool_init for several). */\n");
  w_s(&mut out, "#define BST_HOSTED_PAGES 256\n");
  w_s(&mut out, "static uint64_t bst_run_at[1], bst_run_id[2], bst_runs;\n");
  w_s(&mut out, "static uint32_t bst_pt_leases[BST_HOSTED_PAGES], bst_shared_refs[BST_HOSTED_PAGES];\n");
  w_s(&mut out, "#define BST_MMIO_CHECK(b, l) ((void)(b), (void)(l))\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "#include <malloc.h>\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static bst_pool bst_pool_init(void) {\n");
  w_s(&mut out, "    bst_pool p;\n");
  w_s(&mut out, "    p.size = BST_HOSTED_PAGES;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    p.base = (uint64_t)_aligned_malloc(BST_HOSTED_PAGES * 4096, 4096);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    p.base = (uint64_t)aligned_alloc(4096, BST_HOSTED_PAGES * 4096);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    if (!p.base) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    bst_run_at[0] = p.base;\n");
  w_s(&mut out, "    bst_run_id[1] = BST_HOSTED_PAGES;\n");
  w_s(&mut out, "    bst_runs = 1;\n");
  w_s(&mut out, "    return p;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "static void bst_pool_fini(bst_pool p) { _aligned_free((void *)p.base); }\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "static void bst_pool_fini(bst_pool p) { free((void *)p.base); }\n");
  w_s(&mut out, "#endif\n");
}

fn cg_prelude_pages(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "#define BST_PTE_P 1ull\n");
  w_s(&mut out, "#define BST_PTE_W 2ull\n");
  w_s(&mut out, "#define BST_PTE_U 4ull\n");
  w_s(&mut out, "/* A page the program may write is never one it may run (W^X): the entry\n");
  w_s(&mut out, " * has the no-execute bit when it is made writable (pt_put_frame and\n");
  w_s(&mut out, " * pt_put_shared with w), and has not when made read-only, so a page is\n");
  w_s(&mut out, " * executable if it was mapped read-only (program text) or if the kernel\n");
  w_s(&mut out, " * made it so by mapping it again read-only. pt_set_access leaves the bit\n");
  w_s(&mut out, " * alone: a page that becomes writable for a copy-on-write fault keeps what\n");
  w_s(&mut out, " * its mapping chose. Needs EFER.NXE (boot.S). */\n");
  w_s(&mut out, "#define BST_PTE_NX (1ull << 63)\n");
  w_s(&mut out, "#define BST_PTE_ADDR 0x000FFFFFFFFFF000ull\n");
  w_s(&mut out, "static inline void bst_zero_page(uint64_t a) {\n");
  w_s(&mut out, "#if defined(__x86_64__)\n");
  w_s(&mut out, "    void *p = (void *)a;\n");
  w_s(&mut out, "    uint64_t n = 512;\n");
  w_s(&mut out, "    __asm__ volatile (\"rep stosq\" : \"+D\"(p), \"+c\"(n) : \"a\"(0ull) : \"memory\");\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    uint64_t *w = (uint64_t *)a;\n");
  w_s(&mut out, "    for (int k = 0; k < 512; k++) w[k] = 0;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_pool_size(bst_pool p) { return p.size; }\n");
  w_s(&mut out, "/* Page ids are dense over the runs of RAM: run r holds ids bst_run_id[r] up\n");
  w_s(&mut out, " * to bst_run_id[r + 1], from address bst_run_at[r]. Most machines have one\n");
  w_s(&mut out, " * or two runs, so the loops stop at once. */\n");
  w_s(&mut out, "static inline uint64_t bst_page_at(uint64_t i) {\n");
  w_s(&mut out, "    uint64_t r = 0;\n");
  w_s(&mut out, "    while (r + 1 < bst_runs && i >= bst_run_id[r + 1]) r++;\n");
  w_s(&mut out, "    return bst_run_at[r] + (i - bst_run_id[r]) * 4096;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_frame_id(bst_frame f) {\n");
  w_s(&mut out, "    uint64_t r = 0;\n");
  w_s(&mut out, "    while (r + 1 < bst_runs && f - bst_run_at[r] >= (bst_run_id[r + 1] - bst_run_id[r]) * 4096) r++;\n");
  w_s(&mut out, "    return bst_run_id[r] + (f - bst_run_at[r]) / 4096;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_frame bst_pool_take(bst_pool *p, uint64_t i) {\n");
  w_s(&mut out, "    uint64_t a = bst_page_at(i);\n");
  w_s(&mut out, "    (void)p;\n");
  w_s(&mut out, "    bst_zero_page(a);      /* never leak a page's old contents */\n");
  w_s(&mut out, "    return a;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_pool_give(bst_pool *p, bst_frame f) { (void)p; (void)f; }\n");
  w_s(&mut out, "static inline uint64_t bst_frame_read(bst_frame f, uint64_t w) { return ((uint64_t *)f)[w]; }\n");
  w_s(&mut out, "static inline void bst_frame_write(bst_frame *f, uint64_t w, uint64_t v) { ((uint64_t *)*f)[w] = v; }\n");
  w_s(&mut out, "static inline uint64_t bst_frame_read8(bst_frame f, uint64_t o) { return ((unsigned char *)f)[o]; }\n");
  w_s(&mut out, "static inline void bst_frame_write8(bst_frame *f, uint64_t o, uint64_t v) { ((unsigned char *)*f)[o] = (unsigned char)v; }\n");
  w_s(&mut out, "static inline void bst_frame_to_bytes(bst_bytes *dst, uint64_t d, bst_frame f, uint64_t o, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd(dst->data + d, (const unsigned char *)f + o, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bytes_to_frame(bst_frame *f, uint64_t o, bst_bytes src, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd((unsigned char *)*f + o, src.data + s, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_frame_to_frame(bst_frame *d, uint64_t o, bst_frame f, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd((unsigned char *)*d + o, (const unsigned char *)f + s, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_pt bst_pt_new(bst_frame f, uint64_t level) {\n");
  w_s(&mut out, "    uint64_t *e = (uint64_t *)f;\n");
  w_s(&mut out, "    bst_zero_page(f);      /* f may be a page that held data, not a fresh one */\n");
  w_s(&mut out, "    BST_PT_NEW_HOOK\n");
  w_s(&mut out, "    return f;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_frame bst_pt_free(bst_pt t) { return t; }\n");
  w_s(&mut out, "/* Counts every entry taken out of any table, and every protection change: a processor whose TLB may\n");
  w_s(&mut out, " * still hold the entry reloads CR3 before it runs user code again if the\n");
  w_s(&mut out, " * count moved since its last load (bst_cpu_run, bst_mmu_enter). Putting an\n");
  w_s(&mut out, " * entry into an empty slot needs no reload: x86 caches no translation for\n");
  w_s(&mut out, " * a slot that was not present. */\n");
  w_s(&mut out, "uint64_t bst_pt_gen;\n");
  w_s(&mut out, "/* A last-level slot the program may not touch (pt_set_access 0) keeps its\n");
  w_s(&mut out, " * page with the present bit clear, marked by a bit the CPU ignores in a\n");
  w_s(&mut out, " * non-present entry, so the table still owns it. */\n");
  w_s(&mut out, "#define BST_PTE_HIDDEN 0x400ull\n");
  w_s(&mut out, "static inline bool bst_pt_has(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & (BST_PTE_P | BST_PTE_HIDDEN)) != 0; }\n");
  w_s(&mut out, "static inline bool bst_pt_writable(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_W) != 0; }\n");
  w_s(&mut out, "static inline bool bst_pt_accessible(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_P) != 0; }\n");
  w_s(&mut out, "static inline void bst_pt_set_access(bst_pt *t, uint64_t i, uint64_t a) {\n");
  w_s(&mut out, "    uint64_t e = ((uint64_t *)*t)[i] & ~(BST_PTE_P | BST_PTE_W | BST_PTE_HIDDEN);\n");
  w_s(&mut out, "    e |= a == 0 ? BST_PTE_HIDDEN : (BST_PTE_P | (a == 2 ? BST_PTE_W : 0));\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], e, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "    __atomic_fetch_add(&bst_pt_gen, 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Another processor may be walking the table (it holds a lease on the\n");
  w_s(&mut out, " * tree), so an entry is written with one 64-bit store, present bit\n");
  w_s(&mut out, " * included, after everything it points to (release order). */\n");
  w_s(&mut out, "static inline void bst_pt_put(bst_pt *t, uint64_t i, bst_pt c) {\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], c | BST_PTE_P | BST_PTE_W | BST_PTE_U, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_pt_put_frame(bst_pt *t, uint64_t i, bst_frame f, bool w) {\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], f | BST_PTE_P | BST_PTE_U | (w ? BST_PTE_W | BST_PTE_NX : 0), __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* What slot i points to, left in place (pt_borrow). */\n");
  w_s(&mut out, "static inline uint64_t bst_pt_child(bst_pt t, uint64_t i) { return ((uint64_t *)t)[i] & BST_PTE_ADDR; }\n");
  w_s(&mut out, "/* Leases outstanding on each top-level table (mmu_enter, mmu_exit), by page\n");
  w_s(&mut out, " * number (bst_pt_leases, one per pool page, comes with the pool). A lease this processor parked\n");
  w_s(&mut out, " * (bst_mmu_exit) is given back first, so the count is what it would be had\n");
  w_s(&mut out, " * the table been left at once. */\n");
  w_s(&mut out, "static inline void bst_mmu_settle_on(uint64_t t);   /* defined per target */\n");
  w_s(&mut out, "static inline uint64_t bst_pt_lease_count(bst_pt *t) {\n");
  w_s(&mut out, "    bst_mmu_settle_on(*t);\n");
  w_s(&mut out, "    return __atomic_load_n(&bst_pt_leases[bst_frame_id(*t)], __ATOMIC_ACQUIRE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_pt_take(bst_pt *t, uint64_t i) {\n");
  w_s(&mut out, "    uint64_t *e = &((uint64_t *)*t)[i];\n");
  w_s(&mut out, "    uint64_t a = *e & BST_PTE_ADDR;\n");
  w_s(&mut out, "    *e = 0;\n");
  w_s(&mut out, "    __atomic_fetch_add(&bst_pt_gen, 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    return a;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define bst_pt_take_frame bst_pt_take\n");
  w_s(&mut out, "/* Shared pages: how many references (Shared values and pt_dup_shared's\n");
  w_s(&mut out, " * reads) each page has, by page number, and a PTE bit the CPU ignores that\n");
  w_s(&mut out, " * marks a slot mapping one. The last shared_drop gives the page back. */\n");
  w_s(&mut out, "#define BST_PTE_SHARED 0x200ull\n");
  w_s(&mut out, "static inline bst_frame bst_shared_new(bst_frame f) { __atomic_store_n(&bst_shared_refs[bst_frame_id(f)], 1, __ATOMIC_RELEASE); return f; }\n");
  w_s(&mut out, "static inline bst_frame bst_shared_dup(bst_frame s) { __atomic_fetch_add(&bst_shared_refs[bst_frame_id(s)], 1, __ATOMIC_RELAXED); return s; }\n");
  w_s(&mut out, "static inline uint64_t bst_shared_drop(bst_pool *p, bst_frame s) {\n");
  w_s(&mut out, "    uint64_t i = bst_frame_id(s);\n");
  w_s(&mut out, "    (void)p;\n");
  w_s(&mut out, "    return __atomic_sub_fetch(&bst_shared_refs[i], 1, __ATOMIC_ACQ_REL) == 0 ? i : ~0ull;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_shared_id(bst_frame s) { return bst_frame_id(s); }\n");
  w_s(&mut out, "static inline bool bst_pt_shared(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_SHARED) != 0; }\n");
  w_s(&mut out, "static inline void bst_pt_put_shared(bst_pt *t, uint64_t i, bst_frame s, bool w) {\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], s | BST_PTE_P | BST_PTE_U | BST_PTE_SHARED | (w ? BST_PTE_W | BST_PTE_NX : 0), __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define bst_pt_take_shared bst_pt_take\n");
  w_s(&mut out, "static inline bst_frame bst_pt_dup_shared(bst_pt t, uint64_t i) { return bst_shared_dup(((uint64_t *)t)[i] & BST_PTE_ADDR); }\n");
  w_s(&mut out, "/* Dirty pages: taken without zeroing, so whoever takes them (under a lock,\n");
  w_s(&mut out, " * say) does not pay for it; they become frames only by being overwritten\n");
  w_s(&mut out, " * whole, which can happen later and elsewhere. */\n");
  w_s(&mut out, "static inline bst_frame bst_pool_take_dirty(bst_pool *p, uint64_t i) { (void)p; return bst_page_at(i); }\n");
  w_s(&mut out, "static inline uint64_t bst_dirty_id(bst_frame d) { return bst_frame_id(d); }\n");
  w_s(&mut out, "static inline bst_frame bst_dirty_zero(bst_frame d) { bst_zero_page(d); return d; }\n");
  w_s(&mut out, "static inline bst_frame bst_frame_copy(bst_frame d, bst_frame src) { bst_copy_fwd((unsigned char *)d, (const unsigned char *)src, 4096); return d; }\n");
  w_s(&mut out, "#define bst_shared_copy bst_frame_copy\n");
  w_s(&mut out, "static inline bst_frame bst_dirty_fill(bst_frame d, bst_bytes src, uint64_t s) { bst_copy_fwd((unsigned char *)d, src.data + s, 4096); return d; }\n");
}

fn cg_prelude_kernel(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline void bst_outb(uint16_t port, uint8_t v) { __asm__ volatile (\"outb %0, %1\" : : \"a\"(v), \"Nd\"(port)); }\n");
  w_s(&mut out, "static inline uint8_t bst_inb(uint16_t port) { uint8_t v; __asm__ volatile (\"inb %1, %0\" : \"=a\"(v) : \"Nd\"(port)); return v; }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "#define BST_COM1 0x3F8\n");
  w_s(&mut out, "static void bst_serial_init(void) {\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 1, 0x00);   /* interrupts off while configuring */\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 3, 0x80);   /* DLAB on */\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 0, 0x01);   /* 115200 baud */\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 1, 0x00);\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 3, 0x03);   /* 8N1 */\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 2, 0xC7);   /* FIFO on */\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 4, 0x0B);   /* DTR, RTS, OUT2 (routes the IRQ line) */\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 1, 0x01);   /* interrupt on received data */\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    while ((bst_inb(BST_COM1 + 5) & 0x20) == 0) { }\n");
  w_s(&mut out, "    bst_outb(BST_COM1, (uint8_t)b);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    while ((bst_inb(BST_COM1 + 5) & 0x01) == 0) { __asm__ volatile (\"pause\"); }\n");
  w_s(&mut out, "    return bst_inb(BST_COM1);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_serial_poll(bst_serial s) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    return (bst_inb(BST_COM1 + 5) & 0x01) ? bst_inb(BST_COM1) : 256;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "static void bst_halt(void) { for (;;) __asm__ volatile (\"cli; hlt\"); }\n");
  w_s(&mut out, "static void bst_puts(const char *m) { for (; *m; m++) bst_serial_write(0, (unsigned char)*m); }\n");
  w_s(&mut out, "static void bst_puthex(uint64_t v) {\n");
  w_s(&mut out, "    bst_puts(\"0x\");\n");
  w_s(&mut out, "    for (int i = 60; i >= 0; i -= 4) bst_serial_write(0, (unsigned char)\"0123456789abcdef\"[(v >> i) & 15]);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Memory for Buf: a fixed arena with an exact-size free list, then the\n");
  w_s(&mut out, " * extension bst_pool_init carves from RAM (an eighth of the pool, at least 4 MiB), so\n");
  w_s(&mut out, " * the kernel's own tables can grow with the machine. */\n");
  w_s(&mut out, "#define BST_ARENA_WORDS (1u << 20)   /* 8 MiB */\n");
  w_s(&mut out, "static uint64_t bst_arena[BST_ARENA_WORDS];\n");
  w_s(&mut out, "static uint64_t bst_arena_top = 0;\n");
  w_s(&mut out, "static uint64_t *bst_arena2, bst_arena2_words, bst_arena2_top;\n");
  w_s(&mut out, "typedef struct bst_free { uint64_t words; struct bst_free *next; } bst_free_t;\n");
  w_s(&mut out, "static bst_free_t *bst_free_list = 0;           /* blocks of BST_BINS words or more */\n");
  w_s(&mut out, "#define BST_BINS 1024\n");
  w_s(&mut out, "static bst_free_t *bst_bin[BST_BINS];        /* exact-size free lists: pop in O(1) */\n");
  w_s(&mut out, "static uint64_t bst_arena_lock;              /* every processor allocates from the one arena */\n");
  w_s(&mut out, "/* An empty buffer with no memory when the arena is full. */\n");
  w_s(&mut out, "static bst_buf bst_try_alloc(uint64_t n) {\n");
  w_s(&mut out, "    uint64_t words = (n ? n : 1) + 1;            /* one header word for the size */\n");
  w_s(&mut out, "    if (words < 2) words = 2;\n");
  w_s(&mut out, "    uint64_t *blk = 0;\n");
  w_s(&mut out, "    bst_lock_acquire(&bst_arena_lock);\n");
  w_s(&mut out, "    if (words < BST_BINS) {\n");
  w_s(&mut out, "        bst_free_t *f = bst_bin[words];\n");
  w_s(&mut out, "        if (f) {\n");
  w_s(&mut out, "            bst_bin[words] = f->next;\n");
  w_s(&mut out, "            blk = (uint64_t *)f;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    } else {\n");
  w_s(&mut out, "        bst_free_t **pp = &bst_free_list;\n");
  w_s(&mut out, "        for (bst_free_t *f = bst_free_list; f; pp = &f->next, f = f->next) {\n");
  w_s(&mut out, "            if (f->words == words) {\n");
  w_s(&mut out, "                *pp = f->next;\n");
  w_s(&mut out, "                blk = (uint64_t *)f;\n");
  w_s(&mut out, "                break;\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (!blk && bst_arena_top + words <= BST_ARENA_WORDS) {\n");
  w_s(&mut out, "        blk = &bst_arena[bst_arena_top];\n");
  w_s(&mut out, "        bst_arena_top += words;\n");
  w_s(&mut out, "        blk[0] = words;\n");
  w_s(&mut out, "    } else if (!blk && words <= bst_arena2_words - bst_arena2_top) {\n");
  w_s(&mut out, "        blk = &bst_arena2[bst_arena2_top];\n");
  w_s(&mut out, "        bst_arena2_top += words;\n");
  w_s(&mut out, "        blk[0] = words;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_lock_release(&bst_arena_lock);\n");
  w_s(&mut out, "    if (!blk) { bst_buf none = { 0, 0 }; return none; }\n");
  w_s(&mut out, "    uint64_t *z = blk + 1, zc = words - 1;       /* rep stosq: one string store, not a word at a time */\n");
  w_s(&mut out, "    __asm__ volatile (\"rep stosq\" : \"+D\"(z), \"+c\"(zc) : \"a\"(0) : \"memory\");\n");
  w_s(&mut out, "    bst_buf b = { n, blk + 1 };\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf b = bst_try_alloc(n);\n");
  w_s(&mut out, "    if (!b.data) { bst_puts(\"bastio: out of memory\\n\"); bst_halt(); }\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_free(bst_buf b) {\n");
  w_s(&mut out, "    if (!b.data) return;\n");
  w_s(&mut out, "    uint64_t *blk = b.data - 1;\n");
  w_s(&mut out, "    bst_free_t *f = (bst_free_t *)blk;\n");
  w_s(&mut out, "    bst_lock_acquire(&bst_arena_lock);\n");
  w_s(&mut out, "    f->words = blk[0];\n");
  w_s(&mut out, "    if (f->words < BST_BINS) {\n");
  w_s(&mut out, "        f->next = bst_bin[f->words];\n");
  w_s(&mut out, "        bst_bin[f->words] = f;\n");
  w_s(&mut out, "    } else {\n");
  w_s(&mut out, "        f->next = bst_free_list;\n");
  w_s(&mut out, "        bst_free_list = f;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_lock_release(&bst_arena_lock);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_print(uint64_t v) {\n");
  w_s(&mut out, "    char d[20]; int n = 0;\n");
  w_s(&mut out, "    do { d[n++] = (char)('0' + v % 10); v /= 10; } while (v);\n");
  w_s(&mut out, "    while (n) bst_serial_write(0, (unsigned char)d[--n]);\n");
  w_s(&mut out, "    bst_serial_write(0, '\\n');\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Physical pages: every available run of RAM in the Multiboot memory map\n");
  w_s(&mut out, " * (flags bit 6; without one, mem_upper's, bit 0) from the end of the kernel\n");
  w_s(&mut out, " * image up to bst_ram_limit, where the platform's identity map of RAM stops\n");
  w_s(&mut out, " * (1 GiB, the least the boot code maps, if the platform does not define\n");
  w_s(&mut out, " * it), at most 2^27 pages (512 GiB: the kernel's first top-level slot).\n");
  w_s(&mut out, " * Where the linker script names the image's start (_image_start), the runs\n");
  w_s(&mut out, " * from 1 MiB up to it are in the pool as well. The pages the information,\n");
  w_s(&mut out, " * the map and the command line sit in are left out of every run.\n");
  w_s(&mut out, " * Runs that touch are merged; past BST_RUNS the rest are left out. Page ids\n");
  w_s(&mut out, " * are dense over the runs (bst_page_at, bst_frame_id), so holes such as the\n");
  w_s(&mut out, " * PCI one below 4 GiB have none. A map outside the first 1 GiB is not read.\n");
  w_s(&mut out, " * The front of the run that holds them is carved off for the pool's\n");
  w_s(&mut out, " * bookkeeping: two 32-bit counters a page (leases, shared references) and\n");
  w_s(&mut out, " * the arena's extension of an eighth of the pool (at least 4 MiB). */\n");
  w_s(&mut out, "extern char _end[];\n");
  w_s(&mut out, "/* Where the image starts, if the linker script says: the runs of RAM from\n");
  w_s(&mut out, " * 1 MiB up to it join the pool, since nothing else uses them. */\n");
  w_s(&mut out, "extern char _image_start[] __attribute__((weak));\n");
  w_s(&mut out, "extern uint64_t bst_kernel_pml4[512];\n");
  w_s(&mut out, "extern uint64_t bst_ram_limit __attribute__((weak));\n");
  w_s(&mut out, "#define BST_RUNS 32\n");
  w_s(&mut out, "#define BST_FRAME_LIMIT (1ull << 27)\n");
  w_s(&mut out, "static uint64_t bst_run_at[BST_RUNS], bst_run_id[BST_RUNS + 1], bst_runs;\n");
  w_s(&mut out, "static uint32_t *bst_pt_leases, *bst_shared_refs;\n");
  w_s(&mut out, "static uint64_t bst_carved_lo, bst_carved_hi;\n");
  w_s(&mut out, "static uint64_t bst_mbi;\n");
  w_s(&mut out, "/* Adds [a, b) to the n sorted runs lo/hi, merging the ones it touches. */\n");
  w_s(&mut out, "static uint64_t bst_run_put(uint64_t *lo, uint64_t *hi, uint64_t n, uint64_t a, uint64_t b) {\n");
  w_s(&mut out, "    uint64_t m = 0;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        if (hi[k] < a || b < lo[k]) { lo[m] = lo[k]; hi[m] = hi[k]; m++; }\n");
  w_s(&mut out, "        else { if (lo[k] < a) a = lo[k]; if (hi[k] > b) b = hi[k]; }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (m == BST_RUNS) return m;\n");
  w_s(&mut out, "    uint64_t k = m;\n");
  w_s(&mut out, "    while (k > 0 && lo[k - 1] > a) { lo[k] = lo[k - 1]; hi[k] = hi[k - 1]; k--; }\n");
  w_s(&mut out, "    lo[k] = a; hi[k] = b;\n");
  w_s(&mut out, "    return m + 1;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Takes [a, b) (to whole pages) out of the n runs lo/hi, splitting one if the\n");
  w_s(&mut out, " * hole is inside it (the lower part only, when the table is full). */\n");
  w_s(&mut out, "static uint64_t bst_run_cut(uint64_t *lo, uint64_t *hi, uint64_t n, uint64_t a, uint64_t b) {\n");
  w_s(&mut out, "    a &= ~4095ull;\n");
  w_s(&mut out, "    b = (b + 4095) & ~4095ull;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        if (b <= lo[k] || hi[k] <= a) continue;\n");
  w_s(&mut out, "        if (a <= lo[k] && hi[k] <= b) {\n");
  w_s(&mut out, "            for (uint64_t j = k + 1; j < n; j++) { lo[j - 1] = lo[j]; hi[j - 1] = hi[j]; }\n");
  w_s(&mut out, "            n--;\n");
  w_s(&mut out, "            k--;\n");
  w_s(&mut out, "        } else if (a <= lo[k]) {\n");
  w_s(&mut out, "            lo[k] = b;\n");
  w_s(&mut out, "        } else if (b >= hi[k]) {\n");
  w_s(&mut out, "            hi[k] = a;\n");
  w_s(&mut out, "        } else {\n");
  w_s(&mut out, "            if (n < BST_RUNS) {\n");
  w_s(&mut out, "                for (uint64_t j = n; j > k + 1; j--) { lo[j] = lo[j - 1]; hi[j] = hi[j - 1]; }\n");
  w_s(&mut out, "                lo[k + 1] = b;\n");
  w_s(&mut out, "                hi[k + 1] = hi[k];\n");
  w_s(&mut out, "                n++;\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            hi[k] = a;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return n;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_pool bst_pool_init(uint64_t mbi) {\n");
  w_s(&mut out, "    uint32_t *info = (uint32_t *)mbi;\n");
  w_s(&mut out, "    uint64_t base = ((uint64_t)_end + 4095) & ~4095ull;\n");
  w_s(&mut out, "    uint64_t limit = &bst_ram_limit ? bst_ram_limit : (1ull << 30);\n");
  w_s(&mut out, "    if (limit > (1ull << 39)) limit = 1ull << 39;\n");
  w_s(&mut out, "    uint64_t lo[BST_RUNS], hi[BST_RUNS], n = 0;\n");
  w_s(&mut out, "    if (info && (info[0] & 64) && (uint64_t)info[12] + info[11] <= (1ull << 30)) {\n");
  w_s(&mut out, "        uint8_t *e = (uint8_t *)(uint64_t)info[12], *stop = e + info[11];\n");
  w_s(&mut out, "        while (e + 24 <= stop && *(uint32_t *)e >= 20) {\n");
  w_s(&mut out, "            uint64_t a = *(uint64_t *)(e + 4), len = *(uint64_t *)(e + 12), b = a + len;\n");
  w_s(&mut out, "            if (b < a) b = ~0ull;\n");
  w_s(&mut out, "            if (b > limit) b = limit;\n");
  w_s(&mut out, "            if (&_image_start && *(uint32_t *)(e + 20) == 1 && a < (uint64_t)_image_start) {\n");
  w_s(&mut out, "                /* Below the image: from 1 MiB (the first holds the BIOS data and the\n");
  w_s(&mut out, "                 * processors' start-up code) to the image. */\n");
  w_s(&mut out, "                uint64_t la = a < (1ull << 20) ? (1ull << 20) : a, lb = b < (uint64_t)_image_start ? b : (uint64_t)_image_start;\n");
  w_s(&mut out, "                la = (la + 4095) & ~4095ull;\n");
  w_s(&mut out, "                lb &= ~4095ull;\n");
  w_s(&mut out, "                if (la < lb) n = bst_run_put(lo, hi, n, la, lb);\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            if (a < base) a = base;\n");
  w_s(&mut out, "            if (*(uint32_t *)(e + 20) == 1 && a < b) {\n");
  w_s(&mut out, "                a = (a + 4095) & ~4095ull;\n");
  w_s(&mut out, "                b &= ~4095ull;\n");
  w_s(&mut out, "                if (a < b) n = bst_run_put(lo, hi, n, a, b);\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            e += (uint64_t)*(uint32_t *)e + 4;    /* not in 32 bits: 0xFFFFFFFC + 4 would stay put */\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        /* What the loader left in RAM and the kernel reads later: the information,\n");
  w_s(&mut out, "         * the map and the command line. */\n");
  w_s(&mut out, "        n = bst_run_cut(lo, hi, n, mbi, mbi + 128);\n");
  w_s(&mut out, "        n = bst_run_cut(lo, hi, n, info[12], (uint64_t)info[12] + info[11]);\n");
  w_s(&mut out, "        if ((info[0] & 4) && info[4] && info[4] < (1ull << 30)) {\n");
  w_s(&mut out, "            uint64_t cl = 0;\n");
  w_s(&mut out, "            while (cl < 4096 && ((uint8_t *)(uint64_t)info[4])[cl]) cl++;\n");
  w_s(&mut out, "            n = bst_run_cut(lo, hi, n, info[4], (uint64_t)info[4] + cl + 1);\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    } else {\n");
  w_s(&mut out, "        uint64_t b = 64ull << 20;\n");
  w_s(&mut out, "        if (info && (info[0] & 1)) b = (1ull << 20) + ((uint64_t)info[2] << 10);\n");
  w_s(&mut out, "        if (b > limit) b = limit;\n");
  w_s(&mut out, "        b &= ~4095ull;\n");
  w_s(&mut out, "        if (base < b) n = bst_run_put(lo, hi, n, base, b);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    /* At most 2^27 pages: the top runs go first. */\n");
  w_s(&mut out, "    uint64_t pages = 0;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        if (pages + (hi[k] - lo[k]) / 4096 > BST_FRAME_LIMIT) hi[k] = lo[k] + (BST_FRAME_LIMIT - pages) * 4096;\n");
  w_s(&mut out, "        pages += (hi[k] - lo[k]) / 4096;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    /* The bookkeeping, from the first run with room (the arena extension\n");
  w_s(&mut out, "     * only if there is room for it too). */\n");
  w_s(&mut out, "    uint64_t counters = (pages * 8 + 4095) / 4096, ext = pages / 8, r = n;\n");
  w_s(&mut out, "    if (pages >= 8192 && ext < 1536) ext = 1536;   /* from 32 MiB of pages: at least 6 MiB */\n");
  w_s(&mut out, "    for (int tries = 0; tries < 2 && r == n; tries++) {\n");
  w_s(&mut out, "        if (tries) ext = 0;\n");
  w_s(&mut out, "        for (r = 0; r < n && (hi[r] - lo[r]) / 4096 <= counters + ext; r++) {}\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_pool p;\n");
  w_s(&mut out, "    p.base = base;\n");
  w_s(&mut out, "    p.size = 0;\n");
  w_s(&mut out, "    if (r == n) return p;          /* no room even for the counters: no pages */\n");
  w_s(&mut out, "    uint64_t *w = (uint64_t *)lo[r];\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < counters * 512; k++) w[k] = 0;\n");
  w_s(&mut out, "    bst_pt_leases = (uint32_t *)lo[r];\n");
  w_s(&mut out, "    bst_shared_refs = (uint32_t *)lo[r] + pages;\n");
  w_s(&mut out, "    bst_arena2 = (uint64_t *)(lo[r] + counters * 4096);\n");
  w_s(&mut out, "    bst_arena2_words = ext * 512;\n");
  w_s(&mut out, "    bst_carved_lo = lo[r];\n");
  w_s(&mut out, "    bst_carved_hi = lo[r] + (counters + ext) * 4096;\n");
  w_s(&mut out, "    lo[r] = bst_carved_hi;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        bst_run_at[k] = lo[k];\n");
  w_s(&mut out, "        bst_run_id[k + 1] = bst_run_id[k] + (hi[k] - lo[k]) / 4096;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_runs = n;\n");
  w_s(&mut out, "    p.base = lo[0];\n");
  w_s(&mut out, "    p.size = bst_run_id[n];\n");
  w_s(&mut out, "    return p;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The device window overlaps RAM above 2 GiB: claiming pool RAM (or the\n");
  w_s(&mut out, " * pool's bookkeeping) as registers would alias pages the proofs hand out,\n");
  w_s(&mut out, " * so such a claim stops the machine. Firmware never puts a device there. */\n");
  w_s(&mut out, "static void bst_mmio_check(uint64_t b, uint64_t l) {\n");
  w_s(&mut out, "    int bad = l && b < bst_carved_hi && bst_carved_lo < b + l;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < bst_runs; k++) {\n");
  w_s(&mut out, "        uint64_t lo = bst_run_at[k], hi = lo + (bst_run_id[k + 1] - bst_run_id[k]) * 4096;\n");
  w_s(&mut out, "        if (l && b < hi && lo < b + l) bad = 1;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (bad) { bst_puts(\"bastio: mmio_claim of RAM at \"); bst_puthex(b); bst_puts(\"\\n\"); bst_halt(); }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define BST_MMIO_CHECK(b, l) bst_mmio_check(b, l)\n");
  w_s(&mut out, "#define BST_PT_NEW_HOOK if (level == 4) e[0] = ((uint64_t)bst_kernel_pml4[0] & BST_PTE_ADDR) | BST_PTE_P | BST_PTE_W;\n");
}

fn cg_prelude_bytes_arena(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static bst_bytes bst_balloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf w = bst_alloc((n + 7) / 8);\n");
  w_s(&mut out, "    bst_bytes b = { n, (unsigned char *)w.data };\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_bytes bst_try_balloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf w = bst_try_alloc((n + 7) / 8);\n");
  w_s(&mut out, "    bst_bytes b = { w.data ? n : 0, (unsigned char *)w.data };\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_bfree(bst_bytes b) {\n");
  w_s(&mut out, "    bst_buf w = { (b.len + 7) / 8, (uint64_t *)b.data };\n");
  w_s(&mut out, "    bst_free(w);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Grow a block of `old` words to `n` words, keeping its contents. */\n");
  w_s(&mut out, "static uint64_t *bst_copy_over(uint64_t *q, uint64_t *p, uint64_t old) {\n");
  w_s(&mut out, "    if (q && p) {\n");
  w_s(&mut out, "        for (uint64_t i = 0; i < old; i++) q[i] = p[i];\n");
  w_s(&mut out, "        bst_buf b = { old, p };\n");
  w_s(&mut out, "        bst_free(b);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return q;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t *bst_regrow(uint64_t *p, uint64_t old, uint64_t n) {\n");
  w_s(&mut out, "    return bst_copy_over(bst_alloc(n).data, p, old);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t *bst_try_regrow(uint64_t *p, uint64_t old, uint64_t n) {\n");
  w_s(&mut out, "    return bst_copy_over(bst_try_alloc(n).data, p, old);\n");
  w_s(&mut out, "}\n");
}

fn cg_prelude_child(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "#include <unistd.h>\n");
  w_s(&mut out, "#include <fcntl.h>\n");
  w_s(&mut out, "#include <signal.h>\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "#define WIN32_LEAN_AND_MEAN\n");
  w_s(&mut out, "#include <windows.h>\n");
  w_s(&mut out, "#include <io.h>\n");
  w_s(&mut out, "#include <process.h>\n");
  w_s(&mut out, "/* The parent's ends of the pipes are not inherited (_O_NOINHERIT), so closing\n");
  w_s(&mut out, " * a child's input reaches it as end of file. */\n");
  w_s(&mut out, "#define pipe(p) _pipe((p), 65536, _O_BINARY | _O_NOINHERIT)\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "#include <sys/wait.h>\n");
  w_s(&mut out, "#include <spawn.h>\n");
  w_s(&mut out, "extern char **environ;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "typedef struct { intptr_t pid; int in; FILE *out; } bst_child;\n");
  w_s(&mut out, "/* A child that cannot be started (no such program, no pipes or processes\n");
  w_s(&mut out, " * left) behaves like one that exited with 127 without output, which is\n");
  w_s(&mut out, " * what a failed exec in the child looks like anyway. */\n");
  w_s(&mut out, "static bst_child bst_host_spawn(bst_host h, bst_vec argv) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    bst_child c = { -1, -1, NULL };\n");
  w_s(&mut out, "    int to[2], from[2];\n");
  w_s(&mut out, "    if (argv.len == 0 || pipe(to) != 0) return c;\n");
  w_s(&mut out, "    if (pipe(from) != 0) { close(to[0]); close(to[1]); return c; }\n");
  w_s(&mut out, "#ifndef _WIN32\n");
  w_s(&mut out, "    /* The parent's ends are not inherited by later children, so closing a\n");
  w_s(&mut out, "     * child's input reaches it as end of file. */\n");
  w_s(&mut out, "    fcntl(to[1], F_SETFD, FD_CLOEXEC);\n");
  w_s(&mut out, "    fcntl(from[0], F_SETFD, FD_CLOEXEC);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    char **av = (char **)malloc((argv.len + 1) * sizeof(char *));\n");
  w_s(&mut out, "    if (!av) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    for (uint64_t i = 0; i < argv.len; i++) av[i] = bst_cpath(((bst_bytes *)argv.data)[i]);\n");
  w_s(&mut out, "    av[argv.len] = NULL;\n");
  w_s(&mut out, "    fflush(NULL);\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    /* CreateProcess with the child's ends as its standard handles, made\n");
  w_s(&mut out, "     * inheritable only while it starts. */\n");
  w_s(&mut out, "    intptr_t pid = -1;\n");
  w_s(&mut out, "    {\n");
  w_s(&mut out, "        size_t cap = 1;\n");
  w_s(&mut out, "        for (uint64_t i = 0; i < argv.len; i++) cap += 2 * strlen(av[i]) + 3;\n");
  w_s(&mut out, "        char *cl = (char *)malloc(cap), *w = cl;\n");
  w_s(&mut out, "        if (!cl) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        for (uint64_t i = 0; i < argv.len; i++) {\n");
  w_s(&mut out, "            const char *a = av[i];\n");
  w_s(&mut out, "            int q = !*a || strpbrk(a, \" \\t\\\"\") != NULL;\n");
  w_s(&mut out, "            if (i) *w++ = ' ';\n");
  w_s(&mut out, "            if (q) *w++ = '\"';\n");
  w_s(&mut out, "            size_t b = 0;\n");
  w_s(&mut out, "            for (; *a; a++) {\n");
  w_s(&mut out, "                if (*a == '\\\\') { b++; continue; }\n");
  w_s(&mut out, "                if (*a == '\"') b = 2 * b + 1;\n");
  w_s(&mut out, "                for (; b; b--) *w++ = '\\\\';\n");
  w_s(&mut out, "                *w++ = *a;\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            for (b = q ? 2 * b : b; b; b--) *w++ = '\\\\';\n");
  w_s(&mut out, "            if (q) *w++ = '\"';\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        *w = 0;\n");
  w_s(&mut out, "        HANDLE hin = (HANDLE)_get_osfhandle(to[0]), hout = (HANDLE)_get_osfhandle(from[1]);\n");
  w_s(&mut out, "        SetHandleInformation(hin, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT);\n");
  w_s(&mut out, "        SetHandleInformation(hout, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT);\n");
  w_s(&mut out, "        STARTUPINFOA si;\n");
  w_s(&mut out, "        PROCESS_INFORMATION pi;\n");
  w_s(&mut out, "        memset(&si, 0, sizeof si);\n");
  w_s(&mut out, "        si.cb = sizeof si;\n");
  w_s(&mut out, "        si.dwFlags = STARTF_USESTDHANDLES;\n");
  w_s(&mut out, "        si.hStdInput = hin;\n");
  w_s(&mut out, "        si.hStdOutput = hout;\n");
  w_s(&mut out, "        si.hStdError = GetStdHandle(STD_ERROR_HANDLE);\n");
  w_s(&mut out, "        if (CreateProcessA(NULL, cl, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) {\n");
  w_s(&mut out, "            CloseHandle(pi.hThread);\n");
  w_s(&mut out, "            pid = (intptr_t)pi.hProcess;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        SetHandleInformation(hin, HANDLE_FLAG_INHERIT, 0);\n");
  w_s(&mut out, "        SetHandleInformation(hout, HANDLE_FLAG_INHERIT, 0);\n");
  w_s(&mut out, "        free(cl);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    /* posix_spawn, not fork: the parent's memory is never copied, which a\n");
  w_s(&mut out, "     * kernel without copy-on-write (BastiOS) cannot do for a large one.\n");
  w_s(&mut out, "     * The parent's ends are close-on-exec already. */\n");
  w_s(&mut out, "    int pid = -1;\n");
  w_s(&mut out, "    posix_spawn_file_actions_t fa;\n");
  w_s(&mut out, "    if (posix_spawn_file_actions_init(&fa) == 0) {\n");
  w_s(&mut out, "        if (posix_spawn_file_actions_adddup2(&fa, to[0], 0) != 0 ||\n");
  w_s(&mut out, "            posix_spawn_file_actions_adddup2(&fa, from[1], 1) != 0 ||\n");
  w_s(&mut out, "            posix_spawn_file_actions_addclose(&fa, to[0]) != 0 ||\n");
  w_s(&mut out, "            posix_spawn_file_actions_addclose(&fa, from[1]) != 0 ||\n");
  w_s(&mut out, "            posix_spawnp(&pid, av[0], &fa, NULL, av, environ) != 0) pid = -1;\n");
  w_s(&mut out, "        posix_spawn_file_actions_destroy(&fa);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    for (uint64_t i = 0; i < argv.len; i++) free(av[i]);\n");
  w_s(&mut out, "    free(av);\n");
  w_s(&mut out, "    close(to[0]);\n");
  w_s(&mut out, "    close(from[1]);\n");
  w_s(&mut out, "    if (pid < 0) { close(to[1]); close(from[0]); return c; }\n");
  w_s(&mut out, "#ifdef SIGPIPE\n");
  w_s(&mut out, "    signal(SIGPIPE, SIG_IGN);   /* writing to a child that has exited fails instead */\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    c.pid = pid;\n");
  w_s(&mut out, "    c.in = to[1];\n");
  w_s(&mut out, "    c.out = fdopen(from[0], \"rb\");\n");
  w_s(&mut out, "    if (!c.out) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    return c;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bool bst_child_write(bst_child *c, bst_bytes d) {\n");
  w_s(&mut out, "    if (c->in < 0) return false;\n");
  w_s(&mut out, "    uint64_t n = 0;\n");
  w_s(&mut out, "    while (n < d.len) {\n");
  w_s(&mut out, "        ssize_t w = write(c->in, d.data + n, d.len - n);\n");
  w_s(&mut out, "        if (w <= 0) return false;\n");
  w_s(&mut out, "        n += (uint64_t)w;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return true;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_child_close(bst_child *c) {\n");
  w_s(&mut out, "    if (c->in >= 0) { close(c->in); c->in = -1; }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bool bst_child_read_line(bst_child *c, bst_bytes *out) {\n");
  w_s(&mut out, "    if (!c->out) return false;\n");
  w_s(&mut out, "    size_t cap = 64, n = 0;\n");
  w_s(&mut out, "    unsigned char *d = (unsigned char *)malloc(cap);\n");
  w_s(&mut out, "    if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    int ch;\n");
  w_s(&mut out, "    while ((ch = getc(c->out)) != EOF && ch != '\\n') {\n");
  w_s(&mut out, "        if (n == cap) {\n");
  w_s(&mut out, "            cap *= 2;\n");
  w_s(&mut out, "            d = (unsigned char *)realloc(d, cap);\n");
  w_s(&mut out, "            if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        d[n++] = (unsigned char)ch;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (ch == EOF && n == 0) { free(d); return false; }\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    if (n && d[n - 1] == '\\r') n--;   /* Windows tools end their lines with CRLF */\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    free(out->data);\n");
  w_s(&mut out, "    out->len = n;\n");
  w_s(&mut out, "    out->data = d;\n");
  w_s(&mut out, "    return true;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_child_wait(bst_child c) {\n");
  w_s(&mut out, "    bst_child_close(&c);\n");
  w_s(&mut out, "    if (c.out) fclose(c.out);\n");
  w_s(&mut out, "    if (c.pid < 0) return 127;\n");
  w_s(&mut out, "    int st;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    if (_cwait(&st, c.pid, 0) < 0) return 255;\n");
  w_s(&mut out, "    return (uint64_t)(unsigned)st;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    while (waitpid((pid_t)c.pid, &st, 0) < 0) {}\n");
  w_s(&mut out, "    if (WIFEXITED(st)) return (uint64_t)WEXITSTATUS(st);\n");
  w_s(&mut out, "    if (WIFSIGNALED(st)) return 128 + (uint64_t)WTERMSIG(st);\n");
  w_s(&mut out, "    return 255;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The environment variable `name`, if it is set. */\n");
  w_s(&mut out, "static bool bst_host_env(bst_host h, bst_str name, bst_bytes *out) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    char *c = bst_cpath((bst_bytes){ name.len, (unsigned char *)name.data });\n");
  w_s(&mut out, "    const char *v = getenv(c);\n");
  w_s(&mut out, "    free(c);\n");
  w_s(&mut out, "    if (!v) return false;\n");
  w_s(&mut out, "    size_t n = strlen(v);\n");
  w_s(&mut out, "    bst_bytes b = bst_balloc(n);\n");
  w_s(&mut out, "    memcpy(b.data, v, n);\n");
  w_s(&mut out, "    free(out->data);\n");
  w_s(&mut out, "    *out = b;\n");
  w_s(&mut out, "    return true;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The number of processors online (at least 1). */\n");
  w_s(&mut out, "#if defined(__APPLE__) && !defined(_SC_NPROCESSORS_ONLN)\n");
  w_s(&mut out, "#define _SC_NPROCESSORS_ONLN 58 /* -std=c11 hides it from <unistd.h> */\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static uint64_t bst_host_cpus(bst_host h) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    const char *e = getenv(\"NUMBER_OF_PROCESSORS\");\n");
  w_s(&mut out, "    long n = e ? atol(e) : 1;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    long n = sysconf(_SC_NPROCESSORS_ONLN);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    return n < 1 ? 1 : (uint64_t)n;\n");
  w_s(&mut out, "}\n");
}

/// The prelude part for `thread_spawn`, `thread_join` and the `sbytes_*`
/// builtins (stage1 only): POSIX threads, and the shared bytes with their
/// waiter lists. Part of the trusted base, as the lock and atomic
/// primitives are.
fn cg_prelude_thread(out: &mut Vec[u64]) {
  w_s(&mut out, "/* Threads and shared bytes (stage1 only). thread_spawn runs a function on a\n");
  w_s(&mut out, " * new POSIX thread; its block (the pthread_t, the result, the arguments)\n");
  w_s(&mut out, " * stays on the heap until thread_join frees it. Every access to shared\n");
  w_s(&mut out, " * bytes is a C11 atomic: sbytes_load, sbytes_store, sbytes_rmw and\n");
  w_s(&mut out, " * sbytes_cas sequentially consistent, sbytes_get, sbytes_set and the bulk\n");
  w_s(&mut out, " * copies relaxed (JavaScript's \"unordered\"), so no access is a data race.\n");
  w_s(&mut out, " * A SharedBytes is a handle: the count of handles, the length, the waiters\n");
  w_s(&mut out, " * of sbytes_wait (a list kept under a mutex) and the bytes. */\n");
  w_s(&mut out, "#include <pthread.h>\n");
  w_s(&mut out, "#include <time.h>\n");
  w_s(&mut out, "#include <errno.h>\n");
  w_s(&mut out, "#ifndef BST_THREAD_STACK\n");
  w_s(&mut out, "#define BST_THREAD_STACK ((size_t)64 << 20)\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static void *bst_thread_block(size_t n) {\n");
  w_s(&mut out, "    void *p = calloc(1, n);\n");
  w_s(&mut out, "    if (!p) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    return p;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_thread_start(pthread_t *t, void *(*f)(void *), void *a) {\n");
  w_s(&mut out, "    pthread_attr_t at;\n");
  w_s(&mut out, "    int e = pthread_attr_init(&at);\n");
  w_s(&mut out, "    if (!e) e = pthread_attr_setstacksize(&at, BST_THREAD_STACK);\n");
  w_s(&mut out, "    if (!e) e = pthread_create(t, &at, f, a);\n");
  w_s(&mut out, "    pthread_attr_destroy(&at);\n");
  w_s(&mut out, "    if (e) { fputs(\"Bastio: cannot start a thread\\n\", stderr); abort(); }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_thread_wait(void *th) {\n");
  w_s(&mut out, "    if (pthread_join(*(pthread_t *)th, 0)) { fputs(\"Bastio: cannot join a thread\\n\", stderr); abort(); }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "struct bst_shw { struct bst_shw *next, *prev; uint64_t at; pthread_cond_t cv; int woken; };\n");
  w_s(&mut out, "struct bst_shb { uint64_t refs, len; pthread_mutex_t mu; struct bst_shw *head, *tail; uint64_t data[]; };\n");
  w_s(&mut out, "static struct bst_shb *bst_sbytes_new(uint64_t n) {\n");
  w_s(&mut out, "    struct bst_shb *b = calloc(1, sizeof(struct bst_shb) + (n + 7) / 8 * 8);\n");
  w_s(&mut out, "    if (!b) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    b->refs = 1;\n");
  w_s(&mut out, "    b->len = n;\n");
  w_s(&mut out, "    pthread_mutex_init(&b->mu, 0);\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_sbytes_len(struct bst_shb *b) { return b->len; }\n");
  w_s(&mut out, "static inline struct bst_shb *bst_sbytes_clone(struct bst_shb *b) {\n");
  w_s(&mut out, "    __atomic_add_fetch(&b->refs, 1, __ATOMIC_RELAXED);\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_sbytes_drop(struct bst_shb *b) {\n");
  w_s(&mut out, "    if (__atomic_sub_fetch(&b->refs, 1, __ATOMIC_ACQ_REL) == 0) {\n");
  w_s(&mut out, "        pthread_mutex_destroy(&b->mu);\n");
  w_s(&mut out, "        free(b);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define BST_SHB_AT(b, i) ((unsigned char *)(b)->data + (i))\n");
  w_s(&mut out, "static inline uint64_t bst_sbytes_ld(struct bst_shb *b, uint64_t i, uint64_t w, int o) {\n");
  w_s(&mut out, "    unsigned char *p = BST_SHB_AT(b, i);\n");
  w_s(&mut out, "    switch (w) {\n");
  w_s(&mut out, "    case 1: return __atomic_load_n((uint8_t *)p, o);\n");
  w_s(&mut out, "    case 2: return __atomic_load_n((uint16_t *)p, o);\n");
  w_s(&mut out, "    case 4: return __atomic_load_n((uint32_t *)p, o);\n");
  w_s(&mut out, "    default: return __atomic_load_n((uint64_t *)p, o);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_sbytes_st(struct bst_shb *b, uint64_t i, uint64_t w, uint64_t v, int o) {\n");
  w_s(&mut out, "    unsigned char *p = BST_SHB_AT(b, i);\n");
  w_s(&mut out, "    switch (w) {\n");
  w_s(&mut out, "    case 1: __atomic_store_n((uint8_t *)p, (uint8_t)v, o); break;\n");
  w_s(&mut out, "    case 2: __atomic_store_n((uint16_t *)p, (uint16_t)v, o); break;\n");
  w_s(&mut out, "    case 4: __atomic_store_n((uint32_t *)p, (uint32_t)v, o); break;\n");
  w_s(&mut out, "    default: __atomic_store_n((uint64_t *)p, v, o); break;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_sbytes_load(struct bst_shb *b, uint64_t i, uint64_t w) { return bst_sbytes_ld(b, i, w, __ATOMIC_SEQ_CST); }\n");
  w_s(&mut out, "static inline void bst_sbytes_store(struct bst_shb *b, uint64_t i, uint64_t w, uint64_t v) { bst_sbytes_st(b, i, w, v, __ATOMIC_SEQ_CST); }\n");
  w_s(&mut out, "static inline uint64_t bst_sbytes_get(struct bst_shb *b, uint64_t i, uint64_t w) { return bst_sbytes_ld(b, i, w, __ATOMIC_RELAXED); }\n");
  w_s(&mut out, "static inline void bst_sbytes_set(struct bst_shb *b, uint64_t i, uint64_t w, uint64_t v) { bst_sbytes_st(b, i, w, v, __ATOMIC_RELAXED); }\n");
  w_s(&mut out, "#define BST_SHB_RMW(T) do { T *q = (T *)p; T x = (T)v; switch (op) { \\\n");
  w_s(&mut out, "    case 0: return __atomic_fetch_add(q, x, __ATOMIC_SEQ_CST); \\\n");
  w_s(&mut out, "    case 1: return __atomic_fetch_sub(q, x, __ATOMIC_SEQ_CST); \\\n");
  w_s(&mut out, "    case 2: return __atomic_fetch_and(q, x, __ATOMIC_SEQ_CST); \\\n");
  w_s(&mut out, "    case 3: return __atomic_fetch_or(q, x, __ATOMIC_SEQ_CST); \\\n");
  w_s(&mut out, "    case 4: return __atomic_fetch_xor(q, x, __ATOMIC_SEQ_CST); \\\n");
  w_s(&mut out, "    default: return __atomic_exchange_n(q, x, __ATOMIC_SEQ_CST); } } while (0)\n");
  w_s(&mut out, "/* op: 0 add, 1 sub, 2 and, 3 or, 4 xor, 5 exchange; wraps at the width. */\n");
  w_s(&mut out, "static uint64_t bst_sbytes_rmw(struct bst_shb *b, uint64_t op, uint64_t i, uint64_t w, uint64_t v) {\n");
  w_s(&mut out, "    unsigned char *p = BST_SHB_AT(b, i);\n");
  w_s(&mut out, "    switch (w) {\n");
  w_s(&mut out, "    case 1: BST_SHB_RMW(uint8_t);\n");
  w_s(&mut out, "    case 2: BST_SHB_RMW(uint16_t);\n");
  w_s(&mut out, "    case 4: BST_SHB_RMW(uint32_t);\n");
  w_s(&mut out, "    default: BST_SHB_RMW(uint64_t);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define BST_SHB_CAS(T) do { T e = (T)x; __atomic_compare_exchange_n((T *)p, &e, (T)v, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); return e; } while (0)\n");
  w_s(&mut out, "/* Writes v if the word is x (both cut to the width); returns the word it found. */\n");
  w_s(&mut out, "static uint64_t bst_sbytes_cas(struct bst_shb *b, uint64_t i, uint64_t w, uint64_t x, uint64_t v) {\n");
  w_s(&mut out, "    unsigned char *p = BST_SHB_AT(b, i);\n");
  w_s(&mut out, "    switch (w) {\n");
  w_s(&mut out, "    case 1: BST_SHB_CAS(uint8_t);\n");
  w_s(&mut out, "    case 2: BST_SHB_CAS(uint16_t);\n");
  w_s(&mut out, "    case 4: BST_SHB_CAS(uint32_t);\n");
  w_s(&mut out, "    default: BST_SHB_CAS(uint64_t);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_sbytes_read(struct bst_shb *b, uint64_t from, bst_bytes *out, uint64_t at, uint64_t n) {\n");
  w_s(&mut out, "    unsigned char *s = BST_SHB_AT(b, from);\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) out->data[at + k] = __atomic_load_n(s + k, __ATOMIC_RELAXED);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_sbytes_write(struct bst_shb *b, uint64_t at, bst_bytes src, uint64_t from, uint64_t n) {\n");
  w_s(&mut out, "    unsigned char *d = BST_SHB_AT(b, at);\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) __atomic_store_n(d + k, src.data[from + k], __ATOMIC_RELAXED);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Atomics.wait: sleeps while the word at i is x, until sbytes_notify wakes\n");
  w_s(&mut out, " * this waiter or timeout nanoseconds pass (2^64 - 1: no timeout). 0: woken,\n");
  w_s(&mut out, " * 1: the word was not x, 2: timed out. The check and the sleep happen under\n");
  w_s(&mut out, " * the mutex sbytes_notify takes, so no notification is lost in between. */\n");
  w_s(&mut out, "static uint64_t bst_sbytes_wait(struct bst_shb *b, uint64_t i, uint64_t w, uint64_t x, uint64_t timeout) {\n");
  w_s(&mut out, "    if (w == 4) x = (uint32_t)x;\n");
  w_s(&mut out, "    struct bst_shw me;\n");
  w_s(&mut out, "    struct timespec dl;\n");
  w_s(&mut out, "    int timed = timeout != ~(uint64_t)0;\n");
  w_s(&mut out, "    pthread_mutex_lock(&b->mu);\n");
  w_s(&mut out, "    if (bst_sbytes_ld(b, i, w, __ATOMIC_SEQ_CST) != x) { pthread_mutex_unlock(&b->mu); return 1; }\n");
  w_s(&mut out, "    me.at = i;\n");
  w_s(&mut out, "    me.woken = 0;\n");
  w_s(&mut out, "    me.next = 0;\n");
  w_s(&mut out, "    me.prev = b->tail;\n");
  w_s(&mut out, "    if (b->tail) b->tail->next = &me; else b->head = &me;\n");
  w_s(&mut out, "    b->tail = &me;\n");
  w_s(&mut out, "#ifdef __APPLE__\n");
  w_s(&mut out, "    pthread_cond_init(&me.cv, 0);\n");
  w_s(&mut out, "    if (timed) clock_gettime(CLOCK_REALTIME, &dl);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    pthread_condattr_t ca;\n");
  w_s(&mut out, "    pthread_condattr_init(&ca);\n");
  w_s(&mut out, "    pthread_condattr_setclock(&ca, CLOCK_MONOTONIC);\n");
  w_s(&mut out, "    pthread_cond_init(&me.cv, &ca);\n");
  w_s(&mut out, "    pthread_condattr_destroy(&ca);\n");
  w_s(&mut out, "    if (timed) clock_gettime(CLOCK_MONOTONIC, &dl);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    if (timed) {\n");
  w_s(&mut out, "        uint64_t s = timeout / 1000000000u, ns = (uint64_t)dl.tv_nsec + timeout % 1000000000u;\n");
  w_s(&mut out, "        if (ns >= 1000000000u) { ns -= 1000000000u; s++; }\n");
  w_s(&mut out, "        if (s > (uint64_t)1 << 40) timed = 0;   /* tens of thousands of years: forever */\n");
  w_s(&mut out, "        else { dl.tv_sec += (time_t)s; dl.tv_nsec = (long)ns; }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    int e = 0;\n");
  w_s(&mut out, "    while (!me.woken && e != ETIMEDOUT) {\n");
  w_s(&mut out, "        if (timed) e = pthread_cond_timedwait(&me.cv, &b->mu, &dl);\n");
  w_s(&mut out, "        else pthread_cond_wait(&me.cv, &b->mu);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    uint64_t r = 0;\n");
  w_s(&mut out, "    if (!me.woken) {\n");
  w_s(&mut out, "        if (me.prev) me.prev->next = me.next; else b->head = me.next;\n");
  w_s(&mut out, "        if (me.next) me.next->prev = me.prev; else b->tail = me.prev;\n");
  w_s(&mut out, "        r = 2;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    pthread_mutex_unlock(&b->mu);\n");
  w_s(&mut out, "    pthread_cond_destroy(&me.cv);\n");
  w_s(&mut out, "    return r;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Atomics.notify: wakes up to count waiters on the word at i, oldest\n");
  w_s(&mut out, " * first, and returns how many it woke. */\n");
  w_s(&mut out, "static uint64_t bst_sbytes_notify(struct bst_shb *b, uint64_t i, uint64_t count) {\n");
  w_s(&mut out, "    uint64_t n = 0;\n");
  w_s(&mut out, "    pthread_mutex_lock(&b->mu);\n");
  w_s(&mut out, "    struct bst_shw *q = b->head;\n");
  w_s(&mut out, "    while (q && n < count) {\n");
  w_s(&mut out, "        struct bst_shw *nx = q->next;\n");
  w_s(&mut out, "        if (q->at == i) {\n");
  w_s(&mut out, "            if (q->prev) q->prev->next = q->next; else b->head = q->next;\n");
  w_s(&mut out, "            if (q->next) q->next->prev = q->prev; else b->tail = q->prev;\n");
  w_s(&mut out, "            q->woken = 1;\n");
  w_s(&mut out, "            pthread_cond_signal(&q->cv);\n");
  w_s(&mut out, "            n++;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        q = nx;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    pthread_mutex_unlock(&b->mu);\n");
  w_s(&mut out, "    return n;\n");
  w_s(&mut out, "}\n");
}

/// The prelude part for `host_spawn_err`, `child_read_err_line` and `child_kill`
/// (stage1 only): added after the child part, and only to a program that calls
/// one of them.
fn cg_prelude_spawn_err(out: &mut Vec[u64]) {
  w_s(&mut out, "/* host_spawn_err and child_read_err_line: a child whose standard error is a\n");
  w_s(&mut out, " * pipe of its own, and child_kill. The pipe's read end lives in a list keyed by\n");
  w_s(&mut out, " * the child's pid, so the bst_child of the always-present part stays as it is. */\n");
  w_s(&mut out, "typedef struct bst_errnode { intptr_t pid; FILE *err; struct bst_errnode *next; } bst_errnode;\n");
  w_s(&mut out, "static bst_errnode *bst_errs;\n");
  w_s(&mut out, "static bst_child bst_host_spawn_err(bst_host h, bst_vec argv) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    bst_child c = { -1, -1, NULL };\n");
  w_s(&mut out, "    int to[2], from[2], ef[2];\n");
  w_s(&mut out, "    if (argv.len == 0 || pipe(to) != 0) return c;\n");
  w_s(&mut out, "    if (pipe(from) != 0) { close(to[0]); close(to[1]); return c; }\n");
  w_s(&mut out, "    if (pipe(ef) != 0) { close(to[0]); close(to[1]); close(from[0]); close(from[1]); return c; }\n");
  w_s(&mut out, "#ifndef _WIN32\n");
  w_s(&mut out, "    fcntl(to[1], F_SETFD, FD_CLOEXEC);\n");
  w_s(&mut out, "    fcntl(from[0], F_SETFD, FD_CLOEXEC);\n");
  w_s(&mut out, "    fcntl(ef[0], F_SETFD, FD_CLOEXEC);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    char **av = (char **)malloc((argv.len + 1) * sizeof(char *));\n");
  w_s(&mut out, "    if (!av) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    for (uint64_t i = 0; i < argv.len; i++) av[i] = bst_cpath(((bst_bytes *)argv.data)[i]);\n");
  w_s(&mut out, "    av[argv.len] = NULL;\n");
  w_s(&mut out, "    fflush(NULL);\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    intptr_t pid = -1;\n");
  w_s(&mut out, "    {\n");
  w_s(&mut out, "        size_t cap = 1;\n");
  w_s(&mut out, "        for (uint64_t i = 0; i < argv.len; i++) cap += 2 * strlen(av[i]) + 3;\n");
  w_s(&mut out, "        char *cl = (char *)malloc(cap), *w = cl;\n");
  w_s(&mut out, "        if (!cl) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        for (uint64_t i = 0; i < argv.len; i++) {\n");
  w_s(&mut out, "            const char *a = av[i];\n");
  w_s(&mut out, "            int q = !*a || strpbrk(a, \" \\t\\\"\") != NULL;\n");
  w_s(&mut out, "            if (i) *w++ = ' ';\n");
  w_s(&mut out, "            if (q) *w++ = '\"';\n");
  w_s(&mut out, "            size_t b = 0;\n");
  w_s(&mut out, "            for (; *a; a++) {\n");
  w_s(&mut out, "                if (*a == '\\\\') { b++; continue; }\n");
  w_s(&mut out, "                if (*a == '\"') b = 2 * b + 1;\n");
  w_s(&mut out, "                for (; b; b--) *w++ = '\\\\';\n");
  w_s(&mut out, "                *w++ = *a;\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            for (b = q ? 2 * b : b; b; b--) *w++ = '\\\\';\n");
  w_s(&mut out, "            if (q) *w++ = '\"';\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        *w = 0;\n");
  w_s(&mut out, "        HANDLE hin = (HANDLE)_get_osfhandle(to[0]), hout = (HANDLE)_get_osfhandle(from[1]), herr = (HANDLE)_get_osfhandle(ef[1]);\n");
  w_s(&mut out, "        SetHandleInformation(hin, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT);\n");
  w_s(&mut out, "        SetHandleInformation(hout, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT);\n");
  w_s(&mut out, "        SetHandleInformation(herr, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT);\n");
  w_s(&mut out, "        STARTUPINFOA si;\n");
  w_s(&mut out, "        PROCESS_INFORMATION pi;\n");
  w_s(&mut out, "        memset(&si, 0, sizeof si);\n");
  w_s(&mut out, "        si.cb = sizeof si;\n");
  w_s(&mut out, "        si.dwFlags = STARTF_USESTDHANDLES;\n");
  w_s(&mut out, "        si.hStdInput = hin;\n");
  w_s(&mut out, "        si.hStdOutput = hout;\n");
  w_s(&mut out, "        si.hStdError = herr;\n");
  w_s(&mut out, "        if (CreateProcessA(NULL, cl, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) {\n");
  w_s(&mut out, "            CloseHandle(pi.hThread);\n");
  w_s(&mut out, "            pid = (intptr_t)pi.hProcess;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        SetHandleInformation(hin, HANDLE_FLAG_INHERIT, 0);\n");
  w_s(&mut out, "        SetHandleInformation(hout, HANDLE_FLAG_INHERIT, 0);\n");
  w_s(&mut out, "        SetHandleInformation(herr, HANDLE_FLAG_INHERIT, 0);\n");
  w_s(&mut out, "        free(cl);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    int pid = -1;\n");
  w_s(&mut out, "    posix_spawn_file_actions_t fa;\n");
  w_s(&mut out, "    if (posix_spawn_file_actions_init(&fa) == 0) {\n");
  w_s(&mut out, "        if (posix_spawn_file_actions_adddup2(&fa, to[0], 0) != 0 ||\n");
  w_s(&mut out, "            posix_spawn_file_actions_adddup2(&fa, from[1], 1) != 0 ||\n");
  w_s(&mut out, "            posix_spawn_file_actions_adddup2(&fa, ef[1], 2) != 0 ||\n");
  w_s(&mut out, "            posix_spawn_file_actions_addclose(&fa, to[0]) != 0 ||\n");
  w_s(&mut out, "            posix_spawn_file_actions_addclose(&fa, from[1]) != 0 ||\n");
  w_s(&mut out, "            posix_spawn_file_actions_addclose(&fa, ef[1]) != 0 ||\n");
  w_s(&mut out, "            posix_spawnp(&pid, av[0], &fa, NULL, av, environ) != 0) pid = -1;\n");
  w_s(&mut out, "        posix_spawn_file_actions_destroy(&fa);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    for (uint64_t i = 0; i < argv.len; i++) free(av[i]);\n");
  w_s(&mut out, "    free(av);\n");
  w_s(&mut out, "    close(to[0]);\n");
  w_s(&mut out, "    close(from[1]);\n");
  w_s(&mut out, "    close(ef[1]);\n");
  w_s(&mut out, "    if (pid < 0) { close(to[1]); close(from[0]); close(ef[0]); return c; }\n");
  w_s(&mut out, "#ifdef SIGPIPE\n");
  w_s(&mut out, "    signal(SIGPIPE, SIG_IGN);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    c.pid = pid;\n");
  w_s(&mut out, "    c.in = to[1];\n");
  w_s(&mut out, "    c.out = fdopen(from[0], \"rb\");\n");
  w_s(&mut out, "    bst_errnode *n = (bst_errnode *)malloc(sizeof *n);\n");
  w_s(&mut out, "    if (!c.out || !n) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    n->pid = pid;\n");
  w_s(&mut out, "    n->err = fdopen(ef[0], \"rb\");\n");
  w_s(&mut out, "    if (!n->err) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    n->next = bst_errs;\n");
  w_s(&mut out, "    bst_errs = n;\n");
  w_s(&mut out, "    return c;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The next line of the child's standard error; false at its end, or for a\n");
  w_s(&mut out, " * child that was not started with host_spawn_err. */\n");
  w_s(&mut out, "static bool bst_child_read_err_line(bst_child *c, bst_bytes *out) {\n");
  w_s(&mut out, "    for (bst_errnode *n = bst_errs; n; n = n->next) {\n");
  w_s(&mut out, "        if (n->pid == c->pid && c->pid >= 0) {\n");
  w_s(&mut out, "            bst_child t = *c;\n");
  w_s(&mut out, "            t.out = n->err;\n");
  w_s(&mut out, "            return bst_child_read_line(&t, out);\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return false;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Sends signal `sig` to the child (Windows: any signal but 0 ends it; 0 asks\n");
  w_s(&mut out, " * whether it still runs). False if that failed, for instance because the child\n");
  w_s(&mut out, " * could not be started. */\n");
  w_s(&mut out, "static bool bst_child_kill(bst_child c, uint64_t sig) {\n");
  w_s(&mut out, "    if (c.pid < 0) return false;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    if (sig == 0) {\n");
  w_s(&mut out, "        DWORD code;\n");
  w_s(&mut out, "        return GetExitCodeProcess((HANDLE)c.pid, &code) && code == STILL_ACTIVE;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return TerminateProcess((HANDLE)c.pid, 1) != 0;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    return kill((pid_t)c.pid, (int)sig) == 0;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* child_wait also closes the standard error pipe of a child that has one. */\n");
  w_s(&mut out, "static uint64_t bst_child_wait_err(bst_child c) {\n");
  w_s(&mut out, "    for (bst_errnode **p = &bst_errs; *p; p = &(*p)->next) {\n");
  w_s(&mut out, "        if ((*p)->pid == c.pid && c.pid >= 0) {\n");
  w_s(&mut out, "            bst_errnode *n = *p;\n");
  w_s(&mut out, "            *p = n->next;\n");
  w_s(&mut out, "            fclose(n->err);\n");
  w_s(&mut out, "            free(n);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return bst_child_wait(c);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define bst_child_wait(c) bst_child_wait_err(c)\n");
}

/// The prelude part for `child_fd`, `child_try_read` and `child_try_wait`
/// (stage1 only): added after the spawn_err part, and only to a program that
/// calls one of them.
fn cg_prelude_child_async(out: &mut Vec[u64]) {
  w_s(&mut out, "/* child_fd, child_try_read and child_try_wait: a child driven without blocking.\n");
  w_s(&mut out, " * try_read polls the pipe and reads what is there, so no flag is set on the\n");
  w_s(&mut out, " * descriptor (and the EAGAIN value, 11 on Linux and 35 on macOS, never matters).\n");
  w_s(&mut out, " * It reads the descriptor itself, so do not mix it with child_read_line on the\n");
  w_s(&mut out, " * same stream. */\n");
  w_s(&mut out, "#ifndef _WIN32\n");
  w_s(&mut out, "#include <errno.h>\n");
  w_s(&mut out, "#include <poll.h>\n");
  w_s(&mut out, "#include <sys/wait.h>\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static int bst_child_fdof(bst_child *c, uint64_t which) {\n");
  w_s(&mut out, "    if (which == 0) return c->in;\n");
  w_s(&mut out, "    if (which == 1) return c->out ? fileno(c->out) : -1;\n");
  w_s(&mut out, "    if (which == 2 && c->pid >= 0) {\n");
  w_s(&mut out, "        for (bst_errnode *n = bst_errs; n; n = n->next)\n");
  w_s(&mut out, "            if (n->pid == c->pid) return fileno(n->err);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return -1;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_child_fd(bst_child c, uint64_t which) {\n");
  w_s(&mut out, "    int fd = bst_child_fdof(&c, which);\n");
  w_s(&mut out, "    return fd < 0 ? UINT64_MAX : (uint64_t)fd;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* 0: a chunk of output replaced `out`; 1: nothing to read yet; 2: the end (or no such pipe). */\n");
  w_s(&mut out, "static uint64_t bst_child_try_read(bst_child *c, uint64_t which, bst_bytes *out) {\n");
  w_s(&mut out, "    int fd = bst_child_fdof(c, which);\n");
  w_s(&mut out, "    if (which == 0 || fd < 0) return 2;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    DWORD avail = 0;\n");
  w_s(&mut out, "    if (!PeekNamedPipe((HANDLE)_get_osfhandle(fd), NULL, 0, NULL, &avail, NULL)) return 2;\n");
  w_s(&mut out, "    if (avail == 0) return 1;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    struct pollfd pf;\n");
  w_s(&mut out, "    pf.fd = fd;\n");
  w_s(&mut out, "    pf.events = POLLIN;\n");
  w_s(&mut out, "    pf.revents = 0;\n");
  w_s(&mut out, "    int r;\n");
  w_s(&mut out, "    do { r = poll(&pf, 1, 0); } while (r < 0 && errno == EINTR);\n");
  w_s(&mut out, "    if (r == 0) return 1;\n");
  w_s(&mut out, "    if (r < 0) return 2;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    unsigned char *d = (unsigned char *)malloc(65536);\n");
  w_s(&mut out, "    if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    ssize_t n;\n");
  w_s(&mut out, "    do { n = read(fd, d, 65536); } while (n < 0 && errno == EINTR);\n");
  w_s(&mut out, "    if (n <= 0) { free(d); return 2; }\n");
  w_s(&mut out, "    free(out->data);\n");
  w_s(&mut out, "    out->len = (uint64_t)n;\n");
  w_s(&mut out, "    out->data = d;\n");
  w_s(&mut out, "    return 0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* 256 while the child runs, else its exit status as child_wait would report\n");
  w_s(&mut out, " * it, except that a child ended by a signal gives 512 + the signal. The child is not\n");
  w_s(&mut out, " * reaped: child_wait still has to be called. */\n");
  w_s(&mut out, "static uint64_t bst_child_try_wait(bst_child c) {\n");
  w_s(&mut out, "    if (c.pid < 0) return 127;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    DWORD code;\n");
  w_s(&mut out, "    if (!GetExitCodeProcess((HANDLE)c.pid, &code)) return 255;\n");
  w_s(&mut out, "    return code == STILL_ACTIVE ? 256 : (uint64_t)code;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    siginfo_t si;\n");
  w_s(&mut out, "    memset(&si, 0, sizeof si);\n");
  w_s(&mut out, "    if (waitid(P_PID, (id_t)c.pid, &si, WEXITED | WNOHANG | WNOWAIT) != 0) return 255;\n");
  w_s(&mut out, "    if (si.si_pid == 0) return 256;\n");
  w_s(&mut out, "    return si.si_code == CLD_EXITED ? (uint64_t)si.si_status : 512 + (uint64_t)si.si_status;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
}

/// The prelude part for `host_sandbox` (stage1 only): added after the hosted
/// prelude, and only to a program that calls it.
fn cg_prelude_sandbox(out: &mut Vec[u64]) {
  w_s(&mut out, "#include <errno.h>\n");
  w_s(&mut out, "#include <limits.h>\n");
  w_s(&mut out, "#include <sys/stat.h>\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "#include <direct.h>\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "char *realpath(const char *, char *);   /* XSI: hidden by _POSIX_C_SOURCE alone */\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "/* host_sandbox: the calls a program makes to give up what it may do (Linux:\n");
  w_s(&mut out, " * no_new_privs, seccomp, Landlock) and to name paths before it does. `op` 0 sets\n");
  w_s(&mut out, " * no_new_privs; 1 installs the seccomp filter whose instructions (8 bytes each:\n");
  w_s(&mut out, " * code u16, jt u8, jf u8, k u32, little endian) are `*buf`, with flags `a`; 2\n");
  w_s(&mut out, " * returns the Landlock ABI version; 3 creates a Landlock ruleset from the\n");
  w_s(&mut out, " * attribute bytes in `*buf` and returns its descriptor; 4 lets ruleset `a` reach\n");
  w_s(&mut out, " * the path `*buf` with access `b`; 5 lets ruleset `a` reach TCP port `b & 65535`\n");
  w_s(&mut out, " * with access `b >> 16`; 6 restricts the program to ruleset `a`; 7 closes `a`;\n");
  w_s(&mut out, " * 8 replaces `*buf` with its path made absolute (realpath); 9 replaces `*buf`\n");
  w_s(&mut out, " * with the current directory; 10 returns the error number of the last call that\n");
  w_s(&mut out, " * failed. The failure of any is 2^64 - 1. Ops 0 to 7 fail outside Linux. */\n");
  w_s(&mut out, "static uint64_t bst_sb_errno;\n");
  w_s(&mut out, "static uint64_t bst_sb_fail(void) { bst_sb_errno = (uint64_t)errno; return ~(uint64_t)0; }\n");
  w_s(&mut out, "static void bst_sb_replace(bst_bytes *buf, const char *s) {\n");
  w_s(&mut out, "    size_t n = strlen(s);\n");
  w_s(&mut out, "    unsigned char *d = (unsigned char *)malloc(n ? n : 1);\n");
  w_s(&mut out, "    if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    memcpy(d, s, n);\n");
  w_s(&mut out, "    free(buf->data);\n");
  w_s(&mut out, "    buf->len = n;\n");
  w_s(&mut out, "    buf->data = d;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* `*buf` as a C string (NUL-terminated, malloc'd), or NULL if it holds a NUL. */\n");
  w_s(&mut out, "static char *bst_sb_cstr(const bst_bytes *buf) {\n");
  w_s(&mut out, "    if (memchr(buf->data, 0, buf->len)) { errno = EINVAL; return NULL; }\n");
  w_s(&mut out, "    char *s = (char *)malloc(buf->len + 1);\n");
  w_s(&mut out, "    if (!s) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    memcpy(s, buf->data, buf->len);\n");
  w_s(&mut out, "    s[buf->len] = 0;\n");
  w_s(&mut out, "    return s;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#if defined(__linux__) && (defined(__x86_64__) || defined(__aarch64__))\n");
  w_s(&mut out, "long syscall(long, ...);\n");
  w_s(&mut out, "#ifdef __x86_64__\n");
  w_s(&mut out, "#define BST_SYS_SECCOMP 317\n");
  w_s(&mut out, "#define BST_SYS_PRCTL 157\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "#define BST_SYS_SECCOMP 277\n");
  w_s(&mut out, "#define BST_SYS_PRCTL 167\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "#define BST_SB_LINUX 1\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static uint64_t bst_host_sandbox(bst_host h, uint64_t op, uint64_t a, uint64_t b, bst_bytes *buf) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    if (op == 10) return bst_sb_errno;\n");
  w_s(&mut out, "    if (op == 8) {\n");
  w_s(&mut out, "        char *p = bst_sb_cstr(buf);\n");
  w_s(&mut out, "        if (!p) return bst_sb_fail();\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        char *r = _fullpath(NULL, p, 0);\n");
  w_s(&mut out, "        /* _fullpath names a path that need not exist; realpath does not. */\n");
  w_s(&mut out, "        struct _stat64 st;\n");
  w_s(&mut out, "        if (r && _stat64(r, &st) != 0) { int e = errno; free(r); r = NULL; errno = e; }\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        char *r = realpath(p, NULL);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        if (!r) { bst_sb_errno = (uint64_t)errno; free(p); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        free(p);\n");
  w_s(&mut out, "        bst_sb_replace(buf, r);\n");
  w_s(&mut out, "        free(r);\n");
  w_s(&mut out, "        return 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 9) {\n");
  w_s(&mut out, "        size_t cap = 256;\n");
  w_s(&mut out, "        for (;;) {\n");
  w_s(&mut out, "            char *d = (char *)malloc(cap);\n");
  w_s(&mut out, "            if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "            char *r = _getcwd(d, (int)cap);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "            char *r = getcwd(d, cap);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "            if (r) { bst_sb_replace(buf, d); free(d); return 0; }\n");
  w_s(&mut out, "            int e = errno;\n");
  w_s(&mut out, "            free(d);\n");
  w_s(&mut out, "            if (e != ERANGE || cap >= ((size_t)1 << 20)) { errno = e; return bst_sb_fail(); }\n");
  w_s(&mut out, "            cap *= 2;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#ifdef BST_SB_LINUX\n");
  w_s(&mut out, "    if (op == 0) return syscall(BST_SYS_PRCTL, 38L, 1L, 0L, 0L, 0L) == 0 ? 0 : bst_sb_fail();   /* PR_SET_NO_NEW_PRIVS */\n");
  w_s(&mut out, "    if (op == 1) {\n");
  w_s(&mut out, "        if (buf->len == 0 || buf->len % 8 != 0 || buf->len / 8 > 4096) { errno = EINVAL; return bst_sb_fail(); }\n");
  w_s(&mut out, "        struct { unsigned short len; const void *filter; } prog;   /* struct sock_fprog */\n");
  w_s(&mut out, "        prog.len = (unsigned short)(buf->len / 8);\n");
  w_s(&mut out, "        prog.filter = buf->data;\n");
  w_s(&mut out, "        long r = syscall(BST_SYS_SECCOMP, 1L, (long)a, &prog);   /* SECCOMP_SET_MODE_FILTER */\n");
  w_s(&mut out, "        return r < 0 ? bst_sb_fail() : (uint64_t)r;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 2) {\n");
  w_s(&mut out, "        long r = syscall(444L, (void *)0, 0L, 1L);   /* landlock_create_ruleset(NULL, 0, VERSION) */\n");
  w_s(&mut out, "        return r < 0 ? bst_sb_fail() : (uint64_t)r;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 3) {\n");
  w_s(&mut out, "        long r = syscall(444L, buf->data, (long)buf->len, 0L);\n");
  w_s(&mut out, "        return r < 0 ? bst_sb_fail() : (uint64_t)r;   /* the kernel opens it close-on-exec */\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 4) {\n");
  w_s(&mut out, "        char *p = bst_sb_cstr(buf);\n");
  w_s(&mut out, "        if (!p) return bst_sb_fail();\n");
  w_s(&mut out, "        int fd = open(p, 010000000 | O_CLOEXEC);   /* O_PATH */\n");
  w_s(&mut out, "        free(p);\n");
  w_s(&mut out, "        if (fd < 0) return bst_sb_fail();\n");
  w_s(&mut out, "        struct stat st;   /* a rule for a file that is not a directory carries only the file rights */\n");
  w_s(&mut out, "        if (fstat(fd, &st) == 0 && !S_ISDIR(st.st_mode)) b &= 49159;   /* EXECUTE | WRITE_FILE | READ_FILE | TRUNCATE | IOCTL_DEV */\n");
  w_s(&mut out, "        unsigned char attr[12];   /* struct landlock_path_beneath_attr, packed: allowed_access u64, parent_fd s32 */\n");
  w_s(&mut out, "        int32_t pfd = fd;\n");
  w_s(&mut out, "        memcpy(attr, &b, 8);\n");
  w_s(&mut out, "        memcpy(attr + 8, &pfd, 4);\n");
  w_s(&mut out, "        long r = syscall(445L, (long)a, 1L, attr, 0L);   /* LANDLOCK_RULE_PATH_BENEATH */\n");
  w_s(&mut out, "        int e = errno;\n");
  w_s(&mut out, "        close(fd);\n");
  w_s(&mut out, "        if (r < 0) { errno = e; return bst_sb_fail(); }\n");
  w_s(&mut out, "        return 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 5) {\n");
  w_s(&mut out, "        uint64_t attr[2];   /* struct landlock_net_port_attr: allowed_access, port */\n");
  w_s(&mut out, "        attr[0] = b >> 16;\n");
  w_s(&mut out, "        attr[1] = b & 65535;\n");
  w_s(&mut out, "        long r = syscall(445L, (long)a, 2L, attr, 0L);   /* LANDLOCK_RULE_NET_PORT */\n");
  w_s(&mut out, "        return r < 0 ? bst_sb_fail() : 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 6) return syscall(446L, (long)a, 0L) == 0 ? 0 : bst_sb_fail();\n");
  w_s(&mut out, "    if (op == 7) return close((int)a) == 0 ? 0 : bst_sb_fail();\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    (void)a; (void)b;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    errno = ENOSYS;\n");
  w_s(&mut out, "    return bst_sb_fail();\n");
  w_s(&mut out, "}\n");
}

/// The prelude part for the `f64_*` builtins (stage1 only): added after the
/// hosted prelude, and only to a program that calls one.
fn cg_prelude_f64(out: &mut Vec[u64]) {
  w_s(&mut out, "#include <math.h>\n");
  w_s(&mut out, "/* f64: IEEE 754 doubles, carried as their 64 bits in a uint64_t (so a Vec,\n");
  w_s(&mut out, " * a struct field or a proof sees a plain word). Each operation is the C\n");
  w_s(&mut out, " * one on the values those bits stand for, rounded to nearest. */\n");
  w_s(&mut out, "static inline double bst_f64_d(uint64_t b) { double d; memcpy(&d, &b, 8); return d; }\n");
  w_s(&mut out, "static inline uint64_t bst_f64_b(double d) { uint64_t b; memcpy(&b, &d, 8); return b; }\n");
  w_s(&mut out, "static inline uint64_t bst_f64_add(uint64_t a, uint64_t b) { return bst_f64_b(bst_f64_d(a) + bst_f64_d(b)); }\n");
  w_s(&mut out, "static inline uint64_t bst_f64_sub(uint64_t a, uint64_t b) { return bst_f64_b(bst_f64_d(a) - bst_f64_d(b)); }\n");
  w_s(&mut out, "static inline uint64_t bst_f64_mul(uint64_t a, uint64_t b) { return bst_f64_b(bst_f64_d(a) * bst_f64_d(b)); }\n");
  w_s(&mut out, "static inline uint64_t bst_f64_div(uint64_t a, uint64_t b) { return bst_f64_b(bst_f64_d(a) / bst_f64_d(b)); }\n");
  w_s(&mut out, "static inline uint64_t bst_f64_fma(uint64_t a, uint64_t b, uint64_t c) { return bst_f64_b(fma(bst_f64_d(a), bst_f64_d(b), bst_f64_d(c))); }\n");
  w_s(&mut out, "static inline bool bst_f64_eq(uint64_t a, uint64_t b) { return bst_f64_d(a) == bst_f64_d(b); }\n");
  w_s(&mut out, "static inline bool bst_f64_lt(uint64_t a, uint64_t b) { return bst_f64_d(a) < bst_f64_d(b); }\n");
  w_s(&mut out, "static inline bool bst_f64_le(uint64_t a, uint64_t b) { return bst_f64_d(a) <= bst_f64_d(b); }\n");
  w_s(&mut out, "static inline uint64_t bst_f64_from_u64(uint64_t a) { return bst_f64_b((double)a); }\n");
  w_s(&mut out, "static inline uint64_t bst_f64_from_i64(int64_t a) { return bst_f64_b((double)a); }\n");
  w_s(&mut out, "/* Toward zero, saturating at the type's ends; NaN is 0. */\n");
  w_s(&mut out, "static inline uint64_t bst_f64_to_u64(uint64_t a) {\n");
  w_s(&mut out, "    double d = bst_f64_d(a);\n");
  w_s(&mut out, "    if (!(d > -1.0)) return 0;\n");
  w_s(&mut out, "    if (d >= 18446744073709551616.0) return ~(uint64_t)0;\n");
  w_s(&mut out, "    return (uint64_t)d;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline int64_t bst_f64_to_i64(uint64_t a) {\n");
  w_s(&mut out, "    double d = bst_f64_d(a);\n");
  w_s(&mut out, "    if (d != d) return 0;\n");
  w_s(&mut out, "    if (d <= -9223372036854775808.0) return INT64_MIN;\n");
  w_s(&mut out, "    if (d >= 9223372036854775808.0) return INT64_MAX;\n");
  w_s(&mut out, "    return (int64_t)d;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The functions of one argument, by number (an unknown one is NaN). */\n");
  w_s(&mut out, "static uint64_t bst_f64_math(uint64_t op, uint64_t a) {\n");
  w_s(&mut out, "    double x = bst_f64_d(a), r;\n");
  w_s(&mut out, "    switch (op) {\n");
  w_s(&mut out, "    case 0: r = sqrt(x); break;\n");
  w_s(&mut out, "    case 1: r = floor(x); break;\n");
  w_s(&mut out, "    case 2: r = ceil(x); break;\n");
  w_s(&mut out, "    case 3: r = trunc(x); break;\n");
  w_s(&mut out, "    case 4: r = round(x); break;\n");
  w_s(&mut out, "    case 5: r = nearbyint(x); break;\n");
  w_s(&mut out, "    case 6: r = exp(x); break;\n");
  w_s(&mut out, "    case 7: r = expm1(x); break;\n");
  w_s(&mut out, "    case 8: r = log(x); break;\n");
  w_s(&mut out, "    case 9: r = log1p(x); break;\n");
  w_s(&mut out, "    case 10: r = log2(x); break;\n");
  w_s(&mut out, "    case 11: r = log10(x); break;\n");
  w_s(&mut out, "    case 12: r = sin(x); break;\n");
  w_s(&mut out, "    case 13: r = cos(x); break;\n");
  w_s(&mut out, "    case 14: r = tan(x); break;\n");
  w_s(&mut out, "    case 15: r = asin(x); break;\n");
  w_s(&mut out, "    case 16: r = acos(x); break;\n");
  w_s(&mut out, "    case 17: r = atan(x); break;\n");
  w_s(&mut out, "    case 18: r = sinh(x); break;\n");
  w_s(&mut out, "    case 19: r = cosh(x); break;\n");
  w_s(&mut out, "    case 20: r = tanh(x); break;\n");
  w_s(&mut out, "    case 21: r = asinh(x); break;\n");
  w_s(&mut out, "    case 22: r = acosh(x); break;\n");
  w_s(&mut out, "    case 23: r = atanh(x); break;\n");
  w_s(&mut out, "    case 24: r = cbrt(x); break;\n");
  w_s(&mut out, "    case 25: r = exp2(x); break;\n");
  w_s(&mut out, "    default: r = NAN; break;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return bst_f64_b(r);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The functions of two arguments, by number (an unknown one is NaN). */\n");
  w_s(&mut out, "static uint64_t bst_f64_math2(uint64_t op, uint64_t a, uint64_t b) {\n");
  w_s(&mut out, "    double x = bst_f64_d(a), y = bst_f64_d(b), r;\n");
  w_s(&mut out, "    switch (op) {\n");
  w_s(&mut out, "    case 0: r = pow(x, y); break;\n");
  w_s(&mut out, "    case 1: r = atan2(x, y); break;\n");
  w_s(&mut out, "    case 2: r = fmod(x, y); break;\n");
  w_s(&mut out, "    case 3: r = hypot(x, y); break;\n");
  w_s(&mut out, "    default: r = NAN; break;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return bst_f64_b(r);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The number the bytes spell (strtod, in the C locale: decimal or hexadecimal,\n");
  w_s(&mut out, " * inf, nan), rounded to nearest; NaN unless every byte is used. */\n");
  w_s(&mut out, "static uint64_t bst_f64_parse(bst_bytes s) {\n");
  w_s(&mut out, "    char small[64];\n");
  w_s(&mut out, "    char *t = s.len < sizeof small ? small : (char *)malloc(s.len + 1);\n");
  w_s(&mut out, "    if (!t) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    memcpy(t, s.data, s.len);\n");
  w_s(&mut out, "    t[s.len] = 0;\n");
  w_s(&mut out, "    char *end = t;\n");
  w_s(&mut out, "    double d = s.len == 0 || memchr(s.data, 0, s.len) ? NAN : strtod(t, &end);\n");
  w_s(&mut out, "    if (end != t + s.len) d = NAN;\n");
  w_s(&mut out, "    if (t != small) free(t);\n");
  w_s(&mut out, "    return bst_f64_b(d);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_f64_put(bst_bytes *out, const char *s, size_t n) {\n");
  w_s(&mut out, "    unsigned char *d = (unsigned char *)malloc(n ? n : 1);\n");
  w_s(&mut out, "    if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    memcpy(d, s, n);\n");
  w_s(&mut out, "    free(out->data);\n");
  w_s(&mut out, "    out->len = n;\n");
  w_s(&mut out, "    out->data = d;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Does the decimal with the `p` digits `d` and exponent `e` (d[0].d[1..] * 10^e) read back as `x`? */\n");
  w_s(&mut out, "static bool bst_f64_back(const char *d, int p, int e, double x) {\n");
  w_s(&mut out, "    char t[48];\n");
  w_s(&mut out, "    int k = 0;\n");
  w_s(&mut out, "    t[k++] = d[0];\n");
  w_s(&mut out, "    t[k++] = '.';\n");
  w_s(&mut out, "    for (int i = 1; i < p; i++) t[k++] = d[i];\n");
  w_s(&mut out, "    snprintf(t + k, sizeof t - (size_t)k, \"e%d\", e);\n");
  w_s(&mut out, "    return strtod(t, NULL) == x;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The shortest decimal digits that read back as `a` (the closest such), alone\n");
  w_s(&mut out, " * (`15` for 1.5), replacing `*out`; the result is the decimal exponent n with\n");
  w_s(&mut out, " * |a| = 0.digits * 10^n. For 0 the digits are `0` and n is 1; for an infinity\n");
  w_s(&mut out, " * `inf` and for NaN `nan`, and n is 0. For each length p from 1, the p digits\n");
  w_s(&mut out, " * nearest to `a` are tried, then their neighbour on the other side of `a`\n");
  w_s(&mut out, " * (at a power of two the gap below is half the gap above, so the nearest can\n");
  w_s(&mut out, " * miss while the neighbour reads back). */\n");
  w_s(&mut out, "static int64_t bst_f64_digits(uint64_t a, bst_bytes *out) {\n");
  w_s(&mut out, "    double x = bst_f64_d(a);\n");
  w_s(&mut out, "    char t[64], d[24];\n");
  w_s(&mut out, "    if (x != x) { bst_f64_put(out, \"nan\", 3); return 0; }\n");
  w_s(&mut out, "    if (x == 0) { bst_f64_put(out, \"0\", 1); return 1; }\n");
  w_s(&mut out, "    if (x - x != 0) { bst_f64_put(out, \"inf\", 3); return 0; }\n");
  w_s(&mut out, "    if (x < 0) x = -x;\n");
  w_s(&mut out, "    int p = 1, e = 0;\n");
  w_s(&mut out, "    for (; p <= 17; p++) {\n");
  w_s(&mut out, "        snprintf(t, sizeof t, \"%.*e\", p - 1, x);\n");
  w_s(&mut out, "        int k = 0;\n");
  w_s(&mut out, "        const char *c = t;\n");
  w_s(&mut out, "        for (; *c && *c != 'e'; c++) if (*c >= '0' && *c <= '9') d[k++] = *c;\n");
  w_s(&mut out, "        e = atoi(c + 1);\n");
  w_s(&mut out, "        double got = strtod(t, NULL);\n");
  w_s(&mut out, "        if (got == x || p == 17) break;\n");
  w_s(&mut out, "        char n[24];\n");
  w_s(&mut out, "        int ne = e;\n");
  w_s(&mut out, "        memcpy(n, d, (size_t)p);\n");
  w_s(&mut out, "        int i = p - 1;\n");
  w_s(&mut out, "        if (got < x) {   /* one unit up in the last digit */\n");
  w_s(&mut out, "            while (i >= 0 && n[i] == '9') n[i--] = '0';\n");
  w_s(&mut out, "            if (i < 0) { n[0] = '1'; ne++; } else n[i]++;\n");
  w_s(&mut out, "        } else {          /* one unit down */\n");
  w_s(&mut out, "            while (i >= 0 && n[i] == '0') n[i--] = '9';\n");
  w_s(&mut out, "            n[i]--;\n");
  w_s(&mut out, "            if (n[0] == '0') { memmove(n, n + 1, (size_t)p - 1); n[p - 1] = '9'; ne--; }\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        if (bst_f64_back(n, p, ne, x)) { memcpy(d, n, (size_t)p); e = ne; break; }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    int k = p;\n");
  w_s(&mut out, "    while (k > 1 && d[k - 1] == '0') k--;\n");
  w_s(&mut out, "    bst_f64_put(out, d, (size_t)k);\n");
  w_s(&mut out, "    return (int64_t)e + 1;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* printf's %.*e (`e`) or %.*f with `prec` (at most 100) digits after the point,\n");
  w_s(&mut out, " * replacing `*out`; the result is the length. */\n");
  w_s(&mut out, "static uint64_t bst_f64_fmt(uint64_t a, uint64_t prec, bst_bytes *out, int e) {\n");
  w_s(&mut out, "    double x = bst_f64_d(a);\n");
  w_s(&mut out, "    if (prec > 100) prec = 100;\n");
  w_s(&mut out, "    int n = snprintf(NULL, 0, e ? \"%.*e\" : \"%.*f\", (int)prec, x);\n");
  w_s(&mut out, "    if (n < 0) n = 0;\n");
  w_s(&mut out, "    char *t = (char *)malloc((size_t)n + 1);\n");
  w_s(&mut out, "    if (!t) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    snprintf(t, (size_t)n + 1, e ? \"%.*e\" : \"%.*f\", (int)prec, x);\n");
  w_s(&mut out, "    bst_f64_put(out, t, (size_t)n);\n");
  w_s(&mut out, "    free(t);\n");
  w_s(&mut out, "    return (uint64_t)n;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_f64_fmt_e(uint64_t a, uint64_t prec, bst_bytes *out) { return bst_f64_fmt(a, prec, out, 1); }\n");
  w_s(&mut out, "static uint64_t bst_f64_fmt_f(uint64_t a, uint64_t prec, bst_bytes *out) { return bst_f64_fmt(a, prec, out, 0); }\n");
}

/// The prelude part for `host_sys` (stage1 only): added after the hosted
/// prelude, and only to a program that calls it.
fn cg_prelude_sys(out: &mut Vec[u64]) {
  w_s(&mut out, "#include <errno.h>\n");
  w_s(&mut out, "#include <time.h>\n");
  w_s(&mut out, "#include <sys/stat.h>\n");
  w_s(&mut out, "#include <dirent.h>\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "#include <windows.h>\n");
  w_s(&mut out, "#include <io.h>\n");
  w_s(&mut out, "#include <direct.h>\n");
  w_s(&mut out, "#include <sys/utime.h>\n");
  w_s(&mut out, "#include <process.h>\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "#include <poll.h>\n");
  w_s(&mut out, "#include <sys/time.h>\n");
  w_s(&mut out, "#include <sys/resource.h>\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "#ifdef __linux__\n");
  w_s(&mut out, "#include <sys/epoll.h>\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "/* host_sys: the operating system's files, descriptors, clocks and readiness,\n");
  w_s(&mut out, " * one call with an operation number (see docs/language.md for the table).\n");
  w_s(&mut out, " * The failure of any is 2^64 - 1, and operation 60 then gives errno. */\n");
  w_s(&mut out, "static uint64_t bst_sys_errno;\n");
  w_s(&mut out, "#ifndef _WIN32\n");
  w_s(&mut out, "static volatile uint64_t bst_sig_pending;\n");
  w_s(&mut out, "static int bst_sig_pipe[2] = { -1, -1 };\n");
  w_s(&mut out, "static void bst_sig_handler(int sig) {\n");
  w_s(&mut out, "    int saved = errno;\n");
  w_s(&mut out, "    __atomic_fetch_or(&bst_sig_pending, (uint64_t)1 << (sig & 63), __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    if (bst_sig_pipe[1] >= 0) { char c = 1; ssize_t w = write(bst_sig_pipe[1], &c, 1); (void)w; }\n");
  w_s(&mut out, "    errno = saved;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static int bst_sig_init(void) {\n");
  w_s(&mut out, "    if (bst_sig_pipe[0] >= 0) return 0;\n");
  w_s(&mut out, "    int p[2];\n");
  w_s(&mut out, "    if (pipe(p) != 0) return -1;\n");
  w_s(&mut out, "    for (int i = 0; i < 2; i++) {\n");
  w_s(&mut out, "        fcntl(p[i], F_SETFL, fcntl(p[i], F_GETFL) | O_NONBLOCK);\n");
  w_s(&mut out, "        fcntl(p[i], F_SETFD, FD_CLOEXEC);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_sig_pipe[0] = p[0]; bst_sig_pipe[1] = p[1];\n");
  w_s(&mut out, "    return 0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static uint64_t bst_sys_fail(void) { bst_sys_errno = (uint64_t)errno; return ~(uint64_t)0; }\n");
  w_s(&mut out, "static uint64_t bst_sys_failw(int e) { errno = e; return bst_sys_fail(); }\n");
  w_s(&mut out, "static void bst_sys_set(bst_bytes *buf, const void *s, size_t n) {\n");
  w_s(&mut out, "    unsigned char *d = (unsigned char *)malloc(n ? n : 1);\n");
  w_s(&mut out, "    if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    memcpy(d, s, n);\n");
  w_s(&mut out, "    free(buf->data);\n");
  w_s(&mut out, "    buf->len = n;\n");
  w_s(&mut out, "    buf->data = d;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* `*buf` (or its part `from`..`to`) as a C string from malloc, or NULL if it holds a NUL. */\n");
  w_s(&mut out, "static char *bst_sys_cstr(const bst_bytes *buf, uint64_t from, uint64_t to) {\n");
  w_s(&mut out, "    if (from > to || to > buf->len || memchr(buf->data + from, 0, to - from)) { errno = EINVAL; return NULL; }\n");
  w_s(&mut out, "    char *s = (char *)malloc(to - from + 1);\n");
  w_s(&mut out, "    if (!s) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    memcpy(s, buf->data + from, to - from);\n");
  w_s(&mut out, "    s[to - from] = 0;\n");
  w_s(&mut out, "    return s;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_sys_ns(struct timespec t) { return (uint64_t)t.tv_sec * 1000000000u + (uint64_t)t.tv_nsec; }\n");
  w_s(&mut out, "static void bst_sys_put64(unsigned char *p, uint64_t v) { for (int i = 0; i < 8; i++) p[i] = (unsigned char)(v >> (8 * i)); }\n");
  w_s(&mut out, "static uint64_t bst_sys_get64(const unsigned char *p) { uint64_t v = 0; for (int i = 0; i < 8; i++) v |= (uint64_t)p[i] << (8 * i); return v; }\n");
  w_s(&mut out, "/* The kind of a mode: 1 file, 2 directory, 3 symbolic link, 4 other. */\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "#define lstat stat   /* Windows: no symbolic links through stat */\n");
  w_s(&mut out, "static uint64_t bst_sys_kind(unsigned m) { return S_ISREG(m) ? 1 : S_ISDIR(m) ? 2 : 4; }\n");
  w_s(&mut out, "#define BST_ST_TIME(st, x) ((uint64_t)(st).st_##x##time * 1000000000u)\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "static uint64_t bst_sys_kind(mode_t m) { return S_ISREG(m) ? 1 : S_ISDIR(m) ? 2 : S_ISLNK(m) ? 3 : 4; }\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "#if defined(_WIN32)\n");
  w_s(&mut out, "#elif defined(__APPLE__)\n");
  w_s(&mut out, "/* _POSIX_C_SOURCE hides st_mtimespec; the plain fields are there */\n");
  w_s(&mut out, "#define BST_ST_TIME(st, x) ((uint64_t)(st).st_##x##time * 1000000000u + (uint64_t)(st).st_##x##timensec)\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "#define BST_ST_TIME(st, x) ((uint64_t)(st).st_##x##tim.tv_sec * 1000000000u + (uint64_t)(st).st_##x##tim.tv_nsec)\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "/* A stat record of eight little-endian words replaces `*buf`: the kind, the size,\n");
  w_s(&mut out, " * the permission bits, the times of the last change of the contents, of the last\n");
  w_s(&mut out, " * access and of the last change of the status (nanoseconds since 1970), the device\n");
  w_s(&mut out, " * and the inode number. */\n");
  w_s(&mut out, "static uint64_t bst_sys_statrec(bst_bytes *buf, struct stat *st) {\n");
  w_s(&mut out, "    unsigned char r[64];\n");
  w_s(&mut out, "    bst_sys_put64(r, bst_sys_kind(st->st_mode));\n");
  w_s(&mut out, "    bst_sys_put64(r + 8, (uint64_t)st->st_size);\n");
  w_s(&mut out, "    bst_sys_put64(r + 16, (uint64_t)(st->st_mode & 07777));\n");
  w_s(&mut out, "    bst_sys_put64(r + 24, BST_ST_TIME(*st, m));\n");
  w_s(&mut out, "    bst_sys_put64(r + 32, BST_ST_TIME(*st, a));\n");
  w_s(&mut out, "    bst_sys_put64(r + 40, BST_ST_TIME(*st, c));\n");
  w_s(&mut out, "    bst_sys_put64(r + 48, (uint64_t)st->st_dev);\n");
  w_s(&mut out, "    bst_sys_put64(r + 56, (uint64_t)st->st_ino);\n");
  w_s(&mut out, "    bst_sys_set(buf, r, 64);\n");
  w_s(&mut out, "    return bst_sys_kind(st->st_mode);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#ifndef _WIN32\n");
  w_s(&mut out, "char *realpath(const char *, char *);\n");
  w_s(&mut out, "int symlink(const char *, const char *);\n");
  w_s(&mut out, "ssize_t readlink(const char *, char *, size_t);\n");
  w_s(&mut out, "int lstat(const char *, struct stat *);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "/* The flags of operation 2, as open(2) takes them. */\n");
  w_s(&mut out, "static int bst_sys_oflags(uint64_t a) {\n");
  w_s(&mut out, "    int f = (a & 3) == 3 ? O_RDWR : (a & 2) ? O_WRONLY : O_RDONLY;\n");
  w_s(&mut out, "    if (a & 4) f |= O_CREAT;\n");
  w_s(&mut out, "    if (a & 8) f |= O_TRUNC;\n");
  w_s(&mut out, "    if (a & 16) f |= O_APPEND;\n");
  w_s(&mut out, "    if (a & 32) f |= O_EXCL;\n");
  w_s(&mut out, "#ifdef O_CLOEXEC\n");
  w_s(&mut out, "    f |= O_CLOEXEC;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "#ifdef O_BINARY\n");
  w_s(&mut out, "    f |= O_BINARY;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    return f;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_host_sys(bst_host h, uint64_t op, uint64_t a, uint64_t b, bst_bytes *buf) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    if (op == 60) return bst_sys_errno;\n");
  w_s(&mut out, "    if (op >= 61 && op <= 64) {   /* signals: 61 catch (b = 1) or restore (b = 0) signal a; 62 take the set of caught ones; 63 the read end of a pipe that gets a byte per catch; 64 send signal b to process a */\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        return bst_sys_failw(ENOSYS);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        if (op == 61) {\n");
  w_s(&mut out, "            if (a < 1 || a > 63 || a == SIGKILL || a == SIGSTOP) return bst_sys_failw(EINVAL);\n");
  w_s(&mut out, "            if (bst_sig_init() != 0) return bst_sys_fail();\n");
  w_s(&mut out, "            struct sigaction sa;\n");
  w_s(&mut out, "            memset(&sa, 0, sizeof sa);\n");
  w_s(&mut out, "            sa.sa_handler = b ? bst_sig_handler : SIG_DFL;\n");
  w_s(&mut out, "            sigemptyset(&sa.sa_mask);\n");
  w_s(&mut out, "            sa.sa_flags = SA_RESTART;\n");
  w_s(&mut out, "            return sigaction((int)a, &sa, NULL) == 0 ? 0 : bst_sys_fail();\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        if (op == 64) {\n");
  w_s(&mut out, "            if (a > 0x7fffffff || b > 63) return bst_sys_failw(EINVAL);\n");
  w_s(&mut out, "            return kill((pid_t)a, (int)b) == 0 ? 0 : bst_sys_fail();\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        if (op == 62) return __atomic_exchange_n(&bst_sig_pending, 0, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "        if (bst_sig_init() != 0) return bst_sys_fail();\n");
  w_s(&mut out, "        return (uint64_t)bst_sig_pipe[0];\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 0) {   /* write *buf to descriptor a */\n");
  w_s(&mut out, "        if (a > 0x7fffffff) return bst_sys_failw(EBADF);\n");
  w_s(&mut out, "        if (a == 1) fflush(stdout);\n");
  w_s(&mut out, "        if (a == 2) fflush(stderr);\n");
  w_s(&mut out, "        size_t n = buf->len > 0x7ffff000u ? 0x7ffff000u : (size_t)buf->len;\n");
  w_s(&mut out, "        long r = (long)write((int)a, buf->data, n);\n");
  w_s(&mut out, "        return r < 0 ? bst_sys_fail() : (uint64_t)r;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 1) {   /* read at most b bytes from descriptor a into *buf */\n");
  w_s(&mut out, "        if (a > 0x7fffffff) return bst_sys_failw(EBADF);\n");
  w_s(&mut out, "        if (b > 0x7ffff000u) b = 0x7ffff000u;\n");
  w_s(&mut out, "        unsigned char *d = (unsigned char *)malloc(b ? b : 1);\n");
  w_s(&mut out, "        if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        long r = (long)read((int)a, d, (size_t)b);\n");
  w_s(&mut out, "        if (r < 0) { int e = errno; free(d); return bst_sys_failw(e); }\n");
  w_s(&mut out, "        free(buf->data);\n");
  w_s(&mut out, "        buf->len = (uint64_t)r;\n");
  w_s(&mut out, "        buf->data = d;\n");
  w_s(&mut out, "        return (uint64_t)r;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 2) {   /* open the path *buf with the flags a and permission bits b */\n");
  w_s(&mut out, "        char *p = bst_sys_cstr(buf, 0, buf->len);\n");
  w_s(&mut out, "        if (!p) return bst_sys_fail();\n");
  w_s(&mut out, "        int fd = open(p, bst_sys_oflags(a), (int)(b & 07777));\n");
  w_s(&mut out, "        int e = errno;\n");
  w_s(&mut out, "        free(p);\n");
  w_s(&mut out, "        return fd < 0 ? bst_sys_failw(e) : (uint64_t)fd;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 3) {\n");
  w_s(&mut out, "        if (a > 0x7fffffff) return bst_sys_failw(EBADF);\n");
  w_s(&mut out, "        return close((int)a) == 0 ? 0 : bst_sys_fail();\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 4 || op == 5 || op == 6) {   /* seek: to b, b from the end, b from here (b signed) */\n");
  w_s(&mut out, "        if (a > 0x7fffffff) return bst_sys_failw(EBADF);\n");
  w_s(&mut out, "        long long r = (long long)lseek((int)a, (off_t)(int64_t)b, op == 4 ? SEEK_SET : op == 5 ? SEEK_END : SEEK_CUR);\n");
  w_s(&mut out, "        return r < 0 ? bst_sys_fail() : (uint64_t)r;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 10 || op == 11) {   /* the monotonic clock, the time since 1970, in nanoseconds */\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        if (op == 10) {\n");
  w_s(&mut out, "            LARGE_INTEGER f, n;\n");
  w_s(&mut out, "            QueryPerformanceFrequency(&f);\n");
  w_s(&mut out, "            QueryPerformanceCounter(&n);\n");
  w_s(&mut out, "            uint64_t hz = (uint64_t)f.QuadPart, c = (uint64_t)n.QuadPart;\n");
  w_s(&mut out, "            return c / hz * 1000000000u + c % hz * 1000000000u / hz;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        FILETIME ft;   /* 100 ns units since 1601 */\n");
  w_s(&mut out, "        GetSystemTimeAsFileTime(&ft);\n");
  w_s(&mut out, "        uint64_t w = ((uint64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime;\n");
  w_s(&mut out, "        return (w - 116444736000000000u) * 100u;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        struct timespec t;\n");
  w_s(&mut out, "        if (clock_gettime(op == 10 ? CLOCK_MONOTONIC : CLOCK_REALTIME, &t) != 0) return bst_sys_fail();\n");
  w_s(&mut out, "        return bst_sys_ns(t);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 13) {   /* the local time zone at `a` seconds since 1970 (signed): its name replaces *buf */\n");
  w_s(&mut out, "        time_t t = (time_t)(int64_t)a;\n");
  w_s(&mut out, "        struct tm lt, gt;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        _tzset();\n");
  w_s(&mut out, "        if (localtime_s(&lt, &t) != 0 || gmtime_s(&gt, &t) != 0) return bst_sys_failw(EINVAL);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        tzset();\n");
  w_s(&mut out, "        if (!localtime_r(&t, &lt) || !gmtime_r(&t, &gt)) return bst_sys_fail();\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        long long d = lt.tm_year != gt.tm_year ? (lt.tm_year > gt.tm_year ? 1 : -1) : lt.tm_yday - gt.tm_yday;\n");
  w_s(&mut out, "        long long off = ((d * 24 + (lt.tm_hour - gt.tm_hour)) * 60 + (lt.tm_min - gt.tm_min)) * 60 + (lt.tm_sec - gt.tm_sec);\n");
  w_s(&mut out, "        char z[64];\n");
  w_s(&mut out, "        size_t n = strftime(z, sizeof z, \"%Z\", &lt);\n");
  w_s(&mut out, "        bst_sys_set(buf, z, n);\n");
  w_s(&mut out, "        return (uint64_t)(off + 172800) | ((uint64_t)(lt.tm_isdst > 0) << 32);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 12) {   /* the processor time this program has used, in nanoseconds */\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        FILETIME c, x, k, u;\n");
  w_s(&mut out, "        if (!GetProcessTimes(GetCurrentProcess(), &c, &x, &k, &u)) return bst_sys_failw(EINVAL);\n");
  w_s(&mut out, "        return ((((uint64_t)k.dwHighDateTime << 32) | k.dwLowDateTime) + (((uint64_t)u.dwHighDateTime << 32) | u.dwLowDateTime)) * 100u;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        struct rusage u;\n");
  w_s(&mut out, "        if (getrusage(RUSAGE_SELF, &u) != 0) return bst_sys_fail();\n");
  w_s(&mut out, "        return ((uint64_t)u.ru_utime.tv_sec + (uint64_t)u.ru_stime.tv_sec) * 1000000000u\n");
  w_s(&mut out, "            + ((uint64_t)u.ru_utime.tv_usec + (uint64_t)u.ru_stime.tv_usec) * 1000u;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 20) {   /* stat the path *buf (a = 1: the link itself); the record replaces *buf */\n");
  w_s(&mut out, "        char *p = bst_sys_cstr(buf, 0, buf->len);\n");
  w_s(&mut out, "        if (!p) return bst_sys_fail();\n");
  w_s(&mut out, "        struct stat st;\n");
  w_s(&mut out, "        int r = a == 1 ? lstat(p, &st) : stat(p, &st);\n");
  w_s(&mut out, "        int e = errno;\n");
  w_s(&mut out, "        free(p);\n");
  w_s(&mut out, "        if (r != 0) return bst_sys_failw(e);\n");
  w_s(&mut out, "        return bst_sys_statrec(buf, &st);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 21) {\n");
  w_s(&mut out, "        struct stat st;\n");
  w_s(&mut out, "        if (a > 0x7fffffff) return bst_sys_failw(EBADF);\n");
  w_s(&mut out, "        if (fstat((int)a, &st) != 0) return bst_sys_fail();\n");
  w_s(&mut out, "        return bst_sys_statrec(buf, &st);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 22) {   /* the entries of the directory *buf (not . and ..), each its kind byte, its name and a NUL */\n");
  w_s(&mut out, "        char *p = bst_sys_cstr(buf, 0, buf->len);\n");
  w_s(&mut out, "        if (!p) return bst_sys_fail();\n");
  w_s(&mut out, "        DIR *d = opendir(p);\n");
  w_s(&mut out, "        int e = errno;\n");
  w_s(&mut out, "        if (!d) { free(p); return bst_sys_failw(e); }\n");
  w_s(&mut out, "        size_t cap = 256, len = 0;\n");
  w_s(&mut out, "        uint64_t n = 0;\n");
  w_s(&mut out, "        unsigned char *out = (unsigned char *)malloc(cap);\n");
  w_s(&mut out, "        if (!out) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        struct dirent *de;\n");
  w_s(&mut out, "        while ((de = readdir(d)) != NULL) {\n");
  w_s(&mut out, "            const char *nm = de->d_name;\n");
  w_s(&mut out, "            if (nm[0] == '.' && (nm[1] == 0 || (nm[1] == '.' && nm[2] == 0))) continue;\n");
  w_s(&mut out, "            size_t k = strlen(nm);\n");
  w_s(&mut out, "            unsigned char kind = 4;\n");
  w_s(&mut out, "#ifdef DT_REG\n");
  w_s(&mut out, "            if (de->d_type == DT_REG) kind = 1;\n");
  w_s(&mut out, "            else if (de->d_type == DT_DIR) kind = 2;\n");
  w_s(&mut out, "            else if (de->d_type == DT_LNK) kind = 3;\n");
  w_s(&mut out, "            else if (de->d_type == DT_UNKNOWN) kind = 0;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "            kind = 0;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "            if (kind == 0) {   /* the file system did not say: ask */\n");
  w_s(&mut out, "                size_t pl = strlen(p);\n");
  w_s(&mut out, "                char *full = (char *)malloc(pl + k + 2);\n");
  w_s(&mut out, "                if (!full) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "                memcpy(full, p, pl); full[pl] = '/'; memcpy(full + pl + 1, nm, k + 1);\n");
  w_s(&mut out, "                struct stat st;\n");
  w_s(&mut out, "                kind = lstat(full, &st) == 0 ? (unsigned char)bst_sys_kind(st.st_mode) : 4;\n");
  w_s(&mut out, "                free(full);\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            while (len + k + 2 > cap) {\n");
  w_s(&mut out, "                cap *= 2;\n");
  w_s(&mut out, "                out = (unsigned char *)realloc(out, cap);\n");
  w_s(&mut out, "                if (!out) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            out[len++] = kind;\n");
  w_s(&mut out, "            memcpy(out + len, nm, k);\n");
  w_s(&mut out, "            len += k;\n");
  w_s(&mut out, "            out[len++] = 0;\n");
  w_s(&mut out, "            n++;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        closedir(d);\n");
  w_s(&mut out, "        free(p);\n");
  w_s(&mut out, "        free(buf->data);\n");
  w_s(&mut out, "        buf->data = out;\n");
  w_s(&mut out, "        buf->len = len;\n");
  w_s(&mut out, "        return n;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op >= 23 && op <= 27) {   /* mkdir (bits a), rmdir, unlink, chdir, chmod (bits a) of the path *buf */\n");
  w_s(&mut out, "        char *p = bst_sys_cstr(buf, 0, buf->len);\n");
  w_s(&mut out, "        if (!p) return bst_sys_fail();\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        int r = op == 23 ? _mkdir(p) : op == 24 ? _rmdir(p) : op == 25 ? _unlink(p)\n");
  w_s(&mut out, "            : op == 26 ? _chdir(p) : _chmod(p, (int)(a & 0600));\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        int r = op == 23 ? mkdir(p, (mode_t)(a & 07777)) : op == 24 ? rmdir(p) : op == 25 ? unlink(p)\n");
  w_s(&mut out, "            : op == 26 ? chdir(p) : chmod(p, (mode_t)(a & 07777));\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        int e = errno;\n");
  w_s(&mut out, "        free(p);\n");
  w_s(&mut out, "        return r != 0 ? bst_sys_failw(e) : 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 28 || op == 29) {   /* rename, symlink: the two paths are *buf before and after byte a */\n");
  w_s(&mut out, "        if (a >= buf->len) return bst_sys_failw(EINVAL);\n");
  w_s(&mut out, "        char *x = bst_sys_cstr(buf, 0, a);\n");
  w_s(&mut out, "        if (!x) return bst_sys_fail();\n");
  w_s(&mut out, "        char *y = bst_sys_cstr(buf, a, buf->len);\n");
  w_s(&mut out, "        if (!y) { free(x); return bst_sys_fail(); }\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        int r = op == 28 ? rename(x, y) : (errno = ENOSYS, -1);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        int r = op == 28 ? rename(x, y) : symlink(x, y);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        int e = errno;\n");
  w_s(&mut out, "        free(x);\n");
  w_s(&mut out, "        free(y);\n");
  w_s(&mut out, "        return r != 0 ? bst_sys_failw(e) : 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 30) {   /* the target of the symbolic link *buf replaces it */\n");
  w_s(&mut out, "        char *p = bst_sys_cstr(buf, 0, buf->len);\n");
  w_s(&mut out, "        if (!p) return bst_sys_fail();\n");
  w_s(&mut out, "        char t[4096];\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        long n = (errno = EINVAL, -1);   /* no symbolic links */\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        long n = (long)readlink(p, t, sizeof t);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        int e = errno;\n");
  w_s(&mut out, "        free(p);\n");
  w_s(&mut out, "        if (n < 0) return bst_sys_failw(e);\n");
  w_s(&mut out, "        bst_sys_set(buf, t, (size_t)n);\n");
  w_s(&mut out, "        return (uint64_t)n;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 31) {   /* the absolute path without links of *buf replaces it */\n");
  w_s(&mut out, "        char *p = bst_sys_cstr(buf, 0, buf->len);\n");
  w_s(&mut out, "        if (!p) return bst_sys_fail();\n");
  w_s(&mut out, "        char t[4096];\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        struct stat st;\n");
  w_s(&mut out, "        char *r = stat(p, &st) == 0 ? _fullpath(t, p, sizeof t) : NULL;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        char *r = realpath(p, t);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        int e = errno;\n");
  w_s(&mut out, "        free(p);\n");
  w_s(&mut out, "        if (!r) return bst_sys_failw(e);\n");
  w_s(&mut out, "        bst_sys_set(buf, t, strlen(t));\n");
  w_s(&mut out, "        return 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 32) {   /* the current directory replaces *buf */\n");
  w_s(&mut out, "        char t[4096];\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        if (!_getcwd(t, (int)sizeof t)) return bst_sys_fail();\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        if (!getcwd(t, sizeof t)) return bst_sys_fail();\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        bst_sys_set(buf, t, strlen(t));\n");
  w_s(&mut out, "        return 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 33) {   /* cut the file at descriptor a to b bytes */\n");
  w_s(&mut out, "        if (a > 0x7fffffff) return bst_sys_failw(EBADF);\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        int e = _chsize_s((int)a, (long long)b);\n");
  w_s(&mut out, "        return e == 0 ? 0 : bst_sys_failw(e);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        return ftruncate((int)a, (off_t)b) == 0 ? 0 : bst_sys_fail();\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 34) {   /* hard link: the two paths are *buf before and after byte a (existing, new) */\n");
  w_s(&mut out, "        if (a >= buf->len) return bst_sys_failw(EINVAL);\n");
  w_s(&mut out, "        char *x = bst_sys_cstr(buf, 0, a);\n");
  w_s(&mut out, "        if (!x) return bst_sys_fail();\n");
  w_s(&mut out, "        char *y = bst_sys_cstr(buf, a, buf->len);\n");
  w_s(&mut out, "        if (!y) { free(x); return bst_sys_fail(); }\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        int r = (errno = ENOSYS, -1);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        int r = link(x, y);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        int e = errno;\n");
  w_s(&mut out, "        free(x);\n");
  w_s(&mut out, "        free(y);\n");
  w_s(&mut out, "        return r != 0 ? bst_sys_failw(e) : 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 35) {   /* set the access time a and modification time b of the path *buf, in nanoseconds since 1970 */\n");
  w_s(&mut out, "        char *p = bst_sys_cstr(buf, 0, buf->len);\n");
  w_s(&mut out, "        if (!p) return bst_sys_fail();\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        struct _utimbuf ut;\n");
  w_s(&mut out, "        ut.actime = (time_t)(a / 1000000000u);\n");
  w_s(&mut out, "        ut.modtime = (time_t)(b / 1000000000u);\n");
  w_s(&mut out, "        int r = _utime(p, &ut);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        struct timespec ts[2];\n");
  w_s(&mut out, "        ts[0].tv_sec = (time_t)(a / 1000000000u); ts[0].tv_nsec = (long)(a % 1000000000u);\n");
  w_s(&mut out, "        ts[1].tv_sec = (time_t)(b / 1000000000u); ts[1].tv_nsec = (long)(b % 1000000000u);\n");
  w_s(&mut out, "        int r = utimensat(AT_FDCWD, p, ts, 0);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        int e = errno;\n");
  w_s(&mut out, "        free(p);\n");
  w_s(&mut out, "        return r != 0 ? bst_sys_failw(e) : 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 36) {   /* chmod the file at descriptor a to the bits b */\n");
  w_s(&mut out, "        if (a > 0x7fffffff) return bst_sys_failw(EBADF);\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "        return bst_sys_failw(ENOSYS);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        return fchmod((int)a, (mode_t)(b & 07777)) == 0 ? 0 : bst_sys_fail();\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 40) return (uint64_t)getpid();\n");
  w_s(&mut out, "    if (op == 41) {   /* is descriptor a a terminal? */\n");
  w_s(&mut out, "        if (a > 0x7fffffff) return 0;\n");
  w_s(&mut out, "        return isatty((int)a) ? 1 : 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    if (op == 51) {   /* a pipe: the read end, and the write end shifted up 32 bits */\n");
  w_s(&mut out, "        int p[2];\n");
  w_s(&mut out, "        if (_pipe(p, 65536, _O_BINARY | _O_NOINHERIT) != 0) return bst_sys_fail();\n");
  w_s(&mut out, "        return (uint64_t)(uint32_t)p[0] | (uint64_t)(uint32_t)p[1] << 32;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    if (op == 50) {   /* poll the descriptors in *buf (8 bytes each: fd s32, events s16, revents s16, little endian), waiting at most a ms (2^64 - 1: no limit) */\n");
  w_s(&mut out, "        if (buf->len % 8 != 0 || buf->len / 8 > 65536) return bst_sys_failw(EINVAL);\n");
  w_s(&mut out, "        size_t n = (size_t)(buf->len / 8);\n");
  w_s(&mut out, "        struct pollfd *fds = (struct pollfd *)malloc(n ? n * sizeof *fds : 1);\n");
  w_s(&mut out, "        if (!fds) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        for (size_t i = 0; i < n; i++) {\n");
  w_s(&mut out, "            const unsigned char *q = buf->data + 8 * i;\n");
  w_s(&mut out, "            fds[i].fd = (int)((uint32_t)q[0] | (uint32_t)q[1] << 8 | (uint32_t)q[2] << 16 | (uint32_t)q[3] << 24);\n");
  w_s(&mut out, "            fds[i].events = (short)(q[4] | q[5] << 8);\n");
  w_s(&mut out, "            fds[i].revents = 0;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        int ms = a == ~(uint64_t)0 ? -1 : a > 0x7fffffff ? 0x7fffffff : (int)a;\n");
  w_s(&mut out, "        int r = poll(fds, (nfds_t)n, ms);\n");
  w_s(&mut out, "        if (r < 0) { int e = errno; free(fds); return bst_sys_failw(e); }\n");
  w_s(&mut out, "        for (size_t i = 0; i < n; i++) {\n");
  w_s(&mut out, "            buf->data[8 * i + 6] = (unsigned char)((unsigned short)fds[i].revents & 255);\n");
  w_s(&mut out, "            buf->data[8 * i + 7] = (unsigned char)((unsigned short)fds[i].revents >> 8);\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        free(fds);\n");
  w_s(&mut out, "        return (uint64_t)r;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 51) {   /* a pipe: the read end, and the write end shifted up 32 bits */\n");
  w_s(&mut out, "        int p[2];\n");
  w_s(&mut out, "        if (pipe(p) != 0) return bst_sys_fail();\n");
  w_s(&mut out, "        fcntl(p[0], F_SETFD, FD_CLOEXEC);\n");
  w_s(&mut out, "        fcntl(p[1], F_SETFD, FD_CLOEXEC);\n");
  w_s(&mut out, "        return (uint64_t)(uint32_t)p[0] | (uint64_t)(uint32_t)p[1] << 32;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 52) {   /* descriptor a non-blocking (b = 1) or blocking (b = 0) */\n");
  w_s(&mut out, "        if (a > 0x7fffffff) return bst_sys_failw(EBADF);\n");
  w_s(&mut out, "        int fl = fcntl((int)a, F_GETFL, 0);\n");
  w_s(&mut out, "        if (fl < 0) return bst_sys_fail();\n");
  w_s(&mut out, "        fl = b ? (fl | O_NONBLOCK) : (fl & ~O_NONBLOCK);\n");
  w_s(&mut out, "        return fcntl((int)a, F_SETFL, fl) == 0 ? 0 : bst_sys_fail();\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#ifdef __linux__\n");
  w_s(&mut out, "    if (op == 53) {   /* a new epoll instance (close-on-exec) */\n");
  w_s(&mut out, "        int fd = epoll_create1(EPOLL_CLOEXEC);\n");
  w_s(&mut out, "        return fd < 0 ? bst_sys_fail() : (uint64_t)fd;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 54) {   /* epoll_ctl on instance a: b = the operation (1 add, 2 delete, 3 modify) | the descriptor << 8; *buf = the events (u32) and the data (u64), 12 bytes */\n");
  w_s(&mut out, "        if (a > 0x7fffffff || (b >> 8) > 0x7fffffff) return bst_sys_failw(EBADF);\n");
  w_s(&mut out, "        if (buf->len != 12 && (b & 255) != 2) return bst_sys_failw(EINVAL);\n");
  w_s(&mut out, "        struct epoll_event ev;\n");
  w_s(&mut out, "        memset(&ev, 0, sizeof ev);\n");
  w_s(&mut out, "        if (buf->len == 12) {\n");
  w_s(&mut out, "            ev.events = (uint32_t)buf->data[0] | (uint32_t)buf->data[1] << 8 | (uint32_t)buf->data[2] << 16 | (uint32_t)buf->data[3] << 24;\n");
  w_s(&mut out, "            ev.data.u64 = bst_sys_get64(buf->data + 4);\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        return epoll_ctl((int)a, (int)(b & 255), (int)(b >> 8), &ev) == 0 ? 0 : bst_sys_fail();\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 55) {   /* wait on instance a for at most b events (up to 1024) and the time limit in ms of the first 8 bytes of *buf; *buf is replaced with 12 bytes an event, as for 54 */\n");
  w_s(&mut out, "        if (a > 0x7fffffff) return bst_sys_failw(EBADF);\n");
  w_s(&mut out, "        if (buf->len < 8) return bst_sys_failw(EINVAL);\n");
  w_s(&mut out, "        uint64_t lim = bst_sys_get64(buf->data);\n");
  w_s(&mut out, "        int ms = lim == ~(uint64_t)0 ? -1 : lim > 0x7fffffff ? 0x7fffffff : (int)lim;\n");
  w_s(&mut out, "        if (b == 0 || b > 1024) b = b == 0 ? 1 : 1024;\n");
  w_s(&mut out, "        struct epoll_event evs[1024];\n");
  w_s(&mut out, "        int n = epoll_wait((int)a, evs, (int)b, ms);\n");
  w_s(&mut out, "        if (n < 0) return bst_sys_fail();\n");
  w_s(&mut out, "        unsigned char *out = (unsigned char *)malloc(n ? (size_t)n * 12 : 1);\n");
  w_s(&mut out, "        if (!out) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        for (int i = 0; i < n; i++) {\n");
  w_s(&mut out, "            unsigned char *q = out + 12 * i;\n");
  w_s(&mut out, "            uint32_t e = evs[i].events;\n");
  w_s(&mut out, "            q[0] = (unsigned char)e; q[1] = (unsigned char)(e >> 8); q[2] = (unsigned char)(e >> 16); q[3] = (unsigned char)(e >> 24);\n");
  w_s(&mut out, "            bst_sys_put64(q + 4, evs[i].data.u64);\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        free(buf->data);\n");
  w_s(&mut out, "        buf->data = out;\n");
  w_s(&mut out, "        buf->len = (uint64_t)n * 12;\n");
  w_s(&mut out, "        return (uint64_t)n;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    return bst_sys_failw(ENOSYS);\n");
  w_s(&mut out, "}\n");
}

/// The prelude part for `code_build`, `code_call` and `code_free` (stage1
/// only): added after the hosted prelude, and only to a program that calls
/// them. `bst_stencil_tab` and `BST_NSTENCILS` are the stencil table, which
/// the code generator writes after the prototypes.
fn cg_prelude_code(out: &mut Vec[u64]) {
  w_s(&mut out, "/* code_build, code_call and code_free (stage1, hosted): machine code built\n");
  w_s(&mut out, " * from a plan that can only call the program's stencils (proved Bastio\n");
  w_s(&mut out, " * functions, numbered by stencil(f)), compute on sixteen registers of its\n");
  w_s(&mut out, " * own, read and write the Vec[u64] fields of the stencils' context that\n");
  w_s(&mut out, " * code_field(name) numbers, and branch within itself. The plan is a list of\n");
  w_s(&mut out, " * items, each an opcode word and its operands:\n");
  w_s(&mut out, " *   0 CALL k a b c d   call stencil k with (ctx, a, b, c, d); its result is\n");
  w_s(&mut out, " *                      the current value (0 when the code is entered)\n");
  w_s(&mut out, " *   1 BRZ L, 2 BRNZ L  go to item L if the current value is 0 / is not 0\n");
  w_s(&mut out, " *   3 BREQ v L         go to item L if the current value is v\n");
  w_s(&mut out, " *   4 JMP L            go to item L\n");
  w_s(&mut out, " *   5 RET, 6 RETI v    return the current value / v\n");
  w_s(&mut out, " *   7 ENTRY L          entry point n (counting ENTRY items) starts at item L\n");
  w_s(&mut out, " *   8 CONST d x        r[d] = x\n");
  w_s(&mut out, " *   9 MOV d a          r[d] = r[a]\n");
  w_s(&mut out, " *  10 ALU op d a b     r[d] = r[a] op r[b]; op: 0 add, 1 sub, 2 mul, 3 and,\n");
  w_s(&mut out, " *                      4 or, 5 xor, 6 shl, 7 sar, 8 shr (shifts by the count\n");
  w_s(&mut out, " *                      mod 64; add, sub and mul wrap at 64 bits)\n");
  w_s(&mut out, " *  11 ALUI op d a x    r[d] = r[a] op x\n");
  w_s(&mut out, " *  12 ALU32 op d a b L r[d] = r[a] op r[b] for op 0 add, 1 sub or 2 mul, but\n");
  w_s(&mut out, " *                      go to item L, leaving r[d] as it was, if the 64-bit\n");
  w_s(&mut out, " *                      result is not the sign extension of its low 32 bits\n");
  w_s(&mut out, " *  13 CMPBR c a b L    go to item L if r[a] c r[b]; c: 0 eq, 1 ne, 2 lt, 3 le,\n");
  w_s(&mut out, " *                      4 gt, 5 ge (signed), 6 lt, 7 le, 8 gt, 9 ge (unsigned)\n");
  w_s(&mut out, " *  14 CMPBRI c a x L   go to item L if r[a] c x\n");
  w_s(&mut out, " *  15 GETCUR d         r[d] = the current value\n");
  w_s(&mut out, " *  16 SETCUR a         the current value = r[a]\n");
  w_s(&mut out, " *  17 LOAD d f b i L   r[d] = field f [ r[b] + r[i] ] of the context; go to\n");
  w_s(&mut out, " *                      item L, leaving r[d] as it was, if the index is not\n");
  w_s(&mut out, " *                      below the field's length now\n");
  w_s(&mut out, " *  18 STORE f b i s L  field f [ r[b] + r[i] ] = r[s], or go to item L\n");
  w_s(&mut out, " *  19 CALLR k a b c d  as CALL, with the arguments r[a], r[b], r[c], r[d]\n");
  w_s(&mut out, " *  20 FALU op d a b    r[d] = r[a] op r[b] as doubles (the registers hold their\n");
  w_s(&mut out, " *                      bits); op: 0 add, 1 sub, 2 mul, 3 div\n");
  w_s(&mut out, " *  21 FUN op d a       r[d] = op r[a] as a double; op: 0 sqrt, 1 neg, 2 abs, 3 the\n");
  w_s(&mut out, " *                      signed integer r[a] as a double, 4 r[a] as a double cut\n");
  w_s(&mut out, " *                      towards 0 to a signed integer (NaN and out of range: 2^63)\n");
  w_s(&mut out, " *  22 FCMPBR c a b L   go to item L if r[a] c r[b] as doubles; c: 0 eq, 1 ne, 2 lt,\n");
  w_s(&mut out, " *                      3 le, 4 gt, 5 ge (false for a NaN, except ne)\n");
  w_s(&mut out, " *  23 LOADF d f i L    r[d] = the scalar member (bool or unsigned, zero-extended) of element\n");
  w_s(&mut out, " *                      r[i] of the Vec[S] field f, i.e. code_field(path, member); go to L if\n");
  w_s(&mut out, " *                      the index is not below the length now\n");
  w_s(&mut out, " *  24 STOREF f i s L   that member = the low bits of r[s], or go to L\n");
  w_s(&mut out, " *  25 LOADIN d f i j L r[d] = element r[j] of the Vec[u64] member of element r[i] of f; go to\n");
  w_s(&mut out, " *                      L if either index is not below its length now\n");
  w_s(&mut out, " *  26 STOREIN f i j s L  that element = r[s], or go to L\n");
  w_s(&mut out, " *  27 LEN d f          r[d] = the length of field f now\n");
  w_s(&mut out, " *  28 LENIN d f i L    r[d] = the length of the Vec[u64] member of element r[i]; or go to L\n");
  w_s(&mut out, " *  29 INDJMP a         go to the body of entry point r[a] (numbered by ENTRY, from 0), keeping the\n");
  w_s(&mut out, " *                      registers; if r[a] is not an entry's number, the next item runs\n");
  w_s(&mut out, " * The registers are 0 when the code is entered. L is the word offset of an\n");
  w_s(&mut out, " * item in the plan; f is a number from code_field. Running off the end\n");
  w_s(&mut out, " * returns the current value. A plan that breaks a rule (an unknown opcode, a\n");
  w_s(&mut out, " * missing operand, a register above 15, k or f outside its table, L not an\n");
  w_s(&mut out, " * item) builds nothing: the id is 0. Pages are written while read-write,\n");
  w_s(&mut out, " * then made read-execute: never both (W^X). An id is never reused; calling a\n");
  w_s(&mut out, " * freed or unknown id, or an entry that does not exist, returns 0, and a\n");
  w_s(&mut out, " * region freed while it runs is unmapped when the last call into it returns.\n");
  w_s(&mut out, " * The code reads a field's length and data pointer from the context each\n");
  w_s(&mut out, " * time, so a stencil that grows the Vec cannot leave it a stale one, and an\n");
  w_s(&mut out, " * index is compared with the length before every access. x86-64 on Linux,\n");
  w_s(&mut out, " * macOS and the BSDs; elsewhere code_build returns 0, so programs fall back\n");
  w_s(&mut out, " * on what they would do without machine code. Not thread-safe. */\n");
  w_s(&mut out, "#include <stddef.h>\n");
  w_s(&mut out, "typedef void (*bst_stencil_fn)(void);\n");
  w_s(&mut out, "typedef struct { unsigned char *mem; size_t size; uint64_t nentry; uint32_t *entry; uint64_t running; int freed; } bst_code_region;\n");
  w_s(&mut out, "static bst_code_region *bst_codes;\n");
  w_s(&mut out, "static uint64_t bst_ncodes, bst_capcodes;\n");
  w_s(&mut out, "#if defined(__x86_64__) && (defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__))\n");
  w_s(&mut out, "#include <sys/mman.h>\n");
  w_s(&mut out, "#include <unistd.h>\n");
  w_s(&mut out, "#ifndef MAP_ANONYMOUS              /* hidden by _POSIX_C_SOURCE alone */\n");
  w_s(&mut out, "#ifdef __linux__\n");
  w_s(&mut out, "#define MAP_ANONYMOUS 0x20\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "#define MAP_ANONYMOUS 0x1000\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "#define BST_CODE_X86 1\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "#ifdef BST_CODE_X86\n");
  w_s(&mut out, "/* rbx holds the context and r12 the current value; registers 0 to 3 live in\n");
  w_s(&mut out, " * r13, r14, r15 and rbp and the others in the frame at 32(%rsp)..120(%rsp),\n");
  w_s(&mut out, " * with rax, rcx and rdx as scratch. */\n");
  w_s(&mut out, "#define BST_CODE_STUB 52u\n");
  w_s(&mut out, "#define BST_CODE_EPI 18u       /* add $136,%rsp; pop %rbp, %r15..%r12, %rbx; ret */\n");
  w_s(&mut out, "/* The length in words of the item at plan[i] (0: not a valid item). */\n");
  w_s(&mut out, "static uint64_t bst_code_ilen(const uint64_t *w, uint64_t n, uint64_t i) {\n");
  w_s(&mut out, "    static const uint64_t lens[30] = { 6, 2, 2, 3, 2, 1, 2, 2, 3, 3, 5, 5, 6, 5, 5, 2, 2, 6, 6, 6, 5, 4, 5, 5, 5, 6, 6, 3, 5, 2 };\n");
  w_s(&mut out, "    if (i >= n || w[i] > 29 || lens[w[i]] > n - i) return 0;\n");
  w_s(&mut out, "    return lens[w[i]];\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static unsigned bst_code_imm(uint64_t x) { return x <= 0xffffffffu ? 5u : 10u; }\n");
  w_s(&mut out, "/* Does the item's operands name registers and operations that exist? */\n");
  w_s(&mut out, "static int bst_code_ops_ok(const uint64_t *w, uint64_t i, uint64_t ntab, uint64_t nfield, const uint64_t *etab) {\n");
  w_s(&mut out, "    switch (w[i]) {\n");
  w_s(&mut out, "    case 0: return w[i + 1] < ntab;\n");
  w_s(&mut out, "    case 8: return w[i + 1] < 16;\n");
  w_s(&mut out, "    case 9: return w[i + 1] < 16 && w[i + 2] < 16;\n");
  w_s(&mut out, "    case 10: return w[i + 1] <= 8 && w[i + 2] < 16 && w[i + 3] < 16 && w[i + 4] < 16;\n");
  w_s(&mut out, "    case 11: return w[i + 1] <= 8 && w[i + 2] < 16 && w[i + 3] < 16;\n");
  w_s(&mut out, "    case 12: return w[i + 1] <= 2 && w[i + 2] < 16 && w[i + 3] < 16 && w[i + 4] < 16;\n");
  w_s(&mut out, "    case 13: return w[i + 1] <= 9 && w[i + 2] < 16 && w[i + 3] < 16;\n");
  w_s(&mut out, "    case 14: return w[i + 1] <= 9 && w[i + 2] < 16;\n");
  w_s(&mut out, "    case 15: case 16: return w[i + 1] < 16;\n");
  w_s(&mut out, "    case 17: return w[i + 1] < 16 && w[i + 2] < nfield && etab[4 * w[i + 2] + 2] == 0 && w[i + 3] < 16 && w[i + 4] < 16;\n");
  w_s(&mut out, "    case 18: return w[i + 1] < nfield && etab[4 * w[i + 1] + 2] == 0 && w[i + 2] < 16 && w[i + 3] < 16 && w[i + 4] < 16;\n");
  w_s(&mut out, "    case 19: return w[i + 1] < ntab && w[i + 2] < 16 && w[i + 3] < 16 && w[i + 4] < 16 && w[i + 5] < 16;\n");
  w_s(&mut out, "    case 20: return w[i + 1] <= 3 && w[i + 2] < 16 && w[i + 3] < 16 && w[i + 4] < 16;\n");
  w_s(&mut out, "    case 21: return w[i + 1] <= 4 && w[i + 2] < 16 && w[i + 3] < 16;\n");
  w_s(&mut out, "    case 22: return w[i + 1] <= 5 && w[i + 2] < 16 && w[i + 3] < 16;\n");
  w_s(&mut out, "    case 23: return w[i + 1] < 16 && w[i + 2] < nfield && etab[4 * w[i + 2] + 2] == 3 && w[i + 3] < 16;\n");
  w_s(&mut out, "    case 24: return w[i + 1] < nfield && etab[4 * w[i + 1] + 2] == 3 && w[i + 2] < 16 && w[i + 3] < 16;\n");
  w_s(&mut out, "    case 25: return w[i + 1] < 16 && w[i + 2] < nfield && etab[4 * w[i + 2] + 2] == 2 && w[i + 3] < 16 && w[i + 4] < 16;\n");
  w_s(&mut out, "    case 26: return w[i + 1] < nfield && etab[4 * w[i + 1] + 2] == 2 && w[i + 2] < 16 && w[i + 3] < 16 && w[i + 4] < 16;\n");
  w_s(&mut out, "    case 27: return w[i + 1] < 16 && w[i + 2] < nfield;\n");
  w_s(&mut out, "    case 28: return w[i + 1] < 16 && w[i + 2] < nfield && etab[4 * w[i + 2] + 2] == 2 && w[i + 3] < 16;\n");
  w_s(&mut out, "    case 29: return w[i + 1] < 16;\n");
  w_s(&mut out, "    default: return 1;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Does the item at plan[i] have a label operand? Then *l is it. A label is\n");
  w_s(&mut out, " * a word offset: any 64-bit value, so there is no in-band \"none\". */\n");
  w_s(&mut out, "static int bst_code_label(const uint64_t *w, uint64_t i, uint64_t *l) {\n");
  w_s(&mut out, "    switch (w[i]) {\n");
  w_s(&mut out, "    case 1: case 2: case 4: case 7: *l = w[i + 1]; return 1;\n");
  w_s(&mut out, "    case 3: *l = w[i + 2]; return 1;\n");
  w_s(&mut out, "    case 12: case 17: case 18: case 25: case 26: *l = w[i + 5]; return 1;\n");
  w_s(&mut out, "    case 23: case 24: case 28: *l = w[i + 4]; return 1;\n");
  w_s(&mut out, "    case 13: case 14: case 22: *l = w[i + 4]; return 1;\n");
  w_s(&mut out, "    default: *l = 0; return 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static unsigned bst_code_alu_len(uint64_t op) { return op == 2 ? 4u : 3u; }\n");
  w_s(&mut out, "/* The bytes of a move between register v and rax, rcx or rdx. */\n");
  w_s(&mut out, "static unsigned bst_code_vl(uint64_t v) { return v < 4 ? 3u : 5u; }\n");
  w_s(&mut out, "/* The machine code bytes of the item at plan[i]. */\n");
  w_s(&mut out, "/* The bytes of the move of a scalar member of size sz between rax or rcx and (disp32(%rdx)). */\n");
  w_s(&mut out, "static unsigned bst_code_msz(uint64_t sz) { return sz == 4 ? 6u : 7u; }\n");
  w_s(&mut out, "static unsigned bst_code_msz_st(uint64_t sz) { return sz == 8 || sz == 2 ? 7u : 6u; }\n");
  w_s(&mut out, "/* The bytes of bst_code_elem for index register i. */\n");
  w_s(&mut out, "static unsigned bst_code_elem_len(uint64_t i) { return bst_code_vl(i) + 33u; }\n");
  w_s(&mut out, "static uint64_t bst_code_isize(const uint64_t *w, uint64_t i, const uint64_t *etab) {\n");
  w_s(&mut out, "    switch (w[i]) {\n");
  w_s(&mut out, "    case 0: return 3 + bst_code_imm(w[i + 2]) + bst_code_imm(w[i + 3]) + bst_code_imm(w[i + 4])\n");
  w_s(&mut out, "                 + (w[i + 5] <= 0xffffffffu ? 6u : 10u) + 12 + 3;\n");
  w_s(&mut out, "    case 1: case 2: return 9;\n");
  w_s(&mut out, "    case 3: return (w[i + 1] < 0x80000000u ? 7u : 13u) + 6;\n");
  w_s(&mut out, "    case 4: return 5;\n");
  w_s(&mut out, "    case 5: return 3 + BST_CODE_EPI;\n");
  w_s(&mut out, "    case 6: return bst_code_imm(w[i + 1]) + BST_CODE_EPI;\n");
  w_s(&mut out, "    case 8: return (w[i + 2] < 0x80000000u ? 7u : 10u) + bst_code_vl(w[i + 1]);\n");
  w_s(&mut out, "    case 9: return bst_code_vl(w[i + 2]) + bst_code_vl(w[i + 1]);\n");
  w_s(&mut out, "    case 10: return bst_code_vl(w[i + 3]) + bst_code_vl(w[i + 4]) + bst_code_alu_len(w[i + 1]) + bst_code_vl(w[i + 2]);\n");
  w_s(&mut out, "    case 11: return bst_code_vl(w[i + 3]) + (w[i + 4] <= 0xffffffffu ? 5u : 10u) + bst_code_alu_len(w[i + 1]) + bst_code_vl(w[i + 2]);\n");
  w_s(&mut out, "    case 12: return bst_code_vl(w[i + 3]) + bst_code_vl(w[i + 4]) + bst_code_alu_len(w[i + 1]) + 3 + 3 + 6 + bst_code_vl(w[i + 2]);\n");
  w_s(&mut out, "    case 13: return bst_code_vl(w[i + 2]) + bst_code_vl(w[i + 3]) + 3 + 6;\n");
  w_s(&mut out, "    case 14: return bst_code_vl(w[i + 2]) + (w[i + 3] <= 0xffffffffu ? 5u : 10u) + 3 + 6;\n");
  w_s(&mut out, "    case 15: return 3 + bst_code_vl(w[i + 1]);\n");
  w_s(&mut out, "    case 16: return bst_code_vl(w[i + 1]) + 3;\n");
  w_s(&mut out, "    case 17: return bst_code_vl(w[i + 3]) + bst_code_vl(w[i + 4]) + 3 + 7 + 9 + 7 + 4 + bst_code_vl(w[i + 1]);\n");
  w_s(&mut out, "    case 18: return bst_code_vl(w[i + 2]) + bst_code_vl(w[i + 3]) + 3 + 7 + 9 + 7 + bst_code_vl(w[i + 4]) + 4;\n");
  w_s(&mut out, "    case 19: return 3 + bst_code_vl(w[i + 2]) + bst_code_vl(w[i + 3]) + bst_code_vl(w[i + 4]) + bst_code_vl(w[i + 5]) + 12 + 10 + 2 + 3;\n");
  w_s(&mut out, "    case 20: return bst_code_vl(w[i + 3]) + bst_code_vl(w[i + 4]) + 5 + 5 + 4 + 5 + bst_code_vl(w[i + 2]);\n");
  w_s(&mut out, "    case 21: return bst_code_vl(w[i + 3]) + (w[i + 1] == 1 || w[i + 1] == 2 ? 5u : w[i + 1] == 0 ? 14u : 10u) + bst_code_vl(w[i + 2]);\n");
  w_s(&mut out, "    case 22: return bst_code_vl(w[i + 2]) + bst_code_vl(w[i + 3]) + 5 + 5 + 4 + (w[i + 1] == 0 ? 8u : w[i + 1] == 1 ? 12u : 6u);\n");
  w_s(&mut out, "    case 23: return bst_code_elem_len(w[i + 3]) + bst_code_msz(etab[4 * w[i + 2] + 3]) + bst_code_vl(w[i + 1]);\n");
  w_s(&mut out, "    case 24: return bst_code_elem_len(w[i + 2]) + bst_code_vl(w[i + 3]) + bst_code_msz_st(etab[4 * w[i + 1] + 3]);\n");
  w_s(&mut out, "    case 25: return bst_code_elem_len(w[i + 3]) + 7 + bst_code_vl(w[i + 4]) + 3 + 6 + 7 + 4 + bst_code_vl(w[i + 1]);\n");
  w_s(&mut out, "    case 26: return bst_code_elem_len(w[i + 2]) + 7 + bst_code_vl(w[i + 3]) + 3 + 6 + 7 + bst_code_vl(w[i + 4]) + 4;\n");
  w_s(&mut out, "    case 27: return 7 + bst_code_vl(w[i + 1]);\n");
  w_s(&mut out, "    case 28: return bst_code_elem_len(w[i + 3]) + 7 + bst_code_vl(w[i + 1]);\n");
  w_s(&mut out, "    case 29: return bst_code_vl(w[i + 1]) + 28;\n");
  w_s(&mut out, "    default: return 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_code_put(unsigned char **p, const char *bytes, unsigned n) { memcpy(*p, bytes, n); *p += n; }\n");
  w_s(&mut out, "static void bst_code_u32(unsigned char **p, uint32_t x) { memcpy(*p, &x, 4); *p += 4; }\n");
  w_s(&mut out, "static void bst_code_u64(unsigned char **p, uint64_t x) { memcpy(*p, &x, 8); *p += 8; }\n");
  w_s(&mut out, "/* mov $x into the register of mov-immediate opcode op (%eax..%edi), in 32\n");
  w_s(&mut out, " * bits (which clears the top half) when x fits. */\n");
  w_s(&mut out, "static void bst_code_mov(unsigned char **p, unsigned op, uint64_t x) {\n");
  w_s(&mut out, "    if (x <= 0xffffffffu) {\n");
  w_s(&mut out, "        *(*p)++ = (unsigned char)op;\n");
  w_s(&mut out, "        bst_code_u32(p, (uint32_t)x);\n");
  w_s(&mut out, "    } else {\n");
  w_s(&mut out, "        *(*p)++ = 0x48;\n");
  w_s(&mut out, "        *(*p)++ = (unsigned char)op;\n");
  w_s(&mut out, "        bst_code_u64(p, x);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_code_rel(unsigned char **p, const unsigned char *mem, const uint32_t *off, uint64_t l) {\n");
  w_s(&mut out, "    int64_t d = (int64_t)off[l] - (int64_t)((*p + 4) - mem);\n");
  w_s(&mut out, "    bst_code_u32(p, (uint32_t)(int32_t)d);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Register r (0 rax, 1 rcx, 2 rdx) from or to register v (0 to 3 in r13, r14,\n");
  w_s(&mut out, " * r15, rbp; the others in the frame slot v). */\n");
  w_s(&mut out, "static void bst_code_ld(unsigned char **p, unsigned r, uint64_t v) {\n");
  w_s(&mut out, "    if (v < 4) {\n");
  w_s(&mut out, "        *(*p)++ = v < 3 ? 0x4c : 0x48;                       /* mov %r13..%r15 / %rbp,%r */\n");
  w_s(&mut out, "        *(*p)++ = 0x89;\n");
  w_s(&mut out, "        *(*p)++ = (unsigned char)(0xc0 | ((5 + (v == 3 ? 0 : v)) << 3) | r);\n");
  w_s(&mut out, "        return;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    *(*p)++ = 0x48; *(*p)++ = 0x8b; *(*p)++ = (unsigned char)(0x44 | (r << 3)); *(*p)++ = 0x24; *(*p)++ = (unsigned char)(8 * v);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_code_st(unsigned char **p, uint64_t v, unsigned r) {\n");
  w_s(&mut out, "    if (v < 4) {\n");
  w_s(&mut out, "        *(*p)++ = v < 3 ? 0x49 : 0x48;                       /* mov %r,%r13..%r15 / %rbp */\n");
  w_s(&mut out, "        *(*p)++ = 0x89;\n");
  w_s(&mut out, "        *(*p)++ = (unsigned char)(0xc0 | (r << 3) | (5 + (v == 3 ? 0 : v)));\n");
  w_s(&mut out, "        return;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    *(*p)++ = 0x48; *(*p)++ = 0x89; *(*p)++ = (unsigned char)(0x44 | (r << 3)); *(*p)++ = 0x24; *(*p)++ = (unsigned char)(8 * v);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* rax = rax op rcx. */\n");
  w_s(&mut out, "static void bst_code_alu(unsigned char **p, uint64_t op) {\n");
  w_s(&mut out, "    static const unsigned char two[9][4] = {\n");
  w_s(&mut out, "        { 0x48, 0x01, 0xc8, 0 }, { 0x48, 0x29, 0xc8, 0 }, { 0x48, 0x0f, 0xaf, 0xc1 },\n");
  w_s(&mut out, "        { 0x48, 0x21, 0xc8, 0 }, { 0x48, 0x09, 0xc8, 0 }, { 0x48, 0x31, 0xc8, 0 },\n");
  w_s(&mut out, "        { 0x48, 0xd3, 0xe0, 0 }, { 0x48, 0xd3, 0xf8, 0 }, { 0x48, 0xd3, 0xe8, 0 } };\n");
  w_s(&mut out, "    bst_code_put(p, (const char *)two[op], bst_code_alu_len(op));\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* rcx = x. */\n");
  w_s(&mut out, "static void bst_code_rcx(unsigned char **p, uint64_t x) { bst_code_mov(p, 0xb9, x); }\n");
  w_s(&mut out, "/* The conditional jumps' second opcode byte for conditions 0..9. */\n");
  w_s(&mut out, "static const unsigned char bst_code_jcc[10] = { 0x84, 0x85, 0x8c, 0x8e, 0x8f, 0x8d, 0x82, 0x86, 0x87, 0x83 };\n");
  w_s(&mut out, "/* rax = r[b] + r[i]; if that is not below the length of field f, go to label l;\n");
  w_s(&mut out, " * rdx = the field's data pointer. */\n");
  w_s(&mut out, "static void bst_code_index(unsigned char **p, const unsigned char *mem, const uint32_t *off, uint64_t b, uint64_t ix, uint64_t f, uint64_t l, const uint64_t *ftab) {\n");
  w_s(&mut out, "    bst_code_ld(p, 0, b);\n");
  w_s(&mut out, "    bst_code_ld(p, 1, ix);\n");
  w_s(&mut out, "    bst_code_put(p, \"\\x48\\x01\\xc8\", 3);                                    /* add %rcx,%rax */\n");
  w_s(&mut out, "    bst_code_put(p, \"\\x48\\x8b\\x93\", 3);                                    /* mov len(%rbx),%rdx */\n");
  w_s(&mut out, "    bst_code_u32(p, (uint32_t)(ftab[f] + offsetof(bst_vec, len)));\n");
  w_s(&mut out, "    bst_code_put(p, \"\\x48\\x39\\xd0\\x0f\\x83\", 5);                           /* cmp %rdx,%rax; jae l */\n");
  w_s(&mut out, "    bst_code_rel(p, mem, off, l);\n");
  w_s(&mut out, "    bst_code_put(p, \"\\x48\\x8b\\x93\", 3);                                    /* mov data(%rbx),%rdx */\n");
  w_s(&mut out, "    bst_code_u32(p, (uint32_t)(ftab[f] + offsetof(bst_vec, data)));\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* rdx = the address of element r[i] of the Vec field f, or go to label l if the\n");
  w_s(&mut out, " * index is not below the length now. */\n");
  w_s(&mut out, "static void bst_code_elem(unsigned char **p, const unsigned char *mem, const uint32_t *off, uint64_t ix, uint64_t f, uint64_t l, const uint64_t *ftab, const uint64_t *etab) {\n");
  w_s(&mut out, "    bst_code_ld(p, 0, ix);\n");
  w_s(&mut out, "    bst_code_put(p, \"\\x48\\x8b\\x93\", 3);                                    /* mov len(%rbx),%rdx */\n");
  w_s(&mut out, "    bst_code_u32(p, (uint32_t)(ftab[f] + offsetof(bst_vec, len)));\n");
  w_s(&mut out, "    bst_code_put(p, \"\\x48\\x39\\xd0\\x0f\\x83\", 5);                           /* cmp %rdx,%rax; jae l */\n");
  w_s(&mut out, "    bst_code_rel(p, mem, off, l);\n");
  w_s(&mut out, "    bst_code_put(p, \"\\x48\\x69\\xc0\", 3);                                    /* imul $size,%rax,%rax */\n");
  w_s(&mut out, "    bst_code_u32(p, (uint32_t)etab[4 * f]);\n");
  w_s(&mut out, "    bst_code_put(p, \"\\x48\\x8b\\x93\", 3);                                    /* mov data(%rbx),%rdx */\n");
  w_s(&mut out, "    bst_code_u32(p, (uint32_t)(ftab[f] + offsetof(bst_vec, data)));\n");
  w_s(&mut out, "    bst_code_put(p, \"\\x48\\x01\\xc2\", 3);                                    /* add %rax,%rdx */\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Go to label l unless r[j] is below the length of the Vec member f of the element at rdx; then\n");
  w_s(&mut out, " * rdx = its data pointer and rcx = r[j]. */\n");
  w_s(&mut out, "static void bst_code_inner(unsigned char **p, const unsigned char *mem, const uint32_t *off, uint64_t j, uint64_t f, uint64_t l, const uint64_t *etab) {\n");
  w_s(&mut out, "    bst_code_put(p, \"\\x48\\x8b\\x82\", 3);                                    /* mov len(%rdx),%rax */\n");
  w_s(&mut out, "    bst_code_u32(p, (uint32_t)(etab[4 * f + 1] + offsetof(bst_vec, len)));\n");
  w_s(&mut out, "    bst_code_ld(p, 1, j);\n");
  w_s(&mut out, "    bst_code_put(p, \"\\x48\\x39\\xc1\\x0f\\x83\", 5);                           /* cmp %rax,%rcx; jae l */\n");
  w_s(&mut out, "    bst_code_rel(p, mem, off, l);\n");
  w_s(&mut out, "    bst_code_put(p, \"\\x48\\x8b\\x92\", 3);                                    /* mov data(%rdx),%rdx */\n");
  w_s(&mut out, "    bst_code_u32(p, (uint32_t)(etab[4 * f + 1] + offsetof(bst_vec, data)));\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static uint64_t bst_code_build_(bst_host h, bst_vec plan, const bst_stencil_fn *tab, uint64_t ntab, const uint64_t *ftab, const uint64_t *etab, uint64_t nfield) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "#ifdef BST_CODE_X86\n");
  w_s(&mut out, "    const uint64_t *w = (const uint64_t *)plan.data;\n");
  w_s(&mut out, "    uint64_t n = plan.len, i, nentry = 0;\n");
  w_s(&mut out, "    int has29 = 0;\n");
  w_s(&mut out, "    if (n == 0 || n > (1u << 24)) return 0;\n");
  w_s(&mut out, "    for (i = 0; i < nfield; i++) {\n");
  w_s(&mut out, "        if (ftab[i] + sizeof(bst_vec) >= 0x7fffffffu || etab[4 * i] >= 0x7fffffffu || etab[4 * i + 1] + sizeof(bst_vec) >= 0x7fffffffu) return 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    /* Pass 1: every item well formed; each item's code offset. */\n");
  w_s(&mut out, "    uint32_t *off = (uint32_t *)calloc(n + 1, sizeof(uint32_t));\n");
  w_s(&mut out, "    unsigned char *start = (unsigned char *)calloc(n + 1, 1);\n");
  w_s(&mut out, "    if (!off || !start) { free(off); free(start); return 0; }\n");
  w_s(&mut out, "    for (i = 0; i < n; i += bst_code_ilen(w, n, i)) {\n");
  w_s(&mut out, "        uint64_t l = bst_code_ilen(w, n, i);\n");
  w_s(&mut out, "        if (l == 0 || !bst_code_ops_ok(w, i, ntab, nfield, etab)) { free(off); free(start); return 0; }\n");
  w_s(&mut out, "        start[i] = 1;\n");
  w_s(&mut out, "        if (w[i] == 7) nentry++;\n");
  w_s(&mut out, "        if (w[i] == 29) has29 = 1;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    start[n] = 1;\n");
  w_s(&mut out, "    uint64_t size = BST_CODE_STUB * nentry;\n");
  w_s(&mut out, "    for (i = 0; i < n; i += bst_code_ilen(w, n, i)) {\n");
  w_s(&mut out, "        off[i] = (uint32_t)size;\n");
  w_s(&mut out, "        size += bst_code_isize(w, i, etab);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    off[n] = (uint32_t)size;\n");
  w_s(&mut out, "    size += 3 + BST_CODE_EPI;\n");
  w_s(&mut out, "    uint64_t tabpos = size;\n");
  w_s(&mut out, "    if (has29) size += 4 * nentry;     /* the entry points' addresses, for item 29 */\n");
  w_s(&mut out, "    /* Pass 2: every label an item (or the end). */\n");
  w_s(&mut out, "    for (i = 0; i < n; i += bst_code_ilen(w, n, i)) {\n");
  w_s(&mut out, "        uint64_t l;\n");
  w_s(&mut out, "        if (bst_code_label(w, i, &l) && (l > n || !start[l])) { free(off); free(start); return 0; }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    free(start);\n");
  w_s(&mut out, "    long pg = sysconf(_SC_PAGESIZE);\n");
  w_s(&mut out, "    if (pg <= 0) pg = 4096;\n");
  w_s(&mut out, "    size_t mapped = (size_t)((size + (uint64_t)pg - 1) / (uint64_t)pg * (uint64_t)pg);\n");
  w_s(&mut out, "    void *m = mmap(NULL, mapped, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);\n");
  w_s(&mut out, "    uint32_t *entry = (uint32_t *)malloc((nentry ? nentry : 1) * sizeof(uint32_t));\n");
  w_s(&mut out, "    if (m == MAP_FAILED || !entry) { if (m != MAP_FAILED) munmap(m, mapped); free(entry); free(off); return 0; }\n");
  w_s(&mut out, "    unsigned char *mem = (unsigned char *)m, *p = mem;\n");
  w_s(&mut out, "    /* The entry stubs: save rbx and r12, keep ctx in rbx, make the frame, zero\n");
  w_s(&mut out, "     * the registers and the current value. */\n");
  w_s(&mut out, "    uint64_t e = 0;\n");
  w_s(&mut out, "    for (i = 0; i < n; i += bst_code_ilen(w, n, i)) {\n");
  w_s(&mut out, "        if (w[i] != 7) continue;\n");
  w_s(&mut out, "        entry[e++] = (uint32_t)(p - mem);\n");
  w_s(&mut out, "        bst_code_put(&p, \"\\x53\\x41\\x54\\x41\\x55\\x41\\x56\\x41\\x57\\x55\", 10); /* push %rbx, %r12..%r15, %rbp */\n");
  w_s(&mut out, "        bst_code_put(&p, \"\\x48\\x89\\xfb\\x48\\x81\\xec\\x88\\x00\\x00\\x00\", 10); /* mov %rdi,%rbx; sub $136,%rsp */\n");
  w_s(&mut out, "        bst_code_put(&p, \"\\x48\\x89\\xe7\\xb9\\x10\\x00\\x00\\x00\\x31\\xc0\", 10); /* mov %rsp,%rdi; mov $16,%ecx; xor %eax,%eax */\n");
  w_s(&mut out, "        bst_code_put(&p, \"\\xf3\\x48\\xab\", 3);                                    /* rep stosq */\n");
  w_s(&mut out, "        bst_code_put(&p, \"\\x45\\x31\\xe4\\x45\\x31\\xed\\x45\\x31\\xf6\\x45\\x31\\xff\\x31\\xed\\xe9\", 15); /* zero r12..r15, ebp; jmp */\n");
  w_s(&mut out, "        bst_code_rel(&p, mem, off, w[i + 1]);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    for (i = 0; i < n; i += bst_code_ilen(w, n, i)) {\n");
  w_s(&mut out, "        switch (w[i]) {\n");
  w_s(&mut out, "        case 0: case 19:\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x48\\x89\\xdf\", 3);                          /* mov %rbx,%rdi */\n");
  w_s(&mut out, "            if (w[i] == 0) {\n");
  w_s(&mut out, "                bst_code_mov(&p, 0xbe, w[i + 2]);                         /* %rsi */\n");
  w_s(&mut out, "                bst_code_mov(&p, 0xba, w[i + 3]);                         /* %rdx */\n");
  w_s(&mut out, "                bst_code_mov(&p, 0xb9, w[i + 4]);                         /* %rcx */\n");
  w_s(&mut out, "                if (w[i + 5] <= 0xffffffffu) {                               /* %r8 */\n");
  w_s(&mut out, "                    bst_code_put(&p, \"\\x41\\xb8\", 2); bst_code_u32(&p, (uint32_t)w[i + 5]);\n");
  w_s(&mut out, "                } else {\n");
  w_s(&mut out, "                    bst_code_put(&p, \"\\x49\\xb8\", 2); bst_code_u64(&p, w[i + 5]);\n");
  w_s(&mut out, "                }\n");
  w_s(&mut out, "            } else {\n");
  w_s(&mut out, "                bst_code_ld(&p, 0, w[i + 2]); bst_code_put(&p, \"\\x48\\x89\\xc6\", 3);   /* %rsi */\n");
  w_s(&mut out, "                bst_code_ld(&p, 0, w[i + 3]); bst_code_put(&p, \"\\x48\\x89\\xc2\", 3);   /* %rdx */\n");
  w_s(&mut out, "                bst_code_ld(&p, 0, w[i + 4]); bst_code_put(&p, \"\\x48\\x89\\xc1\", 3);   /* %rcx */\n");
  w_s(&mut out, "                bst_code_ld(&p, 0, w[i + 5]); bst_code_put(&p, \"\\x49\\x89\\xc0\", 3);   /* %r8 */\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x48\\xb8\", 2);                              /* movabs $fn,%rax */\n");
  w_s(&mut out, "            bst_code_u64(&p, (uint64_t)(uintptr_t)tab[w[i + 1]]);\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\xff\\xd0\\x49\\x89\\xc4\", 5);                  /* call *%rax; mov %rax,%r12 */\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 1: case 2:\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x4d\\x85\\xe4\\x0f\", 4);                      /* test %r12,%r12; jz / jnz */\n");
  w_s(&mut out, "            *p++ = w[i] == 1 ? 0x84 : 0x85;\n");
  w_s(&mut out, "            bst_code_rel(&p, mem, off, w[i + 1]);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 3:\n");
  w_s(&mut out, "            if (w[i + 1] < 0x80000000u) {\n");
  w_s(&mut out, "                bst_code_put(&p, \"\\x49\\x81\\xfc\", 3); bst_code_u32(&p, (uint32_t)w[i + 1]);   /* cmp $v,%r12 */\n");
  w_s(&mut out, "            } else {\n");
  w_s(&mut out, "                bst_code_put(&p, \"\\x48\\xb9\", 2); bst_code_u64(&p, w[i + 1]);             /* movabs $v,%rcx */\n");
  w_s(&mut out, "                bst_code_put(&p, \"\\x4c\\x39\\xe1\", 3);                                      /* cmp %r12,%rcx */\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x0f\\x84\", 2);                              /* je */\n");
  w_s(&mut out, "            bst_code_rel(&p, mem, off, w[i + 2]);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 4:\n");
  w_s(&mut out, "            *p++ = 0xe9;                                                 /* jmp */\n");
  w_s(&mut out, "            bst_code_rel(&p, mem, off, w[i + 1]);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 5:\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x4c\\x89\\xe0\", 3);                          /* mov %r12,%rax */\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x48\\x81\\xc4\\x88\\x00\\x00\\x00\\x5d\\x41\\x5f\\x41\\x5e\\x41\\x5d\\x41\\x5c\\x5b\\xc3\", 18);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 6:\n");
  w_s(&mut out, "            bst_code_mov(&p, 0xb8, w[i + 1]);                             /* %rax */\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x48\\x81\\xc4\\x88\\x00\\x00\\x00\\x5d\\x41\\x5f\\x41\\x5e\\x41\\x5d\\x41\\x5c\\x5b\\xc3\", 18);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 8:\n");
  w_s(&mut out, "            if (w[i + 2] < 0x80000000u) {\n");
  w_s(&mut out, "                bst_code_put(&p, \"\\x48\\xc7\\xc0\", 3); bst_code_u32(&p, (uint32_t)w[i + 2]);   /* mov $x,%rax */\n");
  w_s(&mut out, "            } else {\n");
  w_s(&mut out, "                bst_code_put(&p, \"\\x48\\xb8\", 2); bst_code_u64(&p, w[i + 2]);                     /* movabs $x,%rax */\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            bst_code_st(&p, w[i + 1], 0);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 9:\n");
  w_s(&mut out, "            bst_code_ld(&p, 0, w[i + 2]);\n");
  w_s(&mut out, "            bst_code_st(&p, w[i + 1], 0);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 10: case 12:\n");
  w_s(&mut out, "            bst_code_ld(&p, 0, w[i + 3]);\n");
  w_s(&mut out, "            bst_code_ld(&p, 1, w[i + 4]);\n");
  w_s(&mut out, "            bst_code_alu(&p, w[i + 1]);\n");
  w_s(&mut out, "            if (w[i] == 12) {\n");
  w_s(&mut out, "                bst_code_put(&p, \"\\x48\\x63\\xd0\\x48\\x39\\xd0\\x0f\\x85\", 8);   /* movslq %eax,%rdx; cmp %rdx,%rax; jne l */\n");
  w_s(&mut out, "                bst_code_rel(&p, mem, off, w[i + 5]);\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            bst_code_st(&p, w[i + 2], 0);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 11:\n");
  w_s(&mut out, "            bst_code_ld(&p, 0, w[i + 3]);\n");
  w_s(&mut out, "            bst_code_rcx(&p, w[i + 4]);\n");
  w_s(&mut out, "            bst_code_alu(&p, w[i + 1]);\n");
  w_s(&mut out, "            bst_code_st(&p, w[i + 2], 0);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 13: case 14:\n");
  w_s(&mut out, "            bst_code_ld(&p, 0, w[i + 2]);\n");
  w_s(&mut out, "            if (w[i] == 13) bst_code_ld(&p, 1, w[i + 3]);\n");
  w_s(&mut out, "            else bst_code_rcx(&p, w[i + 3]);\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x48\\x39\\xc8\\x0f\", 4);                      /* cmp %rcx,%rax; jcc */\n");
  w_s(&mut out, "            *p++ = bst_code_jcc[w[i + 1]];\n");
  w_s(&mut out, "            bst_code_rel(&p, mem, off, w[i + 4]);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 15:\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x4c\\x89\\xe0\", 3);                          /* mov %r12,%rax */\n");
  w_s(&mut out, "            bst_code_st(&p, w[i + 1], 0);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 16:\n");
  w_s(&mut out, "            bst_code_ld(&p, 0, w[i + 1]);\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x49\\x89\\xc4\", 3);                          /* mov %rax,%r12 */\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 17:\n");
  w_s(&mut out, "            bst_code_index(&p, mem, off, w[i + 3], w[i + 4], w[i + 2], w[i + 5], ftab);\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x48\\x8b\\x04\\xc2\", 4);                      /* mov (%rdx,%rax,8),%rax */\n");
  w_s(&mut out, "            bst_code_st(&p, w[i + 1], 0);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 18:\n");
  w_s(&mut out, "            bst_code_index(&p, mem, off, w[i + 2], w[i + 3], w[i + 1], w[i + 5], ftab);\n");
  w_s(&mut out, "            bst_code_ld(&p, 1, w[i + 4]);\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x48\\x89\\x0c\\xc2\", 4);                      /* mov %rcx,(%rdx,%rax,8) */\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 29:\n");
  w_s(&mut out, "            bst_code_ld(&p, 0, w[i + 1]);\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x48\\x3d\", 2);                              /* cmp $nentry,%rax */\n");
  w_s(&mut out, "            bst_code_u32(&p, (uint32_t)nentry);\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x0f\\x83\\x10\\x00\\x00\\x00\", 6);             /* jae past the jump: an entry number out of range does nothing */\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x48\\x8d\\x0d\", 3);                          /* lea table(%rip),%rcx */\n");
  w_s(&mut out, "            bst_code_u32(&p, (uint32_t)((int64_t)tabpos - (int64_t)((p + 4) - mem)));\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x48\\x63\\x04\\x81\\x48\\x01\\xc8\\xff\\xe0\", 9);   /* movslq (%rcx,%rax,4),%rax; add %rcx,%rax; jmp *%rax */\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 23: case 25: case 28: {\n");
  w_s(&mut out, "            uint64_t f = w[i + 2], ix = w[i + 3], l = w[i] == 25 ? w[i + 5] : w[i + 4];\n");
  w_s(&mut out, "            bst_code_elem(&p, mem, off, ix, f, l, ftab, etab);\n");
  w_s(&mut out, "            if (w[i] == 23) {\n");
  w_s(&mut out, "                uint64_t sz = etab[4 * f + 3], mo = etab[4 * f + 1];\n");
  w_s(&mut out, "                if (sz == 8) bst_code_put(&p, \"\\x48\\x8b\\x82\", 3);       /* mov disp(%rdx),%rax */\n");
  w_s(&mut out, "                else if (sz == 4) bst_code_put(&p, \"\\x8b\\x82\", 2);\n");
  w_s(&mut out, "                else if (sz == 2) bst_code_put(&p, \"\\x0f\\xb7\\x82\", 3);  /* movzwl */\n");
  w_s(&mut out, "                else bst_code_put(&p, \"\\x0f\\xb6\\x82\", 3);             /* movzbl */\n");
  w_s(&mut out, "                bst_code_u32(&p, (uint32_t)mo);\n");
  w_s(&mut out, "            } else if (w[i] == 28) {\n");
  w_s(&mut out, "                bst_code_put(&p, \"\\x48\\x8b\\x82\", 3);                  /* mov len(%rdx),%rax */\n");
  w_s(&mut out, "                bst_code_u32(&p, (uint32_t)(etab[4 * f + 1] + offsetof(bst_vec, len)));\n");
  w_s(&mut out, "            } else {\n");
  w_s(&mut out, "                bst_code_inner(&p, mem, off, w[i + 4], f, l, etab);\n");
  w_s(&mut out, "                bst_code_put(&p, \"\\x48\\x8b\\x04\\xca\", 4);              /* mov (%rdx,%rcx,8),%rax */\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            bst_code_st(&p, w[i + 1], 0);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        case 24: {\n");
  w_s(&mut out, "            uint64_t f = w[i + 1], sz = etab[4 * f + 3];\n");
  w_s(&mut out, "            bst_code_elem(&p, mem, off, w[i + 2], f, w[i + 4], ftab, etab);\n");
  w_s(&mut out, "            bst_code_ld(&p, 1, w[i + 3]);\n");
  w_s(&mut out, "            if (sz == 8) bst_code_put(&p, \"\\x48\\x89\\x8a\", 3);           /* mov %rcx,disp(%rdx) */\n");
  w_s(&mut out, "            else if (sz == 4) bst_code_put(&p, \"\\x89\\x8a\", 2);\n");
  w_s(&mut out, "            else if (sz == 2) bst_code_put(&p, \"\\x66\\x89\\x8a\", 3);\n");
  w_s(&mut out, "            else bst_code_put(&p, \"\\x88\\x8a\", 2);\n");
  w_s(&mut out, "            bst_code_u32(&p, (uint32_t)etab[4 * f + 1]);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        case 26: {\n");
  w_s(&mut out, "            uint64_t f = w[i + 1];\n");
  w_s(&mut out, "            bst_code_elem(&p, mem, off, w[i + 2], f, w[i + 5], ftab, etab);\n");
  w_s(&mut out, "            bst_code_inner(&p, mem, off, w[i + 3], f, w[i + 5], etab);\n");
  w_s(&mut out, "            bst_code_ld(&p, 0, w[i + 4]);\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x48\\x89\\x04\\xca\", 4);                  /* mov %rax,(%rdx,%rcx,8) */\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        case 27:\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x48\\x8b\\x83\", 3);                      /* mov len(%rbx),%rax */\n");
  w_s(&mut out, "            bst_code_u32(&p, (uint32_t)(ftab[w[i + 2]] + offsetof(bst_vec, len)));\n");
  w_s(&mut out, "            bst_code_st(&p, w[i + 1], 0);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 20: {\n");
  w_s(&mut out, "            static const unsigned char fop[4] = { 0x58, 0x5c, 0x59, 0x5e };\n");
  w_s(&mut out, "            bst_code_ld(&p, 0, w[i + 3]);\n");
  w_s(&mut out, "            bst_code_ld(&p, 1, w[i + 4]);\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x66\\x48\\x0f\\x6e\\xc0\\x66\\x48\\x0f\\x6e\\xc9\", 10);   /* movq %rax,%xmm0; movq %rcx,%xmm1 */\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\xf2\\x0f\", 2);\n");
  w_s(&mut out, "            *p++ = fop[w[i + 1]];\n");
  w_s(&mut out, "            *p++ = 0xc1;                                                         /* addsd etc. %xmm1,%xmm0 */\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x66\\x48\\x0f\\x7e\\xc0\", 5);                    /* movq %xmm0,%rax */\n");
  w_s(&mut out, "            bst_code_st(&p, w[i + 2], 0);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        case 21:\n");
  w_s(&mut out, "            bst_code_ld(&p, 0, w[i + 3]);\n");
  w_s(&mut out, "            switch (w[i + 1]) {\n");
  w_s(&mut out, "            case 0: bst_code_put(&p, \"\\x66\\x48\\x0f\\x6e\\xc0\\xf2\\x0f\\x51\\xc0\\x66\\x48\\x0f\\x7e\\xc0\", 14); break;   /* sqrtsd */\n");
  w_s(&mut out, "            case 1: bst_code_put(&p, \"\\x48\\x0f\\xba\\xf8\\x3f\", 5); break;                                           /* btc $63,%rax */\n");
  w_s(&mut out, "            case 2: bst_code_put(&p, \"\\x48\\x0f\\xba\\xf0\\x3f\", 5); break;                                           /* btr $63,%rax */\n");
  w_s(&mut out, "            case 3: bst_code_put(&p, \"\\xf2\\x48\\x0f\\x2a\\xc0\\x66\\x48\\x0f\\x7e\\xc0\", 10); break;                  /* cvtsi2sd %rax,%xmm0; movq */\n");
  w_s(&mut out, "            default: bst_code_put(&p, \"\\x66\\x48\\x0f\\x6e\\xc0\\xf2\\x48\\x0f\\x2c\\xc0\", 10); break;                 /* movq; cvttsd2si %xmm0,%rax */\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            bst_code_st(&p, w[i + 2], 0);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        case 22: {\n");
  w_s(&mut out, "            uint64_t c = w[i + 1];\n");
  w_s(&mut out, "            bst_code_ld(&p, 0, w[i + 2]);\n");
  w_s(&mut out, "            bst_code_ld(&p, 1, w[i + 3]);\n");
  w_s(&mut out, "            bst_code_put(&p, \"\\x66\\x48\\x0f\\x6e\\xc0\\x66\\x48\\x0f\\x6e\\xc9\", 10);   /* movq %rax,%xmm0; movq %rcx,%xmm1 */\n");
  w_s(&mut out, "            if (c == 2 || c == 3) bst_code_put(&p, \"\\x66\\x0f\\x2e\\xc8\", 4);   /* ucomisd %xmm0,%xmm1 */\n");
  w_s(&mut out, "            else bst_code_put(&p, \"\\x66\\x0f\\x2e\\xc1\", 4);                    /* ucomisd %xmm1,%xmm0 */\n");
  w_s(&mut out, "            if (c == 0) {                                                      /* jp over; je l */\n");
  w_s(&mut out, "                bst_code_put(&p, \"\\x7a\\x06\\x0f\\x84\", 4);\n");
  w_s(&mut out, "            } else if (c == 1) {                                               /* jp l; jne l */\n");
  w_s(&mut out, "                bst_code_put(&p, \"\\x0f\\x8a\", 2);\n");
  w_s(&mut out, "                bst_code_rel(&p, mem, off, w[i + 4]);\n");
  w_s(&mut out, "                bst_code_put(&p, \"\\x0f\\x85\", 2);\n");
  w_s(&mut out, "            } else {                                                           /* ja or jae */\n");
  w_s(&mut out, "                bst_code_put(&p, \"\\x0f\", 1);\n");
  w_s(&mut out, "                *p++ = (c == 2 || c == 4) ? 0x87 : 0x83;\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            bst_code_rel(&p, mem, off, w[i + 4]);\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        default:\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_code_put(&p, \"\\x4c\\x89\\xe0\\x48\\x81\\xc4\\x88\\x00\\x00\\x00\\x5d\\x41\\x5f\\x41\\x5e\\x41\\x5d\\x41\\x5c\\x5b\\xc3\", 21);\n");
  w_s(&mut out, "    if (has29) {   /* the table: entry e's body, relative to the table */\n");
  w_s(&mut out, "        for (i = 0; i < n; i += bst_code_ilen(w, n, i)) {\n");
  w_s(&mut out, "            if (w[i] == 7) bst_code_u32(&p, (uint32_t)((int64_t)off[w[i + 1]] - (int64_t)tabpos));\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    free(off);\n");
  w_s(&mut out, "    if ((uint64_t)(p - mem) != size || mprotect(m, mapped, PROT_READ | PROT_EXEC) != 0) {\n");
  w_s(&mut out, "        munmap(m, mapped); free(entry); return 0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (bst_ncodes == bst_capcodes) {\n");
  w_s(&mut out, "        uint64_t cap = bst_capcodes ? bst_capcodes * 2 : 16;\n");
  w_s(&mut out, "        bst_code_region *r = (bst_code_region *)realloc(bst_codes, cap * sizeof(bst_code_region));\n");
  w_s(&mut out, "        if (!r) { munmap(m, mapped); free(entry); return 0; }\n");
  w_s(&mut out, "        bst_codes = r;\n");
  w_s(&mut out, "        bst_capcodes = cap;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_code_region *r = &bst_codes[bst_ncodes++];\n");
  w_s(&mut out, "    r->mem = mem; r->size = mapped; r->nentry = nentry; r->entry = entry; r->running = 0; r->freed = 0;\n");
  w_s(&mut out, "    return bst_ncodes;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    (void)plan; (void)tab; (void)ntab; (void)ftab; (void)nfield;\n");
  w_s(&mut out, "    return 0;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_code_call_(uint64_t id, void *ctx, uint64_t e) {\n");
  w_s(&mut out, "#ifdef BST_CODE_X86\n");
  w_s(&mut out, "    if (id == 0 || id > bst_ncodes) return 0;\n");
  w_s(&mut out, "    bst_code_region *r = &bst_codes[id - 1];\n");
  w_s(&mut out, "    if (r->freed || e >= r->nentry) return 0;\n");
  w_s(&mut out, "    uint64_t (*f)(void *);\n");
  w_s(&mut out, "    void *at = r->mem + r->entry[e];\n");
  w_s(&mut out, "    memcpy(&f, &at, sizeof f);\n");
  w_s(&mut out, "    r->running++;\n");
  w_s(&mut out, "    uint64_t res = f(ctx);\n");
  w_s(&mut out, "    r = &bst_codes[id - 1];          /* the table may have moved */\n");
  w_s(&mut out, "    r->running--;\n");
  w_s(&mut out, "    if (r->freed && r->running == 0 && r->mem) { munmap(r->mem, r->size); free(r->entry); r->mem = NULL; r->entry = NULL; }\n");
  w_s(&mut out, "    return res;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    (void)id; (void)ctx; (void)e;\n");
  w_s(&mut out, "    return 0;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_code_free(bst_host h, uint64_t id) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    if (id == 0 || id > bst_ncodes) return;\n");
  w_s(&mut out, "    bst_code_region *r = &bst_codes[id - 1];\n");
  w_s(&mut out, "    if (r->freed) return;\n");
  w_s(&mut out, "    r->freed = 1;\n");
  w_s(&mut out, "#ifdef BST_CODE_X86\n");
  w_s(&mut out, "    if (r->running == 0 && r->mem) { munmap(r->mem, r->size); free(r->entry); r->mem = NULL; r->entry = NULL; }\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define bst_code_build(h, plan) bst_code_build_((h), (plan), bst_stencil_tab, BST_NSTENCILS, bst_field_tab, bst_field_ext, BST_NFIELDS)\n");
  w_s(&mut out, "#define bst_code_call(id, ctx, e) bst_code_call_((id), (void *)(ctx), (e))\n");
}

/// The prelude part for `host_net`, which stage0 does not have: added after the
/// hosted prelude, and only to a program that calls it.
fn cg_prelude_net(out: &mut Vec[u64]) {
  w_s(&mut out, "#include <time.h>\n");
  w_s(&mut out, "#ifndef _WIN32\n");
  w_s(&mut out, "#include <sys/socket.h>\n");
  w_s(&mut out, "#include <netinet/in.h>\n");
  w_s(&mut out, "#include <sys/un.h>\n");
  w_s(&mut out, "#include <errno.h>\n");
  w_s(&mut out, "#include <poll.h>\n");
  w_s(&mut out, "#include <sys/time.h>\n");
  w_s(&mut out, "/* The address of the Unix socket at the path in *buf: a path of 1 to 107 bytes without a NUL; on Linux a\n");
  w_s(&mut out, " * leading '@' means an abstract socket (the name after it, in the kernel's table, no file). 0 if it does\n");
  w_s(&mut out, " * not fit. */\n");
  w_s(&mut out, "static int bst_unix_addr(struct sockaddr_un *sa, socklen_t *sl, const bst_bytes *buf) {\n");
  w_s(&mut out, "    if (buf->len == 0 || buf->len >= sizeof sa->sun_path || memchr(buf->data, 0, buf->len)) return 0;\n");
  w_s(&mut out, "    memset(sa, 0, sizeof *sa);\n");
  w_s(&mut out, "    sa->sun_family = AF_UNIX;\n");
  w_s(&mut out, "    memcpy(sa->sun_path, buf->data, buf->len);\n");
  w_s(&mut out, "    *sl = (socklen_t)(offsetof(struct sockaddr_un, sun_path) + buf->len + 1);\n");
  w_s(&mut out, "#ifdef __linux__\n");
  w_s(&mut out, "    if (buf->data[0] == '@') {\n");
  w_s(&mut out, "        sa->sun_path[0] = 0;\n");
  w_s(&mut out, "        *sl = (socklen_t)(offsetof(struct sockaddr_un, sun_path) + buf->len);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    return 1;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* A connect with a time limit of `ms` milliseconds (the bits of the port word above bit 15):\n");
  w_s(&mut out, " * a non-blocking connect that is waited for with poll, then the socket is blocking again with the\n");
  w_s(&mut out, " * same limit on every read and write. */\n");
  w_s(&mut out, "static int bst_connect_limit(int fd, struct sockaddr *sa, socklen_t sl, uint64_t ms) {\n");
  w_s(&mut out, "    if (ms > 3600000) ms = 3600000;\n");
  w_s(&mut out, "    int fl = fcntl(fd, F_GETFL, 0);\n");
  w_s(&mut out, "    if (fl < 0 || fcntl(fd, F_SETFL, fl | O_NONBLOCK) != 0) return -1;\n");
  w_s(&mut out, "    if (connect(fd, sa, sl) != 0) {\n");
  w_s(&mut out, "        struct pollfd p;\n");
  w_s(&mut out, "        p.fd = fd; p.events = POLLOUT; p.revents = 0;\n");
  w_s(&mut out, "        if (poll(&p, 1, (int)ms) <= 0) return -1;\n");
  w_s(&mut out, "        int err = 0;\n");
  w_s(&mut out, "        socklen_t el = sizeof err;\n");
  w_s(&mut out, "        if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &el) != 0 || err != 0) return -1;\n");
  w_s(&mut out, "        struct sockaddr_storage peer;   /* a connect that failed at once leaves no error to read: ask for the peer */\n");
  w_s(&mut out, "        socklen_t pl = sizeof peer;\n");
  w_s(&mut out, "        if (getpeername(fd, (struct sockaddr *)&peer, &pl) != 0) return -1;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (fcntl(fd, F_SETFL, fl) != 0) return -1;\n");
  w_s(&mut out, "    struct timeval tv;\n");
  w_s(&mut out, "    tv.tv_sec = (time_t)(ms / 1000); tv.tv_usec = (suseconds_t)((ms % 1000) * 1000);\n");
  w_s(&mut out, "    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);\n");
  w_s(&mut out, "    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof tv);\n");
  w_s(&mut out, "    return 0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "/* Winsock, loaded when first used (no import library to link): sockets are\n");
  w_s(&mut out, " * handles, a read is a recv and a close is a closesocket. */\n");
  w_s(&mut out, "typedef uintptr_t bst_sock;\n");
  w_s(&mut out, "static struct {\n");
  w_s(&mut out, "    int state;   /* 0 not tried, 1 ready, -1 failed */\n");
  w_s(&mut out, "    bst_sock (__stdcall *socket)(int, int, int);\n");
  w_s(&mut out, "    int (__stdcall *bind)(bst_sock, const void *, int);\n");
  w_s(&mut out, "    int (__stdcall *listen)(bst_sock, int);\n");
  w_s(&mut out, "    bst_sock (__stdcall *accept)(bst_sock, void *, int *);\n");
  w_s(&mut out, "    int (__stdcall *connect)(bst_sock, const void *, int);\n");
  w_s(&mut out, "    int (__stdcall *recv)(bst_sock, char *, int, int);\n");
  w_s(&mut out, "    int (__stdcall *send)(bst_sock, const char *, int, int);\n");
  w_s(&mut out, "    int (__stdcall *closesocket)(bst_sock);\n");
  w_s(&mut out, "    int (__stdcall *getsockname)(bst_sock, void *, int *);\n");
  w_s(&mut out, "    int (__stdcall *shutdown)(bst_sock, int);\n");
  w_s(&mut out, "} bst_ws;\n");
  w_s(&mut out, "static int bst_ws_init(void) {\n");
  w_s(&mut out, "    if (bst_ws.state) return bst_ws.state > 0;\n");
  w_s(&mut out, "    bst_ws.state = -1;\n");
  w_s(&mut out, "    HMODULE m = LoadLibraryA(\"ws2_32.dll\");\n");
  w_s(&mut out, "    if (!m) return 0;\n");
  w_s(&mut out, "    int (__stdcall *start)(unsigned short, void *) = (int (__stdcall *)(unsigned short, void *))(void *)GetProcAddress(m, \"WSAStartup\");\n");
  w_s(&mut out, "    bst_ws.socket = (bst_sock (__stdcall *)(int, int, int))(void *)GetProcAddress(m, \"socket\");\n");
  w_s(&mut out, "    bst_ws.bind = (int (__stdcall *)(bst_sock, const void *, int))(void *)GetProcAddress(m, \"bind\");\n");
  w_s(&mut out, "    bst_ws.listen = (int (__stdcall *)(bst_sock, int))(void *)GetProcAddress(m, \"listen\");\n");
  w_s(&mut out, "    bst_ws.accept = (bst_sock (__stdcall *)(bst_sock, void *, int *))(void *)GetProcAddress(m, \"accept\");\n");
  w_s(&mut out, "    bst_ws.connect = (int (__stdcall *)(bst_sock, const void *, int))(void *)GetProcAddress(m, \"connect\");\n");
  w_s(&mut out, "    bst_ws.recv = (int (__stdcall *)(bst_sock, char *, int, int))(void *)GetProcAddress(m, \"recv\");\n");
  w_s(&mut out, "    bst_ws.send = (int (__stdcall *)(bst_sock, const char *, int, int))(void *)GetProcAddress(m, \"send\");\n");
  w_s(&mut out, "    bst_ws.closesocket = (int (__stdcall *)(bst_sock))(void *)GetProcAddress(m, \"closesocket\");\n");
  w_s(&mut out, "    bst_ws.getsockname = (int (__stdcall *)(bst_sock, void *, int *))(void *)GetProcAddress(m, \"getsockname\");\n");
  w_s(&mut out, "    bst_ws.shutdown = (int (__stdcall *)(bst_sock, int))(void *)GetProcAddress(m, \"shutdown\");\n");
  w_s(&mut out, "    char wsadata[512];\n");
  w_s(&mut out, "    if (!start || !bst_ws.socket || !bst_ws.bind || !bst_ws.listen || !bst_ws.accept || !bst_ws.connect\n");
  w_s(&mut out, "        || !bst_ws.recv || !bst_ws.send || !bst_ws.closesocket || !bst_ws.getsockname || !bst_ws.shutdown) return 0;\n");
  w_s(&mut out, "    if (start(0x0202, wsadata) != 0) return 0;\n");
  w_s(&mut out, "    bst_ws.state = 1;\n");
  w_s(&mut out, "    return 1;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_host_net_win(uint64_t op, uint64_t a, uint64_t b, bst_bytes *buf) {\n");
  w_s(&mut out, "    const bst_sock bad = ~(bst_sock)0;\n");
  w_s(&mut out, "    if (op == 7) return (uint64_t)time(NULL);\n");
  w_s(&mut out, "    if (op == 8) {   /* RtlGenRandom, which advapi32 exports as SystemFunction036 */\n");
  w_s(&mut out, "        if (b > 256) return ~(uint64_t)0;\n");
  w_s(&mut out, "        HMODULE m = LoadLibraryA(\"advapi32.dll\");\n");
  w_s(&mut out, "        BOOLEAN (__stdcall *gen)(void *, ULONG) = m ? (BOOLEAN (__stdcall *)(void *, ULONG))(void *)GetProcAddress(m, \"SystemFunction036\") : NULL;\n");
  w_s(&mut out, "        unsigned char *d = (unsigned char *)malloc(b ? b : 1);\n");
  w_s(&mut out, "        if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        if (!gen || !gen(d, (ULONG)b)) { free(d); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        free(buf->data);\n");
  w_s(&mut out, "        buf->len = b;\n");
  w_s(&mut out, "        buf->data = d;\n");
  w_s(&mut out, "        return b;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    unsigned char sa[28];   /* sockaddr_in (family, port and address in network order) or sockaddr_in6 */\n");
  w_s(&mut out, "    if (!bst_ws_init()) return ~(uint64_t)0;\n");
  w_s(&mut out, "    memset(sa, 0, sizeof sa);\n");
  w_s(&mut out, "    sa[0] = 2;\n");
  w_s(&mut out, "    sa[2] = (unsigned char)(b >> 8); sa[3] = (unsigned char)b;\n");
  w_s(&mut out, "    sa[4] = (unsigned char)(a >> 24); sa[5] = (unsigned char)(a >> 16); sa[6] = (unsigned char)(a >> 8); sa[7] = (unsigned char)a;\n");
  w_s(&mut out, "    if (op == 9) {   /* IPv6: the 16 bytes of the address are in *buf */\n");
  w_s(&mut out, "        if (buf->len != 16) return ~(uint64_t)0;\n");
  w_s(&mut out, "        memset(sa, 0, sizeof sa);\n");
  w_s(&mut out, "        sa[0] = 23;\n");
  w_s(&mut out, "        sa[2] = (unsigned char)(b >> 8); sa[3] = (unsigned char)b;\n");
  w_s(&mut out, "        memcpy(sa + 8, buf->data, 16);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 0 || op == 2 || op == 9) {\n");
  w_s(&mut out, "        bst_sock s = bst_ws.socket(op == 9 ? 23 : 2, 1, 0);\n");
  w_s(&mut out, "        if (s == bad) return ~(uint64_t)0;\n");
  w_s(&mut out, "        int sl = op == 9 ? 28 : 16;\n");
  w_s(&mut out, "        if (op == 0 ? (bst_ws.bind(s, sa, sl) != 0 || bst_ws.listen(s, 128) != 0) : bst_ws.connect(s, sa, sl) != 0) { bst_ws.closesocket(s); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        return (uint64_t)s;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 1) {\n");
  w_s(&mut out, "        bst_sock c = bst_ws.accept((bst_sock)a, NULL, NULL);\n");
  w_s(&mut out, "        return c == bad ? ~(uint64_t)0 : (uint64_t)c;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 3) {\n");
  w_s(&mut out, "        if (b > 0x7fffffffu) b = 0x7fffffffu;\n");
  w_s(&mut out, "        unsigned char *d = (unsigned char *)malloc(b ? b : 1);\n");
  w_s(&mut out, "        if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        int n = bst_ws.recv((bst_sock)a, (char *)d, (int)b, 0);\n");
  w_s(&mut out, "        if (n < 0) { free(d); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        free(buf->data);\n");
  w_s(&mut out, "        buf->len = (uint64_t)n;\n");
  w_s(&mut out, "        buf->data = d;\n");
  w_s(&mut out, "        return (uint64_t)n;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 4) {\n");
  w_s(&mut out, "        uint64_t n = buf->len > 0x7fffffffu ? 0x7fffffffu : buf->len;\n");
  w_s(&mut out, "        int r = bst_ws.send((bst_sock)a, (const char *)buf->data, (int)n, 0);\n");
  w_s(&mut out, "        return r < 0 ? ~(uint64_t)0 : (uint64_t)r;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 5) return bst_ws.closesocket((bst_sock)a) == 0 ? 0 : ~(uint64_t)0;\n");
  w_s(&mut out, "    if (op == 10) return b <= 2 && bst_ws.shutdown((bst_sock)a, (int)b) == 0 ? 0 : ~(uint64_t)0;\n");
  w_s(&mut out, "    if (op == 6) {\n");
  w_s(&mut out, "        int len = 16;\n");
  w_s(&mut out, "        if (bst_ws.getsockname((bst_sock)a, sa, &len) != 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "        return ((uint64_t)sa[2] << 8) | sa[3];\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return ~(uint64_t)0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "/* TCP over IPv4: `op` 0 listens on address `a` (host order), port `b` and returns the\n");
  w_s(&mut out, " * socket; 1 accepts a connection on socket `a`; 2 connects to address `a`, port `b`;\n");
  w_s(&mut out, " * 9 connects over IPv6 to the 16 bytes (network order) in `*buf`, port `b` (`a` is 0);\n");
  w_s(&mut out, " * 3 reads at most `b` bytes from socket `a` into `*buf` (replacing it; an empty\n");
  w_s(&mut out, " * result is end of file); 4 writes `*buf` to socket `a` and returns how many bytes\n");
  w_s(&mut out, " * went; 5 closes socket `a`; 6 returns the local port of socket `a`;\n");
  w_s(&mut out, " * 7 returns the time in seconds since 1970; 8 replaces `*buf` with `b` (at most\n");
  w_s(&mut out, " * 256) random bytes from the system's source; 10 shuts down one direction of socket\n");
  w_s(&mut out, " * `a` (`b` 0 reading, 1 writing, 2 both) and leaves it open; 11 starts a connect\n");
  w_s(&mut out, " * to address `a`, port `b` without waiting (the socket is non-blocking: ready\n");
  w_s(&mut out, " * to write when it is made); 12 returns 0 when the connect of socket `a` has\n");
  w_s(&mut out, " * succeeded, or its error number; 13 listens over IPv6 on the 16 bytes in `*buf`;\n");
  w_s(&mut out, " * 14 binds a non-blocking UDP socket to IPv4 address `a`, port `b`; 15 sends `*buf` from\n");
  w_s(&mut out, " * UDP socket `a` to address `b >> 16`, port `b & 65535`; 16 receives one datagram of at\n");
  w_s(&mut out, " * most `b` bytes (the result is the sender's address << 32, port << 16 and length). Only the Linux C backend has 11 to 17 (17 reads the local or remote address of a socket). The failure of any\n");
  w_s(&mut out, " * is 2^64 - 1. */\n");
  w_s(&mut out, "static uint64_t bst_host_net(bst_host h, uint64_t op, uint64_t a, uint64_t b, bst_bytes *buf) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    return bst_host_net_win(op, a, b, buf);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    struct sockaddr_in sa;\n");
  w_s(&mut out, "    struct sockaddr_in6 sa6;\n");
  w_s(&mut out, "    memset(&sa, 0, sizeof sa);\n");
  w_s(&mut out, "    sa.sin_family = AF_INET;\n");
  w_s(&mut out, "    sa.sin_port = htons((uint16_t)b);\n");
  w_s(&mut out, "    sa.sin_addr.s_addr = htonl((uint32_t)a);\n");
  w_s(&mut out, "    if (op == 7) return (uint64_t)time(NULL);\n");
  w_s(&mut out, "    if (op == 8) {\n");
  w_s(&mut out, "        if (b > 256) return ~(uint64_t)0;\n");
  w_s(&mut out, "        unsigned char *d = (unsigned char *)malloc(b ? b : 1);\n");
  w_s(&mut out, "        if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        int fd = open(\"/dev/urandom\", O_RDONLY);\n");
  w_s(&mut out, "        uint64_t got = 0;\n");
  w_s(&mut out, "        while (fd >= 0 && got < b) {\n");
  w_s(&mut out, "            ssize_t n = read(fd, d + got, b - got);\n");
  w_s(&mut out, "            if (n <= 0) break;\n");
  w_s(&mut out, "            got += (uint64_t)n;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        if (fd >= 0) close(fd);\n");
  w_s(&mut out, "        if (got != b) { free(d); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        free(buf->data);\n");
  w_s(&mut out, "        buf->len = b;\n");
  w_s(&mut out, "        buf->data = d;\n");
  w_s(&mut out, "        return b;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 9) {   /* IPv6: the 16 bytes of the address are in *buf */\n");
  w_s(&mut out, "        if (buf->len != 16) return ~(uint64_t)0;\n");
  w_s(&mut out, "        memset(&sa6, 0, sizeof sa6);\n");
  w_s(&mut out, "        sa6.sin6_family = AF_INET6;\n");
  w_s(&mut out, "        sa6.sin6_port = htons((uint16_t)b);\n");
  w_s(&mut out, "        memcpy(&sa6.sin6_addr, buf->data, 16);\n");
  w_s(&mut out, "        int fd = socket(AF_INET6, SOCK_STREAM, 0);\n");
  w_s(&mut out, "        if (fd < 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "        if ((b >> 16) ? bst_connect_limit(fd, (struct sockaddr *)&sa6, sizeof sa6, b >> 16) != 0 : connect(fd, (struct sockaddr *)&sa6, sizeof sa6) != 0) {\n");
  w_s(&mut out, "            close(fd);\n");
  w_s(&mut out, "            return ~(uint64_t)0;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        return (uint64_t)fd;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 13) {   /* listen over IPv6 on the 16 bytes in *buf, port b (dual stack on ::) */\n");
  w_s(&mut out, "        if (buf->len != 16) return ~(uint64_t)0;\n");
  w_s(&mut out, "        int fd = socket(AF_INET6, SOCK_STREAM, 0);\n");
  w_s(&mut out, "        if (fd < 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "        int one = 1, zero = 0;\n");
  w_s(&mut out, "        setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);\n");
  w_s(&mut out, "        setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &zero, sizeof zero);\n");
  w_s(&mut out, "        memset(&sa6, 0, sizeof sa6);\n");
  w_s(&mut out, "        sa6.sin6_family = AF_INET6;\n");
  w_s(&mut out, "        sa6.sin6_port = htons((uint16_t)b);\n");
  w_s(&mut out, "        memcpy(&sa6.sin6_addr, buf->data, 16);\n");
  w_s(&mut out, "        if (bind(fd, (struct sockaddr *)&sa6, sizeof sa6) != 0 || listen(fd, 128) != 0) { close(fd); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        return (uint64_t)fd;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 14) {   /* a non-blocking UDP socket bound to IPv4 address a, port b */\n");
  w_s(&mut out, "        int fd = socket(AF_INET, SOCK_DGRAM, 0);\n");
  w_s(&mut out, "        if (fd < 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "        int one = 1;\n");
  w_s(&mut out, "        setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);\n");
  w_s(&mut out, "        int fl = fcntl(fd, F_GETFL, 0);\n");
  w_s(&mut out, "        if (fl < 0 || fcntl(fd, F_SETFL, fl | O_NONBLOCK) != 0 || bind(fd, (struct sockaddr *)&sa, sizeof sa) != 0) { close(fd); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        return (uint64_t)fd;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 15) {   /* send *buf from UDP socket a to the address b >> 16 (host order), port b & 65535 */\n");
  w_s(&mut out, "        struct sockaddr_in to;\n");
  w_s(&mut out, "        memset(&to, 0, sizeof to);\n");
  w_s(&mut out, "        to.sin_family = AF_INET;\n");
  w_s(&mut out, "        to.sin_port = htons((uint16_t)b);\n");
  w_s(&mut out, "        to.sin_addr.s_addr = htonl((uint32_t)(b >> 16));\n");
  w_s(&mut out, "        ssize_t n = sendto((int)a, buf->data, buf->len, 0, (struct sockaddr *)&to, sizeof to);\n");
  w_s(&mut out, "        return n < 0 ? ~(uint64_t)0 : (uint64_t)n;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 16) {   /* receive one datagram of at most b bytes from UDP socket a into *buf */\n");
  w_s(&mut out, "        if (b > 65535) b = 65535;\n");
  w_s(&mut out, "        unsigned char *d = (unsigned char *)malloc(b ? b : 1);\n");
  w_s(&mut out, "        if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        struct sockaddr_in from;\n");
  w_s(&mut out, "        socklen_t fl = sizeof from;\n");
  w_s(&mut out, "        ssize_t n = recvfrom((int)a, d, b, 0, (struct sockaddr *)&from, &fl);\n");
  w_s(&mut out, "        if (n < 0) { free(d); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        free(buf->data);\n");
  w_s(&mut out, "        buf->len = (uint64_t)n;\n");
  w_s(&mut out, "        buf->data = d;\n");
  w_s(&mut out, "        return ((uint64_t)ntohl(from.sin_addr.s_addr) << 32) | ((uint64_t)ntohs(from.sin_port) << 16) | (uint64_t)n;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 17) {   /* the local (b 0) or remote (b 1) address of socket a: the address bytes go into *buf, the answer is the port and the family (4 or 6) << 16 */\n");
  w_s(&mut out, "        struct sockaddr_storage ss;\n");
  w_s(&mut out, "        socklen_t sl = sizeof ss;\n");
  w_s(&mut out, "        if ((b ? getpeername((int)a, (struct sockaddr *)&ss, &sl) : getsockname((int)a, (struct sockaddr *)&ss, &sl)) != 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "        unsigned char *d; uint64_t n, port, fam;\n");
  w_s(&mut out, "        if (ss.ss_family == AF_INET) { struct sockaddr_in *p4 = (struct sockaddr_in *)&ss; n = 4; fam = 4; port = ntohs(p4->sin_port); d = (unsigned char *)malloc(4); if (d) memcpy(d, &p4->sin_addr, 4); }\n");
  w_s(&mut out, "        else if (ss.ss_family == AF_INET6) { struct sockaddr_in6 *p6 = (struct sockaddr_in6 *)&ss; n = 16; fam = 6; port = ntohs(p6->sin6_port); d = (unsigned char *)malloc(16); if (d) memcpy(d, &p6->sin6_addr, 16); }\n");
  w_s(&mut out, "        else return ~(uint64_t)0;\n");
  w_s(&mut out, "        if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        free(buf->data);\n");
  w_s(&mut out, "        buf->len = n;\n");
  w_s(&mut out, "        buf->data = d;\n");
  w_s(&mut out, "        return port | (fam << 16);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 18 || op == 19) {   /* the Unix socket at the path in *buf: connect (limit b >> 16 ms), or listen */\n");
  w_s(&mut out, "        struct sockaddr_un su;\n");
  w_s(&mut out, "        socklen_t sul = 0;\n");
  w_s(&mut out, "        if (!bst_unix_addr(&su, &sul, buf)) return ~(uint64_t)0;\n");
  w_s(&mut out, "        int fd = socket(AF_UNIX, SOCK_STREAM, 0);\n");
  w_s(&mut out, "        if (fd < 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "        int bad;\n");
  w_s(&mut out, "        if (op == 19) bad = bind(fd, (struct sockaddr *)&su, sul) != 0 || listen(fd, 128) != 0;\n");
  w_s(&mut out, "        else if (b >> 16) bad = bst_connect_limit(fd, (struct sockaddr *)&su, sul, b >> 16) != 0;\n");
  w_s(&mut out, "        else bad = connect(fd, (struct sockaddr *)&su, sul) != 0;\n");
  w_s(&mut out, "        if (bad) {\n");
  w_s(&mut out, "            close(fd);\n");
  w_s(&mut out, "            return ~(uint64_t)0;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        return (uint64_t)fd;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 20) {   /* set the option b of socket a to the bytes in *buf: 1 and 2 join and leave the IPv4 multicast group (group, interface: 4 + 4 bytes), 3 the multicast interface (4 bytes), 4 the multicast TTL, 5 multicast loopback, 6 the TTL, 7 SO_BROADCAST (1 byte each) */\n");
  w_s(&mut out, "        int fd = (int)a;\n");
  w_s(&mut out, "        if (b == 1 || b == 2) {\n");
  w_s(&mut out, "            if (buf->len != 8) return ~(uint64_t)0;   /* a struct ip_mreq: the group, then the interface */\n");
  w_s(&mut out, "            return setsockopt(fd, IPPROTO_IP, b == 1 ? IP_ADD_MEMBERSHIP : IP_DROP_MEMBERSHIP, buf->data, 8) == 0 ? 0 : ~(uint64_t)0;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        if (b == 3) {\n");
  w_s(&mut out, "            struct in_addr ia;\n");
  w_s(&mut out, "            if (buf->len != 4) return ~(uint64_t)0;\n");
  w_s(&mut out, "            memcpy(&ia, buf->data, 4);\n");
  w_s(&mut out, "            return setsockopt(fd, IPPROTO_IP, IP_MULTICAST_IF, &ia, sizeof ia) == 0 ? 0 : ~(uint64_t)0;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        if (b >= 4 && b <= 7) {\n");
  w_s(&mut out, "            int v = buf->len == 1 ? buf->data[0] : -1;\n");
  w_s(&mut out, "            if (v < 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "            int lvl = b == 7 ? SOL_SOCKET : IPPROTO_IP;\n");
  w_s(&mut out, "            int opt = b == 4 ? IP_MULTICAST_TTL : b == 5 ? IP_MULTICAST_LOOP : b == 6 ? IP_TTL : SO_BROADCAST;\n");
  w_s(&mut out, "            return setsockopt(fd, lvl, opt, &v, sizeof v) == 0 ? 0 : ~(uint64_t)0;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        return ~(uint64_t)0;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 12) {   /* the outcome of a connect that was started with 11 */\n");
  w_s(&mut out, "        int err = 0;\n");
  w_s(&mut out, "        socklen_t el = sizeof err;\n");
  w_s(&mut out, "        if (getsockopt((int)a, SOL_SOCKET, SO_ERROR, &err, &el) != 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "        return (uint64_t)err;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 0 || op == 2 || op == 11) {\n");
  w_s(&mut out, "        int fd = socket(AF_INET, SOCK_STREAM, 0);\n");
  w_s(&mut out, "        if (fd < 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "        if (op == 11) {\n");
  w_s(&mut out, "            int fl = fcntl(fd, F_GETFL, 0);\n");
  w_s(&mut out, "            if (fl < 0 || fcntl(fd, F_SETFL, fl | O_NONBLOCK) != 0) { close(fd); return ~(uint64_t)0; }\n");
  w_s(&mut out, "            if (connect(fd, (struct sockaddr *)&sa, sizeof sa) != 0 && errno != EINPROGRESS) { close(fd); return ~(uint64_t)0; }\n");
  w_s(&mut out, "            return (uint64_t)fd;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        if (op == 0) {\n");
  w_s(&mut out, "            int one = 1;\n");
  w_s(&mut out, "            setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);\n");
  w_s(&mut out, "            if (bind(fd, (struct sockaddr *)&sa, sizeof sa) != 0 || listen(fd, 128) != 0) { close(fd); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        } else if ((b >> 16) ? bst_connect_limit(fd, (struct sockaddr *)&sa, sizeof sa, b >> 16) != 0 : connect(fd, (struct sockaddr *)&sa, sizeof sa) != 0) {\n");
  w_s(&mut out, "            close(fd);\n");
  w_s(&mut out, "            return ~(uint64_t)0;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        return (uint64_t)fd;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 1) {\n");
  w_s(&mut out, "        int fd = accept((int)a, NULL, NULL);\n");
  w_s(&mut out, "        return fd < 0 ? ~(uint64_t)0 : (uint64_t)fd;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 3) {\n");
  w_s(&mut out, "        unsigned char *d = (unsigned char *)malloc(b ? b : 1);\n");
  w_s(&mut out, "        if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        ssize_t n = read((int)a, d, b);\n");
  w_s(&mut out, "        if (n < 0) { free(d); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        free(buf->data);\n");
  w_s(&mut out, "        buf->len = (uint64_t)n;\n");
  w_s(&mut out, "        buf->data = d;\n");
  w_s(&mut out, "        return (uint64_t)n;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 4) {\n");
  w_s(&mut out, "#ifdef MSG_NOSIGNAL\n");
  w_s(&mut out, "        ssize_t n = send((int)a, buf->data, buf->len, MSG_NOSIGNAL);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        ssize_t n = send((int)a, buf->data, buf->len, 0);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        return n < 0 ? ~(uint64_t)0 : (uint64_t)n;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 5) return close((int)a) == 0 ? 0 : ~(uint64_t)0;\n");
  w_s(&mut out, "    if (op == 10) return b <= 2 && shutdown((int)a, (int)b) == 0 ? 0 : ~(uint64_t)0;\n");
  w_s(&mut out, "    if (op == 6) {\n");
  w_s(&mut out, "        socklen_t len = sizeof sa;\n");
  w_s(&mut out, "        if (getsockname((int)a, (struct sockaddr *)&sa, &len) != 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "        return (uint64_t)ntohs(sa.sin_port);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return ~(uint64_t)0;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
}

fn cg_prelude_bytes(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Box[T]: one allocation from the same allocator as Buf. */\n");
  w_s(&mut out, "static void *bst_box_alloc(uint64_t n) { return bst_alloc((n + 7) / 8).data; }\n");
  w_s(&mut out, "/* The same, or 0 when out of memory (try_box). */\n");
  w_s(&mut out, "static void *bst_box_try_alloc(uint64_t n) { return bst_try_alloc((n + 7) / 8).data; }\n");
  w_s(&mut out, "static void bst_box_free(void *p, uint64_t n) { bst_buf w = { (n + 7) / 8, (uint64_t *)p }; bst_free(w); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Vec[T]: elements in one allocation that doubles when full. A size past\n");
  w_s(&mut out, " * 2^60 bytes asks the allocator for more than it can give, so it aborts\n");
  w_s(&mut out, " * (out of memory), as `alloc` does. */\n");
  w_s(&mut out, "typedef struct { uint64_t len, cap; void *data; } bst_vec;\n");
  w_s(&mut out, "static void bst_vec_release(bst_vec v, uint64_t size) {\n");
  w_s(&mut out, "    if (v.data) { bst_buf b = { (v.cap * size + 7) / 8, (uint64_t *)v.data }; bst_free(b); }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_vec_grow(bst_vec *v, uint64_t size) {\n");
  w_s(&mut out, "    uint64_t ncap = v->cap ? v->cap * 2 : 4;\n");
  w_s(&mut out, "    uint64_t bytes = ncap > (UINT64_C(1) << 60) / size ? ~UINT64_C(0) - 8 : ncap * size;\n");
  w_s(&mut out, "    v->data = bst_regrow((uint64_t *)v->data, (v->cap * size + 7) / 8, (bytes + 7) / 8);\n");
  w_s(&mut out, "    v->cap = ncap;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* vec_try_reserve: room for k more elements, or false with the vector\n");
  w_s(&mut out, " * unchanged. The capacity stays at most 2^60 elements, as the prover\n");
  w_s(&mut out, " * assumes. */\n");
  w_s(&mut out, "static bool bst_vec_try_grow(bst_vec *v, uint64_t k, uint64_t size) {\n");
  w_s(&mut out, "    uint64_t lim = (UINT64_C(1) << 60) / size;\n");
  w_s(&mut out, "    if (k <= v->cap - v->len) return true;\n");
  w_s(&mut out, "    if (v->len > lim || k > lim - v->len) return false;\n");
  w_s(&mut out, "    uint64_t ncap = v->len + k;\n");
  w_s(&mut out, "    if (v->cap <= lim / 2 && v->cap * 2 > ncap) ncap = v->cap * 2;\n");
  w_s(&mut out, "    uint64_t *d = bst_try_regrow((uint64_t *)v->data, (v->cap * size + 7) / 8, (ncap * size + 7) / 8);\n");
  w_s(&mut out, "    if (!d) return false;\n");
  w_s(&mut out, "    v->data = d;\n");
  w_s(&mut out, "    v->cap = ncap;\n");
  w_s(&mut out, "    return true;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bset(bst_bytes *b, uint64_t i, uint64_t v) { b->data[i] = (unsigned char)v; }\n");
  w_s(&mut out, "/* Bulk copies. The prover has shown both ranges in bounds, so there are no\n");
  w_s(&mut out, " * checks. Kernels are built with -mgeneral-regs-only and no libc, so on\n");
  w_s(&mut out, " * x86-64 a forward copy is one rep movsb where the platform has set\n");
  w_s(&mut out, " * bst_copy_erms (CPUID.7:EBX bit 9: fast strings copy by whole cache\n");
  w_s(&mut out, " * lines, faster than rep movsq on a page), else rep movsq then rep movsb\n");
  w_s(&mut out, " * (an emulator runs rep movsb byte by byte). Nothing here calls memcpy or\n");
  w_s(&mut out, " * memmove. */\n");
  w_s(&mut out, "#if defined(__x86_64__)\n");
  w_s(&mut out, "uint8_t bst_copy_erms;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static inline void bst_copy_fwd(unsigned char *d, const unsigned char *s, uint64_t n) {\n");
  w_s(&mut out, "#if defined(__x86_64__)\n");
  w_s(&mut out, "    if (!bst_copy_erms) {\n");
  w_s(&mut out, "        uint64_t w = n >> 3;\n");
  w_s(&mut out, "        __asm__ volatile (\"rep movsq\" : \"+D\"(d), \"+S\"(s), \"+c\"(w) : : \"memory\");\n");
  w_s(&mut out, "        n &= 7;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    __asm__ volatile (\"rep movsb\" : \"+D\"(d), \"+S\"(s), \"+c\"(n) : : \"memory\");\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) d[k] = s[k];\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Highest byte first, for an overlapping move to a higher address. Not\n");
  w_s(&mut out, " * std + rep movsb: an interrupt taken while the direction flag is set would\n");
  w_s(&mut out, " * run its handler with it set. The empty asm keeps the compiler from\n");
  w_s(&mut out, " * turning the loop into a call to memmove. */\n");
  w_s(&mut out, "static inline void bst_copy_back(unsigned char *d, const unsigned char *s, uint64_t n) {\n");
  w_s(&mut out, "    while (n > 0) { n--; d[n] = s[n]; __asm__ volatile (\"\" : : : \"memory\"); }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bcopy(bst_bytes *dst, uint64_t d, bst_bytes src, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd(dst->data + d, src.data + s, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bmove(bst_bytes *b, uint64_t d, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    if (n == 0) return;\n");
  w_s(&mut out, "    if (d <= s || d - s >= n) bst_copy_fwd(b->data + d, b->data + s, n);\n");
  w_s(&mut out, "    else bst_copy_back(b->data + d, b->data + s, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_bytes bst_bfrom(bst_str s) {\n");
  w_s(&mut out, "    bst_bytes b = bst_balloc(s.len);\n");
  w_s(&mut out, "    for (uint64_t i = 0; i < s.len; i++) b.data[i] = s.data[i];\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
}

fn cg_prelude_ports(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline bst_portio bst_port_claim(bst_ports *p, uint64_t b, uint64_t c) { (void)p; bst_portio io = { b, c }; return io; }\n");
  w_s(&mut out, "static inline void bst_port_release(bst_ports *p, bst_portio io) { (void)p; (void)io; }\n");
  w_s(&mut out, "static inline uint64_t bst_port_base(bst_portio io) { return io.base; }\n");
  w_s(&mut out, "static inline uint64_t bst_port_count(bst_portio io) { return io.count; }\n");
}

fn cg_prelude_mmio(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline bst_mmio bst_mmio_claim(bst_mmiospace *s, uint64_t b, uint64_t l) { (void)s; BST_MMIO_CHECK(b, l); bst_mmio m = { b, l }; return m; }\n");
  w_s(&mut out, "static inline void bst_mmio_release(bst_mmiospace *s, bst_mmio m) { (void)s; (void)m; }\n");
  w_s(&mut out, "static inline uint64_t bst_mmio_base(bst_mmio m) { return m.base; }\n");
  w_s(&mut out, "static inline uint64_t bst_mmio_len(bst_mmio m) { return m.len; }\n");
}

fn cg_prelude_mmio_kernel(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Device memory above 512 GiB is mapped only in the kernel's tables, so a\n");
  w_s(&mut out, " * parked user table (bst_mmu_exit) goes back before it is touched. */\n");
  w_s(&mut out, "#define BST_MMIO_HIGH(a) do { if ((a) >= (1ull << 39)) bst_mmu_settle(); } while (0)\n");
  w_s(&mut out, "#define BST_MMIO_RW(w, t) \\\n");
  w_s(&mut out, "    static inline uint64_t bst_mmio_read##w(bst_mmio *m, uint64_t o) { BST_MMIO_HIGH(m->base + o); return *(volatile t *)(uintptr_t)(m->base + o); } \\\n");
  w_s(&mut out, "    static inline void bst_mmio_write##w(bst_mmio *m, uint64_t o, uint64_t v) { BST_MMIO_HIGH(m->base + o); *(volatile t *)(uintptr_t)(m->base + o) = (t)v; }\n");
  w_s(&mut out, "BST_MMIO_RW(8, uint8_t) BST_MMIO_RW(16, uint16_t) BST_MMIO_RW(32, uint32_t) BST_MMIO_RW(64, uint64_t)\n");
}

fn cg_prelude_dma(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline bst_dma bst_dma_lend(bst_frame f) { __atomic_thread_fence(__ATOMIC_SEQ_CST); return f; }\n");
  w_s(&mut out, "static inline bst_frame bst_dma_take(bst_dma d) { __atomic_thread_fence(__ATOMIC_SEQ_CST); return d; }\n");
  w_s(&mut out, "static inline uint64_t bst_dma_id(bst_dma d) { return bst_frame_id(d); }\n");
  w_s(&mut out, "static inline uint64_t bst_dma_addr(bst_dma d) { return d; }\n");
  w_s(&mut out, "#define BST_DMA_RW(w, t) \\\n");
  w_s(&mut out, "    static inline uint64_t bst_dma_read##w(bst_dma *d, uint64_t o) { return *(volatile t *)(uintptr_t)(*d + o); } \\\n");
  w_s(&mut out, "    static inline void bst_dma_write##w(bst_dma *d, uint64_t o, uint64_t v) { *(volatile t *)(uintptr_t)(*d + o) = (t)v; }\n");
  w_s(&mut out, "BST_DMA_RW(8, uint8_t) BST_DMA_RW(16, uint16_t) BST_DMA_RW(32, uint32_t) BST_DMA_RW(64, uint64_t)\n");
  w_s(&mut out, "/* A copy to or from a lent page is a compiler barrier on both sides, so it\n");
  w_s(&mut out, " * stays in order with the volatile accesses around it. */\n");
  w_s(&mut out, "static inline void bst_dma_to_bytes(bst_bytes *dst, uint64_t d, bst_dma *m, uint64_t o, uint64_t n) {\n");
  w_s(&mut out, "    __asm__ volatile (\"\" : : : \"memory\");\n");
  w_s(&mut out, "    if (n) bst_copy_fwd(dst->data + d, (const unsigned char *)(uintptr_t)(*m + o), n);\n");
  w_s(&mut out, "    __asm__ volatile (\"\" : : : \"memory\");\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bytes_to_dma(bst_dma *m, uint64_t o, bst_bytes src, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    __asm__ volatile (\"\" : : : \"memory\");\n");
  w_s(&mut out, "    if (n) bst_copy_fwd((unsigned char *)(uintptr_t)(*m + o), src.data + s, n);\n");
  w_s(&mut out, "    __asm__ volatile (\"\" : : : \"memory\");\n");
  w_s(&mut out, "}\n");
}

fn cg_prelude_mmio_hosted(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static unsigned char bst_mmio_cell[1u << 20];\n");
  w_s(&mut out, "#define BST_MMIO_RW(w, t) \\\n");
  w_s(&mut out, "    static inline uint64_t bst_mmio_read##w(bst_mmio *m, uint64_t o) { t v; memcpy(&v, &bst_mmio_cell[(m->base + o) & 0xFFFFF], sizeof v); return v; } \\\n");
  w_s(&mut out, "    static inline void bst_mmio_write##w(bst_mmio *m, uint64_t o, uint64_t v) { t x = (t)v; memcpy(&bst_mmio_cell[(m->base + o) & 0xFFFFF], &x, sizeof x); }\n");
  w_s(&mut out, "BST_MMIO_RW(8, uint8_t) BST_MMIO_RW(16, uint16_t) BST_MMIO_RW(32, uint32_t) BST_MMIO_RW(64, uint64_t)\n");
}

fn cg_prelude_ports_kernel(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline uint64_t bst_pio_in8(bst_portio *io, uint64_t o) { return bst_inb((uint16_t)(io->base + o)); }\n");
  w_s(&mut out, "static inline uint64_t bst_pio_in16(bst_portio *io, uint64_t o) { uint16_t v; __asm__ volatile (\"inw %1, %0\" : \"=a\"(v) : \"Nd\"((uint16_t)(io->base + o))); return v; }\n");
  w_s(&mut out, "static inline uint64_t bst_pio_in32(bst_portio *io, uint64_t o) { uint32_t v; __asm__ volatile (\"inl %1, %0\" : \"=a\"(v) : \"Nd\"((uint16_t)(io->base + o))); return v; }\n");
  w_s(&mut out, "static inline void bst_pio_out8(bst_portio *io, uint64_t o, uint64_t v) { bst_outb((uint16_t)(io->base + o), (uint8_t)v); }\n");
  w_s(&mut out, "static inline void bst_pio_out16(bst_portio *io, uint64_t o, uint64_t v) { __asm__ volatile (\"outw %0, %1\" : : \"a\"((uint16_t)v), \"Nd\"((uint16_t)(io->base + o))); }\n");
  w_s(&mut out, "static inline void bst_pio_out32(bst_portio *io, uint64_t o, uint64_t v) { __asm__ volatile (\"outl %0, %1\" : : \"a\"((uint32_t)v), \"Nd\"((uint16_t)(io->base + o))); }\n");
}

fn cg_prelude_ports_hosted(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static uint32_t bst_port_cell[65536];\n");
  w_s(&mut out, "static inline uint64_t bst_pio_in8(bst_portio *io, uint64_t o) { return bst_port_cell[io->base + o] & 0xFF; }\n");
  w_s(&mut out, "static inline uint64_t bst_pio_in16(bst_portio *io, uint64_t o) { return bst_port_cell[io->base + o] & 0xFFFF; }\n");
  w_s(&mut out, "static inline uint64_t bst_pio_in32(bst_portio *io, uint64_t o) { return bst_port_cell[io->base + o]; }\n");
  w_s(&mut out, "static inline void bst_pio_out8(bst_portio *io, uint64_t o, uint64_t v) { bst_port_cell[io->base + o] = (uint32_t)v; }\n");
  w_s(&mut out, "static inline void bst_pio_out16(bst_portio *io, uint64_t o, uint64_t v) { bst_port_cell[io->base + o] = (uint32_t)v; }\n");
  w_s(&mut out, "static inline void bst_pio_out32(bst_portio *io, uint64_t o, uint64_t v) { bst_port_cell[io->base + o] = (uint32_t)v; }\n");
}

fn cg_prelude_kernel_cpu(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline void bst_load_cr3(uint64_t a) { __asm__ volatile (\"mov %0, %%cr3\" : : \"r\"(a) : \"memory\"); }\n");
  w_s(&mut out, "static inline uint64_t bst_read_cr3(void) { uint64_t a; __asm__ volatile (\"mov %%cr3, %0\" : \"=r\"(a)); return a; }\n");
  w_s(&mut out, "/* Three words per processor, zero at boot, if the platform keeps them: the\n");
  w_s(&mut out, " * table this processor parked (0: none), bst_pt_gen as of its last CR3\n");
  w_s(&mut out, " * load, and how many locks it holds. Without them every switch loads CR3\n");
  w_s(&mut out, " * at once. */\n");
  w_s(&mut out, "extern uint64_t *bst_platform_mmu_state(void) __attribute__((weak));\n");
  w_s(&mut out, "static inline uint64_t *bst_mmu_state(void) { return bst_platform_mmu_state ? bst_platform_mmu_state() : 0; }\n");
  w_s(&mut out, "/* A platform that gives user code a table of its own, with none of the\n");
  w_s(&mut out, " * kernel's memory in it (BastiOS: boot/boot.S loads it in bst_cpu_enter and\n");
  w_s(&mut out, " * leaves it at the next trap), defines this symbol and keeps a fourth word\n");
  w_s(&mut out, " * with the state. The kernel's tables then stay in CR3 whenever Bastio code\n");
  w_s(&mut out, " * runs: entering a table only records it in word 3, for bst_cpu_enter, and\n");
  w_s(&mut out, " * the lease is dropped as soon as the processor is done with the table. */\n");
  w_s(&mut out, "extern const char bst_platform_deferred_cr3 __attribute__((weak));\n");
  w_s(&mut out, "#define BST_DEFERRED (&bst_platform_deferred_cr3 != 0)\n");
  w_s(&mut out, "static inline void bst_cr3_load(uint64_t *s, uint64_t a) {\n");
  w_s(&mut out, "    if (s) s[1] = __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    bst_load_cr3(a);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Gives a parked table back: the kernel's tables go into CR3 first, then\n");
  w_s(&mut out, " * the lease's count drops, as bst_mmu_exit does without parking. */\n");
  w_s(&mut out, "static inline void bst_mmu_settle(void) {\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (!s || !s[0]) return;\n");
  w_s(&mut out, "    uint64_t l = s[0];\n");
  w_s(&mut out, "    s[0] = 0;\n");
  w_s(&mut out, "    bst_cr3_load(s, (uint64_t)bst_kernel_pml4);\n");
  w_s(&mut out, "    __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_mmu_settle_on(uint64_t t) {\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (s && s[0] == t) bst_mmu_settle();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_lock_depth(int d) {\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (!s) return;\n");
  w_s(&mut out, "    s[2] += (uint64_t)(int64_t)d;\n");
  w_s(&mut out, "    if (s[2] == 0 && s[0]) bst_mmu_settle();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_mmu_kernel(bst_mmu *m) { (void)m; bst_mmu_settle(); if (!BST_DEFERRED) bst_load_cr3((uint64_t)bst_kernel_pml4); }\n");
  w_s(&mut out, "/* A table this processor parked becomes the new lease without a second\n");
  w_s(&mut out, " * count. CR3 is loaded only if it holds another table, or if an entry was\n");
  w_s(&mut out, " * taken out of some table since the last load (bst_pt_gen). */\n");
  w_s(&mut out, "static inline bst_lease bst_mmu_enter(bst_mmu *m, bst_pt *t) {\n");
  w_s(&mut out, "    (void)m;\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (BST_DEFERRED) {\n");
  w_s(&mut out, "        __atomic_fetch_add(&bst_pt_leases[bst_frame_id(*t)], 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "        s[3] = *t;\n");
  w_s(&mut out, "        return *t;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (s && s[0] == *t) s[0] = 0;\n");
  w_s(&mut out, "    else __atomic_fetch_add(&bst_pt_leases[bst_frame_id(*t)], 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    if (!s || bst_read_cr3() != *t || s[1] != __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST)) bst_cr3_load(s, *t);\n");
  w_s(&mut out, "    if (s && s[0]) {                    /* another table was parked, and CR3 has left it */\n");
  w_s(&mut out, "        uint64_t l = s[0];\n");
  w_s(&mut out, "        s[0] = 0;\n");
  w_s(&mut out, "        __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return *t;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The count drops only once this processor no longer uses the table. Where\n");
  w_s(&mut out, " * the platform keeps bst_mmu_state, the table is parked instead: it stays\n");
  w_s(&mut out, " * in CR3 with its lease counted, so a process that runs again next (after\n");
  w_s(&mut out, " * a system call, say) costs no TLB flush. Every table maps the kernel's\n");
  w_s(&mut out, " * memory the same way (pml4 entry 0, BST_PT_NEW_HOOK), and nothing proved\n");
  w_s(&mut out, " * reaches the user window without a lease, so kernel code runs the same\n");
  w_s(&mut out, " * either way. The lease goes back (bst_mmu_settle) when the processor\n");
  w_s(&mut out, " * enters another table, waits for a lock or an interrupt, lets go of its\n");
  w_s(&mut out, " * last lock without entering the table again, touches MMIO above 512 GiB\n");
  w_s(&mut out, " * (mapped only in the kernel's tables), returns from its smp_run function,\n");
  w_s(&mut out, " * or asks for that table's lease count. So other processors see the lease\n");
  w_s(&mut out, " * held no longer than if the process had trapped a moment later. */\n");
  w_s(&mut out, "static inline void bst_mmu_exit(bst_mmu *m, bst_lease l) {\n");
  w_s(&mut out, "    (void)m;\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (BST_DEFERRED) {\n");
  w_s(&mut out, "        s[3] = 0;\n");
  w_s(&mut out, "        __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "        return;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (s) {\n");
  w_s(&mut out, "        s[0] = l;\n");
  w_s(&mut out, "        return;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_load_cr3((uint64_t)bst_kernel_pml4);\n");
  w_s(&mut out, "    __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_frame bst_pt_free_root(bst_mmu m, bst_pt t) { (void)m; return t; }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Saved user registers: rax rbx rcx rdx rsi rdi rbp r8-r15 (0-14), rip (15),\n");
  w_s(&mut out, " * rsp (16), rflags (17), error code (18), fault address (19), FS base (20). */\n");
  w_s(&mut out, "extern uint64_t *bst_platform_ctx(void) __attribute__((const)); /* this processor's saved context, 21 words; the same for the whole of a call, so loops over it call once */\n");
  w_s(&mut out, "extern uint64_t bst_cpu_enter(void);   /* enter user mode; returns the trap vector */\n");
  w_s(&mut out, "extern uint64_t bst_cpu_wait(void);    /* sti; hlt; cli; returns the interrupt vector */\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_get(bst_cpu c, uint64_t r) { (void)c; return bst_platform_ctx()[r]; }\n");
  w_s(&mut out, "static inline void bst_cpu_set(bst_cpu *c, uint64_t r, uint64_t v) { (void)c; bst_platform_ctx()[r] = v; }\n");
  w_s(&mut out, "/* The user's x87/SSE state, in a page the kernel owns (the platform has\n");
  w_s(&mut out, " * enabled CR4.OSFXSR). fxrstor faults on reserved MXCSR bits, so the load\n");
  w_s(&mut out, " * keeps only the defined bits (0-15) while it runs and puts the word back. */\n");
  w_s(&mut out, "static inline void bst_cpu_fpu_save(bst_cpu *c, bst_frame *f) {\n");
  w_s(&mut out, "    (void)c;\n");
  w_s(&mut out, "    __asm__ volatile (\"fxsave64 (%0)\" : : \"r\"(*f) : \"memory\");\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_cpu_fpu_load(bst_cpu *c, bst_frame f) {\n");
  w_s(&mut out, "    (void)c;\n");
  w_s(&mut out, "    uint64_t *w = (uint64_t *)f, w3 = w[3];\n");
  w_s(&mut out, "    w[3] = w3 & 0xFFFF;                 /* bytes 24-27 are MXCSR, 28-31 its mask (ignored) */\n");
  w_s(&mut out, "    __asm__ volatile (\"fxrstor64 (%0)\" : : \"r\"(f) : \"memory\");\n");
  w_s(&mut out, "    w[3] = w3;                          /* the page reads as it did */\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_run(bst_cpu *c, bst_mmu m) {\n");
  w_s(&mut out, "    (void)c; (void)m;\n");
  w_s(&mut out, "    if (BST_DEFERRED) return bst_cpu_enter();    /* it loads the table, which flushes the TLB */\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    /* flush the TLB if pages may have moved since the last load */\n");
  w_s(&mut out, "    if (!s || s[1] != __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST)) bst_cr3_load(s, bst_read_cr3());\n");
  w_s(&mut out, "    return bst_cpu_enter();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_idle(bst_cpu *c) { (void)c; bst_mmu_settle(); return bst_cpu_wait(); }\n");
  w_s(&mut out, "extern void bst_platform_smp_start(void (*fn)(void *), void *arg); /* run fn(arg) on every other processor */\n");
  w_s(&mut out, "extern void bst_platform_smp_join(void);                           /* wait until all of them have returned */\n");
  w_s(&mut out, "extern uint64_t bst_platform_cpus(void); /* processors running, this one included; 1 to 4096 */\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_count(bst_cpu c) { (void)c; return bst_platform_cpus(); }\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_tsc(bst_cpu c) { (void)c; uint32_t lo, hi; __asm__ volatile(\"rdtsc\" : \"=a\"(lo), \"=d\"(hi)); return (uint64_t)hi << 32 | lo; }\n");
  w_s(&mut out, "/* The Multiboot information the loader passed (0: none), and field f of the\n");
  w_s(&mut out, " * linear framebuffer it set up, if that is 32-bit RGB and lies below 4 GiB:\n");
  w_s(&mut out, " * 0 its address, 1 bytes per line, 2 width and 3 height in pixels, 4 the\n");
  w_s(&mut out, " * bit positions of red, green and blue, a byte each. All 0 without one. */\n");
  w_s(&mut out, "static uint64_t bst_boot_fb(bst_cpu c, uint64_t f) {\n");
  w_s(&mut out, "    (void)c;\n");
  w_s(&mut out, "    uint8_t *mb = (uint8_t *)bst_mbi;\n");
  w_s(&mut out, "    if (!mb || !(*(uint32_t *)mb & (1u << 12)) || mb[109] != 1 || mb[108] != 32) return 0;\n");
  w_s(&mut out, "    uint64_t addr = *(uint64_t *)(mb + 88), pitch = *(uint32_t *)(mb + 96);\n");
  w_s(&mut out, "    uint64_t w = *(uint32_t *)(mb + 100), h = *(uint32_t *)(mb + 104);\n");
  w_s(&mut out, "    if (addr == 0 || addr >= (1ull << 32) || pitch < w * 4 || pitch * h > (1ull << 32) - addr) return 0;    /* no wrap: the verifier takes every field as below 2^32 */\n");
  w_s(&mut out, "    if (f == 0) return addr;\n");
  w_s(&mut out, "    if (f == 1) return pitch;\n");
  w_s(&mut out, "    if (f == 2) return w;\n");
  w_s(&mut out, "    if (f == 3) return h;\n");
  w_s(&mut out, "    if (f == 4) return mb[110] | (uint64_t)mb[112] << 8 | (uint64_t)mb[114] << 16;\n");
  w_s(&mut out, "    return 0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Byte `off` of the ACPI table whose signature is `sig` (its four letters\n");
  w_s(&mut out, " * as a little-endian number; \"DSDT\" is the one the FADT points at), or 256\n");
  w_s(&mut out, " * past its end or without one. The platform finds the tables. */\n");
  w_s(&mut out, "extern uint64_t bst_platform_acpi(uint64_t sig, uint64_t off);\n");
  w_s(&mut out, "static inline uint64_t bst_boot_acpi(bst_cpu c, uint64_t sig, uint64_t off) { (void)c; return bst_platform_acpi(sig, off); }\n");
  w_s(&mut out, "/* Answer `i` to the platform's query `what` about the machine (its boot\n");
  w_s(&mut out, " * command line, memory map, processor, ...: the platform defines them), or\n");
  w_s(&mut out, " * 0. Read-only; nothing is promised about the number. */\n");
  w_s(&mut out, "extern uint64_t bst_platform_info(uint64_t what, uint64_t i);\n");
  w_s(&mut out, "static inline uint64_t bst_boot_info(bst_cpu c, uint64_t what, uint64_t i) { (void)c; return bst_platform_info(what, i); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Called by the platform on a fault in kernel mode: that is a bug in the\n");
  w_s(&mut out, " * trusted base or the compiler, never in verified code. */\n");
  w_s(&mut out, "void bst_kernel_fault(uint64_t vec, uint64_t rip, uint64_t cr2, uint64_t err) {\n");
  w_s(&mut out, "    bst_puts(\"\\nbastio: kernel fault, vector \"); bst_puthex(vec);\n");
  w_s(&mut out, "    bst_puts(\" rip \"); bst_puthex(rip); bst_puts(\" cr2 \"); bst_puthex(cr2); bst_puts(\" err \"); bst_puthex(err);\n");
  w_s(&mut out, "    bst_puts(\"\\n\");\n");
  w_s(&mut out, "    bst_halt();\n");
  w_s(&mut out, "}\n");
}

fn cg_prelude_user(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline void bst_mmu_settle(void) { }\n");
  w_s(&mut out, "static inline void bst_lock_depth(int d) { (void)d; }\n");
  w_s(&mut out, "enum { BST_SYS_EXIT, BST_SYS_WRITE, BST_SYS_READ, BST_SYS_SPAWN, BST_SYS_WAIT, BST_SYS_YIELD,\n");
  w_s(&mut out, "       BST_SYS_GETPID, BST_SYS_INFO, BST_SYS_PS, BST_SYS_KILL, BST_SYS_POWEROFF };\n");
  w_s(&mut out, "static inline uint64_t bst_sys(uint64_t n, uint64_t a, uint64_t b, uint64_t c) {\n");
  w_s(&mut out, "    uint64_t r;\n");
  w_s(&mut out, "    __asm__ volatile (\"int $0x80\" : \"=a\"(r) : \"a\"(n), \"D\"(a), \"S\"(b), \"d\"(c) : \"memory\");\n");
  w_s(&mut out, "    return r;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static unsigned char bst_out[256];\n");
  w_s(&mut out, "static uint64_t bst_out_n;\n");
  w_s(&mut out, "static void bst_flush(void) {\n");
  w_s(&mut out, "    if (bst_out_n) bst_sys(BST_SYS_WRITE, (uint64_t)bst_out, bst_out_n, 0);\n");
  w_s(&mut out, "    bst_out_n = 0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    bst_out[bst_out_n++] = (unsigned char)b;\n");
  w_s(&mut out, "    if (b == '\\n' || bst_out_n == sizeof bst_out) bst_flush();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) { (void)s; bst_flush(); return bst_sys(BST_SYS_READ, 0, 0, 0); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "#define BST_ARENA_WORDS (1u << 13)   /* 64 KiB */\n");
  w_s(&mut out, "static uint64_t bst_arena[BST_ARENA_WORDS];\n");
  w_s(&mut out, "static uint64_t bst_arena_top = 0;\n");
  w_s(&mut out, "typedef struct bst_free { uint64_t words; struct bst_free *next; } bst_free_t;\n");
  w_s(&mut out, "static bst_free_t *bst_free_list = 0;\n");
  w_s(&mut out, "/* An empty buffer with no memory when the arena is full. */\n");
  w_s(&mut out, "static bst_buf bst_try_alloc(uint64_t n) {\n");
  w_s(&mut out, "    uint64_t words = (n ? n : 1) + 1;\n");
  w_s(&mut out, "    if (words < 2) words = 2;\n");
  w_s(&mut out, "    bst_free_t **pp = &bst_free_list;\n");
  w_s(&mut out, "    for (bst_free_t *f = bst_free_list; f; pp = &f->next, f = f->next) {\n");
  w_s(&mut out, "        if (f->words == words) {\n");
  w_s(&mut out, "            *pp = f->next;\n");
  w_s(&mut out, "            uint64_t *blk = (uint64_t *)f;\n");
  w_s(&mut out, "            for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  w_s(&mut out, "            bst_buf b = { n, blk + 1 };\n");
  w_s(&mut out, "            return b;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (bst_arena_top + words > BST_ARENA_WORDS) {\n");
  w_s(&mut out, "        bst_buf none = { 0, 0 };\n");
  w_s(&mut out, "        return none;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    uint64_t *blk = &bst_arena[bst_arena_top];\n");
  w_s(&mut out, "    bst_arena_top += words;\n");
  w_s(&mut out, "    blk[0] = words;\n");
  w_s(&mut out, "    for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  w_s(&mut out, "    bst_buf b = { n, blk + 1 };\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf b = bst_try_alloc(n);\n");
  w_s(&mut out, "    if (!b.data) {\n");
  w_s(&mut out, "        static const char m[] = \"bastio: out of memory\\n\";\n");
  w_s(&mut out, "        bst_flush();\n");
  w_s(&mut out, "        bst_sys(BST_SYS_WRITE, (uint64_t)m, sizeof m - 1, 0);\n");
  w_s(&mut out, "        bst_sys(BST_SYS_EXIT, 255, 0, 0);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_free(bst_buf b) {\n");
  w_s(&mut out, "    if (!b.data) return;\n");
  w_s(&mut out, "    uint64_t *blk = b.data - 1;\n");
  w_s(&mut out, "    bst_free_t *f = (bst_free_t *)blk;\n");
  w_s(&mut out, "    f->words = blk[0];\n");
  w_s(&mut out, "    f->next = bst_free_list;\n");
  w_s(&mut out, "    bst_free_list = f;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_print(uint64_t v) {\n");
  w_s(&mut out, "    char d[20]; int n = 0;\n");
  w_s(&mut out, "    do { d[n++] = (char)('0' + v % 10); v /= 10; } while (v);\n");
  w_s(&mut out, "    while (n) bst_serial_write(0, (unsigned char)d[--n]);\n");
  w_s(&mut out, "    bst_serial_write(0, '\\n');\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_sys_spawn(bst_buf b, uint64_t from, uint64_t to) {\n");
  w_s(&mut out, "    unsigned char name[64];\n");
  w_s(&mut out, "    uint64_t n = 0;\n");
  w_s(&mut out, "    for (uint64_t i = from; i < to && n < sizeof name; i++) name[n++] = (unsigned char)b.data[i];\n");
  w_s(&mut out, "    return bst_sys(BST_SYS_SPAWN, (uint64_t)name, n, 0);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_sys_wait(uint64_t pid) { return bst_sys(BST_SYS_WAIT, pid, 0, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_kill(uint64_t pid) { return bst_sys(BST_SYS_KILL, pid, 0, 0); }\n");
  w_s(&mut out, "static inline void bst_sys_yield(void) { bst_sys(BST_SYS_YIELD, 0, 0, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_getpid(void) { return bst_sys(BST_SYS_GETPID, 0, 0, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_info(uint64_t k) { return bst_sys(BST_SYS_INFO, k, 0, 0); }\n");
  w_s(&mut out, "static inline void bst_sys_ps(void) { bst_flush(); bst_sys(BST_SYS_PS, 0, 0, 0); }\n");
  w_s(&mut out, "static inline void bst_sys_poweroff(void) { bst_flush(); bst_sys(BST_SYS_POWEROFF, 0, 0, 0); }\n");
  w_s(&mut out, "/* Calls with numbers the language does not know: the kernel defines them.\n");
  w_s(&mut out, " * sys_send lends the kernel bytes 0..n of b to read; sys_recv lends all of b\n");
  w_s(&mut out, " * to overwrite. Console output is flushed first so it stays in order. */\n");
  w_s(&mut out, "static inline uint64_t bst_sys_call(uint64_t n, uint64_t a, uint64_t b) { bst_flush(); return bst_sys(n, a, b, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_send(uint64_t n, uint64_t a, bst_bytes b, uint64_t len) { bst_flush(); return bst_sys(n, a, (uint64_t)b.data, len); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_recv(uint64_t n, uint64_t a, bst_bytes *b) { bst_flush(); return bst_sys(n, a, (uint64_t)b->data, b->len); }\n");
}

// The prelude parts, numbered: `cg_parts` lists a target's in stage0's
// order (`prelude_parts`), and `--trusted-base` names and counts them.
/// The prelude part for the AArch64 kernel: PL011 console, halting, the Buf arena and the page pool.
fn cg_prelude_kernel_a64(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "/* The console: a PL011 UART, at the address the platform names in\n");
  w_s(&mut out, " * bst_uart_base (QEMU's virt machine has it at 0x09000000, the default).\n");
  w_s(&mut out, " * The baud rate is left as the firmware set it. */\n");
  w_s(&mut out, "extern uint64_t bst_uart_base __attribute__((weak));\n");
  w_s(&mut out, "static inline volatile uint32_t *bst_uart(void) {\n");
  w_s(&mut out, "    return (volatile uint32_t *)(uintptr_t)(&bst_uart_base ? bst_uart_base : 0x09000000ull);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define BST_UART_DR 0      /* data */\n");
  w_s(&mut out, "#define BST_UART_FR 6      /* flags: bit 4 receive FIFO empty, bit 5 transmit FIFO full */\n");
  w_s(&mut out, "#define BST_UART_LCRH 11   /* line control */\n");
  w_s(&mut out, "#define BST_UART_CR 12     /* control */\n");
  w_s(&mut out, "#define BST_UART_IMSC 14   /* interrupt mask */\n");
  w_s(&mut out, "static void bst_serial_init(void) {\n");
  w_s(&mut out, "    volatile uint32_t *u = bst_uart();\n");
  w_s(&mut out, "    u[BST_UART_CR] = 0;            /* off while configuring */\n");
  w_s(&mut out, "    u[BST_UART_LCRH] = 0x70;       /* 8N1, FIFOs on */\n");
  w_s(&mut out, "    u[BST_UART_IMSC] = 0x10;       /* interrupt on received data */\n");
  w_s(&mut out, "    u[BST_UART_CR] = 0x301;        /* on: transmit and receive */\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    volatile uint32_t *u = bst_uart();\n");
  w_s(&mut out, "    while (u[BST_UART_FR] & 0x20) { }\n");
  w_s(&mut out, "    u[BST_UART_DR] = (uint32_t)(uint8_t)b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    volatile uint32_t *u = bst_uart();\n");
  w_s(&mut out, "    while (u[BST_UART_FR] & 0x10) { __asm__ volatile (\"yield\"); }\n");
  w_s(&mut out, "    return u[BST_UART_DR] & 0xFF;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_serial_poll(bst_serial s) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    volatile uint32_t *u = bst_uart();\n");
  w_s(&mut out, "    return (u[BST_UART_FR] & 0x10) ? 256 : (u[BST_UART_DR] & 0xFF);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "static void bst_halt(void) { for (;;) __asm__ volatile (\"msr daifset, #0xf; wfi\"); }\n");
  w_s(&mut out, "static void bst_puts(const char *m) { for (; *m; m++) bst_serial_write(0, (unsigned char)*m); }\n");
  w_s(&mut out, "static void bst_puthex(uint64_t v) {\n");
  w_s(&mut out, "    bst_puts(\"0x\");\n");
  w_s(&mut out, "    for (int i = 60; i >= 0; i -= 4) bst_serial_write(0, (unsigned char)\"0123456789abcdef\"[(v >> i) & 15]);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Memory for Buf: a fixed arena with an exact-size free list, then the\n");
  w_s(&mut out, " * extension bst_pool_init carves from RAM (an eighth of the pool, at least 4 MiB), so\n");
  w_s(&mut out, " * the kernel's own tables can grow with the machine. */\n");
  w_s(&mut out, "#define BST_ARENA_WORDS (1u << 20)   /* 8 MiB */\n");
  w_s(&mut out, "static uint64_t bst_arena[BST_ARENA_WORDS];\n");
  w_s(&mut out, "static uint64_t bst_arena_top = 0;\n");
  w_s(&mut out, "static uint64_t *bst_arena2, bst_arena2_words, bst_arena2_top;\n");
  w_s(&mut out, "typedef struct bst_free { uint64_t words; struct bst_free *next; } bst_free_t;\n");
  w_s(&mut out, "static bst_free_t *bst_free_list = 0;\n");
  w_s(&mut out, "static uint64_t bst_arena_lock;              /* every processor allocates from the one arena */\n");
  w_s(&mut out, "/* An empty buffer with no memory when the arena is full. */\n");
  w_s(&mut out, "static bst_buf bst_try_alloc(uint64_t n) {\n");
  w_s(&mut out, "    uint64_t words = (n ? n : 1) + 1;            /* one header word for the size */\n");
  w_s(&mut out, "    if (words < 2) words = 2;\n");
  w_s(&mut out, "    uint64_t *blk = 0;\n");
  w_s(&mut out, "    bst_lock_acquire(&bst_arena_lock);\n");
  w_s(&mut out, "    bst_free_t **pp = &bst_free_list;\n");
  w_s(&mut out, "    for (bst_free_t *f = bst_free_list; f; pp = &f->next, f = f->next) {\n");
  w_s(&mut out, "        if (f->words == words) {\n");
  w_s(&mut out, "            *pp = f->next;\n");
  w_s(&mut out, "            blk = (uint64_t *)f;\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (!blk && bst_arena_top + words <= BST_ARENA_WORDS) {\n");
  w_s(&mut out, "        blk = &bst_arena[bst_arena_top];\n");
  w_s(&mut out, "        bst_arena_top += words;\n");
  w_s(&mut out, "        blk[0] = words;\n");
  w_s(&mut out, "    } else if (!blk && words <= bst_arena2_words - bst_arena2_top) {\n");
  w_s(&mut out, "        blk = &bst_arena2[bst_arena2_top];\n");
  w_s(&mut out, "        bst_arena2_top += words;\n");
  w_s(&mut out, "        blk[0] = words;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_lock_release(&bst_arena_lock);\n");
  w_s(&mut out, "    if (!blk) { bst_buf none = { 0, 0 }; return none; }\n");
  w_s(&mut out, "    for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  w_s(&mut out, "    bst_buf b = { n, blk + 1 };\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf b = bst_try_alloc(n);\n");
  w_s(&mut out, "    if (!b.data) { bst_puts(\"bastio: out of memory\\n\"); bst_halt(); }\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_free(bst_buf b) {\n");
  w_s(&mut out, "    if (!b.data) return;\n");
  w_s(&mut out, "    uint64_t *blk = b.data - 1;\n");
  w_s(&mut out, "    bst_free_t *f = (bst_free_t *)blk;\n");
  w_s(&mut out, "    bst_lock_acquire(&bst_arena_lock);\n");
  w_s(&mut out, "    f->words = blk[0];\n");
  w_s(&mut out, "    f->next = bst_free_list;\n");
  w_s(&mut out, "    bst_free_list = f;\n");
  w_s(&mut out, "    bst_lock_release(&bst_arena_lock);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_print(uint64_t v) {\n");
  w_s(&mut out, "    char d[20]; int n = 0;\n");
  w_s(&mut out, "    do { d[n++] = (char)('0' + v % 10); v /= 10; } while (v);\n");
  w_s(&mut out, "    while (n) bst_serial_write(0, (unsigned char)d[--n]);\n");
  w_s(&mut out, "    bst_serial_write(0, '\\n');\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Physical pages: every run of RAM the platform lists (bst_kmain's argument\n");
  w_s(&mut out, " * points to a count followed by that many base and length pairs, which the\n");
  w_s(&mut out, " * boot code takes from the device tree) from the end of the kernel image\n");
  w_s(&mut out, " * up to bst_ram_limit, where the platform's identity map of RAM stops (512\n");
  w_s(&mut out, " * GiB, the kernel's first top-level slot, if the platform does not define\n");
  w_s(&mut out, " * it), at most 2^27 pages. Runs that touch are merged; past BST_RUNS the\n");
  w_s(&mut out, " * rest are left out. Page ids are dense over the runs (bst_page_at,\n");
  w_s(&mut out, " * bst_frame_id). The front of the run that holds them is carved off for the\n");
  w_s(&mut out, " * pool's bookkeeping: two 32-bit counters a page (leases, shared\n");
  w_s(&mut out, " * references) and the arena's extension of an eighth of the pool (at least 4\n");
  w_s(&mut out, " * MiB). */\n");
  w_s(&mut out, "extern char _end[];\n");
  w_s(&mut out, "extern uint64_t bst_kernel_root[512];\n");
  w_s(&mut out, "extern uint64_t bst_ram_limit __attribute__((weak));\n");
  w_s(&mut out, "#define BST_RUNS 32\n");
  w_s(&mut out, "#define BST_FRAME_LIMIT (1ull << 27)\n");
  w_s(&mut out, "static uint64_t bst_run_at[BST_RUNS], bst_run_id[BST_RUNS + 1], bst_runs;\n");
  w_s(&mut out, "static uint32_t *bst_pt_leases, *bst_shared_refs;\n");
  w_s(&mut out, "static uint64_t bst_carved_lo, bst_carved_hi;\n");
  w_s(&mut out, "static uint64_t bst_mbi;\n");
  w_s(&mut out, "/* Adds [a, b) to the n sorted runs lo/hi, merging the ones it touches. */\n");
  w_s(&mut out, "static uint64_t bst_run_put(uint64_t *lo, uint64_t *hi, uint64_t n, uint64_t a, uint64_t b) {\n");
  w_s(&mut out, "    uint64_t m = 0;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        if (hi[k] < a || b < lo[k]) { lo[m] = lo[k]; hi[m] = hi[k]; m++; }\n");
  w_s(&mut out, "        else { if (lo[k] < a) a = lo[k]; if (hi[k] > b) b = hi[k]; }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (m == BST_RUNS) return m;\n");
  w_s(&mut out, "    uint64_t k = m;\n");
  w_s(&mut out, "    while (k > 0 && lo[k - 1] > a) { lo[k] = lo[k - 1]; hi[k] = hi[k - 1]; k--; }\n");
  w_s(&mut out, "    lo[k] = a; hi[k] = b;\n");
  w_s(&mut out, "    return m + 1;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_pool bst_pool_init(uint64_t mbi) {\n");
  w_s(&mut out, "    uint64_t *info = (uint64_t *)mbi;\n");
  w_s(&mut out, "    uint64_t base = ((uint64_t)_end + 4095) & ~4095ull;\n");
  w_s(&mut out, "    uint64_t limit = &bst_ram_limit ? bst_ram_limit : (1ull << 39);\n");
  w_s(&mut out, "    if (limit > (1ull << 39)) limit = 1ull << 39;\n");
  w_s(&mut out, "    uint64_t lo[BST_RUNS], hi[BST_RUNS], n = 0;\n");
  w_s(&mut out, "    for (uint64_t k = 0; info && k < info[0] && k < 64; k++) {\n");
  w_s(&mut out, "        uint64_t a = info[1 + 2 * k], b = a + info[2 + 2 * k];\n");
  w_s(&mut out, "        if (b < a) b = ~0ull;\n");
  w_s(&mut out, "        if (a < base) a = base;\n");
  w_s(&mut out, "        if (b > limit) b = limit;\n");
  w_s(&mut out, "        a = (a + 4095) & ~4095ull;\n");
  w_s(&mut out, "        b &= ~4095ull;\n");
  w_s(&mut out, "        if (a < b) n = bst_run_put(lo, hi, n, a, b);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    /* At most 2^27 pages: the top runs go first. */\n");
  w_s(&mut out, "    uint64_t pages = 0;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        if (pages + (hi[k] - lo[k]) / 4096 > BST_FRAME_LIMIT) hi[k] = lo[k] + (BST_FRAME_LIMIT - pages) * 4096;\n");
  w_s(&mut out, "        pages += (hi[k] - lo[k]) / 4096;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    /* The bookkeeping, from the first run with room (the arena extension\n");
  w_s(&mut out, "     * only if there is room for it too). */\n");
  w_s(&mut out, "    uint64_t counters = (pages * 8 + 4095) / 4096, ext = pages / 8, r = n;\n");
  w_s(&mut out, "    if (pages >= 8192 && ext < 1536) ext = 1536;   /* from 32 MiB of pages: at least 6 MiB */\n");
  w_s(&mut out, "    for (int tries = 0; tries < 2 && r == n; tries++) {\n");
  w_s(&mut out, "        if (tries) ext = 0;\n");
  w_s(&mut out, "        for (r = 0; r < n && (hi[r] - lo[r]) / 4096 <= counters + ext; r++) {}\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_pool p;\n");
  w_s(&mut out, "    p.base = base;\n");
  w_s(&mut out, "    p.size = 0;\n");
  w_s(&mut out, "    if (r == n) return p;          /* no room even for the counters: no pages */\n");
  w_s(&mut out, "    uint64_t *w = (uint64_t *)lo[r];\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < counters * 512; k++) w[k] = 0;\n");
  w_s(&mut out, "    bst_pt_leases = (uint32_t *)lo[r];\n");
  w_s(&mut out, "    bst_shared_refs = (uint32_t *)lo[r] + pages;\n");
  w_s(&mut out, "    bst_arena2 = (uint64_t *)(lo[r] + counters * 4096);\n");
  w_s(&mut out, "    bst_arena2_words = ext * 512;\n");
  w_s(&mut out, "    bst_carved_lo = lo[r];\n");
  w_s(&mut out, "    bst_carved_hi = lo[r] + (counters + ext) * 4096;\n");
  w_s(&mut out, "    lo[r] = bst_carved_hi;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        bst_run_at[k] = lo[k];\n");
  w_s(&mut out, "        bst_run_id[k + 1] = bst_run_id[k] + (hi[k] - lo[k]) / 4096;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_runs = n;\n");
  w_s(&mut out, "    p.base = lo[0];\n");
  w_s(&mut out, "    p.size = bst_run_id[n];\n");
  w_s(&mut out, "    return p;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Claiming RAM as registers would alias pages the proofs hand out, or the\n");
  w_s(&mut out, " * kernel itself, so such a claim stops the machine. On AArch64 the device\n");
  w_s(&mut out, " * window starts at 0, so every run of RAM the platform listed is refused,\n");
  w_s(&mut out, " * the kernel image's included, besides the pool's. */\n");
  w_s(&mut out, "static void bst_mmio_check(uint64_t b, uint64_t l) {\n");
  w_s(&mut out, "    int bad = l && b < bst_carved_hi && bst_carved_lo < b + l;\n");
  w_s(&mut out, "    uint64_t *info = (uint64_t *)bst_mbi;\n");
  w_s(&mut out, "    for (uint64_t k = 0; info && k < info[0] && k < 64; k++) {\n");
  w_s(&mut out, "        uint64_t lo = info[1 + 2 * k], hi = lo + info[2 + 2 * k];\n");
  w_s(&mut out, "        if (hi < lo) hi = ~0ull;\n");
  w_s(&mut out, "        if (l && b < hi && lo < b + l) bad = 1;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < bst_runs; k++) {\n");
  w_s(&mut out, "        uint64_t lo = bst_run_at[k], hi = lo + (bst_run_id[k + 1] - bst_run_id[k]) * 4096;\n");
  w_s(&mut out, "        if (l && b < hi && lo < b + l) bad = 1;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (bad) { bst_puts(\"bastio: mmio_claim of RAM at \"); bst_puthex(b); bst_puts(\"\\n\"); bst_halt(); }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define BST_MMIO_CHECK(b, l) bst_mmio_check(b, l)\n");
  w_s(&mut out, "/* A platform that gives user code a table of its own, with none of the\n");
  w_s(&mut out, " * kernel's memory in it (BastiOS: boot/aarch64/boot.S loads it into TTBR0 in\n");
  w_s(&mut out, " * bst_cpu_enter, from a trampoline the kernel keeps in TTBR1, and leaves it at\n");
  w_s(&mut out, " * the next exception), defines this symbol and keeps a fourth word of\n");
  w_s(&mut out, " * bst_platform_mmu_state for the table. The kernel's tables then stay in\n");
  w_s(&mut out, " * TTBR0 whenever Bastio code runs. */\n");
  w_s(&mut out, "extern const char bst_platform_deferred_ttbr0 __attribute__((weak));\n");
  w_s(&mut out, "#define BST_DEFERRED (&bst_platform_deferred_ttbr0 != 0)\n");
  w_s(&mut out, "/* Otherwise every top-level table maps the kernel as the platform's does:\n");
  w_s(&mut out, " * its first slot points to the same table (EL1 only, set in the entries\n");
  w_s(&mut out, " * below it). */\n");
  w_s(&mut out, "#define BST_PT_NEW_HOOK if (level == 4 && !BST_DEFERRED) e[0] = ((uint64_t)bst_kernel_root[0] & BST_PTE_ADDR) | BST_PTE_TABLE;\n");
}

/// The prelude part for AArch64 page tables (VMSAv8-64, 4 KiB granule).
fn cg_prelude_pages_a64(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "/* VMSAv8-64 descriptors, 4 KiB granule. A table entry is valid and of\n");
  w_s(&mut out, " * type table (bits 0-1); a last-level entry is valid and of type page, with\n");
  w_s(&mut out, " * the access flag set (so the CPU never faults to set it), inner shareable,\n");
  w_s(&mut out, " * normal memory (MAIR index 0, set by the platform), not global (it belongs\n");
  w_s(&mut out, " * to one address space), reachable from EL0 (AP[1]) and read-only unless\n");
  w_s(&mut out, " * writable (AP[2]), and never executable at EL1 (PXN). */\n");
  w_s(&mut out, "#define BST_PTE_P 1ull\n");
  w_s(&mut out, "#define BST_PTE_TABLE 3ull\n");
  w_s(&mut out, "#define BST_PTE_PAGE (3ull | (1ull << 10) | (3ull << 8) | (1ull << 11) | (1ull << 6) | (1ull << 53))\n");
  w_s(&mut out, "#define BST_PTE_RO (1ull << 7)\n");
  w_s(&mut out, "/* A page the program may write is never one it may run (W^X): the entry has\n");
  w_s(&mut out, " * UXN (bit 54) when it is made writable, and has not when made read-only,\n");
  w_s(&mut out, " * so a page is executable if it was mapped read-only (program text) or if\n");
  w_s(&mut out, " * the kernel made it so by mapping it again read-only. pt_set_access\n");
  w_s(&mut out, " * leaves the bit alone. */\n");
  w_s(&mut out, "#define BST_PTE_UXN (1ull << 54)\n");
  w_s(&mut out, "#define BST_PTE_ADDR 0x0000FFFFFFFFF000ull\n");
  w_s(&mut out, "static inline void bst_zero_page(uint64_t a) {\n");
  w_s(&mut out, "#if defined(__x86_64__)\n");
  w_s(&mut out, "    void *p = (void *)a;\n");
  w_s(&mut out, "    uint64_t n = 512;\n");
  w_s(&mut out, "    __asm__ volatile (\"rep stosq\" : \"+D\"(p), \"+c\"(n) : \"a\"(0ull) : \"memory\");\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    uint64_t *w = (uint64_t *)a;\n");
  w_s(&mut out, "    for (int k = 0; k < 512; k++) w[k] = 0;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_pool_size(bst_pool p) { return p.size; }\n");
  w_s(&mut out, "/* Page ids are dense over the runs of RAM: run r holds ids bst_run_id[r] up\n");
  w_s(&mut out, " * to bst_run_id[r + 1], from address bst_run_at[r]. Most machines have one\n");
  w_s(&mut out, " * or two runs, so the loops stop at once. */\n");
  w_s(&mut out, "static inline uint64_t bst_page_at(uint64_t i) {\n");
  w_s(&mut out, "    uint64_t r = 0;\n");
  w_s(&mut out, "    while (r + 1 < bst_runs && i >= bst_run_id[r + 1]) r++;\n");
  w_s(&mut out, "    return bst_run_at[r] + (i - bst_run_id[r]) * 4096;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_frame_id(bst_frame f) {\n");
  w_s(&mut out, "    uint64_t r = 0;\n");
  w_s(&mut out, "    while (r + 1 < bst_runs && f - bst_run_at[r] >= (bst_run_id[r + 1] - bst_run_id[r]) * 4096) r++;\n");
  w_s(&mut out, "    return bst_run_id[r] + (f - bst_run_at[r]) / 4096;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_frame bst_pool_take(bst_pool *p, uint64_t i) {\n");
  w_s(&mut out, "    uint64_t a = bst_page_at(i);\n");
  w_s(&mut out, "    (void)p;\n");
  w_s(&mut out, "    bst_zero_page(a);      /* never leak a page's old contents */\n");
  w_s(&mut out, "    return a;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_pool_give(bst_pool *p, bst_frame f) { (void)p; (void)f; }\n");
  w_s(&mut out, "static inline uint64_t bst_frame_read(bst_frame f, uint64_t w) { return ((uint64_t *)f)[w]; }\n");
  w_s(&mut out, "static inline void bst_frame_write(bst_frame *f, uint64_t w, uint64_t v) { ((uint64_t *)*f)[w] = v; }\n");
  w_s(&mut out, "static inline uint64_t bst_frame_read8(bst_frame f, uint64_t o) { return ((unsigned char *)f)[o]; }\n");
  w_s(&mut out, "static inline void bst_frame_write8(bst_frame *f, uint64_t o, uint64_t v) { ((unsigned char *)*f)[o] = (unsigned char)v; }\n");
  w_s(&mut out, "static inline void bst_frame_to_bytes(bst_bytes *dst, uint64_t d, bst_frame f, uint64_t o, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd(dst->data + d, (const unsigned char *)f + o, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bytes_to_frame(bst_frame *f, uint64_t o, bst_bytes src, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd((unsigned char *)*f + o, src.data + s, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_frame_to_frame(bst_frame *d, uint64_t o, bst_frame f, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd((unsigned char *)*d + o, (const unsigned char *)f + s, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_pt bst_pt_new(bst_frame f, uint64_t level) {\n");
  w_s(&mut out, "    uint64_t *e = (uint64_t *)f;\n");
  w_s(&mut out, "    bst_zero_page(f);      /* f may be a page that held data, not a fresh one */\n");
  w_s(&mut out, "    BST_PT_NEW_HOOK\n");
  w_s(&mut out, "    return f;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_frame bst_pt_free(bst_pt t) { return t; }\n");
  w_s(&mut out, "/* A last-level slot the program may not touch (pt_set_access 0) keeps its\n");
  w_s(&mut out, " * page with the valid bit clear, marked by a bit the CPU ignores in an\n");
  w_s(&mut out, " * invalid entry (one of those reserved for software), so the table still\n");
  w_s(&mut out, " * owns it. */\n");
  w_s(&mut out, "#define BST_PTE_HIDDEN (1ull << 55)\n");
  w_s(&mut out, "static inline bool bst_pt_has(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & (BST_PTE_P | BST_PTE_HIDDEN)) != 0; }\n");
  w_s(&mut out, "static inline bool bst_pt_writable(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_RO) == 0; }\n");
  w_s(&mut out, "static inline bool bst_pt_accessible(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_P) != 0; }\n");
  w_s(&mut out, "static inline void bst_pt_set_access(bst_pt *t, uint64_t i, uint64_t a) {\n");
  w_s(&mut out, "    uint64_t e = ((uint64_t *)*t)[i] & ~(BST_PTE_P | BST_PTE_RO | BST_PTE_HIDDEN);\n");
  w_s(&mut out, "    e |= a == 0 ? BST_PTE_HIDDEN | BST_PTE_RO : (BST_PTE_P | (a == 2 ? 0 : BST_PTE_RO));\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], e, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Another processor may be walking the table (it holds a lease on the\n");
  w_s(&mut out, " * tree), so an entry is written with one 64-bit store, valid bit\n");
  w_s(&mut out, " * included, after everything it points to (release order). The walker\n");
  w_s(&mut out, " * sees it after the next DSB, which every entry to user mode has\n");
  w_s(&mut out, " * (bst_cpu_run). */\n");
  w_s(&mut out, "static inline void bst_pt_put(bst_pt *t, uint64_t i, bst_pt c) {\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], c | BST_PTE_TABLE, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* A page mapped for user mode may hold code the kernel wrote through the\n");
  w_s(&mut out, " * data cache, and AArch64's instruction cache does not snoop it: the page\n");
  w_s(&mut out, " * is cleaned to the point of unification and the instruction cache\n");
  w_s(&mut out, " * invalidated before the entry is written (Arm ARM, \"Instruction cache\n");
  w_s(&mut out, " * maintenance\"). */\n");
  w_s(&mut out, "static inline void bst_sync_icache(uint64_t a) {\n");
  w_s(&mut out, "    uint64_t ctr;\n");
  w_s(&mut out, "    __asm__ volatile (\"mrs %0, ctr_el0\" : \"=r\"(ctr));\n");
  w_s(&mut out, "    uint64_t dl = 4ull << ((ctr >> 16) & 15), il = 4ull << (ctr & 15);\n");
  w_s(&mut out, "    for (uint64_t p = a; p < a + 4096; p += dl) __asm__ volatile (\"dc cvau, %0\" : : \"r\"(p) : \"memory\");\n");
  w_s(&mut out, "    __asm__ volatile (\"dsb ish\" : : : \"memory\");\n");
  w_s(&mut out, "    for (uint64_t p = a; p < a + 4096; p += il) __asm__ volatile (\"ic ivau, %0\" : : \"r\"(p) : \"memory\");\n");
  w_s(&mut out, "    __asm__ volatile (\"dsb ish; isb\" : : : \"memory\");\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_pt_put_frame(bst_pt *t, uint64_t i, bst_frame f, bool w) {\n");
  w_s(&mut out, "    bst_sync_icache(f);\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], f | BST_PTE_PAGE | (w ? BST_PTE_UXN : BST_PTE_RO), __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* What slot i points to, left in place (pt_borrow). */\n");
  w_s(&mut out, "static inline uint64_t bst_pt_child(bst_pt t, uint64_t i) { return ((uint64_t *)t)[i] & BST_PTE_ADDR; }\n");
  w_s(&mut out, "/* Leases outstanding on each top-level table (mmu_enter, mmu_exit), by page\n");
  w_s(&mut out, " * number (bst_pt_leases, one per pool page, comes with the pool). A lease this processor parked\n");
  w_s(&mut out, " * (bst_mmu_exit) is given back first, so the count is what it would be had\n");
  w_s(&mut out, " * the table been left at once. */\n");
  w_s(&mut out, "static inline void bst_mmu_settle_on(uint64_t t);   /* defined per target */\n");
  w_s(&mut out, "static inline uint64_t bst_pt_lease_count(bst_pt *t) {\n");
  w_s(&mut out, "    bst_mmu_settle_on(*t);\n");
  w_s(&mut out, "    return __atomic_load_n(&bst_pt_leases[bst_frame_id(*t)], __ATOMIC_ACQUIRE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Counts every entry taken out of any table, and every protection change: a processor whose TLB may\n");
  w_s(&mut out, " * still hold the entry flushes it before it runs user code again if the\n");
  w_s(&mut out, " * count moved since its last flush (bst_cpu_run, bst_mmu_enter). Putting an\n");
  w_s(&mut out, " * entry into an empty slot needs no flush: no translation is cached for an\n");
  w_s(&mut out, " * invalid entry. */\n");
  w_s(&mut out, "static uint64_t bst_pt_gen;\n");
  w_s(&mut out, "static inline uint64_t bst_pt_take(bst_pt *t, uint64_t i) {\n");
  w_s(&mut out, "    uint64_t *e = &((uint64_t *)*t)[i];\n");
  w_s(&mut out, "    uint64_t a = *e & BST_PTE_ADDR;\n");
  w_s(&mut out, "    *e = 0;\n");
  w_s(&mut out, "    __atomic_fetch_add(&bst_pt_gen, 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    return a;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define bst_pt_take_frame bst_pt_take\n");
  w_s(&mut out, "/* Shared pages: how many references (Shared values and pt_dup_shared's\n");
  w_s(&mut out, " * reads) each page has, by page number, and a PTE bit the CPU ignores that\n");
  w_s(&mut out, " * marks a slot mapping one. The last shared_drop gives the page back. */\n");
  w_s(&mut out, "#define BST_PTE_SHARED (1ull << 56)\n");
  w_s(&mut out, "static inline bst_frame bst_shared_new(bst_frame f) { __atomic_store_n(&bst_shared_refs[bst_frame_id(f)], 1, __ATOMIC_RELEASE); return f; }\n");
  w_s(&mut out, "static inline bst_frame bst_shared_dup(bst_frame s) { __atomic_fetch_add(&bst_shared_refs[bst_frame_id(s)], 1, __ATOMIC_RELAXED); return s; }\n");
  w_s(&mut out, "static inline uint64_t bst_shared_drop(bst_pool *p, bst_frame s) {\n");
  w_s(&mut out, "    uint64_t i = bst_frame_id(s);\n");
  w_s(&mut out, "    (void)p;\n");
  w_s(&mut out, "    return __atomic_sub_fetch(&bst_shared_refs[i], 1, __ATOMIC_ACQ_REL) == 0 ? i : ~0ull;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_shared_id(bst_frame s) { return bst_frame_id(s); }\n");
  w_s(&mut out, "static inline bool bst_pt_shared(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_SHARED) != 0; }\n");
  w_s(&mut out, "static inline void bst_pt_put_shared(bst_pt *t, uint64_t i, bst_frame s, bool w) {\n");
  w_s(&mut out, "    bst_sync_icache(s);\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], s | BST_PTE_PAGE | BST_PTE_SHARED | (w ? BST_PTE_UXN : BST_PTE_RO), __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define bst_pt_take_shared bst_pt_take\n");
  w_s(&mut out, "static inline bst_frame bst_pt_dup_shared(bst_pt t, uint64_t i) { return bst_shared_dup(((uint64_t *)t)[i] & BST_PTE_ADDR); }\n");
  w_s(&mut out, "/* Dirty pages: taken without zeroing, so whoever takes them (under a lock,\n");
  w_s(&mut out, " * say) does not pay for it; they become frames only by being overwritten\n");
  w_s(&mut out, " * whole, which can happen later and elsewhere. */\n");
  w_s(&mut out, "static inline bst_frame bst_pool_take_dirty(bst_pool *p, uint64_t i) { (void)p; return bst_page_at(i); }\n");
  w_s(&mut out, "static inline uint64_t bst_dirty_id(bst_frame d) { return bst_frame_id(d); }\n");
  w_s(&mut out, "static inline bst_frame bst_dirty_zero(bst_frame d) { bst_zero_page(d); return d; }\n");
  w_s(&mut out, "static inline bst_frame bst_frame_copy(bst_frame d, bst_frame src) { bst_copy_fwd((unsigned char *)d, (const unsigned char *)src, 4096); return d; }\n");
  w_s(&mut out, "#define bst_shared_copy bst_frame_copy\n");
  w_s(&mut out, "static inline bst_frame bst_dirty_fill(bst_frame d, bst_bytes src, uint64_t s) { bst_copy_fwd((unsigned char *)d, src.data + s, 4096); return d; }\n");
}

/// The prelude part for the AArch64 CPU: translation table loads, context switch state, the counter.
fn cg_prelude_kernel_cpu_a64(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "/* TTBR0_EL1 holds the top-level table (the kernel's is the platform's\n");
  w_s(&mut out, " * bst_kernel_root). Loading one also flushes this processor's TLB, as a\n");
  w_s(&mut out, " * CR3 load does on x86-64: the tables use no ASIDs, and the kernel's\n");
  w_s(&mut out, " * entries are cheap to walk again. The DSB before makes the table entries\n");
  w_s(&mut out, " * written so far visible to the walker. */\n");
  w_s(&mut out, "static inline void bst_load_root(uint64_t a) {\n");
  w_s(&mut out, "    __asm__ volatile (\"dsb ishst; msr ttbr0_el1, %0; isb; tlbi vmalle1; dsb nsh; isb\" : : \"r\"(a) : \"memory\");\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_read_root(void) { uint64_t a; __asm__ volatile (\"mrs %0, ttbr0_el1\" : \"=r\"(a)); return a; }\n");
  w_s(&mut out, "/* Three words per processor, zero at boot, if the platform keeps them: the\n");
  w_s(&mut out, " * table this processor parked (0: none), bst_pt_gen as of its last\n");
  w_s(&mut out, " * TTBR0 load, and how many locks it holds. Without them every switch\n");
  w_s(&mut out, " * loads TTBR0 at once. */\n");
  w_s(&mut out, "extern uint64_t *bst_platform_mmu_state(void) __attribute__((weak));\n");
  w_s(&mut out, "static inline uint64_t *bst_mmu_state(void) { return bst_platform_mmu_state ? bst_platform_mmu_state() : 0; }\n");
  w_s(&mut out, "static inline void bst_root_load(uint64_t *s, uint64_t a) {\n");
  w_s(&mut out, "    if (s) s[1] = __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    bst_load_root(a);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Gives a parked table back: the kernel's tables go into TTBR0 first, then\n");
  w_s(&mut out, " * the lease's count drops, as bst_mmu_exit does without parking. */\n");
  w_s(&mut out, "static inline void bst_mmu_settle(void) {\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (!s || !s[0]) return;\n");
  w_s(&mut out, "    uint64_t l = s[0];\n");
  w_s(&mut out, "    s[0] = 0;\n");
  w_s(&mut out, "    bst_root_load(s, (uint64_t)bst_kernel_root);\n");
  w_s(&mut out, "    __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_mmu_settle_on(uint64_t t) {\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (s && s[0] == t) bst_mmu_settle();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_lock_depth(int d) {\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (!s) return;\n");
  w_s(&mut out, "    s[2] += (uint64_t)(int64_t)d;\n");
  w_s(&mut out, "    if (s[2] == 0 && s[0]) bst_mmu_settle();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_mmu_kernel(bst_mmu *m) { (void)m; bst_mmu_settle(); if (!BST_DEFERRED) bst_load_root((uint64_t)bst_kernel_root); }\n");
  w_s(&mut out, "/* A table this processor parked becomes the new lease without a second\n");
  w_s(&mut out, " * count. TTBR0 is loaded only if it holds another table, or if an entry was\n");
  w_s(&mut out, " * taken out of some table since the last load (bst_pt_gen). */\n");
  w_s(&mut out, "static inline bst_lease bst_mmu_enter(bst_mmu *m, bst_pt *t) {\n");
  w_s(&mut out, "    (void)m;\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (BST_DEFERRED) {\n");
  w_s(&mut out, "        __atomic_fetch_add(&bst_pt_leases[bst_frame_id(*t)], 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "        s[3] = *t;\n");
  w_s(&mut out, "        return *t;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (s && s[0] == *t) s[0] = 0;\n");
  w_s(&mut out, "    else __atomic_fetch_add(&bst_pt_leases[bst_frame_id(*t)], 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    if (!s || bst_read_root() != *t || s[1] != __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST)) bst_root_load(s, *t);\n");
  w_s(&mut out, "    if (s && s[0]) {                    /* another table was parked, and TTBR0 has left it */\n");
  w_s(&mut out, "        uint64_t l = s[0];\n");
  w_s(&mut out, "        s[0] = 0;\n");
  w_s(&mut out, "        __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return *t;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The count drops only once this processor no longer uses the table. Where\n");
  w_s(&mut out, " * the platform keeps bst_mmu_state, the table is parked instead: it stays\n");
  w_s(&mut out, " * in TTBR0 with its lease counted, so a process that runs again next (after\n");
  w_s(&mut out, " * a system call, say) costs no TLB flush. Every table maps the kernel's\n");
  w_s(&mut out, " * memory the same way (top-level entry 0, BST_PT_NEW_HOOK), and nothing proved\n");
  w_s(&mut out, " * reaches the user window without a lease, so kernel code runs the same\n");
  w_s(&mut out, " * either way. The lease goes back (bst_mmu_settle) when the processor\n");
  w_s(&mut out, " * enters another table, waits for a lock or an interrupt, lets go of its\n");
  w_s(&mut out, " * last lock without entering the table again, touches MMIO above 512 GiB\n");
  w_s(&mut out, " * (mapped only in the kernel's tables), returns from its smp_run function,\n");
  w_s(&mut out, " * or asks for that table's lease count. So other processors see the lease\n");
  w_s(&mut out, " * held no longer than if the process had trapped a moment later. */\n");
  w_s(&mut out, "static inline void bst_mmu_exit(bst_mmu *m, bst_lease l) {\n");
  w_s(&mut out, "    (void)m;\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (BST_DEFERRED) {\n");
  w_s(&mut out, "        s[3] = 0;\n");
  w_s(&mut out, "        __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "        return;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (s) {\n");
  w_s(&mut out, "        s[0] = l;\n");
  w_s(&mut out, "        return;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_load_root((uint64_t)bst_kernel_root);\n");
  w_s(&mut out, "    __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* A platform that tags user translations with an address-space number\n");
  w_s(&mut out, " * (BastiOS: ASIDs) learns here that the table `t` is gone: its number must\n");
  w_s(&mut out, " * not be handed to whoever gets the same page next. */\n");
  w_s(&mut out, "extern void bst_platform_table_free(uint64_t t) __attribute__((weak));\n");
  w_s(&mut out, "static inline bst_frame bst_pt_free_root(bst_mmu m, bst_pt t) {\n");
  w_s(&mut out, "    (void)m;\n");
  w_s(&mut out, "    if (bst_platform_table_free) bst_platform_table_free((uint64_t)t);\n");
  w_s(&mut out, "    return t;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Saved user registers: x0-x30 (0-30), sp_el0 (31), the return address\n");
  w_s(&mut out, " * elr_el1 (32), spsr_el1 (33), the syndrome esr_el1 (34), the fault\n");
  w_s(&mut out, " * address far_el1 (35), tpidr_el0 (36). */\n");
  w_s(&mut out, "extern uint64_t *bst_platform_ctx(void); /* this processor's saved context, 37 words */\n");
  w_s(&mut out, "/* Enter EL0 with eret and return the exception that ended it, with the\n");
  w_s(&mut out, " * context saved back: 128 for an SVC from AArch64 state, 14 for an\n");
  w_s(&mut out, " * instruction or data abort (far is then the address), 32 + n for interrupt\n");
  w_s(&mut out, " * n, and 6 for anything else (esr says what), as the x86-64 vectors the\n");
  w_s(&mut out, " * kernel already knows. Whatever the context holds, the platform enters EL0t\n");
  w_s(&mut out, " * with interrupts unmasked: of spsr it keeps only the condition flags. */\n");
  w_s(&mut out, "extern uint64_t bst_cpu_enter(void);\n");
  w_s(&mut out, "extern uint64_t bst_cpu_wait(void);    /* unmask interrupts, wfi, mask them; returns the interrupt */\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_get(bst_cpu c, uint64_t r) { (void)c; return bst_platform_ctx()[r]; }\n");
  w_s(&mut out, "static inline void bst_cpu_set(bst_cpu *c, uint64_t r, uint64_t v) { (void)c; bst_platform_ctx()[r] = v; }\n");
  w_s(&mut out, "/* The user's FP/SIMD state, in a page the kernel owns: q0-q31 (bytes\n");
  w_s(&mut out, " * 0-511), then FPSR and FPCR (512, 520). The kernel itself is built\n");
  w_s(&mut out, " * without FP/SIMD (-mgeneral-regs-only), so these registers hold the\n");
  w_s(&mut out, " * user's values. */\n");
  w_s(&mut out, "#define BST_FP_PAIRS(op) \\\n");
  w_s(&mut out, "    op \" q0, q1, [%0, #0]\\n\" op \" q2, q3, [%0, #32]\\n\" op \" q4, q5, [%0, #64]\\n\" op \" q6, q7, [%0, #96]\\n\" \\\n");
  w_s(&mut out, "    op \" q8, q9, [%0, #128]\\n\" op \" q10, q11, [%0, #160]\\n\" op \" q12, q13, [%0, #192]\\n\" op \" q14, q15, [%0, #224]\\n\" \\\n");
  w_s(&mut out, "    op \" q16, q17, [%0, #256]\\n\" op \" q18, q19, [%0, #288]\\n\" op \" q20, q21, [%0, #320]\\n\" op \" q22, q23, [%0, #352]\\n\" \\\n");
  w_s(&mut out, "    op \" q24, q25, [%0, #384]\\n\" op \" q26, q27, [%0, #416]\\n\" op \" q28, q29, [%0, #448]\\n\" op \" q30, q31, [%0, #480]\\n\"\n");
  w_s(&mut out, "static inline void bst_cpu_fpu_save(bst_cpu *c, bst_frame *f) {\n");
  w_s(&mut out, "    (void)c;\n");
  w_s(&mut out, "    uint64_t sr, cr;\n");
  w_s(&mut out, "    __asm__ volatile (BST_FP_PAIRS(\"stp\") : : \"r\"(*f) : \"memory\");\n");
  w_s(&mut out, "    __asm__ volatile (\"mrs %0, fpsr\\nmrs %1, fpcr\" : \"=r\"(sr), \"=r\"(cr));\n");
  w_s(&mut out, "    ((uint64_t *)*f)[64] = sr;\n");
  w_s(&mut out, "    ((uint64_t *)*f)[65] = cr;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_cpu_fpu_load(bst_cpu *c, bst_frame f) {\n");
  w_s(&mut out, "    (void)c;\n");
  w_s(&mut out, "    __asm__ volatile (BST_FP_PAIRS(\"ldp\") : : \"r\"(f) : \"memory\");\n");
  w_s(&mut out, "    __asm__ volatile (\"msr fpsr, %0\\nmsr fpcr, %1\" : : \"r\"(((uint64_t *)f)[64]), \"r\"(((uint64_t *)f)[65]) : \"memory\");\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_run(bst_cpu *c, bst_mmu m) {\n");
  w_s(&mut out, "    (void)c; (void)m;\n");
  w_s(&mut out, "    if (BST_DEFERRED) {\n");
  w_s(&mut out, "        /* bst_cpu_enter loads the table; word 1 tells it how many entries have\n");
  w_s(&mut out, "         * been taken out of any table so far, so it can flush this processor's\n");
  w_s(&mut out, "         * TLB if that moved since its last flush (translations are tagged with\n");
  w_s(&mut out, "         * the table's address-space number, so switching tables flushes nothing). */\n");
  w_s(&mut out, "        uint64_t *g = bst_mmu_state();\n");
  w_s(&mut out, "        g[1] = __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "        return bst_cpu_enter();\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    /* flush the TLB if pages may have moved since the last load; at least\n");
  w_s(&mut out, "     * make the entries written so far visible to the walker */\n");
  w_s(&mut out, "    if (!s || s[1] != __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST)) bst_root_load(s, bst_read_root());\n");
  w_s(&mut out, "    else __asm__ volatile (\"dsb ishst; isb\" : : : \"memory\");\n");
  w_s(&mut out, "    return bst_cpu_enter();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_idle(bst_cpu *c) { (void)c; bst_mmu_settle(); return bst_cpu_wait(); }\n");
  w_s(&mut out, "extern void bst_platform_smp_start(void (*fn)(void *), void *arg); /* run fn(arg) on every other processor */\n");
  w_s(&mut out, "extern void bst_platform_smp_join(void);                           /* wait until all of them have returned */\n");
  w_s(&mut out, "extern uint64_t bst_platform_cpus(void); /* processors running, this one included; 1 to 4096 */\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_count(bst_cpu c) { (void)c; return bst_platform_cpus(); }\n");
  w_s(&mut out, "/* The generic timer's virtual count, which ticks at a fixed rate (CNTFRQ_EL0). */\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_tsc(bst_cpu c) { (void)c; uint64_t v; __asm__ volatile(\"isb; mrs %0, cntvct_el0\" : \"=r\"(v)); return v; }\n");
  w_s(&mut out, "/* A linear framebuffer the boot code set up: none yet on AArch64, so every\n");
  w_s(&mut out, " * field is 0, as on a PC without one. */\n");
  w_s(&mut out, "static uint64_t bst_boot_fb(bst_cpu c, uint64_t f) { (void)c; (void)f; return 0; }\n");
  w_s(&mut out, "/* Byte `off` of the ACPI table whose signature is `sig` (its four letters\n");
  w_s(&mut out, " * as a little-endian number; \"DSDT\" is the one the FADT points at), or 256\n");
  w_s(&mut out, " * past its end or without one. The platform finds the tables. */\n");
  w_s(&mut out, "extern uint64_t bst_platform_acpi(uint64_t sig, uint64_t off);\n");
  w_s(&mut out, "static inline uint64_t bst_boot_acpi(bst_cpu c, uint64_t sig, uint64_t off) { (void)c; return bst_platform_acpi(sig, off); }\n");
  w_s(&mut out, "/* Answer `i` to the platform's query `what` about the machine (its boot\n");
  w_s(&mut out, " * command line, memory map, processor, ...: the platform defines them), or\n");
  w_s(&mut out, " * 0. Read-only; nothing is promised about the number. */\n");
  w_s(&mut out, "extern uint64_t bst_platform_info(uint64_t what, uint64_t i);\n");
  w_s(&mut out, "static inline uint64_t bst_boot_info(bst_cpu c, uint64_t what, uint64_t i) { (void)c; return bst_platform_info(what, i); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Called by the platform on a fault in kernel mode: that is a bug in the\n");
  w_s(&mut out, " * trusted base or the compiler, never in verified code. */\n");
  w_s(&mut out, "void bst_kernel_fault(uint64_t vec, uint64_t pc, uint64_t far, uint64_t esr) {\n");
  w_s(&mut out, "    bst_puts(\"\\nbastio: kernel fault, vector \"); bst_puthex(vec);\n");
  w_s(&mut out, "    bst_puts(\" pc \"); bst_puthex(pc); bst_puts(\" far \"); bst_puthex(far); bst_puts(\" esr \"); bst_puthex(esr);\n");
  w_s(&mut out, "    bst_puts(\"\\n\");\n");
  w_s(&mut out, "    bst_halt();\n");
  w_s(&mut out, "}\n");
}

/// The prelude part for AArch64 MMIO barriers.
fn cg_prelude_mmio_kernel_a64(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Device memory above 512 GiB is mapped only in the kernel's tables, so a\n");
  w_s(&mut out, " * parked user table (bst_mmu_exit) goes back before it is touched. Unlike\n");
  w_s(&mut out, " * x86-64, AArch64 lets normal memory accesses pass device ones, so as\n");
  w_s(&mut out, " * Linux's writel and readl do, a write waits for earlier writes (a device\n");
  w_s(&mut out, " * told to read a lent page sees what was put there) and later reads wait\n");
  w_s(&mut out, " * for a read (what a device wrote before it said so is seen). */\n");
  w_s(&mut out, "#define BST_MMIO_HIGH(a) do { if ((a) >= (1ull << 39)) bst_mmu_settle(); } while (0)\n");
  w_s(&mut out, "#define BST_MMIO_RW(w, t) \\\n");
  w_s(&mut out, "    static inline uint64_t bst_mmio_read##w(bst_mmio *m, uint64_t o) { BST_MMIO_HIGH(m->base + o); uint64_t v = *(volatile t *)(uintptr_t)(m->base + o); __asm__ volatile (\"dmb oshld\" : : : \"memory\"); return v; } \\\n");
  w_s(&mut out, "    static inline void bst_mmio_write##w(bst_mmio *m, uint64_t o, uint64_t v) { BST_MMIO_HIGH(m->base + o); __asm__ volatile (\"dmb oshst\" : : : \"memory\"); *(volatile t *)(uintptr_t)(m->base + o) = (t)v; }\n");
  w_s(&mut out, "BST_MMIO_RW(8, uint8_t) BST_MMIO_RW(16, uint16_t) BST_MMIO_RW(32, uint32_t) BST_MMIO_RW(64, uint64_t)\n");
}

/// The prelude part for an AArch64 user program: `svc` system calls.
fn cg_prelude_user_a64(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline void bst_mmu_settle(void) { }\n");
  w_s(&mut out, "static inline void bst_lock_depth(int d) { (void)d; }\n");
  w_s(&mut out, "enum { BST_SYS_EXIT, BST_SYS_WRITE, BST_SYS_READ, BST_SYS_SPAWN, BST_SYS_WAIT, BST_SYS_YIELD,\n");
  w_s(&mut out, "       BST_SYS_GETPID, BST_SYS_INFO, BST_SYS_PS, BST_SYS_KILL, BST_SYS_POWEROFF };\n");
  w_s(&mut out, "/* A system call: `svc #0`, number in x8, arguments in x0-x2, result in x0. */\n");
  w_s(&mut out, "static inline uint64_t bst_sys(uint64_t n, uint64_t a, uint64_t b, uint64_t c) {\n");
  w_s(&mut out, "    register uint64_t x8 __asm__(\"x8\") = n;\n");
  w_s(&mut out, "    register uint64_t x0 __asm__(\"x0\") = a;\n");
  w_s(&mut out, "    register uint64_t x1 __asm__(\"x1\") = b;\n");
  w_s(&mut out, "    register uint64_t x2 __asm__(\"x2\") = c;\n");
  w_s(&mut out, "    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8), \"r\"(x1), \"r\"(x2) : \"memory\");\n");
  w_s(&mut out, "    return x0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static unsigned char bst_out[256];\n");
  w_s(&mut out, "static uint64_t bst_out_n;\n");
  w_s(&mut out, "static void bst_flush(void) {\n");
  w_s(&mut out, "    if (bst_out_n) bst_sys(BST_SYS_WRITE, (uint64_t)bst_out, bst_out_n, 0);\n");
  w_s(&mut out, "    bst_out_n = 0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    bst_out[bst_out_n++] = (unsigned char)b;\n");
  w_s(&mut out, "    if (b == '\\n' || bst_out_n == sizeof bst_out) bst_flush();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) { (void)s; bst_flush(); return bst_sys(BST_SYS_READ, 0, 0, 0); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "#define BST_ARENA_WORDS (1u << 13)   /* 64 KiB */\n");
  w_s(&mut out, "static uint64_t bst_arena[BST_ARENA_WORDS];\n");
  w_s(&mut out, "static uint64_t bst_arena_top = 0;\n");
  w_s(&mut out, "typedef struct bst_free { uint64_t words; struct bst_free *next; } bst_free_t;\n");
  w_s(&mut out, "static bst_free_t *bst_free_list = 0;\n");
  w_s(&mut out, "/* An empty buffer with no memory when the arena is full. */\n");
  w_s(&mut out, "static bst_buf bst_try_alloc(uint64_t n) {\n");
  w_s(&mut out, "    uint64_t words = (n ? n : 1) + 1;\n");
  w_s(&mut out, "    if (words < 2) words = 2;\n");
  w_s(&mut out, "    bst_free_t **pp = &bst_free_list;\n");
  w_s(&mut out, "    for (bst_free_t *f = bst_free_list; f; pp = &f->next, f = f->next) {\n");
  w_s(&mut out, "        if (f->words == words) {\n");
  w_s(&mut out, "            *pp = f->next;\n");
  w_s(&mut out, "            uint64_t *blk = (uint64_t *)f;\n");
  w_s(&mut out, "            for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  w_s(&mut out, "            bst_buf b = { n, blk + 1 };\n");
  w_s(&mut out, "            return b;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (bst_arena_top + words > BST_ARENA_WORDS) {\n");
  w_s(&mut out, "        bst_buf none = { 0, 0 };\n");
  w_s(&mut out, "        return none;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    uint64_t *blk = &bst_arena[bst_arena_top];\n");
  w_s(&mut out, "    bst_arena_top += words;\n");
  w_s(&mut out, "    blk[0] = words;\n");
  w_s(&mut out, "    for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  w_s(&mut out, "    bst_buf b = { n, blk + 1 };\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf b = bst_try_alloc(n);\n");
  w_s(&mut out, "    if (!b.data) {\n");
  w_s(&mut out, "        static const char m[] = \"bastio: out of memory\\n\";\n");
  w_s(&mut out, "        bst_flush();\n");
  w_s(&mut out, "        bst_sys(BST_SYS_WRITE, (uint64_t)m, sizeof m - 1, 0);\n");
  w_s(&mut out, "        bst_sys(BST_SYS_EXIT, 255, 0, 0);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_free(bst_buf b) {\n");
  w_s(&mut out, "    if (!b.data) return;\n");
  w_s(&mut out, "    uint64_t *blk = b.data - 1;\n");
  w_s(&mut out, "    bst_free_t *f = (bst_free_t *)blk;\n");
  w_s(&mut out, "    f->words = blk[0];\n");
  w_s(&mut out, "    f->next = bst_free_list;\n");
  w_s(&mut out, "    bst_free_list = f;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_print(uint64_t v) {\n");
  w_s(&mut out, "    char d[20]; int n = 0;\n");
  w_s(&mut out, "    do { d[n++] = (char)('0' + v % 10); v /= 10; } while (v);\n");
  w_s(&mut out, "    while (n) bst_serial_write(0, (unsigned char)d[--n]);\n");
  w_s(&mut out, "    bst_serial_write(0, '\\n');\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_sys_spawn(bst_buf b, uint64_t from, uint64_t to) {\n");
  w_s(&mut out, "    unsigned char name[64];\n");
  w_s(&mut out, "    uint64_t n = 0;\n");
  w_s(&mut out, "    for (uint64_t i = from; i < to && n < sizeof name; i++) name[n++] = (unsigned char)b.data[i];\n");
  w_s(&mut out, "    return bst_sys(BST_SYS_SPAWN, (uint64_t)name, n, 0);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_sys_wait(uint64_t pid) { return bst_sys(BST_SYS_WAIT, pid, 0, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_kill(uint64_t pid) { return bst_sys(BST_SYS_KILL, pid, 0, 0); }\n");
  w_s(&mut out, "static inline void bst_sys_yield(void) { bst_sys(BST_SYS_YIELD, 0, 0, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_getpid(void) { return bst_sys(BST_SYS_GETPID, 0, 0, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_info(uint64_t k) { return bst_sys(BST_SYS_INFO, k, 0, 0); }\n");
  w_s(&mut out, "static inline void bst_sys_ps(void) { bst_flush(); bst_sys(BST_SYS_PS, 0, 0, 0); }\n");
  w_s(&mut out, "static inline void bst_sys_poweroff(void) { bst_flush(); bst_sys(BST_SYS_POWEROFF, 0, 0, 0); }\n");
  w_s(&mut out, "/* Calls with numbers the language does not know: the kernel defines them.\n");
  w_s(&mut out, " * sys_send lends the kernel bytes 0..n of b to read; sys_recv lends all of b\n");
  w_s(&mut out, " * to overwrite. Console output is flushed first so it stays in order. */\n");
  w_s(&mut out, "static inline uint64_t bst_sys_call(uint64_t n, uint64_t a, uint64_t b) { bst_flush(); return bst_sys(n, a, b, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_send(uint64_t n, uint64_t a, bst_bytes b, uint64_t len) { bst_flush(); return bst_sys(n, a, (uint64_t)b.data, len); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_recv(uint64_t n, uint64_t a, bst_bytes *b) { bst_flush(); return bst_sys(n, a, (uint64_t)b->data, b->len); }\n");
}

/// The prelude part for AArch64 DMA pages, with the barriers a weakly ordered processor needs.
fn cg_prelude_dma_a64(out: &mut Vec[u64]) {
  w_s(&mut out, "static inline bst_dma bst_dma_lend(bst_frame f) { __atomic_thread_fence(__ATOMIC_SEQ_CST); return f; }\n");
  w_s(&mut out, "static inline bst_frame bst_dma_take(bst_dma d) { __atomic_thread_fence(__ATOMIC_SEQ_CST); return d; }\n");
  w_s(&mut out, "static inline uint64_t bst_dma_id(bst_dma d) { return bst_frame_id(d); }\n");
  w_s(&mut out, "static inline uint64_t bst_dma_addr(bst_dma d) { return d; }\n");
  w_s(&mut out, "/* A device writes a lent page in its own order and the processor may reorder\n");
  w_s(&mut out, " * its own loads and stores, so as Linux's dma_rmb and dma_wmb do, a read\n");
  w_s(&mut out, " * keeps later reads after it (what the device wrote before a flag it set is\n");
  w_s(&mut out, " * seen once the flag is) and a write waits for earlier writes (a device that\n");
  w_s(&mut out, " * sees it sees what came before). */\n");
  w_s(&mut out, "#define BST_DMA_RW(w, t) \\\n");
  w_s(&mut out, "    static inline uint64_t bst_dma_read##w(bst_dma *d, uint64_t o) { uint64_t v = *(volatile t *)(uintptr_t)(*d + o); __asm__ volatile (\"dmb oshld\" : : : \"memory\"); return v; } \\\n");
  w_s(&mut out, "    static inline void bst_dma_write##w(bst_dma *d, uint64_t o, uint64_t v) { __asm__ volatile (\"dmb oshst\" : : : \"memory\"); *(volatile t *)(uintptr_t)(*d + o) = (t)v; }\n");
  w_s(&mut out, "BST_DMA_RW(8, uint8_t) BST_DMA_RW(16, uint16_t) BST_DMA_RW(32, uint32_t) BST_DMA_RW(64, uint64_t)\n");
  w_s(&mut out, "/* A copy to or from a lent page is ordered the same way: after the reads\n");
  w_s(&mut out, " * before it, and before the writes after it. */\n");
  w_s(&mut out, "static inline void bst_dma_to_bytes(bst_bytes *dst, uint64_t d, bst_dma *m, uint64_t o, uint64_t n) {\n");
  w_s(&mut out, "    __asm__ volatile (\"dmb osh\" : : : \"memory\");\n");
  w_s(&mut out, "    if (n) bst_copy_fwd(dst->data + d, (const unsigned char *)(uintptr_t)(*m + o), n);\n");
  w_s(&mut out, "    __asm__ volatile (\"dmb osh\" : : : \"memory\");\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bytes_to_dma(bst_dma *m, uint64_t o, bst_bytes src, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    __asm__ volatile (\"dmb osh\" : : : \"memory\");\n");
  w_s(&mut out, "    if (n) bst_copy_fwd((unsigned char *)(uintptr_t)(*m + o), src.data + s, n);\n");
  w_s(&mut out, "    __asm__ volatile (\"dmb osh\" : : : \"memory\");\n");
  w_s(&mut out, "}\n");
}

const PART_POSIX: u64 = 0;
const PART_COMMON: u64 = 1;
const PART_HOSTED: u64 = 2;
const PART_BYTES: u64 = 3;
const PART_PT_HOOK_HOSTED: u64 = 4;
const PART_PAGES: u64 = 5;
const PART_CHILD: u64 = 6;
const PART_PORTS: u64 = 7;
const PART_PORTS_HOSTED: u64 = 8;
const PART_MMIO: u64 = 9;
const PART_MMIO_HOSTED: u64 = 10;
const PART_DMA: u64 = 11;
const PART_KERNEL: u64 = 12;
const PART_BYTES_ARENA: u64 = 13;
const PART_KERNEL_CPU: u64 = 14;
const PART_PORTS_KERNEL: u64 = 15;
const PART_MMIO_KERNEL: u64 = 16;
const PART_USER: u64 = 17;
const PART_KERNEL_A64: u64 = 18;
const PART_PAGES_A64: u64 = 19;
const PART_KERNEL_CPU_A64: u64 = 20;
const PART_MMIO_KERNEL_A64: u64 = 21;
const PART_USER_A64: u64 = 22;
const PART_DMA_A64: u64 = 23;
/// Not in any target's list (stage0 has no such part): see `cg_prelude_net`.
const PART_NET: u64 = 24;
/// Not in any target's list either: see `cg_prelude_sandbox`.
const PART_SANDBOX: u64 = 25;
/// Not in any target's list either: see `cg_prelude_f64`.
const PART_F64: u64 = 26;
/// Not in any target's list either: see `cg_prelude_sys`.
const PART_SYS: u64 = 28;
/// Not in any target's list either: see `cg_prelude_code`.
const PART_CODE: u64 = 27;
/// Not in any target's list either: see `cg_prelude_spawn_err`.
const PART_SPAWN_ERR: u64 = 29;
/// Not in any target's list either: see `cg_prelude_child_async`.
const PART_CHILD_ASYNC: u64 = 30;
/// Not in any target's list either: see `cg_prelude_thread`.
const PART_THREAD: u64 = 31;

fn cg_part_name(id: u64) -> Str {
  if id == PART_POSIX { return "posix"; }
  if id == PART_COMMON { return "common"; }
  if id == PART_HOSTED { return "hosted"; }
  if id == PART_BYTES { return "bytes"; }
  if id == PART_PT_HOOK_HOSTED { return "pt_hook_hosted"; }
  if id == PART_PAGES { return "pages"; }
  if id == PART_CHILD { return "child"; }
  if id == PART_PORTS { return "ports"; }
  if id == PART_PORTS_HOSTED { return "ports_hosted"; }
  if id == PART_MMIO { return "mmio"; }
  if id == PART_MMIO_HOSTED { return "mmio_hosted"; }
  if id == PART_DMA { return "dma"; }
  if id == PART_KERNEL { return "kernel"; }
  if id == PART_BYTES_ARENA { return "bytes_arena"; }
  if id == PART_KERNEL_CPU { return "kernel_cpu"; }
  if id == PART_PORTS_KERNEL { return "ports_kernel"; }
  if id == PART_MMIO_KERNEL { return "mmio_kernel"; }
  if id == PART_KERNEL_A64 { return "kernel_a64"; }
  if id == PART_PAGES_A64 { return "pages_a64"; }
  if id == PART_KERNEL_CPU_A64 { return "kernel_cpu_a64"; }
  if id == PART_MMIO_KERNEL_A64 { return "mmio_kernel_a64"; }
  if id == PART_USER_A64 { return "user_a64"; }
  if id == PART_DMA_A64 { return "dma_a64"; }
  if id == PART_NET { return "net"; }
  if id == PART_SANDBOX { return "sandbox"; }
  if id == PART_F64 { return "f64"; }
  if id == PART_SYS { return "sys"; }
  if id == PART_CODE { return "code"; }
  if id == PART_SPAWN_ERR { return "spawn_err"; }
  if id == PART_CHILD_ASYNC { return "child_async"; }
  if id == PART_THREAD { return "thread"; }
  return "user";
}

fn cg_part(out: &mut Vec[u64], id: u64) {
  if id == PART_POSIX {
    // POSIX for the child-process functions; set before any header.
    w_s(&mut out, "#define _POSIX_C_SOURCE 200809L\n");
  } else if id == PART_COMMON { cg_prelude_common(&mut out); }
  else if id == PART_HOSTED { cg_prelude_hosted(&mut out); }
  else if id == PART_BYTES { cg_prelude_bytes(&mut out); }
  else if id == PART_PT_HOOK_HOSTED { w_s(&mut out, "#define BST_PT_NEW_HOOK (void)level;\nstatic inline void bst_mmu_settle_on(uint64_t t) { (void)t; }\n"); }
  else if id == PART_PAGES { cg_prelude_pages(&mut out); }
  else if id == PART_CHILD { cg_prelude_child(&mut out); }
  else if id == PART_PORTS { cg_prelude_ports(&mut out); }
  else if id == PART_PORTS_HOSTED { cg_prelude_ports_hosted(&mut out); }
  else if id == PART_MMIO { cg_prelude_mmio(&mut out); }
  else if id == PART_MMIO_HOSTED { cg_prelude_mmio_hosted(&mut out); }
  else if id == PART_DMA { cg_prelude_dma(&mut out); }
  else if id == PART_KERNEL { cg_prelude_kernel(&mut out); }
  else if id == PART_BYTES_ARENA { cg_prelude_bytes_arena(&mut out); }
  else if id == PART_KERNEL_CPU { cg_prelude_kernel_cpu(&mut out); }
  else if id == PART_PORTS_KERNEL { cg_prelude_ports_kernel(&mut out); }
  else if id == PART_MMIO_KERNEL { cg_prelude_mmio_kernel(&mut out); }
  else if id == PART_KERNEL_A64 { cg_prelude_kernel_a64(&mut out); }
  else if id == PART_PAGES_A64 { cg_prelude_pages_a64(&mut out); }
  else if id == PART_KERNEL_CPU_A64 { cg_prelude_kernel_cpu_a64(&mut out); }
  else if id == PART_MMIO_KERNEL_A64 { cg_prelude_mmio_kernel_a64(&mut out); }
  else if id == PART_USER_A64 { cg_prelude_user_a64(&mut out); }
  else if id == PART_DMA_A64 { cg_prelude_dma_a64(&mut out); }
  else if id == PART_NET { cg_prelude_net(&mut out); }
  else if id == PART_SANDBOX { cg_prelude_sandbox(&mut out); }
  else if id == PART_F64 { cg_prelude_f64(&mut out); }
  else if id == PART_SYS { cg_prelude_sys(&mut out); }
  else if id == PART_CODE { cg_prelude_code(&mut out); }
  else if id == PART_SPAWN_ERR { cg_prelude_spawn_err(&mut out); }
  else if id == PART_CHILD_ASYNC { cg_prelude_child_async(&mut out); }
  else if id == PART_THREAD { cg_prelude_thread(&mut out); }
  else { cg_prelude_user(&mut out); }
}

/// The parts of target `target`'s prelude for architecture `arch`, in
/// stage0's order (`prelude_parts`) for x86-64. The AArch64 kernel and user
/// parts are stage1's own: stage0 has no AArch64 bare-metal targets. A
/// hosted program is the same C on either architecture.
fn cg_parts(target: u64, arch: u64) -> Vec[u64] {
  let mut v = vec_new[u64]();
  if arch == ARCH_AARCH64 && target == TARGET_KERNEL {
    vec_push(&mut v, PART_COMMON);
    vec_push(&mut v, PART_KERNEL_A64);
    vec_push(&mut v, PART_BYTES_ARENA);
    vec_push(&mut v, PART_BYTES);
    vec_push(&mut v, PART_PAGES_A64);
    vec_push(&mut v, PART_KERNEL_CPU_A64);
    vec_push(&mut v, PART_MMIO);
    vec_push(&mut v, PART_MMIO_KERNEL_A64);
    vec_push(&mut v, PART_DMA_A64);
  } else if arch == ARCH_AARCH64 && target == TARGET_USER {
    vec_push(&mut v, PART_COMMON);
    vec_push(&mut v, PART_USER_A64);
    vec_push(&mut v, PART_BYTES_ARENA);
    vec_push(&mut v, PART_BYTES);
  } else if target == TARGET_KERNEL {
    vec_push(&mut v, PART_COMMON);
    vec_push(&mut v, PART_KERNEL);
    vec_push(&mut v, PART_BYTES_ARENA);
    vec_push(&mut v, PART_BYTES);
    vec_push(&mut v, PART_PAGES);
    vec_push(&mut v, PART_KERNEL_CPU);
    vec_push(&mut v, PART_PORTS);
    vec_push(&mut v, PART_PORTS_KERNEL);
    vec_push(&mut v, PART_MMIO);
    vec_push(&mut v, PART_MMIO_KERNEL);
    vec_push(&mut v, PART_DMA);
  } else if target == TARGET_USER {
    vec_push(&mut v, PART_COMMON);
    vec_push(&mut v, PART_USER);
    vec_push(&mut v, PART_BYTES_ARENA);
    vec_push(&mut v, PART_BYTES);
  } else {
    vec_push(&mut v, PART_POSIX);
    vec_push(&mut v, PART_COMMON);
    vec_push(&mut v, PART_HOSTED);
    vec_push(&mut v, PART_BYTES);
    vec_push(&mut v, PART_PT_HOOK_HOSTED);
    vec_push(&mut v, PART_PAGES);
    vec_push(&mut v, PART_CHILD);
    vec_push(&mut v, PART_PORTS);
    vec_push(&mut v, PART_PORTS_HOSTED);
    vec_push(&mut v, PART_MMIO);
    vec_push(&mut v, PART_MMIO_HOSTED);
    vec_push(&mut v, PART_DMA);
  }
  return v;
}

/// Target `target`'s prelude for architecture `arch`.
fn cg_prelude(out: &mut Vec[u64], target: u64, arch: u64) {
  let parts = cg_parts(target, arch);
  let mut k = 0;
  while k < vec_len(parts) {
    cg_part(&mut out, vec_get(parts, k));
    k = k + 1;
  }
  vec_free(parts);
}
