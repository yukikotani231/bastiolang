fn cg_prelude_mmio_kernel(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "#define BST_MMIO_RW(w, t) \\\n");
  cg_s(&mut out, "    static inline uint64_t bst_mmio_read##w(bst_mmio *m, uint64_t o) { return *(volatile t *)(uintptr_t)(m->base + o); } \\\n");
  cg_s(&mut out, "    static inline void bst_mmio_write##w(bst_mmio *m, uint64_t o, uint64_t v) { *(volatile t *)(uintptr_t)(m->base + o) = (t)v; }\n");
  cg_s(&mut out, "BST_MMIO_RW(8, uint8_t) BST_MMIO_RW(16, uint16_t) BST_MMIO_RW(32, uint32_t) BST_MMIO_RW(64, uint64_t)\n");
}

fn cg_prelude_dma(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "static inline bst_dma bst_dma_lend(bst_frame f) { __atomic_thread_fence(__ATOMIC_SEQ_CST); return f; }\n");
  cg_s(&mut out, "static inline bst_frame bst_dma_take(bst_dma d) { __atomic_thread_fence(__ATOMIC_SEQ_CST); return d; }\n");
  cg_s(&mut out, "static inline uint64_t bst_dma_id(bst_dma d) { return (d - bst_pool_base) / 4096; }\n");
  cg_s(&mut out, "static inline uint64_t bst_dma_addr(bst_dma d) { return d; }\n");
  cg_s(&mut out, "#define BST_DMA_RW(w, t) \\\n");
  cg_s(&mut out, "    static inline uint64_t bst_dma_read##w(bst_dma *d, uint64_t o) { return *(volatile t *)(uintptr_t)(*d + o); } \\\n");
  cg_s(&mut out, "    static inline void bst_dma_write##w(bst_dma *d, uint64_t o, uint64_t v) { *(volatile t *)(uintptr_t)(*d + o) = (t)v; }\n");
  cg_s(&mut out, "BST_DMA_RW(8, uint8_t) BST_DMA_RW(16, uint16_t) BST_DMA_RW(32, uint32_t) BST_DMA_RW(64, uint64_t)\n");
}

fn cg_prelude_mmio_hosted(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "static unsigned char bst_mmio_cell[1u << 20];\n");
  cg_s(&mut out, "#define BST_MMIO_RW(w, t) \\\n");
  cg_s(&mut out, "    static inline uint64_t bst_mmio_read##w(bst_mmio *m, uint64_t o) { t v; memcpy(&v, &bst_mmio_cell[(m->base + o) & 0xFFFFF], sizeof v); return v; } \\\n");
  cg_s(&mut out, "    static inline void bst_mmio_write##w(bst_mmio *m, uint64_t o, uint64_t v) { t x = (t)v; memcpy(&bst_mmio_cell[(m->base + o) & 0xFFFFF], &x, sizeof x); }\n");
  cg_s(&mut out, "BST_MMIO_RW(8, uint8_t) BST_MMIO_RW(16, uint16_t) BST_MMIO_RW(32, uint32_t) BST_MMIO_RW(64, uint64_t)\n");
}

fn cg_prelude_ports_kernel(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "static inline uint64_t bst_pio_in8(bst_portio *io, uint64_t o) { return bst_inb((uint16_t)(io->base + o)); }\n");
  cg_s(&mut out, "static inline uint64_t bst_pio_in16(bst_portio *io, uint64_t o) { uint16_t v; __asm__ volatile (\"inw %1, %0\" : \"=a\"(v) : \"Nd\"((uint16_t)(io->base + o))); return v; }\n");
  cg_s(&mut out, "static inline uint64_t bst_pio_in32(bst_portio *io, uint64_t o) { uint32_t v; __asm__ volatile (\"inl %1, %0\" : \"=a\"(v) : \"Nd\"((uint16_t)(io->base + o))); return v; }\n");
  cg_s(&mut out, "static inline void bst_pio_out8(bst_portio *io, uint64_t o, uint64_t v) { bst_outb((uint16_t)(io->base + o), (uint8_t)v); }\n");
  cg_s(&mut out, "static inline void bst_pio_out16(bst_portio *io, uint64_t o, uint64_t v) { __asm__ volatile (\"outw %0, %1\" : : \"a\"((uint16_t)v), \"Nd\"((uint16_t)(io->base + o))); }\n");
  cg_s(&mut out, "static inline void bst_pio_out32(bst_portio *io, uint64_t o, uint64_t v) { __asm__ volatile (\"outl %0, %1\" : : \"a\"((uint32_t)v), \"Nd\"((uint16_t)(io->base + o))); }\n");
}

fn cg_prelude_ports_hosted(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "static uint32_t bst_port_cell[65536];\n");
  cg_s(&mut out, "static inline uint64_t bst_pio_in8(bst_portio *io, uint64_t o) { return bst_port_cell[io->base + o] & 0xFF; }\n");
  cg_s(&mut out, "static inline uint64_t bst_pio_in16(bst_portio *io, uint64_t o) { return bst_port_cell[io->base + o] & 0xFFFF; }\n");
  cg_s(&mut out, "static inline uint64_t bst_pio_in32(bst_portio *io, uint64_t o) { return bst_port_cell[io->base + o]; }\n");
  cg_s(&mut out, "static inline void bst_pio_out8(bst_portio *io, uint64_t o, uint64_t v) { bst_port_cell[io->base + o] = (uint32_t)v; }\n");
  cg_s(&mut out, "static inline void bst_pio_out16(bst_portio *io, uint64_t o, uint64_t v) { bst_port_cell[io->base + o] = (uint32_t)v; }\n");
  cg_s(&mut out, "static inline void bst_pio_out32(bst_portio *io, uint64_t o, uint64_t v) { bst_port_cell[io->base + o] = (uint32_t)v; }\n");
}

fn cg_prelude_kernel_cpu(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "static inline void bst_load_cr3(uint64_t a) { __asm__ volatile (\"mov %0, %%cr3\" : : \"r\"(a) : \"memory\"); }\n");
  cg_s(&mut out, "static inline void bst_mmu_switch(bst_mmu *m, bst_pt root) { (void)m; bst_load_cr3(root); }\n");
  cg_s(&mut out, "static inline void bst_mmu_kernel(bst_mmu *m) { (void)m; bst_load_cr3((uint64_t)bst_kernel_pml4); }\n");
  cg_s(&mut out, "static inline bst_frame bst_pt_free_root(bst_mmu m, bst_pt t) { (void)m; return t; }\n");
  cg_s(&mut out, "\n");
  cg_s(&mut out, "/* Saved user registers: rax rbx rcx rdx rsi rdi rbp r8-r15 (0-14), rip (15),\n");
  cg_s(&mut out, " * rsp (16), rflags (17), error code (18), fault address (19), FS base (20). */\n");
  cg_s(&mut out, "extern uint64_t *bst_platform_ctx(void); /* this processor's saved context, 21 words */\n");
  cg_s(&mut out, "extern uint64_t bst_cpu_enter(void);   /* enter user mode; returns the trap vector */\n");
  cg_s(&mut out, "extern uint64_t bst_cpu_wait(void);    /* sti; hlt; cli; returns the interrupt vector */\n");
  cg_s(&mut out, "static inline uint64_t bst_cpu_get(bst_cpu c, uint64_t r) { (void)c; return bst_platform_ctx()[r]; }\n");
  cg_s(&mut out, "static inline void bst_cpu_set(bst_cpu *c, uint64_t r, uint64_t v) { (void)c; bst_platform_ctx()[r] = v; }\n");
  cg_s(&mut out, "/* The user's x87/SSE state, in a page the kernel owns (the platform has\n");
  cg_s(&mut out, " * enabled CR4.OSFXSR). fxrstor faults on reserved MXCSR bits, so the load\n");
  cg_s(&mut out, " * works from a copy with only the defined bits (0-15) kept. */\n");
  cg_s(&mut out, "static inline void bst_cpu_fpu_save(bst_cpu *c, bst_frame *f) {\n");
  cg_s(&mut out, "    (void)c;\n");
  cg_s(&mut out, "    __asm__ volatile (\"fxsave64 (%0)\" : : \"r\"(*f) : \"memory\");\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline void bst_cpu_fpu_load(bst_cpu *c, bst_frame f) {\n");
  cg_s(&mut out, "    (void)c;\n");
  cg_s(&mut out, "    uint64_t buf[64] __attribute__((aligned(16)));\n");
  cg_s(&mut out, "    for (int i = 0; i < 64; i++) buf[i] = ((uint64_t *)f)[i];\n");
  cg_s(&mut out, "    buf[3] &= 0xFFFF;                   /* bytes 24-27 are MXCSR, 28-31 its mask (ignored) */\n");
  cg_s(&mut out, "    __asm__ volatile (\"fxrstor64 (%0)\" : : \"r\"(buf) : \"memory\");\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline uint64_t bst_cpu_run(bst_cpu *c, bst_mmu m) {\n");
  cg_s(&mut out, "    (void)c; (void)m;\n");
  cg_s(&mut out, "    uint64_t cr3;\n");
  cg_s(&mut out, "    __asm__ volatile (\"mov %%cr3, %0\" : \"=r\"(cr3));\n");
  cg_s(&mut out, "    bst_load_cr3(cr3);                  /* flush the TLB: pages may have moved since the last run */\n");
  cg_s(&mut out, "    return bst_cpu_enter();\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline uint64_t bst_cpu_idle(bst_cpu *c) { (void)c; return bst_cpu_wait(); }\n");
  cg_s(&mut out, "extern void bst_platform_smp_start(void (*fn)(void *), void *arg); /* run fn(arg) on every other processor */\n");
  cg_s(&mut out, "extern void bst_platform_smp_join(void);                           /* wait until all of them have returned */\n");
  cg_s(&mut out, "extern uint64_t bst_platform_cpus(void); /* processors running, this one included; 1 to 4096 */\n");
  cg_s(&mut out, "static inline uint64_t bst_cpu_count(bst_cpu c) { (void)c; return bst_platform_cpus(); }\n");
  cg_s(&mut out, "\n");
  cg_s(&mut out, "/* Called by the platform on a fault in kernel mode: that is a bug in the\n");
  cg_s(&mut out, " * trusted base or the compiler, never in verified code. */\n");
  cg_s(&mut out, "void bst_kernel_fault(uint64_t vec, uint64_t rip, uint64_t cr2, uint64_t err) {\n");
  cg_s(&mut out, "    bst_puts(\"\\nbastio: kernel fault, vector \"); bst_puthex(vec);\n");
  cg_s(&mut out, "    bst_puts(\" rip \"); bst_puthex(rip); bst_puts(\" cr2 \"); bst_puthex(cr2); bst_puts(\" err \"); bst_puthex(err);\n");
  cg_s(&mut out, "    bst_puts(\"\\n\");\n");
  cg_s(&mut out, "    bst_halt();\n");
  cg_s(&mut out, "}\n");
}

fn cg_prelude_user(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "enum { BST_SYS_EXIT, BST_SYS_WRITE, BST_SYS_READ, BST_SYS_SPAWN, BST_SYS_WAIT, BST_SYS_YIELD,\n");
  cg_s(&mut out, "       BST_SYS_GETPID, BST_SYS_INFO, BST_SYS_PS, BST_SYS_KILL, BST_SYS_POWEROFF };\n");
  cg_s(&mut out, "static inline uint64_t bst_sys(uint64_t n, uint64_t a, uint64_t b, uint64_t c) {\n");
  cg_s(&mut out, "    uint64_t r;\n");
  cg_s(&mut out, "    __asm__ volatile (\"int $0x80\" : \"=a\"(r) : \"a\"(n), \"D\"(a), \"S\"(b), \"d\"(c) : \"memory\");\n");
  cg_s(&mut out, "    return r;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static unsigned char bst_out[256];\n");
  cg_s(&mut out, "static uint64_t bst_out_n;\n");
  cg_s(&mut out, "static void bst_flush(void) {\n");
  cg_s(&mut out, "    if (bst_out_n) bst_sys(BST_SYS_WRITE, (uint64_t)bst_out, bst_out_n, 0);\n");
  cg_s(&mut out, "    bst_out_n = 0;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) {\n");
  cg_s(&mut out, "    (void)s;\n");
  cg_s(&mut out, "    bst_out[bst_out_n++] = (unsigned char)b;\n");
  cg_s(&mut out, "    if (b == '\\n' || bst_out_n == sizeof bst_out) bst_flush();\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) { (void)s; bst_flush(); return bst_sys(BST_SYS_READ, 0, 0, 0); }\n");
  cg_s(&mut out, "\n");
  cg_s(&mut out, "#define BST_ARENA_WORDS (1u << 13)   /* 64 KiB */\n");
  cg_s(&mut out, "static uint64_t bst_arena[BST_ARENA_WORDS];\n");
  cg_s(&mut out, "static uint64_t bst_arena_top = 0;\n");
  cg_s(&mut out, "typedef struct bst_free { uint64_t words; struct bst_free *next; } bst_free_t;\n");
  cg_s(&mut out, "static bst_free_t *bst_free_list = 0;\n");
  cg_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  cg_s(&mut out, "    uint64_t words = (n ? n : 1) + 1;\n");
  cg_s(&mut out, "    if (words < 2) words = 2;\n");
  cg_s(&mut out, "    bst_free_t **pp = &bst_free_list;\n");
  cg_s(&mut out, "    for (bst_free_t *f = bst_free_list; f; pp = &f->next, f = f->next) {\n");
  cg_s(&mut out, "        if (f->words == words) {\n");
  cg_s(&mut out, "            *pp = f->next;\n");
  cg_s(&mut out, "            uint64_t *blk = (uint64_t *)f;\n");
  cg_s(&mut out, "            for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  cg_s(&mut out, "            bst_buf b = { n, blk + 1 };\n");
  cg_s(&mut out, "            return b;\n");
  cg_s(&mut out, "        }\n");
  cg_s(&mut out, "    }\n");
  cg_s(&mut out, "    if (bst_arena_top + words > BST_ARENA_WORDS) {\n");
  cg_s(&mut out, "        static const char m[] = \"bastio: out of memory\\n\";\n");
  cg_s(&mut out, "        bst_flush();\n");
  cg_s(&mut out, "        bst_sys(BST_SYS_WRITE, (uint64_t)m, sizeof m - 1, 0);\n");
  cg_s(&mut out, "        bst_sys(BST_SYS_EXIT, 255, 0, 0);\n");
  cg_s(&mut out, "    }\n");
  cg_s(&mut out, "    uint64_t *blk = &bst_arena[bst_arena_top];\n");
  cg_s(&mut out, "    bst_arena_top += words;\n");
  cg_s(&mut out, "    blk[0] = words;\n");
  cg_s(&mut out, "    for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  cg_s(&mut out, "    bst_buf b = { n, blk + 1 };\n");
  cg_s(&mut out, "    return b;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static void bst_free(bst_buf b) {\n");
  cg_s(&mut out, "    uint64_t *blk = b.data - 1;\n");
  cg_s(&mut out, "    bst_free_t *f = (bst_free_t *)blk;\n");
  cg_s(&mut out, "    f->words = blk[0];\n");
  cg_s(&mut out, "    f->next = bst_free_list;\n");
  cg_s(&mut out, "    bst_free_list = f;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static void bst_print(uint64_t v) {\n");
  cg_s(&mut out, "    char d[20]; int n = 0;\n");
  cg_s(&mut out, "    do { d[n++] = (char)('0' + v % 10); v /= 10; } while (v);\n");
  cg_s(&mut out, "    while (n) bst_serial_write(0, (unsigned char)d[--n]);\n");
  cg_s(&mut out, "    bst_serial_write(0, '\\n');\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static uint64_t bst_sys_spawn(bst_buf b, uint64_t from, uint64_t to) {\n");
  cg_s(&mut out, "    unsigned char name[64];\n");
  cg_s(&mut out, "    uint64_t n = 0;\n");
  cg_s(&mut out, "    for (uint64_t i = from; i < to && n < sizeof name; i++) name[n++] = (unsigned char)b.data[i];\n");
  cg_s(&mut out, "    return bst_sys(BST_SYS_SPAWN, (uint64_t)name, n, 0);\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline uint64_t bst_sys_wait(uint64_t pid) { return bst_sys(BST_SYS_WAIT, pid, 0, 0); }\n");
  cg_s(&mut out, "static inline uint64_t bst_sys_kill(uint64_t pid) { return bst_sys(BST_SYS_KILL, pid, 0, 0); }\n");
  cg_s(&mut out, "static inline void bst_sys_yield(void) { bst_sys(BST_SYS_YIELD, 0, 0, 0); }\n");
  cg_s(&mut out, "static inline uint64_t bst_sys_getpid(void) { return bst_sys(BST_SYS_GETPID, 0, 0, 0); }\n");
  cg_s(&mut out, "static inline uint64_t bst_sys_info(uint64_t k) { return bst_sys(BST_SYS_INFO, k, 0, 0); }\n");
  cg_s(&mut out, "static inline void bst_sys_ps(void) { bst_flush(); bst_sys(BST_SYS_PS, 0, 0, 0); }\n");
  cg_s(&mut out, "static inline void bst_sys_poweroff(void) { bst_flush(); bst_sys(BST_SYS_POWEROFF, 0, 0, 0); }\n");
  cg_s(&mut out, "/* Calls with numbers the language does not know: the kernel defines them.\n");
  cg_s(&mut out, " * sys_send lends the kernel bytes 0..n of b to read; sys_recv lends all of b\n");
  cg_s(&mut out, " * to overwrite. Console output is flushed first so it stays in order. */\n");
  cg_s(&mut out, "static inline uint64_t bst_sys_call(uint64_t n, uint64_t a, uint64_t b) { bst_flush(); return bst_sys(n, a, b, 0); }\n");
  cg_s(&mut out, "static inline uint64_t bst_sys_send(uint64_t n, uint64_t a, bst_bytes b, uint64_t len) { bst_flush(); return bst_sys(n, a, (uint64_t)b.data, len); }\n");
  cg_s(&mut out, "static inline uint64_t bst_sys_recv(uint64_t n, uint64_t a, bst_bytes *b) { bst_flush(); return bst_sys(n, a, (uint64_t)b->data, b->len); }\n");
}

/// The parts of target `target`'s prelude, in stage0's order
/// (`prelude_parts`).
fn cg_prelude(out: &mut Vec[u64], target: u64) {
  if target == TARGET_KERNEL {
    cg_prelude_common(&mut out);
    cg_prelude_kernel(&mut out);
    cg_prelude_bytes_arena(&mut out);
    cg_prelude_bytes(&mut out);
    cg_prelude_pages(&mut out);
    cg_prelude_kernel_cpu(&mut out);
    cg_prelude_ports(&mut out);
    cg_prelude_ports_kernel(&mut out);
    cg_prelude_mmio(&mut out);
    cg_prelude_mmio_kernel(&mut out);
    cg_prelude_dma(&mut out);
  } else if target == TARGET_USER {
    cg_prelude_common(&mut out);
    cg_prelude_user(&mut out);
    cg_prelude_bytes_arena(&mut out);
    cg_prelude_bytes(&mut out);
  } else {
    // POSIX for the child-process functions; set before any header.
    cg_s(&mut out, "#define _POSIX_C_SOURCE 200809L\n");
    cg_prelude_common(&mut out);
    cg_prelude_hosted(&mut out);
    cg_prelude_bytes(&mut out);
    cg_s(&mut out, "#define BST_PT_NEW_HOOK (void)level;\n");
    cg_prelude_pages(&mut out);
    cg_prelude_child(&mut out);
    cg_prelude_ports(&mut out);
    cg_prelude_ports_hosted(&mut out);
    cg_prelude_mmio(&mut out);
    cg_prelude_mmio_hosted(&mut out);
    cg_prelude_dma(&mut out);
  }
}
