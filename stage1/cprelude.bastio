// The runtime preludes: the C each generated program starts with, one
// function per part. They are copies of the preludes of stage0's C backend
// (stage0/src/codegen.rs), and the differential test (difftest.sh, `c`)
// keeps them identical: what bastioc1 emits must match what bastioc0 emits
// byte for byte. Like those, they are the trusted runtime of each target
// (ROADMAP invariant 3).

fn cg_s(out: &mut Vec[u64], s: Str) {
  let mut k = 0;
  while k < slen(s)
    invariant k <= slen(s)
  {
    vec_push(&mut out, cast[u64](sget(s, k)));
    k = k + 1;
  }
}

fn cg_prelude_common(out: &mut Vec[u64]) {
  cg_s(&mut out, "/* generated by bastioc0 -- do not edit */\n");
  cg_s(&mut out, "#include <stdint.h>\n");
  cg_s(&mut out, "#include <stdbool.h>\n");
  cg_s(&mut out, "#include <stddef.h>\n");
  cg_s(&mut out, "typedef struct { uint64_t len; uint64_t *data; } bst_buf;\n");
  cg_s(&mut out, "typedef struct { uint64_t len; const unsigned char *data; } bst_str;\n");
  cg_s(&mut out, "typedef struct { uint64_t len; unsigned char *data; } bst_bytes;\n");
  cg_s(&mut out, "typedef int bst_serial, bst_mmu, bst_cpu, bst_host;   /* capability tokens: no data */\n");
  cg_s(&mut out, "typedef uint64_t bst_frame, bst_pt;         /* a page's physical address */\n");
  cg_s(&mut out, "typedef struct { uint64_t base, size; } bst_pool;\n");
  cg_s(&mut out, "typedef int bst_ports;                      /* capability token: no data */\n");
  cg_s(&mut out, "typedef struct { uint64_t base, count; } bst_portio;\n");
  cg_s(&mut out, "typedef int bst_mmiospace;                  /* capability token: no data */\n");
  cg_s(&mut out, "typedef struct { uint64_t base, len; } bst_mmio;\n");
  cg_s(&mut out, "typedef uint64_t bst_dma;                   /* a lent page's physical address */\n");
  cg_s(&mut out, "/* Lock[T]: a lock word followed by the T. A spin lock; acquire and release\n");
  cg_s(&mut out, " * order the accesses to the contents between processors. */\n");
  cg_s(&mut out, "static inline void bst_lock_acquire(uint64_t *w) {\n");
  cg_s(&mut out, "    while (__atomic_exchange_n(w, 1, __ATOMIC_ACQUIRE))\n");
  cg_s(&mut out, "        while (__atomic_load_n(w, __ATOMIC_RELAXED)) {\n");
  cg_s(&mut out, "#if defined(__x86_64__) || defined(__i386__)\n");
  cg_s(&mut out, "            __asm__ volatile (\"pause\");\n");
  cg_s(&mut out, "#endif\n");
  cg_s(&mut out, "        }\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline void bst_lock_release(uint64_t *w) { __atomic_store_n(w, 0, __ATOMIC_RELEASE); }\n");
  cg_s(&mut out, "static inline bst_buf bst_set(bst_buf b, uint64_t i, uint64_t v) { b.data[i] = v; return b; }\n");
}

fn cg_prelude_hosted(out: &mut Vec[u64]) {
  cg_s(&mut out, "#include <stdio.h>\n");
  cg_s(&mut out, "#include <stdlib.h>\n");
  cg_s(&mut out, "#include <string.h>\n");
  cg_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) { (void)s; putchar((int)b); if (b == '\\n') fflush(stdout); }\n");
  cg_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) { (void)s; fflush(stdout); int c = getchar(); return c == EOF ? 4 : (uint64_t)c; }\n");
  cg_s(&mut out, "\n");
  cg_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  cg_s(&mut out, "    bst_buf b;\n");
  cg_s(&mut out, "    b.len = n;\n");
  cg_s(&mut out, "    b.data = (uint64_t *)calloc(n ? n : 1, sizeof(uint64_t));\n");
  cg_s(&mut out, "    if (!b.data) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  cg_s(&mut out, "    return b;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline void bst_free(bst_buf b) { free(b.data); }\n");
  cg_s(&mut out, "/* Grow a block of `old` words to `n` words, keeping its contents; the new\n");
  cg_s(&mut out, " * words are not zeroed (only Vec uses it, and never reads past its length). */\n");
  cg_s(&mut out, "static uint64_t *bst_regrow(uint64_t *p, uint64_t old, uint64_t n) {\n");
  cg_s(&mut out, "    (void)old;\n");
  cg_s(&mut out, "    uint64_t *q = (uint64_t *)realloc(p, (n ? n : 1) * sizeof(uint64_t));\n");
  cg_s(&mut out, "    if (!q) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  cg_s(&mut out, "    return q;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline void bst_print(uint64_t v) { printf(\"%llu\\n\", (unsigned long long)v); }\n");
  cg_s(&mut out, "\n");
  cg_s(&mut out, "static bst_bytes bst_balloc(uint64_t n) {\n");
  cg_s(&mut out, "    bst_bytes b;\n");
  cg_s(&mut out, "    b.len = n;\n");
  cg_s(&mut out, "    b.data = (unsigned char *)calloc(n ? n : 1, 1);\n");
  cg_s(&mut out, "    if (!b.data) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  cg_s(&mut out, "    return b;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline void bst_bfree(bst_bytes b) { free(b.data); }\n");
  cg_s(&mut out, "\n");
  cg_s(&mut out, "/* The Host capability: command-line arguments and whole-file I/O. */\n");
  cg_s(&mut out, "static int bst_argc;\n");
  cg_s(&mut out, "static char **bst_argv;\n");
  cg_s(&mut out, "static uint64_t bst_host_argc(bst_host h) { (void)h; return (uint64_t)bst_argc; }\n");
  cg_s(&mut out, "static bst_bytes bst_host_arg(bst_host h, uint64_t i) {\n");
  cg_s(&mut out, "    (void)h;\n");
  cg_s(&mut out, "    if (i >= (uint64_t)bst_argc) return bst_balloc(0);\n");
  cg_s(&mut out, "    size_t n = strlen(bst_argv[i]);\n");
  cg_s(&mut out, "    bst_bytes b = bst_balloc(n);\n");
  cg_s(&mut out, "    memcpy(b.data, bst_argv[i], n);\n");
  cg_s(&mut out, "    return b;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static char *bst_cpath(bst_bytes p) {   /* a NUL-terminated copy; a NUL inside ends the path */\n");
  cg_s(&mut out, "    char *c = (char *)malloc(p.len + 1);\n");
  cg_s(&mut out, "    if (!c) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  cg_s(&mut out, "    memcpy(c, p.data, p.len);\n");
  cg_s(&mut out, "    c[p.len] = 0;\n");
  cg_s(&mut out, "    return c;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static bool bst_host_read(bst_host h, bst_bytes path, bst_bytes *out) {\n");
  cg_s(&mut out, "    (void)h;\n");
  cg_s(&mut out, "    char *c = bst_cpath(path);\n");
  cg_s(&mut out, "    FILE *f = fopen(c, \"rb\");\n");
  cg_s(&mut out, "    free(c);\n");
  cg_s(&mut out, "    if (!f) return false;\n");
  cg_s(&mut out, "    size_t cap = 4096, n = 0;\n");
  cg_s(&mut out, "    unsigned char *d = (unsigned char *)malloc(cap);\n");
  cg_s(&mut out, "    if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  cg_s(&mut out, "    size_t got;\n");
  cg_s(&mut out, "    while ((got = fread(d + n, 1, cap - n, f)) > 0) {\n");
  cg_s(&mut out, "        n += got;\n");
  cg_s(&mut out, "        if (n == cap) {\n");
  cg_s(&mut out, "            cap *= 2;\n");
  cg_s(&mut out, "            d = (unsigned char *)realloc(d, cap);\n");
  cg_s(&mut out, "            if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  cg_s(&mut out, "        }\n");
  cg_s(&mut out, "    }\n");
  cg_s(&mut out, "    bool ok = !ferror(f);\n");
  cg_s(&mut out, "    fclose(f);\n");
  cg_s(&mut out, "    if (!ok) { free(d); return false; }\n");
  cg_s(&mut out, "    free(out->data);\n");
  cg_s(&mut out, "    out->len = n;\n");
  cg_s(&mut out, "    out->data = d;\n");
  cg_s(&mut out, "    return true;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static bool bst_host_write(bst_host h, bst_bytes path, bst_bytes data) {\n");
  cg_s(&mut out, "    (void)h;\n");
  cg_s(&mut out, "    char *c = bst_cpath(path);\n");
  cg_s(&mut out, "    FILE *f = fopen(c, \"wb\");\n");
  cg_s(&mut out, "    free(c);\n");
  cg_s(&mut out, "    if (!f) return false;\n");
  cg_s(&mut out, "    bool ok = fwrite(data.data, 1, data.len, f) == data.len;\n");
  cg_s(&mut out, "    return fclose(f) == 0 && ok;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static void bst_host_eprint(bst_host h, bst_bytes b) {\n");
  cg_s(&mut out, "    (void)h;\n");
  cg_s(&mut out, "    fflush(stdout);\n");
  cg_s(&mut out, "    fwrite(b.data, 1, b.len, stderr);\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "\n");
  cg_s(&mut out, "/* Simulated physical memory: a pool of page-aligned pages from the heap. */\n");
  cg_s(&mut out, "#define BST_HOSTED_PAGES 256\n");
  cg_s(&mut out, "static uint64_t bst_pool_base;\n");
  cg_s(&mut out, "static bst_pool bst_pool_init(void) {\n");
  cg_s(&mut out, "    bst_pool p;\n");
  cg_s(&mut out, "    p.size = BST_HOSTED_PAGES;\n");
  cg_s(&mut out, "    p.base = (uint64_t)aligned_alloc(4096, BST_HOSTED_PAGES * 4096);\n");
  cg_s(&mut out, "    if (!p.base) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  cg_s(&mut out, "    bst_pool_base = p.base;\n");
  cg_s(&mut out, "    return p;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static void bst_pool_fini(bst_pool p) { free((void *)p.base); }\n");
}

fn cg_prelude_pages(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "#define BST_PTE_P 1ull\n");
  cg_s(&mut out, "#define BST_PTE_W 2ull\n");
  cg_s(&mut out, "#define BST_PTE_U 4ull\n");
  cg_s(&mut out, "#define BST_PTE_ADDR 0x000FFFFFFFFFF000ull\n");
  cg_s(&mut out, "static inline void bst_zero_page(uint64_t a) {\n");
  cg_s(&mut out, "#if defined(__x86_64__)\n");
  cg_s(&mut out, "    void *p = (void *)a;\n");
  cg_s(&mut out, "    uint64_t n = 512;\n");
  cg_s(&mut out, "    __asm__ volatile (\"rep stosq\" : \"+D\"(p), \"+c\"(n) : \"a\"(0ull) : \"memory\");\n");
  cg_s(&mut out, "#else\n");
  cg_s(&mut out, "    uint64_t *w = (uint64_t *)a;\n");
  cg_s(&mut out, "    for (int k = 0; k < 512; k++) w[k] = 0;\n");
  cg_s(&mut out, "#endif\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline uint64_t bst_pool_size(bst_pool p) { return p.size; }\n");
  cg_s(&mut out, "static inline bst_frame bst_pool_take(bst_pool *p, uint64_t i) {\n");
  cg_s(&mut out, "    uint64_t a = p->base + i * 4096;\n");
  cg_s(&mut out, "    bst_zero_page(a);      /* never leak a page's old contents */\n");
  cg_s(&mut out, "    return a;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline void bst_pool_give(bst_pool *p, bst_frame f) { (void)p; (void)f; }\n");
  cg_s(&mut out, "static inline uint64_t bst_frame_id(bst_frame f) { return (f - bst_pool_base) / 4096; }\n");
  cg_s(&mut out, "static inline uint64_t bst_frame_read(bst_frame f, uint64_t w) { return ((uint64_t *)f)[w]; }\n");
  cg_s(&mut out, "static inline void bst_frame_write(bst_frame *f, uint64_t w, uint64_t v) { ((uint64_t *)*f)[w] = v; }\n");
  cg_s(&mut out, "static inline uint64_t bst_frame_read8(bst_frame f, uint64_t o) { return ((unsigned char *)f)[o]; }\n");
  cg_s(&mut out, "static inline void bst_frame_write8(bst_frame *f, uint64_t o, uint64_t v) { ((unsigned char *)*f)[o] = (unsigned char)v; }\n");
  cg_s(&mut out, "static inline bst_pt bst_pt_new(bst_frame f, uint64_t level) {\n");
  cg_s(&mut out, "    uint64_t *e = (uint64_t *)f;\n");
  cg_s(&mut out, "    bst_zero_page(f);      /* f may be a page that held data, not a fresh one */\n");
  cg_s(&mut out, "    BST_PT_NEW_HOOK\n");
  cg_s(&mut out, "    return f;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline bst_frame bst_pt_free(bst_pt t) { return t; }\n");
  cg_s(&mut out, "static inline bool bst_pt_has(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_P) != 0; }\n");
  cg_s(&mut out, "static inline void bst_pt_put(bst_pt *t, uint64_t i, bst_pt c) { ((uint64_t *)*t)[i] = c | BST_PTE_P | BST_PTE_W | BST_PTE_U; }\n");
  cg_s(&mut out, "static inline void bst_pt_put_frame(bst_pt *t, uint64_t i, bst_frame f, bool w) {\n");
  cg_s(&mut out, "    ((uint64_t *)*t)[i] = f | BST_PTE_P | BST_PTE_U | (w ? BST_PTE_W : 0);\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline uint64_t bst_pt_take(bst_pt *t, uint64_t i) {\n");
  cg_s(&mut out, "    uint64_t *e = &((uint64_t *)*t)[i];\n");
  cg_s(&mut out, "    uint64_t a = *e & BST_PTE_ADDR;\n");
  cg_s(&mut out, "    *e = 0;\n");
  cg_s(&mut out, "    return a;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "#define bst_pt_take_frame bst_pt_take\n");
}

fn cg_prelude_kernel(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "static inline void bst_outb(uint16_t port, uint8_t v) { __asm__ volatile (\"outb %0, %1\" : : \"a\"(v), \"Nd\"(port)); }\n");
  cg_s(&mut out, "static inline uint8_t bst_inb(uint16_t port) { uint8_t v; __asm__ volatile (\"inb %1, %0\" : \"=a\"(v) : \"Nd\"(port)); return v; }\n");
  cg_s(&mut out, "\n");
  cg_s(&mut out, "#define BST_COM1 0x3F8\n");
  cg_s(&mut out, "static void bst_serial_init(void) {\n");
  cg_s(&mut out, "    bst_outb(BST_COM1 + 1, 0x00);   /* interrupts off while configuring */\n");
  cg_s(&mut out, "    bst_outb(BST_COM1 + 3, 0x80);   /* DLAB on */\n");
  cg_s(&mut out, "    bst_outb(BST_COM1 + 0, 0x01);   /* 115200 baud */\n");
  cg_s(&mut out, "    bst_outb(BST_COM1 + 1, 0x00);\n");
  cg_s(&mut out, "    bst_outb(BST_COM1 + 3, 0x03);   /* 8N1 */\n");
  cg_s(&mut out, "    bst_outb(BST_COM1 + 2, 0xC7);   /* FIFO on */\n");
  cg_s(&mut out, "    bst_outb(BST_COM1 + 4, 0x0B);   /* DTR, RTS, OUT2 (routes the IRQ line) */\n");
  cg_s(&mut out, "    bst_outb(BST_COM1 + 1, 0x01);   /* interrupt on received data */\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) {\n");
  cg_s(&mut out, "    (void)s;\n");
  cg_s(&mut out, "    while ((bst_inb(BST_COM1 + 5) & 0x20) == 0) { }\n");
  cg_s(&mut out, "    bst_outb(BST_COM1, (uint8_t)b);\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) {\n");
  cg_s(&mut out, "    (void)s;\n");
  cg_s(&mut out, "    while ((bst_inb(BST_COM1 + 5) & 0x01) == 0) { __asm__ volatile (\"pause\"); }\n");
  cg_s(&mut out, "    return bst_inb(BST_COM1);\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline uint64_t bst_serial_poll(bst_serial s) {\n");
  cg_s(&mut out, "    (void)s;\n");
  cg_s(&mut out, "    return (bst_inb(BST_COM1 + 5) & 0x01) ? bst_inb(BST_COM1) : 256;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "\n");
  cg_s(&mut out, "static void bst_halt(void) { for (;;) __asm__ volatile (\"cli; hlt\"); }\n");
  cg_s(&mut out, "static void bst_puts(const char *m) { for (; *m; m++) bst_serial_write(0, (unsigned char)*m); }\n");
  cg_s(&mut out, "static void bst_puthex(uint64_t v) {\n");
  cg_s(&mut out, "    bst_puts(\"0x\");\n");
  cg_s(&mut out, "    for (int i = 60; i >= 0; i -= 4) bst_serial_write(0, (unsigned char)\"0123456789abcdef\"[(v >> i) & 15]);\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "\n");
  cg_s(&mut out, "/* Memory for Buf: a fixed arena with an exact-size free list. */\n");
  cg_s(&mut out, "#define BST_ARENA_WORDS (1u << 20)   /* 8 MiB */\n");
  cg_s(&mut out, "static uint64_t bst_arena[BST_ARENA_WORDS];\n");
  cg_s(&mut out, "static uint64_t bst_arena_top = 0;\n");
  cg_s(&mut out, "typedef struct bst_free { uint64_t words; struct bst_free *next; } bst_free_t;\n");
  cg_s(&mut out, "static bst_free_t *bst_free_list = 0;\n");
  cg_s(&mut out, "static uint64_t bst_arena_lock;              /* every processor allocates from the one arena */\n");
  cg_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  cg_s(&mut out, "    uint64_t words = (n ? n : 1) + 1;            /* one header word for the size */\n");
  cg_s(&mut out, "    if (words < 2) words = 2;\n");
  cg_s(&mut out, "    uint64_t *blk = 0;\n");
  cg_s(&mut out, "    bst_lock_acquire(&bst_arena_lock);\n");
  cg_s(&mut out, "    bst_free_t **pp = &bst_free_list;\n");
  cg_s(&mut out, "    for (bst_free_t *f = bst_free_list; f; pp = &f->next, f = f->next) {\n");
  cg_s(&mut out, "        if (f->words == words) {\n");
  cg_s(&mut out, "            *pp = f->next;\n");
  cg_s(&mut out, "            blk = (uint64_t *)f;\n");
  cg_s(&mut out, "            break;\n");
  cg_s(&mut out, "        }\n");
  cg_s(&mut out, "    }\n");
  cg_s(&mut out, "    if (!blk) {\n");
  cg_s(&mut out, "        if (bst_arena_top + words > BST_ARENA_WORDS) { bst_puts(\"bastio: out of memory\\n\"); bst_halt(); }\n");
  cg_s(&mut out, "        blk = &bst_arena[bst_arena_top];\n");
  cg_s(&mut out, "        bst_arena_top += words;\n");
  cg_s(&mut out, "        blk[0] = words;\n");
  cg_s(&mut out, "    }\n");
  cg_s(&mut out, "    bst_lock_release(&bst_arena_lock);\n");
  cg_s(&mut out, "    for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  cg_s(&mut out, "    bst_buf b = { n, blk + 1 };\n");
  cg_s(&mut out, "    return b;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static void bst_free(bst_buf b) {\n");
  cg_s(&mut out, "    uint64_t *blk = b.data - 1;\n");
  cg_s(&mut out, "    bst_free_t *f = (bst_free_t *)blk;\n");
  cg_s(&mut out, "    bst_lock_acquire(&bst_arena_lock);\n");
  cg_s(&mut out, "    f->words = blk[0];\n");
  cg_s(&mut out, "    f->next = bst_free_list;\n");
  cg_s(&mut out, "    bst_free_list = f;\n");
  cg_s(&mut out, "    bst_lock_release(&bst_arena_lock);\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static void bst_print(uint64_t v) {\n");
  cg_s(&mut out, "    char d[20]; int n = 0;\n");
  cg_s(&mut out, "    do { d[n++] = (char)('0' + v % 10); v /= 10; } while (v);\n");
  cg_s(&mut out, "    while (n) bst_serial_write(0, (unsigned char)d[--n]);\n");
  cg_s(&mut out, "    bst_serial_write(0, '\\n');\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "\n");
  cg_s(&mut out, "/* Physical pages: everything from the end of the kernel image to the end of\n");
  cg_s(&mut out, " * the RAM that follows it, capped at 2^16 pages and at the 1 GiB the boot\n");
  cg_s(&mut out, " * code identity-maps. With a Multiboot memory map (flags bit 6) that is the\n");
  cg_s(&mut out, " * run of available entries, merged where they touch, that holds the first\n");
  cg_s(&mut out, " * page after the kernel: UEFI firmware leaves holes low in memory, where\n");
  cg_s(&mut out, " * mem_upper (bit 0, the fallback) stops. A map outside the 1 GiB is not read. */\n");
  cg_s(&mut out, "extern char _end[];\n");
  cg_s(&mut out, "extern uint64_t bst_kernel_pml4[512];\n");
  cg_s(&mut out, "static uint64_t bst_pool_base;\n");
  cg_s(&mut out, "static bst_pool bst_pool_init(uint64_t mbi) {\n");
  cg_s(&mut out, "    uint32_t *info = (uint32_t *)mbi;\n");
  cg_s(&mut out, "    uint64_t base = ((uint64_t)_end + 4095) & ~4095ull;\n");
  cg_s(&mut out, "    uint64_t ram_end = 64ull << 20;\n");
  cg_s(&mut out, "    if (info && (info[0] & 1)) ram_end = (1ull << 20) + ((uint64_t)info[2] << 10);\n");
  cg_s(&mut out, "    if (info && (info[0] & 64) && (uint64_t)info[12] + info[11] <= (1ull << 30)) {\n");
  cg_s(&mut out, "        uint64_t end = base;\n");
  cg_s(&mut out, "        for (int grew = 1; grew; ) {\n");
  cg_s(&mut out, "            grew = 0;\n");
  cg_s(&mut out, "            uint8_t *e = (uint8_t *)(uint64_t)info[12], *stop = e + info[11];\n");
  cg_s(&mut out, "            while (e + 24 <= stop) {\n");
  cg_s(&mut out, "                uint64_t addr = *(uint64_t *)(e + 4), len = *(uint64_t *)(e + 12);\n");
  cg_s(&mut out, "                if (*(uint32_t *)(e + 20) == 1 && addr <= end && end < addr + len) {\n");
  cg_s(&mut out, "                    end = addr + len;\n");
  cg_s(&mut out, "                    grew = 1;\n");
  cg_s(&mut out, "                }\n");
  cg_s(&mut out, "                e += *(uint32_t *)e + 4;\n");
  cg_s(&mut out, "            }\n");
  cg_s(&mut out, "        }\n");
  cg_s(&mut out, "        ram_end = end;\n");
  cg_s(&mut out, "    }\n");
  cg_s(&mut out, "    if (ram_end > (1ull << 30)) ram_end = 1ull << 30;\n");
  cg_s(&mut out, "    bst_pool p;\n");
  cg_s(&mut out, "    p.base = base;\n");
  cg_s(&mut out, "    p.size = ram_end > base ? (ram_end - base) / 4096 : 0;\n");
  cg_s(&mut out, "    if (p.size > 65536) p.size = 65536;\n");
  cg_s(&mut out, "    bst_pool_base = base;\n");
  cg_s(&mut out, "    return p;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "#define BST_PT_NEW_HOOK if (level == 4) e[0] = ((uint64_t)bst_kernel_pml4[0] & BST_PTE_ADDR) | BST_PTE_P | BST_PTE_W;\n");
}

fn cg_prelude_bytes_arena(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "static bst_bytes bst_balloc(uint64_t n) {\n");
  cg_s(&mut out, "    bst_buf w = bst_alloc((n + 7) / 8);\n");
  cg_s(&mut out, "    bst_bytes b = { n, (unsigned char *)w.data };\n");
  cg_s(&mut out, "    return b;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static void bst_bfree(bst_bytes b) {\n");
  cg_s(&mut out, "    bst_buf w = { (b.len + 7) / 8, (uint64_t *)b.data };\n");
  cg_s(&mut out, "    bst_free(w);\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "/* Grow a block of `old` words to `n` words, keeping its contents. */\n");
  cg_s(&mut out, "static uint64_t *bst_regrow(uint64_t *p, uint64_t old, uint64_t n) {\n");
  cg_s(&mut out, "    uint64_t *q = bst_alloc(n).data;\n");
  cg_s(&mut out, "    if (p) {\n");
  cg_s(&mut out, "        for (uint64_t i = 0; i < old; i++) q[i] = p[i];\n");
  cg_s(&mut out, "        bst_buf b = { old, p };\n");
  cg_s(&mut out, "        bst_free(b);\n");
  cg_s(&mut out, "    }\n");
  cg_s(&mut out, "    return q;\n");
  cg_s(&mut out, "}\n");
}

fn cg_prelude_child(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "#include <unistd.h>\n");
  cg_s(&mut out, "#include <signal.h>\n");
  cg_s(&mut out, "#include <sys/wait.h>\n");
  cg_s(&mut out, "typedef struct { int pid; int in; FILE *out; } bst_child;\n");
  cg_s(&mut out, "/* A child that cannot be started (no such program, no pipes or processes\n");
  cg_s(&mut out, " * left) behaves like one that exited with 127 without output, which is\n");
  cg_s(&mut out, " * what a failed exec in the child looks like anyway. */\n");
  cg_s(&mut out, "static bst_child bst_host_spawn(bst_host h, bst_vec argv) {\n");
  cg_s(&mut out, "    (void)h;\n");
  cg_s(&mut out, "    bst_child c = { -1, -1, NULL };\n");
  cg_s(&mut out, "    int to[2], from[2];\n");
  cg_s(&mut out, "    if (argv.len == 0 || pipe(to) != 0) return c;\n");
  cg_s(&mut out, "    if (pipe(from) != 0) { close(to[0]); close(to[1]); return c; }\n");
  cg_s(&mut out, "    char **av = (char **)malloc((argv.len + 1) * sizeof(char *));\n");
  cg_s(&mut out, "    if (!av) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  cg_s(&mut out, "    for (uint64_t i = 0; i < argv.len; i++) av[i] = bst_cpath(((bst_bytes *)argv.data)[i]);\n");
  cg_s(&mut out, "    av[argv.len] = NULL;\n");
  cg_s(&mut out, "    fflush(NULL);\n");
  cg_s(&mut out, "    int pid = fork();\n");
  cg_s(&mut out, "    if (pid == 0) {\n");
  cg_s(&mut out, "        dup2(to[0], 0);\n");
  cg_s(&mut out, "        dup2(from[1], 1);\n");
  cg_s(&mut out, "        close(to[0]); close(to[1]); close(from[0]); close(from[1]);\n");
  cg_s(&mut out, "        execvp(av[0], av);\n");
  cg_s(&mut out, "        _exit(127);\n");
  cg_s(&mut out, "    }\n");
  cg_s(&mut out, "    for (uint64_t i = 0; i < argv.len; i++) free(av[i]);\n");
  cg_s(&mut out, "    free(av);\n");
  cg_s(&mut out, "    close(to[0]);\n");
  cg_s(&mut out, "    close(from[1]);\n");
  cg_s(&mut out, "    if (pid < 0) { close(to[1]); close(from[0]); return c; }\n");
  cg_s(&mut out, "    signal(SIGPIPE, SIG_IGN);   /* writing to a child that has exited fails instead */\n");
  cg_s(&mut out, "    c.pid = pid;\n");
  cg_s(&mut out, "    c.in = to[1];\n");
  cg_s(&mut out, "    c.out = fdopen(from[0], \"rb\");\n");
  cg_s(&mut out, "    if (!c.out) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  cg_s(&mut out, "    return c;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static bool bst_child_write(bst_child *c, bst_bytes d) {\n");
  cg_s(&mut out, "    if (c->in < 0) return false;\n");
  cg_s(&mut out, "    uint64_t n = 0;\n");
  cg_s(&mut out, "    while (n < d.len) {\n");
  cg_s(&mut out, "        ssize_t w = write(c->in, d.data + n, d.len - n);\n");
  cg_s(&mut out, "        if (w <= 0) return false;\n");
  cg_s(&mut out, "        n += (uint64_t)w;\n");
  cg_s(&mut out, "    }\n");
  cg_s(&mut out, "    return true;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static void bst_child_close(bst_child *c) {\n");
  cg_s(&mut out, "    if (c->in >= 0) { close(c->in); c->in = -1; }\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static bool bst_child_read_line(bst_child *c, bst_bytes *out) {\n");
  cg_s(&mut out, "    if (!c->out) return false;\n");
  cg_s(&mut out, "    size_t cap = 64, n = 0;\n");
  cg_s(&mut out, "    unsigned char *d = (unsigned char *)malloc(cap);\n");
  cg_s(&mut out, "    if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  cg_s(&mut out, "    int ch;\n");
  cg_s(&mut out, "    while ((ch = getc(c->out)) != EOF && ch != '\\n') {\n");
  cg_s(&mut out, "        if (n == cap) {\n");
  cg_s(&mut out, "            cap *= 2;\n");
  cg_s(&mut out, "            d = (unsigned char *)realloc(d, cap);\n");
  cg_s(&mut out, "            if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  cg_s(&mut out, "        }\n");
  cg_s(&mut out, "        d[n++] = (unsigned char)ch;\n");
  cg_s(&mut out, "    }\n");
  cg_s(&mut out, "    if (ch == EOF && n == 0) { free(d); return false; }\n");
  cg_s(&mut out, "    free(out->data);\n");
  cg_s(&mut out, "    out->len = n;\n");
  cg_s(&mut out, "    out->data = d;\n");
  cg_s(&mut out, "    return true;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static uint64_t bst_child_wait(bst_child c) {\n");
  cg_s(&mut out, "    bst_child_close(&c);\n");
  cg_s(&mut out, "    if (c.out) fclose(c.out);\n");
  cg_s(&mut out, "    if (c.pid < 0) return 127;\n");
  cg_s(&mut out, "    int st;\n");
  cg_s(&mut out, "    while (waitpid(c.pid, &st, 0) < 0) {}\n");
  cg_s(&mut out, "    if (WIFEXITED(st)) return (uint64_t)WEXITSTATUS(st);\n");
  cg_s(&mut out, "    if (WIFSIGNALED(st)) return 128 + (uint64_t)WTERMSIG(st);\n");
  cg_s(&mut out, "    return 255;\n");
  cg_s(&mut out, "}\n");
}

fn cg_prelude_bytes(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "/* Box[T]: one allocation from the same allocator as Buf. */\n");
  cg_s(&mut out, "static void *bst_box_alloc(uint64_t n) { return bst_alloc((n + 7) / 8).data; }\n");
  cg_s(&mut out, "static void bst_box_free(void *p, uint64_t n) { bst_buf w = { (n + 7) / 8, (uint64_t *)p }; bst_free(w); }\n");
  cg_s(&mut out, "\n");
  cg_s(&mut out, "/* Vec[T]: elements in one allocation that doubles when full. A size past\n");
  cg_s(&mut out, " * 2^60 bytes asks the allocator for more than it can give, so it aborts\n");
  cg_s(&mut out, " * (out of memory), as `alloc` does. */\n");
  cg_s(&mut out, "typedef struct { uint64_t len, cap; void *data; } bst_vec;\n");
  cg_s(&mut out, "static void bst_vec_release(bst_vec v, uint64_t size) {\n");
  cg_s(&mut out, "    if (v.data) { bst_buf b = { (v.cap * size + 7) / 8, (uint64_t *)v.data }; bst_free(b); }\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static void bst_vec_grow(bst_vec *v, uint64_t size) {\n");
  cg_s(&mut out, "    uint64_t ncap = v->cap ? v->cap * 2 : 4;\n");
  cg_s(&mut out, "    uint64_t bytes = ncap > (UINT64_C(1) << 60) / size ? ~UINT64_C(0) - 8 : ncap * size;\n");
  cg_s(&mut out, "    v->data = bst_regrow((uint64_t *)v->data, (v->cap * size + 7) / 8, (bytes + 7) / 8);\n");
  cg_s(&mut out, "    v->cap = ncap;\n");
  cg_s(&mut out, "}\n");
  cg_s(&mut out, "static inline void bst_bset(bst_bytes *b, uint64_t i, uint64_t v) { b->data[i] = (unsigned char)v; }\n");
  cg_s(&mut out, "static bst_bytes bst_bfrom(bst_str s) {\n");
  cg_s(&mut out, "    bst_bytes b = bst_balloc(s.len);\n");
  cg_s(&mut out, "    for (uint64_t i = 0; i < s.len; i++) b.data[i] = s.data[i];\n");
  cg_s(&mut out, "    return b;\n");
  cg_s(&mut out, "}\n");
}

