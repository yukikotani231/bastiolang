  cg_s(&mut out, "static inline bst_portio bst_port_claim(bst_ports *p, uint64_t b, uint64_t c) { (void)p; bst_portio io = { b, c }; return io; }\n");
  cg_s(&mut out, "static inline void bst_port_release(bst_ports *p, bst_portio io) { (void)p; (void)io; }\n");
  cg_s(&mut out, "static inline uint64_t bst_port_base(bst_portio io) { return io.base; }\n");
  cg_s(&mut out, "static inline uint64_t bst_port_count(bst_portio io) { return io.count; }\n");
}

