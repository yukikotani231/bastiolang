// The runtime preludes: the C each generated program starts with, one
// function per part. They are copies of the preludes of stage0's C backend
// (stage0/src/codegen.rs), and the differential test (difftest.sh, `c`)
// keeps them identical: what bastioc1 emits must match what bastioc0 emits
// byte for byte. Like those, they are the trusted runtime of each target
// (ROADMAP invariant 3).

import "wtext.bastio";

fn cg_prelude_common(out: &mut Vec[u64]) {
  w_s(&mut out, "/* generated by bastioc0 -- do not edit */\n");
  w_s(&mut out, "#include <stdint.h>\n");
  w_s(&mut out, "#include <stdbool.h>\n");
  w_s(&mut out, "#include <stddef.h>\n");
  w_s(&mut out, "typedef struct { uint64_t len; uint64_t *data; } bst_buf;\n");
  w_s(&mut out, "typedef struct { uint64_t len; const unsigned char *data; } bst_str;\n");
  w_s(&mut out, "typedef struct { uint64_t len; unsigned char *data; } bst_bytes;\n");
  w_s(&mut out, "typedef int bst_serial, bst_mmu, bst_cpu, bst_host;   /* capability tokens: no data */\n");
  w_s(&mut out, "typedef uint64_t bst_frame, bst_pt;         /* a page's physical address */\n");
  w_s(&mut out, "typedef struct { uint64_t base, size; } bst_pool;\n");
  w_s(&mut out, "typedef int bst_ports;                      /* capability token: no data */\n");
  w_s(&mut out, "typedef struct { uint64_t base, count; } bst_portio;\n");
  w_s(&mut out, "typedef int bst_mmiospace;                  /* capability token: no data */\n");
  w_s(&mut out, "typedef struct { uint64_t base, len; } bst_mmio;\n");
  w_s(&mut out, "typedef uint64_t bst_dma;                   /* a lent page's physical address */\n");
  w_s(&mut out, "typedef uint64_t bst_lease;                 /* the address of the table it holds */\n");
  w_s(&mut out, "/* Lock[T]: a lock word followed by the T. A spin lock; acquire and release\n");
  w_s(&mut out, " * order the accesses to the contents between processors. A processor that\n");
  w_s(&mut out, " * has to wait first gives up a parked address space (bst_mmu_exit), as a\n");
  w_s(&mut out, " * processor holding a lease never waits, and one that lets go of its last\n");
  w_s(&mut out, " * lock gives it up too, unless it entered the table again meanwhile\n");
  w_s(&mut out, " * (bst_lock_depth). */\n");
  w_s(&mut out, "static inline void bst_mmu_settle(void);    /* defined per target */\n");
  w_s(&mut out, "static inline void bst_lock_depth(int d);   /* defined per target */\n");
  w_s(&mut out, "#ifndef BST_SPIN_PLAIN\n#define BST_SPIN_PLAIN 4096u\n#endif\n");
  w_s(&mut out, "#ifdef BST_LOCKSTAT\n");
  w_s(&mut out, "/* Diagnostic build (-DBST_LOCKSTAT): per lock, how many times it was taken,\n");
  w_s(&mut out, " * how many of those had to wait, and the time spent waiting and holding,\n");
  w_s(&mut out, " * in TSC ticks. Read bst_lockstat from a debugger. */\n");
  w_s(&mut out, "struct bst_ls { uint64_t *w; uint64_t acq, contended, wait, hold, t0; };\n");
  w_s(&mut out, "struct bst_ls bst_lockstat[8];\n");
  w_s(&mut out, "static inline struct bst_ls *bst_ls_of(uint64_t *w) {\n");
  w_s(&mut out, "    for (int i = 0; i < 8; i++) {\n");
  w_s(&mut out, "        uint64_t *o = 0;\n");
  w_s(&mut out, "        if (__atomic_load_n(&bst_lockstat[i].w, __ATOMIC_ACQUIRE) == w) return &bst_lockstat[i];\n");
  w_s(&mut out, "        if (__atomic_compare_exchange_n(&bst_lockstat[i].w, &o, w, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return &bst_lockstat[i];\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return &bst_lockstat[7];\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static inline void bst_lock_acquire(uint64_t *w) {\n");
  w_s(&mut out, "#ifdef BST_LOCKSTAT\n");
  w_s(&mut out, "    uint64_t bst_t0 = __builtin_ia32_rdtsc();\n");
  w_s(&mut out, "    int bst_waited = 0;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    while (__atomic_exchange_n(w, 1, __ATOMIC_ACQUIRE)) {\n");
  w_s(&mut out, "#ifdef BST_LOCKSTAT\n");
  w_s(&mut out, "        bst_waited = 1;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        bst_mmu_settle();\n");
  w_s(&mut out, "        unsigned bst_spins = 0;\n");
  w_s(&mut out, "        while (__atomic_load_n(w, __ATOMIC_RELAXED)) {\n");
  w_s(&mut out, "#if defined(__x86_64__) || defined(__i386__)\n");
  w_s(&mut out, "            if (++bst_spins > BST_SPIN_PLAIN) __asm__ volatile (\"pause\");\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#ifdef BST_LOCKSTAT\n");
  w_s(&mut out, "    { struct bst_ls *l = bst_ls_of(w); uint64_t t = __builtin_ia32_rdtsc();\n");
  w_s(&mut out, "      l->acq++; l->contended += bst_waited; l->wait += t - bst_t0; l->t0 = t; }\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    bst_lock_depth(1);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_lock_release(uint64_t *w) {\n");
  w_s(&mut out, "#ifdef BST_LOCKSTAT\n");
  w_s(&mut out, "    { struct bst_ls *l = bst_ls_of(w); l->hold += __builtin_ia32_rdtsc() - l->t0; }\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    __atomic_store_n(w, 0, __ATOMIC_RELEASE); bst_lock_depth(-1);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_buf bst_set(bst_buf b, uint64_t i, uint64_t v) { b.data[i] = v; return b; }\n");
}

fn cg_prelude_hosted(out: &mut Vec[u64]) {
  w_s(&mut out, "#include <stdio.h>\n");
  w_s(&mut out, "#include <stdlib.h>\n");
  w_s(&mut out, "#include <string.h>\n");
  w_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) { (void)s; putchar((int)b); if (b == '\\n') fflush(stdout); }\n");
  w_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) { (void)s; fflush(stdout); int c = getchar(); return c == EOF ? 4 : (uint64_t)c; }\n");
  w_s(&mut out, "static inline void bst_mmu_settle(void) { }\n");
  w_s(&mut out, "static inline void bst_lock_depth(int d) { (void)d; }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf b;\n");
  w_s(&mut out, "    b.len = n;\n");
  w_s(&mut out, "    b.data = (uint64_t *)calloc(n ? n : 1, sizeof(uint64_t));\n");
  w_s(&mut out, "    if (!b.data) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_buf bst_try_alloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf b;\n");
  w_s(&mut out, "    b.data = (uint64_t *)calloc(n ? n : 1, sizeof(uint64_t));\n");
  w_s(&mut out, "    __asm__ volatile (\"\" : \"+r\"(b.data)); /* clang drops a calloc that is only freed, and with it the failure */\n");
  w_s(&mut out, "    b.len = b.data ? n : 0;\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_free(bst_buf b) { free(b.data); }\n");
  w_s(&mut out, "/* Grow a block of `old` words to `n` words, keeping its contents; the new\n");
  w_s(&mut out, " * words are not zeroed (only Vec uses it, and never reads past its length). */\n");
  w_s(&mut out, "static uint64_t *bst_try_regrow(uint64_t *p, uint64_t old, uint64_t n) {\n");
  w_s(&mut out, "    (void)old;\n");
  w_s(&mut out, "    return (uint64_t *)realloc(p, (n ? n : 1) * sizeof(uint64_t));\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t *bst_regrow(uint64_t *p, uint64_t old, uint64_t n) {\n");
  w_s(&mut out, "    uint64_t *q = bst_try_regrow(p, old, n);\n");
  w_s(&mut out, "    if (!q) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    return q;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_print(uint64_t v) { printf(\"%llu\\n\", (unsigned long long)v); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "static bst_bytes bst_balloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_bytes b;\n");
  w_s(&mut out, "    b.len = n;\n");
  w_s(&mut out, "    b.data = (unsigned char *)calloc(n ? n : 1, 1);\n");
  w_s(&mut out, "    if (!b.data) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_bytes bst_try_balloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_bytes b;\n");
  w_s(&mut out, "    b.data = (unsigned char *)calloc(n ? n : 1, 1);\n");
  w_s(&mut out, "    __asm__ volatile (\"\" : \"+r\"(b.data)); /* clang drops a calloc that is only freed, and with it the failure */\n");
  w_s(&mut out, "    b.len = b.data ? n : 0;\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bfree(bst_bytes b) { free(b.data); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* The Host capability: command-line arguments and whole-file I/O. */\n");
  w_s(&mut out, "static int bst_argc;\n");
  w_s(&mut out, "static char **bst_argv;\n");
  w_s(&mut out, "static uint64_t bst_host_argc(bst_host h) { (void)h; return (uint64_t)bst_argc; }\n");
  w_s(&mut out, "static bst_bytes bst_host_arg(bst_host h, uint64_t i) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    if (i >= (uint64_t)bst_argc) return bst_balloc(0);\n");
  w_s(&mut out, "    const char *a = bst_argv[i];\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    if (i == 0 && _pgmptr) a = _pgmptr;   /* argv[0] may lack the .exe that opens the file */\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    size_t n = strlen(a);\n");
  w_s(&mut out, "    bst_bytes b = bst_balloc(n);\n");
  w_s(&mut out, "    memcpy(b.data, a, n);\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static char *bst_cpath(bst_bytes p) {   /* a NUL-terminated copy; a NUL inside ends the path */\n");
  w_s(&mut out, "    char *c = (char *)malloc(p.len + 1);\n");
  w_s(&mut out, "    if (!c) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    memcpy(c, p.data, p.len);\n");
  w_s(&mut out, "    c[p.len] = 0;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    if (p.len == 9 && memcmp(c, \"/dev/null\", 9) == 0) memcpy(c, \"NUL\", 4);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    return c;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bool bst_host_read(bst_host h, bst_bytes path, bst_bytes *out) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    char *c = bst_cpath(path);\n");
  w_s(&mut out, "    FILE *f = fopen(c, \"rb\");\n");
  w_s(&mut out, "    free(c);\n");
  w_s(&mut out, "    if (!f) return false;\n");
  w_s(&mut out, "    size_t cap = 4096, n = 0;\n");
  w_s(&mut out, "    unsigned char *d = (unsigned char *)malloc(cap);\n");
  w_s(&mut out, "    if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    size_t got;\n");
  w_s(&mut out, "    while ((got = fread(d + n, 1, cap - n, f)) > 0) {\n");
  w_s(&mut out, "        n += got;\n");
  w_s(&mut out, "        if (n == cap) {\n");
  w_s(&mut out, "            cap *= 2;\n");
  w_s(&mut out, "            d = (unsigned char *)realloc(d, cap);\n");
  w_s(&mut out, "            if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bool ok = !ferror(f);\n");
  w_s(&mut out, "    fclose(f);\n");
  w_s(&mut out, "    if (!ok) { free(d); return false; }\n");
  w_s(&mut out, "    free(out->data);\n");
  w_s(&mut out, "    out->len = n;\n");
  w_s(&mut out, "    out->data = d;\n");
  w_s(&mut out, "    return true;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bool bst_host_write(bst_host h, bst_bytes path, bst_bytes data) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    char *c = bst_cpath(path);\n");
  w_s(&mut out, "    FILE *f = fopen(c, \"wb\");\n");
  w_s(&mut out, "    free(c);\n");
  w_s(&mut out, "    if (!f) return false;\n");
  w_s(&mut out, "    bool ok = fwrite(data.data, 1, data.len, f) == data.len;\n");
  w_s(&mut out, "    return fclose(f) == 0 && ok;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_host_eprint(bst_host h, bst_bytes b) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    fflush(stdout);\n");
  w_s(&mut out, "    fwrite(b.data, 1, b.len, stderr);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Simulated physical memory: a pool of page-aligned pages from the heap,\n");
  w_s(&mut out, " * one run of RAM (see the kernel's bst_pool_init for several). */\n");
  w_s(&mut out, "#define BST_HOSTED_PAGES 256\n");
  w_s(&mut out, "static uint64_t bst_run_at[1], bst_run_id[2], bst_runs;\n");
  w_s(&mut out, "static uint32_t bst_pt_leases[BST_HOSTED_PAGES], bst_shared_refs[BST_HOSTED_PAGES];\n");
  w_s(&mut out, "#define BST_MMIO_CHECK(b, l) ((void)(b), (void)(l))\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "#include <malloc.h>\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static bst_pool bst_pool_init(void) {\n");
  w_s(&mut out, "    bst_pool p;\n");
  w_s(&mut out, "    p.size = BST_HOSTED_PAGES;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    p.base = (uint64_t)_aligned_malloc(BST_HOSTED_PAGES * 4096, 4096);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    p.base = (uint64_t)aligned_alloc(4096, BST_HOSTED_PAGES * 4096);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    if (!p.base) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    bst_run_at[0] = p.base;\n");
  w_s(&mut out, "    bst_run_id[1] = BST_HOSTED_PAGES;\n");
  w_s(&mut out, "    bst_runs = 1;\n");
  w_s(&mut out, "    return p;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "static void bst_pool_fini(bst_pool p) { _aligned_free((void *)p.base); }\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "static void bst_pool_fini(bst_pool p) { free((void *)p.base); }\n");
  w_s(&mut out, "#endif\n");
}

fn cg_prelude_pages(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "#define BST_PTE_P 1ull\n");
  w_s(&mut out, "#define BST_PTE_W 2ull\n");
  w_s(&mut out, "#define BST_PTE_U 4ull\n");
  w_s(&mut out, "/* A page the program may write is never one it may run (W^X): the entry\n");
  w_s(&mut out, " * has the no-execute bit when it is made writable (pt_put_frame and\n");
  w_s(&mut out, " * pt_put_shared with w), and has not when made read-only, so a page is\n");
  w_s(&mut out, " * executable if it was mapped read-only (program text) or if the kernel\n");
  w_s(&mut out, " * made it so by mapping it again read-only. pt_set_access leaves the bit\n");
  w_s(&mut out, " * alone: a page that becomes writable for a copy-on-write fault keeps what\n");
  w_s(&mut out, " * its mapping chose. Needs EFER.NXE (boot.S). */\n");
  w_s(&mut out, "#define BST_PTE_NX (1ull << 63)\n");
  w_s(&mut out, "#define BST_PTE_ADDR 0x000FFFFFFFFFF000ull\n");
  w_s(&mut out, "static inline void bst_zero_page(uint64_t a) {\n");
  w_s(&mut out, "#if defined(__x86_64__)\n");
  w_s(&mut out, "    void *p = (void *)a;\n");
  w_s(&mut out, "    uint64_t n = 512;\n");
  w_s(&mut out, "    __asm__ volatile (\"rep stosq\" : \"+D\"(p), \"+c\"(n) : \"a\"(0ull) : \"memory\");\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    uint64_t *w = (uint64_t *)a;\n");
  w_s(&mut out, "    for (int k = 0; k < 512; k++) w[k] = 0;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_pool_size(bst_pool p) { return p.size; }\n");
  w_s(&mut out, "/* Page ids are dense over the runs of RAM: run r holds ids bst_run_id[r] up\n");
  w_s(&mut out, " * to bst_run_id[r + 1], from address bst_run_at[r]. Most machines have one\n");
  w_s(&mut out, " * or two runs, so the loops stop at once. */\n");
  w_s(&mut out, "static inline uint64_t bst_page_at(uint64_t i) {\n");
  w_s(&mut out, "    uint64_t r = 0;\n");
  w_s(&mut out, "    while (r + 1 < bst_runs && i >= bst_run_id[r + 1]) r++;\n");
  w_s(&mut out, "    return bst_run_at[r] + (i - bst_run_id[r]) * 4096;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_frame_id(bst_frame f) {\n");
  w_s(&mut out, "    uint64_t r = 0;\n");
  w_s(&mut out, "    while (r + 1 < bst_runs && f - bst_run_at[r] >= (bst_run_id[r + 1] - bst_run_id[r]) * 4096) r++;\n");
  w_s(&mut out, "    return bst_run_id[r] + (f - bst_run_at[r]) / 4096;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_frame bst_pool_take(bst_pool *p, uint64_t i) {\n");
  w_s(&mut out, "    uint64_t a = bst_page_at(i);\n");
  w_s(&mut out, "    (void)p;\n");
  w_s(&mut out, "    bst_zero_page(a);      /* never leak a page's old contents */\n");
  w_s(&mut out, "    return a;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_pool_give(bst_pool *p, bst_frame f) { (void)p; (void)f; }\n");
  w_s(&mut out, "static inline uint64_t bst_frame_read(bst_frame f, uint64_t w) { return ((uint64_t *)f)[w]; }\n");
  w_s(&mut out, "static inline void bst_frame_write(bst_frame *f, uint64_t w, uint64_t v) { ((uint64_t *)*f)[w] = v; }\n");
  w_s(&mut out, "static inline uint64_t bst_frame_read8(bst_frame f, uint64_t o) { return ((unsigned char *)f)[o]; }\n");
  w_s(&mut out, "static inline void bst_frame_write8(bst_frame *f, uint64_t o, uint64_t v) { ((unsigned char *)*f)[o] = (unsigned char)v; }\n");
  w_s(&mut out, "static inline void bst_frame_to_bytes(bst_bytes *dst, uint64_t d, bst_frame f, uint64_t o, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd(dst->data + d, (const unsigned char *)f + o, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bytes_to_frame(bst_frame *f, uint64_t o, bst_bytes src, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd((unsigned char *)*f + o, src.data + s, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_frame_to_frame(bst_frame *d, uint64_t o, bst_frame f, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd((unsigned char *)*d + o, (const unsigned char *)f + s, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_pt bst_pt_new(bst_frame f, uint64_t level) {\n");
  w_s(&mut out, "    uint64_t *e = (uint64_t *)f;\n");
  w_s(&mut out, "    bst_zero_page(f);      /* f may be a page that held data, not a fresh one */\n");
  w_s(&mut out, "    BST_PT_NEW_HOOK\n");
  w_s(&mut out, "    return f;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_frame bst_pt_free(bst_pt t) { return t; }\n");
  w_s(&mut out, "/* Counts every entry taken out of any table, and every protection change: a processor whose TLB may\n");
  w_s(&mut out, " * still hold the entry reloads CR3 before it runs user code again if the\n");
  w_s(&mut out, " * count moved since its last load (bst_cpu_run, bst_mmu_enter). Putting an\n");
  w_s(&mut out, " * entry into an empty slot needs no reload: x86 caches no translation for\n");
  w_s(&mut out, " * a slot that was not present. */\n");
  w_s(&mut out, "uint64_t bst_pt_gen;\n");
  w_s(&mut out, "/* A last-level slot the program may not touch (pt_set_access 0) keeps its\n");
  w_s(&mut out, " * page with the present bit clear, marked by a bit the CPU ignores in a\n");
  w_s(&mut out, " * non-present entry, so the table still owns it. */\n");
  w_s(&mut out, "#define BST_PTE_HIDDEN 0x400ull\n");
  w_s(&mut out, "static inline bool bst_pt_has(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & (BST_PTE_P | BST_PTE_HIDDEN)) != 0; }\n");
  w_s(&mut out, "static inline bool bst_pt_writable(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_W) != 0; }\n");
  w_s(&mut out, "static inline bool bst_pt_accessible(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_P) != 0; }\n");
  w_s(&mut out, "static inline void bst_pt_set_access(bst_pt *t, uint64_t i, uint64_t a) {\n");
  w_s(&mut out, "    uint64_t e = ((uint64_t *)*t)[i] & ~(BST_PTE_P | BST_PTE_W | BST_PTE_HIDDEN);\n");
  w_s(&mut out, "    e |= a == 0 ? BST_PTE_HIDDEN : (BST_PTE_P | (a == 2 ? BST_PTE_W : 0));\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], e, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "    __atomic_fetch_add(&bst_pt_gen, 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Another processor may be walking the table (it holds a lease on the\n");
  w_s(&mut out, " * tree), so an entry is written with one 64-bit store, present bit\n");
  w_s(&mut out, " * included, after everything it points to (release order). */\n");
  w_s(&mut out, "static inline void bst_pt_put(bst_pt *t, uint64_t i, bst_pt c) {\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], c | BST_PTE_P | BST_PTE_W | BST_PTE_U, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_pt_put_frame(bst_pt *t, uint64_t i, bst_frame f, bool w) {\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], f | BST_PTE_P | BST_PTE_U | (w ? BST_PTE_W | BST_PTE_NX : 0), __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* What slot i points to, left in place (pt_borrow). */\n");
  w_s(&mut out, "static inline uint64_t bst_pt_child(bst_pt t, uint64_t i) { return ((uint64_t *)t)[i] & BST_PTE_ADDR; }\n");
  w_s(&mut out, "/* Leases outstanding on each top-level table (mmu_enter, mmu_exit), by page\n");
  w_s(&mut out, " * number (bst_pt_leases, one per pool page, comes with the pool). A lease this processor parked\n");
  w_s(&mut out, " * (bst_mmu_exit) is given back first, so the count is what it would be had\n");
  w_s(&mut out, " * the table been left at once. */\n");
  w_s(&mut out, "static inline void bst_mmu_settle_on(uint64_t t);   /* defined per target */\n");
  w_s(&mut out, "static inline uint64_t bst_pt_lease_count(bst_pt *t) {\n");
  w_s(&mut out, "    bst_mmu_settle_on(*t);\n");
  w_s(&mut out, "    return __atomic_load_n(&bst_pt_leases[bst_frame_id(*t)], __ATOMIC_ACQUIRE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_pt_take(bst_pt *t, uint64_t i) {\n");
  w_s(&mut out, "    uint64_t *e = &((uint64_t *)*t)[i];\n");
  w_s(&mut out, "    uint64_t a = *e & BST_PTE_ADDR;\n");
  w_s(&mut out, "    *e = 0;\n");
  w_s(&mut out, "    __atomic_fetch_add(&bst_pt_gen, 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    return a;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define bst_pt_take_frame bst_pt_take\n");
  w_s(&mut out, "/* Shared pages: how many references (Shared values and pt_dup_shared's\n");
  w_s(&mut out, " * reads) each page has, by page number, and a PTE bit the CPU ignores that\n");
  w_s(&mut out, " * marks a slot mapping one. The last shared_drop gives the page back. */\n");
  w_s(&mut out, "#define BST_PTE_SHARED 0x200ull\n");
  w_s(&mut out, "static inline bst_frame bst_shared_new(bst_frame f) { __atomic_store_n(&bst_shared_refs[bst_frame_id(f)], 1, __ATOMIC_RELEASE); return f; }\n");
  w_s(&mut out, "static inline bst_frame bst_shared_dup(bst_frame s) { __atomic_fetch_add(&bst_shared_refs[bst_frame_id(s)], 1, __ATOMIC_RELAXED); return s; }\n");
  w_s(&mut out, "static inline uint64_t bst_shared_drop(bst_pool *p, bst_frame s) {\n");
  w_s(&mut out, "    uint64_t i = bst_frame_id(s);\n");
  w_s(&mut out, "    (void)p;\n");
  w_s(&mut out, "    return __atomic_sub_fetch(&bst_shared_refs[i], 1, __ATOMIC_ACQ_REL) == 0 ? i : ~0ull;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_shared_id(bst_frame s) { return bst_frame_id(s); }\n");
  w_s(&mut out, "static inline bool bst_pt_shared(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_SHARED) != 0; }\n");
  w_s(&mut out, "static inline void bst_pt_put_shared(bst_pt *t, uint64_t i, bst_frame s, bool w) {\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], s | BST_PTE_P | BST_PTE_U | BST_PTE_SHARED | (w ? BST_PTE_W | BST_PTE_NX : 0), __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define bst_pt_take_shared bst_pt_take\n");
  w_s(&mut out, "static inline bst_frame bst_pt_dup_shared(bst_pt t, uint64_t i) { return bst_shared_dup(((uint64_t *)t)[i] & BST_PTE_ADDR); }\n");
  w_s(&mut out, "/* Dirty pages: taken without zeroing, so whoever takes them (under a lock,\n");
  w_s(&mut out, " * say) does not pay for it; they become frames only by being overwritten\n");
  w_s(&mut out, " * whole, which can happen later and elsewhere. */\n");
  w_s(&mut out, "static inline bst_frame bst_pool_take_dirty(bst_pool *p, uint64_t i) { (void)p; return bst_page_at(i); }\n");
  w_s(&mut out, "static inline uint64_t bst_dirty_id(bst_frame d) { return bst_frame_id(d); }\n");
  w_s(&mut out, "static inline bst_frame bst_dirty_zero(bst_frame d) { bst_zero_page(d); return d; }\n");
  w_s(&mut out, "static inline bst_frame bst_frame_copy(bst_frame d, bst_frame src) { bst_copy_fwd((unsigned char *)d, (const unsigned char *)src, 4096); return d; }\n");
  w_s(&mut out, "#define bst_shared_copy bst_frame_copy\n");
  w_s(&mut out, "static inline bst_frame bst_dirty_fill(bst_frame d, bst_bytes src, uint64_t s) { bst_copy_fwd((unsigned char *)d, src.data + s, 4096); return d; }\n");
}

fn cg_prelude_kernel(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline void bst_outb(uint16_t port, uint8_t v) { __asm__ volatile (\"outb %0, %1\" : : \"a\"(v), \"Nd\"(port)); }\n");
  w_s(&mut out, "static inline uint8_t bst_inb(uint16_t port) { uint8_t v; __asm__ volatile (\"inb %1, %0\" : \"=a\"(v) : \"Nd\"(port)); return v; }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "#define BST_COM1 0x3F8\n");
  w_s(&mut out, "static void bst_serial_init(void) {\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 1, 0x00);   /* interrupts off while configuring */\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 3, 0x80);   /* DLAB on */\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 0, 0x01);   /* 115200 baud */\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 1, 0x00);\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 3, 0x03);   /* 8N1 */\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 2, 0xC7);   /* FIFO on */\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 4, 0x0B);   /* DTR, RTS, OUT2 (routes the IRQ line) */\n");
  w_s(&mut out, "    bst_outb(BST_COM1 + 1, 0x01);   /* interrupt on received data */\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    while ((bst_inb(BST_COM1 + 5) & 0x20) == 0) { }\n");
  w_s(&mut out, "    bst_outb(BST_COM1, (uint8_t)b);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    while ((bst_inb(BST_COM1 + 5) & 0x01) == 0) { __asm__ volatile (\"pause\"); }\n");
  w_s(&mut out, "    return bst_inb(BST_COM1);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_serial_poll(bst_serial s) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    return (bst_inb(BST_COM1 + 5) & 0x01) ? bst_inb(BST_COM1) : 256;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "static void bst_halt(void) { for (;;) __asm__ volatile (\"cli; hlt\"); }\n");
  w_s(&mut out, "static void bst_puts(const char *m) { for (; *m; m++) bst_serial_write(0, (unsigned char)*m); }\n");
  w_s(&mut out, "static void bst_puthex(uint64_t v) {\n");
  w_s(&mut out, "    bst_puts(\"0x\");\n");
  w_s(&mut out, "    for (int i = 60; i >= 0; i -= 4) bst_serial_write(0, (unsigned char)\"0123456789abcdef\"[(v >> i) & 15]);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Memory for Buf: a fixed arena with an exact-size free list, then the\n");
  w_s(&mut out, " * extension bst_pool_init carves from RAM (an eighth of the pool, at least 4 MiB), so\n");
  w_s(&mut out, " * the kernel's own tables can grow with the machine. */\n");
  w_s(&mut out, "#define BST_ARENA_WORDS (1u << 20)   /* 8 MiB */\n");
  w_s(&mut out, "static uint64_t bst_arena[BST_ARENA_WORDS];\n");
  w_s(&mut out, "static uint64_t bst_arena_top = 0;\n");
  w_s(&mut out, "static uint64_t *bst_arena2, bst_arena2_words, bst_arena2_top;\n");
  w_s(&mut out, "typedef struct bst_free { uint64_t words; struct bst_free *next; } bst_free_t;\n");
  w_s(&mut out, "static bst_free_t *bst_free_list = 0;           /* blocks of BST_BINS words or more */\n");
  w_s(&mut out, "#define BST_BINS 1024\n");
  w_s(&mut out, "static bst_free_t *bst_bin[BST_BINS];        /* exact-size free lists: pop in O(1) */\n");
  w_s(&mut out, "static uint64_t bst_arena_lock;              /* every processor allocates from the one arena */\n");
  w_s(&mut out, "/* An empty buffer with no memory when the arena is full. */\n");
  w_s(&mut out, "static bst_buf bst_try_alloc(uint64_t n) {\n");
  w_s(&mut out, "    uint64_t words = (n ? n : 1) + 1;            /* one header word for the size */\n");
  w_s(&mut out, "    if (words < 2) words = 2;\n");
  w_s(&mut out, "    uint64_t *blk = 0;\n");
  w_s(&mut out, "    bst_lock_acquire(&bst_arena_lock);\n");
  w_s(&mut out, "    if (words < BST_BINS) {\n");
  w_s(&mut out, "        bst_free_t *f = bst_bin[words];\n");
  w_s(&mut out, "        if (f) {\n");
  w_s(&mut out, "            bst_bin[words] = f->next;\n");
  w_s(&mut out, "            blk = (uint64_t *)f;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    } else {\n");
  w_s(&mut out, "        bst_free_t **pp = &bst_free_list;\n");
  w_s(&mut out, "        for (bst_free_t *f = bst_free_list; f; pp = &f->next, f = f->next) {\n");
  w_s(&mut out, "            if (f->words == words) {\n");
  w_s(&mut out, "                *pp = f->next;\n");
  w_s(&mut out, "                blk = (uint64_t *)f;\n");
  w_s(&mut out, "                break;\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (!blk && bst_arena_top + words <= BST_ARENA_WORDS) {\n");
  w_s(&mut out, "        blk = &bst_arena[bst_arena_top];\n");
  w_s(&mut out, "        bst_arena_top += words;\n");
  w_s(&mut out, "        blk[0] = words;\n");
  w_s(&mut out, "    } else if (!blk && words <= bst_arena2_words - bst_arena2_top) {\n");
  w_s(&mut out, "        blk = &bst_arena2[bst_arena2_top];\n");
  w_s(&mut out, "        bst_arena2_top += words;\n");
  w_s(&mut out, "        blk[0] = words;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_lock_release(&bst_arena_lock);\n");
  w_s(&mut out, "    if (!blk) { bst_buf none = { 0, 0 }; return none; }\n");
  w_s(&mut out, "    uint64_t *z = blk + 1, zc = words - 1;       /* rep stosq: one string store, not a word at a time */\n");
  w_s(&mut out, "    __asm__ volatile (\"rep stosq\" : \"+D\"(z), \"+c\"(zc) : \"a\"(0) : \"memory\");\n");
  w_s(&mut out, "    bst_buf b = { n, blk + 1 };\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf b = bst_try_alloc(n);\n");
  w_s(&mut out, "    if (!b.data) { bst_puts(\"bastio: out of memory\\n\"); bst_halt(); }\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_free(bst_buf b) {\n");
  w_s(&mut out, "    if (!b.data) return;\n");
  w_s(&mut out, "    uint64_t *blk = b.data - 1;\n");
  w_s(&mut out, "    bst_free_t *f = (bst_free_t *)blk;\n");
  w_s(&mut out, "    bst_lock_acquire(&bst_arena_lock);\n");
  w_s(&mut out, "    f->words = blk[0];\n");
  w_s(&mut out, "    if (f->words < BST_BINS) {\n");
  w_s(&mut out, "        f->next = bst_bin[f->words];\n");
  w_s(&mut out, "        bst_bin[f->words] = f;\n");
  w_s(&mut out, "    } else {\n");
  w_s(&mut out, "        f->next = bst_free_list;\n");
  w_s(&mut out, "        bst_free_list = f;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_lock_release(&bst_arena_lock);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_print(uint64_t v) {\n");
  w_s(&mut out, "    char d[20]; int n = 0;\n");
  w_s(&mut out, "    do { d[n++] = (char)('0' + v % 10); v /= 10; } while (v);\n");
  w_s(&mut out, "    while (n) bst_serial_write(0, (unsigned char)d[--n]);\n");
  w_s(&mut out, "    bst_serial_write(0, '\\n');\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Physical pages: every available run of RAM in the Multiboot memory map\n");
  w_s(&mut out, " * (flags bit 6; without one, mem_upper's, bit 0) from the end of the kernel\n");
  w_s(&mut out, " * image up to bst_ram_limit, where the platform's identity map of RAM stops\n");
  w_s(&mut out, " * (1 GiB, the least the boot code maps, if the platform does not define\n");
  w_s(&mut out, " * it), at most 2^27 pages (512 GiB: the kernel's first top-level slot).\n");
  w_s(&mut out, " * Where the linker script names the image's start (_image_start), the runs\n");
  w_s(&mut out, " * from 1 MiB up to it are in the pool as well. The pages the information,\n");
  w_s(&mut out, " * the map and the command line sit in are left out of every run.\n");
  w_s(&mut out, " * Runs that touch are merged; past BST_RUNS the rest are left out. Page ids\n");
  w_s(&mut out, " * are dense over the runs (bst_page_at, bst_frame_id), so holes such as the\n");
  w_s(&mut out, " * PCI one below 4 GiB have none. A map outside the first 1 GiB is not read.\n");
  w_s(&mut out, " * The front of the run that holds them is carved off for the pool's\n");
  w_s(&mut out, " * bookkeeping: two 32-bit counters a page (leases, shared references) and\n");
  w_s(&mut out, " * the arena's extension of an eighth of the pool (at least 4 MiB). */\n");
  w_s(&mut out, "extern char _end[];\n");
  w_s(&mut out, "/* Where the image starts, if the linker script says: the runs of RAM from\n");
  w_s(&mut out, " * 1 MiB up to it join the pool, since nothing else uses them. */\n");
  w_s(&mut out, "extern char _image_start[] __attribute__((weak));\n");
  w_s(&mut out, "extern uint64_t bst_kernel_pml4[512];\n");
  w_s(&mut out, "extern uint64_t bst_ram_limit __attribute__((weak));\n");
  w_s(&mut out, "#define BST_RUNS 32\n");
  w_s(&mut out, "#define BST_FRAME_LIMIT (1ull << 27)\n");
  w_s(&mut out, "static uint64_t bst_run_at[BST_RUNS], bst_run_id[BST_RUNS + 1], bst_runs;\n");
  w_s(&mut out, "static uint32_t *bst_pt_leases, *bst_shared_refs;\n");
  w_s(&mut out, "static uint64_t bst_carved_lo, bst_carved_hi;\n");
  w_s(&mut out, "static uint64_t bst_mbi;\n");
  w_s(&mut out, "/* Adds [a, b) to the n sorted runs lo/hi, merging the ones it touches. */\n");
  w_s(&mut out, "static uint64_t bst_run_put(uint64_t *lo, uint64_t *hi, uint64_t n, uint64_t a, uint64_t b) {\n");
  w_s(&mut out, "    uint64_t m = 0;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        if (hi[k] < a || b < lo[k]) { lo[m] = lo[k]; hi[m] = hi[k]; m++; }\n");
  w_s(&mut out, "        else { if (lo[k] < a) a = lo[k]; if (hi[k] > b) b = hi[k]; }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (m == BST_RUNS) return m;\n");
  w_s(&mut out, "    uint64_t k = m;\n");
  w_s(&mut out, "    while (k > 0 && lo[k - 1] > a) { lo[k] = lo[k - 1]; hi[k] = hi[k - 1]; k--; }\n");
  w_s(&mut out, "    lo[k] = a; hi[k] = b;\n");
  w_s(&mut out, "    return m + 1;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Takes [a, b) (to whole pages) out of the n runs lo/hi, splitting one if the\n");
  w_s(&mut out, " * hole is inside it (the lower part only, when the table is full). */\n");
  w_s(&mut out, "static uint64_t bst_run_cut(uint64_t *lo, uint64_t *hi, uint64_t n, uint64_t a, uint64_t b) {\n");
  w_s(&mut out, "    a &= ~4095ull;\n");
  w_s(&mut out, "    b = (b + 4095) & ~4095ull;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        if (b <= lo[k] || hi[k] <= a) continue;\n");
  w_s(&mut out, "        if (a <= lo[k] && hi[k] <= b) {\n");
  w_s(&mut out, "            for (uint64_t j = k + 1; j < n; j++) { lo[j - 1] = lo[j]; hi[j - 1] = hi[j]; }\n");
  w_s(&mut out, "            n--;\n");
  w_s(&mut out, "            k--;\n");
  w_s(&mut out, "        } else if (a <= lo[k]) {\n");
  w_s(&mut out, "            lo[k] = b;\n");
  w_s(&mut out, "        } else if (b >= hi[k]) {\n");
  w_s(&mut out, "            hi[k] = a;\n");
  w_s(&mut out, "        } else {\n");
  w_s(&mut out, "            if (n < BST_RUNS) {\n");
  w_s(&mut out, "                for (uint64_t j = n; j > k + 1; j--) { lo[j] = lo[j - 1]; hi[j] = hi[j - 1]; }\n");
  w_s(&mut out, "                lo[k + 1] = b;\n");
  w_s(&mut out, "                hi[k + 1] = hi[k];\n");
  w_s(&mut out, "                n++;\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            hi[k] = a;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return n;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_pool bst_pool_init(uint64_t mbi) {\n");
  w_s(&mut out, "    uint32_t *info = (uint32_t *)mbi;\n");
  w_s(&mut out, "    uint64_t base = ((uint64_t)_end + 4095) & ~4095ull;\n");
  w_s(&mut out, "    uint64_t limit = &bst_ram_limit ? bst_ram_limit : (1ull << 30);\n");
  w_s(&mut out, "    if (limit > (1ull << 39)) limit = 1ull << 39;\n");
  w_s(&mut out, "    uint64_t lo[BST_RUNS], hi[BST_RUNS], n = 0;\n");
  w_s(&mut out, "    if (info && (info[0] & 64) && (uint64_t)info[12] + info[11] <= (1ull << 30)) {\n");
  w_s(&mut out, "        uint8_t *e = (uint8_t *)(uint64_t)info[12], *stop = e + info[11];\n");
  w_s(&mut out, "        while (e + 24 <= stop && *(uint32_t *)e >= 20) {\n");
  w_s(&mut out, "            uint64_t a = *(uint64_t *)(e + 4), len = *(uint64_t *)(e + 12), b = a + len;\n");
  w_s(&mut out, "            if (b < a) b = ~0ull;\n");
  w_s(&mut out, "            if (b > limit) b = limit;\n");
  w_s(&mut out, "            if (&_image_start && *(uint32_t *)(e + 20) == 1 && a < (uint64_t)_image_start) {\n");
  w_s(&mut out, "                /* Below the image: from 1 MiB (the first holds the BIOS data and the\n");
  w_s(&mut out, "                 * processors' start-up code) to the image. */\n");
  w_s(&mut out, "                uint64_t la = a < (1ull << 20) ? (1ull << 20) : a, lb = b < (uint64_t)_image_start ? b : (uint64_t)_image_start;\n");
  w_s(&mut out, "                la = (la + 4095) & ~4095ull;\n");
  w_s(&mut out, "                lb &= ~4095ull;\n");
  w_s(&mut out, "                if (la < lb) n = bst_run_put(lo, hi, n, la, lb);\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            if (a < base) a = base;\n");
  w_s(&mut out, "            if (*(uint32_t *)(e + 20) == 1 && a < b) {\n");
  w_s(&mut out, "                a = (a + 4095) & ~4095ull;\n");
  w_s(&mut out, "                b &= ~4095ull;\n");
  w_s(&mut out, "                if (a < b) n = bst_run_put(lo, hi, n, a, b);\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            e += (uint64_t)*(uint32_t *)e + 4;    /* not in 32 bits: 0xFFFFFFFC + 4 would stay put */\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        /* What the loader left in RAM and the kernel reads later: the information,\n");
  w_s(&mut out, "         * the map and the command line. */\n");
  w_s(&mut out, "        n = bst_run_cut(lo, hi, n, mbi, mbi + 128);\n");
  w_s(&mut out, "        n = bst_run_cut(lo, hi, n, info[12], (uint64_t)info[12] + info[11]);\n");
  w_s(&mut out, "        if ((info[0] & 4) && info[4] && info[4] < (1ull << 30)) {\n");
  w_s(&mut out, "            uint64_t cl = 0;\n");
  w_s(&mut out, "            while (cl < 4096 && ((uint8_t *)(uint64_t)info[4])[cl]) cl++;\n");
  w_s(&mut out, "            n = bst_run_cut(lo, hi, n, info[4], (uint64_t)info[4] + cl + 1);\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    } else {\n");
  w_s(&mut out, "        uint64_t b = 64ull << 20;\n");
  w_s(&mut out, "        if (info && (info[0] & 1)) b = (1ull << 20) + ((uint64_t)info[2] << 10);\n");
  w_s(&mut out, "        if (b > limit) b = limit;\n");
  w_s(&mut out, "        b &= ~4095ull;\n");
  w_s(&mut out, "        if (base < b) n = bst_run_put(lo, hi, n, base, b);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    /* At most 2^27 pages: the top runs go first. */\n");
  w_s(&mut out, "    uint64_t pages = 0;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        if (pages + (hi[k] - lo[k]) / 4096 > BST_FRAME_LIMIT) hi[k] = lo[k] + (BST_FRAME_LIMIT - pages) * 4096;\n");
  w_s(&mut out, "        pages += (hi[k] - lo[k]) / 4096;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    /* The bookkeeping, from the first run with room (the arena extension\n");
  w_s(&mut out, "     * only if there is room for it too). */\n");
  w_s(&mut out, "    uint64_t counters = (pages * 8 + 4095) / 4096, ext = pages / 8, r = n;\n");
  w_s(&mut out, "    if (ext < 1024) ext = pages / 8 < 1024 ? pages / 8 : 1024;   /* at least 4 MiB, at most an eighth */\n");
  w_s(&mut out, "    for (int tries = 0; tries < 2 && r == n; tries++) {\n");
  w_s(&mut out, "        if (tries) ext = 0;\n");
  w_s(&mut out, "        for (r = 0; r < n && (hi[r] - lo[r]) / 4096 <= counters + ext; r++) {}\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_pool p;\n");
  w_s(&mut out, "    p.base = base;\n");
  w_s(&mut out, "    p.size = 0;\n");
  w_s(&mut out, "    if (r == n) return p;          /* no room even for the counters: no pages */\n");
  w_s(&mut out, "    uint64_t *w = (uint64_t *)lo[r];\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < counters * 512; k++) w[k] = 0;\n");
  w_s(&mut out, "    bst_pt_leases = (uint32_t *)lo[r];\n");
  w_s(&mut out, "    bst_shared_refs = (uint32_t *)lo[r] + pages;\n");
  w_s(&mut out, "    bst_arena2 = (uint64_t *)(lo[r] + counters * 4096);\n");
  w_s(&mut out, "    bst_arena2_words = ext * 512;\n");
  w_s(&mut out, "    bst_carved_lo = lo[r];\n");
  w_s(&mut out, "    bst_carved_hi = lo[r] + (counters + ext) * 4096;\n");
  w_s(&mut out, "    lo[r] = bst_carved_hi;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        bst_run_at[k] = lo[k];\n");
  w_s(&mut out, "        bst_run_id[k + 1] = bst_run_id[k] + (hi[k] - lo[k]) / 4096;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_runs = n;\n");
  w_s(&mut out, "    p.base = lo[0];\n");
  w_s(&mut out, "    p.size = bst_run_id[n];\n");
  w_s(&mut out, "    return p;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The device window overlaps RAM above 2 GiB: claiming pool RAM (or the\n");
  w_s(&mut out, " * pool's bookkeeping) as registers would alias pages the proofs hand out,\n");
  w_s(&mut out, " * so such a claim stops the machine. Firmware never puts a device there. */\n");
  w_s(&mut out, "static void bst_mmio_check(uint64_t b, uint64_t l) {\n");
  w_s(&mut out, "    int bad = l && b < bst_carved_hi && bst_carved_lo < b + l;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < bst_runs; k++) {\n");
  w_s(&mut out, "        uint64_t lo = bst_run_at[k], hi = lo + (bst_run_id[k + 1] - bst_run_id[k]) * 4096;\n");
  w_s(&mut out, "        if (l && b < hi && lo < b + l) bad = 1;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (bad) { bst_puts(\"bastio: mmio_claim of RAM at \"); bst_puthex(b); bst_puts(\"\\n\"); bst_halt(); }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define BST_MMIO_CHECK(b, l) bst_mmio_check(b, l)\n");
  w_s(&mut out, "#define BST_PT_NEW_HOOK if (level == 4) e[0] = ((uint64_t)bst_kernel_pml4[0] & BST_PTE_ADDR) | BST_PTE_P | BST_PTE_W;\n");
}

fn cg_prelude_bytes_arena(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static bst_bytes bst_balloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf w = bst_alloc((n + 7) / 8);\n");
  w_s(&mut out, "    bst_bytes b = { n, (unsigned char *)w.data };\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_bytes bst_try_balloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf w = bst_try_alloc((n + 7) / 8);\n");
  w_s(&mut out, "    bst_bytes b = { w.data ? n : 0, (unsigned char *)w.data };\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_bfree(bst_bytes b) {\n");
  w_s(&mut out, "    bst_buf w = { (b.len + 7) / 8, (uint64_t *)b.data };\n");
  w_s(&mut out, "    bst_free(w);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Grow a block of `old` words to `n` words, keeping its contents. */\n");
  w_s(&mut out, "static uint64_t *bst_copy_over(uint64_t *q, uint64_t *p, uint64_t old) {\n");
  w_s(&mut out, "    if (q && p) {\n");
  w_s(&mut out, "        for (uint64_t i = 0; i < old; i++) q[i] = p[i];\n");
  w_s(&mut out, "        bst_buf b = { old, p };\n");
  w_s(&mut out, "        bst_free(b);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return q;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t *bst_regrow(uint64_t *p, uint64_t old, uint64_t n) {\n");
  w_s(&mut out, "    return bst_copy_over(bst_alloc(n).data, p, old);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t *bst_try_regrow(uint64_t *p, uint64_t old, uint64_t n) {\n");
  w_s(&mut out, "    return bst_copy_over(bst_try_alloc(n).data, p, old);\n");
  w_s(&mut out, "}\n");
}

fn cg_prelude_child(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "#include <unistd.h>\n");
  w_s(&mut out, "#include <fcntl.h>\n");
  w_s(&mut out, "#include <signal.h>\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "#define WIN32_LEAN_AND_MEAN\n");
  w_s(&mut out, "#include <windows.h>\n");
  w_s(&mut out, "#include <io.h>\n");
  w_s(&mut out, "#include <process.h>\n");
  w_s(&mut out, "/* The parent's ends of the pipes are not inherited (_O_NOINHERIT), so closing\n");
  w_s(&mut out, " * a child's input reaches it as end of file. */\n");
  w_s(&mut out, "#define pipe(p) _pipe((p), 65536, _O_BINARY | _O_NOINHERIT)\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "#include <sys/wait.h>\n");
  w_s(&mut out, "#include <spawn.h>\n");
  w_s(&mut out, "extern char **environ;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "typedef struct { intptr_t pid; int in; FILE *out; } bst_child;\n");
  w_s(&mut out, "/* A child that cannot be started (no such program, no pipes or processes\n");
  w_s(&mut out, " * left) behaves like one that exited with 127 without output, which is\n");
  w_s(&mut out, " * what a failed exec in the child looks like anyway. */\n");
  w_s(&mut out, "static bst_child bst_host_spawn(bst_host h, bst_vec argv) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    bst_child c = { -1, -1, NULL };\n");
  w_s(&mut out, "    int to[2], from[2];\n");
  w_s(&mut out, "    if (argv.len == 0 || pipe(to) != 0) return c;\n");
  w_s(&mut out, "    if (pipe(from) != 0) { close(to[0]); close(to[1]); return c; }\n");
  w_s(&mut out, "#ifndef _WIN32\n");
  w_s(&mut out, "    /* The parent's ends are not inherited by later children, so closing a\n");
  w_s(&mut out, "     * child's input reaches it as end of file. */\n");
  w_s(&mut out, "    fcntl(to[1], F_SETFD, FD_CLOEXEC);\n");
  w_s(&mut out, "    fcntl(from[0], F_SETFD, FD_CLOEXEC);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    char **av = (char **)malloc((argv.len + 1) * sizeof(char *));\n");
  w_s(&mut out, "    if (!av) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    for (uint64_t i = 0; i < argv.len; i++) av[i] = bst_cpath(((bst_bytes *)argv.data)[i]);\n");
  w_s(&mut out, "    av[argv.len] = NULL;\n");
  w_s(&mut out, "    fflush(NULL);\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    /* CreateProcess with the child's ends as its standard handles, made\n");
  w_s(&mut out, "     * inheritable only while it starts. */\n");
  w_s(&mut out, "    intptr_t pid = -1;\n");
  w_s(&mut out, "    {\n");
  w_s(&mut out, "        size_t cap = 1;\n");
  w_s(&mut out, "        for (uint64_t i = 0; i < argv.len; i++) cap += 2 * strlen(av[i]) + 3;\n");
  w_s(&mut out, "        char *cl = (char *)malloc(cap), *w = cl;\n");
  w_s(&mut out, "        if (!cl) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        for (uint64_t i = 0; i < argv.len; i++) {\n");
  w_s(&mut out, "            const char *a = av[i];\n");
  w_s(&mut out, "            int q = !*a || strpbrk(a, \" \\t\\\"\") != NULL;\n");
  w_s(&mut out, "            if (i) *w++ = ' ';\n");
  w_s(&mut out, "            if (q) *w++ = '\"';\n");
  w_s(&mut out, "            size_t b = 0;\n");
  w_s(&mut out, "            for (; *a; a++) {\n");
  w_s(&mut out, "                if (*a == '\\\\') { b++; continue; }\n");
  w_s(&mut out, "                if (*a == '\"') b = 2 * b + 1;\n");
  w_s(&mut out, "                for (; b; b--) *w++ = '\\\\';\n");
  w_s(&mut out, "                *w++ = *a;\n");
  w_s(&mut out, "            }\n");
  w_s(&mut out, "            for (b = q ? 2 * b : b; b; b--) *w++ = '\\\\';\n");
  w_s(&mut out, "            if (q) *w++ = '\"';\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        *w = 0;\n");
  w_s(&mut out, "        HANDLE hin = (HANDLE)_get_osfhandle(to[0]), hout = (HANDLE)_get_osfhandle(from[1]);\n");
  w_s(&mut out, "        SetHandleInformation(hin, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT);\n");
  w_s(&mut out, "        SetHandleInformation(hout, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT);\n");
  w_s(&mut out, "        STARTUPINFOA si;\n");
  w_s(&mut out, "        PROCESS_INFORMATION pi;\n");
  w_s(&mut out, "        memset(&si, 0, sizeof si);\n");
  w_s(&mut out, "        si.cb = sizeof si;\n");
  w_s(&mut out, "        si.dwFlags = STARTF_USESTDHANDLES;\n");
  w_s(&mut out, "        si.hStdInput = hin;\n");
  w_s(&mut out, "        si.hStdOutput = hout;\n");
  w_s(&mut out, "        si.hStdError = GetStdHandle(STD_ERROR_HANDLE);\n");
  w_s(&mut out, "        if (CreateProcessA(NULL, cl, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) {\n");
  w_s(&mut out, "            CloseHandle(pi.hThread);\n");
  w_s(&mut out, "            pid = (intptr_t)pi.hProcess;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        SetHandleInformation(hin, HANDLE_FLAG_INHERIT, 0);\n");
  w_s(&mut out, "        SetHandleInformation(hout, HANDLE_FLAG_INHERIT, 0);\n");
  w_s(&mut out, "        free(cl);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    /* posix_spawn, not fork: the parent's memory is never copied, which a\n");
  w_s(&mut out, "     * kernel without copy-on-write (BastiOS) cannot do for a large one.\n");
  w_s(&mut out, "     * The parent's ends are close-on-exec already. */\n");
  w_s(&mut out, "    int pid = -1;\n");
  w_s(&mut out, "    posix_spawn_file_actions_t fa;\n");
  w_s(&mut out, "    if (posix_spawn_file_actions_init(&fa) == 0) {\n");
  w_s(&mut out, "        if (posix_spawn_file_actions_adddup2(&fa, to[0], 0) != 0 ||\n");
  w_s(&mut out, "            posix_spawn_file_actions_adddup2(&fa, from[1], 1) != 0 ||\n");
  w_s(&mut out, "            posix_spawn_file_actions_addclose(&fa, to[0]) != 0 ||\n");
  w_s(&mut out, "            posix_spawn_file_actions_addclose(&fa, from[1]) != 0 ||\n");
  w_s(&mut out, "            posix_spawnp(&pid, av[0], &fa, NULL, av, environ) != 0) pid = -1;\n");
  w_s(&mut out, "        posix_spawn_file_actions_destroy(&fa);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    for (uint64_t i = 0; i < argv.len; i++) free(av[i]);\n");
  w_s(&mut out, "    free(av);\n");
  w_s(&mut out, "    close(to[0]);\n");
  w_s(&mut out, "    close(from[1]);\n");
  w_s(&mut out, "    if (pid < 0) { close(to[1]); close(from[0]); return c; }\n");
  w_s(&mut out, "#ifdef SIGPIPE\n");
  w_s(&mut out, "    signal(SIGPIPE, SIG_IGN);   /* writing to a child that has exited fails instead */\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    c.pid = pid;\n");
  w_s(&mut out, "    c.in = to[1];\n");
  w_s(&mut out, "    c.out = fdopen(from[0], \"rb\");\n");
  w_s(&mut out, "    if (!c.out) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    return c;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bool bst_child_write(bst_child *c, bst_bytes d) {\n");
  w_s(&mut out, "    if (c->in < 0) return false;\n");
  w_s(&mut out, "    uint64_t n = 0;\n");
  w_s(&mut out, "    while (n < d.len) {\n");
  w_s(&mut out, "        ssize_t w = write(c->in, d.data + n, d.len - n);\n");
  w_s(&mut out, "        if (w <= 0) return false;\n");
  w_s(&mut out, "        n += (uint64_t)w;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return true;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_child_close(bst_child *c) {\n");
  w_s(&mut out, "    if (c->in >= 0) { close(c->in); c->in = -1; }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bool bst_child_read_line(bst_child *c, bst_bytes *out) {\n");
  w_s(&mut out, "    if (!c->out) return false;\n");
  w_s(&mut out, "    size_t cap = 64, n = 0;\n");
  w_s(&mut out, "    unsigned char *d = (unsigned char *)malloc(cap);\n");
  w_s(&mut out, "    if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "    int ch;\n");
  w_s(&mut out, "    while ((ch = getc(c->out)) != EOF && ch != '\\n') {\n");
  w_s(&mut out, "        if (n == cap) {\n");
  w_s(&mut out, "            cap *= 2;\n");
  w_s(&mut out, "            d = (unsigned char *)realloc(d, cap);\n");
  w_s(&mut out, "            if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        d[n++] = (unsigned char)ch;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (ch == EOF && n == 0) { free(d); return false; }\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    if (n && d[n - 1] == '\\r') n--;   /* Windows tools end their lines with CRLF */\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    free(out->data);\n");
  w_s(&mut out, "    out->len = n;\n");
  w_s(&mut out, "    out->data = d;\n");
  w_s(&mut out, "    return true;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_child_wait(bst_child c) {\n");
  w_s(&mut out, "    bst_child_close(&c);\n");
  w_s(&mut out, "    if (c.out) fclose(c.out);\n");
  w_s(&mut out, "    if (c.pid < 0) return 127;\n");
  w_s(&mut out, "    int st;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    if (_cwait(&st, c.pid, 0) < 0) return 255;\n");
  w_s(&mut out, "    return (uint64_t)(unsigned)st;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    while (waitpid((pid_t)c.pid, &st, 0) < 0) {}\n");
  w_s(&mut out, "    if (WIFEXITED(st)) return (uint64_t)WEXITSTATUS(st);\n");
  w_s(&mut out, "    if (WIFSIGNALED(st)) return 128 + (uint64_t)WTERMSIG(st);\n");
  w_s(&mut out, "    return 255;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The environment variable `name`, if it is set. */\n");
  w_s(&mut out, "static bool bst_host_env(bst_host h, bst_str name, bst_bytes *out) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "    char *c = bst_cpath((bst_bytes){ name.len, (unsigned char *)name.data });\n");
  w_s(&mut out, "    const char *v = getenv(c);\n");
  w_s(&mut out, "    free(c);\n");
  w_s(&mut out, "    if (!v) return false;\n");
  w_s(&mut out, "    size_t n = strlen(v);\n");
  w_s(&mut out, "    bst_bytes b = bst_balloc(n);\n");
  w_s(&mut out, "    memcpy(b.data, v, n);\n");
  w_s(&mut out, "    free(out->data);\n");
  w_s(&mut out, "    *out = b;\n");
  w_s(&mut out, "    return true;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The number of processors online (at least 1). */\n");
  w_s(&mut out, "#if defined(__APPLE__) && !defined(_SC_NPROCESSORS_ONLN)\n");
  w_s(&mut out, "#define _SC_NPROCESSORS_ONLN 58 /* -std=c11 hides it from <unistd.h> */\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static uint64_t bst_host_cpus(bst_host h) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    const char *e = getenv(\"NUMBER_OF_PROCESSORS\");\n");
  w_s(&mut out, "    long n = e ? atol(e) : 1;\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    long n = sysconf(_SC_NPROCESSORS_ONLN);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "    return n < 1 ? 1 : (uint64_t)n;\n");
  w_s(&mut out, "}\n");
}

/// The prelude part for `host_net`, which stage0 does not have: added after the
/// hosted prelude, and only to a program that calls it.
fn cg_prelude_net(out: &mut Vec[u64]) {
  w_s(&mut out, "#ifndef _WIN32\n");
  w_s(&mut out, "#include <sys/socket.h>\n");
  w_s(&mut out, "#include <netinet/in.h>\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "/* Winsock, loaded when first used (no import library to link): sockets are\n");
  w_s(&mut out, " * handles, a read is a recv and a close is a closesocket. */\n");
  w_s(&mut out, "typedef uintptr_t bst_sock;\n");
  w_s(&mut out, "static struct {\n");
  w_s(&mut out, "    int state;   /* 0 not tried, 1 ready, -1 failed */\n");
  w_s(&mut out, "    bst_sock (__stdcall *socket)(int, int, int);\n");
  w_s(&mut out, "    int (__stdcall *bind)(bst_sock, const void *, int);\n");
  w_s(&mut out, "    int (__stdcall *listen)(bst_sock, int);\n");
  w_s(&mut out, "    bst_sock (__stdcall *accept)(bst_sock, void *, int *);\n");
  w_s(&mut out, "    int (__stdcall *connect)(bst_sock, const void *, int);\n");
  w_s(&mut out, "    int (__stdcall *recv)(bst_sock, char *, int, int);\n");
  w_s(&mut out, "    int (__stdcall *send)(bst_sock, const char *, int, int);\n");
  w_s(&mut out, "    int (__stdcall *closesocket)(bst_sock);\n");
  w_s(&mut out, "    int (__stdcall *getsockname)(bst_sock, void *, int *);\n");
  w_s(&mut out, "} bst_ws;\n");
  w_s(&mut out, "static int bst_ws_init(void) {\n");
  w_s(&mut out, "    if (bst_ws.state) return bst_ws.state > 0;\n");
  w_s(&mut out, "    bst_ws.state = -1;\n");
  w_s(&mut out, "    HMODULE m = LoadLibraryA(\"ws2_32.dll\");\n");
  w_s(&mut out, "    if (!m) return 0;\n");
  w_s(&mut out, "    int (__stdcall *start)(unsigned short, void *) = (int (__stdcall *)(unsigned short, void *))(void *)GetProcAddress(m, \"WSAStartup\");\n");
  w_s(&mut out, "    bst_ws.socket = (bst_sock (__stdcall *)(int, int, int))(void *)GetProcAddress(m, \"socket\");\n");
  w_s(&mut out, "    bst_ws.bind = (int (__stdcall *)(bst_sock, const void *, int))(void *)GetProcAddress(m, \"bind\");\n");
  w_s(&mut out, "    bst_ws.listen = (int (__stdcall *)(bst_sock, int))(void *)GetProcAddress(m, \"listen\");\n");
  w_s(&mut out, "    bst_ws.accept = (bst_sock (__stdcall *)(bst_sock, void *, int *))(void *)GetProcAddress(m, \"accept\");\n");
  w_s(&mut out, "    bst_ws.connect = (int (__stdcall *)(bst_sock, const void *, int))(void *)GetProcAddress(m, \"connect\");\n");
  w_s(&mut out, "    bst_ws.recv = (int (__stdcall *)(bst_sock, char *, int, int))(void *)GetProcAddress(m, \"recv\");\n");
  w_s(&mut out, "    bst_ws.send = (int (__stdcall *)(bst_sock, const char *, int, int))(void *)GetProcAddress(m, \"send\");\n");
  w_s(&mut out, "    bst_ws.closesocket = (int (__stdcall *)(bst_sock))(void *)GetProcAddress(m, \"closesocket\");\n");
  w_s(&mut out, "    bst_ws.getsockname = (int (__stdcall *)(bst_sock, void *, int *))(void *)GetProcAddress(m, \"getsockname\");\n");
  w_s(&mut out, "    char wsadata[512];\n");
  w_s(&mut out, "    if (!start || !bst_ws.socket || !bst_ws.bind || !bst_ws.listen || !bst_ws.accept || !bst_ws.connect\n");
  w_s(&mut out, "        || !bst_ws.recv || !bst_ws.send || !bst_ws.closesocket || !bst_ws.getsockname) return 0;\n");
  w_s(&mut out, "    if (start(0x0202, wsadata) != 0) return 0;\n");
  w_s(&mut out, "    bst_ws.state = 1;\n");
  w_s(&mut out, "    return 1;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_host_net_win(uint64_t op, uint64_t a, uint64_t b, bst_bytes *buf) {\n");
  w_s(&mut out, "    const bst_sock bad = ~(bst_sock)0;\n");
  w_s(&mut out, "    unsigned char sa[16];   /* sockaddr_in: family, port and address in network order */\n");
  w_s(&mut out, "    if (!bst_ws_init()) return ~(uint64_t)0;\n");
  w_s(&mut out, "    memset(sa, 0, sizeof sa);\n");
  w_s(&mut out, "    sa[0] = 2;\n");
  w_s(&mut out, "    sa[2] = (unsigned char)(b >> 8); sa[3] = (unsigned char)b;\n");
  w_s(&mut out, "    sa[4] = (unsigned char)(a >> 24); sa[5] = (unsigned char)(a >> 16); sa[6] = (unsigned char)(a >> 8); sa[7] = (unsigned char)a;\n");
  w_s(&mut out, "    if (op == 0 || op == 2) {\n");
  w_s(&mut out, "        bst_sock s = bst_ws.socket(2, 1, 0);\n");
  w_s(&mut out, "        if (s == bad) return ~(uint64_t)0;\n");
  w_s(&mut out, "        if (op == 0 ? (bst_ws.bind(s, sa, 16) != 0 || bst_ws.listen(s, 128) != 0) : bst_ws.connect(s, sa, 16) != 0) { bst_ws.closesocket(s); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        return (uint64_t)s;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 1) {\n");
  w_s(&mut out, "        bst_sock c = bst_ws.accept((bst_sock)a, NULL, NULL);\n");
  w_s(&mut out, "        return c == bad ? ~(uint64_t)0 : (uint64_t)c;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 3) {\n");
  w_s(&mut out, "        if (b > 0x7fffffffu) b = 0x7fffffffu;\n");
  w_s(&mut out, "        unsigned char *d = (unsigned char *)malloc(b ? b : 1);\n");
  w_s(&mut out, "        if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        int n = bst_ws.recv((bst_sock)a, (char *)d, (int)b, 0);\n");
  w_s(&mut out, "        if (n < 0) { free(d); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        free(buf->data);\n");
  w_s(&mut out, "        buf->len = (uint64_t)n;\n");
  w_s(&mut out, "        buf->data = d;\n");
  w_s(&mut out, "        return (uint64_t)n;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 4) {\n");
  w_s(&mut out, "        uint64_t n = buf->len > 0x7fffffffu ? 0x7fffffffu : buf->len;\n");
  w_s(&mut out, "        int r = bst_ws.send((bst_sock)a, (const char *)buf->data, (int)n, 0);\n");
  w_s(&mut out, "        return r < 0 ? ~(uint64_t)0 : (uint64_t)r;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 5) return bst_ws.closesocket((bst_sock)a) == 0 ? 0 : ~(uint64_t)0;\n");
  w_s(&mut out, "    if (op == 6) {\n");
  w_s(&mut out, "        int len = 16;\n");
  w_s(&mut out, "        if (bst_ws.getsockname((bst_sock)a, sa, &len) != 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "        return ((uint64_t)sa[2] << 8) | sa[3];\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return ~(uint64_t)0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "/* TCP over IPv4: `op` 0 listens on address `a` (host order), port `b` and returns the\n");
  w_s(&mut out, " * socket; 1 accepts a connection on socket `a`; 2 connects to address `a`, port `b`;\n");
  w_s(&mut out, " * 3 reads at most `b` bytes from socket `a` into `*buf` (replacing it; an empty\n");
  w_s(&mut out, " * result is end of file); 4 writes `*buf` to socket `a` and returns how many bytes\n");
  w_s(&mut out, " * went; 5 closes socket `a`; 6 returns the local port of socket `a`. The failure\n");
  w_s(&mut out, " * of any is 2^64 - 1. */\n");
  w_s(&mut out, "static uint64_t bst_host_net(bst_host h, uint64_t op, uint64_t a, uint64_t b, bst_bytes *buf) {\n");
  w_s(&mut out, "    (void)h;\n");
  w_s(&mut out, "#ifdef _WIN32\n");
  w_s(&mut out, "    return bst_host_net_win(op, a, b, buf);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    struct sockaddr_in sa;\n");
  w_s(&mut out, "    memset(&sa, 0, sizeof sa);\n");
  w_s(&mut out, "    sa.sin_family = AF_INET;\n");
  w_s(&mut out, "    sa.sin_port = htons((uint16_t)b);\n");
  w_s(&mut out, "    sa.sin_addr.s_addr = htonl((uint32_t)a);\n");
  w_s(&mut out, "    if (op == 0 || op == 2) {\n");
  w_s(&mut out, "        int fd = socket(AF_INET, SOCK_STREAM, 0);\n");
  w_s(&mut out, "        if (fd < 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "        if (op == 0) {\n");
  w_s(&mut out, "            int one = 1;\n");
  w_s(&mut out, "            setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);\n");
  w_s(&mut out, "            if (bind(fd, (struct sockaddr *)&sa, sizeof sa) != 0 || listen(fd, 128) != 0) { close(fd); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        } else if (connect(fd, (struct sockaddr *)&sa, sizeof sa) != 0) {\n");
  w_s(&mut out, "            close(fd);\n");
  w_s(&mut out, "            return ~(uint64_t)0;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "        return (uint64_t)fd;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 1) {\n");
  w_s(&mut out, "        int fd = accept((int)a, NULL, NULL);\n");
  w_s(&mut out, "        return fd < 0 ? ~(uint64_t)0 : (uint64_t)fd;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 3) {\n");
  w_s(&mut out, "        unsigned char *d = (unsigned char *)malloc(b ? b : 1);\n");
  w_s(&mut out, "        if (!d) { fputs(\"Bastio: out of memory\\n\", stderr); abort(); }\n");
  w_s(&mut out, "        ssize_t n = read((int)a, d, b);\n");
  w_s(&mut out, "        if (n < 0) { free(d); return ~(uint64_t)0; }\n");
  w_s(&mut out, "        free(buf->data);\n");
  w_s(&mut out, "        buf->len = (uint64_t)n;\n");
  w_s(&mut out, "        buf->data = d;\n");
  w_s(&mut out, "        return (uint64_t)n;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 4) {\n");
  w_s(&mut out, "#ifdef MSG_NOSIGNAL\n");
  w_s(&mut out, "        ssize_t n = send((int)a, buf->data, buf->len, MSG_NOSIGNAL);\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "        ssize_t n = send((int)a, buf->data, buf->len, 0);\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "        return n < 0 ? ~(uint64_t)0 : (uint64_t)n;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (op == 5) return close((int)a) == 0 ? 0 : ~(uint64_t)0;\n");
  w_s(&mut out, "    if (op == 6) {\n");
  w_s(&mut out, "        socklen_t len = sizeof sa;\n");
  w_s(&mut out, "        if (getsockname((int)a, (struct sockaddr *)&sa, &len) != 0) return ~(uint64_t)0;\n");
  w_s(&mut out, "        return (uint64_t)ntohs(sa.sin_port);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return ~(uint64_t)0;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
}

fn cg_prelude_bytes(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Box[T]: one allocation from the same allocator as Buf. */\n");
  w_s(&mut out, "static void *bst_box_alloc(uint64_t n) { return bst_alloc((n + 7) / 8).data; }\n");
  w_s(&mut out, "/* The same, or 0 when out of memory (try_box). */\n");
  w_s(&mut out, "static void *bst_box_try_alloc(uint64_t n) { return bst_try_alloc((n + 7) / 8).data; }\n");
  w_s(&mut out, "static void bst_box_free(void *p, uint64_t n) { bst_buf w = { (n + 7) / 8, (uint64_t *)p }; bst_free(w); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Vec[T]: elements in one allocation that doubles when full. A size past\n");
  w_s(&mut out, " * 2^60 bytes asks the allocator for more than it can give, so it aborts\n");
  w_s(&mut out, " * (out of memory), as `alloc` does. */\n");
  w_s(&mut out, "typedef struct { uint64_t len, cap; void *data; } bst_vec;\n");
  w_s(&mut out, "static void bst_vec_release(bst_vec v, uint64_t size) {\n");
  w_s(&mut out, "    if (v.data) { bst_buf b = { (v.cap * size + 7) / 8, (uint64_t *)v.data }; bst_free(b); }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_vec_grow(bst_vec *v, uint64_t size) {\n");
  w_s(&mut out, "    uint64_t ncap = v->cap ? v->cap * 2 : 4;\n");
  w_s(&mut out, "    uint64_t bytes = ncap > (UINT64_C(1) << 60) / size ? ~UINT64_C(0) - 8 : ncap * size;\n");
  w_s(&mut out, "    v->data = bst_regrow((uint64_t *)v->data, (v->cap * size + 7) / 8, (bytes + 7) / 8);\n");
  w_s(&mut out, "    v->cap = ncap;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* vec_try_reserve: room for k more elements, or false with the vector\n");
  w_s(&mut out, " * unchanged. The capacity stays at most 2^60 elements, as the prover\n");
  w_s(&mut out, " * assumes. */\n");
  w_s(&mut out, "static bool bst_vec_try_grow(bst_vec *v, uint64_t k, uint64_t size) {\n");
  w_s(&mut out, "    uint64_t lim = (UINT64_C(1) << 60) / size;\n");
  w_s(&mut out, "    if (k <= v->cap - v->len) return true;\n");
  w_s(&mut out, "    if (v->len > lim || k > lim - v->len) return false;\n");
  w_s(&mut out, "    uint64_t ncap = v->len + k;\n");
  w_s(&mut out, "    if (v->cap <= lim / 2 && v->cap * 2 > ncap) ncap = v->cap * 2;\n");
  w_s(&mut out, "    uint64_t *d = bst_try_regrow((uint64_t *)v->data, (v->cap * size + 7) / 8, (ncap * size + 7) / 8);\n");
  w_s(&mut out, "    if (!d) return false;\n");
  w_s(&mut out, "    v->data = d;\n");
  w_s(&mut out, "    v->cap = ncap;\n");
  w_s(&mut out, "    return true;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bset(bst_bytes *b, uint64_t i, uint64_t v) { b->data[i] = (unsigned char)v; }\n");
  w_s(&mut out, "/* Bulk copies. The prover has shown both ranges in bounds, so there are no\n");
  w_s(&mut out, " * checks. Kernels are built with -mgeneral-regs-only and no libc, so on\n");
  w_s(&mut out, " * x86-64 a forward copy is one rep movsb where the platform has set\n");
  w_s(&mut out, " * bst_copy_erms (CPUID.7:EBX bit 9: fast strings copy by whole cache\n");
  w_s(&mut out, " * lines, faster than rep movsq on a page), else rep movsq then rep movsb\n");
  w_s(&mut out, " * (an emulator runs rep movsb byte by byte). Nothing here calls memcpy or\n");
  w_s(&mut out, " * memmove. */\n");
  w_s(&mut out, "#if defined(__x86_64__)\n");
  w_s(&mut out, "uint8_t bst_copy_erms;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "static inline void bst_copy_fwd(unsigned char *d, const unsigned char *s, uint64_t n) {\n");
  w_s(&mut out, "#if defined(__x86_64__)\n");
  w_s(&mut out, "    if (!bst_copy_erms) {\n");
  w_s(&mut out, "        uint64_t w = n >> 3;\n");
  w_s(&mut out, "        __asm__ volatile (\"rep movsq\" : \"+D\"(d), \"+S\"(s), \"+c\"(w) : : \"memory\");\n");
  w_s(&mut out, "        n &= 7;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    __asm__ volatile (\"rep movsb\" : \"+D\"(d), \"+S\"(s), \"+c\"(n) : : \"memory\");\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) d[k] = s[k];\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Highest byte first, for an overlapping move to a higher address. Not\n");
  w_s(&mut out, " * std + rep movsb: an interrupt taken while the direction flag is set would\n");
  w_s(&mut out, " * run its handler with it set. The empty asm keeps the compiler from\n");
  w_s(&mut out, " * turning the loop into a call to memmove. */\n");
  w_s(&mut out, "static inline void bst_copy_back(unsigned char *d, const unsigned char *s, uint64_t n) {\n");
  w_s(&mut out, "    while (n > 0) { n--; d[n] = s[n]; __asm__ volatile (\"\" : : : \"memory\"); }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bcopy(bst_bytes *dst, uint64_t d, bst_bytes src, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd(dst->data + d, src.data + s, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bmove(bst_bytes *b, uint64_t d, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    if (n == 0) return;\n");
  w_s(&mut out, "    if (d <= s || d - s >= n) bst_copy_fwd(b->data + d, b->data + s, n);\n");
  w_s(&mut out, "    else bst_copy_back(b->data + d, b->data + s, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_bytes bst_bfrom(bst_str s) {\n");
  w_s(&mut out, "    bst_bytes b = bst_balloc(s.len);\n");
  w_s(&mut out, "    for (uint64_t i = 0; i < s.len; i++) b.data[i] = s.data[i];\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
}

fn cg_prelude_ports(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline bst_portio bst_port_claim(bst_ports *p, uint64_t b, uint64_t c) { (void)p; bst_portio io = { b, c }; return io; }\n");
  w_s(&mut out, "static inline void bst_port_release(bst_ports *p, bst_portio io) { (void)p; (void)io; }\n");
  w_s(&mut out, "static inline uint64_t bst_port_base(bst_portio io) { return io.base; }\n");
  w_s(&mut out, "static inline uint64_t bst_port_count(bst_portio io) { return io.count; }\n");
}

fn cg_prelude_mmio(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline bst_mmio bst_mmio_claim(bst_mmiospace *s, uint64_t b, uint64_t l) { (void)s; BST_MMIO_CHECK(b, l); bst_mmio m = { b, l }; return m; }\n");
  w_s(&mut out, "static inline void bst_mmio_release(bst_mmiospace *s, bst_mmio m) { (void)s; (void)m; }\n");
  w_s(&mut out, "static inline uint64_t bst_mmio_base(bst_mmio m) { return m.base; }\n");
  w_s(&mut out, "static inline uint64_t bst_mmio_len(bst_mmio m) { return m.len; }\n");
}

fn cg_prelude_mmio_kernel(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Device memory above 512 GiB is mapped only in the kernel's tables, so a\n");
  w_s(&mut out, " * parked user table (bst_mmu_exit) goes back before it is touched. */\n");
  w_s(&mut out, "#define BST_MMIO_HIGH(a) do { if ((a) >= (1ull << 39)) bst_mmu_settle(); } while (0)\n");
  w_s(&mut out, "#define BST_MMIO_RW(w, t) \\\n");
  w_s(&mut out, "    static inline uint64_t bst_mmio_read##w(bst_mmio *m, uint64_t o) { BST_MMIO_HIGH(m->base + o); return *(volatile t *)(uintptr_t)(m->base + o); } \\\n");
  w_s(&mut out, "    static inline void bst_mmio_write##w(bst_mmio *m, uint64_t o, uint64_t v) { BST_MMIO_HIGH(m->base + o); *(volatile t *)(uintptr_t)(m->base + o) = (t)v; }\n");
  w_s(&mut out, "BST_MMIO_RW(8, uint8_t) BST_MMIO_RW(16, uint16_t) BST_MMIO_RW(32, uint32_t) BST_MMIO_RW(64, uint64_t)\n");
}

fn cg_prelude_dma(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline bst_dma bst_dma_lend(bst_frame f) { __atomic_thread_fence(__ATOMIC_SEQ_CST); return f; }\n");
  w_s(&mut out, "static inline bst_frame bst_dma_take(bst_dma d) { __atomic_thread_fence(__ATOMIC_SEQ_CST); return d; }\n");
  w_s(&mut out, "static inline uint64_t bst_dma_id(bst_dma d) { return bst_frame_id(d); }\n");
  w_s(&mut out, "static inline uint64_t bst_dma_addr(bst_dma d) { return d; }\n");
  w_s(&mut out, "#define BST_DMA_RW(w, t) \\\n");
  w_s(&mut out, "    static inline uint64_t bst_dma_read##w(bst_dma *d, uint64_t o) { return *(volatile t *)(uintptr_t)(*d + o); } \\\n");
  w_s(&mut out, "    static inline void bst_dma_write##w(bst_dma *d, uint64_t o, uint64_t v) { *(volatile t *)(uintptr_t)(*d + o) = (t)v; }\n");
  w_s(&mut out, "BST_DMA_RW(8, uint8_t) BST_DMA_RW(16, uint16_t) BST_DMA_RW(32, uint32_t) BST_DMA_RW(64, uint64_t)\n");
  w_s(&mut out, "/* A copy to or from a lent page is a compiler barrier on both sides, so it\n");
  w_s(&mut out, " * stays in order with the volatile accesses around it. */\n");
  w_s(&mut out, "static inline void bst_dma_to_bytes(bst_bytes *dst, uint64_t d, bst_dma *m, uint64_t o, uint64_t n) {\n");
  w_s(&mut out, "    __asm__ volatile (\"\" : : : \"memory\");\n");
  w_s(&mut out, "    if (n) bst_copy_fwd(dst->data + d, (const unsigned char *)(uintptr_t)(*m + o), n);\n");
  w_s(&mut out, "    __asm__ volatile (\"\" : : : \"memory\");\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bytes_to_dma(bst_dma *m, uint64_t o, bst_bytes src, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    __asm__ volatile (\"\" : : : \"memory\");\n");
  w_s(&mut out, "    if (n) bst_copy_fwd((unsigned char *)(uintptr_t)(*m + o), src.data + s, n);\n");
  w_s(&mut out, "    __asm__ volatile (\"\" : : : \"memory\");\n");
  w_s(&mut out, "}\n");
}

fn cg_prelude_mmio_hosted(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static unsigned char bst_mmio_cell[1u << 20];\n");
  w_s(&mut out, "#define BST_MMIO_RW(w, t) \\\n");
  w_s(&mut out, "    static inline uint64_t bst_mmio_read##w(bst_mmio *m, uint64_t o) { t v; memcpy(&v, &bst_mmio_cell[(m->base + o) & 0xFFFFF], sizeof v); return v; } \\\n");
  w_s(&mut out, "    static inline void bst_mmio_write##w(bst_mmio *m, uint64_t o, uint64_t v) { t x = (t)v; memcpy(&bst_mmio_cell[(m->base + o) & 0xFFFFF], &x, sizeof x); }\n");
  w_s(&mut out, "BST_MMIO_RW(8, uint8_t) BST_MMIO_RW(16, uint16_t) BST_MMIO_RW(32, uint32_t) BST_MMIO_RW(64, uint64_t)\n");
}

fn cg_prelude_ports_kernel(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline uint64_t bst_pio_in8(bst_portio *io, uint64_t o) { return bst_inb((uint16_t)(io->base + o)); }\n");
  w_s(&mut out, "static inline uint64_t bst_pio_in16(bst_portio *io, uint64_t o) { uint16_t v; __asm__ volatile (\"inw %1, %0\" : \"=a\"(v) : \"Nd\"((uint16_t)(io->base + o))); return v; }\n");
  w_s(&mut out, "static inline uint64_t bst_pio_in32(bst_portio *io, uint64_t o) { uint32_t v; __asm__ volatile (\"inl %1, %0\" : \"=a\"(v) : \"Nd\"((uint16_t)(io->base + o))); return v; }\n");
  w_s(&mut out, "static inline void bst_pio_out8(bst_portio *io, uint64_t o, uint64_t v) { bst_outb((uint16_t)(io->base + o), (uint8_t)v); }\n");
  w_s(&mut out, "static inline void bst_pio_out16(bst_portio *io, uint64_t o, uint64_t v) { __asm__ volatile (\"outw %0, %1\" : : \"a\"((uint16_t)v), \"Nd\"((uint16_t)(io->base + o))); }\n");
  w_s(&mut out, "static inline void bst_pio_out32(bst_portio *io, uint64_t o, uint64_t v) { __asm__ volatile (\"outl %0, %1\" : : \"a\"((uint32_t)v), \"Nd\"((uint16_t)(io->base + o))); }\n");
}

fn cg_prelude_ports_hosted(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static uint32_t bst_port_cell[65536];\n");
  w_s(&mut out, "static inline uint64_t bst_pio_in8(bst_portio *io, uint64_t o) { return bst_port_cell[io->base + o] & 0xFF; }\n");
  w_s(&mut out, "static inline uint64_t bst_pio_in16(bst_portio *io, uint64_t o) { return bst_port_cell[io->base + o] & 0xFFFF; }\n");
  w_s(&mut out, "static inline uint64_t bst_pio_in32(bst_portio *io, uint64_t o) { return bst_port_cell[io->base + o]; }\n");
  w_s(&mut out, "static inline void bst_pio_out8(bst_portio *io, uint64_t o, uint64_t v) { bst_port_cell[io->base + o] = (uint32_t)v; }\n");
  w_s(&mut out, "static inline void bst_pio_out16(bst_portio *io, uint64_t o, uint64_t v) { bst_port_cell[io->base + o] = (uint32_t)v; }\n");
  w_s(&mut out, "static inline void bst_pio_out32(bst_portio *io, uint64_t o, uint64_t v) { bst_port_cell[io->base + o] = (uint32_t)v; }\n");
}

fn cg_prelude_kernel_cpu(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline void bst_load_cr3(uint64_t a) { __asm__ volatile (\"mov %0, %%cr3\" : : \"r\"(a) : \"memory\"); }\n");
  w_s(&mut out, "static inline uint64_t bst_read_cr3(void) { uint64_t a; __asm__ volatile (\"mov %%cr3, %0\" : \"=r\"(a)); return a; }\n");
  w_s(&mut out, "/* Three words per processor, zero at boot, if the platform keeps them: the\n");
  w_s(&mut out, " * table this processor parked (0: none), bst_pt_gen as of its last CR3\n");
  w_s(&mut out, " * load, and how many locks it holds. Without them every switch loads CR3\n");
  w_s(&mut out, " * at once. */\n");
  w_s(&mut out, "extern uint64_t *bst_platform_mmu_state(void) __attribute__((weak));\n");
  w_s(&mut out, "static inline uint64_t *bst_mmu_state(void) { return bst_platform_mmu_state ? bst_platform_mmu_state() : 0; }\n");
  w_s(&mut out, "/* A platform that gives user code a table of its own, with none of the\n");
  w_s(&mut out, " * kernel's memory in it (BastiOS: boot/boot.S loads it in bst_cpu_enter and\n");
  w_s(&mut out, " * leaves it at the next trap), defines this symbol and keeps a fourth word\n");
  w_s(&mut out, " * with the state. The kernel's tables then stay in CR3 whenever Bastio code\n");
  w_s(&mut out, " * runs: entering a table only records it in word 3, for bst_cpu_enter, and\n");
  w_s(&mut out, " * the lease is dropped as soon as the processor is done with the table. */\n");
  w_s(&mut out, "extern const char bst_platform_deferred_cr3 __attribute__((weak));\n");
  w_s(&mut out, "#define BST_DEFERRED (&bst_platform_deferred_cr3 != 0)\n");
  w_s(&mut out, "static inline void bst_cr3_load(uint64_t *s, uint64_t a) {\n");
  w_s(&mut out, "    if (s) s[1] = __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    bst_load_cr3(a);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Gives a parked table back: the kernel's tables go into CR3 first, then\n");
  w_s(&mut out, " * the lease's count drops, as bst_mmu_exit does without parking. */\n");
  w_s(&mut out, "static inline void bst_mmu_settle(void) {\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (!s || !s[0]) return;\n");
  w_s(&mut out, "    uint64_t l = s[0];\n");
  w_s(&mut out, "    s[0] = 0;\n");
  w_s(&mut out, "    bst_cr3_load(s, (uint64_t)bst_kernel_pml4);\n");
  w_s(&mut out, "    __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_mmu_settle_on(uint64_t t) {\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (s && s[0] == t) bst_mmu_settle();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_lock_depth(int d) {\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (!s) return;\n");
  w_s(&mut out, "    s[2] += (uint64_t)(int64_t)d;\n");
  w_s(&mut out, "    if (s[2] == 0 && s[0]) bst_mmu_settle();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_mmu_kernel(bst_mmu *m) { (void)m; bst_mmu_settle(); if (!BST_DEFERRED) bst_load_cr3((uint64_t)bst_kernel_pml4); }\n");
  w_s(&mut out, "/* A table this processor parked becomes the new lease without a second\n");
  w_s(&mut out, " * count. CR3 is loaded only if it holds another table, or if an entry was\n");
  w_s(&mut out, " * taken out of some table since the last load (bst_pt_gen). */\n");
  w_s(&mut out, "static inline bst_lease bst_mmu_enter(bst_mmu *m, bst_pt *t) {\n");
  w_s(&mut out, "    (void)m;\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (BST_DEFERRED) {\n");
  w_s(&mut out, "        __atomic_fetch_add(&bst_pt_leases[bst_frame_id(*t)], 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "        s[3] = *t;\n");
  w_s(&mut out, "        return *t;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (s && s[0] == *t) s[0] = 0;\n");
  w_s(&mut out, "    else __atomic_fetch_add(&bst_pt_leases[bst_frame_id(*t)], 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    if (!s || bst_read_cr3() != *t || s[1] != __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST)) bst_cr3_load(s, *t);\n");
  w_s(&mut out, "    if (s && s[0]) {                    /* another table was parked, and CR3 has left it */\n");
  w_s(&mut out, "        uint64_t l = s[0];\n");
  w_s(&mut out, "        s[0] = 0;\n");
  w_s(&mut out, "        __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return *t;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The count drops only once this processor no longer uses the table. Where\n");
  w_s(&mut out, " * the platform keeps bst_mmu_state, the table is parked instead: it stays\n");
  w_s(&mut out, " * in CR3 with its lease counted, so a process that runs again next (after\n");
  w_s(&mut out, " * a system call, say) costs no TLB flush. Every table maps the kernel's\n");
  w_s(&mut out, " * memory the same way (pml4 entry 0, BST_PT_NEW_HOOK), and nothing proved\n");
  w_s(&mut out, " * reaches the user window without a lease, so kernel code runs the same\n");
  w_s(&mut out, " * either way. The lease goes back (bst_mmu_settle) when the processor\n");
  w_s(&mut out, " * enters another table, waits for a lock or an interrupt, lets go of its\n");
  w_s(&mut out, " * last lock without entering the table again, touches MMIO above 512 GiB\n");
  w_s(&mut out, " * (mapped only in the kernel's tables), returns from its smp_run function,\n");
  w_s(&mut out, " * or asks for that table's lease count. So other processors see the lease\n");
  w_s(&mut out, " * held no longer than if the process had trapped a moment later. */\n");
  w_s(&mut out, "static inline void bst_mmu_exit(bst_mmu *m, bst_lease l) {\n");
  w_s(&mut out, "    (void)m;\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (BST_DEFERRED) {\n");
  w_s(&mut out, "        s[3] = 0;\n");
  w_s(&mut out, "        __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "        return;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (s) {\n");
  w_s(&mut out, "        s[0] = l;\n");
  w_s(&mut out, "        return;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_load_cr3((uint64_t)bst_kernel_pml4);\n");
  w_s(&mut out, "    __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_frame bst_pt_free_root(bst_mmu m, bst_pt t) { (void)m; return t; }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Saved user registers: rax rbx rcx rdx rsi rdi rbp r8-r15 (0-14), rip (15),\n");
  w_s(&mut out, " * rsp (16), rflags (17), error code (18), fault address (19), FS base (20). */\n");
  w_s(&mut out, "extern uint64_t *bst_platform_ctx(void) __attribute__((const)); /* this processor's saved context, 21 words; the same for the whole of a call, so loops over it call once */\n");
  w_s(&mut out, "extern uint64_t bst_cpu_enter(void);   /* enter user mode; returns the trap vector */\n");
  w_s(&mut out, "extern uint64_t bst_cpu_wait(void);    /* sti; hlt; cli; returns the interrupt vector */\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_get(bst_cpu c, uint64_t r) { (void)c; return bst_platform_ctx()[r]; }\n");
  w_s(&mut out, "static inline void bst_cpu_set(bst_cpu *c, uint64_t r, uint64_t v) { (void)c; bst_platform_ctx()[r] = v; }\n");
  w_s(&mut out, "/* The user's x87/SSE state, in a page the kernel owns (the platform has\n");
  w_s(&mut out, " * enabled CR4.OSFXSR). fxrstor faults on reserved MXCSR bits, so the load\n");
  w_s(&mut out, " * keeps only the defined bits (0-15) while it runs and puts the word back. */\n");
  w_s(&mut out, "static inline void bst_cpu_fpu_save(bst_cpu *c, bst_frame *f) {\n");
  w_s(&mut out, "    (void)c;\n");
  w_s(&mut out, "    __asm__ volatile (\"fxsave64 (%0)\" : : \"r\"(*f) : \"memory\");\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_cpu_fpu_load(bst_cpu *c, bst_frame f) {\n");
  w_s(&mut out, "    (void)c;\n");
  w_s(&mut out, "    uint64_t *w = (uint64_t *)f, w3 = w[3];\n");
  w_s(&mut out, "    w[3] = w3 & 0xFFFF;                 /* bytes 24-27 are MXCSR, 28-31 its mask (ignored) */\n");
  w_s(&mut out, "    __asm__ volatile (\"fxrstor64 (%0)\" : : \"r\"(f) : \"memory\");\n");
  w_s(&mut out, "    w[3] = w3;                          /* the page reads as it did */\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_run(bst_cpu *c, bst_mmu m) {\n");
  w_s(&mut out, "    (void)c; (void)m;\n");
  w_s(&mut out, "    if (BST_DEFERRED) return bst_cpu_enter();    /* it loads the table, which flushes the TLB */\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    /* flush the TLB if pages may have moved since the last load */\n");
  w_s(&mut out, "    if (!s || s[1] != __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST)) bst_cr3_load(s, bst_read_cr3());\n");
  w_s(&mut out, "    return bst_cpu_enter();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_idle(bst_cpu *c) { (void)c; bst_mmu_settle(); return bst_cpu_wait(); }\n");
  w_s(&mut out, "extern void bst_platform_smp_start(void (*fn)(void *), void *arg); /* run fn(arg) on every other processor */\n");
  w_s(&mut out, "extern void bst_platform_smp_join(void);                           /* wait until all of them have returned */\n");
  w_s(&mut out, "extern uint64_t bst_platform_cpus(void); /* processors running, this one included; 1 to 4096 */\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_count(bst_cpu c) { (void)c; return bst_platform_cpus(); }\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_tsc(bst_cpu c) { (void)c; uint32_t lo, hi; __asm__ volatile(\"rdtsc\" : \"=a\"(lo), \"=d\"(hi)); return (uint64_t)hi << 32 | lo; }\n");
  w_s(&mut out, "/* The Multiboot information the loader passed (0: none), and field f of the\n");
  w_s(&mut out, " * linear framebuffer it set up, if that is 32-bit RGB and lies below 4 GiB:\n");
  w_s(&mut out, " * 0 its address, 1 bytes per line, 2 width and 3 height in pixels, 4 the\n");
  w_s(&mut out, " * bit positions of red, green and blue, a byte each. All 0 without one. */\n");
  w_s(&mut out, "static uint64_t bst_boot_fb(bst_cpu c, uint64_t f) {\n");
  w_s(&mut out, "    (void)c;\n");
  w_s(&mut out, "    uint8_t *mb = (uint8_t *)bst_mbi;\n");
  w_s(&mut out, "    if (!mb || !(*(uint32_t *)mb & (1u << 12)) || mb[109] != 1 || mb[108] != 32) return 0;\n");
  w_s(&mut out, "    uint64_t addr = *(uint64_t *)(mb + 88), pitch = *(uint32_t *)(mb + 96);\n");
  w_s(&mut out, "    uint64_t w = *(uint32_t *)(mb + 100), h = *(uint32_t *)(mb + 104);\n");
  w_s(&mut out, "    if (addr == 0 || addr >= (1ull << 32) || pitch < w * 4 || pitch * h > (1ull << 32) - addr) return 0;    /* no wrap: the verifier takes every field as below 2^32 */\n");
  w_s(&mut out, "    if (f == 0) return addr;\n");
  w_s(&mut out, "    if (f == 1) return pitch;\n");
  w_s(&mut out, "    if (f == 2) return w;\n");
  w_s(&mut out, "    if (f == 3) return h;\n");
  w_s(&mut out, "    if (f == 4) return mb[110] | (uint64_t)mb[112] << 8 | (uint64_t)mb[114] << 16;\n");
  w_s(&mut out, "    return 0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Byte `off` of the ACPI table whose signature is `sig` (its four letters\n");
  w_s(&mut out, " * as a little-endian number; \"DSDT\" is the one the FADT points at), or 256\n");
  w_s(&mut out, " * past its end or without one. The platform finds the tables. */\n");
  w_s(&mut out, "extern uint64_t bst_platform_acpi(uint64_t sig, uint64_t off);\n");
  w_s(&mut out, "static inline uint64_t bst_boot_acpi(bst_cpu c, uint64_t sig, uint64_t off) { (void)c; return bst_platform_acpi(sig, off); }\n");
  w_s(&mut out, "/* Answer `i` to the platform's query `what` about the machine (its boot\n");
  w_s(&mut out, " * command line, memory map, processor, ...: the platform defines them), or\n");
  w_s(&mut out, " * 0. Read-only; nothing is promised about the number. */\n");
  w_s(&mut out, "extern uint64_t bst_platform_info(uint64_t what, uint64_t i);\n");
  w_s(&mut out, "static inline uint64_t bst_boot_info(bst_cpu c, uint64_t what, uint64_t i) { (void)c; return bst_platform_info(what, i); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Called by the platform on a fault in kernel mode: that is a bug in the\n");
  w_s(&mut out, " * trusted base or the compiler, never in verified code. */\n");
  w_s(&mut out, "void bst_kernel_fault(uint64_t vec, uint64_t rip, uint64_t cr2, uint64_t err) {\n");
  w_s(&mut out, "    bst_puts(\"\\nbastio: kernel fault, vector \"); bst_puthex(vec);\n");
  w_s(&mut out, "    bst_puts(\" rip \"); bst_puthex(rip); bst_puts(\" cr2 \"); bst_puthex(cr2); bst_puts(\" err \"); bst_puthex(err);\n");
  w_s(&mut out, "    bst_puts(\"\\n\");\n");
  w_s(&mut out, "    bst_halt();\n");
  w_s(&mut out, "}\n");
}

fn cg_prelude_user(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline void bst_mmu_settle(void) { }\n");
  w_s(&mut out, "static inline void bst_lock_depth(int d) { (void)d; }\n");
  w_s(&mut out, "enum { BST_SYS_EXIT, BST_SYS_WRITE, BST_SYS_READ, BST_SYS_SPAWN, BST_SYS_WAIT, BST_SYS_YIELD,\n");
  w_s(&mut out, "       BST_SYS_GETPID, BST_SYS_INFO, BST_SYS_PS, BST_SYS_KILL, BST_SYS_POWEROFF };\n");
  w_s(&mut out, "static inline uint64_t bst_sys(uint64_t n, uint64_t a, uint64_t b, uint64_t c) {\n");
  w_s(&mut out, "    uint64_t r;\n");
  w_s(&mut out, "    __asm__ volatile (\"int $0x80\" : \"=a\"(r) : \"a\"(n), \"D\"(a), \"S\"(b), \"d\"(c) : \"memory\");\n");
  w_s(&mut out, "    return r;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static unsigned char bst_out[256];\n");
  w_s(&mut out, "static uint64_t bst_out_n;\n");
  w_s(&mut out, "static void bst_flush(void) {\n");
  w_s(&mut out, "    if (bst_out_n) bst_sys(BST_SYS_WRITE, (uint64_t)bst_out, bst_out_n, 0);\n");
  w_s(&mut out, "    bst_out_n = 0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    bst_out[bst_out_n++] = (unsigned char)b;\n");
  w_s(&mut out, "    if (b == '\\n' || bst_out_n == sizeof bst_out) bst_flush();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) { (void)s; bst_flush(); return bst_sys(BST_SYS_READ, 0, 0, 0); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "#define BST_ARENA_WORDS (1u << 13)   /* 64 KiB */\n");
  w_s(&mut out, "static uint64_t bst_arena[BST_ARENA_WORDS];\n");
  w_s(&mut out, "static uint64_t bst_arena_top = 0;\n");
  w_s(&mut out, "typedef struct bst_free { uint64_t words; struct bst_free *next; } bst_free_t;\n");
  w_s(&mut out, "static bst_free_t *bst_free_list = 0;\n");
  w_s(&mut out, "/* An empty buffer with no memory when the arena is full. */\n");
  w_s(&mut out, "static bst_buf bst_try_alloc(uint64_t n) {\n");
  w_s(&mut out, "    uint64_t words = (n ? n : 1) + 1;\n");
  w_s(&mut out, "    if (words < 2) words = 2;\n");
  w_s(&mut out, "    bst_free_t **pp = &bst_free_list;\n");
  w_s(&mut out, "    for (bst_free_t *f = bst_free_list; f; pp = &f->next, f = f->next) {\n");
  w_s(&mut out, "        if (f->words == words) {\n");
  w_s(&mut out, "            *pp = f->next;\n");
  w_s(&mut out, "            uint64_t *blk = (uint64_t *)f;\n");
  w_s(&mut out, "            for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  w_s(&mut out, "            bst_buf b = { n, blk + 1 };\n");
  w_s(&mut out, "            return b;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (bst_arena_top + words > BST_ARENA_WORDS) {\n");
  w_s(&mut out, "        bst_buf none = { 0, 0 };\n");
  w_s(&mut out, "        return none;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    uint64_t *blk = &bst_arena[bst_arena_top];\n");
  w_s(&mut out, "    bst_arena_top += words;\n");
  w_s(&mut out, "    blk[0] = words;\n");
  w_s(&mut out, "    for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  w_s(&mut out, "    bst_buf b = { n, blk + 1 };\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf b = bst_try_alloc(n);\n");
  w_s(&mut out, "    if (!b.data) {\n");
  w_s(&mut out, "        static const char m[] = \"bastio: out of memory\\n\";\n");
  w_s(&mut out, "        bst_flush();\n");
  w_s(&mut out, "        bst_sys(BST_SYS_WRITE, (uint64_t)m, sizeof m - 1, 0);\n");
  w_s(&mut out, "        bst_sys(BST_SYS_EXIT, 255, 0, 0);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_free(bst_buf b) {\n");
  w_s(&mut out, "    if (!b.data) return;\n");
  w_s(&mut out, "    uint64_t *blk = b.data - 1;\n");
  w_s(&mut out, "    bst_free_t *f = (bst_free_t *)blk;\n");
  w_s(&mut out, "    f->words = blk[0];\n");
  w_s(&mut out, "    f->next = bst_free_list;\n");
  w_s(&mut out, "    bst_free_list = f;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_print(uint64_t v) {\n");
  w_s(&mut out, "    char d[20]; int n = 0;\n");
  w_s(&mut out, "    do { d[n++] = (char)('0' + v % 10); v /= 10; } while (v);\n");
  w_s(&mut out, "    while (n) bst_serial_write(0, (unsigned char)d[--n]);\n");
  w_s(&mut out, "    bst_serial_write(0, '\\n');\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_sys_spawn(bst_buf b, uint64_t from, uint64_t to) {\n");
  w_s(&mut out, "    unsigned char name[64];\n");
  w_s(&mut out, "    uint64_t n = 0;\n");
  w_s(&mut out, "    for (uint64_t i = from; i < to && n < sizeof name; i++) name[n++] = (unsigned char)b.data[i];\n");
  w_s(&mut out, "    return bst_sys(BST_SYS_SPAWN, (uint64_t)name, n, 0);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_sys_wait(uint64_t pid) { return bst_sys(BST_SYS_WAIT, pid, 0, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_kill(uint64_t pid) { return bst_sys(BST_SYS_KILL, pid, 0, 0); }\n");
  w_s(&mut out, "static inline void bst_sys_yield(void) { bst_sys(BST_SYS_YIELD, 0, 0, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_getpid(void) { return bst_sys(BST_SYS_GETPID, 0, 0, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_info(uint64_t k) { return bst_sys(BST_SYS_INFO, k, 0, 0); }\n");
  w_s(&mut out, "static inline void bst_sys_ps(void) { bst_flush(); bst_sys(BST_SYS_PS, 0, 0, 0); }\n");
  w_s(&mut out, "static inline void bst_sys_poweroff(void) { bst_flush(); bst_sys(BST_SYS_POWEROFF, 0, 0, 0); }\n");
  w_s(&mut out, "/* Calls with numbers the language does not know: the kernel defines them.\n");
  w_s(&mut out, " * sys_send lends the kernel bytes 0..n of b to read; sys_recv lends all of b\n");
  w_s(&mut out, " * to overwrite. Console output is flushed first so it stays in order. */\n");
  w_s(&mut out, "static inline uint64_t bst_sys_call(uint64_t n, uint64_t a, uint64_t b) { bst_flush(); return bst_sys(n, a, b, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_send(uint64_t n, uint64_t a, bst_bytes b, uint64_t len) { bst_flush(); return bst_sys(n, a, (uint64_t)b.data, len); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_recv(uint64_t n, uint64_t a, bst_bytes *b) { bst_flush(); return bst_sys(n, a, (uint64_t)b->data, b->len); }\n");
}

// The prelude parts, numbered: `cg_parts` lists a target's in stage0's
// order (`prelude_parts`), and `--trusted-base` names and counts them.
/// The prelude part for the AArch64 kernel: PL011 console, halting, the Buf arena and the page pool.
fn cg_prelude_kernel_a64(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "/* The console: a PL011 UART, at the address the platform names in\n");
  w_s(&mut out, " * bst_uart_base (QEMU's virt machine has it at 0x09000000, the default).\n");
  w_s(&mut out, " * The baud rate is left as the firmware set it. */\n");
  w_s(&mut out, "extern uint64_t bst_uart_base __attribute__((weak));\n");
  w_s(&mut out, "static inline volatile uint32_t *bst_uart(void) {\n");
  w_s(&mut out, "    return (volatile uint32_t *)(uintptr_t)(&bst_uart_base ? bst_uart_base : 0x09000000ull);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define BST_UART_DR 0      /* data */\n");
  w_s(&mut out, "#define BST_UART_FR 6      /* flags: bit 4 receive FIFO empty, bit 5 transmit FIFO full */\n");
  w_s(&mut out, "#define BST_UART_LCRH 11   /* line control */\n");
  w_s(&mut out, "#define BST_UART_CR 12     /* control */\n");
  w_s(&mut out, "#define BST_UART_IMSC 14   /* interrupt mask */\n");
  w_s(&mut out, "static void bst_serial_init(void) {\n");
  w_s(&mut out, "    volatile uint32_t *u = bst_uart();\n");
  w_s(&mut out, "    u[BST_UART_CR] = 0;            /* off while configuring */\n");
  w_s(&mut out, "    u[BST_UART_LCRH] = 0x70;       /* 8N1, FIFOs on */\n");
  w_s(&mut out, "    u[BST_UART_IMSC] = 0x10;       /* interrupt on received data */\n");
  w_s(&mut out, "    u[BST_UART_CR] = 0x301;        /* on: transmit and receive */\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    volatile uint32_t *u = bst_uart();\n");
  w_s(&mut out, "    while (u[BST_UART_FR] & 0x20) { }\n");
  w_s(&mut out, "    u[BST_UART_DR] = (uint32_t)(uint8_t)b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    volatile uint32_t *u = bst_uart();\n");
  w_s(&mut out, "    while (u[BST_UART_FR] & 0x10) { __asm__ volatile (\"yield\"); }\n");
  w_s(&mut out, "    return u[BST_UART_DR] & 0xFF;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_serial_poll(bst_serial s) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    volatile uint32_t *u = bst_uart();\n");
  w_s(&mut out, "    return (u[BST_UART_FR] & 0x10) ? 256 : (u[BST_UART_DR] & 0xFF);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "static void bst_halt(void) { for (;;) __asm__ volatile (\"msr daifset, #0xf; wfi\"); }\n");
  w_s(&mut out, "static void bst_puts(const char *m) { for (; *m; m++) bst_serial_write(0, (unsigned char)*m); }\n");
  w_s(&mut out, "static void bst_puthex(uint64_t v) {\n");
  w_s(&mut out, "    bst_puts(\"0x\");\n");
  w_s(&mut out, "    for (int i = 60; i >= 0; i -= 4) bst_serial_write(0, (unsigned char)\"0123456789abcdef\"[(v >> i) & 15]);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Memory for Buf: a fixed arena with an exact-size free list, then the\n");
  w_s(&mut out, " * extension bst_pool_init carves from RAM (an eighth of the pool, at least 4 MiB), so\n");
  w_s(&mut out, " * the kernel's own tables can grow with the machine. */\n");
  w_s(&mut out, "#define BST_ARENA_WORDS (1u << 20)   /* 8 MiB */\n");
  w_s(&mut out, "static uint64_t bst_arena[BST_ARENA_WORDS];\n");
  w_s(&mut out, "static uint64_t bst_arena_top = 0;\n");
  w_s(&mut out, "static uint64_t *bst_arena2, bst_arena2_words, bst_arena2_top;\n");
  w_s(&mut out, "typedef struct bst_free { uint64_t words; struct bst_free *next; } bst_free_t;\n");
  w_s(&mut out, "static bst_free_t *bst_free_list = 0;\n");
  w_s(&mut out, "static uint64_t bst_arena_lock;              /* every processor allocates from the one arena */\n");
  w_s(&mut out, "/* An empty buffer with no memory when the arena is full. */\n");
  w_s(&mut out, "static bst_buf bst_try_alloc(uint64_t n) {\n");
  w_s(&mut out, "    uint64_t words = (n ? n : 1) + 1;            /* one header word for the size */\n");
  w_s(&mut out, "    if (words < 2) words = 2;\n");
  w_s(&mut out, "    uint64_t *blk = 0;\n");
  w_s(&mut out, "    bst_lock_acquire(&bst_arena_lock);\n");
  w_s(&mut out, "    bst_free_t **pp = &bst_free_list;\n");
  w_s(&mut out, "    for (bst_free_t *f = bst_free_list; f; pp = &f->next, f = f->next) {\n");
  w_s(&mut out, "        if (f->words == words) {\n");
  w_s(&mut out, "            *pp = f->next;\n");
  w_s(&mut out, "            blk = (uint64_t *)f;\n");
  w_s(&mut out, "            break;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (!blk && bst_arena_top + words <= BST_ARENA_WORDS) {\n");
  w_s(&mut out, "        blk = &bst_arena[bst_arena_top];\n");
  w_s(&mut out, "        bst_arena_top += words;\n");
  w_s(&mut out, "        blk[0] = words;\n");
  w_s(&mut out, "    } else if (!blk && words <= bst_arena2_words - bst_arena2_top) {\n");
  w_s(&mut out, "        blk = &bst_arena2[bst_arena2_top];\n");
  w_s(&mut out, "        bst_arena2_top += words;\n");
  w_s(&mut out, "        blk[0] = words;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_lock_release(&bst_arena_lock);\n");
  w_s(&mut out, "    if (!blk) { bst_buf none = { 0, 0 }; return none; }\n");
  w_s(&mut out, "    for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  w_s(&mut out, "    bst_buf b = { n, blk + 1 };\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf b = bst_try_alloc(n);\n");
  w_s(&mut out, "    if (!b.data) { bst_puts(\"bastio: out of memory\\n\"); bst_halt(); }\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_free(bst_buf b) {\n");
  w_s(&mut out, "    if (!b.data) return;\n");
  w_s(&mut out, "    uint64_t *blk = b.data - 1;\n");
  w_s(&mut out, "    bst_free_t *f = (bst_free_t *)blk;\n");
  w_s(&mut out, "    bst_lock_acquire(&bst_arena_lock);\n");
  w_s(&mut out, "    f->words = blk[0];\n");
  w_s(&mut out, "    f->next = bst_free_list;\n");
  w_s(&mut out, "    bst_free_list = f;\n");
  w_s(&mut out, "    bst_lock_release(&bst_arena_lock);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_print(uint64_t v) {\n");
  w_s(&mut out, "    char d[20]; int n = 0;\n");
  w_s(&mut out, "    do { d[n++] = (char)('0' + v % 10); v /= 10; } while (v);\n");
  w_s(&mut out, "    while (n) bst_serial_write(0, (unsigned char)d[--n]);\n");
  w_s(&mut out, "    bst_serial_write(0, '\\n');\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Physical pages: every run of RAM the platform lists (bst_kmain's argument\n");
  w_s(&mut out, " * points to a count followed by that many base and length pairs, which the\n");
  w_s(&mut out, " * boot code takes from the device tree) from the end of the kernel image\n");
  w_s(&mut out, " * up to bst_ram_limit, where the platform's identity map of RAM stops (512\n");
  w_s(&mut out, " * GiB, the kernel's first top-level slot, if the platform does not define\n");
  w_s(&mut out, " * it), at most 2^27 pages. Runs that touch are merged; past BST_RUNS the\n");
  w_s(&mut out, " * rest are left out. Page ids are dense over the runs (bst_page_at,\n");
  w_s(&mut out, " * bst_frame_id). The front of the run that holds them is carved off for the\n");
  w_s(&mut out, " * pool's bookkeeping: two 32-bit counters a page (leases, shared\n");
  w_s(&mut out, " * references) and the arena's extension of an eighth of the pool (at least 4\n");
  w_s(&mut out, " * MiB). */\n");
  w_s(&mut out, "extern char _end[];\n");
  w_s(&mut out, "extern uint64_t bst_kernel_root[512];\n");
  w_s(&mut out, "extern uint64_t bst_ram_limit __attribute__((weak));\n");
  w_s(&mut out, "#define BST_RUNS 32\n");
  w_s(&mut out, "#define BST_FRAME_LIMIT (1ull << 27)\n");
  w_s(&mut out, "static uint64_t bst_run_at[BST_RUNS], bst_run_id[BST_RUNS + 1], bst_runs;\n");
  w_s(&mut out, "static uint32_t *bst_pt_leases, *bst_shared_refs;\n");
  w_s(&mut out, "static uint64_t bst_carved_lo, bst_carved_hi;\n");
  w_s(&mut out, "static uint64_t bst_mbi;\n");
  w_s(&mut out, "/* Adds [a, b) to the n sorted runs lo/hi, merging the ones it touches. */\n");
  w_s(&mut out, "static uint64_t bst_run_put(uint64_t *lo, uint64_t *hi, uint64_t n, uint64_t a, uint64_t b) {\n");
  w_s(&mut out, "    uint64_t m = 0;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        if (hi[k] < a || b < lo[k]) { lo[m] = lo[k]; hi[m] = hi[k]; m++; }\n");
  w_s(&mut out, "        else { if (lo[k] < a) a = lo[k]; if (hi[k] > b) b = hi[k]; }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (m == BST_RUNS) return m;\n");
  w_s(&mut out, "    uint64_t k = m;\n");
  w_s(&mut out, "    while (k > 0 && lo[k - 1] > a) { lo[k] = lo[k - 1]; hi[k] = hi[k - 1]; k--; }\n");
  w_s(&mut out, "    lo[k] = a; hi[k] = b;\n");
  w_s(&mut out, "    return m + 1;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_pool bst_pool_init(uint64_t mbi) {\n");
  w_s(&mut out, "    uint64_t *info = (uint64_t *)mbi;\n");
  w_s(&mut out, "    uint64_t base = ((uint64_t)_end + 4095) & ~4095ull;\n");
  w_s(&mut out, "    uint64_t limit = &bst_ram_limit ? bst_ram_limit : (1ull << 39);\n");
  w_s(&mut out, "    if (limit > (1ull << 39)) limit = 1ull << 39;\n");
  w_s(&mut out, "    uint64_t lo[BST_RUNS], hi[BST_RUNS], n = 0;\n");
  w_s(&mut out, "    for (uint64_t k = 0; info && k < info[0] && k < 64; k++) {\n");
  w_s(&mut out, "        uint64_t a = info[1 + 2 * k], b = a + info[2 + 2 * k];\n");
  w_s(&mut out, "        if (b < a) b = ~0ull;\n");
  w_s(&mut out, "        if (a < base) a = base;\n");
  w_s(&mut out, "        if (b > limit) b = limit;\n");
  w_s(&mut out, "        a = (a + 4095) & ~4095ull;\n");
  w_s(&mut out, "        b &= ~4095ull;\n");
  w_s(&mut out, "        if (a < b) n = bst_run_put(lo, hi, n, a, b);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    /* At most 2^27 pages: the top runs go first. */\n");
  w_s(&mut out, "    uint64_t pages = 0;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        if (pages + (hi[k] - lo[k]) / 4096 > BST_FRAME_LIMIT) hi[k] = lo[k] + (BST_FRAME_LIMIT - pages) * 4096;\n");
  w_s(&mut out, "        pages += (hi[k] - lo[k]) / 4096;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    /* The bookkeeping, from the first run with room (the arena extension\n");
  w_s(&mut out, "     * only if there is room for it too). */\n");
  w_s(&mut out, "    uint64_t counters = (pages * 8 + 4095) / 4096, ext = pages / 8, r = n;\n");
  w_s(&mut out, "    if (ext < 1024) ext = pages / 8 < 1024 ? pages / 8 : 1024;   /* at least 4 MiB, at most an eighth */\n");
  w_s(&mut out, "    for (int tries = 0; tries < 2 && r == n; tries++) {\n");
  w_s(&mut out, "        if (tries) ext = 0;\n");
  w_s(&mut out, "        for (r = 0; r < n && (hi[r] - lo[r]) / 4096 <= counters + ext; r++) {}\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_pool p;\n");
  w_s(&mut out, "    p.base = base;\n");
  w_s(&mut out, "    p.size = 0;\n");
  w_s(&mut out, "    if (r == n) return p;          /* no room even for the counters: no pages */\n");
  w_s(&mut out, "    uint64_t *w = (uint64_t *)lo[r];\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < counters * 512; k++) w[k] = 0;\n");
  w_s(&mut out, "    bst_pt_leases = (uint32_t *)lo[r];\n");
  w_s(&mut out, "    bst_shared_refs = (uint32_t *)lo[r] + pages;\n");
  w_s(&mut out, "    bst_arena2 = (uint64_t *)(lo[r] + counters * 4096);\n");
  w_s(&mut out, "    bst_arena2_words = ext * 512;\n");
  w_s(&mut out, "    bst_carved_lo = lo[r];\n");
  w_s(&mut out, "    bst_carved_hi = lo[r] + (counters + ext) * 4096;\n");
  w_s(&mut out, "    lo[r] = bst_carved_hi;\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < n; k++) {\n");
  w_s(&mut out, "        bst_run_at[k] = lo[k];\n");
  w_s(&mut out, "        bst_run_id[k + 1] = bst_run_id[k] + (hi[k] - lo[k]) / 4096;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_runs = n;\n");
  w_s(&mut out, "    p.base = lo[0];\n");
  w_s(&mut out, "    p.size = bst_run_id[n];\n");
  w_s(&mut out, "    return p;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Claiming RAM as registers would alias pages the proofs hand out, or the\n");
  w_s(&mut out, " * kernel itself, so such a claim stops the machine. On AArch64 the device\n");
  w_s(&mut out, " * window starts at 0, so every run of RAM the platform listed is refused,\n");
  w_s(&mut out, " * the kernel image's included, besides the pool's. */\n");
  w_s(&mut out, "static void bst_mmio_check(uint64_t b, uint64_t l) {\n");
  w_s(&mut out, "    int bad = l && b < bst_carved_hi && bst_carved_lo < b + l;\n");
  w_s(&mut out, "    uint64_t *info = (uint64_t *)bst_mbi;\n");
  w_s(&mut out, "    for (uint64_t k = 0; info && k < info[0] && k < 64; k++) {\n");
  w_s(&mut out, "        uint64_t lo = info[1 + 2 * k], hi = lo + info[2 + 2 * k];\n");
  w_s(&mut out, "        if (hi < lo) hi = ~0ull;\n");
  w_s(&mut out, "        if (l && b < hi && lo < b + l) bad = 1;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    for (uint64_t k = 0; k < bst_runs; k++) {\n");
  w_s(&mut out, "        uint64_t lo = bst_run_at[k], hi = lo + (bst_run_id[k + 1] - bst_run_id[k]) * 4096;\n");
  w_s(&mut out, "        if (l && b < hi && lo < b + l) bad = 1;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (bad) { bst_puts(\"bastio: mmio_claim of RAM at \"); bst_puthex(b); bst_puts(\"\\n\"); bst_halt(); }\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define BST_MMIO_CHECK(b, l) bst_mmio_check(b, l)\n");
  w_s(&mut out, "/* A platform that gives user code a table of its own, with none of the\n");
  w_s(&mut out, " * kernel's memory in it (BastiOS: boot/aarch64/boot.S loads it into TTBR0 in\n");
  w_s(&mut out, " * bst_cpu_enter, from a trampoline the kernel keeps in TTBR1, and leaves it at\n");
  w_s(&mut out, " * the next exception), defines this symbol and keeps a fourth word of\n");
  w_s(&mut out, " * bst_platform_mmu_state for the table. The kernel's tables then stay in\n");
  w_s(&mut out, " * TTBR0 whenever Bastio code runs. */\n");
  w_s(&mut out, "extern const char bst_platform_deferred_ttbr0 __attribute__((weak));\n");
  w_s(&mut out, "#define BST_DEFERRED (&bst_platform_deferred_ttbr0 != 0)\n");
  w_s(&mut out, "/* Otherwise every top-level table maps the kernel as the platform's does:\n");
  w_s(&mut out, " * its first slot points to the same table (EL1 only, set in the entries\n");
  w_s(&mut out, " * below it). */\n");
  w_s(&mut out, "#define BST_PT_NEW_HOOK if (level == 4 && !BST_DEFERRED) e[0] = ((uint64_t)bst_kernel_root[0] & BST_PTE_ADDR) | BST_PTE_TABLE;\n");
}

/// The prelude part for AArch64 page tables (VMSAv8-64, 4 KiB granule).
fn cg_prelude_pages_a64(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "/* VMSAv8-64 descriptors, 4 KiB granule. A table entry is valid and of\n");
  w_s(&mut out, " * type table (bits 0-1); a last-level entry is valid and of type page, with\n");
  w_s(&mut out, " * the access flag set (so the CPU never faults to set it), inner shareable,\n");
  w_s(&mut out, " * normal memory (MAIR index 0, set by the platform), not global (it belongs\n");
  w_s(&mut out, " * to one address space), reachable from EL0 (AP[1]) and read-only unless\n");
  w_s(&mut out, " * writable (AP[2]), and never executable at EL1 (PXN). */\n");
  w_s(&mut out, "#define BST_PTE_P 1ull\n");
  w_s(&mut out, "#define BST_PTE_TABLE 3ull\n");
  w_s(&mut out, "#define BST_PTE_PAGE (3ull | (1ull << 10) | (3ull << 8) | (1ull << 11) | (1ull << 6) | (1ull << 53))\n");
  w_s(&mut out, "#define BST_PTE_RO (1ull << 7)\n");
  w_s(&mut out, "/* A page the program may write is never one it may run (W^X): the entry has\n");
  w_s(&mut out, " * UXN (bit 54) when it is made writable, and has not when made read-only,\n");
  w_s(&mut out, " * so a page is executable if it was mapped read-only (program text) or if\n");
  w_s(&mut out, " * the kernel made it so by mapping it again read-only. pt_set_access\n");
  w_s(&mut out, " * leaves the bit alone. */\n");
  w_s(&mut out, "#define BST_PTE_UXN (1ull << 54)\n");
  w_s(&mut out, "#define BST_PTE_ADDR 0x0000FFFFFFFFF000ull\n");
  w_s(&mut out, "static inline void bst_zero_page(uint64_t a) {\n");
  w_s(&mut out, "#if defined(__x86_64__)\n");
  w_s(&mut out, "    void *p = (void *)a;\n");
  w_s(&mut out, "    uint64_t n = 512;\n");
  w_s(&mut out, "    __asm__ volatile (\"rep stosq\" : \"+D\"(p), \"+c\"(n) : \"a\"(0ull) : \"memory\");\n");
  w_s(&mut out, "#else\n");
  w_s(&mut out, "    uint64_t *w = (uint64_t *)a;\n");
  w_s(&mut out, "    for (int k = 0; k < 512; k++) w[k] = 0;\n");
  w_s(&mut out, "#endif\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_pool_size(bst_pool p) { return p.size; }\n");
  w_s(&mut out, "/* Page ids are dense over the runs of RAM: run r holds ids bst_run_id[r] up\n");
  w_s(&mut out, " * to bst_run_id[r + 1], from address bst_run_at[r]. Most machines have one\n");
  w_s(&mut out, " * or two runs, so the loops stop at once. */\n");
  w_s(&mut out, "static inline uint64_t bst_page_at(uint64_t i) {\n");
  w_s(&mut out, "    uint64_t r = 0;\n");
  w_s(&mut out, "    while (r + 1 < bst_runs && i >= bst_run_id[r + 1]) r++;\n");
  w_s(&mut out, "    return bst_run_at[r] + (i - bst_run_id[r]) * 4096;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_frame_id(bst_frame f) {\n");
  w_s(&mut out, "    uint64_t r = 0;\n");
  w_s(&mut out, "    while (r + 1 < bst_runs && f - bst_run_at[r] >= (bst_run_id[r + 1] - bst_run_id[r]) * 4096) r++;\n");
  w_s(&mut out, "    return bst_run_id[r] + (f - bst_run_at[r]) / 4096;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_frame bst_pool_take(bst_pool *p, uint64_t i) {\n");
  w_s(&mut out, "    uint64_t a = bst_page_at(i);\n");
  w_s(&mut out, "    (void)p;\n");
  w_s(&mut out, "    bst_zero_page(a);      /* never leak a page's old contents */\n");
  w_s(&mut out, "    return a;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_pool_give(bst_pool *p, bst_frame f) { (void)p; (void)f; }\n");
  w_s(&mut out, "static inline uint64_t bst_frame_read(bst_frame f, uint64_t w) { return ((uint64_t *)f)[w]; }\n");
  w_s(&mut out, "static inline void bst_frame_write(bst_frame *f, uint64_t w, uint64_t v) { ((uint64_t *)*f)[w] = v; }\n");
  w_s(&mut out, "static inline uint64_t bst_frame_read8(bst_frame f, uint64_t o) { return ((unsigned char *)f)[o]; }\n");
  w_s(&mut out, "static inline void bst_frame_write8(bst_frame *f, uint64_t o, uint64_t v) { ((unsigned char *)*f)[o] = (unsigned char)v; }\n");
  w_s(&mut out, "static inline void bst_frame_to_bytes(bst_bytes *dst, uint64_t d, bst_frame f, uint64_t o, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd(dst->data + d, (const unsigned char *)f + o, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bytes_to_frame(bst_frame *f, uint64_t o, bst_bytes src, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd((unsigned char *)*f + o, src.data + s, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_frame_to_frame(bst_frame *d, uint64_t o, bst_frame f, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    if (n) bst_copy_fwd((unsigned char *)*d + o, (const unsigned char *)f + s, n);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_pt bst_pt_new(bst_frame f, uint64_t level) {\n");
  w_s(&mut out, "    uint64_t *e = (uint64_t *)f;\n");
  w_s(&mut out, "    bst_zero_page(f);      /* f may be a page that held data, not a fresh one */\n");
  w_s(&mut out, "    BST_PT_NEW_HOOK\n");
  w_s(&mut out, "    return f;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline bst_frame bst_pt_free(bst_pt t) { return t; }\n");
  w_s(&mut out, "/* A last-level slot the program may not touch (pt_set_access 0) keeps its\n");
  w_s(&mut out, " * page with the valid bit clear, marked by a bit the CPU ignores in an\n");
  w_s(&mut out, " * invalid entry (one of those reserved for software), so the table still\n");
  w_s(&mut out, " * owns it. */\n");
  w_s(&mut out, "#define BST_PTE_HIDDEN (1ull << 55)\n");
  w_s(&mut out, "static inline bool bst_pt_has(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & (BST_PTE_P | BST_PTE_HIDDEN)) != 0; }\n");
  w_s(&mut out, "static inline bool bst_pt_writable(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_RO) == 0; }\n");
  w_s(&mut out, "static inline bool bst_pt_accessible(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_P) != 0; }\n");
  w_s(&mut out, "static inline void bst_pt_set_access(bst_pt *t, uint64_t i, uint64_t a) {\n");
  w_s(&mut out, "    uint64_t e = ((uint64_t *)*t)[i] & ~(BST_PTE_P | BST_PTE_RO | BST_PTE_HIDDEN);\n");
  w_s(&mut out, "    e |= a == 0 ? BST_PTE_HIDDEN | BST_PTE_RO : (BST_PTE_P | (a == 2 ? 0 : BST_PTE_RO));\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], e, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Another processor may be walking the table (it holds a lease on the\n");
  w_s(&mut out, " * tree), so an entry is written with one 64-bit store, valid bit\n");
  w_s(&mut out, " * included, after everything it points to (release order). The walker\n");
  w_s(&mut out, " * sees it after the next DSB, which every entry to user mode has\n");
  w_s(&mut out, " * (bst_cpu_run). */\n");
  w_s(&mut out, "static inline void bst_pt_put(bst_pt *t, uint64_t i, bst_pt c) {\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], c | BST_PTE_TABLE, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* A page mapped for user mode may hold code the kernel wrote through the\n");
  w_s(&mut out, " * data cache, and AArch64's instruction cache does not snoop it: the page\n");
  w_s(&mut out, " * is cleaned to the point of unification and the instruction cache\n");
  w_s(&mut out, " * invalidated before the entry is written (Arm ARM, \"Instruction cache\n");
  w_s(&mut out, " * maintenance\"). */\n");
  w_s(&mut out, "static inline void bst_sync_icache(uint64_t a) {\n");
  w_s(&mut out, "    uint64_t ctr;\n");
  w_s(&mut out, "    __asm__ volatile (\"mrs %0, ctr_el0\" : \"=r\"(ctr));\n");
  w_s(&mut out, "    uint64_t dl = 4ull << ((ctr >> 16) & 15), il = 4ull << (ctr & 15);\n");
  w_s(&mut out, "    for (uint64_t p = a; p < a + 4096; p += dl) __asm__ volatile (\"dc cvau, %0\" : : \"r\"(p) : \"memory\");\n");
  w_s(&mut out, "    __asm__ volatile (\"dsb ish\" : : : \"memory\");\n");
  w_s(&mut out, "    for (uint64_t p = a; p < a + 4096; p += il) __asm__ volatile (\"ic ivau, %0\" : : \"r\"(p) : \"memory\");\n");
  w_s(&mut out, "    __asm__ volatile (\"dsb ish; isb\" : : : \"memory\");\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_pt_put_frame(bst_pt *t, uint64_t i, bst_frame f, bool w) {\n");
  w_s(&mut out, "    bst_sync_icache(f);\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], f | BST_PTE_PAGE | (w ? BST_PTE_UXN : BST_PTE_RO), __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* What slot i points to, left in place (pt_borrow). */\n");
  w_s(&mut out, "static inline uint64_t bst_pt_child(bst_pt t, uint64_t i) { return ((uint64_t *)t)[i] & BST_PTE_ADDR; }\n");
  w_s(&mut out, "/* Leases outstanding on each top-level table (mmu_enter, mmu_exit), by page\n");
  w_s(&mut out, " * number (bst_pt_leases, one per pool page, comes with the pool). A lease this processor parked\n");
  w_s(&mut out, " * (bst_mmu_exit) is given back first, so the count is what it would be had\n");
  w_s(&mut out, " * the table been left at once. */\n");
  w_s(&mut out, "static inline void bst_mmu_settle_on(uint64_t t);   /* defined per target */\n");
  w_s(&mut out, "static inline uint64_t bst_pt_lease_count(bst_pt *t) {\n");
  w_s(&mut out, "    bst_mmu_settle_on(*t);\n");
  w_s(&mut out, "    return __atomic_load_n(&bst_pt_leases[bst_frame_id(*t)], __ATOMIC_ACQUIRE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Counts every entry taken out of any table, and every protection change: a processor whose TLB may\n");
  w_s(&mut out, " * still hold the entry flushes it before it runs user code again if the\n");
  w_s(&mut out, " * count moved since its last flush (bst_cpu_run, bst_mmu_enter). Putting an\n");
  w_s(&mut out, " * entry into an empty slot needs no flush: no translation is cached for an\n");
  w_s(&mut out, " * invalid entry. */\n");
  w_s(&mut out, "static uint64_t bst_pt_gen;\n");
  w_s(&mut out, "static inline uint64_t bst_pt_take(bst_pt *t, uint64_t i) {\n");
  w_s(&mut out, "    uint64_t *e = &((uint64_t *)*t)[i];\n");
  w_s(&mut out, "    uint64_t a = *e & BST_PTE_ADDR;\n");
  w_s(&mut out, "    *e = 0;\n");
  w_s(&mut out, "    __atomic_fetch_add(&bst_pt_gen, 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    return a;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define bst_pt_take_frame bst_pt_take\n");
  w_s(&mut out, "/* Shared pages: how many references (Shared values and pt_dup_shared's\n");
  w_s(&mut out, " * reads) each page has, by page number, and a PTE bit the CPU ignores that\n");
  w_s(&mut out, " * marks a slot mapping one. The last shared_drop gives the page back. */\n");
  w_s(&mut out, "#define BST_PTE_SHARED (1ull << 56)\n");
  w_s(&mut out, "static inline bst_frame bst_shared_new(bst_frame f) { __atomic_store_n(&bst_shared_refs[bst_frame_id(f)], 1, __ATOMIC_RELEASE); return f; }\n");
  w_s(&mut out, "static inline bst_frame bst_shared_dup(bst_frame s) { __atomic_fetch_add(&bst_shared_refs[bst_frame_id(s)], 1, __ATOMIC_RELAXED); return s; }\n");
  w_s(&mut out, "static inline uint64_t bst_shared_drop(bst_pool *p, bst_frame s) {\n");
  w_s(&mut out, "    uint64_t i = bst_frame_id(s);\n");
  w_s(&mut out, "    (void)p;\n");
  w_s(&mut out, "    return __atomic_sub_fetch(&bst_shared_refs[i], 1, __ATOMIC_ACQ_REL) == 0 ? i : ~0ull;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_shared_id(bst_frame s) { return bst_frame_id(s); }\n");
  w_s(&mut out, "static inline bool bst_pt_shared(bst_pt t, uint64_t i) { return (((uint64_t *)t)[i] & BST_PTE_SHARED) != 0; }\n");
  w_s(&mut out, "static inline void bst_pt_put_shared(bst_pt *t, uint64_t i, bst_frame s, bool w) {\n");
  w_s(&mut out, "    bst_sync_icache(s);\n");
  w_s(&mut out, "    __atomic_store_n(&((uint64_t *)*t)[i], s | BST_PTE_PAGE | BST_PTE_SHARED | (w ? BST_PTE_UXN : BST_PTE_RO), __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "#define bst_pt_take_shared bst_pt_take\n");
  w_s(&mut out, "static inline bst_frame bst_pt_dup_shared(bst_pt t, uint64_t i) { return bst_shared_dup(((uint64_t *)t)[i] & BST_PTE_ADDR); }\n");
  w_s(&mut out, "/* Dirty pages: taken without zeroing, so whoever takes them (under a lock,\n");
  w_s(&mut out, " * say) does not pay for it; they become frames only by being overwritten\n");
  w_s(&mut out, " * whole, which can happen later and elsewhere. */\n");
  w_s(&mut out, "static inline bst_frame bst_pool_take_dirty(bst_pool *p, uint64_t i) { (void)p; return bst_page_at(i); }\n");
  w_s(&mut out, "static inline uint64_t bst_dirty_id(bst_frame d) { return bst_frame_id(d); }\n");
  w_s(&mut out, "static inline bst_frame bst_dirty_zero(bst_frame d) { bst_zero_page(d); return d; }\n");
  w_s(&mut out, "static inline bst_frame bst_frame_copy(bst_frame d, bst_frame src) { bst_copy_fwd((unsigned char *)d, (const unsigned char *)src, 4096); return d; }\n");
  w_s(&mut out, "#define bst_shared_copy bst_frame_copy\n");
  w_s(&mut out, "static inline bst_frame bst_dirty_fill(bst_frame d, bst_bytes src, uint64_t s) { bst_copy_fwd((unsigned char *)d, src.data + s, 4096); return d; }\n");
}

/// The prelude part for the AArch64 CPU: translation table loads, context switch state, the counter.
fn cg_prelude_kernel_cpu_a64(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "/* TTBR0_EL1 holds the top-level table (the kernel's is the platform's\n");
  w_s(&mut out, " * bst_kernel_root). Loading one also flushes this processor's TLB, as a\n");
  w_s(&mut out, " * CR3 load does on x86-64: the tables use no ASIDs, and the kernel's\n");
  w_s(&mut out, " * entries are cheap to walk again. The DSB before makes the table entries\n");
  w_s(&mut out, " * written so far visible to the walker. */\n");
  w_s(&mut out, "static inline void bst_load_root(uint64_t a) {\n");
  w_s(&mut out, "    __asm__ volatile (\"dsb ishst; msr ttbr0_el1, %0; isb; tlbi vmalle1; dsb nsh; isb\" : : \"r\"(a) : \"memory\");\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_read_root(void) { uint64_t a; __asm__ volatile (\"mrs %0, ttbr0_el1\" : \"=r\"(a)); return a; }\n");
  w_s(&mut out, "/* Three words per processor, zero at boot, if the platform keeps them: the\n");
  w_s(&mut out, " * table this processor parked (0: none), bst_pt_gen as of its last\n");
  w_s(&mut out, " * TTBR0 load, and how many locks it holds. Without them every switch\n");
  w_s(&mut out, " * loads TTBR0 at once. */\n");
  w_s(&mut out, "extern uint64_t *bst_platform_mmu_state(void) __attribute__((weak));\n");
  w_s(&mut out, "static inline uint64_t *bst_mmu_state(void) { return bst_platform_mmu_state ? bst_platform_mmu_state() : 0; }\n");
  w_s(&mut out, "static inline void bst_root_load(uint64_t *s, uint64_t a) {\n");
  w_s(&mut out, "    if (s) s[1] = __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    bst_load_root(a);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* Gives a parked table back: the kernel's tables go into TTBR0 first, then\n");
  w_s(&mut out, " * the lease's count drops, as bst_mmu_exit does without parking. */\n");
  w_s(&mut out, "static inline void bst_mmu_settle(void) {\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (!s || !s[0]) return;\n");
  w_s(&mut out, "    uint64_t l = s[0];\n");
  w_s(&mut out, "    s[0] = 0;\n");
  w_s(&mut out, "    bst_root_load(s, (uint64_t)bst_kernel_root);\n");
  w_s(&mut out, "    __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_mmu_settle_on(uint64_t t) {\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (s && s[0] == t) bst_mmu_settle();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_lock_depth(int d) {\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (!s) return;\n");
  w_s(&mut out, "    s[2] += (uint64_t)(int64_t)d;\n");
  w_s(&mut out, "    if (s[2] == 0 && s[0]) bst_mmu_settle();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_mmu_kernel(bst_mmu *m) { (void)m; bst_mmu_settle(); if (!BST_DEFERRED) bst_load_root((uint64_t)bst_kernel_root); }\n");
  w_s(&mut out, "/* A table this processor parked becomes the new lease without a second\n");
  w_s(&mut out, " * count. TTBR0 is loaded only if it holds another table, or if an entry was\n");
  w_s(&mut out, " * taken out of some table since the last load (bst_pt_gen). */\n");
  w_s(&mut out, "static inline bst_lease bst_mmu_enter(bst_mmu *m, bst_pt *t) {\n");
  w_s(&mut out, "    (void)m;\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (BST_DEFERRED) {\n");
  w_s(&mut out, "        __atomic_fetch_add(&bst_pt_leases[bst_frame_id(*t)], 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "        s[3] = *t;\n");
  w_s(&mut out, "        return *t;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (s && s[0] == *t) s[0] = 0;\n");
  w_s(&mut out, "    else __atomic_fetch_add(&bst_pt_leases[bst_frame_id(*t)], 1, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "    if (!s || bst_read_root() != *t || s[1] != __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST)) bst_root_load(s, *t);\n");
  w_s(&mut out, "    if (s && s[0]) {                    /* another table was parked, and TTBR0 has left it */\n");
  w_s(&mut out, "        uint64_t l = s[0];\n");
  w_s(&mut out, "        s[0] = 0;\n");
  w_s(&mut out, "        __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return *t;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* The count drops only once this processor no longer uses the table. Where\n");
  w_s(&mut out, " * the platform keeps bst_mmu_state, the table is parked instead: it stays\n");
  w_s(&mut out, " * in TTBR0 with its lease counted, so a process that runs again next (after\n");
  w_s(&mut out, " * a system call, say) costs no TLB flush. Every table maps the kernel's\n");
  w_s(&mut out, " * memory the same way (top-level entry 0, BST_PT_NEW_HOOK), and nothing proved\n");
  w_s(&mut out, " * reaches the user window without a lease, so kernel code runs the same\n");
  w_s(&mut out, " * either way. The lease goes back (bst_mmu_settle) when the processor\n");
  w_s(&mut out, " * enters another table, waits for a lock or an interrupt, lets go of its\n");
  w_s(&mut out, " * last lock without entering the table again, touches MMIO above 512 GiB\n");
  w_s(&mut out, " * (mapped only in the kernel's tables), returns from its smp_run function,\n");
  w_s(&mut out, " * or asks for that table's lease count. So other processors see the lease\n");
  w_s(&mut out, " * held no longer than if the process had trapped a moment later. */\n");
  w_s(&mut out, "static inline void bst_mmu_exit(bst_mmu *m, bst_lease l) {\n");
  w_s(&mut out, "    (void)m;\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    if (BST_DEFERRED) {\n");
  w_s(&mut out, "        s[3] = 0;\n");
  w_s(&mut out, "        __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "        return;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (s) {\n");
  w_s(&mut out, "        s[0] = l;\n");
  w_s(&mut out, "        return;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    bst_load_root((uint64_t)bst_kernel_root);\n");
  w_s(&mut out, "    __atomic_fetch_sub(&bst_pt_leases[bst_frame_id(l)], 1, __ATOMIC_RELEASE);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "/* A platform that tags user translations with an address-space number\n");
  w_s(&mut out, " * (BastiOS: ASIDs) learns here that the table `t` is gone: its number must\n");
  w_s(&mut out, " * not be handed to whoever gets the same page next. */\n");
  w_s(&mut out, "extern void bst_platform_table_free(uint64_t t) __attribute__((weak));\n");
  w_s(&mut out, "static inline bst_frame bst_pt_free_root(bst_mmu m, bst_pt t) {\n");
  w_s(&mut out, "    (void)m;\n");
  w_s(&mut out, "    if (bst_platform_table_free) bst_platform_table_free((uint64_t)t);\n");
  w_s(&mut out, "    return t;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Saved user registers: x0-x30 (0-30), sp_el0 (31), the return address\n");
  w_s(&mut out, " * elr_el1 (32), spsr_el1 (33), the syndrome esr_el1 (34), the fault\n");
  w_s(&mut out, " * address far_el1 (35), tpidr_el0 (36). */\n");
  w_s(&mut out, "extern uint64_t *bst_platform_ctx(void); /* this processor's saved context, 37 words */\n");
  w_s(&mut out, "/* Enter EL0 with eret and return the exception that ended it, with the\n");
  w_s(&mut out, " * context saved back: 128 for an SVC from AArch64 state, 14 for an\n");
  w_s(&mut out, " * instruction or data abort (far is then the address), 32 + n for interrupt\n");
  w_s(&mut out, " * n, and 6 for anything else (esr says what), as the x86-64 vectors the\n");
  w_s(&mut out, " * kernel already knows. Whatever the context holds, the platform enters EL0t\n");
  w_s(&mut out, " * with interrupts unmasked: of spsr it keeps only the condition flags. */\n");
  w_s(&mut out, "extern uint64_t bst_cpu_enter(void);\n");
  w_s(&mut out, "extern uint64_t bst_cpu_wait(void);    /* unmask interrupts, wfi, mask them; returns the interrupt */\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_get(bst_cpu c, uint64_t r) { (void)c; return bst_platform_ctx()[r]; }\n");
  w_s(&mut out, "static inline void bst_cpu_set(bst_cpu *c, uint64_t r, uint64_t v) { (void)c; bst_platform_ctx()[r] = v; }\n");
  w_s(&mut out, "/* The user's FP/SIMD state, in a page the kernel owns: q0-q31 (bytes\n");
  w_s(&mut out, " * 0-511), then FPSR and FPCR (512, 520). The kernel itself is built\n");
  w_s(&mut out, " * without FP/SIMD (-mgeneral-regs-only), so these registers hold the\n");
  w_s(&mut out, " * user's values. */\n");
  w_s(&mut out, "#define BST_FP_PAIRS(op) \\\n");
  w_s(&mut out, "    op \" q0, q1, [%0, #0]\\n\" op \" q2, q3, [%0, #32]\\n\" op \" q4, q5, [%0, #64]\\n\" op \" q6, q7, [%0, #96]\\n\" \\\n");
  w_s(&mut out, "    op \" q8, q9, [%0, #128]\\n\" op \" q10, q11, [%0, #160]\\n\" op \" q12, q13, [%0, #192]\\n\" op \" q14, q15, [%0, #224]\\n\" \\\n");
  w_s(&mut out, "    op \" q16, q17, [%0, #256]\\n\" op \" q18, q19, [%0, #288]\\n\" op \" q20, q21, [%0, #320]\\n\" op \" q22, q23, [%0, #352]\\n\" \\\n");
  w_s(&mut out, "    op \" q24, q25, [%0, #384]\\n\" op \" q26, q27, [%0, #416]\\n\" op \" q28, q29, [%0, #448]\\n\" op \" q30, q31, [%0, #480]\\n\"\n");
  w_s(&mut out, "static inline void bst_cpu_fpu_save(bst_cpu *c, bst_frame *f) {\n");
  w_s(&mut out, "    (void)c;\n");
  w_s(&mut out, "    uint64_t sr, cr;\n");
  w_s(&mut out, "    __asm__ volatile (BST_FP_PAIRS(\"stp\") : : \"r\"(*f) : \"memory\");\n");
  w_s(&mut out, "    __asm__ volatile (\"mrs %0, fpsr\\nmrs %1, fpcr\" : \"=r\"(sr), \"=r\"(cr));\n");
  w_s(&mut out, "    ((uint64_t *)*f)[64] = sr;\n");
  w_s(&mut out, "    ((uint64_t *)*f)[65] = cr;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_cpu_fpu_load(bst_cpu *c, bst_frame f) {\n");
  w_s(&mut out, "    (void)c;\n");
  w_s(&mut out, "    __asm__ volatile (BST_FP_PAIRS(\"ldp\") : : \"r\"(f) : \"memory\");\n");
  w_s(&mut out, "    __asm__ volatile (\"msr fpsr, %0\\nmsr fpcr, %1\" : : \"r\"(((uint64_t *)f)[64]), \"r\"(((uint64_t *)f)[65]) : \"memory\");\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_run(bst_cpu *c, bst_mmu m) {\n");
  w_s(&mut out, "    (void)c; (void)m;\n");
  w_s(&mut out, "    if (BST_DEFERRED) {\n");
  w_s(&mut out, "        /* bst_cpu_enter loads the table; word 1 tells it how many entries have\n");
  w_s(&mut out, "         * been taken out of any table so far, so it can flush this processor's\n");
  w_s(&mut out, "         * TLB if that moved since its last flush (translations are tagged with\n");
  w_s(&mut out, "         * the table's address-space number, so switching tables flushes nothing). */\n");
  w_s(&mut out, "        uint64_t *g = bst_mmu_state();\n");
  w_s(&mut out, "        g[1] = __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST);\n");
  w_s(&mut out, "        return bst_cpu_enter();\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    uint64_t *s = bst_mmu_state();\n");
  w_s(&mut out, "    /* flush the TLB if pages may have moved since the last load; at least\n");
  w_s(&mut out, "     * make the entries written so far visible to the walker */\n");
  w_s(&mut out, "    if (!s || s[1] != __atomic_load_n(&bst_pt_gen, __ATOMIC_SEQ_CST)) bst_root_load(s, bst_read_root());\n");
  w_s(&mut out, "    else __asm__ volatile (\"dsb ishst; isb\" : : : \"memory\");\n");
  w_s(&mut out, "    return bst_cpu_enter();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_idle(bst_cpu *c) { (void)c; bst_mmu_settle(); return bst_cpu_wait(); }\n");
  w_s(&mut out, "extern void bst_platform_smp_start(void (*fn)(void *), void *arg); /* run fn(arg) on every other processor */\n");
  w_s(&mut out, "extern void bst_platform_smp_join(void);                           /* wait until all of them have returned */\n");
  w_s(&mut out, "extern uint64_t bst_platform_cpus(void); /* processors running, this one included; 1 to 4096 */\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_count(bst_cpu c) { (void)c; return bst_platform_cpus(); }\n");
  w_s(&mut out, "/* The generic timer's virtual count, which ticks at a fixed rate (CNTFRQ_EL0). */\n");
  w_s(&mut out, "static inline uint64_t bst_cpu_tsc(bst_cpu c) { (void)c; uint64_t v; __asm__ volatile(\"isb; mrs %0, cntvct_el0\" : \"=r\"(v)); return v; }\n");
  w_s(&mut out, "/* A linear framebuffer the boot code set up: none yet on AArch64, so every\n");
  w_s(&mut out, " * field is 0, as on a PC without one. */\n");
  w_s(&mut out, "static uint64_t bst_boot_fb(bst_cpu c, uint64_t f) { (void)c; (void)f; return 0; }\n");
  w_s(&mut out, "/* Byte `off` of the ACPI table whose signature is `sig` (its four letters\n");
  w_s(&mut out, " * as a little-endian number; \"DSDT\" is the one the FADT points at), or 256\n");
  w_s(&mut out, " * past its end or without one. The platform finds the tables. */\n");
  w_s(&mut out, "extern uint64_t bst_platform_acpi(uint64_t sig, uint64_t off);\n");
  w_s(&mut out, "static inline uint64_t bst_boot_acpi(bst_cpu c, uint64_t sig, uint64_t off) { (void)c; return bst_platform_acpi(sig, off); }\n");
  w_s(&mut out, "/* Answer `i` to the platform's query `what` about the machine (its boot\n");
  w_s(&mut out, " * command line, memory map, processor, ...: the platform defines them), or\n");
  w_s(&mut out, " * 0. Read-only; nothing is promised about the number. */\n");
  w_s(&mut out, "extern uint64_t bst_platform_info(uint64_t what, uint64_t i);\n");
  w_s(&mut out, "static inline uint64_t bst_boot_info(bst_cpu c, uint64_t what, uint64_t i) { (void)c; return bst_platform_info(what, i); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Called by the platform on a fault in kernel mode: that is a bug in the\n");
  w_s(&mut out, " * trusted base or the compiler, never in verified code. */\n");
  w_s(&mut out, "void bst_kernel_fault(uint64_t vec, uint64_t pc, uint64_t far, uint64_t esr) {\n");
  w_s(&mut out, "    bst_puts(\"\\nbastio: kernel fault, vector \"); bst_puthex(vec);\n");
  w_s(&mut out, "    bst_puts(\" pc \"); bst_puthex(pc); bst_puts(\" far \"); bst_puthex(far); bst_puts(\" esr \"); bst_puthex(esr);\n");
  w_s(&mut out, "    bst_puts(\"\\n\");\n");
  w_s(&mut out, "    bst_halt();\n");
  w_s(&mut out, "}\n");
}

/// The prelude part for AArch64 MMIO barriers.
fn cg_prelude_mmio_kernel_a64(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "/* Device memory above 512 GiB is mapped only in the kernel's tables, so a\n");
  w_s(&mut out, " * parked user table (bst_mmu_exit) goes back before it is touched. Unlike\n");
  w_s(&mut out, " * x86-64, AArch64 lets normal memory accesses pass device ones, so as\n");
  w_s(&mut out, " * Linux's writel and readl do, a write waits for earlier writes (a device\n");
  w_s(&mut out, " * told to read a lent page sees what was put there) and later reads wait\n");
  w_s(&mut out, " * for a read (what a device wrote before it said so is seen). */\n");
  w_s(&mut out, "#define BST_MMIO_HIGH(a) do { if ((a) >= (1ull << 39)) bst_mmu_settle(); } while (0)\n");
  w_s(&mut out, "#define BST_MMIO_RW(w, t) \\\n");
  w_s(&mut out, "    static inline uint64_t bst_mmio_read##w(bst_mmio *m, uint64_t o) { BST_MMIO_HIGH(m->base + o); uint64_t v = *(volatile t *)(uintptr_t)(m->base + o); __asm__ volatile (\"dmb oshld\" : : : \"memory\"); return v; } \\\n");
  w_s(&mut out, "    static inline void bst_mmio_write##w(bst_mmio *m, uint64_t o, uint64_t v) { BST_MMIO_HIGH(m->base + o); __asm__ volatile (\"dmb oshst\" : : : \"memory\"); *(volatile t *)(uintptr_t)(m->base + o) = (t)v; }\n");
  w_s(&mut out, "BST_MMIO_RW(8, uint8_t) BST_MMIO_RW(16, uint16_t) BST_MMIO_RW(32, uint32_t) BST_MMIO_RW(64, uint64_t)\n");
}

/// The prelude part for an AArch64 user program: `svc` system calls.
fn cg_prelude_user_a64(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "static inline void bst_mmu_settle(void) { }\n");
  w_s(&mut out, "static inline void bst_lock_depth(int d) { (void)d; }\n");
  w_s(&mut out, "enum { BST_SYS_EXIT, BST_SYS_WRITE, BST_SYS_READ, BST_SYS_SPAWN, BST_SYS_WAIT, BST_SYS_YIELD,\n");
  w_s(&mut out, "       BST_SYS_GETPID, BST_SYS_INFO, BST_SYS_PS, BST_SYS_KILL, BST_SYS_POWEROFF };\n");
  w_s(&mut out, "/* A system call: `svc #0`, number in x8, arguments in x0-x2, result in x0. */\n");
  w_s(&mut out, "static inline uint64_t bst_sys(uint64_t n, uint64_t a, uint64_t b, uint64_t c) {\n");
  w_s(&mut out, "    register uint64_t x8 __asm__(\"x8\") = n;\n");
  w_s(&mut out, "    register uint64_t x0 __asm__(\"x0\") = a;\n");
  w_s(&mut out, "    register uint64_t x1 __asm__(\"x1\") = b;\n");
  w_s(&mut out, "    register uint64_t x2 __asm__(\"x2\") = c;\n");
  w_s(&mut out, "    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8), \"r\"(x1), \"r\"(x2) : \"memory\");\n");
  w_s(&mut out, "    return x0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static unsigned char bst_out[256];\n");
  w_s(&mut out, "static uint64_t bst_out_n;\n");
  w_s(&mut out, "static void bst_flush(void) {\n");
  w_s(&mut out, "    if (bst_out_n) bst_sys(BST_SYS_WRITE, (uint64_t)bst_out, bst_out_n, 0);\n");
  w_s(&mut out, "    bst_out_n = 0;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_serial_write(bst_serial s, uint64_t b) {\n");
  w_s(&mut out, "    (void)s;\n");
  w_s(&mut out, "    bst_out[bst_out_n++] = (unsigned char)b;\n");
  w_s(&mut out, "    if (b == '\\n' || bst_out_n == sizeof bst_out) bst_flush();\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_serial_read(bst_serial s) { (void)s; bst_flush(); return bst_sys(BST_SYS_READ, 0, 0, 0); }\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "#define BST_ARENA_WORDS (1u << 13)   /* 64 KiB */\n");
  w_s(&mut out, "static uint64_t bst_arena[BST_ARENA_WORDS];\n");
  w_s(&mut out, "static uint64_t bst_arena_top = 0;\n");
  w_s(&mut out, "typedef struct bst_free { uint64_t words; struct bst_free *next; } bst_free_t;\n");
  w_s(&mut out, "static bst_free_t *bst_free_list = 0;\n");
  w_s(&mut out, "/* An empty buffer with no memory when the arena is full. */\n");
  w_s(&mut out, "static bst_buf bst_try_alloc(uint64_t n) {\n");
  w_s(&mut out, "    uint64_t words = (n ? n : 1) + 1;\n");
  w_s(&mut out, "    if (words < 2) words = 2;\n");
  w_s(&mut out, "    bst_free_t **pp = &bst_free_list;\n");
  w_s(&mut out, "    for (bst_free_t *f = bst_free_list; f; pp = &f->next, f = f->next) {\n");
  w_s(&mut out, "        if (f->words == words) {\n");
  w_s(&mut out, "            *pp = f->next;\n");
  w_s(&mut out, "            uint64_t *blk = (uint64_t *)f;\n");
  w_s(&mut out, "            for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  w_s(&mut out, "            bst_buf b = { n, blk + 1 };\n");
  w_s(&mut out, "            return b;\n");
  w_s(&mut out, "        }\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    if (bst_arena_top + words > BST_ARENA_WORDS) {\n");
  w_s(&mut out, "        bst_buf none = { 0, 0 };\n");
  w_s(&mut out, "        return none;\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    uint64_t *blk = &bst_arena[bst_arena_top];\n");
  w_s(&mut out, "    bst_arena_top += words;\n");
  w_s(&mut out, "    blk[0] = words;\n");
  w_s(&mut out, "    for (uint64_t i = 1; i < words; i++) blk[i] = 0;\n");
  w_s(&mut out, "    bst_buf b = { n, blk + 1 };\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static bst_buf bst_alloc(uint64_t n) {\n");
  w_s(&mut out, "    bst_buf b = bst_try_alloc(n);\n");
  w_s(&mut out, "    if (!b.data) {\n");
  w_s(&mut out, "        static const char m[] = \"bastio: out of memory\\n\";\n");
  w_s(&mut out, "        bst_flush();\n");
  w_s(&mut out, "        bst_sys(BST_SYS_WRITE, (uint64_t)m, sizeof m - 1, 0);\n");
  w_s(&mut out, "        bst_sys(BST_SYS_EXIT, 255, 0, 0);\n");
  w_s(&mut out, "    }\n");
  w_s(&mut out, "    return b;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_free(bst_buf b) {\n");
  w_s(&mut out, "    if (!b.data) return;\n");
  w_s(&mut out, "    uint64_t *blk = b.data - 1;\n");
  w_s(&mut out, "    bst_free_t *f = (bst_free_t *)blk;\n");
  w_s(&mut out, "    f->words = blk[0];\n");
  w_s(&mut out, "    f->next = bst_free_list;\n");
  w_s(&mut out, "    bst_free_list = f;\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static void bst_print(uint64_t v) {\n");
  w_s(&mut out, "    char d[20]; int n = 0;\n");
  w_s(&mut out, "    do { d[n++] = (char)('0' + v % 10); v /= 10; } while (v);\n");
  w_s(&mut out, "    while (n) bst_serial_write(0, (unsigned char)d[--n]);\n");
  w_s(&mut out, "    bst_serial_write(0, '\\n');\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static uint64_t bst_sys_spawn(bst_buf b, uint64_t from, uint64_t to) {\n");
  w_s(&mut out, "    unsigned char name[64];\n");
  w_s(&mut out, "    uint64_t n = 0;\n");
  w_s(&mut out, "    for (uint64_t i = from; i < to && n < sizeof name; i++) name[n++] = (unsigned char)b.data[i];\n");
  w_s(&mut out, "    return bst_sys(BST_SYS_SPAWN, (uint64_t)name, n, 0);\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline uint64_t bst_sys_wait(uint64_t pid) { return bst_sys(BST_SYS_WAIT, pid, 0, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_kill(uint64_t pid) { return bst_sys(BST_SYS_KILL, pid, 0, 0); }\n");
  w_s(&mut out, "static inline void bst_sys_yield(void) { bst_sys(BST_SYS_YIELD, 0, 0, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_getpid(void) { return bst_sys(BST_SYS_GETPID, 0, 0, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_info(uint64_t k) { return bst_sys(BST_SYS_INFO, k, 0, 0); }\n");
  w_s(&mut out, "static inline void bst_sys_ps(void) { bst_flush(); bst_sys(BST_SYS_PS, 0, 0, 0); }\n");
  w_s(&mut out, "static inline void bst_sys_poweroff(void) { bst_flush(); bst_sys(BST_SYS_POWEROFF, 0, 0, 0); }\n");
  w_s(&mut out, "/* Calls with numbers the language does not know: the kernel defines them.\n");
  w_s(&mut out, " * sys_send lends the kernel bytes 0..n of b to read; sys_recv lends all of b\n");
  w_s(&mut out, " * to overwrite. Console output is flushed first so it stays in order. */\n");
  w_s(&mut out, "static inline uint64_t bst_sys_call(uint64_t n, uint64_t a, uint64_t b) { bst_flush(); return bst_sys(n, a, b, 0); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_send(uint64_t n, uint64_t a, bst_bytes b, uint64_t len) { bst_flush(); return bst_sys(n, a, (uint64_t)b.data, len); }\n");
  w_s(&mut out, "static inline uint64_t bst_sys_recv(uint64_t n, uint64_t a, bst_bytes *b) { bst_flush(); return bst_sys(n, a, (uint64_t)b->data, b->len); }\n");
}

/// The prelude part for AArch64 DMA pages, with the barriers a weakly ordered processor needs.
fn cg_prelude_dma_a64(out: &mut Vec[u64]) {
  w_s(&mut out, "static inline bst_dma bst_dma_lend(bst_frame f) { __atomic_thread_fence(__ATOMIC_SEQ_CST); return f; }\n");
  w_s(&mut out, "static inline bst_frame bst_dma_take(bst_dma d) { __atomic_thread_fence(__ATOMIC_SEQ_CST); return d; }\n");
  w_s(&mut out, "static inline uint64_t bst_dma_id(bst_dma d) { return bst_frame_id(d); }\n");
  w_s(&mut out, "static inline uint64_t bst_dma_addr(bst_dma d) { return d; }\n");
  w_s(&mut out, "/* A device writes a lent page in its own order and the processor may reorder\n");
  w_s(&mut out, " * its own loads and stores, so as Linux's dma_rmb and dma_wmb do, a read\n");
  w_s(&mut out, " * keeps later reads after it (what the device wrote before a flag it set is\n");
  w_s(&mut out, " * seen once the flag is) and a write waits for earlier writes (a device that\n");
  w_s(&mut out, " * sees it sees what came before). */\n");
  w_s(&mut out, "#define BST_DMA_RW(w, t) \\\n");
  w_s(&mut out, "    static inline uint64_t bst_dma_read##w(bst_dma *d, uint64_t o) { uint64_t v = *(volatile t *)(uintptr_t)(*d + o); __asm__ volatile (\"dmb oshld\" : : : \"memory\"); return v; } \\\n");
  w_s(&mut out, "    static inline void bst_dma_write##w(bst_dma *d, uint64_t o, uint64_t v) { __asm__ volatile (\"dmb oshst\" : : : \"memory\"); *(volatile t *)(uintptr_t)(*d + o) = (t)v; }\n");
  w_s(&mut out, "BST_DMA_RW(8, uint8_t) BST_DMA_RW(16, uint16_t) BST_DMA_RW(32, uint32_t) BST_DMA_RW(64, uint64_t)\n");
  w_s(&mut out, "/* A copy to or from a lent page is ordered the same way: after the reads\n");
  w_s(&mut out, " * before it, and before the writes after it. */\n");
  w_s(&mut out, "static inline void bst_dma_to_bytes(bst_bytes *dst, uint64_t d, bst_dma *m, uint64_t o, uint64_t n) {\n");
  w_s(&mut out, "    __asm__ volatile (\"dmb osh\" : : : \"memory\");\n");
  w_s(&mut out, "    if (n) bst_copy_fwd(dst->data + d, (const unsigned char *)(uintptr_t)(*m + o), n);\n");
  w_s(&mut out, "    __asm__ volatile (\"dmb osh\" : : : \"memory\");\n");
  w_s(&mut out, "}\n");
  w_s(&mut out, "static inline void bst_bytes_to_dma(bst_dma *m, uint64_t o, bst_bytes src, uint64_t s, uint64_t n) {\n");
  w_s(&mut out, "    __asm__ volatile (\"dmb osh\" : : : \"memory\");\n");
  w_s(&mut out, "    if (n) bst_copy_fwd((unsigned char *)(uintptr_t)(*m + o), src.data + s, n);\n");
  w_s(&mut out, "    __asm__ volatile (\"dmb osh\" : : : \"memory\");\n");
  w_s(&mut out, "}\n");
}

const PART_POSIX: u64 = 0;
const PART_COMMON: u64 = 1;
const PART_HOSTED: u64 = 2;
const PART_BYTES: u64 = 3;
const PART_PT_HOOK_HOSTED: u64 = 4;
const PART_PAGES: u64 = 5;
const PART_CHILD: u64 = 6;
const PART_PORTS: u64 = 7;
const PART_PORTS_HOSTED: u64 = 8;
const PART_MMIO: u64 = 9;
const PART_MMIO_HOSTED: u64 = 10;
const PART_DMA: u64 = 11;
const PART_KERNEL: u64 = 12;
const PART_BYTES_ARENA: u64 = 13;
const PART_KERNEL_CPU: u64 = 14;
const PART_PORTS_KERNEL: u64 = 15;
const PART_MMIO_KERNEL: u64 = 16;
const PART_USER: u64 = 17;
const PART_KERNEL_A64: u64 = 18;
const PART_PAGES_A64: u64 = 19;
const PART_KERNEL_CPU_A64: u64 = 20;
const PART_MMIO_KERNEL_A64: u64 = 21;
const PART_USER_A64: u64 = 22;
const PART_DMA_A64: u64 = 23;
/// Not in any target's list (stage0 has no such part): see `cg_prelude_net`.
const PART_NET: u64 = 24;

fn cg_part_name(id: u64) -> Str {
  if id == PART_POSIX { return "posix"; }
  if id == PART_COMMON { return "common"; }
  if id == PART_HOSTED { return "hosted"; }
  if id == PART_BYTES { return "bytes"; }
  if id == PART_PT_HOOK_HOSTED { return "pt_hook_hosted"; }
  if id == PART_PAGES { return "pages"; }
  if id == PART_CHILD { return "child"; }
  if id == PART_PORTS { return "ports"; }
  if id == PART_PORTS_HOSTED { return "ports_hosted"; }
  if id == PART_MMIO { return "mmio"; }
  if id == PART_MMIO_HOSTED { return "mmio_hosted"; }
  if id == PART_DMA { return "dma"; }
  if id == PART_KERNEL { return "kernel"; }
  if id == PART_BYTES_ARENA { return "bytes_arena"; }
  if id == PART_KERNEL_CPU { return "kernel_cpu"; }
  if id == PART_PORTS_KERNEL { return "ports_kernel"; }
  if id == PART_MMIO_KERNEL { return "mmio_kernel"; }
  if id == PART_KERNEL_A64 { return "kernel_a64"; }
  if id == PART_PAGES_A64 { return "pages_a64"; }
  if id == PART_KERNEL_CPU_A64 { return "kernel_cpu_a64"; }
  if id == PART_MMIO_KERNEL_A64 { return "mmio_kernel_a64"; }
  if id == PART_USER_A64 { return "user_a64"; }
  if id == PART_DMA_A64 { return "dma_a64"; }
  if id == PART_NET { return "net"; }
  return "user";
}

fn cg_part(out: &mut Vec[u64], id: u64) {
  if id == PART_POSIX {
    // POSIX for the child-process functions; set before any header.
    w_s(&mut out, "#define _POSIX_C_SOURCE 200809L\n");
  } else if id == PART_COMMON { cg_prelude_common(&mut out); }
  else if id == PART_HOSTED { cg_prelude_hosted(&mut out); }
  else if id == PART_BYTES { cg_prelude_bytes(&mut out); }
  else if id == PART_PT_HOOK_HOSTED { w_s(&mut out, "#define BST_PT_NEW_HOOK (void)level;\nstatic inline void bst_mmu_settle_on(uint64_t t) { (void)t; }\n"); }
  else if id == PART_PAGES { cg_prelude_pages(&mut out); }
  else if id == PART_CHILD { cg_prelude_child(&mut out); }
  else if id == PART_PORTS { cg_prelude_ports(&mut out); }
  else if id == PART_PORTS_HOSTED { cg_prelude_ports_hosted(&mut out); }
  else if id == PART_MMIO { cg_prelude_mmio(&mut out); }
  else if id == PART_MMIO_HOSTED { cg_prelude_mmio_hosted(&mut out); }
  else if id == PART_DMA { cg_prelude_dma(&mut out); }
  else if id == PART_KERNEL { cg_prelude_kernel(&mut out); }
  else if id == PART_BYTES_ARENA { cg_prelude_bytes_arena(&mut out); }
  else if id == PART_KERNEL_CPU { cg_prelude_kernel_cpu(&mut out); }
  else if id == PART_PORTS_KERNEL { cg_prelude_ports_kernel(&mut out); }
  else if id == PART_MMIO_KERNEL { cg_prelude_mmio_kernel(&mut out); }
  else if id == PART_KERNEL_A64 { cg_prelude_kernel_a64(&mut out); }
  else if id == PART_PAGES_A64 { cg_prelude_pages_a64(&mut out); }
  else if id == PART_KERNEL_CPU_A64 { cg_prelude_kernel_cpu_a64(&mut out); }
  else if id == PART_MMIO_KERNEL_A64 { cg_prelude_mmio_kernel_a64(&mut out); }
  else if id == PART_USER_A64 { cg_prelude_user_a64(&mut out); }
  else if id == PART_DMA_A64 { cg_prelude_dma_a64(&mut out); }
  else if id == PART_NET { cg_prelude_net(&mut out); }
  else { cg_prelude_user(&mut out); }
}

/// The parts of target `target`'s prelude for architecture `arch`, in
/// stage0's order (`prelude_parts`) for x86-64. The AArch64 kernel and user
/// parts are stage1's own: stage0 has no AArch64 bare-metal targets. A
/// hosted program is the same C on either architecture.
fn cg_parts(target: u64, arch: u64) -> Vec[u64] {
  let mut v = vec_new[u64]();
  if arch == ARCH_AARCH64 && target == TARGET_KERNEL {
    vec_push(&mut v, PART_COMMON);
    vec_push(&mut v, PART_KERNEL_A64);
    vec_push(&mut v, PART_BYTES_ARENA);
    vec_push(&mut v, PART_BYTES);
    vec_push(&mut v, PART_PAGES_A64);
    vec_push(&mut v, PART_KERNEL_CPU_A64);
    vec_push(&mut v, PART_MMIO);
    vec_push(&mut v, PART_MMIO_KERNEL_A64);
    vec_push(&mut v, PART_DMA_A64);
  } else if arch == ARCH_AARCH64 && target == TARGET_USER {
    vec_push(&mut v, PART_COMMON);
    vec_push(&mut v, PART_USER_A64);
    vec_push(&mut v, PART_BYTES_ARENA);
    vec_push(&mut v, PART_BYTES);
  } else if target == TARGET_KERNEL {
    vec_push(&mut v, PART_COMMON);
    vec_push(&mut v, PART_KERNEL);
    vec_push(&mut v, PART_BYTES_ARENA);
    vec_push(&mut v, PART_BYTES);
    vec_push(&mut v, PART_PAGES);
    vec_push(&mut v, PART_KERNEL_CPU);
    vec_push(&mut v, PART_PORTS);
    vec_push(&mut v, PART_PORTS_KERNEL);
    vec_push(&mut v, PART_MMIO);
    vec_push(&mut v, PART_MMIO_KERNEL);
    vec_push(&mut v, PART_DMA);
  } else if target == TARGET_USER {
    vec_push(&mut v, PART_COMMON);
    vec_push(&mut v, PART_USER);
    vec_push(&mut v, PART_BYTES_ARENA);
    vec_push(&mut v, PART_BYTES);
  } else {
    vec_push(&mut v, PART_POSIX);
    vec_push(&mut v, PART_COMMON);
    vec_push(&mut v, PART_HOSTED);
    vec_push(&mut v, PART_BYTES);
    vec_push(&mut v, PART_PT_HOOK_HOSTED);
    vec_push(&mut v, PART_PAGES);
    vec_push(&mut v, PART_CHILD);
    vec_push(&mut v, PART_PORTS);
    vec_push(&mut v, PART_PORTS_HOSTED);
    vec_push(&mut v, PART_MMIO);
    vec_push(&mut v, PART_MMIO_HOSTED);
    vec_push(&mut v, PART_DMA);
  }
  return v;
}

/// Target `target`'s prelude for architecture `arch`.
fn cg_prelude(out: &mut Vec[u64], target: u64, arch: u64) {
  let parts = cg_parts(target, arch);
  let mut k = 0;
  while k < vec_len(parts) {
    cg_part(&mut out, vec_get(parts, k));
    k = k + 1;
  }
  vec_free(parts);
}
