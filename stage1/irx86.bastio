// IR to x86-64 (docs/ir.md): the emitter for the IR of stage1/ir.bastio and
// the registers chosen by stage1/irra.bastio, behind `--backend native-ir`.
//
// `x86_program_ir` is `x86_program` with one difference: each function is
// lowered to the IR first, and a function the IR handles is written from
// it; any other (a node outside the IR's subset, a calling convention the
// emitter does not reproduce) goes through the generator of x86.bastio
// as before. Both write into the same file with the same calling convention
// (docs: `x86_regargs`, `x86_regret`), so the two kinds of function call
// each other. Hosted target only.
//
// Registers. The allocator is given the six callee-saved registers (%rbp
// among them: the frame is addressed from %rsp, see `ix_fpo`, and the
// function is written again with five when that cannot be done) and
// four of the caller-saved ones (%r8-%r11); the emitter keeps %rax, %rcx,
// %rdx, %rsi and %rdi to itself, so no value shares a register with an
// argument of a call. Spilled values and the slots of `IR_SLOT` live in the
// frame below the saved registers. The code is a plain walk of the
// instructions: operands are used from where the allocator put them, a
// result is computed in its own register when it has one.
import "x86.bastio";
import "irra.bastio";
import "iropt.bastio";
import "iropt_inline.bastio";

/// A frame holds the saved registers, the spilled values and the slots; an
/// instruction count past this goes to the old generator (the allocator is
/// quadratic).
const IX_MAX_INS: u64 = 40000;

/// Where a value is: machine register `reg` (an XR_ number; k = IXK_REG),
/// the frame word `off` words below %rbp (IXK_MEM) or a constant `imm`
/// (IXK_IMM, a register the allocator left out because it is only ever one
/// constant).
const IXK_REG: u64 = 1;
const IXK_MEM: u64 = 2;
const IXK_IMM: u64 = 3;

struct IxL { k: u64, reg: u64, off: u64, imm: u64 }

fn ix_rl(r: u64) -> IxL {
  return IxL { k: IXK_REG, reg: r, off: 0, imm: 0 };
}

fn ix_ml(off: u64) -> IxL {
  return IxL { k: IXK_MEM, reg: 0, off: off, imm: 0 };
}

fn ix_il(v: u64) -> IxL {
  return IxL { k: IXK_IMM, reg: 0, off: 0, imm: v };
}

/// Does `v` fit the signed 32-bit immediate of most instructions?
fn ix_fits(v: u64) -> bool {
  return v <= 2147483647 || v >= 18446744071562067968;
}

fn ix_callee(i: u64) -> u64 {
  if i == 0 { return XR_RBX; }
  if i == 1 { return XR_R12; }
  if i == 2 { return XR_R13; }
  if i == 3 { return XR_R14; }
  if i == 4 { return XR_R15; }
  return XR_RBP;
}

fn ix_caller(i: u64) -> u64 {
  if i == 0 { return XR_R8; }
  if i == 1 { return XR_R9; }
  if i == 2 { return XR_R10; }
  return XR_R11;
}

/// Where virtual register `r` lives.
fn ix_loc(al: &IrAlloc, r: u64) -> IxL {
  if u_at(al.cst, r) == 1 {
    return ix_il(u_at(al.cv, r));
  }
  let cls = u_at(al.cls, r);
  let idx = u_at(al.idx, r);
  if cls == RA_CALLEE {
    return ix_rl(ix_callee(idx));
  }
  if cls == RA_CALLER {
    return ix_rl(ix_caller(idx));
  }
  return ix_ml(wrap_add(wrap_add(al.ncallee_used, 1), idx));
}

/// The immediate `v` as an assembler operand (`v` fits 32 bits).
fn ix_w_imm(out: &mut Vec[u64], v: u64) {
  w_s(&mut out, "$");
  if v <= 2147483647 {
    w_num(&mut out, v);
  } else {
    w_s(&mut out, "-");
    w_num(&mut out, wrap_sub(0, v));
  }
}

fn ix_op(out: &mut Vec[u64], l: IxL) {
  if l.k == IXK_REG {
    w_s(&mut out, x86_rname(l.reg));
  } else if l.k == IXK_IMM {
    ix_w_imm(&mut out, l.imm);
  } else if l.off >= 9223372036854775808 {
    // Above the frame pointer: an argument's own stack word.
    w_num(&mut out, wrap_mul(8, wrap_sub(0, l.off)));
    w_s(&mut out, "(%fp)");
  } else {
    vec_push(&mut out, 45);
    w_num(&mut out, wrap_mul(8, l.off));
    w_s(&mut out, "(%fp)");
  }
}

fn ix_same(a: IxL, b: IxL) -> bool {
  return a.k == b.k && a.reg == b.reg && a.off == b.off && a.imm == b.imm;
}

/// `name a, b` (AT&T: the source first).
fn ix_ins2(out: &mut Vec[u64], name: Str, a: IxL, b: IxL) {
  w_s(&mut out, "\t");
  w_s(&mut out, name);
  w_s(&mut out, " ");
  ix_op(&mut out, a);
  w_s(&mut out, ", ");
  ix_op(&mut out, b);
  w_s(&mut out, "\n");
}

/// `to = from`, through %rax when that takes two instructions.
fn ix_mov(out: &mut Vec[u64], from: IxL, to: IxL) {
  if ix_same(from, to) {
    return;
  }
  if from.k == IXK_IMM {
    if !ix_fits(from.imm) {
      let mut t = to;
      if to.k != IXK_REG {
        t = ix_rl(XR_RAX);
      }
      w_s(&mut out, "\tmovabs $");
      w_num(&mut out, from.imm);
      w_s(&mut out, ", ");
      ix_op(&mut out, t);
      w_s(&mut out, "\n");
      if to.k != IXK_REG {
        ix_ins2(&mut out, "mov", t, to);
      }
    } else if to.k == IXK_REG {
      ix_ins2(&mut out, "mov", from, to);
    } else {
      ix_ins2(&mut out, "movq", from, to);
    }
  } else if from.k == IXK_MEM && to.k == IXK_MEM {
    ix_ins2(&mut out, "mov", from, ix_rl(XR_RAX));
    ix_ins2(&mut out, "mov", ix_rl(XR_RAX), to);
  } else {
    ix_ins2(&mut out, "mov", from, to);
  }
}

/// `from` as the source operand of an instruction that takes a 32-bit
/// immediate, a register or memory: a larger constant goes through %rcx.
fn ix_src(out: &mut Vec[u64], from: IxL) -> IxL {
  if from.k == IXK_IMM && !ix_fits(from.imm) {
    ix_mov(&mut out, from, ix_rl(XR_RCX));
    return ix_rl(XR_RCX);
  }
  return from;
}

fn ix_push(out: &mut Vec[u64], from: IxL) {
  let l = ix_src(&mut out, from);
  w_s(&mut out, "\tpush ");
  ix_op(&mut out, l);
  w_s(&mut out, "\n");
}

/// The register that holds virtual register `r`: its own, or `scratch` after
/// loading it.
fn ix_use(out: &mut Vec[u64], al: &IrAlloc, r: u64, scratch: u64) -> u64 {
  let l = ix_loc(al, r);
  if l.k == IXK_REG {
    return l.reg;
  }
  ix_mov(&mut out, l, ix_rl(scratch));
  return scratch;
}

/// `d = <machine register t>`.
struct IxMagic { ok: bool, m: u64, sh: u64 }

/// The multiplier and shift of an unsigned division by `d` (not a power of
/// two, below 2^63) without a shift of the dividend first: q = mulhi(n, m) >>
/// sh, with m = ceil(2^(64 + sh) / d) fitting 64 bits and the error below
/// 2^sh, which makes it exact for every 64-bit n.
fn ix_div_magic(d: u64) -> IxMagic {
  let mut r = IxMagic { ok: false, m: 0, sh: 0 };
  if d < 3 || d >= 9223372036854775808 || d & wrap_sub(d, 1) == 0 {
    return r;
  }
  let mut sh = 0;
  let mut p2 = 1;
  while sh < 63 && p2 < d && !r.ok {
    let qr = x86_longdiv(p2, d);
    if qr.r == 0 || qr.q < 18446744073709551615 {
      let mut ex = 0;
      if qr.r != 0 {
        ex = wrap_sub(d, qr.r);
      }
      if ex <= p2 {
        r = IxMagic { ok: true, m: wrap_add(qr.q, x86_ne0(qr.r)), sh: sh };
      }
    }
    sh = sh + 1;
    p2 = wrap_mul(p2, 2);
  }
  return r;
}

fn ix_finish(out: &mut Vec[u64], al: &IrAlloc, d: u64, t: u64) {
  ix_mov(&mut out, ix_rl(t), ix_loc(al, d));
}

/// The 32-bit and 8-bit names of the registers the emitter can use.
fn ix_name32(r: u64) -> Str {
  if r == XR_RAX { return "%eax"; }
  if r == XR_RCX { return "%ecx"; }
  if r == XR_RDX { return "%edx"; }
  if r == XR_RSI { return "%esi"; }
  if r == XR_RDI { return "%edi"; }
  if r == XR_RBX { return "%ebx"; }
  if r == XR_R12 { return "%r12d"; }
  if r == XR_R13 { return "%r13d"; }
  if r == XR_R14 { return "%r14d"; }
  if r == XR_R15 { return "%r15d"; }
  if r == XR_R8 { return "%r8d"; }
  if r == XR_R9 { return "%r9d"; }
  if r == XR_R10 { return "%r10d"; }
  if r == XR_RBP { return "%ebp"; }
  return "%r11d";
}

fn ix_name16(r: u64) -> Str {
  if r == XR_RAX { return "%ax"; }
  if r == XR_RCX { return "%cx"; }
  if r == XR_RDX { return "%dx"; }
  if r == XR_RSI { return "%si"; }
  if r == XR_RDI { return "%di"; }
  if r == XR_RBX { return "%bx"; }
  if r == XR_R12 { return "%r12w"; }
  if r == XR_R13 { return "%r13w"; }
  if r == XR_R14 { return "%r14w"; }
  if r == XR_R15 { return "%r15w"; }
  if r == XR_R8 { return "%r8w"; }
  if r == XR_R9 { return "%r9w"; }
  if r == XR_R10 { return "%r10w"; }
  if r == XR_RBP { return "%bp"; }
  return "%r11w";
}

fn ix_name8(r: u64) -> Str {
  if r == XR_RAX { return "%al"; }
  if r == XR_RCX { return "%cl"; }
  if r == XR_RDX { return "%dl"; }
  if r == XR_RSI { return "%sil"; }
  if r == XR_RDI { return "%dil"; }
  if r == XR_RBX { return "%bl"; }
  if r == XR_R12 { return "%r12b"; }
  if r == XR_R13 { return "%r13b"; }
  if r == XR_R14 { return "%r14b"; }
  if r == XR_R15 { return "%r15b"; }
  if r == XR_R8 { return "%r8b"; }
  if r == XR_R9 { return "%r9b"; }
  if r == XR_R10 { return "%r10b"; }
  if r == XR_RBP { return "%bpl"; }
  return "%r11b";
}

/// The address `(base,index,8)` or `(base,index)`.
fn ix_w_addr(out: &mut Vec[u64], rb: u64, ri: u64, size: u64) {
  w_s(&mut out, "(");
  w_s(&mut out, x86_rname(rb));
  w_s(&mut out, ",");
  w_s(&mut out, x86_rname(ri));
  if size == 8 {
    w_s(&mut out, ",8");
  }
  w_s(&mut out, ")");
}

/// The address `a[b]` once its parts are in registers (`ri` is 0 for a
/// constant index `imm`).
struct IxA { rb: u64, ri: u64, imm: u64, sw: u64, disp: u64 }

/// Loads what the address `a[b]` needs into %rsi and %rdi when it is not in
/// registers. The address of a frame slot (`al.cst` 2 or 3, see
/// `ix_fold_slots`) needs no register: it is written off %rbp.
fn ix_aprep(out: &mut Vec[u64], al: &IrAlloc, a: u64, b: u64, disp: u64) -> IxA {
  let mut rb = XR_RBP;
  let mut sw = 0;
  if u_at(al.cst, a) >= 2 {
    sw = u_at(al.cv, a);
  } else {
    rb = ix_use(&mut out, al, a, XR_RSI);
  }
  let lb = ix_loc(al, b);
  if lb.k == IXK_IMM && wrap_add(lb.imm, disp) < 268435456 {
    return IxA { rb: rb, ri: 0, imm: wrap_add(lb.imm, disp), sw: sw, disp: 0 };
  }
  return IxA { rb: rb, ri: ix_use(&mut out, al, b, XR_RDI), imm: 0, sw: sw, disp: disp };
}

fn ix_awrite(out: &mut Vec[u64], ap: IxA, size: u64) {
  if ap.sw != 0 {
    // A frame slot: one signed displacement off the frame register.
    let mut up = wrap_mul(ap.imm, size);
    if ap.ri != 0 {
      up = wrap_mul(ap.disp, size);
    }
    let down = wrap_mul(8, ap.sw);
    if up >= down {
      w_num(&mut out, wrap_sub(up, down));
    } else {
      w_s(&mut out, "-");
      w_num(&mut out, wrap_sub(down, up));
    }
    if ap.ri == 0 {
      w_s(&mut out, "(%fp)");
    } else {
      w_s(&mut out, "(%fp,");
      w_s(&mut out, x86_rname(ap.ri));
      if size == 8 {
        w_s(&mut out, ",8");
      }
      w_s(&mut out, ")");
    }
  } else if ap.ri == 0 {
    w_num(&mut out, wrap_mul(ap.imm, size));
    w_s(&mut out, "(");
    w_s(&mut out, x86_rname(ap.rb));
    w_s(&mut out, ")");
  } else {
    if ap.disp != 0 {
      w_num(&mut out, wrap_mul(ap.disp, size));
    }
    ix_w_addr(&mut out, ap.rb, ap.ri, size);
  }
}

fn ix_lbl(out: &mut Vec[u64], x: u64, l: u64) {
  w_s(&mut out, ".Lir");
  w_num(&mut out, x);
  w_s(&mut out, "_");
  w_num(&mut out, l);
}

fn ix_jump(out: &mut Vec[u64], name: Str, x: u64, l: u64) {
  w_s(&mut out, "\t");
  w_s(&mut out, name);
  w_s(&mut out, " ");
  ix_lbl(&mut out, x, l);
  w_s(&mut out, "\n");
}

fn ix_is_cmp(op: u64) -> bool {
  return op >= IR_EQ && op <= IR_SGE;
}

/// The condition-code suffix of comparison `op`.
fn ix_cc(op: u64) -> Str {
  if op == IR_EQ { return "e"; }
  if op == IR_NE { return "ne"; }
  if op == IR_LT { return "b"; }
  if op == IR_LE { return "be"; }
  if op == IR_GT { return "a"; }
  if op == IR_GE { return "ae"; }
  if op == IR_SLT { return "l"; }
  if op == IR_SLE { return "le"; }
  if op == IR_SGT { return "g"; }
  return "ge";
}

/// The comparison that is true when `op` is false.
fn ix_not(op: u64) -> u64 {
  if op == IR_EQ { return IR_NE; }
  if op == IR_NE { return IR_EQ; }
  if op == IR_LT { return IR_GE; }
  if op == IR_GE { return IR_LT; }
  if op == IR_LE { return IR_GT; }
  if op == IR_GT { return IR_LE; }
  if op == IR_SLT { return IR_SGE; }
  if op == IR_SGE { return IR_SLT; }
  if op == IR_SLE { return IR_SGT; }
  return IR_SLE;
}

/// Writes the comparison of `a` with `b` (the flags for `a ? b`).
/// Does the last line written to `out` start with `pre` and end with `, suf`
/// (and its newline)?
fn ix_last_line(out: &Vec[u64], pre: Str, suf: Str) -> bool {
  let n = vec_len(out);
  if n == 0 || vec_get(out, n - 1) != 10 {
    return false;
  }
  let mut s = n - 1;                 // the start of the line
  while s > 0 && vec_get(out, s - 1) != 10
    invariant s <= n - 1 && n == vlen(out)
  {
    s = s - 1;
  }
  let len = n - 1 - s;               // without the newline
  if len < slen(pre) + slen(suf) + 2 {
    return false;
  }
  // the register stands after a comma and a space
  if vec_get(out, n - 1 - slen(suf) - 2) != 44 || vec_get(out, n - 1 - slen(suf) - 1) != 32 {
    return false;
  }
  let mut k = 0;
  while k < slen(pre)
    invariant k <= slen(pre) && s + slen(pre) <= n - 1 && n == vlen(out)
  {
    if vec_get(out, s + k) != cast[u64](sget(pre, k)) {
      return false;
    }
    k = k + 1;
  }
  let mut j = 0;
  while j < slen(suf)
    invariant j <= slen(suf) && slen(suf) <= len && n == vlen(out)
  {
    if vec_get(out, n - 1 - slen(suf) + j) != cast[u64](sget(suf, j)) {
      return false;
    }
    j = j + 1;
  }
  return true;
}

/// Is the text from `mark` to the end of `out` the same as the text of the
/// same length just before `mark`? (The same instructions written twice in
/// a row.)
fn ix_repeats(out: &Vec[u64], mark: u64) -> bool {
  let n = vec_len(out);
  if mark > n || n - mark > mark || mark == n {
    return false;
  }
  let len = n - mark;
  let mut k = 0;
  while k < len
    invariant k <= len && len <= mark && mark < n && n == vlen(out)
  {
    if vec_get(out, mark + k) != vec_get(out, mark - len + k) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

fn ix_cmp(out: &mut Vec[u64], al: &IrAlloc, a: u64, b: u64) {
  let mut la = ix_loc(al, a);
  let lb = ix_src(&mut out, ix_loc(al, b));
  if la.k == IXK_IMM || (la.k == IXK_MEM && lb.k == IXK_MEM) {
    ix_mov(&mut out, la, ix_rl(XR_RAX));
    la = ix_rl(XR_RAX);
  }
  if lb.k == IXK_IMM && lb.imm == 0 && la.k == IXK_REG && (ix_last_line(out, "\tand ", x86_rname(la.reg)) || ix_last_line(out, "\tor ", x86_rname(la.reg))) {
    // `and` and `or` set the flags as a comparison with zero does.
  } else if la.k == IXK_MEM && lb.k == IXK_IMM {
    // An immediate against memory needs its width (`cmp` alone is 32 bits).
    ix_ins2(&mut out, "cmpq", lb, la);
  } else {
    ix_ins2(&mut out, "cmp", lb, la);
  }
}

/// A byte `load` at `i` that only the `eq` or `ne` after it reads, whose other
/// operand is the byte loaded by the instruction before (in a register, read
/// by nothing else than that compare), and a branch on the compare after it:
/// the register of the other operand, or IR_NONE.
fn ix_ld8cmp(f: &IrFn, al: &IrAlloc, nuse: &Vec[u64], i: u64) -> u64 {
  if i == 0 || i > 100000000 {
    return IR_NONE;
  }
  let q = ix_at(f, i);
  let pq = ix_at(f, i - 1);
  let cq = ix_at(f, i + 1);
  let bq = ix_at(f, i + 2);
  if q.op != IR_LOAD || q.c != 1 || pq.op != IR_LOAD || pq.c != 1 || (cq.op != IR_EQ && cq.op != IR_NE) || bq.op != IR_BR || bq.a != cq.d {
    return IR_NONE;
  }
  if u_at(nuse, q.d) != 1 || u_at(nuse, cq.d) != 1 || u_at(nuse, pq.d) != 1 {
    return IR_NONE;
  }
  if !((cq.a == pq.d && cq.b == q.d) || (cq.b == pq.d && cq.a == q.d)) {
    return IR_NONE;
  }
  let lo = ix_loc(al, pq.d);
  if lo.k != IXK_REG {
    return IR_NONE;
  }
  return pq.d;
}

/// The comparison before a branch on `op`, and the condition to branch on.
/// An unsigned `a > 0` or `a <= 0` is a test of ZF alone (`a != 0`, `a == 0`),
/// so when the instruction just written is an `add` or `sub` into the
/// register `a` (the step of a countdown), its flags are the comparison's.
fn ix_cmp_br(out: &mut Vec[u64], al: &IrAlloc, a: u64, b: u64, op: u64) -> u64 {
  let la = ix_loc(al, a);
  let lb = ix_loc(al, b);
  if lb.k == IXK_IMM && lb.imm == 0 && la.k == IXK_REG && (op == IR_GT || op == IR_LE)
     && (ix_last_line(out, "\tsub ", x86_rname(la.reg)) || ix_last_line(out, "\tadd ", x86_rname(la.reg))) {
    if op == IR_GT {
      return IR_NE;
    }
    return IR_EQ;
  }
  ix_cmp(&mut out, al, a, b);
  return op;
}

/// The symbol of function instance `x`.
fn ix_sym(out: &mut Vec[u64], g: &mut X86, m: &Mono, p: &Parser, x: u64) {
  x86_sym(&mut g, m, p, x);
  w_append(&mut out, g.ln);
  while vec_len(g.ln) > 0 {
    vec_pop(&mut g.ln);
  }
}

/// Is `t` a Buf or Bytes? The IR holds one as (data address, length); the
/// generator of x86.bastio as (length, data address), the length being the
/// word at the lower address, in %rax or the first argument register.
fn ix_buffer(c: &Checker, m: &Mono, p: &Parser, t: u64) -> bool {
  let k = ir_kind(c, m, p, t);
  return k == IRK_BUF || k == IRK_BYTES || k == IRK_STR;
}

/// For each word of the parameters of `x` in the order of the IR (the
/// first parameter's first word first), its position in the calling
/// convention: counted from the last parameter's first word, which is the
/// first argument register or the stack word nearest the return address.
fn ix_positions(g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, x: u64) -> Vec[u64] {
  let xi = inst_at(m, x);
  let dn = node_at(p.nodes, xi.def);
  let mut ws = vec_new[u64]();
  let mut sw = vec_new[u64]();
  let mut q = dn.a;
  while q != 0 {
    let qn = node_at(p.nodes, q);
    let pt = conv(&mut m, p, qn.a, x, q);
    vec_push(&mut ws, x86_pwords(&mut g, c, m, p, pt));
    if ix_buffer(c, m, p, pt) {
      vec_push(&mut sw, 1);
    } else {
      vec_push(&mut sw, 0);
    }
    q = qn.next;
  }
  let mut starts = vec_new[u64]();
  let mut total = 0;
  let mut i = 0;
  while i < vec_len(ws) {
    vec_push(&mut starts, total);
    total = wrap_add(total, vec_get(ws, i));
    i = i + 1;
  }
  let mut pos = vec_new[u64]();
  let mut z = 0;
  while z < total && z < 100000 {
    vec_push(&mut pos, 0);
    z = z + 1;
  }
  let mut after = 0;
  i = vec_len(ws);
  while i > 0
    invariant i <= vlen(ws)
  {
    i = i - 1;
    let w = vec_get(ws, i);
    let mut j = 0;
    while j < w && j < 100000 {
      let mut at = j;
      if u_at(sw, i) == 1 && w == 2 {
        at = 1 - j;
      }
      ra_set(&mut pos, wrap_add(u_at(starts, i), j), wrap_add(after, at));
      j = j + 1;
    }
    after = wrap_add(after, w);
  }
  vec_free(ws);
  vec_free(sw);
  vec_free(starts);
  return pos;
}

/// Does the call `q` of `f` agree with the calling convention of its callee?
fn ix_call_ok(f: &IrFn, g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, q: IrIns) -> bool {
  let pos = ix_positions(&mut g, c, &mut m, p, q.a);
  let n = vec_len(pos);
  vec_free(pos);
  if n != q.c {
    return false;
  }
  let rt = cg_ret_ty(&mut m, p, q.a);
  let rw = x86_words(&mut g, c, m, p, rt);
  if q.op == IR_CALLM {
    return rw > 2 && rw == q.ty;
  }
  if rw > 2 {
    return false;
  }
  if q.d != IR_NONE {
    let mut got = 1;
    if q.ty != IR_NONE && q.ty != 0 {
      got = 2;
    }
    if got != rw {
      return false;
    }
  }
  return true;
}

/// A call: the arguments in registers (up to four words) or pushed on the
/// stack, as `x86_call_to` does it, then the result from %rax and %rdx.
fn ix_call(out: &mut Vec[u64], f: &IrFn, al: &IrAlloc, g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, q: IrIns, slotw: u64, inplace: bool) {
  let pos = ix_positions(&mut g, c, &mut m, p, q.a);
  let total = vec_len(pos);
  let na = x86_regargs(&mut g, c, &mut m, p, q.a);
  // With the result area at the bottom of the frame, the callee writes the
  // result straight into the slot: it is just above the arguments.
  let direct = q.op == IR_CALLM && inplace;
  if q.op == IR_CALLM && !direct {
    // The space for the result, above the arguments (`x86_call_to`).
    w_s(&mut out, "\tsub $");
    w_num(&mut out, wrap_mul(8, q.ty));
    w_s(&mut out, ", %rsp\n");
  }
  if na > 0 {
    let mut j = 0;
    while j < q.c && j < 4096 {
      let a = u_at(f.args, wrap_add(q.b, j));
      ix_mov(&mut out, ix_loc(al, a), ix_rl(x86_argreg(u_at(pos, j))));
      j = j + 1;
    }
  } else {
    let mut k = total;
    while k > 0 && k < 100000 {
      k = k - 1;
      let mut j = 0;
      while j < q.c && j < 4096 {
        if u_at(pos, j) == k {
          let a = u_at(f.args, wrap_add(q.b, j));
          ix_push(&mut out, ix_loc(al, a));
        }
        j = j + 1;
      }
    }
  }
  w_s(&mut out, "\tcall ");
  ix_sym(&mut out, &mut g, m, p, q.a);
  w_s(&mut out, "\n");
  if na == 0 && total > 0 {
    w_s(&mut out, "\tadd $");
    w_num(&mut out, wrap_mul(8, total));
    w_s(&mut out, ", %rsp\n");
  }
  vec_free(pos);
  if q.op == IR_CALLM {
    // The result words go to the frame slot, whose lowest word is `slotw`
    // words below %rbp; the slot's address is the value of the call.
    let mut j = 0;
    while j < q.ty && j < 4096 && !direct {
      w_s(&mut out, "\tmov ");
      w_num(&mut out, wrap_mul(8, j));
      w_s(&mut out, "(%rsp), %rax\n\tmov %rax, -");
      w_num(&mut out, wrap_sub(wrap_mul(8, slotw), wrap_mul(8, j)));
      w_s(&mut out, "(%fp)\n");
      j = j + 1;
    }
    if !direct {
      w_s(&mut out, "\tadd $");
      w_num(&mut out, wrap_mul(8, q.ty));
      w_s(&mut out, ", %rsp\n");
    }
    w_s(&mut out, "\tlea -");
    w_num(&mut out, wrap_mul(8, slotw));
    w_s(&mut out, "(%fp), %rax\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
    return;
  }
  if q.d != IR_NONE {
    if q.ty != IR_NONE && q.ty != 0 && ix_buffer(c, m, p, cg_ret_ty(&mut m, p, q.a)) {
      ix_mov(&mut out, ix_rl(XR_RDX), ix_loc(al, q.d));
      ix_mov(&mut out, ix_rl(XR_RAX), ix_loc(al, q.ty));
    } else {
      ix_mov(&mut out, ix_rl(XR_RAX), ix_loc(al, q.d));
      if q.ty != IR_NONE && q.ty != 0 {
        ix_mov(&mut out, ix_rl(XR_RDX), ix_loc(al, q.ty));
      }
    }
  }
}

/// Does `op` compute its result with one instruction `name b, t` after
/// `t = a`?
fn ix_alu(op: u64) -> Str {
  if op == IR_ADD { return "add"; }
  if op == IR_SUB { return "sub"; }
  if op == IR_MUL { return "imul"; }
  if op == IR_AND { return "and"; }
  if op == IR_OR { return "or"; }
  if op == IR_XOR { return "xor"; }
  return "";
}

fn ix_norm(out: &mut Vec[u64], m: &Mono, t: u64) {
  if t != 0 {
    let s = x86_normalize(m, t);
    if slen(s) > 0 {
      w_s(&mut out, "\t");
      w_s(&mut out, s);
      w_s(&mut out, "\n");
    }
  }
}

/// Does `v` (bytes) end with `s`? If so, `cut` drops it.
fn ix_ends_with(v: &Vec[u64], s: Str) -> bool {
  let n = vec_len(v);
  let l = slen(s);
  if l > n {
    return false;
  }
  let mut k = 0;
  while k < l
    invariant k <= slen(s) && slen(s) <= vlen(v)
  {
    if vec_get(v, n - l + k) != cast[u64](sget(s, k)) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

/// How many times the text `v` contains `pat`.
fn ix_count(v: &Vec[u64], pat: Str) -> u64 {
  let n = vec_len(v);
  let mut c = 0;
  let mut i = 0;
  while i < n {
    if ix_has_at(v, i, pat) {
      c = wrap_add(c, 1);
    }
    i = i + 1;
  }
  return c;
}

/// Whether the text `v` contains `pat`.
fn ix_mentions(v: &Vec[u64], pat: Str) -> bool {
  let n = vec_len(v);
  let m = slen(pat);
  let mut i = 0;
  while i < n {
    let mut j = 0;
    while j < m && i + j < n && vec_get(v, i + j) == cast[u64](sget(pat, j)) {
      j = j + 1;
    }
    if j == m {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// Does the text `v` mention `pat` from position `from` on?
fn ix_mentions_from(v: &Vec[u64], from: u64, pat: Str) -> bool {
  let n = vec_len(v);
  let m = slen(pat);
  let mut i = from;
  while i < n {
    let mut j = 0;
    while j < m && i + j < n && vec_get(v, i + j) == cast[u64](sget(pat, j)) {
      j = j + 1;
    }
    if j == m {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// Whether the text `v` has `pat` at position `i`.
fn ix_has_at(v: &Vec[u64], i: u64, pat: Str) -> bool {
  let m = slen(pat);
  let mut j = 0;
  while j < m && i < 1000000000 && j < 100 && i + j < vec_len(v) && vec_get(v, i + j) == cast[u64](sget(pat, j)) {
    j = j + 1;
  }
  return j == m;
}

/// The `movabs $M, %rdx; mul %rdx` in the code of a division by a constant
/// (`g.body`), as `mul` of the register that holds the multiplier.
fn ix_mulreg(g: &mut X86, mval: u64, reg: u64) {
  let mut pat = vec_new[u64]();
  w_s(&mut pat, "\tmovabs $");
  w_num(&mut pat, mval);
  w_s(&mut pat, ", %rdx\n\tmul %rdx\n");
  let mut at = IR_NONE;
  let mut k = 0;
  while k < vec_len(g.body) && at == IR_NONE && k < 100000 {
    if ix_has_vec(g.body, k, pat) {
      at = k;
    }
    k = wrap_add(k, 1);
  }
  if at != IR_NONE {
    let mut nb = vec_new[u64]();
    k = 0;
    while k < at && k < vec_len(g.body) {
      vec_push(&mut nb, vec_get(g.body, k));
      k = wrap_add(k, 1);
    }
    w_s(&mut nb, "\tmul ");
    w_s(&mut nb, x86_rname(reg));
    w_s(&mut nb, "\n");
    k = wrap_add(at, vec_len(pat));
    while k < vec_len(g.body) {
      vec_push(&mut nb, vec_get(g.body, k));
      k = wrap_add(k, 1);
    }
    x86_clear(&mut g.body);
    w_append(&mut g.body, nb);
    vec_free(nb);
  }
  vec_free(pat);
}

/// Does `v` hold the bytes of `pat` at `i`?
fn ix_has_vec(v: &Vec[u64], i: u64, pat: &Vec[u64]) -> bool {
  let m = vec_len(pat);
  let mut j = 0;
  while j < m && i < 1000000000 && i + j < vec_len(v) && vec_get(v, i + j) == vec_get(pat, j) {
    j = j + 1;
  }
  return j == m;
}

/// The end of the decimal number at `i` in `v`, and the number in `ix_fpo_val`.
fn ix_digits_end(v: &Vec[u64], i: u64) -> u64 {
  let mut k = i;
  while k < vec_len(v) && vec_get(v, k) >= 48 && vec_get(v, k) <= 57 && i < 1000000000 && k < i + 12 {
    k = k + 1;
  }
  return k;
}

fn ix_digits_val(v: &Vec[u64], i: u64, e: u64) -> u64 {
  let mut x = 0;
  let mut k = i;
  while k < e && i < 1000000000 && k < i + 12 && x < 1000000000000 {
    x = wrap_add(wrap_mul(x, 10), wrap_sub(u_at(v, k), 48));
    k = k + 1;
  }
  return x;
}

/// The mnemonic of the jump that holds exactly when the one `inner` has at
/// `i` (`je `, `jb `, ...) does not; empty when it is not one of those.
fn ix_jcc_inv(inner: &Vec[u64], i: u64) -> Str {
  if ix_has_at(inner, i, "je ") { return "jne"; }
  if ix_has_at(inner, i, "jne ") { return "je"; }
  if ix_has_at(inner, i, "jb ") { return "jae"; }
  if ix_has_at(inner, i, "jae ") { return "jb"; }
  if ix_has_at(inner, i, "jbe ") { return "ja"; }
  if ix_has_at(inner, i, "ja ") { return "jbe"; }
  if ix_has_at(inner, i, "jl ") { return "jge"; }
  if ix_has_at(inner, i, "jge ") { return "jl"; }
  if ix_has_at(inner, i, "jle ") { return "jg"; }
  if ix_has_at(inner, i, "jg ") { return "jle"; }
  return "";
}

/// The end of the line that starts at `s` (the position of its newline).
fn ix_eol(v: &Vec[u64], s: u64) -> u64 {
  let mut e = s;
  while e < vec_len(v) && u_at(v, e) != 10 {
    e = wrap_add(e, 1);
  }
  return e;
}

/// Whether the lines at `a` and `b` name the same label: the text of the
/// jump's operand (after its mnemonic) against a label line without its colon.
fn ix_same_label(v: &Vec[u64], a: u64, ae: u64, b: u64, be: u64) -> bool {
  let mut x = a;
  while x < ae && u_at(v, x) != 32 {
    x = wrap_add(x, 1);
  }
  x = wrap_add(x, 1);
  if be == 0 || wrap_sub(ae, x) != wrap_sub(wrap_sub(be, b), 1) {
    return false;
  }
  let mut k = 0;
  let n = wrap_sub(ae, x);
  while k < n && k < 200 {
    if u_at(v, wrap_add(x, k)) != u_at(v, wrap_add(b, k)) {
      return false;
    }
    k = wrap_add(k, 1);
  }
  return true;
}

/// Whether a jump of `v` names the label on the line [b, be) (which ends
/// with its colon).
fn ix_label_used(v: &Vec[u64], b: u64, be: u64) -> bool {
  let n = vec_len(v);
  let mut s = 0;
  while s < n {
    let e = ix_eol(v, s);
    if u_at(v, s) == 9 && u_at(v, wrap_add(s, 1)) == 106 && ix_same_label(v, wrap_add(s, 1), e, b, be) {
      return true;
    }
    s = wrap_add(e, 1);
  }
  return false;
}

/// `jCC .La; [unused labels] jmp .Lb; .La:` (the branch around a jump)
/// becomes `jNCC .Lb; [unused labels] .La:`.
fn ix_flip_jumps(inner: &Vec[u64]) -> Vec[u64] {
  let n = vec_len(inner);
  let mut out = vec_new[u64]();
  let mut s = 0;
  while s < n {
    let e = ix_eol(inner, s);
    let mut done = false;
    let inv = ix_jcc_inv(inner, wrap_add(s, 1));
    if u_at(inner, s) == 9 && slen(inv) > 0 {
      // The labels no jump reaches, then the jump.
      let mut s2 = wrap_add(e, 1);
      let mut e2 = ix_eol(inner, s2);
      let mut more = true;
      while more {
        more = false;
        if u_at(inner, s2) == 46 && e2 > s2 && u_at(inner, wrap_sub(e2, 1)) == 58 && !ix_label_used(inner, s2, e2) {
          s2 = wrap_add(e2, 1);
          e2 = ix_eol(inner, s2);
          more = true;
        }
      }
      if u_at(inner, s2) == 9 && ix_has_at(inner, wrap_add(s2, 1), "jmp .Lir") {
        let s3 = wrap_add(e2, 1);
        let e3 = ix_eol(inner, s3);
        if e3 > s3 && u_at(inner, wrap_sub(e3, 1)) == 58 && ix_same_label(inner, wrap_add(s, 1), e, s3, e3) {
          w_s(&mut out, "\t");
          w_s(&mut out, inv);
          w_s(&mut out, " ");
          let mut x = wrap_add(s2, 5);
          while x < e2 {
            vec_push(&mut out, u_at(inner, x));
            x = wrap_add(x, 1);
          }
          vec_push(&mut out, 10);
          // The unused labels stay; the jump is gone.
          let mut c = wrap_add(e, 1);
          while c < s2 {
            vec_push(&mut out, u_at(inner, c));
            c = wrap_add(c, 1);
          }
          s = s3;
          done = true;
        }
      }
    }
    if !done {
      let mut c = s;
      while c < e {
        vec_push(&mut out, u_at(inner, c));
        c = wrap_add(c, 1);
      }
      if e < n {
        vec_push(&mut out, 10);
      }
      s = wrap_add(e, 1);
    }
  }
  return out;
}

/// `inner` with the frame register `%fp` written as %rbp.
fn ix_fp_classic(inner: &Vec[u64]) -> Vec[u64] {
  let n = vec_len(inner);
  let mut out = vec_new[u64]();
  let mut c = 0;
  while c < n {
    if ix_has_at(inner, c, "%fp") {
      w_s(&mut out, "%rbp");
      c = wrap_add(c, 3);
    } else {
      vec_push(&mut out, u_at(inner, c));
      c = c + 1;
    }
  }
  return out;
}

/// The text of a function body (`inner`) written for a frame of `fsz` bytes
/// of locals below a frame pointer, rewritten to address the frame from
/// %rsp instead: `N(%rbp)` becomes `N+fsz+depth(%rsp)`, where `depth` is
/// what the body has pushed so far, and `leave` becomes the `add` that drops
/// the frame. The caller opens the frame with `sub $fsz+8, %rsp` (the extra
/// word stands where the saved %rbp was, so %rsp is aligned as it was).
/// Empty when the body does anything this does not follow: a use of %rbp
/// other than a plain memory operand, a change of %rsp other than push, pop,
/// and `sub`/`add` of a constant, or a label, jump or return with something
/// pushed.
fn ix_fpo(inner: &Vec[u64], fsz: u64) -> Vec[u64] {
  let n = vec_len(inner);
  let mut out = vec_new[u64]();
  let mut d = 0;
  let mut ok = true;
  let mut s = 0;
  while s < n && ok {
    let mut e = s;
    while e < n && u_at(inner, e) != 10 {
      e = wrap_add(e, 1);
    }
    if u_at(inner, s) != 9 {
      if d != 0 {
        ok = false;
      }
      let mut c = s;
      while c < e {
        vec_push(&mut out, u_at(inner, c));
        c = wrap_add(c, 1);
      }
    } else if ix_has_at(inner, wrap_add(s, 1), "leave") {
      if d != 0 {
        ok = false;
      }
      w_s(&mut out, "\tadd $");
      w_num(&mut out, wrap_add(fsz, 8));
      w_s(&mut out, ", %rsp");
    } else {
      let a = wrap_add(s, 1);
      let isrsp = e >= 6 && ix_has_at(inner, wrap_sub(e, 6), ", %rsp");
      let isadd = isrsp && ix_has_at(inner, a, "add $");
      let issub = isrsp && ix_has_at(inner, a, "sub $");
      let ispush = ix_has_at(inner, a, "push ");
      let ispop = ix_has_at(inner, a, "pop ");
      if ix_has_at(inner, a, "j") || ix_has_at(inner, a, "ret") {
        if d != 0 {
          ok = false;
        }
      }
      if !isadd && !issub && e >= 4 && ix_has_at(inner, wrap_sub(e, 4), "%rsp") {
        ok = false;
      }
      // The line, with each `N(%rbp)` made `N'(%rsp)`.
      let mut c = s;
      let mut found = 0;
      while c < e && ok {
        if ix_has_at(inner, c, "%fp") {
          found = wrap_add(found, 1);
        }
        let neg = u_at(inner, c) == 45;
        let mut b = c;
        if neg {
          b = wrap_add(c, 1);
        }
        let de = ix_digits_end(inner, b);
        let prevd = c > s && u_at(inner, wrap_sub(c, 1)) >= 48 && u_at(inner, wrap_sub(c, 1)) <= 57;
        let fpend = ix_has_at(inner, de, "(%fp)") || ix_has_at(inner, de, "(%fp,");
        if !prevd && fpend && (de > b || (!neg && de == c)) {
          let x = ix_digits_val(inner, b, de);
          let mut v = 0;
          if neg {
            if x > wrap_add(fsz, d) {
              ok = false;
            } else {
              v = wrap_sub(wrap_add(fsz, d), x);
            }
          } else {
            v = wrap_add(wrap_add(x, fsz), d);
          }
          w_num(&mut out, v);
          w_s(&mut out, "(%rsp");
          c = wrap_add(de, 4);
        } else {
          vec_push(&mut out, u_at(inner, c));
          c = wrap_add(c, 1);
        }
      }
      if found != 0 {
        ok = false;
      }
      if ispush {
        d = wrap_add(d, 8);
      } else if ispop {
        if d < 8 || ix_has_at(inner, wrap_add(a, 4), "(") || ix_digits_end(inner, wrap_add(a, 4)) != wrap_add(a, 4) {
          ok = false;
        } else {
          d = wrap_sub(d, 8);
        }
      } else if isadd || issub {
        let de = ix_digits_end(inner, wrap_add(a, 5));
        let x = ix_digits_val(inner, wrap_add(a, 5), de);
        if issub {
          d = wrap_add(d, x);
        } else if x > d {
          ok = false;
        } else {
          d = wrap_sub(d, x);
        }
      }
    }
    if s < n {
      vec_push(&mut out, 10);
    }
    s = wrap_add(e, 1);
  }
  if !ok {
    vec_free(out);
    return vec_new[u64]();
  }
  return out;
}

/// Does the code `ix_ins` writes for `q` leave %rax as it was? Only the
/// shapes that need no scratch register: a store of a register or a small
/// constant, a load into a register, and an add into another register (one
/// `lea`).
fn ix_keeps_rax(al: &IrAlloc, m: &Mono, q: IrIns) -> bool {
  if q.op == IR_STORE {
    let lv = ix_loc(al, q.d);
    return (lv.k == IXK_IMM && ix_fits(lv.imm)) || lv.k == IXK_REG;
  }
  if q.op == IR_CONST {
    let ld = ix_loc(al, q.d);
    return u_at(al.cst, q.d) != 0 || ld.k == IXK_REG;
  }
  if q.op == IR_MOV {
    let ld = ix_loc(al, q.d);
    let la = ix_loc(al, q.a);
    return u_at(al.cst, q.d) == 3 || (ld.k == IXK_REG && (la.k == IXK_REG || la.k == IXK_IMM));
  }
  if q.op == IR_LOAD {
    // The address is built in %rsi and %rdi, and a load into a register
    // goes straight there.
    let ld = ix_loc(al, q.d);
    return ld.k == IXK_REG;
  }
  let wrap = q.c == 1 && q.ty != 0 && slen(x86_normalize(m, q.ty)) > 0;
  if q.op == IR_ADD && !wrap {
    let ld = ix_loc(al, q.d);
    let la = ix_loc(al, q.a);
    let lb = ix_loc(al, q.b);
    if ld.k == IXK_REG && la.k == IXK_REG && la.reg != ld.reg {
      return (lb.k == IXK_IMM && ix_fits(lb.imm)) || (lb.k == IXK_REG && lb.reg != ld.reg);
    }
  }
  return false;
}

/// Does `ix_ins` leave the processor's context block in %rax for `q`? A
/// `cpu_set` does; a `cpu_get` does unless its result is loaded through %rax.
fn ix_sets_ctx(al: &IrAlloc, q: IrIns) -> bool {
  if q.op == IR_PCALL && q.c == 6 {
    return true;
  }
  let ld = ix_loc(al, q.d);
  return q.op == IR_PCALL && q.c == 3 && ld.k == IXK_REG;
}

/// One instruction other than control flow and calls.
fn ix_ins(out: &mut Vec[u64], f: &IrFn, al: &IrAlloc, g: &mut X86, m: &Mono, p: &Parser, q: IrIns, slotw: u64, ctxlive: bool) {
  let op = q.op;
  let alu = ix_alu(op);
  let lbq = ix_loc(al, q.b);
  let mg = ix_div_magic(lbq.imm);
  if slen(alu) > 0 {
    let ld = ix_loc(al, q.d);
    let mut la = ix_loc(al, q.a);
    let wrap = q.c == 1 && q.ty != 0 && slen(x86_normalize(m, q.ty)) > 0;
    let mut t = XR_RAX;
