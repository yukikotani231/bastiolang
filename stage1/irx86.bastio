// IR to x86-64 (docs/ir.md): the emitter for the IR of stage1/ir.bastio and
// the registers chosen by stage1/irra.bastio, behind `--backend native-ir`.
//
// `x86_program_ir` is `x86_program` with one difference: each function is
// lowered to the IR first, and a function the IR handles is written from
// it; any other (a node outside the IR's subset, a calling convention the
// emitter does not reproduce) goes through the generator of x86.bastio
// as before. Both write into the same file with the same calling convention
// (docs: `x86_regargs`, `x86_regret`), so the two kinds of function call
// each other. Hosted target only.
//
// Registers. The allocator is given the five callee-saved registers and
// four of the caller-saved ones (%r8-%r11); the emitter keeps %rax, %rcx,
// %rdx, %rsi and %rdi to itself, so no value shares a register with an
// argument of a call. Spilled values and the slots of `IR_SLOT` live in the
// frame below the saved registers. The code is a plain walk of the
// instructions: operands are used from where the allocator put them, a
// result is computed in its own register when it has one.
import "x86.bastio";
import "irra.bastio";
import "iropt.bastio";
import "iropt_inline.bastio";

/// A frame holds the saved registers, the spilled values and the slots; an
/// instruction count past this goes to the old generator (the allocator is
/// quadratic).
const IX_MAX_INS: u64 = 3000;

/// Where a value is: machine register `reg` (an XR_ number; k = IXK_REG),
/// the frame word `off` words below %rbp (IXK_MEM) or a constant `imm`
/// (IXK_IMM, a register the allocator left out because it is only ever one
/// constant).
const IXK_REG: u64 = 1;
const IXK_MEM: u64 = 2;
const IXK_IMM: u64 = 3;

struct IxL { k: u64, reg: u64, off: u64, imm: u64 }

fn ix_rl(r: u64) -> IxL {
  return IxL { k: IXK_REG, reg: r, off: 0, imm: 0 };
}

fn ix_ml(off: u64) -> IxL {
  return IxL { k: IXK_MEM, reg: 0, off: off, imm: 0 };
}

fn ix_il(v: u64) -> IxL {
  return IxL { k: IXK_IMM, reg: 0, off: 0, imm: v };
}

/// Does `v` fit the signed 32-bit immediate of most instructions?
fn ix_fits(v: u64) -> bool {
  return v <= 2147483647 || v >= 18446744071562067968;
}

fn ix_callee(i: u64) -> u64 {
  if i == 0 { return XR_RBX; }
  if i == 1 { return XR_R12; }
  if i == 2 { return XR_R13; }
  if i == 3 { return XR_R14; }
  return XR_R15;
}

fn ix_caller(i: u64) -> u64 {
  if i == 0 { return XR_R8; }
  if i == 1 { return XR_R9; }
  if i == 2 { return XR_R10; }
  return XR_R11;
}

/// Where virtual register `r` lives.
fn ix_loc(al: &IrAlloc, r: u64) -> IxL {
  if u_at(al.cst, r) == 1 {
    return ix_il(u_at(al.cv, r));
  }
  let cls = u_at(al.cls, r);
  let idx = u_at(al.idx, r);
  if cls == RA_CALLEE {
    return ix_rl(ix_callee(idx));
  }
  if cls == RA_CALLER {
    return ix_rl(ix_caller(idx));
  }
  return ix_ml(wrap_add(wrap_add(al.ncallee_used, 1), idx));
}

/// The immediate `v` as an assembler operand (`v` fits 32 bits).
fn ix_w_imm(out: &mut Vec[u64], v: u64) {
  w_s(&mut out, "$");
  if v <= 2147483647 {
    w_num(&mut out, v);
  } else {
    w_s(&mut out, "-");
    w_num(&mut out, wrap_sub(0, v));
  }
}

fn ix_op(out: &mut Vec[u64], l: IxL) {
  if l.k == IXK_REG {
    w_s(&mut out, x86_rname(l.reg));
  } else if l.k == IXK_IMM {
    ix_w_imm(&mut out, l.imm);
  } else {
    vec_push(&mut out, 45);
    w_num(&mut out, wrap_mul(8, l.off));
    w_s(&mut out, "(%rbp)");
  }
}

fn ix_same(a: IxL, b: IxL) -> bool {
  return a.k == b.k && a.reg == b.reg && a.off == b.off && a.imm == b.imm;
}

/// `name a, b` (AT&T: the source first).
fn ix_ins2(out: &mut Vec[u64], name: Str, a: IxL, b: IxL) {
  w_s(&mut out, "\t");
  w_s(&mut out, name);
  w_s(&mut out, " ");
  ix_op(&mut out, a);
  w_s(&mut out, ", ");
  ix_op(&mut out, b);
  w_s(&mut out, "\n");
}

/// `to = from`, through %rax when that takes two instructions.
fn ix_mov(out: &mut Vec[u64], from: IxL, to: IxL) {
  if ix_same(from, to) {
    return;
  }
  if from.k == IXK_IMM {
    if !ix_fits(from.imm) {
      let mut t = to;
      if to.k != IXK_REG {
        t = ix_rl(XR_RAX);
      }
      w_s(&mut out, "\tmovabs $");
      w_num(&mut out, from.imm);
      w_s(&mut out, ", ");
      ix_op(&mut out, t);
      w_s(&mut out, "\n");
      if to.k != IXK_REG {
        ix_ins2(&mut out, "mov", t, to);
      }
    } else if to.k == IXK_REG {
      ix_ins2(&mut out, "mov", from, to);
    } else {
      ix_ins2(&mut out, "movq", from, to);
    }
  } else if from.k == IXK_MEM && to.k == IXK_MEM {
    ix_ins2(&mut out, "mov", from, ix_rl(XR_RAX));
    ix_ins2(&mut out, "mov", ix_rl(XR_RAX), to);
  } else {
    ix_ins2(&mut out, "mov", from, to);
  }
}

/// `from` as the source operand of an instruction that takes a 32-bit
/// immediate, a register or memory: a larger constant goes through %rcx.
fn ix_src(out: &mut Vec[u64], from: IxL) -> IxL {
  if from.k == IXK_IMM && !ix_fits(from.imm) {
    ix_mov(&mut out, from, ix_rl(XR_RCX));
    return ix_rl(XR_RCX);
  }
  return from;
}

fn ix_push(out: &mut Vec[u64], from: IxL) {
  let l = ix_src(&mut out, from);
  w_s(&mut out, "\tpush ");
  ix_op(&mut out, l);
  w_s(&mut out, "\n");
}

/// The register that holds virtual register `r`: its own, or `scratch` after
/// loading it.
fn ix_use(out: &mut Vec[u64], al: &IrAlloc, r: u64, scratch: u64) -> u64 {
  let l = ix_loc(al, r);
  if l.k == IXK_REG {
    return l.reg;
  }
  ix_mov(&mut out, l, ix_rl(scratch));
  return scratch;
}

/// `d = <machine register t>`.
fn ix_finish(out: &mut Vec[u64], al: &IrAlloc, d: u64, t: u64) {
  ix_mov(&mut out, ix_rl(t), ix_loc(al, d));
}

/// The 32-bit and 8-bit names of the registers the emitter can use.
fn ix_name32(r: u64) -> Str {
  if r == XR_RAX { return "%eax"; }
  if r == XR_RCX { return "%ecx"; }
  if r == XR_RDX { return "%edx"; }
  if r == XR_RSI { return "%esi"; }
  if r == XR_RDI { return "%edi"; }
  if r == XR_RBX { return "%ebx"; }
  if r == XR_R12 { return "%r12d"; }
  if r == XR_R13 { return "%r13d"; }
  if r == XR_R14 { return "%r14d"; }
  if r == XR_R15 { return "%r15d"; }
  if r == XR_R8 { return "%r8d"; }
  if r == XR_R9 { return "%r9d"; }
  if r == XR_R10 { return "%r10d"; }
  return "%r11d";
}

fn ix_name8(r: u64) -> Str {
  if r == XR_RAX { return "%al"; }
  if r == XR_RCX { return "%cl"; }
  if r == XR_RDX { return "%dl"; }
  if r == XR_RSI { return "%sil"; }
  if r == XR_RDI { return "%dil"; }
  if r == XR_RBX { return "%bl"; }
  if r == XR_R12 { return "%r12b"; }
  if r == XR_R13 { return "%r13b"; }
  if r == XR_R14 { return "%r14b"; }
  if r == XR_R15 { return "%r15b"; }
  if r == XR_R8 { return "%r8b"; }
  if r == XR_R9 { return "%r9b"; }
  if r == XR_R10 { return "%r10b"; }
  return "%r11b";
}

/// The address `(base,index,8)` or `(base,index)`.
fn ix_w_addr(out: &mut Vec[u64], rb: u64, ri: u64, size: u64) {
  w_s(&mut out, "(");
  w_s(&mut out, x86_rname(rb));
  w_s(&mut out, ",");
  w_s(&mut out, x86_rname(ri));
  if size == 8 {
    w_s(&mut out, ",8");
  }
  w_s(&mut out, ")");
}

/// The address `a[b]` once its parts are in registers (`ri` is 0 for a
/// constant index `imm`).
struct IxA { rb: u64, ri: u64, imm: u64 }

/// Loads what the address `a[b]` needs into %rsi and %rdi when it is not in
/// registers.
fn ix_aprep(out: &mut Vec[u64], al: &IrAlloc, a: u64, b: u64) -> IxA {
  let rb = ix_use(&mut out, al, a, XR_RSI);
  let lb = ix_loc(al, b);
  if lb.k == IXK_IMM && lb.imm < 268435456 {
    return IxA { rb: rb, ri: 0, imm: lb.imm };
  }
  return IxA { rb: rb, ri: ix_use(&mut out, al, b, XR_RDI), imm: 0 };
}

fn ix_awrite(out: &mut Vec[u64], ap: IxA, size: u64) {
  if ap.ri == 0 {
    w_num(&mut out, wrap_mul(ap.imm, size));
    w_s(&mut out, "(");
    w_s(&mut out, x86_rname(ap.rb));
    w_s(&mut out, ")");
  } else {
    ix_w_addr(&mut out, ap.rb, ap.ri, size);
  }
}

fn ix_lbl(out: &mut Vec[u64], x: u64, l: u64) {
  w_s(&mut out, ".Lir");
  w_num(&mut out, x);
  w_s(&mut out, "_");
  w_num(&mut out, l);
}

fn ix_jump(out: &mut Vec[u64], name: Str, x: u64, l: u64) {
  w_s(&mut out, "\t");
  w_s(&mut out, name);
  w_s(&mut out, " ");
  ix_lbl(&mut out, x, l);
  w_s(&mut out, "\n");
}

fn ix_is_cmp(op: u64) -> bool {
  return op >= IR_EQ && op <= IR_SGE;
}

/// The condition-code suffix of comparison `op`.
fn ix_cc(op: u64) -> Str {
  if op == IR_EQ { return "e"; }
  if op == IR_NE { return "ne"; }
  if op == IR_LT { return "b"; }
  if op == IR_LE { return "be"; }
  if op == IR_GT { return "a"; }
  if op == IR_GE { return "ae"; }
  if op == IR_SLT { return "l"; }
  if op == IR_SLE { return "le"; }
  if op == IR_SGT { return "g"; }
  return "ge";
}

/// The comparison that is true when `op` is false.
fn ix_not(op: u64) -> u64 {
  if op == IR_EQ { return IR_NE; }
  if op == IR_NE { return IR_EQ; }
  if op == IR_LT { return IR_GE; }
  if op == IR_GE { return IR_LT; }
  if op == IR_LE { return IR_GT; }
  if op == IR_GT { return IR_LE; }
  if op == IR_SLT { return IR_SGE; }
  if op == IR_SGE { return IR_SLT; }
  if op == IR_SLE { return IR_SGT; }
  return IR_SLE;
}

/// Writes the comparison of `a` with `b` (the flags for `a ? b`).
fn ix_cmp(out: &mut Vec[u64], al: &IrAlloc, a: u64, b: u64) {
  let mut la = ix_loc(al, a);
  let lb = ix_src(&mut out, ix_loc(al, b));
  if la.k == IXK_IMM || (la.k == IXK_MEM && lb.k == IXK_MEM) {
    ix_mov(&mut out, la, ix_rl(XR_RAX));
    la = ix_rl(XR_RAX);
  }
  if la.k == IXK_MEM && lb.k == IXK_IMM {
    // An immediate against memory needs its width (`cmp` alone is 32 bits).
    ix_ins2(&mut out, "cmpq", lb, la);
  } else {
    ix_ins2(&mut out, "cmp", lb, la);
  }
}

/// The symbol of function instance `x`.
fn ix_sym(out: &mut Vec[u64], g: &mut X86, m: &Mono, p: &Parser, x: u64) {
  x86_sym(&mut g, m, p, x);
  w_append(&mut out, g.ln);
  while vec_len(g.ln) > 0 {
    vec_pop(&mut g.ln);
  }
}

/// Is `t` a Buf or Bytes? The IR holds one as (data address, length); the
/// generator of x86.bastio as (length, data address), the length being the
/// word at the lower address, in %rax or the first argument register.
fn ix_buffer(c: &Checker, m: &Mono, p: &Parser, t: u64) -> bool {
  let k = ir_kind(c, m, p, t);
  return k == IRK_BUF || k == IRK_BYTES || k == IRK_STR;
}

/// For each word of the parameters of `x` in the order of the IR (the
/// first parameter's first word first), its position in the calling
/// convention: counted from the last parameter's first word, which is the
/// first argument register or the stack word nearest the return address.
fn ix_positions(g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, x: u64) -> Vec[u64] {
  let xi = inst_at(m, x);
  let dn = node_at(p.nodes, xi.def);
  let mut ws = vec_new[u64]();
  let mut sw = vec_new[u64]();
  let mut q = dn.a;
  while q != 0 {
    let qn = node_at(p.nodes, q);
    let pt = conv(&mut m, p, qn.a, x, q);
    vec_push(&mut ws, x86_pwords(&mut g, c, m, p, pt));
    if ix_buffer(c, m, p, pt) {
      vec_push(&mut sw, 1);
    } else {
      vec_push(&mut sw, 0);
    }
    q = qn.next;
  }
  let mut starts = vec_new[u64]();
  let mut total = 0;
  let mut i = 0;
  while i < vec_len(ws) {
    vec_push(&mut starts, total);
    total = wrap_add(total, vec_get(ws, i));
    i = i + 1;
  }
  let mut pos = vec_new[u64]();
  let mut z = 0;
  while z < total && z < 100000 {
    vec_push(&mut pos, 0);
    z = z + 1;
  }
  let mut after = 0;
  i = vec_len(ws);
  while i > 0
    invariant i <= vlen(ws)
  {
    i = i - 1;
    let w = vec_get(ws, i);
    let mut j = 0;
    while j < w && j < 100000 {
      let mut at = j;
      if u_at(sw, i) == 1 && w == 2 {
        at = 1 - j;
      }
      ra_set(&mut pos, wrap_add(u_at(starts, i), j), wrap_add(after, at));
      j = j + 1;
    }
    after = wrap_add(after, w);
  }
  vec_free(ws);
  vec_free(sw);
  vec_free(starts);
  return pos;
}

/// Does the call `q` of `f` agree with the calling convention of its callee?
fn ix_call_ok(f: &IrFn, g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, q: IrIns) -> bool {
  let pos = ix_positions(&mut g, c, &mut m, p, q.a);
  let n = vec_len(pos);
  vec_free(pos);
  if n != q.c {
    return false;
  }
  let rt = cg_ret_ty(&mut m, p, q.a);
  let rw = x86_words(&mut g, c, m, p, rt);
  if q.op == IR_CALLM {
    return rw > 2 && rw == q.ty;
  }
  if rw > 2 {
    return false;
  }
  if q.d != IR_NONE {
    let mut got = 1;
    if q.ty != IR_NONE && q.ty != 0 {
      got = 2;
    }
    if got != rw {
      return false;
    }
  }
  return true;
}

/// A call: the arguments in registers (up to four words) or pushed on the
/// stack, as `x86_call_to` does it, then the result from %rax and %rdx.
fn ix_call(out: &mut Vec[u64], f: &IrFn, al: &IrAlloc, g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, q: IrIns, slotw: u64) {
  let pos = ix_positions(&mut g, c, &mut m, p, q.a);
  let total = vec_len(pos);
  let na = x86_regargs(&mut g, c, &mut m, p, q.a);
  if q.op == IR_CALLM {
    // The space for the result, above the arguments (`x86_call_to`).
    w_s(&mut out, "\tsub $");
    w_num(&mut out, wrap_mul(8, q.ty));
    w_s(&mut out, ", %rsp\n");
  }
  if na > 0 {
    let mut j = 0;
    while j < q.c && j < 4096 {
      let a = u_at(f.args, wrap_add(q.b, j));
      ix_mov(&mut out, ix_loc(al, a), ix_rl(x86_argreg(u_at(pos, j))));
      j = j + 1;
    }
  } else {
    let mut k = total;
    while k > 0 && k < 100000 {
      k = k - 1;
      let mut j = 0;
      while j < q.c && j < 4096 {
        if u_at(pos, j) == k {
          let a = u_at(f.args, wrap_add(q.b, j));
          ix_push(&mut out, ix_loc(al, a));
        }
        j = j + 1;
      }
    }
  }
  w_s(&mut out, "\tcall ");
  ix_sym(&mut out, &mut g, m, p, q.a);
  w_s(&mut out, "\n");
  if na == 0 && total > 0 {
    w_s(&mut out, "\tadd $");
    w_num(&mut out, wrap_mul(8, total));
    w_s(&mut out, ", %rsp\n");
  }
  vec_free(pos);
  if q.op == IR_CALLM {
    // The result words go to the frame slot, whose lowest word is `slotw`
    // words below %rbp; the slot's address is the value of the call.
    let mut j = 0;
    while j < q.ty && j < 4096 {
      w_s(&mut out, "\tmov ");
      w_num(&mut out, wrap_mul(8, j));
      w_s(&mut out, "(%rsp), %rax\n\tmov %rax, -");
      w_num(&mut out, wrap_sub(wrap_mul(8, slotw), wrap_mul(8, j)));
      w_s(&mut out, "(%rbp)\n");
      j = j + 1;
    }
    w_s(&mut out, "\tadd $");
    w_num(&mut out, wrap_mul(8, q.ty));
    w_s(&mut out, ", %rsp\n\tlea -");
    w_num(&mut out, wrap_mul(8, slotw));
    w_s(&mut out, "(%rbp), %rax\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
    return;
  }
  if q.d != IR_NONE {
    if q.ty != IR_NONE && q.ty != 0 && ix_buffer(c, m, p, cg_ret_ty(&mut m, p, q.a)) {
      ix_mov(&mut out, ix_rl(XR_RDX), ix_loc(al, q.d));
      ix_mov(&mut out, ix_rl(XR_RAX), ix_loc(al, q.ty));
    } else {
      ix_mov(&mut out, ix_rl(XR_RAX), ix_loc(al, q.d));
      if q.ty != IR_NONE && q.ty != 0 {
        ix_mov(&mut out, ix_rl(XR_RDX), ix_loc(al, q.ty));
      }
    }
  }
}

/// Does `op` compute its result with one instruction `name b, t` after
/// `t = a`?
fn ix_alu(op: u64) -> Str {
  if op == IR_ADD { return "add"; }
  if op == IR_SUB { return "sub"; }
  if op == IR_MUL { return "imul"; }
  if op == IR_AND { return "and"; }
  if op == IR_OR { return "or"; }
  if op == IR_XOR { return "xor"; }
  return "";
}

fn ix_norm(out: &mut Vec[u64], m: &Mono, t: u64) {
  if t != 0 {
    let s = x86_normalize(m, t);
    if slen(s) > 0 {
      w_s(&mut out, "\t");
      w_s(&mut out, s);
      w_s(&mut out, "\n");
    }
  }
}

/// One instruction other than control flow and calls.
fn ix_ins(out: &mut Vec[u64], f: &IrFn, al: &IrAlloc, g: &mut X86, m: &Mono, p: &Parser, q: IrIns, slotw: u64) {
  let op = q.op;
  let alu = ix_alu(op);
  let lbq = ix_loc(al, q.b);
  if slen(alu) > 0 {
    let ld = ix_loc(al, q.d);
    let la = ix_loc(al, q.a);
    let wrap = q.c == 1 && q.ty != 0 && slen(x86_normalize(m, q.ty)) > 0;
    let mut t = XR_RAX;
    let lb0 = ix_loc(al, q.b);
    if ld.k == IXK_REG && !wrap && !(lb0.k == IXK_REG && lb0.reg == ld.reg) {
      t = ld.reg;
    }
    ix_mov(&mut out, la, ix_rl(t));
    let lb = ix_src(&mut out, lb0);
    ix_ins2(&mut out, alu, lb, ix_rl(t));
    if wrap {
      ix_norm(&mut out, m, q.ty);
    }
    ix_finish(&mut out, al, q.d, t);
  } else if ix_is_cmp(op) {
    ix_cmp(&mut out, al, q.a, q.b);
    w_s(&mut out, "\tset");
    w_s(&mut out, ix_cc(op));
    w_s(&mut out, " %al\n\tmovzbl %al, %eax\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_CONST {
    if u_at(al.cst, q.d) == 0 {
      ix_mov(&mut out, ix_il(q.a), ix_loc(al, q.d));
    }
  } else if op == IR_MOV {
    ix_mov(&mut out, ix_loc(al, q.a), ix_loc(al, q.d));
  } else if (op == IR_DIV || op == IR_REM) && lbq.k == IXK_IMM && lbq.imm != 0 {
    // A constant divisor: shifts and a multiplication, as the generator
    // of x86.bastio does it (the code is written into its line buffer).
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RAX));
    x86_clear(&mut g.body);
    x86_div_const(&mut g, lbq.imm, op == IR_REM);
    w_append(&mut out, g.body);
    x86_clear(&mut g.body);
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_DIV || op == IR_REM || op == IR_SDIV || op == IR_SREM {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RAX));
    ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RCX));
    if op == IR_DIV || op == IR_REM {
      w_s(&mut out, "\txor %edx, %edx\n\tdiv %rcx\n");
    } else {
      w_s(&mut out, "\tcqo\n\tidiv %rcx\n");
    }
    if op == IR_REM || op == IR_SREM {
      ix_finish(&mut out, al, q.d, XR_RDX);
    } else {
      ix_finish(&mut out, al, q.d, XR_RAX);
    }
  } else if op == IR_SHL || op == IR_SHR || op == IR_SAR {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RAX));
    let lb = ix_loc(al, q.b);
    let mut ins = "sar";
    if op == IR_SHL {
      ins = "shl";
    } else if op == IR_SHR {
      ins = "shr";
    }
    if lb.k == IXK_IMM && lb.imm < 64 {
      ix_ins2(&mut out, ins, lb, ix_rl(XR_RAX));
    } else {
      ix_mov(&mut out, lb, ix_rl(XR_RCX));
      w_s(&mut out, "\t");
      w_s(&mut out, ins);
      w_s(&mut out, " %cl, %rax\n");
    }
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_NOT {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RAX));
    if q.ty != 0 {
      w_s(&mut out, "\tnot %rax\n");
      ix_norm(&mut out, m, q.ty);
    } else {
      w_s(&mut out, "\txor $1, %eax\n");
    }
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_NEG {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RAX));
    w_s(&mut out, "\tneg %rax\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_WRAP {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RAX));
    ix_norm(&mut out, m, q.ty);
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_LOAD {
    let ld = ix_loc(al, q.d);
    let ap = ix_aprep(&mut out, al, q.a, q.b);
    let mut t = XR_RAX;
    if ld.k == IXK_REG {
      t = ld.reg;
    }
    if q.c == 1 {
      w_s(&mut out, "\tmovzbl ");
      ix_awrite(&mut out, ap, 1);
      w_s(&mut out, ", ");
      w_s(&mut out, ix_name32(t));
    } else {
      w_s(&mut out, "\tmov ");
      ix_awrite(&mut out, ap, 8);
      w_s(&mut out, ", ");
      w_s(&mut out, x86_rname(t));
    }
    w_s(&mut out, "\n");
    ix_finish(&mut out, al, q.d, t);
  } else if op == IR_STORE {
    let ap = ix_aprep(&mut out, al, q.a, q.b);
    let lv = ix_loc(al, q.d);
    if lv.k == IXK_IMM && ix_fits(lv.imm) {
      if q.c == 1 {
        w_s(&mut out, "\tmovb ");
        ix_w_imm(&mut out, lv.imm);
      } else {
        w_s(&mut out, "\tmovq ");
        ix_w_imm(&mut out, lv.imm);
      }
    } else {
      let mut v = XR_RAX;
      if lv.k == IXK_REG {
        v = lv.reg;
      } else {
        ix_mov(&mut out, lv, ix_rl(XR_RAX));
      }
      if q.c == 1 {
        w_s(&mut out, "\tmov ");
        w_s(&mut out, ix_name8(v));
      } else {
        w_s(&mut out, "\tmov ");
        w_s(&mut out, x86_rname(v));
      }
    }
    w_s(&mut out, ", ");
    ix_awrite(&mut out, ap, q.c);
    w_s(&mut out, "\n");
  } else if op == IR_ALLOC {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDI));
    if q.c == 1 {
      w_s(&mut out, "\tcall bst_rt_balloc\n");
    } else {
      w_s(&mut out, "\tcall bst_rt_alloc\n");
    }
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_FREE {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDI));
    w_s(&mut out, "\tcall bst_rt_free\n");
  } else if op == IR_PRINT {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDI));
    w_s(&mut out, "\tcall bst_rt_print\n");
  } else if op == IR_PUTC {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDI));
    w_s(&mut out, "\tcall bst_rt_putc\n");
  } else if op == IR_GETC {
    w_s(&mut out, "\tcall bst_rt_getc\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_VGROW {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDI));
    w_s(&mut out, "\tmov $");
    w_num(&mut out, wrap_mul(8, q.c));
    w_s(&mut out, ", %esi\n\tcall bst_rt_vec_grow\n");
  } else if op == IR_STRLIT {
    // The bytes are in the data of the program; the literal of a syntax
    // node is added once (`x86_push_val`).
    let mut s = 0;
    while s < vec_len(g.snode) && u_at(g.snode, s) != q.a {
      s = s + 1;
    }
    if s == vec_len(g.snode) {
      let b = x86_lit_bytes(p, q.a);
      s = x86_add_string(&mut g, b);
      vec_push(&mut g.snode, q.a);
      vec_free(b);
    }
    w_s(&mut out, "\tlea .Lstr");
    w_num(&mut out, s);
    w_s(&mut out, "(%rip), %rax\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_SLOT {
    // The address of the slot whose lowest word is `slotw` words below %rbp.
    w_s(&mut out, "\tlea -");
    w_num(&mut out, wrap_mul(8, slotw));
    w_s(&mut out, "(%rbp), %rax\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
  }
}

fn ix_jcc(out: &mut Vec[u64], op: u64, x: u64, l: u64) {
  w_s(&mut out, "\tj");
  w_s(&mut out, ix_cc(op));
  w_s(&mut out, " ");
  ix_lbl(&mut out, x, l);
  w_s(&mut out, "\n");
}

/// The jumps of a branch whose condition `op` is already in the flags.
fn ix_br_flags(out: &mut Vec[u64], x: u64, op: u64, then: u64, els: u64, next: u64) {
  if next == then {
    ix_jcc(&mut out, ix_not(op), x, els);
  } else {
    ix_jcc(&mut out, op, x, then);
    if next != els {
      ix_jump(&mut out, "jmp", x, els);
    }
  }
}

/// Instruction `i` of `f` (an instruction of op 0 past the end).
fn ix_at(f: &IrFn, i: u64) -> IrIns {
  if i < vec_len(f.ins) {
    return vec_get(f.ins, i);
  }
  return IrIns { op: 0, d: IR_NONE, a: IR_NONE, b: IR_NONE, c: 0, ty: 0 };
}

/// The body of the function: its instructions.
fn ix_body(out: &mut Vec[u64], f: &IrFn, al: &IrAlloc, g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, nuse: &Vec[u64], base: u64, rswap: bool, retoff: u64) {
  let n = vec_len(f.ins);
  // The position after each label (0: no such label).
  let mut lpos = vec_new[u64]();
  let mut z = 0;
  while z < f.nlabel && z < 100000000 {
    vec_push(&mut lpos, 0);
    z = z + 1;
  }
  z = 0;
  while z < n {
    let lq = vec_get(f.ins, z);
    if lq.op == IR_LABEL {
      ra_set(&mut lpos, lq.a, z + 1);
    }
    z = z + 1;
  }
  let mut slotw = base;
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    let nq = ix_at(f, i + 1);
    let nq2 = ix_at(f, i + 2);
    let mut next = IR_NONE;
    if nq.op == IR_LABEL {
      next = nq.a;
    }
    if q.op == IR_LABEL {
      ix_lbl(&mut out, f.x, q.a);
      w_s(&mut out, ":\n");
    } else if q.op == IR_JMP {
      // A jump to a block that is only a test repeats the test here
      // (the loop is entered at its test and tested again at its end).
      let lp = u_at(lpos, q.a);
      let h1 = ix_at(f, lp);
      let h2 = ix_at(f, wrap_add(lp, 1));
      if lp != 0 && h1.op == IR_BR && next != q.a {
        ix_cmp_zero(&mut out, al, h1.a);
        ix_br_flags(&mut out, f.x, IR_NE, h1.b, h1.c, next);
      } else if lp != 0 && ix_is_cmp(h1.op) && h2.op == IR_BR && h2.a == h1.d && u_at(nuse, h1.d) == 1 && next != q.a {
        ix_cmp(&mut out, al, h1.a, h1.b);
        ix_br_flags(&mut out, f.x, h1.op, h2.b, h2.c, next);
      } else if next != q.a {
        ix_jump(&mut out, "jmp", f.x, q.a);
      }
    } else if q.op == IR_BR {
      ix_cmp_zero(&mut out, al, q.a);
      ix_br_flags(&mut out, f.x, IR_NE, q.b, q.c, next);
    } else if ix_is_cmp(q.op) && nq.op == IR_BR && nq.a == q.d && u_at(nuse, q.d) == 1 {
      // A comparison that only the branch after it reads: no boolean.
      let mut next2 = IR_NONE;
      if nq2.op == IR_LABEL {
        next2 = nq2.a;
      }
      ix_cmp(&mut out, al, q.a, q.b);
      ix_br_flags(&mut out, f.x, q.op, nq.b, nq.c, next2);
      i = i + 1;
    } else if q.op == IR_RET && q.c > 0 {
      // A result of more than two words goes to the space the caller reserved.
      let mut rb = XR_RSI;
      if q.a != IR_NONE {
        rb = ix_use(&mut out, al, q.a, XR_RSI);
      }
      let mut j = 0;
      while j < q.c && j < 4096 {
        if q.a == IR_NONE {
          ix_mov(&mut out, ix_loc(al, u_at(f.args, wrap_add(q.b, j))), ix_rl(XR_RAX));
          w_s(&mut out, "\tmov %rax, ");
        } else {
          w_s(&mut out, "\tmov ");
          w_num(&mut out, wrap_mul(8, j));
          w_s(&mut out, "(");
          w_s(&mut out, x86_rname(rb));
          w_s(&mut out, "), %rax\n\tmov %rax, ");
        }
        w_num(&mut out, wrap_add(retoff, wrap_mul(8, j)));
        w_s(&mut out, "(%rbp)\n");
        j = j + 1;
      }
      if i + 1 < n {
        w_s(&mut out, "\tjmp ");
        ix_lbl(&mut out, f.x, IR_NONE);
        w_s(&mut out, "\n");
      }
    } else if q.op == IR_RET {
      if rswap && q.a != IR_NONE && q.b != IR_NONE {
        ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RAX));
        ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDX));
      } else {
        if q.a != IR_NONE {
          ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RAX));
        }
        if q.b != IR_NONE {
          ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RDX));
        }
      }
      if i + 1 < n {
        w_s(&mut out, "\tjmp ");
        ix_lbl(&mut out, f.x, IR_NONE);
        w_s(&mut out, "\n");
      }
    } else if q.op == IR_UNREACH {
      w_s(&mut out, "\tud2\n");
    } else if q.op == IR_CALL || q.op == IR_CALLM {
      if q.op == IR_CALLM {
        slotw = wrap_add(slotw, q.ty);
      }
      ix_call(&mut out, f, al, &mut g, c, &mut m, p, q, slotw);
    } else {
      if q.op == IR_SLOT {
        slotw = wrap_add(slotw, q.c);
      }
      ix_ins(&mut out, f, al, &mut g, m, p, q, slotw);
    }
    i = i + 1;
  }
  vec_free(lpos);
}

fn ix_cmp_zero(out: &mut Vec[u64], al: &IrAlloc, r: u64) {
  let mut l = ix_loc(al, r);
  if l.k == IXK_IMM {
    ix_mov(&mut out, l, ix_rl(XR_RAX));
    l = ix_rl(XR_RAX);
  }
  w_s(&mut out, "\tcmpq $0, ");
  ix_op(&mut out, l);
  w_s(&mut out, "\n");
}

/// How many instructions read each register.
fn ix_uses(f: &IrFn) -> Vec[u64] {
  let mut nuse = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut nuse, 0);
    r = r + 1;
  }
  let mut i = 0;
  while i < vec_len(f.ins) {
    let mut rs = vec_new[u64]();
    ra_reads(f, vec_get(f.ins, i), &mut rs);
    let mut j = 0;
    while j < vec_len(rs) {
      let x = vec_get(rs, j);
      ra_set(&mut nuse, x, wrap_add(u_at(nuse, x), 1));
      j = j + 1;
    }
    vec_free(rs);
    i = i + 1;
  }
  return nuse;
}

/// Does instruction `q` write its register `d` only after it has read all
/// its operands, and is `d` its only result?
fn ix_defines(q: IrIns) -> bool {
  let op = q.op;
  return ra_is_binary(op) || op == IR_CONST || op == IR_MOV || op == IR_NOT || op == IR_NEG || op == IR_WRAP
    || op == IR_LOAD || op == IR_ALLOC || op == IR_CALL;
}

/// `t = op ...; s = mov t`, where `t` is written and read only there,
/// becomes `s = op ...`: the copies the lowering makes for `s = s + 1` and
/// `let s = 0`.
fn ix_coalesce(f: &mut IrFn) {
  let nuse = ix_uses(f);
  let mut ndef = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut ndef, 0);
    r = r + 1;
  }
  let mut j = 0;
  while j < vec_len(f.params) {
    let pr = vec_get(f.params, j);
    ra_set(&mut ndef, pr, wrap_add(u_at(ndef, pr), 1));
    j = j + 1;
  }
  let mut i = 0;
  while i < vec_len(f.ins) {
    let mut ws = vec_new[u64]();
    ra_writes(vec_get(f.ins, i), &mut ws);
    j = 0;
    while j < vec_len(ws) {
      let wr = vec_get(ws, j);
      ra_set(&mut ndef, wr, wrap_add(u_at(ndef, wr), 1));
      j = j + 1;
    }
    vec_free(ws);
    i = i + 1;
  }
  let mut out = vec_new[IrIns]();
  i = 0;
  while i < vec_len(f.ins) {
    let q = vec_get(f.ins, i);
    let nq = ix_at(f, i + 1);
    if ix_defines(q) && q.d != IR_NONE && nq.op == IR_MOV && nq.a == q.d && nq.d != q.d
      && u_at(ndef, q.d) == 1 && u_at(nuse, q.d) == 1 {
      vec_push(&mut out, IrIns { op: q.op, d: nq.d, a: q.a, b: q.b, c: q.c, ty: q.ty });
      i = i + 2;
    } else {
      vec_push(&mut out, q);
      i = i + 1;
    }
  }
  vec_free(nuse);
  vec_free(ndef);
  vec_free(f.ins);
  f.ins = out;
}

/// Writes function instance `x` from its IR, to `g.out`. False (nothing
/// written) when the IR does not cover it or the convention does not match.
fn irx_function(g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, x: u64) -> bool {
  if g.target != TARGET_HOSTED || g.stage0 {
    return false;
  }
  let mut f = ir_lower(c, &mut m, p, x);
  if f.failed || vec_len(f.ins) > IX_MAX_INS {
    ir_free(f);
    return false;
  }
  iropt_inline(&mut f, c, &mut m, p);
  iropt_slots(&mut f);
  iropt_copies(&mut f);
  iropt_dce(&mut f);
  iropt_thread(&mut f);
  ix_coalesce(&mut f);
  let xi = inst_at(m, x);
  let pos = ix_positions(&mut g, c, &mut m, p, x);
  let mut ok = vec_len(pos) == vec_len(f.params);
  if ok && name_is(p, xi.def, "main") && vec_len(pos) > 0 {
    ok = false;
  }
  let rt = cg_ret_ty(&mut m, p, x);
  let mut k = 0;
  while ok && k < vec_len(f.ins) {
    let q = vec_get(f.ins, k);
    if (q.op == IR_CALL || q.op == IR_CALLM) && !ix_call_ok(f, &mut g, c, &mut m, p, q) {
      ok = false;
    }
    k = k + 1;
  }
  if !ok {
    vec_free(pos);
    ir_free(f);
    return false;
  }
  let na = x86_regargs(&mut g, c, &mut m, p, x);
  let al = ra_alloc_const(f, 5, 4);
  let nuse = ix_uses(f);
  // The frame: saved registers, spills, slots.
  let mut slots = 0;
  k = 0;
  while k < vec_len(f.ins) {
    let q = vec_get(f.ins, k);
    if q.op == IR_SLOT {
      slots = wrap_add(slots, q.c);
    } else if q.op == IR_CALLM {
      slots = wrap_add(slots, q.ty);
    }
    k = k + 1;
  }
  let base = wrap_add(al.ncallee_used, al.nspill);
  let mut words = wrap_add(base, slots);
  if words % 2 == 1 {
    words = wrap_add(words, 1);
  }
  let mut out = vec_new[u64]();
  w_s(&mut out, "\t.type ");
  ix_sym(&mut out, &mut g, m, p, x);
  w_s(&mut out, ", @function\n");
  ix_sym(&mut out, &mut g, m, p, x);
  w_s(&mut out, ":                  # from the IR\n\tpush %rbp\n\tmov %rsp, %rbp\n\tsub $");
  w_num(&mut out, wrap_mul(8, words));
  w_s(&mut out, ", %rsp\n");
  k = 0;
  while k < al.ncallee_used {
    ix_ins2(&mut out, "mov", ix_rl(ix_callee(k)), ix_ml(wrap_add(k, 1)));
    k = k + 1;
  }
  // The parameters, from their argument registers or stack words.
  k = 0;
  while k < vec_len(f.params) {
    let r = vec_get(f.params, k);
    if u_at(al.cls, r) != RA_NONE {
      let dst = ix_loc(al, r);
      let ps = u_at(pos, k);
      if na > 0 {
        ix_mov(&mut out, ix_rl(x86_argreg(ps)), dst);
      } else {
        let mut t = dst.reg;
        if dst.k != IXK_REG {
          t = XR_RAX;
        }
        w_s(&mut out, "\tmov ");
        w_num(&mut out, wrap_add(16, wrap_mul(8, ps)));
        w_s(&mut out, "(%rbp), ");
        w_s(&mut out, x86_rname(t));
        w_s(&mut out, "\n");
        if dst.k != IXK_REG {
          ix_mov(&mut out, ix_rl(XR_RAX), dst);
        }
      }
    }
    k = k + 1;
  }
  // A result of more than two words is above the parameters left on the stack.
  let mut retoff = 16;
  if na == 0 {
    retoff = wrap_add(16, wrap_mul(8, vec_len(pos)));
  }
  ix_body(&mut out, f, al, &mut g, c, &mut m, p, nuse, base, ix_buffer(c, m, p, rt), retoff);
  ix_lbl(&mut out, x, IR_NONE);
  w_s(&mut out, ":\n");
  k = 0;
  while k < al.ncallee_used {
    ix_ins2(&mut out, "mov", ix_ml(wrap_add(k, 1)), ix_rl(ix_callee(k)));
    k = k + 1;
  }
  w_s(&mut out, "\tleave\n\tret\n\t.size ");
  ix_sym(&mut out, &mut g, m, p, x);
  w_s(&mut out, ", .-");
  ix_sym(&mut out, &mut g, m, p, x);
  w_s(&mut out, "\n\n");
  w_append(&mut g.out, out);
  vec_free(out);
  vec_free(nuse);
  vec_free(pos);
  ra_free(al);
  ir_free(f);
  return true;
}

/// `x86_program`, with the functions the IR covers written from it.
fn x86_program_ir(g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser) -> bool {
  let main_x = x86_program_start(&mut g, &mut m, p);
  if g.failed {
    return false;
  }
  let mut k = 0;
  while k < vec_len(m.fns) && !g.failed {
    let x = u_at(m.fns, k);
    if !irx_function(&mut g, c, &mut m, p, x) {
      x86_function(&mut g, c, &mut m, p, x);
    }
    k = k + 1;
  }
  return x86_program_end(&mut g, c, &mut m, p, main_x);
}
