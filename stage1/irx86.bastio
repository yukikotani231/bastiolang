      w_s(&mut out, "\tmov ");
    }
    w_s(&mut out, ir_sym(q.a));
    let gl = ix_loc(al, q.d);
    if gl.k == IXK_REG {
      w_s(&mut out, "(%rip), ");
      w_s(&mut out, x86_rname(gl.reg));
      w_s(&mut out, "\n");
    } else {
      w_s(&mut out, "(%rip), %rax\n");
      ix_finish(&mut out, al, q.d, XR_RAX);
    }
  } else if op == IR_TSC {
    w_s(&mut out, "\trdtsc\n\tshl $32, %rdx\n\tor %rdx, %rax\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_PCALL && (q.c == 3 || q.c == 6) {
    // `cpu_get` / `cpu_set`: the saved context is the start of the processor's
    // block, which is %rsp rounded down (bst_platform_ctx_mask, from the
    // platform). No call; a constant word index is a displacement.
    let la = ix_loc(al, q.a);
    let mut disp = false;
    let mut ix = XR_RDI;
    if la.k == IXK_IMM && la.imm < 268435456 {
      disp = true;
    } else if la.k == IXK_REG {
      ix = la.reg;
    } else {
      ix_mov(&mut out, la, ix_rl(XR_RDI));
    }
    if !ctxlive {
      w_s(&mut out, "\tmov %rsp, %rax\n\tand $bst_platform_ctx_mask, %rax\n");
    }
    let mut addr = vec_new[u64]();
    if disp {
      w_num(&mut addr, wrap_mul(8, la.imm));
      w_s(&mut addr, "(%rax)");
    } else {
      w_s(&mut addr, "(%rax,");
      w_s(&mut addr, x86_rname(ix));
      w_s(&mut addr, ",8)");
    }
    if q.c == 3 {
      let ld = ix_loc(al, q.d);
      let mut t = XR_RAX;
      if ld.k == IXK_REG {
        t = ld.reg;
      }
      w_s(&mut out, "\tmov ");
      w_append(&mut out, addr);
      w_s(&mut out, ", ");
      w_s(&mut out, x86_rname(t));
      w_s(&mut out, "\n");
      ix_finish(&mut out, al, q.d, t);
    } else {
      let lv = ix_loc(al, q.b);
      if lv.k == IXK_IMM && ix_fits(lv.imm) {
        w_s(&mut out, "\tmovq ");
        ix_w_imm(&mut out, lv.imm);
      } else {
        let mut v = XR_RSI;
        if lv.k == IXK_REG {
          v = lv.reg;
        } else {
          ix_mov(&mut out, lv, ix_rl(XR_RSI));
        }
        w_s(&mut out, "\tmov ");
        w_s(&mut out, x86_rname(v));
      }
      w_s(&mut out, ", ");
      w_append(&mut out, addr);
      w_s(&mut out, "\n");
    }
    vec_free(addr);
  } else if op == IR_PCALL {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDI));
    if q.c != 3 {
      ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RSI));
    }
    if q.c == 0 {
      w_s(&mut out, "\tlea bst_platform_info(%rip), %rax\n\tcall bst_rt_ccall\n");
    } else if q.c == 1 {
      w_s(&mut out, "\tlea bst_platform_acpi(%rip), %rax\n\tcall bst_rt_ccall\n");
    } else if q.c == 2 {
      w_s(&mut out, "\tlea bst_platform_cpus(%rip), %rax\n\tcall bst_rt_ccall\n");
    } else if q.c == 7 {
      w_s(&mut out, "\tcall bst_rt_fpu_load\n");
    } else if q.c == 9 {
      w_s(&mut out, "\tcall bst_rt_cpu_run\n");
    } else if q.c == 8 {
      w_s(&mut out, "\tfxsave64 (%rdi)\n");
    } else if q.c == 5 {
      w_s(&mut out, "\tmov $");
      w_num(&mut out, wrap_mul(8, q.ty));
      w_s(&mut out, ", %edx\n\tcall bst_rt_vec_try_reserve\n");
    } else if q.c == 10 || q.c == 11 {
      // A system call: the number in %rdi, the three arguments at (%rsi).
      w_s(&mut out, "\tmov %rdi, %rax\n\tmov 16(%rsi), %rdx\n\tmov (%rsi), %rdi\n\tmov 8(%rsi), %rsi\n");
      if q.c == 10 {
        w_s(&mut out, "\tcall bst_rt_sys\n");
      } else {
        w_s(&mut out, "\tcall bst_rt_fsys\n");
      }
    } else if q.c == 12 {
      w_s(&mut out, "\tmov 8(%rsi), %rdx\n\tmov (%rsi), %rsi\n\tcall bst_rt_sys_spawn\n");
    } else if q.c == 31 {
      w_s(&mut out, "\tmovslq bst_rt_argc(%rip), %rax\n");
    } else if q.c >= 20 && q.c <= 30 {
      // A call of a hosted runtime routine on the four words at (%rdi); what
      // it leaves in %rax, %rdx and %rcx goes back to the block's first three.
      w_s(&mut out, "\tpush %rdi\n\tpush %rdi\n\tmov 24(%rdi), %rcx\n\tmov 16(%rdi), %rdx\n\tmov 8(%rdi), %rsi\n\tmov (%rdi), %rdi\n\tcall ");
      if q.c == 20 {
        w_s(&mut out, "bst_rt_host_arg");
      } else if q.c == 21 {
        w_s(&mut out, "bst_rt_host_read");
      } else if q.c == 22 {
        w_s(&mut out, "bst_rt_host_write");
      } else if q.c == 23 {
        w_s(&mut out, "bst_rt_host_env");
      } else if q.c == 24 {
        w_s(&mut out, "bst_rt_host_cpus");
      } else if q.c == 25 {
        w_s(&mut out, "bst_rt_eprint");
      } else if q.c == 26 {
        w_s(&mut out, "bst_rt_spawn");
      } else if q.c == 27 {
        w_s(&mut out, "bst_rt_child_write");
      } else if q.c == 28 {
        w_s(&mut out, "bst_rt_child_close");
      } else if q.c == 29 {
        w_s(&mut out, "bst_rt_child_read_line");
      } else {
        w_s(&mut out, "bst_rt_child_wait");
      }
      w_s(&mut out, "\n\tmov (%rsp), %r8\n\tadd $16, %rsp\n\tmov %rax, (%r8)\n\tmov %rdx, 8(%r8)\n\tmov %rcx, 16(%r8)\n");
    } else {
      w_s(&mut out, "\tlea bst_cpu_wait(%rip), %rax\n\tcall bst_rt_ccall\n");
    }
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_LOCKINC {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RCX));
    w_s(&mut out, "\tlock incl (%rcx)\n");
  } else if op == IR_LOCKDEC {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RCX));
    w_s(&mut out, "\tlock decl (%rcx)\n\tsetz %al\n\tmovzbl %al, %eax\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_COPYPAGE {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDI));
    ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RSI));
    w_s(&mut out, "\tmov $512, %ecx\n\trep movsq\n");
  } else if op == IR_FILL {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDI));
    ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RAX));
    ix_mov(&mut out, ix_loc(al, q.c), ix_rl(XR_RCX));
    w_s(&mut out, "\trep stosb\n");
  } else if op == IR_CP16 {
    // Two words from c[d] to a[b], through %xmm0.
    let aps = ix_aprep(&mut out, al, q.c, q.d, 0);
    w_s(&mut out, "\tmovdqu ");
    ix_awrite(&mut out, aps, 8);
    w_s(&mut out, ", %xmm0\n");
    let apd = ix_aprep(&mut out, al, q.a, q.b, 0);
    w_s(&mut out, "\tmovups %xmm0, ");
    ix_awrite(&mut out, apd, 8);
    w_s(&mut out, "\n");
  } else if op == IR_COPY {
    // Whole words with rep movsq, then the rest with rep movsb.
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDI));
    ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RSI));
    ix_mov(&mut out, ix_loc(al, q.c), ix_rl(XR_RCX));
    w_s(&mut out, "\tmov %rcx, %rax\n\tshr $3, %rcx\n\trep movsq\n\tmov %eax, %ecx\n\tand $7, %ecx\n\trep movsb\n");
  } else if op == IR_XCHG {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RCX));
    ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RAX));
    w_s(&mut out, "\txchg %rax, (%rcx)\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_CAS {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RCX));
    ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RAX));
    ix_mov(&mut out, ix_loc(al, q.c), ix_rl(XR_RDX));
    w_s(&mut out, "\tlock cmpxchg %rdx, (%rcx)\n\tsete %al\n\tmovzbl %al, %eax\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_LOCKACQ {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RCX));
    w_s(&mut out, "1:\tmov $1, %eax\n\txchg %rax, (%rcx)\n\ttest %rax, %rax\n\tjz 2f\n\tpause\n\tjmp 1b\n2:\n");
  } else if op == IR_MMCHK {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RSI));
    ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RDX));
    w_s(&mut out, "\tcall bst_rt_mmio_check\n");
  } else if op == IR_FENCE {
    w_s(&mut out, "\tmfence\n");
  } else if op == IR_DEVR {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RCX));
    if q.c == 1 {
      w_s(&mut out, "\tmovzbl (%rcx), %eax\n");
    } else if q.c == 2 {
      w_s(&mut out, "\tmovzwl (%rcx), %eax\n");
    } else if q.c == 4 {
      w_s(&mut out, "\tmov (%rcx), %eax\n");
    } else {
      w_s(&mut out, "\tmov (%rcx), %rax\n");
    }
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_DEVW {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RCX));
    ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RDX));
    if q.c == 1 {
      w_s(&mut out, "\tmov %dl, (%rcx)\n");
    } else if q.c == 2 {
      w_s(&mut out, "\tmov %dx, (%rcx)\n");
    } else if q.c == 4 {
      w_s(&mut out, "\tmov %edx, (%rcx)\n");
    } else {
      w_s(&mut out, "\tmov %rdx, (%rcx)\n");
    }
  } else if op == IR_PIN {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDX));
    if q.c == 1 {
      w_s(&mut out, "\tinb %dx, %al\n\tmovzbl %al, %eax\n");
    } else if q.c == 2 {
      w_s(&mut out, "\tinw %dx, %ax\n\tmovzwl %ax, %eax\n");
    } else {
      w_s(&mut out, "\tinl %dx, %eax\n");
    }
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_POUT {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDX));
    ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RAX));
    if q.c == 1 {
      w_s(&mut out, "\toutb %al, %dx\n");
    } else if q.c == 2 {
      w_s(&mut out, "\toutw %ax, %dx\n");
    } else {
      w_s(&mut out, "\toutl %eax, %dx\n");
    }
  } else if op == IR_ZERO {
    let mark = vec_len(out);
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDI));
    let moved = vec_len(out) > mark;
    w_s(&mut out, "\tmov $512, %ecx\n\txor %eax, %eax\n\trep stosq\n");
    // (Without the move the address is in %rdi, which the first `rep stosq`
    // advanced: that is not the same page.)
    if !g.stage0 && moved && ix_repeats(out, mark) {
      // The same page was zeroed by the instructions just before (a page
      // table made from a page that was cleared already).
      while vec_len(out) > mark {
        vec_pop(&mut out);
      }
    }
  } else if op == IR_GETC {
    w_s(&mut out, "\tcall bst_rt_getc\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_VGROW {
    ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDI));
    w_s(&mut out, "\tmov $");
    w_num(&mut out, wrap_mul(8, q.c));
    w_s(&mut out, ", %esi\n\tcall bst_rt_vec_grow\n");
  } else if op == IR_STRLIT {
    // The bytes are in the data of the program; the literal of a syntax
    // node is added once (`x86_push_val`).
    let mut s = 0;
    while s < vec_len(g.snode) && u_at(g.snode, s) != q.a {
      s = s + 1;
    }
    if s == vec_len(g.snode) {
      let b = x86_lit_bytes(p, q.a);
      s = x86_add_string(&mut g, b);
      vec_push(&mut g.snode, q.a);
      vec_free(b);
    }
    w_s(&mut out, "\tlea .Lstr");
    w_num(&mut out, s);
    w_s(&mut out, "(%rip), %rax\n");
    ix_finish(&mut out, al, q.d, XR_RAX);
  } else if op == IR_SLOT {
    // The address of the slot whose lowest word is `slotw` words below %rbp;
    // nothing to write when every use of it is written off %rbp.
    if u_at(al.cst, q.d) != 3 {
      let ld = ix_loc(al, q.d);
      w_s(&mut out, "\tlea -");
      w_num(&mut out, wrap_mul(8, slotw));
      if ld.k == IXK_REG {
        w_s(&mut out, "(%fp), ");
        w_s(&mut out, x86_rname(ld.reg));
        w_s(&mut out, "\n");
      } else {
        w_s(&mut out, "(%fp), %rax\n");
        ix_finish(&mut out, al, q.d, XR_RAX);
      }
    }
  }
}

fn ix_jcc(out: &mut Vec[u64], op: u64, x: u64, l: u64) {
  w_s(&mut out, "\tj");
  w_s(&mut out, ix_cc(op));
  w_s(&mut out, " ");
  ix_lbl(&mut out, x, l);
  w_s(&mut out, "\n");
}

/// The jumps of a branch whose condition `op` is already in the flags.
fn ix_br_flags(out: &mut Vec[u64], x: u64, op: u64, then: u64, els: u64, next: u64) {
  if next == then {
    ix_jcc(&mut out, ix_not(op), x, els);
  } else {
    ix_jcc(&mut out, op, x, then);
    if next != els {
      ix_jump(&mut out, "jmp", x, els);
    }
  }
}

/// Does `q` wrap its result to a type narrower than 64 bits?
fn ix_wraps(m: &Mono, q: IrIns) -> bool {
  return q.c == 1 && q.ty != 0 && slen(x86_normalize(m, q.ty)) > 0;
}

/// Whether the `load` at `i` is the first of `t = load p[k]; [consts] u = t op
/// x; store p[k], u` of whole words (op `add`, `sub`, `and`, `or` or `xor`;
/// `x` an immediate or a register; no wrapping; `t` and `u` read once): the
/// position of the `store`, or 0. The three are then one instruction on memory,
/// `addq $1, (%r8,%r10,8)`.
fn ix_rmw(f: &IrFn, al: &IrAlloc, m: &Mono, nuse: &Vec[u64], i: u64) -> u64 {
  let q = ix_at(f, i);
  if q.c != 8 || q.d == IR_NONE || u_at(nuse, q.d) != 1 {
    return 0;
  }
  let mut j = wrap_add(i, 1);
  let mut aq = ix_at(f, j);
  let mut skipped = 0;
  let mut more = aq.op == IR_CONST;
  while more && skipped < 2 {
    let cl = ix_loc(al, aq.d);
    if cl.k == IXK_IMM {
      j = wrap_add(j, 1);
      skipped = skipped + 1;
      aq = ix_at(f, j);
      more = aq.op == IR_CONST;
    } else {
      more = false;
    }
  }
  if !(aq.op == IR_ADD || aq.op == IR_SUB || aq.op == IR_AND || aq.op == IR_OR || aq.op == IR_XOR) || ix_wraps(m, aq) || aq.d == IR_NONE || u_at(nuse, aq.d) != 1 {
    return 0;
  }
  let mut x = aq.b;
  if aq.a != q.d {
    // A commutative operation may have the loaded value second.
    if aq.b != q.d || aq.op == IR_SUB {
      return 0;
    }
    x = aq.a;
  } else if aq.b == q.d {
    return 0;
  }
  let lx = ix_loc(al, x);
  if !(lx.k == IXK_REG || (lx.k == IXK_IMM && ix_fits(lx.imm))) {
    return 0;
  }
  let sq = ix_at(f, wrap_add(j, 1));
  if sq.op != IR_STORE || sq.c != 8 || sq.d != aq.d || sq.a != q.a || sq.b != q.b || sq.ty != q.ty {
    return 0;
  }
  // The address is not the register the value is in, nor written in between.
  if q.a == aq.d || q.b == aq.d || q.a == q.d || q.b == q.d {
    return 0;
  }
  return wrap_add(j, 1);
}

/// Whether the `mul` at `i` by a constant of 2, 3, 4, 5, 6, 8, 9, 10 or 18 is
/// read only by an `add` at most six instructions on, with nothing between
/// that writes the registers it reads or reads the product (all in registers,
/// no wrapping): the position of that `add`, or 0. The product is then not
/// computed alone; the `add` makes it with `lea`s (`cur * 10 + c` is
/// `lea (a,a,4), t; lea (c,t,2), d`, as a compiler writes it by hand).
fn ix_scale_fuse(f: &IrFn, al: &IrAlloc, m: &Mono, nuse: &Vec[u64], i: u64) -> u64 {
  let q = ix_at(f, i);
  if q.op != IR_MUL || ix_wraps(m, q) || q.d == IR_NONE {
    return 0;
  }
  let lk = ix_loc(al, q.b);
  let la = ix_loc(al, q.a);
  if lk.k != IXK_IMM || la.k != IXK_REG {
    return 0;
  }
  let k = lk.imm;
  if !(k == 2 || k == 3 || k == 4 || k == 5 || k == 6 || k == 8 || k == 9 || k == 10 || k == 18) {
    return 0;
  }
  let mut j = wrap_add(i, 1);
  let mut found = 0;
  while found == 0 && j < wrap_add(i, 7) {
    let t = ix_at(f, j);
    if t.op == IR_ADD && !ix_wraps(m, t) && ((t.a == q.d && t.b != q.d) || (t.b == q.d && t.a != q.d)) {
      let mut y = t.b;
      if t.b == q.d {
        y = t.a;
      }
      let ly = ix_loc(al, y);
      let ld = ix_loc(al, t.d);
      // The result register may not be the one the other operand is in: the
      // first `lea` writes it.
      // The product has no other reader: it is the only use, or the `add`
      // writes it again (`cur = cur * 10; cur = cur + c`).
      if ly.k == IXK_REG && ld.k == IXK_REG && ly.reg != ld.reg && y != q.a && (u_at(nuse, q.d) == 1 || t.d == q.d) {
        found = j;
      } else {
        return 0;
      }
    } else if t.op == IR_CONST || t.op == IR_MOV || slen(ix_alu(t.op)) > 0 {
      let lt = ix_loc(al, t.d);
      if t.a == q.d || t.b == q.d || t.d == q.d || t.d == q.a {
        return 0;
      }
      // A constant that stands as an immediate writes nothing.
      if lt.k != IXK_IMM && (lt.k != IXK_REG || lt.reg == la.reg) {
        return 0;
      }
      j = wrap_add(j, 1);
    } else {
      return 0;
    }
  }
  if found == 0 {
    return 0;
  }
  return found;
}

/// Whether the 8-byte load at `i` is read only by the next instruction, an
/// `add`, `sub`, `and`, `or` or `xor` (without a normalising wrap) that puts the result in the
/// register that already holds its other operand: the operation reads memory
/// (`add (%rbx,%r11,8), %r10`), no register is loaded. A `sub` must take the
/// loaded value as its second operand.
fn ix_load_alu(f: &IrFn, al: &IrAlloc, m: &Mono, nuse: &Vec[u64], i: u64) -> bool {
  let q = ix_at(f, i);
  if q.c != 8 || u_at(nuse, q.d) != 1 {
    return false;
  }
  let nq = ix_at(f, wrap_add(i, 1));
  if slen(ix_alu(nq.op)) == 0 || nq.op == IR_MUL || ix_wraps(m, nq) || nq.a == nq.b {
    return false;
  }
  let mut x = nq.a;
  if nq.a == q.d {
    if nq.op == IR_SUB {
      return false;
    }
    x = nq.b;
  } else if nq.b != q.d {
    return false;
  }
  if x == IR_NONE || x == q.d {
    return false;
  }
  let ld = ix_loc(al, nq.d);
  let lx = ix_loc(al, x);
  return ld.k == IXK_REG && lx.k == IXK_REG && lx.reg == ld.reg;
}

struct IxRot { j: u64, x: u64, d: u64, k: u64 }

/// Whether the shift at `i` starts `d = wrap32(x << k) | (x >> (32 - k))` of
/// an `x` below 2^32 (the shifts and the `wrap` in either order, with only
/// constants that stand as immediates between them, and the three results
/// read once): a rotation of a 32-bit word. `j` is the position of the `or`
/// (0: not such a sequence), `k` the left rotation.
fn ix_rot32(f: &IrFn, al: &IrAlloc, m: &Mono, ub: &Vec[u64], nuse: &Vec[u64], i: u64) -> IxRot {
  let none = IxRot { j: 0, x: 0, d: 0, k: 0 };
  let q = ix_at(f, i);
  if (q.op != IR_SHL && q.op != IR_SHR) || q.a >= vec_len(ub) || q.d >= vec_len(nuse) || u_at(nuse, q.d) != 1 {
    return none;
  }
  // The word is below 2^32 when a bound says so or the right shift is typed
  // u32 (a u32 value is always held zero-extended).
  let mut small = u_at(ub, q.a) <= 4294967295;
  if q.op == IR_SHR && kind_t(m, q.ty) == TY_U32 {
    small = true;
  }
  let l1 = ix_loc(al, q.b);
  if l1.k != IXK_IMM || l1.imm < 1 || l1.imm > 31 || q.d == q.a {
    return none;
  }
  let mut wp = IR_NONE;
  let mut other = IR_NONE;
  let mut orp = IR_NONE;
  let mut p = wrap_add(i, 1);
  let mut going = true;
  while going && p < vec_len(f.ins) && p < wrap_add(i, 8) {
    let t = ix_at(f, p);
    let mut imm_const = false;
    if t.op == IR_CONST {
      let lc = ix_loc(al, t.d);
      imm_const = lc.k == IXK_IMM;
    }
    if imm_const {
      p = wrap_add(p, 1);
    } else if t.op == IR_WRAP && wp == IR_NONE && kind_t(m, t.ty) == TY_U32 && t.d < vec_len(nuse) && u_at(nuse, t.d) == 1 && t.d != q.a {
      wp = p;
      p = wrap_add(p, 1);
    } else if (t.op == IR_SHL || t.op == IR_SHR) && t.op != q.op && other == IR_NONE && t.a == q.a && t.d != q.a && t.d < vec_len(nuse) && u_at(nuse, t.d) == 1 {
      let l2 = ix_loc(al, t.b);
      if l2.k != IXK_IMM || wrap_add(l1.imm, l2.imm) != 32 {
        return none;
      }
      other = p;
      if t.op == IR_SHR && kind_t(m, t.ty) == TY_U32 {
        small = true;
      }
      p = wrap_add(p, 1);
    } else if t.op == IR_OR && wp != IR_NONE && other != IR_NONE {
      orp = p;
      going = false;
    } else {
      return none;
    }
  }
  if orp == IR_NONE || !small {
    return none;
  }
  let mut shl = q;
  let mut shr = ix_at(f, other);
  if q.op == IR_SHR {
    shr = q;
    shl = ix_at(f, other);
  }
  let w = ix_at(f, wp);
  let o = ix_at(f, orp);
  if w.a != shl.d || !((o.a == w.d && o.b == shr.d) || (o.b == w.d && o.a == shr.d)) || o.c != 0 || o.d == IR_NONE {
    return none;
  }
  // The wrap must follow its shift, and the temporaries must not be the word.
  let mut shl_pos = i;
  if q.op == IR_SHR {
    shl_pos = other;
  }
  if wp < shl_pos || w.d == q.a || shl.d == w.d {
    return none;
  }
  let ld = ix_loc(al, o.d);
  let lx = ix_loc(al, q.a);
  if ld.k != IXK_REG || lx.k != IXK_REG {
    return none;
  }
  let lk = ix_loc(al, shl.b);
  return IxRot { j: orp, x: q.a, d: o.d, k: lk.imm };
}

fn ix_rot32j(f: &IrFn, al: &IrAlloc, m: &Mono, ub: &Vec[u64], nuse: &Vec[u64], i: u64) -> u64 {
  let r = ix_rot32(f, al, m, ub, nuse, i);
  return r.j;
}

/// Whether the `xor`, `or` or `and` at `i` makes the word that the rotation
/// right after it (`ix_rot32`) turns, into the register of its other operand,
/// which the rotation then overwrites: `v8 = xor v3, v0; v3 = rotl(v8, k)` is
/// `xorl v0, v3; roll k, v3`. `j` is the position of the rotation's last
/// instruction (0: no such pair).
fn ix_rotprod(f: &IrFn, al: &IrAlloc, m: &Mono, ub: &Vec[u64], nuse: &Vec[u64], i: u64) -> IxRot {
  let none = IxRot { j: 0, x: 0, d: 0, k: 0 };
  let q = ix_at(f, i);
  if (q.op != IR_XOR && q.op != IR_OR && q.op != IR_AND) || q.d == IR_NONE || q.d >= vec_len(nuse) || u_at(nuse, q.d) != 2 || q.a == q.b {
    return none;
  }
  let mut k = wrap_add(i, 1);
  let mut nq = ix_at(f, k);
  let mut skipped = 0;
  while nq.op == IR_CONST && skipped < 4 {
    let lc = ix_loc(al, nq.d);
    if lc.k != IXK_IMM {
      return none;
    }
    k = wrap_add(k, 1);
    skipped = skipped + 1;
    nq = ix_at(f, k);
  }
  if nq.a != q.d {
    return none;
  }
  let rt = ix_rot32(f, al, m, ub, nuse, k);
  if rt.j == 0 || rt.x != q.d || (rt.d != q.a && rt.d != q.b) {
    return none;
  }
  let ld = ix_loc(al, rt.d);
  let mut other = q.b;
  if rt.d == q.b {
    other = q.a;
  }
  let lo = ix_loc(al, other);
  if lo.k == IXK_REG && lo.reg == ld.reg {
    return none;
  }
  if lo.k != IXK_REG && !(lo.k == IXK_IMM && ix_fits(lo.imm)) {
    return none;
  }
  return rt;
}

fn ix_rotprodj(f: &IrFn, al: &IrAlloc, m: &Mono, ub: &Vec[u64], nuse: &Vec[u64], i: u64) -> u64 {
  let r = ix_rotprod(f, al, m, ub, nuse, i);
  return r.j;
}

/// Whether the load at `i` is read only by a comparison with a constant that
/// stands as an immediate (constants that cost nothing may stand between)
/// and then the branch on it, or directly by the branch: the index of that
/// comparison (`i` for the branch alone), or 0 if the load is not such.
fn ix_load_cmp(f: &IrFn, al: &IrAlloc, nuse: &Vec[u64], ub: &Vec[u64], i: u64) -> u64 {
  let q = ix_at(f, i);
  if u_at(nuse, q.d) != 1 {
    return 0;
  }
  if q.c != 1 && q.c != 2 && q.c != 4 && q.c != 8 {
    return 0;
  }
  let nq = ix_at(f, wrap_add(i, 1));
  if nq.op == IR_BR && nq.a == q.d {
    return i;
  }
  let mut j = wrap_add(i, 1);
  let mut cm = nq;
  let mut skipped = 0;
  let mut more = true;
  while more && skipped < 4 {
    more = false;
    if cm.op == IR_CONST {
      let cl = ix_loc(al, cm.d);
      if cl.k == IXK_IMM {
        j = wrap_add(j, 1);
        skipped = skipped + 1;
        cm = ix_at(f, j);
        more = true;
      }
    }
  }
  let br = ix_at(f, wrap_add(j, 1));
  if !ix_is_cmp(cm.op) || (cm.a != q.d && cm.b != q.d) || br.op != IR_BR || br.a != cm.d || u_at(nuse, cm.d) != 1 {
    return 0;
  }
  if q.c == 8 && cm.a != cm.b {
    // A comparison with a register: `cmpq %reg, mem` (the load on the left),
    // or `cmpq mem, %reg` (on the right).
    if cm.a == q.d {
      let lr = ix_loc(al, cm.b);
      if lr.k == IXK_REG {
        return j;
      }
    } else {
      let lr = ix_loc(al, cm.a);
      if lr.k == IXK_REG {
        return j;
      }
    }
  }
  if q.c == 1 && cm.a != cm.b && cm.op < IR_SLT {
    // A byte against a register that holds a byte: `cmpb` on the byte
    // registers, the order of the unsigned comparison unchanged.
    let mut other = cm.a;
    if cm.a == q.d {
      other = cm.b;
    }
    let lr = ix_loc(al, other);
    if lr.k == IXK_REG && other < vec_len(ub) && u_at(ub, other) < 256 {
      return j;
    }
  }
  if cm.a != q.d {
    return 0;
  }
  let lb = ix_loc(al, cm.b);
  if lb.k != IXK_IMM || !ix_fits(lb.imm) {
    return 0;
  }
  if q.c == 8 {
    return j;
  }
  // A narrow load is zero-extended: the comparison is the same in the
  // narrow width when it is unsigned and the constant fits that width.
  let mut lim = 256;
  if q.c == 2 {
    lim = 65536;
  } else if q.c == 4 {
    lim = 4294967296;
  }
  if cm.op >= IR_SLT || lb.imm >= lim {
    return 0;
  }
  return j;
}

/// Writes the displacement `-k` of an address (nothing for 0).
fn ix_w_disp(out: &mut Vec[u64], k: u64) {
  if k != 0 {
    w_s(&mut out, "-");
    w_num(&mut out, k);
  }
}

/// The position of a `sub` of a register by a small constant, read once, by
/// the add that `ix_scale_fuse` pairs with the multiply at `i`, among the
/// instructions between them (so that the `lea` of the pair can carry the
/// constant as a displacement and the `sub` is not written); 0 if none.
fn ix_sub_disp(f: &IrFn, al: &IrAlloc, m: &Mono, nuse: &Vec[u64], i: u64) -> u64 {
  let mq = ix_at(f, i);
  let j = ix_scale_fuse(f, al, m, nuse, i);
  if mq.op != IR_MUL || j == 0 || j > wrap_add(i, 8) {
    return 0;
  }
  let aq = ix_at(f, j);
  let mut found = 0;
  let mut k = wrap_add(i, 1);
  while k < j && found == 0 {
    let q = ix_at(f, k);
    if q.op == IR_SUB && !ix_wraps(m, q) && q.d != IR_NONE && q.d < vec_len(nuse) && u_at(nuse, q.d) == 1 && (aq.a == q.d || aq.b == q.d) {
      let lk = ix_loc(al, q.b);
      let lx = ix_loc(al, q.a);
      let lm = ix_loc(al, mq.d);
      let ld = ix_loc(al, aq.d);
      let la = ix_loc(al, mq.a);
      let mut ok = lk.k == IXK_IMM && lk.imm != 0 && lk.imm < 1000000 && lx.k == IXK_REG;
      // x is read by the `lea`, after the multiply wrote its result and the
      // add its own, and nothing in between writes it.
      if ok {
        ok = lm.k == IXK_REG && ld.k == IXK_REG && lm.reg != lx.reg && ld.reg != lx.reg && la.k == IXK_REG && la.reg != lx.reg && q.a != mq.d;
      }
      let mut z = wrap_add(k, 1);
      while ok && z < j {
        let t = ix_at(f, z);
        let lt = ix_loc(al, t.d);
        if lt.k == IXK_REG && lt.reg == lx.reg {
          ok = false;
        }
        z = wrap_add(z, 1);
      }
      if ok {
        found = k;
      }
    }
    k = wrap_add(k, 1);
  }
  return found;
}

/// Index of the `k`th instruction of a select that starts with the comparison
/// at `i`: constants that stand as immediates (they write nothing) may lie
/// between its instructions.
fn ix_sel_pos(f: &IrFn, al: &IrAlloc, nuse: &Vec[u64], i: u64, k: u64) -> u64 {
  let mut p = i;
  let mut t = 0;
  while t < k && t < 8 {
    p = wrap_add(p, 1);
    let mut more = true;
    let mut skipped = 0;
    while more && skipped < 4 {
      more = false;
      let c = ix_at(f, p);
      if c.op == IR_CONST {
        let cl = ix_loc(al, c.d);
        if cl.k == IXK_IMM {
          p = wrap_add(p, 1);
          skipped = skipped + 1;
          more = true;
        }
      } else if c.op == IR_MOV && c.d != IR_NONE && c.a != IR_NONE && u_at(nuse, c.d) == 1 {
        // A copy of an arm, read only by the select: the select reads the
        // arm itself.
        let ld = ix_loc(al, c.d);
        let la = ix_loc(al, c.a);
        if ld.k == IXK_REG && la.k == IXK_REG {
          p = wrap_add(p, 1);
          skipped = skipped + 1;
          more = true;
        }
      }
    }
    t = t + 1;
  }
  return p;
}

/// `v`, or what the copy of it among the select's instructions copies (the
/// select's `xor`, `and` and `xor` follow the instruction at `n`).
fn ix_sel_src(f: &IrFn, al: &IrAlloc, nuse: &Vec[u64], n: u64, v: u64) -> u64 {
  let last = ix_sel_pos(f, al, nuse, n, 3);
  let mut p = wrap_add(n, 1);
  let mut r = v;
  while p < last && p < wrap_add(n, 24) {
    let c = ix_at(f, p);
    if c.op == IR_MOV && c.d == v {
      r = c.a;
    }
    p = wrap_add(p, 1);
  }
  return r;
}

/// The arm a select takes when its condition is false: the operand of the
/// last `xor` that is not the masked difference.
fn ix_sel_ve(f: &IrFn, al: &IrAlloc, nuse: &Vec[u64], n: u64) -> u64 {
  let an = ix_at(f, ix_sel_pos(f, al, nuse, n, 2));
  let x2 = ix_at(f, ix_sel_pos(f, al, nuse, n, 3));
  if x2.b == an.d {
    return ix_sel_src(f, al, nuse, n, x2.a);
  }
  return ix_sel_src(f, al, nuse, n, x2.b);
}

/// The arm it takes when its condition is true: the other operand of the
/// first `xor`.
fn ix_sel_vt(f: &IrFn, al: &IrAlloc, nuse: &Vec[u64], n: u64) -> u64 {
  let x1 = ix_at(f, ix_sel_pos(f, al, nuse, n, 1));
  let ve = ix_sel_ve(f, al, nuse, n);
  if ix_sel_src(f, al, nuse, n, x1.a) == ve {
    return ix_sel_src(f, al, nuse, n, x1.b);
  }
  return ix_sel_src(f, al, nuse, n, x1.a);
}

/// Whether the three instructions after the one at `n` (`iropt_ifconv`'s
/// `d = ve ^ ((vt ^ ve) & m)` with the mask `m`) are a select that `cmov`
/// makes: each temporary read once, the result in a register and the
/// register that `cmov` reads from not one the result shares with the other
/// arm.
fn ix_sel_ok(f: &IrFn, al: &IrAlloc, nuse: &Vec[u64], n: u64, m: u64) -> bool {
  let x1 = ix_at(f, ix_sel_pos(f, al, nuse, n, 1));
  let an = ix_at(f, ix_sel_pos(f, al, nuse, n, 2));
  let x2 = ix_at(f, ix_sel_pos(f, al, nuse, n, 3));
  if x1.op != IR_XOR || x1.c != 0 || an.op != IR_AND || !((an.a == x1.d && an.b == m) || (an.a == m && an.b == x1.d)) || x2.op != IR_XOR || (x2.b != an.d && x2.a != an.d) || (ix_sel_ve(f, al, nuse, n) != ix_sel_src(f, al, nuse, n, x1.a) && ix_sel_ve(f, al, nuse, n) != ix_sel_src(f, al, nuse, n, x1.b)) {
    return false;
  }
  if u_at(nuse, x1.d) != 1 || u_at(nuse, an.d) != 1 {
    return false;
  }
  let ld = ix_loc(al, x2.d);
  let lt = ix_loc(al, ix_sel_vt(f, al, nuse, n));
  let le = ix_loc(al, ix_sel_ve(f, al, nuse, n));
  if ld.k != IXK_REG || (lt.k != IXK_REG && lt.k != IXK_MEM && lt.k != IXK_IMM) {
    return false;
  }
  if ix_sel_src(f, al, nuse, n, x1.a) == ix_sel_src(f, al, nuse, n, x1.b) || x2.d == IR_NONE {
    return false;
  }
  // The result may be the register of the other arm (it is then loaded
  // first) but not of the arm taken by the condition unless the arms swap.
  if lt.k == IXK_REG && lt.reg == ld.reg && (le.k != IXK_REG && le.k != IXK_MEM) {
    return false;
  }
  return true;
}

/// How many selects by the comparison at `i` and its mask (`neg`) the
/// instructions after them are, all of which `cmov` makes (one, or two that
/// share the mask), or 0.
fn ix_cmov_n(f: &IrFn, al: &IrAlloc, nuse: &Vec[u64], i: u64) -> u64 {
  let q = ix_at(f, i);
  let n = wrap_add(i, 1);
  let ng = ix_at(f, n);
  if !(ix_is_cmp(q.op) && ng.op == IR_NEG && ng.a == q.d && u_at(nuse, q.d) == 1) {
    return 0;
  }
  let users = u_at(nuse, ng.d);
  if users == 1 && ix_sel_ok(f, al, nuse, n, ng.d) {
    return 1;
  }
  if users == 2 && ix_sel_ok(f, al, nuse, n, ng.d) {
    let n2 = ix_sel_pos(f, al, nuse, n, 3);
    if ix_sel_ok(f, al, nuse, n2, ng.d) {
      return 2;
    }
  }
  return 0;
}

/// Writes the conditional move of the select after the instruction at `n`,
/// the flags of comparison `op` being set; the index of its last instruction.
fn ix_emit_cmov(out: &mut Vec[u64], f: &IrFn, al: &IrAlloc, nuse: &Vec[u64], n: u64, op: u64) -> u64 {
  let x2 = ix_at(f, ix_sel_pos(f, al, nuse, n, 3));
  let ld = ix_loc(al, x2.d);
  let lt = ix_loc(al, ix_sel_vt(f, al, nuse, n));
  let le = ix_loc(al, ix_sel_ve(f, al, nuse, n));
  if lt.k == IXK_REG && lt.reg == ld.reg {
    // The result already is the register of the arm the condition takes:
    // load the other arm when the condition is false.
    let mut src = le;
    if le.k == IXK_IMM {
      ix_mov(&mut out, le, ix_rl(XR_RCX));
      src = ix_rl(XR_RCX);
    }
    w_s(&mut out, "\tcmov");
    w_s(&mut out, ix_cc(ix_not(op)));
    w_s(&mut out, " ");
    ix_op(&mut out, src);
  } else {
    ix_mov(&mut out, le, ld);
    let mut src = lt;
    if lt.k == IXK_IMM {
      ix_mov(&mut out, lt, ix_rl(XR_RCX));
      src = ix_rl(XR_RCX);
    }
    w_s(&mut out, "\tcmov");
    w_s(&mut out, ix_cc(op));
    w_s(&mut out, " ");
    ix_op(&mut out, src);
  }
  w_s(&mut out, ", ");
  w_s(&mut out, x86_rname(ld.reg));
  w_s(&mut out, "\n");
  return ix_sel_pos(f, al, nuse, n, 3);
}

/// `t = mul a, 3|5|9` (no wrap) and the `d = add t, imm` after it (constants
/// that stand as immediates may lie between), `t` read by that `add` alone,
/// `a` and `d` in registers: the position of the `add`, for one
/// `lea imm(a, a, 2|4|8)`; IR_NONE if it is not so.
fn ix_mul_lea(f: &IrFn, al: &IrAlloc, nuse: &Vec[u64], i: u64) -> u64 {
  let q = ix_at(f, i);
  if q.op != IR_MUL || q.c != 0 || q.d >= vec_len(nuse) || u_at(nuse, q.d) != 1 {
    return IR_NONE;
  }
  let mut j = wrap_add(i, 1);
  let mut nq = ix_at(f, j);
  let mut nl = ix_loc(al, nq.d);
  while nq.op == IR_CONST && nl.k == IXK_IMM && j < wrap_add(i, 4) {
    j = wrap_add(j, 1);
    nq = ix_at(f, j);
    nl = ix_loc(al, nq.d);
  }
  if nq.op != IR_ADD || nq.c != 0 || nq.a != q.d || nq.b == q.d {
    return IR_NONE;
  }
  let mut la = ix_loc(al, q.a);
  let mut lm = ix_loc(al, q.b);
  if la.k == IXK_IMM {
    lm = la;
    la = ix_loc(al, q.b);
  }
  let lb = ix_loc(al, nq.b);
  let ld = ix_loc(al, nq.d);
  if la.k != IXK_REG || ld.k != IXK_REG || lm.k != IXK_IMM || lb.k != IXK_IMM {
    return IR_NONE;
  }
  if (lm.imm == 3 || lm.imm == 5 || lm.imm == 9) && lb.imm <= 2147483647 {
    return j;
  }
  return IR_NONE;
}

/// Whether instruction `i` is an `and` of a register with an immediate (or a
/// `%` by 2) that only a comparison for equality with zero, then the branch on
/// it, read (constants that stand as immediates may lie between): the index of
/// the comparison, or 0 if it is not so.
fn ix_test_br(f: &IrFn, al: &IrAlloc, nuse: &Vec[u64], i: u64) -> u64 {
  let q = ix_at(f, i);
  if (q.op != IR_AND && q.op != IR_REM) || q.c != 0 || u_at(nuse, q.d) != 1 {
    return 0;
  }
  let la = ix_loc(al, q.a);
  let lb = ix_loc(al, q.b);
  if la.k != IXK_REG || lb.k != IXK_IMM || !ix_fits(lb.imm) {
    return 0;
  }
  if q.op == IR_REM && lb.imm != 2 {
    return 0;
  }
  let mut j = wrap_add(i, 1);
  let mut cm = ix_at(f, j);
  let mut skipped = 0;
  let mut more = true;
  while more && skipped < 4 {
    more = false;
    if cm.op == IR_CONST {
      let cl = ix_loc(al, cm.d);
      if cl.k == IXK_IMM {
        j = wrap_add(j, 1);
        skipped = skipped + 1;
        cm = ix_at(f, j);
        more = true;
      }
    }
  }
  let br = ix_at(f, wrap_add(j, 1));
  if (cm.op != IR_EQ && cm.op != IR_NE) || cm.a != q.d || br.op != IR_BR || br.a != cm.d || u_at(nuse, cm.d) != 1 {
    return 0;
  }
  let lz = ix_loc(al, cm.b);
  if lz.k != IXK_IMM || lz.imm != 0 {
    return 0;
  }
  return j;
}

/// Whether label `t` is among the labels that stand in a row from
/// instruction `i` on: they are all at one address, so a branch to any of
/// them is a branch to the next instruction.
fn ix_label_run_has(f: &IrFn, i: u64, t: u64) -> bool {
  let mut j = i;
  while j < wrap_add(i, 64) {
    let q = ix_at(f, j);
    if q.op != IR_LABEL {
      return false;
    }
    if q.a == t {
      return true;
    }
    j = wrap_add(j, 1);
  }
  return false;
}

/// The label a branch to `then` or `els` falls through to when the labels
/// from instruction `i` on include one of them (`then` first), else the
/// first of them, else IR_NONE.
fn ix_pick_next(f: &IrFn, i: u64, then: u64, els: u64) -> u64 {
  if ix_label_run_has(f, i, then) {
    return then;
  }
  if ix_label_run_has(f, i, els) {
    return els;
  }
  let q = ix_at(f, i);
  if q.op == IR_LABEL {
    return q.a;
  }
  return IR_NONE;
}

/// Instruction `i` of `f` (an instruction of op 0 past the end).
fn ix_at(f: &IrFn, i: u64) -> IrIns {
  if i < vec_len(f.ins) {
    return vec_get(f.ins, i);
  }
  return IrIns { op: 0, d: IR_NONE, a: IR_NONE, b: IR_NONE, c: 0, ty: 0 };
}

/// `smp_run` (a PCALL with c == 13; q.ty packs the callee instance, the
/// parameter count and which parameters are `&mut`): the block of shared
/// words is at register `q.a`. The thunk (C calling convention, the block's
/// address in %rdi) calls the function with the block's words and a token
/// for each `&mut` parameter; the other processors run it, this one too, and
/// it waits for them.
fn ix_smp(out: &mut Vec[u64], g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, al: &IrAlloc, q: IrIns) {
  let x = q.ty / 65536;
  let np = (q.ty / 4096) % 16;
  let mask = q.ty % 4096;
  let k = g.nsmp;
  g.nsmp = wrap_add(k, 1);
  x86_sym(&mut g, m, p, x);
  let fname = g.ln;
  g.ln = vec_new[u64]();
  w_s(&mut g.smp, "bst_rt_smp_thunk");
  w_num(&mut g.smp, k);
  w_s(&mut g.smp, ":\n\tpush %rbp\n\tmov %rsp, %rbp\n\tpush %rbx\n\tpush $0\n\tmov %rdi, %rbx\n");
  let mut j = 0;
  while j < np && j < 16 {
    if (mask >> j) & 1 == 1 {
      w_s(&mut g.smp, "\tlea -16(%rbp), %rax\n\tpush %rax\n");
    } else {
      w_s(&mut g.smp, "\tpush ");
      w_num(&mut g.smp, wrap_mul(8, j));
      w_s(&mut g.smp, "(%rbx)\n");
    }
    j = j + 1;
  }
  let na = x86_regargs(&mut g, c, &mut m, p, x);
  if na == np {
    j = 0;
    while j < na {
      w_s(&mut g.smp, "\tpop ");
      w_s(&mut g.smp, x86_rname(x86_argreg(j)));
      w_s(&mut g.smp, "\n");
      j = j + 1;
    }
  }
  w_s(&mut g.smp, "\tcall ");
  w_append(&mut g.smp, fname);
  w_s(&mut g.smp, "\n\tmov -8(%rbp), %rbx\n\tleave\n\tret\n\n");
  vec_free(fname);
  ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDI));
  w_s(&mut out, "\tpush %rdi\n\tpush %rdi\n\tmov %rdi, %rsi\n\tlea bst_rt_smp_thunk");
  w_num(&mut out, k);
  w_s(&mut out, "(%rip), %rdi\n\tcall bst_rt_smp_start\n\tmov (%rsp), %rdi\n\tcall bst_rt_smp_thunk");
  w_num(&mut out, k);
  w_s(&mut out, "\n\tcall bst_rt_smp_join\n\tadd $16, %rsp\n");
}

/// The body of the function: its instructions.
fn ix_body(out: &mut Vec[u64], f: &IrFn, al: &IrAlloc, g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, nuse: &Vec[u64], ub: &Vec[u64], moff: &Vec[u64], base: u64, words: u64, rswap: bool, retoff: u64) {
  let n = vec_len(f.ins);
  // The position after each label (0: no such label).
  let mut lpos = vec_new[u64]();
  let mut z = 0;
  while z < f.nlabel && z < 100000000 {
    vec_push(&mut lpos, 0);
    z = z + 1;
  }
  z = 0;
  while z < n {
    let lq = vec_get(f.ins, z);
    if lq.op == IR_LABEL {
      ra_set(&mut lpos, lq.a, z + 1);
    }
    z = z + 1;
  }
  // The labels a branch comes back to (loop heads), which get aligned: a
  // jump (or branch) to a label placed before it (but not the jump that ends a
  // cold arm `iropt_coldarm` moved, which has `b` = 1), and the targets of the
  // test that a jump to a test block repeats.
  let mut heads = vec_new[u64]();
  z = 0;
  while z < f.nlabel && z < 100000000 {
    vec_push(&mut heads, 0);
    z = z + 1;
  }
  z = 0;
  while z < n {
    let hq = vec_get(f.ins, z);
    if hq.op == IR_JMP && hq.b != 1 {
      let lp = u_at(lpos, hq.a);
      if lp != 0 && lp <= z {
        ra_set(&mut heads, hq.a, 1);
      }
      let t1 = ix_at(f, lp);
      let t2 = ix_at(f, wrap_add(lp, 1));
      let mut tb = t1;
      if lp != 0 && ix_is_cmp(t1.op) && t2.op == IR_BR && t2.a == t1.d {
        tb = t2;
      }
      if lp != 0 && tb.op == IR_BR {
        if u_at(lpos, tb.b) != 0 && u_at(lpos, tb.b) <= z {
          ra_set(&mut heads, tb.b, 1);
        }
        if u_at(lpos, tb.c) != 0 && u_at(lpos, tb.c) <= z {
          ra_set(&mut heads, tb.c, 1);
        }
      }
    } else if hq.op == IR_BR {
      if u_at(lpos, hq.b) != 0 && u_at(lpos, hq.b) <= z {
        ra_set(&mut heads, hq.b, 1);
      }
      if u_at(lpos, hq.c) != 0 && u_at(lpos, hq.c) <= z {
        ra_set(&mut heads, hq.c, 1);
      }
    }
    z = z + 1;
  }
  // Slots and the result areas of calls that return into the frame share
  // one area (`ix_share_slots`).
  let slotw = base;
  // %rax holds the processor's context block (cpu_get and cpu_set write it)
  // from the last of those instructions, if only instructions that keep
  // %rax came since.
  let mut ctx = false;
  let mut pend_j = 0;
  let mut pend_i = 0;
  // A `y = x - K` that the `lea` of the add after it (`ix_scale_fuse`) takes as a displacement: y, the register of x and K.
  let mut sk_y = IR_NONE;
  let mut sk_reg = 0;
  let mut sk_k = 0;
  let mut i = 0;
  while i < n {
    let live = ctx;
    ctx = false;
    let q = vec_get(f.ins, i);
    let nq = ix_at(f, i + 1);
    let lnq = ix_loc(al, nq.d);
    if pend_j != 0 && i == pend_j {
      // The `add` of a product kept for it (`ix_scale_fuse`).
      let mq = ix_at(f, pend_i);
      let mut y = q.b;
      if q.b == mq.d {
        y = q.a;
      }
      let la = ix_loc(al, mq.a);
      let mut ly = ix_loc(al, y);
      let mut disp = 0;
      if y == sk_y {
        ly = ix_rl(sk_reg);
        disp = sk_k;
      }
      let ld = ix_loc(al, q.d);
      let lk = ix_loc(al, mq.b);
      let k = lk.imm;
      let mut sc = k;
      if k == 3 || k == 5 || k == 9 || k == 6 || k == 10 || k == 18 {
        if k == 3 || k == 6 {
          sc = 2;
        } else if k == 5 || k == 10 {
          sc = 4;
        } else {
          sc = 8;
        }
        // d = a + a * sc
        w_s(&mut out, "\tlea (");
        w_s(&mut out, x86_rname(la.reg));
        w_s(&mut out, ", ");
        w_s(&mut out, x86_rname(la.reg));
        w_s(&mut out, ", ");
        w_num(&mut out, sc);
        w_s(&mut out, "), ");
        w_s(&mut out, x86_rname(ld.reg));
        w_s(&mut out, "\n");
        let mut sc2 = 1;
        if k == 6 || k == 10 || k == 18 {
          sc2 = 2;
        }
        w_s(&mut out, "\tlea ");
        ix_w_disp(&mut out, disp);
        w_s(&mut out, "(");
        w_s(&mut out, x86_rname(ly.reg));
        w_s(&mut out, ", ");
        w_s(&mut out, x86_rname(ld.reg));
        if sc2 > 1 {
          w_s(&mut out, ", 2");
        }
        w_s(&mut out, "), ");
        w_s(&mut out, x86_rname(ld.reg));
        w_s(&mut out, "\n");
      } else {
        w_s(&mut out, "\tlea ");
        ix_w_disp(&mut out, disp);
        w_s(&mut out, "(");
        w_s(&mut out, x86_rname(ly.reg));
        w_s(&mut out, ", ");
        w_s(&mut out, x86_rname(la.reg));
        w_s(&mut out, ", ");
        w_num(&mut out, sc);
        w_s(&mut out, "), ");
        w_s(&mut out, x86_rname(ld.reg));
        w_s(&mut out, "\n");
      }
      pend_j = 0;
      sk_y = IR_NONE;
    } else if q.op == IR_SUB && sk_y == q.d && pend_j != 0 {
      // Taken by the `lea` of the add (see `ix_sub_disp`).
    } else if q.op == IR_MUL && pend_j == 0 && ix_scale_fuse(f, al, m, nuse, i) != 0 {
      pend_j = ix_scale_fuse(f, al, m, nuse, i);
      pend_i = i;
      let sp = ix_sub_disp(f, al, m, nuse, i);
      if sp != 0 {
        let sq = ix_at(f, sp);
        let lx = ix_loc(al, sq.a);
        let lkk = ix_loc(al, sq.b);
        sk_y = sq.d;
        sk_reg = lx.reg;
        sk_k = lkk.imm;
      }
    } else if q.op == IR_LABEL {
      if u_at(heads, q.a) == 1 {
        w_s(&mut out, "\t.p2align 4\n");
      }
      ix_lbl(&mut out, f.x, q.a);
      w_s(&mut out, ":\n");
    } else if q.op == IR_JMP {
      // A jump to a block that is only a test repeats the test here
      // (the loop is entered at its test and tested again at its end).
      let lp0 = u_at(lpos, q.a);
      // Constants that stand as immediates cost nothing, so a test that
      // starts with them (`v = const 512; c = lt i, v`) is still just a test.
      let mut lp = lp0;
      let mut skipped = 0;
      let mut more = lp != 0;
      while more && skipped < 8 {
        let cq = ix_at(f, lp);
        let cl = ix_loc(al, cq.d);
        if cq.op == IR_CONST && cl.k == IXK_IMM {
          lp = wrap_add(lp, 1);
          skipped = skipped + 1;
        } else {
          more = false;
        }
      }
      let h1 = ix_at(f, lp);
      let h2 = ix_at(f, wrap_add(lp, 1));
      let falls = ix_label_run_has(f, i + 1, q.a);
      if lp0 != 0 && h1.op == IR_BR && !falls {
        ix_cmp_zero(&mut out, al, h1.a);
        ix_br_flags(&mut out, f.x, IR_NE, h1.b, h1.c, ix_pick_next(f, i + 1, h1.b, h1.c));
      } else if lp0 != 0 && ix_is_cmp(h1.op) && h2.op == IR_BR && h2.a == h1.d && u_at(nuse, h1.d) == 1 && !falls {
        let cop = ix_cmp_br(&mut out, al, h1.a, h1.b, h1.op);
        ix_br_flags(&mut out, f.x, cop, h2.b, h2.c, ix_pick_next(f, i + 1, h2.b, h2.c));
      } else if !falls {
        ix_jump(&mut out, "jmp", f.x, q.a);
      }
    } else if q.op == IR_BR {
      ix_cmp_zero(&mut out, al, q.a);
      ix_br_flags(&mut out, f.x, IR_NE, q.b, q.c, ix_pick_next(f, i + 1, q.b, q.c));
    } else if (q.op == IR_XOR || q.op == IR_OR || q.op == IR_AND) && ix_rotprodj(f, al, m, ub, nuse, i) != 0 {
      // The word of a rotation made in the register the rotation overwrites.
      let rt = ix_rotprod(f, al, m, ub, nuse, i);
      let ldr = ix_loc(al, rt.d);
      let mut other = q.b;
      if rt.d == q.b {
        other = q.a;
      }
      let lor = ix_loc(al, other);
      w_s(&mut out, "\t");
      w_s(&mut out, ix_alu(q.op));
      w_s(&mut out, "l ");
      if lor.k == IXK_IMM {
        ix_w_imm(&mut out, lor.imm);
      } else {
        w_s(&mut out, ix_name32(lor.reg));
      }
      w_s(&mut out, ", ");
      w_s(&mut out, ix_name32(ldr.reg));
      w_s(&mut out, "\n\troll $");
      w_num(&mut out, rt.k);
      w_s(&mut out, ", ");
      w_s(&mut out, ix_name32(ldr.reg));
      w_s(&mut out, "\n");
      i = rt.j;
    } else if (q.op == IR_SHL || q.op == IR_SHR) && ix_rot32j(f, al, m, ub, nuse, i) != 0 {
      // A rotation of a 32-bit word: `roll`.
      let rt = ix_rot32(f, al, m, ub, nuse, i);
      let ldr = ix_loc(al, rt.d);
      let lxr = ix_loc(al, rt.x);
      if lxr.reg != ldr.reg {
        w_s(&mut out, "\tmovl ");
        w_s(&mut out, ix_name32(lxr.reg));
        w_s(&mut out, ", ");
        w_s(&mut out, ix_name32(ldr.reg));
        w_s(&mut out, "\n");
      }
      w_s(&mut out, "\troll $");
      w_num(&mut out, rt.k);
      w_s(&mut out, ", ");
      w_s(&mut out, ix_name32(ldr.reg));
      w_s(&mut out, "\n");
      i = rt.j;
    } else if q.op == IR_LOAD && ix_rmw(f, al, m, nuse, i) != 0 {
      // `t = load p[k]; u = t op x; store p[k], u`: one instruction on memory.
      let j = ix_rmw(f, al, m, nuse, i);
      let mut k = wrap_add(i, 1);
      let mut aq = ix_at(f, k);
      while aq.op == IR_CONST {
        k = wrap_add(k, 1);
        aq = ix_at(f, k);
      }
      let mut x = aq.b;
      if aq.a != q.d {
        x = aq.a;
      }
      let ap = ix_aprep(&mut out, al, q.a, q.b, q.ty);
      w_s(&mut out, "\t");
      w_s(&mut out, ix_alu(aq.op));
      w_s(&mut out, "q ");
      ix_op(&mut out, ix_loc(al, x));
      w_s(&mut out, ", ");
      ix_awrite(&mut out, ap, 8);
      w_s(&mut out, "\n");
      i = j;
    } else if q.op == IR_LOAD && ix_load_cmp(f, al, nuse, ub, i) != 0 {
      // A load that only a comparison with a constant (or the branch) reads:
      // the comparison reads memory, no register is loaded.
      let j = ix_load_cmp(f, al, nuse, ub, i);
      let cm = ix_at(f, j);
      let br = ix_at(f, wrap_add(j, 1));
      let ap = ix_aprep(&mut out, al, q.a, q.b, q.ty);
      let mut sz = 1;
      if q.c == 8 {
        sz = 8;
      }
      let mut op = IR_NE;
      let mut imm = 0;
      let mut rg = XR_RAX;
      let mut byreg = false;
      if j != i {
        op = cm.op;
        let lb = ix_loc(al, cm.b);
        imm = lb.imm;
        if cm.a == q.d && lb.k == IXK_REG {
          byreg = true;
          rg = lb.reg;
        } else if cm.b == q.d {
          let la2 = ix_loc(al, cm.a);
          byreg = true;
          rg = la2.reg;
        }
      }
      if q.c == 1 {
        w_s(&mut out, "\tcmpb ");
      } else if q.c == 2 {
        w_s(&mut out, "\tcmpw ");
      } else if q.c == 4 {
        w_s(&mut out, "\tcmpl ");
      } else {
        w_s(&mut out, "\tcmpq ");
      }
      if byreg && j != i && cm.b == q.d && (op != IR_EQ && op != IR_NE || q.c == 1) {
        // The loaded word is the right operand: `cmpq mem, %reg` compares
        // the register with it, in the order of the comparison.
        ix_awrite(&mut out, ap, sz);
        w_s(&mut out, ", ");
        if q.c == 1 {
          w_s(&mut out, ix_name8(rg));
        } else {
          w_s(&mut out, x86_rname(rg));
        }
      } else {
        if byreg && q.c == 1 {
          w_s(&mut out, ix_name8(rg));
        } else if byreg {
          w_s(&mut out, x86_rname(rg));
        } else {
          ix_w_imm(&mut out, imm);
        }
        w_s(&mut out, ", ");
        ix_awrite(&mut out, ap, sz);
      }
      w_s(&mut out, "\n");
      ix_br_flags(&mut out, f.x, op, br.b, br.c, ix_pick_next(f, wrap_add(j, 2), br.b, br.c));
      i = wrap_add(j, 1);
    } else if ix_test_br(f, al, nuse, i) != 0 {
      // `x & mask` (or `x % 2`) that only a comparison with zero and the branch read: `test`.
      let j = ix_test_br(f, al, nuse, i);
      let cm = ix_at(f, j);
      let br = ix_at(f, wrap_add(j, 1));
      let la = ix_loc(al, q.a);
      let mut mask = ix_loc(al, q.b);
      if q.op == IR_REM {
        mask = ix_il(1);
      }
      ix_ins2(&mut out, "test", mask, la);
      ix_br_flags(&mut out, f.x, cm.op, br.b, br.c, ix_pick_next(f, wrap_add(j, 2), br.b, br.c));
      i = wrap_add(j, 1);
    } else if q.op == IR_LOAD && ix_load_alu(f, al, m, nuse, i) {
      let ld = ix_loc(al, nq.d);
      let ap = ix_aprep(&mut out, al, q.a, q.b, q.ty);
      w_s(&mut out, "\t");
      w_s(&mut out, ix_alu(nq.op));
      w_s(&mut out, " ");
      ix_awrite(&mut out, ap, 8);
      w_s(&mut out, ", ");
      w_s(&mut out, x86_rname(ld.reg));
      w_s(&mut out, "\n");
      i = i + 1;
    } else if ix_mul_lea(f, al, nuse, i) != IR_NONE {
      // `3 * x + 1` and the like: one lea.
      let aq = ix_at(f, ix_mul_lea(f, al, nuse, i));
      let mut lm = ix_loc(al, q.b);
      let mut la = ix_loc(al, q.a);
      if la.k == IXK_IMM {
        lm = la;
        la = ix_loc(al, q.b);
      }
      let lb = ix_loc(al, aq.b);
      let ld = ix_loc(al, aq.d);
      w_s(&mut out, "\tlea ");
      w_num(&mut out, lb.imm);
      w_s(&mut out, "(");
      w_s(&mut out, x86_rname(la.reg));
      w_s(&mut out, ", ");
      w_s(&mut out, x86_rname(la.reg));
      w_s(&mut out, ", ");
      w_num(&mut out, wrap_sub(lm.imm, 1));
      w_s(&mut out, "), ");
      w_s(&mut out, x86_rname(ld.reg));
      w_s(&mut out, "\n");
      i = ix_mul_lea(f, al, nuse, i);
    } else if ix_cmov_n(f, al, nuse, i) > 0 {
      // A select (or two that share the mask) by a comparison, which
      // `iropt_ifconv` wrote as `d = ve ^ ((vt ^ ve) & -(a ? b))`: the flags
      // of the comparison, then a conditional move for each, on its
      // condition (or on the opposite one when the result already is the
      // register of the arm the condition takes).
      let cn = ix_cmov_n(f, al, nuse, i);
      let mut op = q.op;
      if q.op == IR_GT {
        ix_cmp(&mut out, al, q.b, q.a);
        op = IR_LT;
      } else {
        ix_cmp(&mut out, al, q.a, q.b);
      }
      let mut last = ix_emit_cmov(&mut out, f, al, nuse, wrap_add(i, 1), op);
      if cn == 2 {
        last = ix_emit_cmov(&mut out, f, al, nuse, last, op);
      }
      i = last;
    } else if (q.op == IR_LT || q.op == IR_GT) && nq.op == IR_NEG && nq.a == q.d && u_at(nuse, q.d) == 1 && lnq.k == IXK_REG {
      // The mask of an unsigned comparison (`-(a < b)`, what a select by it
      // wants): the borrow of the comparison spread over a register.
      let lm = ix_loc(al, nq.d);
      if q.op == IR_LT {
        ix_cmp(&mut out, al, q.a, q.b);
      } else {
        ix_cmp(&mut out, al, q.b, q.a);
      }
      w_s(&mut out, "\tsbb ");
      w_s(&mut out, x86_rname(lm.reg));
      w_s(&mut out, ", ");
      w_s(&mut out, x86_rname(lm.reg));
      w_s(&mut out, "\n");
      i = i + 1;
    } else if q.op == IR_LOAD && q.c == 1 && ix_ld8cmp(f, al, nuse, i) != IR_NONE {
      // A byte loaded only to be compared for (in)equality with the byte
      // loaded just before: `cmpb mem, %reg8`, no register for the second.
      let o = ix_ld8cmp(f, al, nuse, i);
      let cq = ix_at(f, i + 1);
      let bq = ix_at(f, i + 2);
      let lo = ix_loc(al, o);
      let ap = ix_aprep(&mut out, al, q.a, q.b, q.ty);
      w_s(&mut out, "\tcmpb ");
      ix_awrite(&mut out, ap, 1);
      w_s(&mut out, ", ");
      w_s(&mut out, ix_name8(lo.reg));
      w_s(&mut out, "\n");
      ix_br_flags(&mut out, f.x, cq.op, bq.b, bq.c, ix_pick_next(f, i + 3, bq.b, bq.c));
      i = i + 2;
    } else if ix_is_cmp(q.op) && nq.op == IR_BR && nq.a == q.d && u_at(nuse, q.d) == 1 {
      // A comparison that only the branch after it reads: no boolean.
      let cop = ix_cmp_br(&mut out, al, q.a, q.b, q.op);
      ix_br_flags(&mut out, f.x, cop, nq.b, nq.c, ix_pick_next(f, i + 2, nq.b, nq.c));
      i = i + 1;
    } else if q.op == IR_RET && q.c > 0 {
      // A result of more than two words goes to the space the caller reserved.
      let mut rb = XR_RSI;
      if q.a != IR_NONE {
        rb = ix_use(&mut out, al, q.a, XR_RSI);
      }
      let mut j = 0;
      while j < q.c && j < 4096 {
        // A value kept in its word of the result area needs no store.
        let kept = q.a == IR_NONE && ix_in_result(al, u_at(f.args, wrap_add(q.b, j)), wrap_add(retoff / 8, j));
        if kept {
        } else if q.a == IR_NONE {
          // A register or a small constant is stored as it is.
          let src = ix_loc(al, u_at(f.args, wrap_add(q.b, j)));
          if src.k == IXK_REG {
            w_s(&mut out, "\tmov ");
            w_s(&mut out, x86_rname(src.reg));
            w_s(&mut out, ", ");
          } else if src.k == IXK_IMM && ix_fits(src.imm) {
            w_s(&mut out, "\tmovq ");
            ix_w_imm(&mut out, src.imm);
            w_s(&mut out, ", ");
          } else {
            ix_mov(&mut out, src, ix_rl(XR_RAX));
            w_s(&mut out, "\tmov %rax, ");
          }
        } else {
          w_s(&mut out, "\tmov ");
          w_num(&mut out, wrap_mul(8, j));
          w_s(&mut out, "(");
          w_s(&mut out, x86_rname(rb));
          w_s(&mut out, "), %rax\n\tmov %rax, ");
        }
        if !kept {
          w_num(&mut out, wrap_add(retoff, wrap_mul(8, j)));
          w_s(&mut out, "(%fp)\n");
        }
        j = j + 1;
      }
      if i + 1 < n {
        w_s(&mut out, "\tjmp ");
        ix_lbl(&mut out, f.x, IR_NONE);
        w_s(&mut out, "\n");
      }
    } else if q.op == IR_RET {
      if rswap && q.a != IR_NONE && q.b != IR_NONE {
        ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RAX));
        ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RDX));
      } else {
        if q.a != IR_NONE {
          ix_mov(&mut out, ix_loc(al, q.a), ix_rl(XR_RAX));
        }
        if q.b != IR_NONE {
          ix_mov(&mut out, ix_loc(al, q.b), ix_rl(XR_RDX));
        }
      }
      if i + 1 < n {
        w_s(&mut out, "\tjmp ");
        ix_lbl(&mut out, f.x, IR_NONE);
        w_s(&mut out, "\n");
      }
    } else if q.op == IR_UNREACH {
      w_s(&mut out, "\tud2\n");
    } else if q.op == IR_CALL || q.op == IR_CALLM {
      let mut sw = slotw;
      if q.op == IR_CALLM {
        sw = wrap_add(base, wrap_add(u_at(moff, i), q.ty));
      }
      ix_call(&mut out, f, al, &mut g, c, &mut m, p, q, sw, sw == words);
    } else if q.op == IR_PCALL && q.c == 13 {
      ix_smp(&mut out, &mut g, c, &mut m, p, al, q);
    } else {
      let mut sw = slotw;
      if q.op == IR_SLOT {
        sw = wrap_add(base, wrap_add(q.a, q.c));
      }
      ix_ins(&mut out, f, al, &mut g, m, p, q, sw, live);
      ctx = ix_sets_ctx(al, q) || (live && ix_keeps_rax(al, m, q));
    }
    i = wrap_add(i, 1);
  }
  vec_free(lpos);
  vec_free(heads);
}

fn ix_cmp_zero(out: &mut Vec[u64], al: &IrAlloc, r: u64) {
  let mut l = ix_loc(al, r);
  if l.k == IXK_IMM {
    ix_mov(&mut out, l, ix_rl(XR_RAX));
    l = ix_rl(XR_RAX);
  }
  if l.k == IXK_REG && (ix_last_line(out, "\tand ", x86_rname(l.reg)) || ix_last_line(out, "\tor ", x86_rname(l.reg))) {
    return;                          // `and` and `or` set the flags as a comparison with zero does
  }
  w_s(&mut out, "\tcmpq $0, ");
  ix_op(&mut out, l);
  w_s(&mut out, "\n");
}

/// How many instructions read each register.
/// A value the allocator left in the frame that appears in the results of
/// more than two words only as one and the same word of them is kept in that
/// word of the result area (above the saved frame pointer) instead: its store
/// at the return is then already done. One value per result word; nothing
/// else lives in the result area, and a value read at no other word is not
/// overwritten by the stores of another return before its own is skipped.
/// `rw` is the first result word's distance above %rbp, in words.
fn ix_result_homes(f: &IrFn, al: &mut IrAlloc, rw: u64) {
  // For each register: the word it is returned in, plus one (0: none yet),
  // or a large number when it is returned in two different words.
  let mut at = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut at, 0);
    r = r + 1;
  }
  let mut pk = 0;
  while pk < vec_len(f.params) {
    ra_set(&mut at, vec_get(f.params, pk), 1000000);
    pk = pk + 1;
  }
  let mut i = 0;
  while i < vec_len(f.ins) {
    let q = vec_get(f.ins, i);
    if q.op == IR_RET && q.c > 2 && q.a == IR_NONE {
      let mut j = 0;
      while j < q.c && j < 4096 {
        let x = u_at(f.args, wrap_add(q.b, j));
        let cur = u_at(at, x);
        if x < f.nreg && cur != 0 && cur != wrap_add(j, 1) {
          ra_set(&mut at, x, 1000000);
        } else if x < f.nreg && cur == 0 {
          ra_set(&mut at, x, wrap_add(j, 1));
        }
        j = j + 1;
      }
    }
    i = i + 1;
  }
  let mut taken = vec_new[u64]();
  r = 0;
  while r < f.nreg && r < 1000000000 {
    let w = u_at(at, r);
    if w != 0 && w <= 4096 && u_at(al.cls, r) == RA_SPILL && u_at(al.cst, r) == 0 {
      while vec_len(taken) <= w {
        vec_push(&mut taken, 0);
      }
      if u_at(taken, w) == 0 {
        ra_set(&mut taken, w, 1);
        ra_set(&mut al.idx, r, wrap_sub(0, wrap_add(wrap_add(al.ncallee_used, 1), wrap_add(rw, wrap_sub(w, 1)))));
      }
    }
    r = r + 1;
  }
  vec_free(taken);
  vec_free(at);
}

/// Is `r` in the frame word `home` words above %rbp?
fn ix_in_result(al: &IrAlloc, r: u64, home: u64) -> bool {
  let l = ix_loc(al, r);
  return l.k == IXK_MEM && l.off == wrap_sub(0, home);
}

fn ix_uses(f: &IrFn) -> Vec[u64] {
  let mut nuse = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut nuse, 0);
    r = r + 1;
  }
  let mut i = 0;
  while i < vec_len(f.ins) {
    let mut rs = vec_new[u64]();
    ra_reads(f, vec_get(f.ins, i), &mut rs);
    let mut j = 0;
    while j < vec_len(rs) {
      let x = vec_get(rs, j);
      ra_set(&mut nuse, x, wrap_add(u_at(nuse, x), 1));
      j = j + 1;
    }
    vec_free(rs);
    i = i + 1;
  }
  return nuse;
}

/// Does instruction `q` write its register `d` only after it has read all
/// its operands, and is `d` its only result?
fn ix_defines(q: IrIns) -> bool {
  let op = q.op;
  return ra_is_binary(op) || op == IR_CONST || op == IR_MOV || op == IR_NOT || op == IR_NEG || op == IR_WRAP
    || op == IR_LOAD || op == IR_ALLOC || op == IR_CALL || op == IR_RT || op == IR_GLOBAL;
}

/// A load or store whose index is `x + K` (K a constant, the sum used by
/// nothing else) reads `x` and carries K in its `ty` field, which the
/// backend writes as a displacement: `mov 8(%rax,%rcx,8)` for the element
/// after `x`. The add is then dead. Only within a few instructions of the
/// add and with no write to `x` in between, so `x` still holds the value.
fn ix_addr_fold(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let ndef = iropt_ndef(f);
  let nuse = iropt_nuse(f);
  let cv = iropt_consts(f, ndef);
  let mut found = 0;
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_ADD && q.c != 1 && q.ty == 0 && q.d != IR_NONE && q.d < f.nreg && u_at(ndef, q.d) == 1 && u_at(nuse, q.d) == 1 {
      let ka = u_at(cv, q.a);
      let kb = u_at(cv, q.b);
      let mut x = IR_NONE;
      let mut k = IR_NONE;
      if ka == IR_NONE && kb != IR_NONE {
        x = q.a;
        k = kb;
      } else if ka != IR_NONE && kb == IR_NONE {
        x = q.b;
        k = ka;
      }
      if x != IR_NONE && x != q.d && k != 0 && k < 134217728 {
        let mut j = wrap_add(i, 1);
        let mut going = true;
        while going && j < n && j < wrap_add(i, 8) {
          let r = vec_get(f.ins, j);
          let mut reads = vec_new[u64]();
          ra_reads(f, r, &mut reads);
          let mut uses = false;
          let mut w = 0;
          while w < vec_len(reads) {
            if vec_get(reads, w) == q.d {
              uses = true;
            }
            w = w + 1;
          }
          vec_free(reads);
          if uses {
            if (r.op == IR_LOAD || r.op == IR_STORE) && r.b == q.d && r.a != q.d && r.d != q.d && r.ty == 0 {
              let mut r2 = r;
              r2.b = x;
              r2.ty = k;
              vec_set(&mut f.ins, j, r2);
              found = wrap_add(found, 1);
            }
            going = false;
          } else if r.op == IR_LABEL || r.op == IR_JMP || r.op == IR_BR || r.op == IR_RET {
            going = false;
          } else {
            let mut ws = vec_new[u64]();
            ra_writes(r, &mut ws);
            w = 0;
            while w < vec_len(ws) {
              if vec_get(ws, w) == x {
                going = false;
              }
              w = w + 1;
            }
            vec_free(ws);
            j = wrap_add(j, 1);
          }
        }
      }
    }
    i = i + 1;
  }
  vec_free(ndef);
  vec_free(nuse);
  vec_free(cv);
  return found;
}

/// `ix_addr_fold` for a sum with several users: the loads and stores among
/// them that take it as the index (a cell read at `j + 1` and written at
/// `j + 1`), at most 32 instructions after the add and perhaps on either side
/// of a branch, address off `x` with the displacement. Nothing writes `x` up
/// to the last of them, and every label in that stretch is reached only from
/// inside it, so a path to such a user always runs through the add and `x` is
/// what it was there. The add stays for the users that remain; when there are
/// none it is dead.
fn ix_addr_fold2(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  if n > 4000000 || f.nreg > 100000000 {
    return 0;
  }
  let ndef = iropt_ndef(f);
  let nuse = iropt_nuse(f);
  let cv = iropt_consts(f, ndef);
  // The first and the last position that jumps to each label.
  let mut lmin = vec_new[u64]();
  let mut lmax = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut lmin, IR_NONE);
    vec_push(&mut lmax, 0);
    l = wrap_add(l, 1);
  }
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    let mut t1 = IR_NONE;
    let mut t2 = IR_NONE;
    if q.op == IR_JMP {
      t1 = q.a;
    } else if q.op == IR_BR {
      t1 = q.b;
      t2 = q.c;
    }
    if t1 < f.nlabel {
      if i < u_at(lmin, t1) {
        ra_set(&mut lmin, t1, i);
      }
      if i > u_at(lmax, t1) {
        ra_set(&mut lmax, t1, i);
      }
    }
    if t2 < f.nlabel {
      if i < u_at(lmin, t2) {
        ra_set(&mut lmin, t2, i);
      }
      if i > u_at(lmax, t2) {
        ra_set(&mut lmax, t2, i);
      }
    }
    i = i + 1;
  }
  let mut found = 0;
  i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_ADD && q.c != 1 && q.ty == 0 && q.d != IR_NONE && q.d < f.nreg && u_at(ndef, q.d) == 1 && u_at(nuse, q.d) >= 2 {
      let ka = u_at(cv, q.a);
      let kb = u_at(cv, q.b);
      let mut x = IR_NONE;
      let mut k = IR_NONE;
      if ka == IR_NONE && kb != IR_NONE {
        x = q.a;
        k = kb;
      } else if ka != IR_NONE && kb == IR_NONE {
        x = q.b;
        k = ka;
      }
      if x != IR_NONE && x != q.d && k != 0 && k < 134217728 {
        let mut users = vec_new[u64]();
        let mut going = true;
        let mut j = wrap_add(i, 1);
        while going && j < n && j < wrap_add(i, 33) {
          let r = vec_get(f.ins, j);
          let mut reads = vec_new[u64]();
          ra_reads(f, r, &mut reads);
          let mut uses = false;
          let mut w = 0;
          while w < vec_len(reads) {
            if vec_get(reads, w) == q.d {
              uses = true;
            }
            w = w + 1;
          }
          vec_free(reads);
          if uses && (r.op == IR_LOAD || r.op == IR_STORE) && r.b == q.d && r.a != q.d && r.d != q.d && r.ty == 0 {
            vec_push(&mut users, j);
          }
          let mut ws = vec_new[u64]();
          ra_writes(r, &mut ws);
          w = 0;
          while w < vec_len(ws) {
            if vec_get(ws, w) == x || vec_get(ws, w) == q.d {
              going = false;
            }
            w = w + 1;
          }
          vec_free(ws);
          j = wrap_add(j, 1);
        }
        // Every label up to the last user is jumped to only from inside.
        let mut last = i;
        if vec_len(users) > 0 {
          last = vec_get(users, wrap_sub(vec_len(users), 1));
        }
        let mut ok = vec_len(users) > 0;
        let mut p = i;
        while ok && p <= last && p < n {
          let r = ix_at(f, p);
          if r.op == IR_LABEL && r.a < f.nlabel && u_at(lmin, r.a) != IR_NONE && (u_at(lmin, r.a) < i || u_at(lmax, r.a) > last) {
            ok = false;
          }
          p = wrap_add(p, 1);
        }
        if ok {
          let mut m = 0;
          while m < vec_len(users) {
            let pos = vec_get(users, m);
            if pos < vec_len(f.ins) {
              let mut r2 = vec_get(f.ins, pos);
              r2.b = x;
              r2.ty = k;
              vec_set(&mut f.ins, pos, r2);
              found = wrap_add(found, 1);
            }
            m = m + 1;
          }
        }
        vec_free(users);
      }
    }
    i = i + 1;
  }
  vec_free(lmin);
  vec_free(lmax);
  vec_free(ndef);
  vec_free(nuse);
  vec_free(cv);
  return found;
}

/// Where an if/else has a straight run of instructions with a load for its
/// then-arm and a few instructions for its else-arm, as the bounds test of a
/// vector read inlined from `get`, the then-arm goes last and falls into the
/// join: the common path then runs no `jmp` over the else-arm.
fn ix_arms(f: &mut IrFn) {
  let n = vec_len(f.ins);
  let mut refs = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut refs, 0);
    l = l + 1;
  }
  let mut i = 0;
  while i < n {
    let q = ix_at(f, i);
    if q.op == IR_JMP && q.a < f.nlabel {
      ra_set(&mut refs, q.a, wrap_add(u_at(refs, q.a), 1));
    }
    if q.op == IR_BR {
      if q.b < f.nlabel {
        ra_set(&mut refs, q.b, wrap_add(u_at(refs, q.b), 1));
      }
      if q.c < f.nlabel {
        ra_set(&mut refs, q.c, wrap_add(u_at(refs, q.c), 1));
      }
    }
    i = i + 1;
  }
  let mut out = vec_new[IrIns]();
  i = 0;
  while i < n {
    let q = ix_at(f, i);
    let mut next = wrap_add(i, 1);
    let mut swapped = false;
    if q.op == IR_BR && q.b != q.c && q.b < f.nlabel && q.c < f.nlabel && u_at(refs, q.b) == 1 && u_at(refs, q.c) == 1 {
      let t0 = ix_at(f, wrap_add(i, 1));
      if t0.op == IR_LABEL && t0.a == q.b {
        // The then-arm: a straight run to a jump.
        let mut k = wrap_add(i, 2);
        let mut going = true;
        let mut ok = true;
        let mut load = false;
        while going && k < n && k < wrap_add(i, 16) {
          let r = ix_at(f, k);
          if r.op == IR_JMP {
            going = false;
          } else {
            if r.op == IR_LABEL || r.op == IR_BR || r.op == IR_RET || r.op == IR_UNREACH {
              ok = false;
              going = false;
            }
            if r.op == IR_LOAD {
              load = true;
            }
            k = wrap_add(k, 1);
          }
        }
        let jm = ix_at(f, k);
        let e0 = ix_at(f, wrap_add(k, 1));
        if ok && load && !going && k < n && jm.op == IR_JMP && e0.op == IR_LABEL && e0.a == q.c {
          // The else-arm: a few instructions that run into the join.
          let mut m = wrap_add(k, 2);
          let mut g2 = true;
          let mut ok2 = true;
          while g2 && m < n && m < wrap_add(k, 7) {
            let r = ix_at(f, m);
            if r.op == IR_LABEL {
              if r.a != jm.a {
                ok2 = false;
              }
              g2 = false;
            } else {
              if r.op == IR_JMP || r.op == IR_BR || r.op == IR_RET || r.op == IR_UNREACH || r.op == IR_LOAD || r.op == IR_CALL || r.op == IR_CALLM {
                ok2 = false;
                g2 = false;
              }
              m = wrap_add(m, 1);
            }
          }
          if ok2 && !g2 && m < n {
            // Branch, then the else-arm with its jump, then the then-arm.
            vec_push(&mut out, q);
            let mut e = wrap_add(k, 1);
            while e < m {
              vec_push(&mut out, ix_at(f, e));
              e = wrap_add(e, 1);
            }
            vec_push(&mut out, jm);
            let mut t = wrap_add(i, 1);
            while t < k {
              vec_push(&mut out, ix_at(f, t));
              t = wrap_add(t, 1);
            }
            next = m;
            swapped = true;
          }
        }
      }
    }
    if !swapped {
      vec_push(&mut out, q);
    }
    i = next;
  }
  vec_free(f.ins);
  f.ins = out;
  vec_free(refs);
}

/// The register a chain of single-definition copies of `r` ends at (`r`
/// itself when it is not written once by a `mov`), and in `first` the position
/// of the earliest copy of the chain.
fn ix_mov_root(f: &IrFn, ndef: &Vec[u64], r: u64, first: &mut u64) -> u64 {
  let mut cur = r;
  let mut hops = 0;
  while hops < 4 && cur < vec_len(ndef) && u_at(ndef, cur) == 1 {
    let mut next = cur;
    let mut x = 0;
    while x < vec_len(f.ins) {
      let m = vec_get(f.ins, x);
      if m.op == IR_MOV && m.d == cur {
        next = m.a;
        if x < first {
          first = x;
        }
      }
      x = wrap_add(x, 1);
    }
    if next == cur {
      return cur;
    }
    cur = next;
    hops = wrap_add(hops, 1);
  }
  return cur;
}

/// Two counters that start equal and step together: `a = ...; b = mov a`
/// (or both `mov` of one register) in one straight run, and the same
/// `a = a + K` and `b = b + K` side by side. `b` is then `a`, and goes: the
/// address `y * 256 + x` of a load and of a store, each with an induction
/// variable of its own, take one register. Only counters whose every other
/// read can be rewritten, and that are not parameters.
fn ix_ivmerge(f: &mut IrFn) -> u64 {
  let ndef = iropt_ndef(f);
  let nuse = iropt_nuse(f);
  let cv = iropt_consts(f, ndef);
  let n = vec_len(f.ins);
  let mut done = 0;
  let mut drop = vec_new[u64]();
  let mut k = 0;
  while k < n {
    vec_push(&mut drop, 0);
    k = wrap_add(k, 1);
  }
  let mut ren = vec_new[IrIns]();
  let mut i = 0;
  while i < n {
    let qa = ix_at(f, i);
    if qa.op == IR_ADD && qa.d == qa.a && qa.d < f.nreg && qa.b < vec_len(cv) && u_at(cv, qa.b) != IR_NONE && u_at(ndef, qa.d) == 2 && u_at(drop, i) == 0 {
      // The step of the other counter follows, with constants between.
      let mut j = wrap_add(i, 1);
      let mut qb = ix_at(f, j);
      while qb.op == IR_CONST {
        j = wrap_add(j, 1);
        qb = ix_at(f, j);
      }
      if j < n && qb.op == IR_ADD && qb.d == qb.a && qb.d != qa.d && qb.d < f.nreg && qb.b < vec_len(cv) && u_at(cv, qb.b) == u_at(cv, qa.b) && u_at(ndef, qb.d) == 2 && !ra_is_param(f, qb.d) && qa.c == qb.c && qa.ty == qb.ty {
        // Where each starts.
        let mut pa = IR_NONE;
        let mut pb = IR_NONE;
        let mut p = 0;
        while p < n {
          let m = vec_get(f.ins, p);
          if p != i && ra_writes_has(m, qa.d) {
            pa = p;
          }
          if p != j && ra_writes_has(m, qb.d) {
            pb = p;
          }
          p = wrap_add(p, 1);
        }
        if pa != IR_NONE && pb != IR_NONE && pa < i && pb < i {
          let ia = vec_get(f.ins, pa);
          let ib = vec_get(f.ins, pb);
          let mut same = false;
          if ib.op == IR_MOV && ib.a == qa.d && pb > pa {
            same = true;
          } else if ia.op == IR_MOV && ib.op == IR_MOV && ia.a == ib.a && u_at(ndef, ia.a) <= 1 {
            same = true;
          }
          // Or copies of one register through copies written once, with
          // no write of that register from the first copy to the later start.
          let mut fa = pa;
          let mut root = IR_NONE;
          if !same && ia.op == IR_MOV && ib.op == IR_MOV {
            let mut fb = pb;
            let ra = ix_mov_root(f, ndef, ia.a, &mut fa);
            let rb = ix_mov_root(f, ndef, ib.a, &mut fb);
            if fb < fa {
              fa = fb;
            }
            if ra == rb {
              same = true;
              root = ra;
            }
          }
          // One straight run between the two starts, so they always happen
          // together; the steps are side by side.
          let first = pa;
          let mut lo = first;
          if fa < lo {
            lo = fa;
          }
          if pb < lo {
            lo = pb;
          }
          let mut hi = pa;
          if pb > hi {
            hi = pb;
          }
          let mut ok = same;
          let mut x = wrap_add(lo, 1);
          while ok && x < hi {
            let m = vec_get(f.ins, x);
            if m.op == IR_LABEL || ra_is_end(m.op) || m.op == IR_CALL || m.op == IR_CALLM {
              ok = false;
            }
            if x != pa && x != pb && (ra_writes_has(m, qa.d) || ra_writes_has(m, qb.d)) {
              ok = false;
            }
            if root != IR_NONE && ra_writes_has(m, root) {
              ok = false;
            }
            x = wrap_add(x, 1);
          }
          // Every read of b can be rewritten.
          x = 0;
          while ok && x < n {
            let m = vec_get(f.ins, x);
            if x != j && ra_reads_has(f, m, qb.d) && !ra_substable(m.op) {
              ok = false;
            }
            x = wrap_add(x, 1);
          }
          if ok {
            ra_set(&mut drop, pb, 1);
            ra_set(&mut drop, j, 1);
            vec_push(&mut ren, IrIns { op: 0, d: qb.d, a: qa.d, b: 0, c: 0, ty: 0 });
            done = wrap_add(done, 1);
          }
        }
      }
    }
    i = wrap_add(i, 1);
  }
  vec_free(ndef);
  vec_free(nuse);
  vec_free(cv);
  if done == 0 {
    vec_free(drop);
    vec_free(ren);
    return 0;
  }
  let mut out = vec_new[IrIns]();
  k = 0;
  while k < n {
    if u_at(drop, k) == 0 {
      let mut q = vec_get(f.ins, k);
      let mut r = 0;
      while r < vec_len(ren) {
        let e = vec_get(ren, r);
        q = ra_subst(q, e.d, e.a);
        r = wrap_add(r, 1);
      }
      vec_push(&mut out, q);
    }
    k = wrap_add(k, 1);
  }
  vec_free(drop);
  vec_free(ren);
  vec_free(f.ins);
  f.ins = out;
  return done;
}

/// Counting down: a loop `i = const c0; H: ...; i = add i, 1; t = lt i, K;
/// br t, H, E` whose counter `i` nothing else reads (no index, no guard)
/// and whose bound `K` is a constant above `c0`, counts `K - c0` down to
/// zero instead: `i = const (K - c0); ...; i = sub i, 1; t = gt i, 0`. The
/// subtraction leaves the flags the branch wants, so no compare is needed.
/// `H` is reached only by the back edge and the straight line from the
/// `const`, and the constant `K` is read by the compare alone. Returns how
/// many loops it changed.
fn ix_countdown(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let nuse = iropt_nuse(f);
  let ndef = iropt_ndef(f);
  let cv = iropt_consts(f, ndef);
  let lp = ra_lpos(f);
  let mut done = 0;
  let mut b = 3;
  while b < n {
    let q = vec_get(f.ins, b);
    if q.op == IR_BR && q.b < vec_len(lp) {
      let h = u_at(lp, q.b);
      let cmp = ix_at(f, wrap_sub(b, 1));
      // The step is behind the constants the compare and the step read.
      let mut pa = wrap_sub(b, 2);
      let mut pq = ix_at(f, pa);
      while pa > 0 && pa < n && pq.op == IR_CONST {
        pa = wrap_sub(pa, 1);
        pq = ix_at(f, pa);
      }
      let add = ix_at(f, pa);
      if h != IR_NONE && h < b && cmp.op == IR_LT && cmp.d == q.a && cmp.ty == 0 && cmp.d < vec_len(nuse) && u_at(nuse, cmp.d) == 1 && add.op == IR_ADD && add.d == cmp.a && add.a == cmp.a && add.c == 0 && add.ty == 0 && cmp.b < vec_len(cv) && add.b < vec_len(cv) && cmp.a < vec_len(ndef) && cmp.b < vec_len(nuse) {
        let i = cmp.a;
        let k = u_at(cv, cmp.b);
        if u_at(cv, add.b) == 1 && k != IR_NONE && u_at(ndef, i) == 2 && u_at(nuse, i) == 2 && u_at(nuse, cmp.b) == 1 {
          // The other write of `i` is a `const` before the loop with no
          // label or jump between it and `H`, and `H` has no other way in.
          let mut d0 = IR_NONE;
          let mut kd = IR_NONE;
          let mut j = 0;
          while j < b {
            let t = vec_get(f.ins, j);
            if t.op == IR_CONST && t.d == i && j < h {
              d0 = j;
            }
            if t.op == IR_CONST && t.d == cmp.b {
              kd = j;
            }
            j = wrap_add(j, 1);
          }
          let mut ok = d0 != IR_NONE && kd != IR_NONE;
          if ok {
            j = wrap_add(d0, 1);
            while j < h {
              let t = vec_get(f.ins, j);
              if t.op == IR_LABEL || t.op == IR_JMP || t.op == IR_BR || t.op == IR_RET {
                ok = false;
              }
              j = wrap_add(j, 1);
            }
          }
          j = 0;
          while ok && j < n {
            let t = vec_get(f.ins, j);
            if j != b && ((t.op == IR_JMP && t.a == q.b) || (t.op == IR_BR && (t.b == q.b || t.c == q.b))) {
              ok = false;
            }
            j = wrap_add(j, 1);
          }
          if ok {
            let cq = ix_at(f, d0);
            let c0 = cq.a;
            if c0 < k && d0 < vec_len(f.ins) && kd < vec_len(f.ins) && b < vec_len(f.ins) && pa < vec_len(f.ins) {
              let mut t0 = cq;
              t0.a = wrap_sub(k, c0);
              vec_set(&mut f.ins, d0, t0);
              let mut tk = ix_at(f, kd);
              tk.a = 0;
              vec_set(&mut f.ins, kd, tk);
              let mut a2 = add;
              a2.op = IR_SUB;
              vec_set(&mut f.ins, pa, a2);
              let mut c2 = cmp;
              c2.op = IR_GT;
              vec_set(&mut f.ins, wrap_sub(b, 1), c2);
              done = wrap_add(done, 1);
            }
          }
        }
      }
    }
    b = wrap_add(b, 1);
  }
  vec_free(lp);
  vec_free(cv);
  vec_free(ndef);
  vec_free(nuse);
  return done;
}

/// `t = add x, K; ...; x = mov t`, where `t` is written once, read only
/// between the two (the `x + 1` an address wanted, say), `K` is a constant and
/// `x` is not written in between, becomes `x = add x, K` at the `mov` (when
/// nothing else reads the sum, the first `add` is dead then). A
/// common-subexpression pass merges `x + 1` of the loop body with the step of
/// the counter, and the sum would then stay in a register (or the frame) from
/// its first use to the end of the loop; added again, it takes one `add`
/// instead, in place.
fn ix_incr(f: &mut IrFn) -> u64 {
  let nuse = iropt_nuse(f);
  let ndef = iropt_ndef(f);
  let cv = iropt_consts(f, ndef);
  let n = vec_len(f.ins);
  let mut dp = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut dp, IR_NONE);
    r = wrap_add(r, 1);
  }
  let mut out = vec_new[IrIns]();
  let mut done = 0;
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    let mut hit = false;
    if q.op == IR_MOV && q.a < vec_len(dp) && q.d != q.a && u_at(ndef, q.a) == 1 && u_at(dp, q.a) != IR_NONE {
      let s = u_at(dp, q.a);
      let a = ix_at(f, s);
      if a.op == IR_ADD && a.a == q.d && a.b < vec_len(cv) && u_at(cv, a.b) != IR_NONE && a.d == q.a {
        // Straight-line from the sum to the copy, no write of x, and every
        // read of the sum is in between.
        let mut ok = true;
        let mut reads = 0;
        let mut j = wrap_add(s, 1);
        while ok && j < i {
          let m = ix_at(f, j);
          if m.op == IR_LABEL || ra_is_end(m.op) || m.op == IR_CALL || m.op == IR_CALLM {
            ok = false;
          }
          if ra_writes_has(m, q.d) || ra_writes_has(m, q.a) {
            ok = false;
          }
          if ra_reads_has(f, m, q.a) {
            reads = wrap_add(reads, 1);
          }
          j = wrap_add(j, 1);
        }
        if ok && reads == wrap_sub(u_at(nuse, q.a), 1) {
          let kr = ir_reg(&mut f);
          vec_push(&mut out, IrIns { op: IR_CONST, d: kr, a: u_at(cv, a.b), b: 0, c: 0, ty: 0 });
          vec_push(&mut out, IrIns { op: IR_ADD, d: q.d, a: q.d, b: kr, c: a.c, ty: a.ty });
          hit = true;
        }
      }
    }
    if hit {
      done = wrap_add(done, 1);
    } else {
      vec_push(&mut out, q);
    }
    let mut ws = vec_new[u64]();
    ra_writes(q, &mut ws);
    let mut w = 0;
    while w < vec_len(ws) {
      let x = vec_get(ws, w);
      if x < vec_len(dp) && u_at(dp, x) == IR_NONE {
        ra_set(&mut dp, x, i);
      }
      w = wrap_add(w, 1);
    }
    vec_free(ws);
    i = wrap_add(i, 1);
  }
  vec_free(nuse);
  vec_free(ndef);
  vec_free(cv);
  vec_free(dp);
  if done == 0 {
    vec_free(out);
    return 0;
  }
  vec_free(f.ins);
  f.ins = out;
  return done;
}

/// `t = op ...; s = mov t`, where `t` is written and read only there,
/// becomes `s = op ...`: the copies the lowering makes for `s = s + 1` and
/// `let s = 0`.
fn ix_coalesce(f: &mut IrFn) {
  let nuse = ix_uses(f);
  let mut ndef = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut ndef, 0);
    r = r + 1;
  }
  let mut j = 0;
  while j < vec_len(f.params) {
    let pr = vec_get(f.params, j);
    ra_set(&mut ndef, pr, wrap_add(u_at(ndef, pr), 1));
    j = j + 1;
  }
  let mut i = 0;
  while i < vec_len(f.ins) {
    let mut ws = vec_new[u64]();
    ra_writes(vec_get(f.ins, i), &mut ws);
    j = 0;
    while j < vec_len(ws) {
      let wr = vec_get(ws, j);
      ra_set(&mut ndef, wr, wrap_add(u_at(ndef, wr), 1));
      j = j + 1;
    }
    vec_free(ws);
    i = i + 1;
  }
  // moved[i] = j + 1: the definition at i, whose only use is the copy
  // `s = mov t` at j in the same straight run, with no read or write of s
  // between them, may write s directly; gone[j]: that copy.
  let mut moved = vec_new[u64]();
  let mut gone = vec_new[u64]();
  i = 0;
  while i < vec_len(f.ins) {
    vec_push(&mut moved, 0);
    vec_push(&mut gone, 0);
    i = i + 1;
  }
  i = 0;
  while i < vec_len(f.ins) {
    let q = vec_get(f.ins, i);
    let mut cand = u_at(gone, i) == 0 && ix_defines(q) && q.d != IR_NONE && q.d < vec_len(ndef) && u_at(ndef, q.d) == 1 && u_at(nuse, q.d) == 1 && q.op != IR_CALL && q.op != IR_CALLM && q.op != IR_CONST;
    let adj = ix_at(f, i + 1);
    if cand && adj.op == IR_MOV && adj.a == q.d {
      cand = false;
    }
    j = wrap_add(i, 1);
    let mut s = IR_NONE;
    let mut scanning = cand;
    while scanning && j < vec_len(f.ins) && j < wrap_add(i, 40) {
      let m = vec_get(f.ins, j);
      if m.op == IR_LABEL || ra_is_end(m.op) {
        scanning = false;
      } else if m.op == IR_MOV && m.a == q.d && m.d != q.d && m.d < vec_len(ndef) {
        s = m.d;
        scanning = false;
      } else if ra_writes_has(m, q.d) || ra_reads_has(f, m, q.d) {
        scanning = false;
      } else {
        j = wrap_add(j, 1);
      }
    }
    if s != IR_NONE {
      // Between the definition and the copy, nothing touches s.
      let mut ok = true;
      let mut x = wrap_add(i, 1);
      while ok && x < j {
        let m = ix_at(f, x);
        if ra_writes_has(m, s) || ra_reads_has(f, m, s) || m.op == IR_CALL || m.op == IR_CALLM {
          ok = false;
        }
        x = wrap_add(x, 1);
      }
      if ok && u_at(gone, j) == 0 && u_at(moved, i) == 0 {
        ra_set(&mut moved, i, wrap_add(j, 1));
        ra_set(&mut gone, j, 1);
      }
    }
    i = wrap_add(i, 1);
  }
  let mut out = vec_new[IrIns]();
  i = 0;
  while i < vec_len(f.ins) {
    let q = vec_get(f.ins, i);
    let nq = ix_at(f, i + 1);
    // A call with two results writes a second register that may be dead
    // (`v1, v2 = call f; s = mov v1`): the allocator can give that dead
    // result the register `s` would now share, and its move (written after
    // the first) would overwrite the first result.
    let mut other = false;
    if q.op == IR_CALL && q.ty != IR_NONE && q.ty != 0 {
      other = true;
    }
    if u_at(gone, i) != 0 {
      i = i + 1;
    } else if !other && ix_defines(q) && q.d != IR_NONE && nq.op == IR_MOV && nq.a == q.d && nq.d != q.d
      && u_at(ndef, q.d) == 1 && u_at(nuse, q.d) == 1 {
      // (The copy may itself be one that writes a later copy's target.)
      let mut dst = nq.d;
      if u_at(moved, i + 1) != 0 {
        let rq = ix_at(f, wrap_sub(u_at(moved, i + 1), 1));
        dst = rq.d;
      }
      vec_push(&mut out, IrIns { op: q.op, d: dst, a: q.a, b: q.b, c: q.c, ty: q.ty });
      i = i + 2;
    } else if !other && ix_defines(q) && q.d != IR_NONE && q.d < vec_len(ndef) && u_at(ndef, q.d) == 1 && u_at(nuse, q.d) == 1 && u_at(moved, i) != 0 {
      // The copy comes later in the same run (the words of a result loaded
      // together, then bound one by one): the definition writes its target.
      let tq = ix_at(f, wrap_sub(u_at(moved, i), 1));
      vec_push(&mut out, IrIns { op: q.op, d: tq.d, a: q.a, b: q.b, c: q.c, ty: q.ty });
      i = i + 1;
    } else {
      vec_push(&mut out, q);
      i = i + 1;
    }
  }
  vec_free(nuse);
  vec_free(ndef);
  vec_free(moved);
  vec_free(gone);
  vec_free(f.ins);
  f.ins = out;
}

/// `t = op a, b; a = op2 t, c` (or `op2 c, t`), where `t` is written and
/// read only there, `c` is not `a`, and the two follow each other (but for
/// constants between), becomes
/// `a = op a, b; a = op2 a, c`: the temporary and a copy go, as for
/// `i = (i + 1) % n`, whose sum would otherwise take a register of its own
/// for the length of one instruction.
fn ix_inplace(f: &mut IrFn) -> u64 {
  let nuse = iropt_nuse(f);
  let ndef = iropt_ndef(f);
  let n = vec_len(f.ins);
  let mut out = vec_new[IrIns]();
  let mut done = 0;
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    // Constants may sit between the two (the lowering writes them where
    // they are used).
    let mut j = wrap_add(i, 1);
    let mut clean = true;
    let mut scanning = true;
    while scanning && j < n && j < wrap_add(i, 4) {
      let cq = ix_at(f, j);
      if cq.op == IR_CONST {
        if cq.d == q.a || cq.d == q.d {
          clean = false;
        }
        j = wrap_add(j, 1);
      } else {
        scanning = false;
      }
    }
    let nq = ix_at(f, j);
    let mut hit = false;
    if clean && ra_is_binary(q.op) && ra_is_binary(nq.op) && q.d < f.nreg && q.a < f.nreg && nq.d == q.a && q.d != q.a && u_at(ndef, q.d) == 1 && u_at(nuse, q.d) == 1 && j < n {
      let mut ok = false;
      let mut y = nq;
      if nq.a == q.d && nq.b != q.a && nq.b != q.d {
        ok = true;
        y.a = q.a;
      } else if nq.b == q.d && nq.a != q.a && nq.a != q.d {
        ok = true;
        y.b = q.a;
      }
      if ok {
        vec_push(&mut out, IrIns { op: q.op, d: q.a, a: q.a, b: q.b, c: q.c, ty: q.ty });
        let mut m = wrap_add(i, 1);
        while m < j {
          vec_push(&mut out, ix_at(f, m));
          m = wrap_add(m, 1);
        }
        vec_push(&mut out, y);
        hit = true;
      }
    }
    if hit {
      done = wrap_add(done, 1);
      i = wrap_add(j, 1);
    } else {
      vec_push(&mut out, q);
      i = wrap_add(i, 1);
    }
  }
  vec_free(nuse);
  vec_free(ndef);
  if done == 0 {
    vec_free(out);
    return 0;
  }
  vec_free(f.ins);
  f.ins = out;
  return done;
}

/// Whether `q` may move before a comparison and its mask: pure arithmetic
/// (no division, which traps) that reads neither of them.
fn ix_selprep_pure(q: IrIns) -> bool {
  if q.op == IR_CONST || q.op == IR_MOV || q.op == IR_NOT || q.op == IR_NEG || q.op == IR_WRAP {
    return true;
  }
  return ra_is_binary(q.op) && !ix_is_cmp(q.op) && q.op != IR_DIV && q.op != IR_SDIV && q.op != IR_REM && q.op != IR_SREM;
}

/// `c = a ? b; m = neg c; w...; sel` becomes `w...; c = a ? b; m = neg c;
/// sel`, where the `w` are pure arithmetic (the arms of the select that
/// `iropt_ifconv` hoisted, such as the `mid + 1` of a binary search) that
/// neither read the mask nor write what the comparison reads: the select
/// then follows its mask directly, and the comparison's flags reach the
/// conditional moves that make it.
fn ix_selprep(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let mut out = vec_new[IrIns]();
  let mut done = 0;
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    let nq = ix_at(f, i + 1);
    let mut moved = false;
    if ix_is_cmp(q.op) && nq.op == IR_NEG && nq.a == q.d && i + 1 < n {
      let mut j = wrap_add(i, 2);
      let mut scanning = true;
      while scanning && j < n && j < wrap_add(i, 10) {
        let w = ix_at(f, j);
        if ix_selprep_pure(w) && !ra_reads_has(f, w, q.d) && !ra_reads_has(f, w, nq.d) && !ra_writes_has(w, q.a) && !ra_writes_has(w, q.b) && !ra_writes_has(w, q.d) && !ra_writes_has(w, nq.d) {
          j = wrap_add(j, 1);
        } else {
          scanning = false;
        }
      }
      // The scan went through the select's first `xor` (it reads no mask);
      // the select starts there, and the run to move ends before it.
      let an = ix_at(f, j);
      let prev = ix_at(f, wrap_sub(j, 1));
      if j > wrap_add(i, 2) && an.op == IR_AND && (an.a == nq.d || an.b == nq.d) && prev.op == IR_XOR {
        j = wrap_sub(j, 1);
      }
      // The moved run is [i + 2, j); only worth it when a select follows.
      let x1 = ix_at(f, j);
      if j > wrap_add(i, 2) && x1.op == IR_XOR {
        let mut m = wrap_add(i, 2);
        while m < j {
          vec_push(&mut out, ix_at(f, m));
          m = wrap_add(m, 1);
        }
        vec_push(&mut out, q);
        vec_push(&mut out, nq);
        done = wrap_add(done, 1);
        moved = true;
        i = j;
      }
    }
    if !moved {
      vec_push(&mut out, q);
      i = wrap_add(i, 1);
    }
  }
  if done == 0 {
    vec_free(out);
    return 0;
  }
  vec_free(f.ins);
  f.ins = out;
  return done;
}

/// Moves a word load that only a comparison and its branch read down to just
/// before that comparison, over instructions that neither write memory nor
/// the load's address, so that the comparison can read the word from memory
/// (`cmpq mem, %reg`) and no register holds it. Returns how many moved.
fn ix_sinkld(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  if n > 4000000 {
    return 0;
  }
  let nuse = iropt_nuse(f);
  let ndef = iropt_ndef(f);
  let mut done = 0;
  let mut i = 0;
  while i < n {
    let q = iropt_at(f, i);
    if q.op == IR_LOAD && (q.c == 8 || q.c == 1) && q.d < f.nreg && u_at(nuse, q.d) == 1 && u_at(ndef, q.d) == 1 {
      let mut j = wrap_add(i, 1);
      let mut tgt = n;
      let mut scanning = true;
      while scanning && j < n && j < wrap_add(i, 12) {
        let m = iropt_at(f, j);
        if ra_reads_has(f, m, q.d) {
          scanning = false;
          let b = iropt_at(f, wrap_add(j, 1));
          if ix_is_cmp(m.op) && m.a != m.b && b.op == IR_BR && b.a == m.d && u_at(nuse, m.d) == 1 {
            tgt = j;
          }
        } else if !iropt_ebb_keeps_loads(m.op) || m.op == IR_LABEL || m.op == IR_BR || ra_writes_has(m, q.a) || ra_writes_has(m, q.b) {
          scanning = false;
        } else {
          j = wrap_add(j, 1);
        }
      }
      if tgt < n && tgt > wrap_add(i, 1) {
        let mut k = i;
        while wrap_add(k, 1) < tgt {
          iropt_put(&mut f, k, iropt_at(f, wrap_add(k, 1)));
          k = wrap_add(k, 1);
        }
        iropt_put(&mut f, wrap_sub(tgt, 1), q);
        done = wrap_add(done, 1);
      }
    }
    i = wrap_add(i, 1);
  }
  vec_free(nuse);
  vec_free(ndef);
  return done;
}

/// Two adjacent word loads from one base and the two stores of them to
/// adjacent words of another (the copy of a two-word struct, `v = a[i]` then
/// `b[j] = v`) become one 16-byte move, `IR_CP16`. The pair of stores must be
/// next to each other (only constants between), nothing between the loads and
/// the first store may write memory or the loads' registers, the second load
/// is read only by the second store, and the first load stays if anything
/// else reads it (a comparison of the key).
fn ix_copy16(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let nr = f.nreg;
  let ndef = iropt_ndef(f);
  let nuse = iropt_nuse(f);
  let mut kv = vec_new[u64]();
  let mut dpos = vec_new[u64]();
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut kv, IR_NONE);
    vec_push(&mut dpos, IR_NONE);
    r = wrap_add(r, 1);
  }
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_CONST && q.d < nr && u_at(ndef, q.d) == 1 {
      ra_set(&mut kv, q.d, q.a);
    }
    if (q.op == IR_LOAD || q.op == IR_CONST || ra_is_binary(q.op) || q.op == IR_MOV) && q.d < nr && u_at(ndef, q.d) == 1 {
      ra_set(&mut dpos, q.d, i);
    }
    i = wrap_add(i, 1);
  }
  // For each label: how many jumps and branches name it, and where the first is.
  let mut lcnt = vec_new[u64]();
  let mut lfst = vec_new[u64]();
  let mut lb = 0;
  while lb < f.nlabel && lb < 1000000000 {
    vec_push(&mut lcnt, 0);
    vec_push(&mut lfst, IR_NONE);
    lb = wrap_add(lb, 1);
  }
  i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_JMP && q.a < vec_len(lcnt) {
      ra_set(&mut lcnt, q.a, wrap_add(u_at(lcnt, q.a), 1));
      if u_at(lfst, q.a) == IR_NONE {
        ra_set(&mut lfst, q.a, i);
      }
    } else if q.op == IR_BR && q.b < vec_len(lcnt) && q.c < vec_len(lcnt) {
      ra_set(&mut lcnt, q.b, wrap_add(u_at(lcnt, q.b), 1));
      if u_at(lfst, q.b) == IR_NONE {
        ra_set(&mut lfst, q.b, i);
      }
      ra_set(&mut lcnt, q.c, wrap_add(u_at(lcnt, q.c), 1));
      if u_at(lfst, q.c) == IR_NONE {
        ra_set(&mut lfst, q.c, i);
      }
    }
    i = wrap_add(i, 1);
  }
  // kill[i] = 1: instruction i is dropped; 2: i is replaced.
  let mut kill = vec_new[u64]();
  let mut rep = vec_new[IrIns]();
  i = 0;
  while i < n {
    vec_push(&mut kill, 0);
    vec_push(&mut rep, vec_get(f.ins, i));
    i = wrap_add(i, 1);
  }
  let mut done = 0;
  i = 0;
  while i < n {
    let s1 = vec_get(f.ins, i);
    if s1.op == IR_STORE && s1.c == 8 && s1.ty == 0 && s1.b < nr && u_at(kv, s1.b) != IR_NONE && s1.d < nr && u_at(kv, s1.b) < 1000000 && u_at(kill, i) == 0 {
      // The second store: next store, only constants between.
      let mut j = wrap_add(i, 1);
      let mut going = true;
      while going && j < n && j < wrap_add(i, 6) {
        let t = vec_get(f.ins, j);
        if t.op == IR_CONST {
          j = wrap_add(j, 1);
        } else {
          going = false;
        }
      }
      if j < n {
        let s2 = vec_get(f.ins, j);
        if s2.op == IR_STORE && s2.c == 8 && s2.ty == 0 && s2.a == s1.a && s2.b < nr && u_at(kv, s2.b) == wrap_add(u_at(kv, s1.b), 1) && s2.d < nr && s2.d != s1.d && s2.a != s1.d && s2.a != s2.d {
          // x is the first word, through copies (a value that a comparison
          // also reads is often the result register of an inlined call).
          let mut x = s1.d;
          let y = s2.d;
          let mut hops = 0;
          let mut px = u_at(dpos, x);
          let mut xdirect = true;
          let mut chase = true;
          while chase && hops < 4 && px != IR_NONE && px < n {
            let mv = vec_get(f.ins, px);
            if mv.op != IR_MOV {
              chase = false;
            } else if mv.a < nr && u_at(ndef, mv.a) == 1 && u_at(dpos, mv.a) != IR_NONE {
              x = mv.a;
              px = u_at(dpos, x);
              xdirect = false;
            } else {
              px = IR_NONE;
              chase = false;
            }
            hops = wrap_add(hops, 1);
          }
          let py = u_at(dpos, y);
          if px != IR_NONE && py != IR_NONE && px < i && py < i && u_at(ndef, x) == 1 && u_at(ndef, y) == 1 && u_at(nuse, y) == 1 && x != y {
            let lx = vec_get(f.ins, px);
            let ly = vec_get(f.ins, py);
            if lx.op == IR_LOAD && ly.op == IR_LOAD && lx.c == 8 && ly.c == 8 && lx.ty == 0 && ly.ty == 0 && lx.a == ly.a && lx.b < nr && ly.b < nr && u_at(kv, lx.b) != IR_NONE && u_at(kv, ly.b) == wrap_add(u_at(kv, lx.b), 1) && lx.a != x && lx.a != y {
              // Nothing between the first load and the first store writes
              // memory or the source base.
              let lo = px;
              let mut ok = true;
              let mut m = lo;
              while m < i && ok {
                let t = vec_get(f.ins, m);
                if t.op == IR_BR {
                  // A branch is fine when each target is reached only from the
                  // branches in this stretch (checked at the label).
                } else if t.op == IR_LABEL {
                  // Entered only by one branch of this stretch.
                  if t.a >= vec_len(lcnt) || u_at(lcnt, t.a) != 1 || u_at(lfst, t.a) == IR_NONE || u_at(lfst, t.a) < lo || u_at(lfst, t.a) >= m {
                    ok = false;
                  }
                } else if !(t.op == IR_CONST || t.op == IR_MOV || t.op == IR_LOAD || t.op == IR_WRAP || t.op == IR_NOT || t.op == IR_NEG || ra_is_binary(t.op)) {
                  ok = false;
                }
                if m != px && m != py && ra_writes_has(t, lx.a) {
                  ok = false;
                }
                m = wrap_add(m, 1);
              }
              if ok && i < vec_len(rep) && j < vec_len(kill) && py < vec_len(kill) && px < vec_len(kill) {
                vec_set(&mut rep, i, IrIns { op: IR_CP16, d: lx.b, a: s1.a, b: s1.b, c: lx.a, ty: 0 });
                vec_set(&mut kill, j, 1);
                vec_set(&mut kill, py, 1);
                if xdirect && u_at(nuse, x) == 1 {
                  vec_set(&mut kill, px, 1);
                }
                done = wrap_add(done, 1);
              }
            }
          }
        }
      }
    }
    i = wrap_add(i, 1);
  }
  if done > 0 {
    let mut out = vec_new[IrIns]();
    i = 0;
    while i < n {
      if i < vec_len(rep) && u_at(kill, i) == 0 {
        vec_push(&mut out, vec_get(rep, i));
      }
      i = wrap_add(i, 1);
    }
    vec_free(f.ins);
    f.ins = out;
  }
  vec_free(ndef);
  vec_free(nuse);
  vec_free(kv);
  vec_free(dpos);
  vec_free(kill);
  vec_free(rep);
  vec_free(lcnt);
  vec_free(lfst);
  return done;
}

/// `x % K == 0` (or `!= 0`) for an odd constant K above 1 and a 64-bit x, the
/// remainder read only by that test: `x * inv(K)`, wrapping, is at most
/// floor((2^64 - 1) / K) exactly when K divides x (`inv` the inverse of K
/// modulo 2^64). One multiplication and one compare instead of the
/// remainder's multiply, shift and subtract chain. Returns how many it
/// rewrote.
fn ix_divisible(f: &mut IrFn, m: &Mono) -> u64 {
  let n = vec_len(f.ins);
  let ndef = iropt_ndef(f);
  let nuse = iropt_nuse(f);
  let cv = iropt_consts(f, ndef);
  let mut out = vec_new[IrIns]();
  let mut done = 0;
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    let mut hit = false;
    if q.op == IR_REM && q.d < f.nreg && u_at(ndef, q.d) == 1 && u_at(nuse, q.d) == 1 && q.b < vec_len(cv) && u_at(cv, q.b) != IR_NONE {
      let k = u_at(cv, q.b);
      if k >= 3 && k < 9223372036854775808 && (k & 1) == 1 && (q.ty == 0 || slen(x86_normalize(m, q.ty)) == 0) {
        // The test: next compare of the remainder against zero.
        let mut j = wrap_add(i, 1);
        let mut at = IR_NONE;
        while j < n && j < wrap_add(i, 6) && at == IR_NONE {
          let t = vec_get(f.ins, j);
          if (t.op == IR_EQ || t.op == IR_NE) && ((t.a == q.d && t.b < vec_len(cv) && u_at(cv, t.b) == 0) || (t.b == q.d && t.a < vec_len(cv) && u_at(cv, t.a) == 0)) {
            at = j;
          } else if ra_reads_has(f, t, q.d) || ra_writes_has(t, q.a) {
            j = n;
          }
          j = wrap_add(j, 1);
        }
        if at != IR_NONE && at < n {
          let mut inv = k;
          let mut r = 0;
          while r < 6 {
            inv = wrap_mul(inv, wrap_sub(2, wrap_mul(k, inv)));
            r = wrap_add(r, 1);
          }
          let ri = ir_reg(&mut f);
          let rt = ir_reg(&mut f);
          vec_push(&mut out, IrIns { op: IR_CONST, d: ri, a: inv, b: 0, c: 0, ty: 0 });
          vec_push(&mut out, IrIns { op: IR_CONST, d: rt, a: 18446744073709551615 / k, b: 0, c: 0, ty: 0 });
          vec_push(&mut out, IrIns { op: IR_MUL, d: q.d, a: q.a, b: ri, c: 1, ty: q.ty });
          // The compare, later: x * inv <= limit for `== 0`, above it for `!= 0`.
          let t = vec_get(f.ins, at);
          let mut cop = IR_LE;
          if t.op == IR_NE {
            cop = IR_GT;
          }
          let mut p = i;
          p = wrap_add(p, 1);
          while p < at {
            vec_push(&mut out, vec_get(f.ins, p));
            p = wrap_add(p, 1);
          }
          vec_push(&mut out, IrIns { op: cop, d: t.d, a: q.d, b: rt, c: 0, ty: t.ty });
          i = at;
          hit = true;
          done = wrap_add(done, 1);
        }
      }
    }
    if !hit {
      vec_push(&mut out, q);
    }
    i = wrap_add(i, 1);
  }
  vec_free(ndef);
  vec_free(nuse);
  vec_free(cv);
  if done > 0 {
    vec_free(f.ins);
    f.ins = out;
  } else {
    vec_free(out);
  }
  return done;
}

/// The multiplier that the division by the constant `k` loads into %rdx
/// (`movabs $M, %rdx; mul %rdx`), 0 if its code has no such pair.
fn ix_divm(g: &mut X86, k: u64, rem: bool) -> u64 {
  x86_clear(&mut g.body);
  x86_div_const(&mut g, k, rem);
  let mut m = 0;
  let mut found = 0;
  let mut i = 0;
  while i < vec_len(g.body) && i < 100000 {
    if ix_has_at(g.body, i, "\tmovabs $") {
      let mut e = wrap_add(i, 9);
      let mut x = 0;
      while e < vec_len(g.body) && e < wrap_add(i, 29) && vec_get(g.body, e) >= 48 && vec_get(g.body, e) <= 57 {
        x = wrap_add(wrap_mul(x, 10), wrap_sub(vec_get(g.body, e), 48));
        e = wrap_add(e, 1);
      }
      if e > wrap_add(i, 9) && ix_has_at(g.body, e, ", %rdx\n\tmul %rdx\n") {
        m = x;
        found = wrap_add(found, 1);
      }
    }
    i = wrap_add(i, 1);
  }
  x86_clear(&mut g.body);
  if found != 1 {
    return 0;
  }
  return m;
}

/// Is the instruction at `j`, after the loop spanning `lp` to `hi`, in a block
/// that begins at a label only branches from inside the loop name and that a
/// jump or a return ends just before (so nothing falls into it)?
fn ix_cold_of(f: &IrFn, lpos: &Vec[u64], lp: u64, hi: u64, j: u64) -> bool {
  let n = vec_len(f.ins);
  if j >= n {
    return false;
  }
  // The label that starts the block.
  let mut t = j;
  let mut found = false;
  while !found && t > hi && t < n {
    let tq = vec_get(f.ins, t);
    if tq.op == IR_LABEL {
      found = true;
    } else {
      t = wrap_sub(t, 1);
    }
  }
  if !found || t <= hi || t == 0 || t >= n {
    return false;
  }
  let pv = vec_get(f.ins, t - 1);
  if pv.op != IR_JMP && pv.op != IR_BR && pv.op != IR_RET && pv.op != IR_UNREACH {
    return false;
  }
  let lq = vec_get(f.ins, t);
  let mut ok = true;
  let mut k = 0;
  while k < n && ok {
    if k < lp || k > hi {
      let r = vec_get(f.ins, k);
      if (r.op == IR_JMP && r.a == lq.a) || (r.op == IR_BR && (r.b == lq.a || r.c == lq.a)) {
        // A jump to the block from outside the loop must come from the
        // block's own stretch (a loop inside it).
        if k < t || k > j {
          ok = false;
        }
      }
    }
    k = wrap_add(k, 1);
  }
  return ok;
}

/// Where to make a value that the loop spanning positions `lp` to `hi` (its
/// header label at `lp`, its last back edge at `hi`) reads: a position in
/// front of it that every path into the loop passes, or IR_NONE. Without a
/// jump from outside into the loop that is the header; with the entry test of
/// a rotated loop (a branch that lands on the header or inside the loop) it
/// is that branch, and the stretch from it to the header holds no label, so
/// nothing enters between them.
fn ix_hoist_at(f: &IrFn, lpos: &Vec[u64], lp: u64, hi: u64) -> u64 {
  let n = vec_len(f.ins);
  let mut e0 = IR_NONE;
  let mut ok = true;
  let mut j = 0;
  while j < n && ok {
    if j < lp || j > hi {
      let t = vec_get(f.ins, j);
      let mut x1 = IR_NONE;
      let mut x2 = IR_NONE;
      if t.op == IR_JMP {
        x1 = t.a;
      } else if t.op == IR_BR {
        x1 = t.b;
        x2 = t.c;
      }
      let mut into = false;
      if x1 < vec_len(lpos) && u_at(lpos, x1) != IR_NONE && u_at(lpos, x1) >= lp && u_at(lpos, x1) <= hi {
        into = true;
      }
      if x2 < vec_len(lpos) && u_at(lpos, x2) != IR_NONE && u_at(lpos, x2) >= lp && u_at(lpos, x2) <= hi {
        into = true;
      }
      if into {
        if j > hi {
          // Allowed from a block placed after the loop that only the loop
          // branches to and that nothing falls into (a rarely taken arm).
          if !ix_cold_of(f, lpos, lp, hi, j) {
            ok = false;
          }
        } else if e0 == IR_NONE {
          e0 = j;
        }
      }
    }
    j = wrap_add(j, 1);
  }
  if !ok {
    return IR_NONE;
  }
  if e0 == IR_NONE {
    return lp;
  }
  if e0 >= n {
    return IR_NONE;
  }
  let mut k = wrap_add(e0, 1);
  while k < lp && k < n {
    let tk = vec_get(f.ins, k);
    if tk.op == IR_LABEL {
      return IR_NONE;
    }
    k = wrap_add(k, 1);
  }
  // Keep the compare that the entry branch tests next to it.
  let eb = vec_get(f.ins, e0);
  if e0 > 0 && eb.op == IR_BR {
    let pv = vec_get(f.ins, e0 - 1);
    if iropt_is_cmp(pv.op) && pv.d == eb.a {
      return e0 - 1;
    }
  }
  return e0;
}

/// A division by a constant inside a loop loads its multiplier on every pass
/// (`movabs`); the multiplier is made once in front of the loop instead, a
/// register of its own that the loop reads, and the division records it in
/// its `c` (the register plus two). The loop is the innermost one around the
/// division whose header is reached only by falling in and by its back edges.
fn ix_divhoist(f: &mut IrFn, g: &mut X86) -> u64 {
  let n = vec_len(f.ins);
  let ndef = iropt_ndef(f);
  let mut kv = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut kv, IR_NONE);
    r = wrap_add(r, 1);
  }
  let mut lpos = vec_new[u64]();
  let mut fref = vec_new[u64]();
  let mut lref = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut lpos, IR_NONE);
    vec_push(&mut fref, IR_NONE);
    vec_push(&mut lref, 0);
    l = wrap_add(l, 1);
  }
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_CONST && q.d < vec_len(ndef) && u_at(ndef, q.d) == 1 {
      ra_set(&mut kv, q.d, q.a);
    } else if q.op == IR_LABEL && q.a < vec_len(lpos) {
      ra_set(&mut lpos, q.a, i);
    } else if q.op == IR_JMP && q.a < vec_len(lpos) {
      if u_at(fref, q.a) == IR_NONE {
        ra_set(&mut fref, q.a, i);
      }
      ra_set(&mut lref, q.a, i);
    } else if q.op == IR_BR && q.b < vec_len(lpos) && q.c < vec_len(lpos) {
      if u_at(fref, q.b) == IR_NONE {
        ra_set(&mut fref, q.b, i);
      }
      ra_set(&mut lref, q.b, i);
      if u_at(fref, q.c) == IR_NONE {
        ra_set(&mut fref, q.c, i);
      }
      ra_set(&mut lref, q.c, i);
    }
    i = wrap_add(i, 1);
  }
  // The registers made in front of a label: (label position, multiplier).
  let mut hp = vec_new[u64]();
  let mut hm = vec_new[u64]();
  let mut hr = vec_new[u64]();
  let mut dreg = vec_new[u64]();
  i = 0;
  while i < n {
    vec_push(&mut dreg, 0);
    i = wrap_add(i, 1);
  }
  let mut done = 0;
  i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if (q.op == IR_DIV || q.op == IR_REM) && q.c == 0 && q.b < vec_len(kv) && u_at(kv, q.b) != IR_NONE && u_at(kv, q.b) > 2 {
      // The innermost loop around position i that has a place in front of it.
      let mut best = IR_NONE;
      let mut bestp = IR_NONE;
      let mut lb = 0;
      while lb < vec_len(lpos) {
        let lp = u_at(lpos, lb);
        if lp != IR_NONE && lp < i && u_at(lref, lb) > i && (best == IR_NONE || lp > best) {
          let at = ix_hoist_at(f, lpos, lp, u_at(lref, lb));
          if at != IR_NONE {
            best = lp;
            bestp = at;
          }
        }
        lb = wrap_add(lb, 1);
      }
      if best != IR_NONE {
        // The multiplier the emitter would load: that of the shift-free form
        // for a division it has one for, else the one in the generated code.
        let mg = ix_div_magic(u_at(kv, q.b));
        let mut mm = 0;
        if q.op == IR_DIV && mg.ok {
          mm = mg.m;
        } else {
          mm = ix_divm(&mut g, u_at(kv, q.b), q.op == IR_REM);
        }
        if mm >= 2147483648 {
          let mut h = 0;
          let mut at = IR_NONE;
          while h < vec_len(hp) {
            if u_at(hp, h) == bestp && u_at(hm, h) == mm {
              at = h;
            }
            h = wrap_add(h, 1);
          }
          if at == IR_NONE {
            at = vec_len(hp);
            vec_push(&mut hp, bestp);
            vec_push(&mut hm, mm);
            vec_push(&mut hr, ir_reg(&mut f));
          }
          ra_set(&mut dreg, i, wrap_add(u_at(hr, at), 2));
          done = wrap_add(done, 1);
        }
      }
    }
    i = wrap_add(i, 1);
  }
  if done > 0 {
    let mut out = vec_new[IrIns]();
    i = 0;
    while i < n {
      let mut h = 0;
      while h < vec_len(hp) {
        if u_at(hp, h) == i {
          vec_push(&mut out, IrIns { op: IR_CONST, d: u_at(hr, h), a: u_at(hm, h), b: 0, c: 0, ty: 0 });
        }
        h = wrap_add(h, 1);
      }
      let mut q = vec_get(f.ins, i);
      if u_at(dreg, i) != 0 {
        q.c = u_at(dreg, i);
      }
      vec_push(&mut out, q);
      i = wrap_add(i, 1);
    }
    vec_free(f.ins);
    f.ins = out;
  }
  vec_free(ndef);
  vec_free(kv);
  vec_free(lpos);
  vec_free(fref);
  vec_free(lref);
  vec_free(hp);
  vec_free(hm);
  vec_free(hr);
  vec_free(dreg);
  return done;
}

/// `y = op s, b; ...; s = op2 y, c` (or `op2 c, y`), where `y` is written and
/// read only there, `b` and `c` are not `s`, and nothing between the two
/// reads or writes `s`, becomes `s = op s, b; ...; s = op2 s, c`: the old
/// value of `s` is dead once the first reads it, so `y` needs no register of
/// its own. This is the loop-carried `x = (x >> 1) ^ (m & k)`, where the
/// shifted value would otherwise be copied back into `x`'s register.
fn ix_fwd(f: &mut IrFn) -> u64 {
  let nuse = iropt_nuse(f);
  let ndef = iropt_ndef(f);
  let n = vec_len(f.ins);
  // newd[i] = s + 1: the definition at i writes s; usep[j] = 1: the use at j
  // reads s in place of y (its operand renamed through `ra_subst`).
  let mut newd = vec_new[u64]();
  let mut usey = vec_new[u64]();
  let mut i = 0;
  while i < n {
    vec_push(&mut newd, 0);
    vec_push(&mut usey, 0);
    i = i + 1;
  }
  let mut done = 0;
  i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    let y = q.d;
    if ra_is_binary(q.op) && y < f.nreg && q.a < f.nreg && q.a != y && q.b != q.a && q.b != y && u_at(ndef, y) == 1 && u_at(nuse, y) == 1 && u_at(newd, i) == 0 && u_at(usey, i) == 0 {
      let s = q.a;
      let mut j = wrap_add(i, 1);
      let mut scanning = true;
      let mut found = n;
      while scanning && j < n && j < wrap_add(i, 40) {
        let m = vec_get(f.ins, j);
        if m.op == IR_LABEL || ra_is_end(m.op) {
          scanning = false;
        } else if ra_reads_has(f, m, y) {
          scanning = false;
          if ra_is_binary(m.op) && m.d == s && u_at(newd, j) == 0 && u_at(usey, j) == 0 && ((m.a == y && m.b != s && m.b != y) || (m.b == y && m.a != s && m.a != y)) {
            found = j;
          }
        } else if ra_reads_has(f, m, s) || ra_writes_has(m, s) || ra_writes_has(m, y) {
          scanning = false;
        } else {
          j = wrap_add(j, 1);
        }
      }
      if found < n {
        ra_set(&mut newd, i, wrap_add(s, 1));
        ra_set(&mut usey, found, y + 1);
        done = wrap_add(done, 1);
      }
    }
    i = i + 1;
  }
  if done == 0 {
    vec_free(nuse);
    vec_free(ndef);
    vec_free(newd);
    vec_free(usey);
    return 0;
  }
  let mut out = vec_new[IrIns]();
  i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    let nd = u_at(newd, i);
    let uy = u_at(usey, i);
    if nd != 0 {
      vec_push(&mut out, IrIns { op: q.op, d: wrap_sub(nd, 1), a: q.a, b: q.b, c: q.c, ty: q.ty });
    } else if uy != 0 {
      vec_push(&mut out, ra_subst(q, wrap_sub(uy, 1), q.d));
    } else {
      vec_push(&mut out, q);
    }
    i = i + 1;
  }
  vec_free(nuse);
  vec_free(ndef);
  vec_free(newd);
  vec_free(usey);
  vec_free(f.ins);
  f.ins = out;
  return done;
}

/// Gives the frame slots of `IR_SLOT` instructions their places in the
/// slot area: `a` of each is its offset in words, and slots whose addresses
/// are never live together share words. The result is the area's size. A slot
/// is live from its first to its last use over its address and every copy of
/// it (`MOV` and arithmetic); a slot whose address is stored or reaches any
/// other instruction stays live for the whole function.
fn ix_share_slots(f: &mut IrFn, moff: &mut Vec[u64]) -> u64 {
  let n = vec_len(f.ins);
  let nr = f.nreg;
  let bl = ra_blocks(f);
  let lv = ra_live(f, bl);
  let iv = ra_intervals(f, bl, lv);
  // Slot number + 1 that each register may hold the address of (0: none).
  let mut root = vec_new[u64]();
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut root, 0);
    r = r + 1;
  }
  // How many instructions write each register: the result area of a call
  // is shared only when its register holds nothing else.
  let mut ndefs = vec_new[u64]();
  r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut ndefs, 0);
    r = r + 1;
  }
  let mut spos = vec_new[u64]();
  let mut pinned = vec_new[u64]();
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    let mut ws = vec_new[u64]();
    ra_writes(q, &mut ws);
    let mut j = 0;
    while j < vec_len(ws) {
      let w = vec_get(ws, j);
      if w < nr {
        ra_set(&mut ndefs, w, wrap_add(u_at(ndefs, w), 1));
      }
      j = j + 1;
    }
    vec_free(ws);
    i = i + 1;
  }
  i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_SLOT {
      vec_push(&mut spos, i);
      vec_push(&mut pinned, 0);
      ra_set(&mut root, q.d, vec_len(spos));
    } else if q.op == IR_CALLM {
      vec_push(&mut spos, i);
      if q.d < nr && u_at(ndefs, q.d) == 1 {
        vec_push(&mut pinned, 0);
        ra_set(&mut root, q.d, vec_len(spos));
      } else {
        vec_push(&mut pinned, 1);
      }
    }
    i = i + 1;
  }
  let ns = vec_len(spos);
  let mut round = 0;
  let mut changed = true;
  while changed && round < 64 {
    changed = false;
    i = 0;
    while i < n {
      let q = vec_get(f.ins, i);
      let mut rs = vec_new[u64]();
      ra_reads(f, q, &mut rs);
      let mut j = 0;
      while j < vec_len(rs) {
        let x = vec_get(rs, j);
        let sl = u_at(root, x);
        if x < nr && sl != 0 {
          if ra_is_binary(q.op) || q.op == IR_MOV {
            let w = q.d;
            if w < nr && w != IR_NONE {
              let prev = u_at(root, w);
              if prev == 0 {
                ra_set(&mut root, w, sl);
                changed = true;
              } else if prev != sl {
                ra_set(&mut pinned, wrap_sub(prev, 1), 1);
                ra_set(&mut pinned, wrap_sub(sl, 1), 1);
              }
            }
          } else if q.op == IR_STORE {
            if x == q.d {
              ra_set(&mut pinned, wrap_sub(sl, 1), 1);
            }
          } else if q.op != IR_LOAD && q.op != IR_CALL && q.op != IR_CALLM && q.op != IR_PCALL && q.op != IR_ZERO {
            ra_set(&mut pinned, wrap_sub(sl, 1), 1);
          }
        }
        j = j + 1;
      }
      vec_free(rs);
      i = i + 1;
    }
    round = round + 1;
  }
  if changed {
    // No fixed point: keep every slot to itself.
    let mut k = 0;
    while k < ns {
      ra_set(&mut pinned, k, 1);
      k = k + 1;
    }
  }
  let mut lo = vec_new[u64]();
  let mut hi = vec_new[u64]();
  let mut k = 0;
  while k < ns {
    if u_at(pinned, k) != 0 {
      vec_push(&mut lo, 0);
      vec_push(&mut hi, n);
    } else {
      vec_push(&mut lo, n);
      vec_push(&mut hi, 0);
    }
    k = k + 1;
  }
  r = 0;
  while r < nr && r < 1000000000 {
    let sl = u_at(root, r);
    if sl != 0 && u_at(iv.lo, r) != IR_NONE && u_at(pinned, wrap_sub(sl, 1)) == 0 {
      let t = wrap_sub(sl, 1);
      if u_at(iv.lo, r) < u_at(lo, t) {
        ra_set(&mut lo, t, u_at(iv.lo, r));
      }
      if u_at(iv.hi, r) > u_at(hi, t) {
        ra_set(&mut hi, t, u_at(iv.hi, r));
      }
    }
    r = r + 1;
  }
  // First fit: the lowest offset where no slot live at the same time
  // overlaps.
  let mut off = vec_new[u64]();
  let mut size = vec_new[u64]();
  k = 0;
  while k < ns {
    let sq = ix_at(f, u_at(spos, k));
    if sq.op == IR_CALLM {
      vec_push(&mut size, sq.ty);
    } else {
      vec_push(&mut size, sq.c);
    }
    vec_push(&mut off, 0);
    k = k + 1;
  }
  let mut area = 0;
  k = 0;
  while k < ns {
    // Candidates: 0 and the end of every slot placed before.
    let mut best = IR_NONE;
    let mut cand = 0;
    let mut cn = 0;
    while cn <= k && cn < 100000 {
      if cn > 0 {
        let pj = wrap_sub(cn, 1);
        cand = wrap_add(u_at(off, pj), u_at(size, pj));
      }
      let mut fits = true;
      let mut t = 0;
      while t < k {
        if u_at(lo, k) <= u_at(hi, t) && u_at(lo, t) <= u_at(hi, k) {
          let a0 = u_at(off, t);
          let a1 = wrap_add(a0, u_at(size, t));
          let b1 = wrap_add(cand, u_at(size, k));
          if cand < a1 && a0 < b1 {
            fits = false;
          }
        }
        t = t + 1;
      }
      if fits && cand < best {
        best = cand;
      }
      cn = cn + 1;
    }
    ra_set(&mut off, k, best);
    let e = wrap_add(best, u_at(size, k));
    if e > area {
      area = e;
    }
    let pos = u_at(spos, k);
    if pos < vec_len(f.ins) {
      let mut q = vec_get(f.ins, pos);
      if q.op == IR_SLOT {
        q.a = best;
        vec_set(&mut f.ins, pos, q);
      } else {
        ra_set(&mut moff, pos, best);
      }
    }
    k = k + 1;
  }
  // A result area moves to the bottom of the frame when nothing live at the
  // same time is there: the call then returns into the slot itself.
  k = 0;
  while k < ns {
    let pos = u_at(spos, k);
    let mut is_callm = false;
    if pos < vec_len(f.ins) {
      let cq = vec_get(f.ins, pos);
      is_callm = cq.op == IR_CALLM;
    }
    if is_callm && u_at(size, k) <= area {
      let cand = wrap_sub(area, u_at(size, k));
      let mut fits = true;
      let mut t = 0;
      while t < ns {
        if t != k && u_at(lo, k) <= u_at(hi, t) && u_at(lo, t) <= u_at(hi, k) {
          if cand < wrap_add(u_at(off, t), u_at(size, t)) {
            fits = false;
          }
        }
        t = t + 1;
      }
      if fits {
        ra_set(&mut off, k, cand);
        ra_set(&mut moff, pos, cand);
      }
    }
    k = k + 1;
  }
  vec_free(ndefs);
  vec_free(off);
  vec_free(size);
  vec_free(lo);
  vec_free(hi);
  vec_free(spos);
  vec_free(pinned);
  vec_free(root);
  vec_free(iv.lo);
  vec_free(iv.hi);
  vec_free(lv.inn);
  vec_free(lv.out);
  vec_free(lv.bit);
  vec_free(bl);
  return area;
}

/// Can an instruction read slot-address register `r` without it being in a
/// register: as the base of a load or a store (not as the stored value or
/// the index), or as the source of a copy `cand` says need not be written?
fn ix_fold_read(q: IrIns, r: u64, al: &IrAlloc, cand: &Vec[u64]) -> bool {
  if q.op == IR_LOAD {
    return q.a == r && q.b != r;
  }
  if q.op == IR_STORE {
    return q.a == r && q.b != r && q.d != r;
  }
  if q.op == IR_MOV {
    return q.a == r && q.d != r && u_at(al.cst, q.d) == 2 && u_at(cand, q.d) == 1;
  }
  return false;
}

/// Marks the registers that hold the address of a frame slot (written once,
/// by `IR_SLOT` or by a copy of one): `al.cst` is 2 and `al.cv` the slot's
/// lowest word below %rbp. A load or store through one is written off %rbp
/// (`ix_aprep`), and where every use is of that kind (`al.cst` 3) the
/// address itself is never computed.
fn ix_fold_slots(f: &IrFn, al: &mut IrAlloc, base: u64) {
  let n = vec_len(f.ins);
  let nr = f.nreg;
  let mut ndef = vec_new[u64]();
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut ndef, 0);
    r = r + 1;
  }
  let mut j = 0;
  while j < vec_len(f.params) {
    let pr = vec_get(f.params, j);
    ra_set(&mut ndef, pr, wrap_add(u_at(ndef, pr), 1));
    j = j + 1;
  }
  let mut i = 0;
  while i < n {
    let mut ws = vec_new[u64]();
    ra_writes(vec_get(f.ins, i), &mut ws);
    j = 0;
    while j < vec_len(ws) {
      let w = vec_get(ws, j);
      if w < nr {
        ra_set(&mut ndef, w, wrap_add(u_at(ndef, w), 1));
      }
      j = j + 1;
    }
    vec_free(ws);
    i = i + 1;
  }
  let mut found = 0;
  i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_SLOT && q.d < nr && u_at(ndef, q.d) == 1 && u_at(al.cst, q.d) == 0 {
      ra_set(&mut al.cst, q.d, 2);
      ra_set(&mut al.cv, q.d, wrap_add(base, wrap_add(q.a, q.c)));
      found = wrap_add(found, 1);
    }
    i = i + 1;
  }
  if found == 0 {
    vec_free(ndef);
    return;
  }
  // Copies of those addresses, in a few rounds (a copy of a copy).
  let mut round = 0;
  let mut grew = true;
  while grew && round < 4 {
    grew = false;
    i = 0;
    while i < n {
      let q = vec_get(f.ins, i);
      if q.op == IR_MOV && q.d < nr && q.a < nr && q.d != q.a && u_at(ndef, q.d) == 1 && u_at(al.cst, q.d) == 0 && u_at(al.cst, q.a) == 2 {
        ra_set(&mut al.cst, q.d, 2);
        ra_set(&mut al.cv, q.d, u_at(al.cv, q.a));
        grew = true;
      }
      i = i + 1;
    }
    round = round + 1;
  }
  // Which of them are only ever read in a way that needs no register.
  let mut cand = vec_new[u64]();
  r = 0;
  while r < nr && r < 1000000000 {
    if u_at(al.cst, r) == 2 {
      vec_push(&mut cand, 1);
    } else {
      vec_push(&mut cand, 0);
    }
    r = r + 1;
  }
  let mut changed = true;
  while changed {
    changed = false;
    i = 0;
    while i < n {
      let q = vec_get(f.ins, i);
      let mut rs = vec_new[u64]();
      ra_reads(f, q, &mut rs);
      j = 0;
      while j < vec_len(rs) {
        let x = vec_get(rs, j);
        if x < nr && u_at(cand, x) == 1 && !ix_fold_read(q, x, al, cand) {
          ra_set(&mut cand, x, 0);
          changed = true;
        }
        j = j + 1;
      }
      vec_free(rs);
      i = i + 1;
    }
  }
  // A parameter or a live-out register is read by no instruction of its own.
  j = 0;
  while j < vec_len(f.params) {
    let pr = vec_get(f.params, j);
    if pr < nr {
      ra_set(&mut cand, pr, 0);
    }
    j = j + 1;
  }
  r = 0;
  while r < nr && r < 1000000000 {
    if u_at(cand, r) == 1 {
      ra_set(&mut al.cst, r, 3);
    }
    r = r + 1;
  }
  vec_free(cand);
  vec_free(ndef);
}

/// The family (see x86_fam_at) of the 64-bit register named from `d` to `e`,
/// or 0 for anything else, %rsp and %rbp included.
fn ix_reg64(code: &Vec[u64], d: u64, e: u64) -> u64 {
  if u_at(code, d) != 37 || e <= wrap_add(d, 1) {
    return 0;
  }
  let f = x86_fam_at(code, wrap_add(d, 1));
  if f == 0 || f == 7 || f == 8 {
    return 0;
  }
  if f <= 8 {
    if u_at(code, wrap_add(d, 1)) == 114 {
      return f;
    }
    return 0;
  }
  let last = u_at(code, wrap_sub(e, 1));
  if last >= 48 && last <= 57 {
    return f;
  }
  return 0;
}

/// N when the operand from `s` to `e` is `N(%rsp)` with N a multiple of 8 in
/// `lo` .. `hi` (the frame words of spilled values), else IR_NONE.
fn ix_spill_at(code: &Vec[u64], s: u64, e: u64, lo: u64, hi: u64) -> u64 {
  let mut p = s;
  while p < e && p < vec_len(code) && vec_get(code, p) != 40 {
    p = p + 1;
  }
  if p >= e || !x86_txt(code, p, e, "(%rsp)") {
    return IR_NONE;
  }
  if p <= s || wrap_sub(p, s) > 6 {
    return IR_NONE;
  }
  let mut v = 0;
  let mut k = s;
  while k < p {
    let ch = u_at(code, k);
    if ch < 48 || ch > 57 {
      return IR_NONE;
    }
    v = wrap_add(wrap_mul(v, 10), wrap_sub(ch, 48));
    k = k + 1;
  }
  if v % 8 != 0 || v < lo || v >= hi {
    return IR_NONE;
  }
  return v;
}

/// The entries of the table (register family, frame offset) that survive
/// when the registers in `mask` (a bit per family) are written and, when
/// `off` is not IR_NONE, the word at that offset is.
fn ix_reload_kill(treg: &mut Vec[u64], toff: &mut Vec[u64], mask: u64, off: u64) {
  let mut nr = vec_new[u64]();
  let mut no = vec_new[u64]();
  let mut j = 0;
  while j < vec_len(treg) {
    let f = u_at(treg, j);
    let o = u_at(toff, j);
    let mut gone = o == off;
    if f < 64 && ((mask >> f) & 1) == 1 {
      gone = true;
    }
    if !gone {
      vec_push(&mut nr, f);
      vec_push(&mut no, o);
    }
    j = j + 1;
  }
  vec_free(treg);
  vec_free(toff);
  treg = nr;
  toff = no;
}

/// Does the table say that register family `f` holds the word at `off`?
fn ix_reload_has(treg: &Vec[u64], toff: &Vec[u64], f: u64, off: u64) -> bool {
  let mut j = 0;
  while j < vec_len(treg) {
    if u_at(treg, j) == f && u_at(toff, j) == off {
      return true;
    }
    j = j + 1;
  }
  return false;
}

/// Drops the load of a spilled value into a register that holds that value
/// already: `mov 40(%rsp), %rsi` again after stores through %rsi, as when a
/// struct is written field by field to an address kept in the frame. `lo` ..
/// `hi` are the byte offsets of the frame words the allocator spills to;
/// nothing but a move into the register or a store to that word changes what
/// they hold (they are never addressed). Whatever else a line does that is
/// not a compare, a jump or a plain write to registers forgets everything.
fn ix_reload(code: &Vec[u64], lo: u64, hi: u64, out: &mut Vec[u64]) {
  let starts = x86_line_starts(code);
  let nl = vec_len(starts);
  let mut treg = vec_new[u64]();
  let mut toff = vec_new[u64]();
  let mut i = 0;
  while i < nl
    invariant i <= nl
  {
    let s = u_at(starts, i);
    let e = x86_line_end(code, s);
    let mut keep = true;
    if u_at(code, s) != 9 || u_at(code, wrap_add(s, 1)) == 46 {
      ix_reload_kill(&mut treg, &mut toff, 131071, IR_NONE);
    } else if x86_has_prefix(code, s, "\tj") || x86_has_prefix(code, s, "\tcmp") || x86_has_prefix(code, s, "\ttest ") {
      keep = true;
    } else if x86_has_prefix(code, s, "\tmov ") || x86_has_prefix(code, s, "\tmovq ") || x86_has_prefix(code, s, "\tmovl ")
      || x86_has_prefix(code, s, "\tmovb ") || x86_has_prefix(code, s, "\tmovw ")
    {
      let d = x86_last_op(code, s, e);
      if d == e || d < 2 {
        ix_reload_kill(&mut treg, &mut toff, 131071, IR_NONE);
      } else if u_at(code, d) == 37 {
        let f = ix_reg64(code, d, e);
        let mut off = IR_NONE;
        if f != 0 && x86_has_prefix(code, s, "\tmov ") {
          off = ix_spill_at(code, wrap_add(s, 5), wrap_sub(d, 2), lo, hi);
        }
        if off != IR_NONE && ix_reload_has(treg, toff, f, off) {
          keep = false;
        } else {
          ix_reload_kill(&mut treg, &mut toff, x86_fams(code, d, e), IR_NONE);
          if off != IR_NONE && vec_len(treg) < 8 {
            vec_push(&mut treg, f);
            vec_push(&mut toff, off);
          }
        }
      } else if x86_has_rsp(code, d, e) {
        ix_reload_kill(&mut treg, &mut toff, 0, ix_spill_at(code, d, e, lo, hi));
      }
    } else {
      let w = x86_plain_writes(code, s, e);
      ix_reload_kill(&mut treg, &mut toff, w, IR_NONE);
    }
    if keep {
      let mut k = s;
      while k < e {
        vec_push(&mut out, u_at(code, k));
        k = k + 1;
      }
      if e < vec_len(code) {
        vec_push(&mut out, 10);
      }
    }
    i = i + 1;
  }
  vec_free(starts);
  vec_free(treg);
  vec_free(toff);
}

/// Writes function instance `x` from its IR, to `g.out`. False (nothing
/// written) when the IR does not cover it or the convention does not match.
/// The label at the start of the code that a return-at-once stub leaves to
/// the function proper.
const IX_SLOW: u64 = 4000000000;

/// An instruction that a return-at-once stub may hold: it computes with
/// registers only, and its code uses no register but %rax and the
/// allocatable ones.
fn ix_stub_op(q: IrIns) -> bool {
  let op = q.op;
  return op == IR_CONST || op == IR_MOV || op == IR_ADD || op == IR_SUB || op == IR_AND || op == IR_OR || op == IR_XOR || (op >= IR_EQ && op <= IR_SGE);
}

/// The position of the label `l` in `f`, or IR_NONE.
fn ix_label_pos(f: &IrFn, l: u64) -> u64 {
  let mut i = 0;
  while i < vec_len(f.ins) {
    let q = ix_at(f, i);
    if q.op == IR_LABEL && q.a == l {
      return i;
    }
    i = i + 1;
  }
  return IR_NONE;
}

/// A function that first tests its parameters and, when they pass, returns
/// a value computed from them at once is entered through a stub: the test and
/// that return, with no frame and no saved registers, in front of the
/// function proper. This returns the stub as a function of its own (no
/// instructions: there is none). Its labels carry a number of their own, so
/// they cannot clash with the ones of `f`.
fn ix_fast_entry(f: &IrFn) -> IrFn {
  let mut s = ir_new(wrap_add(f.x, 2000000000));
  let n = vec_len(f.ins);
  let mut i = 0;
  while i < n && ix_stub_op(ix_at(f, i)) {
    i = i + 1;
  }
  let br = ix_at(f, i);
  if i >= n || br.op != IR_BR || vec_len(f.params) > 4 || vec_len(f.lent) > 0 {
    return s;
  }
  let mut side = 0;
  let mut ret = IR_NONE;
  let mut e = 1;
  while e <= 2 && side == 0 {
    let mut l = br.b;
    if e == 2 {
      l = br.c;
    }
    let lp = ix_label_pos(f, l);
    if lp != IR_NONE {
      let mut k = wrap_add(lp, 1);
      while k < n && ix_stub_op(ix_at(f, k)) {
        k = k + 1;
      }
      let rq = ix_at(f, k);
      if k < n && rq.op == IR_RET && rq.c == 0 {
        side = e;
        ret = k;
      }
    }
    e = e + 1;
  }
  if side == 0 {
    return s;
  }
  let mut l = br.b;
  if side == 2 {
    l = br.c;
  }
  let lp = ix_label_pos(f, l);
  let lo = f.nlabel;
  let hi = wrap_add(f.nlabel, 1);
  let mut k = 0;
  while k < vec_len(f.params) {
    vec_push(&mut s.params, vec_get(f.params, k));
    k = k + 1;
  }
  s.nreg = f.nreg;
  s.nlabel = wrap_add(f.nlabel, 2);
  k = 0;
  while k < i {
    vec_push(&mut s.ins, ix_at(f, k));
    k = k + 1;
  }
  // The exit block is last, so its return needs no jump.
  if side == 1 {
    ir_emit(&mut s, IR_BR, IR_NONE, br.a, hi, lo, 0);
  } else {
    ir_emit(&mut s, IR_BR, IR_NONE, br.a, lo, hi, 0);
  }
  ir_place(&mut s, lo);
  ir_emit(&mut s, IR_UNREACH, IR_NONE, IR_NONE, IR_NONE, 0, 0);
  ir_place(&mut s, hi);
  k = wrap_add(lp, 1);
  while k <= ret && k < n {
    vec_push(&mut s.ins, ix_at(f, k));
    k = k + 1;
  }
  return s;
}

/// Does the code in `v` write one of the registers that hold the arguments
/// (%rdi, %rsi, %rdx, %rcx)? It is read line by line: the operand after the
/// last comma, or the only operand, is where an instruction writes.
fn ix_writes_args(v: &Vec[u64]) -> bool {
  let n = vec_len(v);
  let mut i = 0;
  while i < n {
    let mut e = i;
    while e < n && u_at(v, e) != 10 {
      e = wrap_add(e, 1);
    }
    // The operand starts after the last comma, or the first blank, of the line.
    let mut st = i;
    let mut k = i;
    while k < e {
      let ch = u_at(v, k);
      if ch == 44 || ch == 32 || ch == 9 {
        st = wrap_add(k, 1);
      }
      k = wrap_add(k, 1);
    }
    if st < e && u_at(v, st) == 37 && (ix_has_at(v, st, "%rdi") || ix_has_at(v, st, "%rsi") || ix_has_at(v, st, "%rdx") || ix_has_at(v, st, "%rcx")
      || ix_has_at(v, st, "%edi") || ix_has_at(v, st, "%esi") || ix_has_at(v, st, "%edx") || ix_has_at(v, st, "%ecx")
      || ix_has_at(v, st, "%di") || ix_has_at(v, st, "%si") || ix_has_at(v, st, "%dx") || ix_has_at(v, st, "%cx")
      || ix_has_at(v, st, "%dl") || ix_has_at(v, st, "%cl")) {
      return true;
    }
    i = wrap_add(e, 1);
  }
  return false;
}

/// The code of stub `v` up to its last jump to the function proper: what the
/// stub does after that is its return, which may write %rax and %rdx.
fn ix_stub_head(v: &Vec[u64]) -> Vec[u64] {
  let n = vec_len(v);
  let mut last = 0;
  let mut i = 0;
  while i < n {
    if ix_has_at(v, i, "_4000000000") {
      last = i;
    }
    i = i + 1;
  }
  let mut e = last;
  while e < n && u_at(v, e) != 10 {
    e = e + 1;
  }
  let mut r = vec_new[u64]();
  i = 0;
  while i < e {
    vec_push(&mut r, u_at(v, i));
    i = i + 1;
  }
  return r;
}

/// `s` with each `\tud2` turned into a jump to the function proper of instance `x`.
fn ix_stub_jumps(v: &Vec[u64], x: u64) -> Vec[u64] {
  let mut r = vec_new[u64]();
  let n = vec_len(v);
  let mut i = 0;
  while i < n {
    if ix_has_at(v, i, "\tud2\n") {
      w_s(&mut r, "\tjmp ");
      ix_lbl(&mut r, x, IX_SLOW);
      w_s(&mut r, "\n");
      i = i + 5;
    } else {
      vec_push(&mut r, u_at(v, i));
      i = i + 1;
    }
  }
  return r;
}

fn irx_function_n(g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, x: u64, ncallee: u64) -> u64 {
  if g.stage0 {
    return 0;
  }
  let f = ir_lower(c, &mut m, p, x);
  if f.failed || vec_len(f.ins) > IX_MAX_INS {
    ir_free(f);
    return 0;
  }
  let mut stub = vec_new[u64]();
  if x86_regargs(&mut g, c, &mut m, p, x) > 0 {
    let s = ix_fast_entry(f);
    if vec_len(s.ins) > 0 {
      let mut st = vec_new[u64]();
      let none = vec_new[u64]();
      let r = ix_function_core(&mut g, c, &mut m, p, x, ncallee, s, true, none, &mut st);
      let head = ix_stub_head(st);
      let clobbers = ix_writes_args(head);
      vec_free(head);
      if r == 1 && !clobbers {
        vec_free(stub);
        stub = st;
      } else {
        vec_free(st);
      }
    } else {
      ir_free(s);
    }
  }
  let mut res = vec_new[u64]();
  let r = ix_function_core(&mut g, c, &mut m, p, x, ncallee, f, false, stub, &mut res);
  if r == 1 {
    w_append(&mut g.out, res);
  }
  vec_free(res);
  return r;
}

/// The assembly of function `f` (lowered) of instance `x`, appended to
/// `res`. With `fast` it is a stub (see `ix_fast_entry`) that has no frame
/// and no header; otherwise `stub` goes in front of the prologue.
fn ix_function_core(g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, x: u64, ncallee: u64, fin: IrFn, fast: bool, stub: Vec[u64], res: &mut Vec[u64]) -> u64 {
  let mut f = fin;
  let looped = iropt_accrec(&mut f) > 0;
  iropt_inline(&mut f, c, &mut m, p, looped);
  iropt_copies(&mut f);
  iropt_slots(&mut f);
  iropt_fold(&mut f);
  iropt_copies(&mut f);
  iropt_dce(&mut f);
  let mut wb = 0;
  while wb < 4 && iropt_wbk(&mut f) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
    wb = wb + 1;
  }
  if iropt_exitfacts(&mut f) > 0 {
    iropt_reach(&mut f);
    iropt_copies(&mut f);
    iropt_dce(&mut f);
    iropt_labels(&mut f);
  }
  vec_free(f.nz);
  f.nz = vec_new[u64]();
  iropt_copies(&mut f);
  if iropt_cse(&mut f) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
  }
  if iropt_unroll(&mut f) > 0 {
    iropt_fold(&mut f);
    iropt_copies(&mut f);
    iropt_dce(&mut f);
  }
  iropt_switch(&mut f);
  iropt_thread(&mut f);
  if iropt_range(&mut f) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
    iropt_thread(&mut f);
  }
  if iropt_merge(&mut f) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
    iropt_thread(&mut f);
  }
  iropt_hoist(&mut f);
  iropt_reach(&mut f);
  iropt_labels(&mut f);
  iropt_chain(&mut f);
  iropt_copies(&mut f);
  iropt_dce(&mut f);
  // The jumps and labels gone, a join may now begin with the branch that a
  // constant decides.
  if iropt_merge(&mut f) > 0 {
    iropt_thread(&mut f);
    iropt_labels(&mut f);
    iropt_chain(&mut f);
    iropt_copies(&mut f);
    iropt_dce(&mut f);
  }
  if iropt_zext(&mut f, false) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
  }
  let mut u32t = IR_NONE;
  let mut ti = 0;
  while ti < vec_len(m.tys) && u32t == IR_NONE {
    if kind_t(m, ti) == TY_U32 {
      u32t = ti;
    }
    ti = wrap_add(ti, 1);
  }
  if u32t != IR_NONE && iropt_wrap32(&mut f, u32t) > 0 {
    iropt_dce(&mut f);
  }
  let mut fused = 0;
  while iropt_cmpfuse(&mut f) > 0 && fused < 4 {
    fused = fused + 1;
  }
  // After `while k < n && a[k] == b[k] { k += 1 }` an `if k == n` on the exit
  // of a mismatch is decided by the loop's test, which holds there.
  iropt_efacts(&mut f);
  if iropt_ifconv(&mut f) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
    iropt_labels(&mut f);
  }
  if iropt_zext(&mut f, true) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
  }
  // The same address computed twice in a loop (the load a comparison reads
  // and the load after it) is one value before the counter's multiples are
  // reduced, so that one register stands for it.
  if iropt_ebb(&mut f) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
  }
  iropt_ivs(&mut f);
  iropt_remdiv(&mut f);
  iropt_ebb(&mut f);
  iropt_copies(&mut f);
  if iropt_xorcancel(&mut f) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
  }
  iropt_bits(&mut f);
  iropt_licm(&mut f);
  if ix_divisible(&mut f, m) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
  }
  if iropt_vlen(&mut f) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
  }
  if iropt_rowptr(&mut f) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
  }
  if iropt_punroll(&mut f) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
  }
  iropt_wide(&mut f);
  iropt_dead_live(&mut f);
  iropt_copies(&mut f);
  iropt_fold(&mut f);
  ix_addr_fold(&mut f);
  ix_addr_fold2(&mut f);
  iropt_dce(&mut f);
  // Dead stores gone, a block may now be only a `jmp`.
  iropt_thread(&mut f);
  iropt_reach(&mut f);
  iropt_labels(&mut f);
  iropt_rotate(&mut f);
  if iropt_entry_guard(&mut f) > 0 {
    iropt_labels(&mut f);
  }
  if ix_incr(&mut f) > 0 {
    iropt_dce(&mut f);
  }
  ix_countdown(&mut f);
  if g.target != TARGET_KERNEL && ix_copy16(&mut f) > 0 {
    iropt_copies(&mut f);
    iropt_dce(&mut f);
  }
  ix_sinkld(&mut f);
  ix_ivmerge(&mut f);
  ix_selprep(&mut f);
  ix_coalesce(&mut f);
  ix_inplace(&mut f);
  ix_fwd(&mut f);
  ix_arms(&mut f);
  iropt_coldarm(&mut f);
  ix_divhoist(&mut f, &mut g);
  let xi = inst_at(m, x);
  let pos = ix_positions(&mut g, c, &mut m, p, x);
  let mut ok = vec_len(pos) == vec_len(f.params);
  if ok && name_is(p, xi.def, "main") && vec_len(pos) > 0 && g.target != TARGET_KERNEL {
    ok = false;
  }
  let rt = cg_ret_ty(&mut m, p, x);
  let mut k = 0;
  while ok && k < vec_len(f.ins) {
    let q = vec_get(f.ins, k);
    if (q.op == IR_CALL || q.op == IR_CALLM) && !ix_call_ok(f, &mut g, c, &mut m, p, q) {
      ok = false;
    }
    k = k + 1;
  }
  if !ok {
    vec_free(pos);
    vec_free(stub);
    ir_free(f);
    return 0;
  }
  let na = x86_regargs(&mut g, c, &mut m, p, x);
  let mut al = ra_alloc_const_wide(f, ncallee, 4);
  // A register kept in the frame is copied to a register around a loop that uses it.
  if ra_split_loops(&mut f, al, 6) > 0 {
    ra_free(al);
    al = ra_alloc_const_wide(f, ncallee, 4);
  }
  // A retry with fewer registers (see below) that spills more than the
  // attempt before it is not worth the saves it avoids.
  g.rspill = al.nspill;
  if al.nspill > g.rlimit {
    vec_free(pos);
    vec_free(stub);
    ra_free(al);
    ir_free(f);
    return 15;
  }
  let nuse = ix_uses(f);
  // The frame: saved registers, spills, slots.
  let mut moff = vec_new[u64]();
  k = 0;
  while k < vec_len(f.ins) {
    vec_push(&mut moff, 0);
    k = k + 1;
  }
  let slots = ix_share_slots(&mut f, &mut moff);
  let mut base = wrap_add(al.ncallee_used, al.nspill);
  // The padding word that keeps the frame even sits above the slots, so a
  // result area at the bottom of the slots is at %rsp.
  if wrap_add(base, slots) % 2 == 1 {
    base = wrap_add(base, 1);
  }
  ix_fold_slots(f, &mut al, base);
  let words = wrap_add(base, slots);
  let mut out = vec_new[u64]();
  if !fast {
    w_s(&mut out, "\t.type ");
    ix_sym(&mut out, &mut g, m, p, x);
    w_s(&mut out, ", @function\n");
    ix_sym(&mut out, &mut g, m, p, x);
    w_s(&mut out, ":                  # from the IR\n");
    // The stub costs a compare and a jump on every other entry, and saves the
    // frame only on the early one: it pays when the frame is heavy.
    if vec_len(stub) > 0 && al.ncallee_used >= 4 {
      w_append(&mut out, stub);
      ix_lbl(&mut out, x, IX_SLOW);
      w_s(&mut out, ":\n");
    }
  }
  let mut inner = vec_new[u64]();
  k = 0;
  while k < al.ncallee_used {
    ix_ins2(&mut inner, "mov", ix_rl(ix_callee(k)), ix_ml(wrap_add(k, 1)));
    k = k + 1;
  }
  let save_end = vec_len(inner);
  // A result of more than two words is above the parameters left on the stack.
  let mut retoff = 16;
  if na == 0 {
    retoff = wrap_add(16, wrap_mul(8, vec_len(pos)));
  }
  ix_result_homes(f, &mut al, retoff / 8);
  // The parameters, from their argument registers or stack words. A
  // parameter the allocator left in the frame stays in the stack word it
  // came in (the callee owns its arguments).
  k = 0;
  while k < vec_len(f.params) {
    let r = vec_get(f.params, k);
    if na == 0 && u_at(al.cls, r) == RA_SPILL && u_at(al.cst, r) == 0 && u_at(nuse, r) != 0 {
      let home = wrap_add(2, u_at(pos, k));
      ra_set(&mut al.idx, r, wrap_sub(0, wrap_add(wrap_add(al.ncallee_used, 1), home)));
    } else if u_at(al.cls, r) != RA_NONE && u_at(nuse, r) != 0 {
      let dst = ix_loc(al, r);
      let ps = u_at(pos, k);
      if na > 0 {
        ix_mov(&mut inner, ix_rl(x86_argreg(ps)), dst);
      } else {
        let mut t = dst.reg;
        if dst.k != IXK_REG {
          t = XR_RAX;
        }
        w_s(&mut inner, "\tmov ");
        w_num(&mut inner, wrap_add(16, wrap_mul(8, ps)));
        w_s(&mut inner, "(%fp), ");
        w_s(&mut inner, x86_rname(t));
        w_s(&mut inner, "\n");
        if dst.k != IXK_REG {
          ix_mov(&mut inner, ix_rl(XR_RAX), dst);
        }
      }
    }
    k = k + 1;
  }
  let ndef_b = iropt_ndef(f);
  let cv_b = iropt_consts(f, ndef_b);
  let mut conv_b = false;
  let mut wb_b = vec_new[u64]();
  let mut wi = 0;
  while wi < vec_len(f.ins) {
    let wq = vec_get(f.ins, wi);
    let mut bits = 0;
    if wq.ty != 0 && (wq.op == IR_WRAP || (wq.c == 1 && (wq.op == IR_ADD || wq.op == IR_SUB || wq.op == IR_MUL))) {
      let kt = kind_t(m, wq.ty);
      if kt == TY_U32 {
        bits = 32;
      } else if kt == TY_U16 {
        bits = 16;
      } else if kt == TY_U8 {
        bits = 8;
      }
    }
    vec_push(&mut wb_b, bits);
    wi = wi + 1;
  }
  let ub_b = iropt_ub_all(f, ndef_b, cv_b, wb_b, &mut conv_b);
  vec_free(wb_b);
  ix_body(&mut inner, f, al, &mut g, c, &mut m, p, nuse, ub_b, moff, base, words, ix_buffer(c, m, p, rt), retoff);
  vec_free(ndef_b);
  vec_free(cv_b);
  vec_free(ub_b);
  ix_lbl(&mut inner, f.x, IR_NONE);
  w_s(&mut inner, ":\n");
  // The allocator counted a callee-saved register that no instruction ended
  // up using: allocate again with one register fewer, so the function does
  // not save and restore it.
  let top = wrap_sub(al.ncallee_used, 1);
  if !fast && !g.rkeep && top >= 1 && top <= 4 && !ix_mentions_from(inner, save_end, x86_rname(ix_callee(top))) {
    vec_free(inner);
    vec_free(out);
    vec_free(nuse);
    vec_free(moff);
    vec_free(pos);
    vec_free(stub);
    ra_free(al);
    ir_free(f);
    return wrap_add(10, top);
  }
  k = 0;
  while k < al.ncallee_used {
    ix_ins2(&mut inner, "mov", ix_ml(wrap_add(k, 1)), ix_rl(ix_callee(k)));
    k = k + 1;
  }
  // A function with no frame, no calls and no use of the frame pointer
  // needs none of it: no push, no leave.
  let bare = words == 0 && !ix_mentions(inner, "%fp") && !ix_mentions(inner, "%rsp") && !ix_mentions(inner, "call");
  if fast && !bare {
    vec_free(inner);
    vec_free(out);
    vec_free(nuse);
    vec_free(moff);
    vec_free(pos);
    vec_free(stub);
    ra_free(al);
    ir_free(f);
    return 3;
  }
  if bare {
    w_s(&mut inner, "\tret\n");
  } else {
    w_s(&mut inner, "\tleave\n\tret\n");
  }
  if !fast {
    w_s(&mut inner, "\t.size ");
    ix_sym(&mut inner, &mut g, m, p, x);
    w_s(&mut inner, ", .-");
    ix_sym(&mut inner, &mut g, m, p, x);
    w_s(&mut inner, "\n\n");
  }
  if fast {
    let jumped = ix_stub_jumps(inner, x);
    vec_free(inner);
    inner = jumped;
  }
  let mut framed = ix_flip_jumps(inner);
  vec_free(inner);
  if !bare {
    // The frame is addressed from %rsp when the body allows it.
    let fp = ix_fpo(framed, wrap_mul(8, words));
    if vec_len(fp) > 0 {
      w_s(&mut out, "\tsub $");
      w_num(&mut out, wrap_add(wrap_mul(8, words), 8));
      w_s(&mut out, ", %rsp\n");
      // Spilled values live in the words just above the slots.
      let mut rl = vec_new[u64]();
      if words >= wrap_add(al.ncallee_used, al.nspill) {
        ix_reload(fp, wrap_mul(8, wrap_sub(words, wrap_add(al.ncallee_used, al.nspill))), wrap_mul(8, wrap_sub(words, al.ncallee_used)), &mut rl);
      } else {
        ix_reload(fp, 0, 0, &mut rl);
      }
      vec_free(framed);
      vec_free(fp);
      framed = rl;
    } else {
      vec_free(fp);
      if al.ncallee_used > 5 {
        // %rbp holds a value: there is no frame pointer to fall back to.
        vec_free(framed);
        vec_free(out);
        vec_free(nuse);
        vec_free(moff);
        vec_free(pos);
        vec_free(stub);
        ra_free(al);
        ir_free(f);
        return 2;
      }
      let cl = ix_fp_classic(framed);
      vec_free(framed);
      framed = cl;
      w_s(&mut out, "\tpush %rbp\n\tmov %rsp, %rbp\n\tsub $");
      w_num(&mut out, wrap_mul(8, words));
      w_s(&mut out, ", %rsp\n");
    }
  }
  w_append(&mut out, framed);
  w_append(&mut res, out);
  vec_free(framed);
  vec_free(out);
  vec_free(nuse);
  vec_free(moff);
  vec_free(pos);
  vec_free(stub);
  ra_free(al);
  ir_free(f);
  return 1;
}

/// `irx_function_n`, again with the register that ended up unused taken out
/// of the pool, while that does not make it spill more.
fn irx_shrink(g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, x: u64, n0: u64) -> u64 {
  g.rlimit = 1000000000;
  g.rkeep = false;
  let mut n = n0;
  let mut r = irx_function_n(&mut g, c, &mut m, p, x, n);
  let mut tries = 0;
  while r >= 11 && r <= 14 && tries < 6 {
    let prev = n;
    n = r - 10;
    g.rlimit = g.rspill;
    r = irx_function_n(&mut g, c, &mut m, p, x, n);
    if r == 15 {
      g.rlimit = 1000000000;
      g.rkeep = true;
      r = irx_function_n(&mut g, c, &mut m, p, x, prev);
      g.rkeep = false;
      return r;
    }
    tries = tries + 1;
  }
  g.rlimit = 1000000000;
  return r;
}

/// `irx_function_n` with %rbp among the registers, and without it when the
/// frame cannot be addressed from %rsp.
fn irx_function(g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser, x: u64) -> bool {
  let mut r = irx_shrink(&mut g, c, &mut m, p, x, 6);
  if r == 2 {
    r = irx_shrink(&mut g, c, &mut m, p, x, 5);
  }
  return r == 1;
}

/// `x86_program`, with the functions the IR covers written from it.
fn x86_program_ir(g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser) -> bool {
  let main_x = x86_program_start(&mut g, &mut m, p);
  if g.failed {
    return false;
  }
  iri_count(c, &mut m, p);
  let mut k = 0;
  while k < vec_len(m.fns) && !g.failed {
    let x = u_at(m.fns, k);
    if !irx_function(&mut g, c, &mut m, p, x) {
      x86_function(&mut g, c, &mut m, p, x);
    }
    k = k + 1;
  }
  return x86_program_end(&mut g, c, &mut m, p, main_x);
}
