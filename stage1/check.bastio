// Type and linearity checking, as stage0/src/check.rs does it, on the
// program as the monomorphizer left it (every function an instance).
//
// stage0 stops at the first error, so this does too: an error is recorded
// once (`cfail`) and every function returns as soon as one is.
//
// Ownership is tracked per place, as in stage0: a place is a variable with
// a chain of field names (`p`, `p.root`, `p.inner.buf`), interned in
// `Checker.paths`, and `Checker.moved` is the set of places that have been
// consumed. Sets of places are vectors without repeats.
import "mono.bastio";

const C_TYPE: u64 = 1;
const C_USE: u64 = 2;
const C_LEAK: u64 = 3;
const C_BRANCH: u64 = 4;
const C_MATCH: u64 = 5;
const C_TARGET: u64 = 6;
const C_EXPORT: u64 = 7;
const C_PIN: u64 = 8;
const C_LOCK_ORDER: u64 = 9;

const TARGET_HOSTED: u64 = 0;
const TARGET_KERNEL: u64 = 1;
const TARGET_USER: u64 = 2;

// Where a builtin is available.
const AV_ALL: u64 = 0;
const AV_HOSTED: u64 = 1;
const AV_MEM: u64 = 2;       // hosted and kernel
const AV_KERNEL: u64 = 3;
const AV_USER: u64 = 4;

/// A builtin's signature: up to four parameter types.
struct Bsig { name: Str, avail: u64, np: u64, p0: u64, p1: u64, p2: u64, p3: u64, ret: u64 }

/// A ghost accessor (specifications only): its argument type, whether it
/// also takes an index, and its result type.
struct Ghost { name: Str, arg: u64, idx: bool, ret: u64 }

/// A place: the field `s..e` of place `up`, or the variable `s..e` when
/// `up` is 0.
struct Path { up: u64, s: u64, e: u64 }

/// A variable in scope; `path` is its place.
struct Var { s: u64, e: u64, path: u64, vty: u64, mutable: bool }

struct Checker {
  bs: Vec[Bsig],
  ghosts: Vec[Ghost],
  /// The field (or payload) types of each struct and enum instance: those
  /// of instance x start at `ftys[fstart[x] - 1]`; a variant without a
  /// payload has type 0.
  fstart: Vec[u64],
  ftys: Vec[u64],
  /// Places; index 0 is unused.
  paths: Vec[Path],
  /// The variables in scope, innermost last.
  vars: Vec[Var],
  moved: Vec[u64],
  /// The variables bound by enclosing `forall`s (their nodes).
  bound: Vec[u64],
  target: u64,
  /// The return type of the function being checked.
  ret: u64,
  /// The instance being checked (0 for a plain spec fn).
  env: u64,
  /// Only the spec fns before this one are visible (0: all of them).
  spec_lim: u64,
  /// When checking spec fn `Mono.specs[j]`, j + 1: only the instances of
  /// generic spec fns before it are visible (0: all of them).
  spec_pos: u64,
  tu64: u64,
  tbool: u64,
  tunit: u64,
  tstr: u64,
  failed: bool,
  efile: u64,
  eline: u64,
  ecol: u64,
  ecode: u64,
  /// What is wrong, as bastioc0 says it (the sentence after the code),
  /// then its hints, one `  = ..` line each.
  emsg: Vec[u64],
  enotes: Vec[u64],
  /// The integer type of each arithmetic operator, unary minus and
  /// `wrap_*` call, and the source type of each `cast`/`wrap`, when it is
  /// not u64, per instance (the verifier's overflow bounds; every other one
  /// is u64).
  int_ops: Vec[IntOp],
  /// Instance `from` calls instance `to` (`locked` and `smp_run` call the
  /// function they name), without repeats, for `lock_order`.
  calls: Vec[Edge],
  /// Each `locked` call, in checking order.
  lsites: Vec[LockSite],
  /// The function's parameters are `vars[0..nparams]`.
  nparams: u64,
  /// Checking a loop invariant, where `old(..)` is allowed.
  inv: bool,
  /// Checking the argument of `old(..)` in a loop invariant, which may
  /// name only parameters (they alone have a value at the call).
  old_only: bool
}

struct Edge { from: u64, to: u64 }

/// `locked` call `node` in instance `x` holds a lock of class `cls` (the
/// type of its contents) while it runs instance `f`.
struct LockSite { x: u64, node: u64, cls: u64, f: u64 }

/// Operator node `node` of instance `x` works on integer type `ty`.
struct IntOp { x: u64, node: u64, ty: u64 }

fn checker_free(c: Checker) {
  vec_free(c.bs);
  vec_free(c.ghosts);
  vec_free(c.fstart);
  vec_free(c.ftys);
  vec_free(c.paths);
  vec_free(c.vars);
  vec_free(c.moved);
  vec_free(c.bound);
  vec_free(c.int_ops);
  vec_free(c.calls);
  vec_free(c.lsites);
  vec_free(c.emsg);
  vec_free(c.enotes);
}

fn bsig(c: &mut Checker, name: Str, avail: u64, np: u64, p0: u64, p1: u64, p2: u64, p3: u64, ret: u64) {
  vec_push(&mut c.bs, Bsig { name: name, avail: avail, np: np, p0: p0, p1: p1, p2: p2, p3: p3, ret: ret });
}

fn ghost(c: &mut Checker, name: Str, arg: u64, idx: bool, ret: u64) {
  vec_push(&mut c.ghosts, Ghost { name: name, arg: arg, idx: idx, ret: ret });
}

fn prim(m: &mut Mono, p: &Parser, kind: u64) -> u64 {
  return intern(&mut m, p, kind, 0);
}

fn ref_to(m: &mut Mono, p: &Parser, t: u64) -> u64 {
  return intern(&mut m, p, TY_REF, t);
}

fn mut_to(m: &mut Mono, p: &Parser, t: u64) -> u64 {
  return intern(&mut m, p, TY_MUTREF, t);
}

/// A checker for the program monomorphized into `m`, on `target`.
fn checker_new(m: &mut Mono, p: &Parser, target: u64) -> Checker {
  let u = prim(&mut m, p, TY_U64);
  let b = prim(&mut m, p, TY_BOOL);
  let un = prim(&mut m, p, TY_UNIT);
  let st = prim(&mut m, p, TY_STR);
  let mut paths = vec_new[Path]();
  vec_push(&mut paths, Path { up: 0, s: 0, e: 0 });
  let mut c = Checker {
    bs: vec_new[Bsig](), ghosts: vec_new[Ghost](), fstart: vec_new[u64](), ftys: vec_new[u64](),
    paths: paths, vars: vec_new[Var](), moved: vec_new[u64](), bound: vec_new[u64](),
    target: target, ret: un, env: 0, spec_lim: 0, spec_pos: 0, tu64: u, tbool: b, tunit: un, tstr: st,
    failed: false, efile: 0, eline: 0, ecol: 0, ecode: 0, emsg: vec_new[u64](), enotes: vec_new[u64](), int_ops: vec_new[IntOp](),
    calls: vec_new[Edge](), lsites: vec_new[LockSite](), nparams: 0, inv: false, old_only: false
  };
  let buf = prim(&mut m, p, TY_BUF);
  let byt = prim(&mut m, p, TY_BYTES);
  let hst = prim(&mut m, p, TY_HOST);
  let chd = prim(&mut m, p, TY_CHILD);
  let ser = prim(&mut m, p, TY_SERIAL);
  let frm = prim(&mut m, p, TY_FRAME);
  let ptb = prim(&mut m, p, TY_PT);
  let pol = prim(&mut m, p, TY_POOL);
  let mmu = prim(&mut m, p, TY_MMU);
  let cpu = prim(&mut m, p, TY_CPU);
  let prt = prim(&mut m, p, TY_PORTS);
  let pio = prim(&mut m, p, TY_PORTIO);
  let msp = prim(&mut m, p, TY_MMIOSPACE);
  let mio = prim(&mut m, p, TY_MMIO);
  let dma = prim(&mut m, p, TY_DMA);
  let lse = prim(&mut m, p, TY_LEASE);
  let u8t = prim(&mut m, p, TY_U8);
  let u16t = prim(&mut m, p, TY_U16);
  let u32t = prim(&mut m, p, TY_U32);
  let rbuf = ref_to(&mut m, p, buf);
  let rbyt = ref_to(&mut m, p, byt);
  let mbyt = mut_to(&mut m, p, byt);
  let rhst = ref_to(&mut m, p, hst);
  let vbyt = intern(&mut m, p, TY_VEC, byt);
  let rvbyt = ref_to(&mut m, p, vbyt);
  let mchd = mut_to(&mut m, p, chd);
  let rser = ref_to(&mut m, p, ser);
  let rpol = ref_to(&mut m, p, pol);
  let mpol = mut_to(&mut m, p, pol);
  let rfrm = ref_to(&mut m, p, frm);
  let mfrm = mut_to(&mut m, p, frm);
  let rptb = ref_to(&mut m, p, ptb);
  let mptb = mut_to(&mut m, p, ptb);
  let rmmu = ref_to(&mut m, p, mmu);
  let mmmu = mut_to(&mut m, p, mmu);
  let rcpu = ref_to(&mut m, p, cpu);
  let mcpu = mut_to(&mut m, p, cpu);
  let mprt = mut_to(&mut m, p, prt);
  let rpio = ref_to(&mut m, p, pio);
  let mpio = mut_to(&mut m, p, pio);
  let mmsp = mut_to(&mut m, p, msp);
  let rmio = ref_to(&mut m, p, mio);
  let mmmio = mut_to(&mut m, p, mio);
  let rdma = ref_to(&mut m, p, dma);
  let mdma = mut_to(&mut m, p, dma);
  bsig(&mut c, "alloc", AV_ALL, 1, u, 0, 0, 0, buf);
  bsig(&mut c, "len", AV_ALL, 1, rbuf, 0, 0, 0, u);
  bsig(&mut c, "get", AV_ALL, 2, rbuf, u, 0, 0, u);
  bsig(&mut c, "set", AV_ALL, 3, buf, u, u, 0, buf);
  bsig(&mut c, "free", AV_ALL, 1, buf, 0, 0, 0, un);
  bsig(&mut c, "print", AV_ALL, 1, u, 0, 0, 0, un);
  bsig(&mut c, "balloc", AV_ALL, 1, u, 0, 0, 0, byt);
  bsig(&mut c, "blen", AV_ALL, 1, rbyt, 0, 0, 0, u);
  bsig(&mut c, "bget", AV_ALL, 2, rbyt, u, 0, 0, u8t);
  bsig(&mut c, "bset", AV_ALL, 3, mbyt, u, u8t, 0, un);
  bsig(&mut c, "bfree", AV_ALL, 1, byt, 0, 0, 0, un);
  bsig(&mut c, "bfrom", AV_ALL, 1, st, 0, 0, 0, byt);
  bsig(&mut c, "host_argc", AV_HOSTED, 1, rhst, 0, 0, 0, u);
  bsig(&mut c, "host_arg", AV_HOSTED, 2, rhst, u, 0, 0, byt);
  bsig(&mut c, "host_read", AV_HOSTED, 3, rhst, rbyt, mbyt, 0, b);
  bsig(&mut c, "host_write", AV_HOSTED, 3, rhst, rbyt, rbyt, 0, b);
  bsig(&mut c, "host_eprint", AV_HOSTED, 2, rhst, rbyt, 0, 0, un);
  bsig(&mut c, "host_env", AV_HOSTED, 3, rhst, st, mbyt, 0, b);
  bsig(&mut c, "host_cpus", AV_HOSTED, 1, rhst, 0, 0, 0, u);
  bsig(&mut c, "host_spawn", AV_HOSTED, 2, rhst, rvbyt, 0, 0, chd);
  bsig(&mut c, "child_write", AV_HOSTED, 2, mchd, rbyt, 0, 0, b);
  bsig(&mut c, "child_close", AV_HOSTED, 1, mchd, 0, 0, 0, un);
  bsig(&mut c, "child_read_line", AV_HOSTED, 2, mchd, mbyt, 0, 0, b);
  bsig(&mut c, "child_wait", AV_HOSTED, 1, chd, 0, 0, 0, u);
  bsig(&mut c, "slen", AV_ALL, 1, st, 0, 0, 0, u);
  bsig(&mut c, "sget", AV_ALL, 2, st, u, 0, 0, u8t);
  bsig(&mut c, "serial_write", AV_ALL, 2, rser, u8t, 0, 0, un);
  bsig(&mut c, "serial_read", AV_ALL, 1, rser, 0, 0, 0, u8t);
  bsig(&mut c, "serial_poll", AV_KERNEL, 1, rser, 0, 0, 0, u);
  bsig(&mut c, "pool_size", AV_MEM, 1, rpol, 0, 0, 0, u);
  bsig(&mut c, "pool_take", AV_MEM, 2, mpol, u, 0, 0, frm);
  bsig(&mut c, "pool_give", AV_MEM, 2, mpol, frm, 0, 0, un);
  bsig(&mut c, "frame_id", AV_MEM, 1, rfrm, 0, 0, 0, u);
  bsig(&mut c, "frame_read", AV_MEM, 2, rfrm, u, 0, 0, u);
  bsig(&mut c, "frame_write", AV_MEM, 3, mfrm, u, u, 0, un);
  bsig(&mut c, "frame_read8", AV_MEM, 2, rfrm, u, 0, 0, u8t);
  bsig(&mut c, "frame_write8", AV_MEM, 3, mfrm, u, u8t, 0, un);
  bsig(&mut c, "pt_new", AV_MEM, 2, frm, u, 0, 0, ptb);
  bsig(&mut c, "pt_free", AV_MEM, 1, ptb, 0, 0, 0, frm);
  bsig(&mut c, "pt_free_root", AV_KERNEL, 2, rmmu, ptb, 0, 0, frm);
  bsig(&mut c, "pt_has", AV_MEM, 2, rptb, u, 0, 0, b);
  bsig(&mut c, "pt_writable", AV_MEM, 2, rptb, u, 0, 0, b);
  bsig(&mut c, "pt_put", AV_MEM, 3, mptb, u, ptb, 0, un);
  bsig(&mut c, "pt_take", AV_MEM, 2, mptb, u, 0, 0, ptb);
  bsig(&mut c, "pt_put_frame", AV_MEM, 4, mptb, u, frm, b, un);
  bsig(&mut c, "pt_take_frame", AV_MEM, 2, mptb, u, 0, 0, frm);
  bsig(&mut c, "pt_lease_count", AV_MEM, 1, mptb, 0, 0, 0, u);
  bsig(&mut c, "mmu_enter", AV_KERNEL, 2, mmmu, mptb, 0, 0, lse);
  bsig(&mut c, "mmu_exit", AV_KERNEL, 2, mmmu, lse, 0, 0, un);
  bsig(&mut c, "mmu_kernel", AV_KERNEL, 1, mmmu, 0, 0, 0, un);
  bsig(&mut c, "cpu_run", AV_KERNEL, 2, mcpu, rmmu, 0, 0, u);
  bsig(&mut c, "cpu_idle", AV_KERNEL, 1, mcpu, 0, 0, 0, u);
  bsig(&mut c, "cpu_get", AV_KERNEL, 2, rcpu, u, 0, 0, u);
  bsig(&mut c, "cpu_set", AV_KERNEL, 3, mcpu, u, u, 0, un);
  bsig(&mut c, "cpu_fpu_save", AV_KERNEL, 2, mcpu, mfrm, 0, 0, un);
  bsig(&mut c, "cpu_fpu_load", AV_KERNEL, 2, mcpu, rfrm, 0, 0, un);
  bsig(&mut c, "cpu_count", AV_KERNEL, 1, rcpu, 0, 0, 0, u);
  bsig(&mut c, "boot_fb", AV_KERNEL, 2, rcpu, u, 0, 0, u);
  bsig(&mut c, "port_claim", AV_MEM, 3, mprt, u, u, 0, pio);
  bsig(&mut c, "port_release", AV_MEM, 2, mprt, pio, 0, 0, un);
  bsig(&mut c, "port_base", AV_MEM, 1, rpio, 0, 0, 0, u);
  bsig(&mut c, "port_count", AV_MEM, 1, rpio, 0, 0, 0, u);
  bsig(&mut c, "pio_in8", AV_MEM, 2, mpio, u, 0, 0, u8t);
  bsig(&mut c, "pio_in16", AV_MEM, 2, mpio, u, 0, 0, u16t);
  bsig(&mut c, "pio_in32", AV_MEM, 2, mpio, u, 0, 0, u32t);
  bsig(&mut c, "pio_out8", AV_MEM, 3, mpio, u, u8t, 0, un);
  bsig(&mut c, "pio_out16", AV_MEM, 3, mpio, u, u16t, 0, un);
  bsig(&mut c, "pio_out32", AV_MEM, 3, mpio, u, u32t, 0, un);
  bsig(&mut c, "mmio_claim", AV_MEM, 3, mmsp, u, u, 0, mio);
  bsig(&mut c, "mmio_release", AV_MEM, 2, mmsp, mio, 0, 0, un);
  bsig(&mut c, "mmio_base", AV_MEM, 1, rmio, 0, 0, 0, u);
  bsig(&mut c, "mmio_len", AV_MEM, 1, rmio, 0, 0, 0, u);
  bsig(&mut c, "mmio_read8", AV_MEM, 2, mmmio, u, 0, 0, u8t);
  bsig(&mut c, "mmio_read16", AV_MEM, 2, mmmio, u, 0, 0, u16t);
  bsig(&mut c, "mmio_read32", AV_MEM, 2, mmmio, u, 0, 0, u32t);
  bsig(&mut c, "mmio_read64", AV_MEM, 2, mmmio, u, 0, 0, u);
  bsig(&mut c, "mmio_write8", AV_MEM, 3, mmmio, u, u8t, 0, un);
  bsig(&mut c, "mmio_write16", AV_MEM, 3, mmmio, u, u16t, 0, un);
  bsig(&mut c, "mmio_write32", AV_MEM, 3, mmmio, u, u32t, 0, un);
  bsig(&mut c, "mmio_write64", AV_MEM, 3, mmmio, u, u, 0, un);
  bsig(&mut c, "dma_lend", AV_MEM, 1, frm, 0, 0, 0, dma);
  bsig(&mut c, "dma_take", AV_MEM, 1, dma, 0, 0, 0, frm);
  bsig(&mut c, "dma_id", AV_MEM, 1, rdma, 0, 0, 0, u);
  bsig(&mut c, "dma_addr", AV_MEM, 1, rdma, 0, 0, 0, u);
  bsig(&mut c, "dma_read8", AV_MEM, 2, mdma, u, 0, 0, u8t);
  bsig(&mut c, "dma_read16", AV_MEM, 2, mdma, u, 0, 0, u16t);
  bsig(&mut c, "dma_read32", AV_MEM, 2, mdma, u, 0, 0, u32t);
  bsig(&mut c, "dma_read64", AV_MEM, 2, mdma, u, 0, 0, u);
  bsig(&mut c, "dma_write8", AV_MEM, 3, mdma, u, u8t, 0, un);
  bsig(&mut c, "dma_write16", AV_MEM, 3, mdma, u, u16t, 0, un);
  bsig(&mut c, "dma_write32", AV_MEM, 3, mdma, u, u32t, 0, un);
  bsig(&mut c, "dma_write64", AV_MEM, 3, mdma, u, u, 0, un);
  bsig(&mut c, "sys_spawn", AV_USER, 3, rbuf, u, u, 0, u);
  bsig(&mut c, "sys_wait", AV_USER, 1, u, 0, 0, 0, u);
  bsig(&mut c, "sys_kill", AV_USER, 1, u, 0, 0, 0, u);
  bsig(&mut c, "sys_yield", AV_USER, 0, 0, 0, 0, 0, un);
  bsig(&mut c, "sys_getpid", AV_USER, 0, 0, 0, 0, 0, u);
  bsig(&mut c, "sys_info", AV_USER, 1, u, 0, 0, 0, u);
  bsig(&mut c, "sys_ps", AV_USER, 0, 0, 0, 0, 0, un);
  bsig(&mut c, "sys_poweroff", AV_USER, 0, 0, 0, 0, 0, un);
  bsig(&mut c, "sys_call", AV_USER, 3, u, u, u, 0, u);
  bsig(&mut c, "sys_send", AV_USER, 4, u, u, rbyt, u, u);
  bsig(&mut c, "sys_recv", AV_USER, 3, u, u, mbyt, 0, u);
  ghost(&mut c, "frame_id", frm, false, u);
  ghost(&mut c, "pt_id", ptb, false, u);
  ghost(&mut c, "pt_level", ptb, false, u);
  ghost(&mut c, "pt_used", ptb, true, b);
  ghost(&mut c, "pt_leases", ptb, false, u);
  ghost(&mut c, "pool_has", pol, true, b);
  ghost(&mut c, "pool_size", pol, false, u);
  ghost(&mut c, "mmu_root", mmu, false, u);
  ghost(&mut c, "port_base", pio, false, u);
  ghost(&mut c, "port_count", pio, false, u);
  ghost(&mut c, "port_free", prt, true, b);
  ghost(&mut c, "mmio_base", mio, false, u);
  ghost(&mut c, "mmio_len", mio, false, u);
  ghost(&mut c, "mmio_free", msp, true, b);
  ghost(&mut c, "dma_id", dma, false, u);
  field_types(&mut c, &mut m, p);
  return c;
}

/// Fills in `fstart` and `ftys` for every struct and enum instance.
fn field_types(c: &mut Checker, m: &mut Mono, p: &Parser) {
  let mut k = 0;
  while k < vec_len(m.insts) {
    vec_push(&mut c.fstart, 0);
    k = k + 1;
  }
  k = 0;
  while k < ndefs(m) {
    let x = def_at(m, k);
    if x < vec_len(c.fstart) {
      vec_set(&mut c.fstart, x, vec_len(c.ftys) + 1);
    }
    let xi = inst_at(m, x);
    let dn = node_at(p.nodes, xi.def);
    let mut f = dn.a;
    while f != 0 {
      let fd = node_at(p.nodes, f);
      let mut t = 0;
      if fd.a != 0 {
        t = conv(&mut m, p, fd.a, x, xi.def);
      }
      vec_push(&mut c.ftys, t);
      f = fd.next;
    }
    k = k + 1;
  }
}

/// The number of struct and enum instances.
fn ndefs(m: &Mono) -> u64 {
  if vec_len(m.structs) > SRC_MAX || vec_len(m.enums) > SRC_MAX {
    return 0;
  }
  return vec_len(m.structs) + vec_len(m.enums);
}

/// The k-th struct or enum instance of the program: the structs, then the enums.
fn def_at(m: &Mono, k: u64) -> u64 {
  let ns = vec_len(m.structs);
  if k < ns {
    return vec_get(m.structs, k);
  }
  if k - ns < vec_len(m.enums) {
    return vec_get(m.enums, k - ns);
  }
  return 0;
}

// ---- Small helpers ----

fn u_at(v: &Vec[u64], i: u64) -> u64 {
  if i < vec_len(v) {
    return vec_get(v, i);
  }
  return 0;
}

fn has_id(v: &Vec[u64], x: u64) -> bool {
  let mut k = 0;
  while k < vec_len(v) {
    if vec_get(v, k) == x {
      return true;
    }
    k = k + 1;
  }
  return false;
}

fn copy_set(v: &Vec[u64]) -> Vec[u64] {
  let mut out = vec_new[u64]();
  let mut k = 0;
  while k < vec_len(v) {
    vec_push(&mut out, vec_get(v, k));
    k = k + 1;
  }
  return out;
}

/// Do `a` and `b` (vectors without repeats) hold the same elements?
fn same_set(a: &Vec[u64], b: &Vec[u64]) -> bool {
  if vec_len(a) != vec_len(b) {
    return false;
  }
  let mut k = 0;
  while k < vec_len(a) {
    if !has_id(b, vec_get(a, k)) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

fn add_id(v: &mut Vec[u64], x: u64) {
  if !has_id(v, x) {
    vec_push(&mut v, x);
  }
}

fn union_into(a: &mut Vec[u64], b: &Vec[u64]) {
  let mut k = 0;
  while k < vec_len(b) {
    add_id(&mut a, vec_get(b, k));
    k = k + 1;
  }
}

fn set_moved(c: &mut Checker, v: Vec[u64]) {
  let prev = c.moved;
  c.moved = v;
  vec_free(prev);
}

fn kind_t(m: &Mono, t: u64) -> u64 {
  let x = ty_at(m, t);
  return x.kind;
}

fn inner_t(m: &Mono, t: u64) -> u64 {
  let x = ty_at(m, t);
  return x.a;
}

fn ck_ref(m: &Mono, t: u64) -> bool {
  let k = kind_t(m, t);
  return k == TY_REF || k == TY_MUTREF;
}

/// The type with any borrow removed.
fn base_t(m: &Mono, t: u64) -> u64 {
  if ck_ref(m, t) {
    return inner_t(m, t);
  }
  return t;
}

/// Is `t` a signed integer type (`i8`, `i16`, `i32` or `i64`)?
fn is_signed(m: &Mono, t: u64) -> bool {
  let k = kind_t(m, t);
  return k == TY_I8 || k == TY_I16 || k == TY_I32 || k == TY_I64;
}

/// Is `t` an integer type (`u8` .. `u64` or `i8` .. `i64`)?
fn is_int(m: &Mono, t: u64) -> bool {
  let k = kind_t(m, t);
  return k == TY_U64 || k == TY_U8 || k == TY_U16 || k == TY_U32 || is_signed(m, t);
}

/// Is node `i` an integer literal: `v`, or `-v`, which is the literal -v?
fn is_lit(p: &Parser, i: u64) -> bool {
  let n = node_at(p.nodes, i);
  return n.kind == E_INT || (n.kind == E_NEG && kind_of(p, n.a) == E_INT);
}

/// Does the literal value `v` (negated when `neg`) fit in the integer type
/// `t`? (Every literal fits in `u64`: the lexer allows no more.)
fn lit_fits(m: &Mono, v: u64, neg: bool, t: u64) -> bool {
  let k = kind_t(m, t);
  if neg && v != 0 {
    if k == TY_I8 { return v <= 128; }
    if k == TY_I16 { return v <= 32768; }
    if k == TY_I32 { return v <= 2147483648; }
    if k == TY_I64 { return v <= 9223372036854775808; }
    return false;
  }
  if k == TY_U8 { return v <= 255; }
  if k == TY_U16 { return v <= 65535; }
  if k == TY_U32 { return v <= 4294967295; }
  if k == TY_I8 { return v <= 127; }
  if k == TY_I16 { return v <= 32767; }
  if k == TY_I32 { return v <= 2147483647; }
  if k == TY_I64 { return v <= 9223372036854775807; }
  return true;
}

/// In a specification every integer is just a number, whatever its type.
fn spec_norm(c: &Checker, m: &Mono, t: u64) -> u64 {
  if is_int(m, t) {
    return c.tu64;
  }
  return t;
}

/// The j-th field (or payload) type of instance `x`.
fn fld_ty(c: &Checker, x: u64, j: u64) -> u64 {
  let st = u_at(c.fstart, x);
  if st == 0 || st > SRC_MAX || j > SRC_MAX {
    return 0;
  }
  return u_at(c.ftys, st - 1 + j);
}

/// The index + 1 of the node named `s..e` in the list from `head`, or 0.
fn index_in(p: &Parser, head: u64, s: u64, e: u64) -> u64 {
  let mut k = head;
  let mut j = 0;
  while k != 0 && j < SRC_MAX {
    let n = node_at(p.nodes, k);
    if same(p.src, n.s, n.e, s, e) {
      return j + 1;
    }
    k = n.next;
    j = j + 1;
  }
  return 0;
}

fn def_node(m: &Mono, p: &Parser, x: u64) -> Node {
  let xi = inst_at(m, x);
  return node_at(p.nodes, xi.def);
}

/// Is a value of type `t` linear (must it be consumed exactly once)?
fn ck_linear(c: &Checker, m: &Mono, p: &Parser, t: u64) -> bool {
  let k = kind_t(m, t);
  if (k >= TY_BUF && k <= TY_DMA) || k == TY_LEASE || k == TY_BOX || k == TY_VEC || k == TY_LOCK || k == TY_ATOMIC {
    return true;
  }
  if k == TY_STRUCT || k == TY_ENUM {
    let x = inner_t(m, t);
    let dn = def_node(m, p, x);
    let n = list_len(p, dn.a);
    let mut j = 0;
    while j < n {
      let ft = fld_ty(c, x, j);
      if ft != 0 && ck_linear(c, m, p, ft) {
        return true;
      }
      j = j + 1;
    }
  }
  return false;
}

/// Is a value of type `t` pinned: does it hold a `Cpu`, `Mmu` or `Lease`,
/// which describe the processor that holds them and may never reach another one?
fn is_pinned(c: &Checker, m: &Mono, p: &Parser, t: u64) -> bool {
  let k = kind_t(m, t);
  if k == TY_MMU || k == TY_CPU || k == TY_LEASE {
    return true;
  }
  if k == TY_BOX || k == TY_VEC || k == TY_LOCK || k == TY_ATOMIC || k == TY_REF || k == TY_MUTREF {
    return is_pinned(c, m, p, inner_t(m, t));
  }
  if k == TY_STRUCT || k == TY_ENUM {
    let x = inner_t(m, t);
    let dn = def_node(m, p, x);
    let n = list_len(p, dn.a);
    let mut j = 0;
    while j < n {
      let ft = fld_ty(c, x, j);
      if ft != 0 && is_pinned(c, m, p, ft) {
        return true;
      }
      j = j + 1;
    }
  }
  return false;
}

/// Records an error at node `loc`, unless one is recorded already.
fn cfail(c: &mut Checker, p: &Parser, loc: u64, code: u64) {
  if !c.failed {
    let n = node_at(p.nodes, loc);
    c.failed = true;
    c.efile = n.file;
    c.eline = n.line;
    c.ecol = n.col;
    c.ecode = code;
  }
}

// ---- Messages ----
//
// The sentence after the code and the hints, as bastioc0 words them. Only
// the first error is reported, so a message is written only by the call
// that records the error: `cm_new` records it and says whether it did.

/// Records an error at node `loc` with `code`, as `cfail` does; true when
/// it is the first, so the caller goes on to write its sentence.
fn cm_new(c: &mut Checker, p: &Parser, loc: u64, code: u64) -> bool {
  if c.failed {
    return false;
  }
  cfail(&mut c, p, loc, code);
  return true;
}

/// Appends `s` to the sentence.
fn cm_s(c: &mut Checker, s: Str) {
  let mut k = 0;
  while k < slen(s)
    invariant k <= slen(s)
  {
    vec_push(&mut c.emsg, cast[u64](sget(s, k)));
    k = k + 1;
  }
}

/// Appends the source text `s..e`.
fn cm_src(c: &mut Checker, p: &Parser, s: u64, e: u64) {
  let mut k = s;
  while k < e && k < blen(p.src) {
    vec_push(&mut c.emsg, cast[u64](bget(p.src, k)));
    k = k + 1;
  }
}

/// Appends the name of node `i`.
fn cm_name(c: &mut Checker, p: &Parser, i: u64) {
  let n = node_at(p.nodes, i);
  cm_src(&mut c, p, n.s, n.e);
}

/// Appends the second name of node `i` (a variant's, after `Enum::`).
fn cm_name2(c: &mut Checker, p: &Parser, i: u64) {
  let n = node_at(p.nodes, i);
  cm_src(&mut c, p, n.s2, n.e2);
}

fn cm_num(c: &mut Checker, x: u64) {
  let mut digs = vec_new[u64]();
  let mut y = x;
  vec_push(&mut digs, 48 + y % 10);
  y = y / 10;
  while y > 0 {
    vec_push(&mut digs, 48 + y % 10);
    y = y / 10;
  }
  let mut k = vec_len(digs);
  while k > 0 {
    k = k - 1;
    vec_push(&mut c.emsg, u_at(digs, k));
  }
  vec_free(digs);
}

/// Appends the name of type `t`, as stage0's `Type::name`.
fn cm_ty(c: &mut Checker, m: &Mono, p: &Parser, t: u64) {
  let x = ty_at(m, t);
  let k = x.kind;
  if k == TY_U64 { cm_s(&mut c, "u64"); }
  else if k == TY_U8 { cm_s(&mut c, "u8"); }
  else if k == TY_U16 { cm_s(&mut c, "u16"); }
  else if k == TY_U32 { cm_s(&mut c, "u32"); }
  else if k == TY_I8 { cm_s(&mut c, "i8"); }
  else if k == TY_I16 { cm_s(&mut c, "i16"); }
  else if k == TY_I32 { cm_s(&mut c, "i32"); }
  else if k == TY_I64 { cm_s(&mut c, "i64"); }
  else if k == TY_BOOL { cm_s(&mut c, "bool"); }
  else if k == TY_UNIT { cm_s(&mut c, "()"); }
  else if k == TY_STR { cm_s(&mut c, "Str"); }
  else if k == TY_BUF { cm_s(&mut c, "Buf"); }
  else if k == TY_BYTES { cm_s(&mut c, "Bytes"); }
  else if k == TY_HOST { cm_s(&mut c, "Host"); }
  else if k == TY_CHILD { cm_s(&mut c, "Child"); }
  else if k == TY_SERIAL { cm_s(&mut c, "Serial"); }
  else if k == TY_FRAME { cm_s(&mut c, "Frame"); }
  else if k == TY_PT { cm_s(&mut c, "PageTable"); }
  else if k == TY_POOL { cm_s(&mut c, "Pool"); }
  else if k == TY_MMU { cm_s(&mut c, "Mmu"); }
  else if k == TY_CPU { cm_s(&mut c, "Cpu"); }
  else if k == TY_PORTS { cm_s(&mut c, "Ports"); }
  else if k == TY_PORTIO { cm_s(&mut c, "PortIo"); }
  else if k == TY_MMIOSPACE { cm_s(&mut c, "MmioSpace"); }
  else if k == TY_MMIO { cm_s(&mut c, "Mmio"); }
  else if k == TY_DMA { cm_s(&mut c, "Dma"); }
  else if k == TY_LEASE { cm_s(&mut c, "Lease"); }
  else if k == TY_STRUCT || k == TY_ENUM { cm_inst(&mut c, m, p, x.a); }
  else if k == TY_UNKNOWN { cm_name(&mut c, p, x.a); }
  else if k == TY_BOX { cm_s(&mut c, "Box["); cm_ty(&mut c, m, p, x.a); cm_s(&mut c, "]"); }
  else if k == TY_VEC { cm_s(&mut c, "Vec["); cm_ty(&mut c, m, p, x.a); cm_s(&mut c, "]"); }
  else if k == TY_LOCK { cm_s(&mut c, "Lock["); cm_ty(&mut c, m, p, x.a); cm_s(&mut c, "]"); }
  else if k == TY_ATOMIC { cm_s(&mut c, "Atomic["); cm_ty(&mut c, m, p, x.a); cm_s(&mut c, "]"); }
  else if k == TY_REF { cm_s(&mut c, "&"); cm_ty(&mut c, m, p, x.a); }
  else if k == TY_MUTREF { cm_s(&mut c, "&mut "); cm_ty(&mut c, m, p, x.a); }
}

/// Appends the name of instance `x`: `Pair[u64, Buf]`, or `Rect`.
fn cm_inst(c: &mut Checker, m: &Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  cm_name(&mut c, p, xi.def);
  if xi.n > 0 && xi.args < SRC_MAX {
    cm_s(&mut c, "[");
    let mut j = 0;
    while j < xi.n && j < SRC_MAX
      invariant j <= SRC_MAX
    {
      if j > 0 {
        cm_s(&mut c, ", ");
      }
      cm_ty(&mut c, m, p, targ_at(m, xi.args + j));
      j = j + 1;
    }
    cm_s(&mut c, "]");
  }
}

/// ` must be WANT, found GOT`, the end of a type mismatch.
fn cm_must(c: &mut Checker, m: &Mono, p: &Parser, want: u64, got: u64) {
  cm_s(&mut c, " must be ");
  cm_ty(&mut c, m, p, want);
  cm_s(&mut c, ", found ");
  cm_ty(&mut c, m, p, got);
}

/// Appends the text of place `k` (`x.f.g`) to `buf`.
fn cm_place_to(c: &Checker, p: &Parser, k: u64, buf: &mut Vec[u64]) {
  let mut chain = vec_new[u64]();
  let mut q = k;
  while q != 0 && vec_len(chain) < SRC_MAX {
    vec_push(&mut chain, q);
    let x = path_at(c, q);
    q = x.up;
  }
  let mut j = vec_len(chain);
  while j > 0 {
    j = j - 1;
    let x = path_at(c, u_at(chain, j));
    let mut i = x.s;
    while i < x.e && i < blen(p.src) {
      vec_push(&mut buf, cast[u64](bget(p.src, i)));
      i = i + 1;
    }
    if j > 0 {
      vec_push(&mut buf, 46);
    }
  }
  vec_free(chain);
}

/// Appends the text of place `k`.
fn cm_place(c: &mut Checker, p: &Parser, k: u64) {
  let mut buf = vec_new[u64]();
  cm_place_to(c, p, k, &mut buf);
  let mut j = 0;
  while j < vec_len(buf) {
    vec_push(&mut c.emsg, vec_get(buf, j));
    j = j + 1;
  }
  vec_free(buf);
}

/// Does the text of place `a` sort before that of place `b`?
fn cm_place_lt(c: &Checker, p: &Parser, a: u64, b: u64) -> bool {
  let mut ta = vec_new[u64]();
  let mut tb = vec_new[u64]();
  cm_place_to(c, p, a, &mut ta);
  cm_place_to(c, p, b, &mut tb);
  let mut j = 0;
  let mut r = 0;
  while r == 0 && j < vec_len(ta) && j < vec_len(tb) {
    let x = vec_get(ta, j);
    let y = vec_get(tb, j);
    if x < y {
      r = 1;
    } else if x > y {
      r = 2;
    }
    j = j + 1;
  }
  if r == 0 && vec_len(ta) < vec_len(tb) {
    r = 1;
  }
  vec_free(ta);
  vec_free(tb);
  return r == 1;
}

/// Sorts the places in `v` by their text.
fn cm_sort(c: &Checker, p: &Parser, v: &mut Vec[u64]) {
  let mut i = 1;
  while i < vec_len(v) {
    let mut j = i;
    while j > 0 && j < vec_len(v) && cm_place_lt(c, p, vec_get(v, j), vec_get(v, j - 1)) {
      let x = vec_get(v, j);
      vec_set(&mut v, j, vec_get(v, j - 1));
      vec_set(&mut v, j - 1, x);
      j = j - 1;
    }
    i = i + 1;
  }
}

/// Appends the places in `v`, sorted, joined by "`, `".
fn cm_places(c: &mut Checker, p: &Parser, v: &Vec[u64]) {
  let mut w = copy_set(v);
  cm_sort(c, p, &mut w);
  let mut j = 0;
  while j < vec_len(w) {
    if j > 0 {
      cm_s(&mut c, "`, `");
    }
    cm_place(&mut c, p, vec_get(w, j));
    j = j + 1;
  }
  vec_free(w);
}

/// "`A` is consumed in only ...": the places in `a` or `b` but not both.
fn cm_symdiff(c: &mut Checker, p: &Parser, a: &Vec[u64], b: &Vec[u64]) {
  let mut d = vec_new[u64]();
  let mut j = 0;
  while j < vec_len(a) {
    if !has_id(b, vec_get(a, j)) {
      add_id(&mut d, vec_get(a, j));
    }
    j = j + 1;
  }
  j = 0;
  while j < vec_len(b) {
    if !has_id(a, vec_get(b, j)) {
      add_id(&mut d, vec_get(b, j));
    }
    j = j + 1;
  }
  cm_s(&mut c, "`");
  cm_places(&mut c, p, d);
  cm_s(&mut c, "`");
  vec_free(d);
}

/// The first, by text, of the moved places strictly inside place `k`, or 0.
fn cm_desc_first(c: &Checker, p: &Parser, k: u64) -> u64 {
  let mut best = 0;
  let mut j = 0;
  while j < vec_len(c.moved) {
    let q = vec_get(c.moved, j);
    if inside(c, q, k) && (best == 0 || cm_place_lt(c, p, q, best)) {
      best = q;
    }
    j = j + 1;
  }
  return best;
}

/// Adds the hint line `  = s`.
fn cm_note(c: &mut Checker, s: Str) {
  let msg = c.emsg;
  c.emsg = vec_new[u64]();
  cm_s(&mut c, "  = ");
  cm_s(&mut c, s);
  cm_s(&mut c, "\n");
  cm_take_note(&mut c, msg);
}

/// The sentence written since `msg` was set aside becomes a hint line;
/// `msg` is the sentence again.
fn cm_take_note(c: &mut Checker, msg: Vec[u64]) {
  let line = c.emsg;
  c.emsg = msg;
  let mut j = 0;
  while j < vec_len(line) {
    vec_push(&mut c.enotes, vec_get(line, j));
    j = j + 1;
  }
  vec_free(line);
}

/// The hint stage0's `in_copy` adds to an error in instance `x` of a
/// generic function.
fn cm_in_copy(c: &mut Checker, m: &Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  if xi.n == 0 {
    return;
  }
  let msg = c.emsg;
  c.emsg = vec_new[u64]();
  cm_s(&mut c, "  = in `");
  cm_inst(&mut c, m, p, x);
  cm_s(&mut c, "`, the copy of a generic function for these type arguments\n");
  cm_take_note(&mut c, msg);
}

/// The hint on a value left owned.
fn cm_note_consume(c: &mut Checker) {
  cm_note(&mut c, "every linear value must be consumed exactly once: return it, pass it to a function that takes it by value, or `free` it");
}

/// The text of operator `op`.
fn cm_op(c: &mut Checker, op: u64) {
  if op == P_IMPLIES { cm_s(&mut c, "==>"); }
  else if op == P_EQEQ { cm_s(&mut c, "=="); }
  else if op == P_NE { cm_s(&mut c, "!="); }
  else if op == P_LE { cm_s(&mut c, "<="); }
  else if op == P_GE { cm_s(&mut c, ">="); }
  else if op == P_ANDAND { cm_s(&mut c, "&&"); }
  else if op == P_OROR { cm_s(&mut c, "||"); }
  else if op == P_PLUS { cm_s(&mut c, "+"); }
  else if op == P_MINUS { cm_s(&mut c, "-"); }
  else if op == P_STAR { cm_s(&mut c, "*"); }
  else if op == P_SLASH { cm_s(&mut c, "/"); }
  else if op == P_PERCENT { cm_s(&mut c, "%"); }
  else if op == P_LT { cm_s(&mut c, "<"); }
  else if op == P_GT { cm_s(&mut c, ">"); }
  else if op == P_AMP { cm_s(&mut c, "&"); }
  else if op == P_PIPE { cm_s(&mut c, "|"); }
  else if op == P_CARET { cm_s(&mut c, "^"); }
  else if op == P_SHL { cm_s(&mut c, "<<"); }
  else if op == P_SHR { cm_s(&mut c, ">>"); }
}

/// Records a type mismatch at `loc` unless `got` is `want`; true when the
/// caller is to write what must have type `want`, then `cm_must`.
fn cm_mismatch(c: &mut Checker, p: &Parser, got: u64, want: u64, loc: u64) -> bool {
  return got != want && cm_new(&mut c, p, loc, C_TYPE);
}

/// `WHAT must be WANT, found GOT` unless `got` is `want`.
fn expect_ty(c: &mut Checker, m: &Mono, p: &Parser, got: u64, want: u64, loc: u64, what: Str) {
  if cm_mismatch(&mut c, p, got, want, loc) {
    cm_s(&mut c, what);
    cm_must(&mut c, m, p, want, got);
  }
}

/// `E::V` for variant `v` (node `i`'s second name) of enum instance `x`.
fn cm_variant(c: &mut Checker, m: &Mono, p: &Parser, x: u64, i: u64) {
  cm_inst(&mut c, m, p, x);
  cm_s(&mut c, "::");
  cm_name2(&mut c, p, i);
}

// ---- Names ----

fn span_is(p: &Parser, s: u64, e: u64, w: Str) -> bool {
  if s <= e && e <= blen(p.src) {
    return spells(p.src, s, e, w);
  }
  return false;
}

fn bs_at(c: &Checker, k: u64) -> Bsig {
  if k < vec_len(c.bs) {
    return vec_get(c.bs, k);
  }
  return Bsig { name: "", avail: 0, np: 0, p0: 0, p1: 0, p2: 0, p3: 0, ret: 0 };
}

fn ghost_at(c: &Checker, k: u64) -> Ghost {
  if k < vec_len(c.ghosts) {
    return vec_get(c.ghosts, k);
  }
  return Ghost { name: "", arg: 0, idx: false, ret: 0 };
}

/// The builtin named `s..e` in the table: its index + 1, or 0.
fn bs_index(c: &Checker, p: &Parser, s: u64, e: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(c.bs) {
    let b = vec_get(c.bs, k);
    if span_is(p, s, e, b.name) {
      return k + 1;
    }
    k = k + 1;
  }
  return 0;
}

fn ghost_index(c: &Checker, p: &Parser, s: u64, e: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(c.ghosts) {
    let g = vec_get(c.ghosts, k);
    if span_is(p, s, e, g.name) {
      return k + 1;
    }
    k = k + 1;
  }
  return 0;
}

fn is_vec_builtin(p: &Parser, s: u64, e: u64) -> bool {
  return span_is(p, s, e, "vec_new") || span_is(p, s, e, "vec_len") || span_is(p, s, e, "vec_push")
    || span_is(p, s, e, "vec_pop") || span_is(p, s, e, "vec_get") || span_is(p, s, e, "vec_set")
    || span_is(p, s, e, "vec_swap") || span_is(p, s, e, "vec_free");
}

/// Wrapping arithmetic: both operands and the result have one integer type.
fn is_wrap_builtin(p: &Parser, s: u64, e: u64) -> bool {
  return span_is(p, s, e, "wrap_add") || span_is(p, s, e, "wrap_sub") || span_is(p, s, e, "wrap_mul");
}

/// The builtins over `Lock[T]`: generic, so checked by hand like `box`.
fn is_lock_builtin(p: &Parser, s: u64, e: u64) -> bool {
  return span_is(p, s, e, "lock_new") || span_is(p, s, e, "lock_end") || span_is(p, s, e, "locked");
}

/// The builtins over `Atomic[T]`: generic too.
fn is_atomic_builtin(p: &Parser, s: u64, e: u64) -> bool {
  return span_is(p, s, e, "atomic_new") || span_is(p, s, e, "atomic_end") || span_is(p, s, e, "atomic_load")
    || span_is(p, s, e, "atomic_store") || span_is(p, s, e, "atomic_swap") || span_is(p, s, e, "atomic_cas")
    || span_is(p, s, e, "atomic_wrap_add");
}

/// The builtins that lend a page table's child in place to a function they
/// name, like `locked`.
fn is_pt_borrow_builtin(p: &Parser, s: u64, e: u64) -> bool {
  return span_is(p, s, e, "pt_borrow") || span_is(p, s, e, "pt_borrow_frame");
}

fn is_builtin_name(c: &Checker, p: &Parser, s: u64, e: u64) -> bool {
  return span_is(p, s, e, "box") || span_is(p, s, e, "unbox") || span_is(p, s, e, "cast") || span_is(p, s, e, "wrap")
    || span_is(p, s, e, "smp_run") || is_pt_borrow_builtin(p, s, e) || is_lock_builtin(p, s, e) || is_atomic_builtin(p, s, e)
    || is_vec_builtin(p, s, e) || is_wrap_builtin(p, s, e) || bs_index(c, p, s, e) != 0;
}

/// `result` and `old` belong to specifications.
fn is_spec_word(p: &Parser, s: u64, e: u64) -> bool {
  return span_is(p, s, e, "result") || span_is(p, s, e, "old");
}

/// The first function named `s..e`, when it is not generic; otherwise 0.
fn plain_fn(p: &Parser, s: u64, e: u64) -> u64 {
  let mut k = p.fns.head;
  while k != 0 {
    let n = node_at(p.nodes, k);
    if same(p.src, n.s, n.e, s, e) {
      if n.v != 0 {
        return 0;
      }
      return k;
    }
    k = n.next;
  }
  return 0;
}

/// Is `s..e` the name of a function with a signature (a builtin in the
/// table or a function that is not generic)?
fn sigs_has(c: &Checker, p: &Parser, s: u64, e: u64) -> bool {
  return bs_index(c, p, s, e) != 0 || plain_fn(p, s, e) != 0;
}

/// The visible spec fn named `s..e`, or 0.
fn find_spec(c: &Checker, p: &Parser, s: u64, e: u64) -> u64 {
  let mut k = p.specs.head;
  while k != 0 && k != c.spec_lim {
    let n = node_at(p.nodes, k);
    if same(p.src, n.s, n.e, s, e) {
      return k;
    }
    k = n.next;
  }
  return 0;
}

fn any_spec(p: &Parser, s: u64, e: u64) -> bool {
  return index_in(p, p.specs.head, s, e) != 0;
}

fn var_at(c: &Checker, j: u64) -> Var {
  if j < vec_len(c.vars) {
    return vec_get(c.vars, j);
  }
  return Var { s: 0, e: 0, path: 0, vty: 0, mutable: false };
}

/// The variable named `s..e` in scope: its index + 1, or 0.
fn find_var(c: &Checker, p: &Parser, s: u64, e: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(c.vars) {
    let v = vec_get(c.vars, k);
    if same(p.src, v.s, v.e, s, e) {
      return k + 1;
    }
    k = k + 1;
  }
  return 0;
}

fn is_bound(c: &Checker, p: &Parser, s: u64, e: u64) -> bool {
  let mut k = 0;
  while k < vec_len(c.bound) {
    let n = node_at(p.nodes, vec_get(c.bound, k));
    if same(p.src, n.s, n.e, s, e) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

/// Does `s..e` name the enum that instance `x` is an instance of? (A
/// generic enum may be written without its type arguments.)
fn names_enum(m: &Mono, p: &Parser, s: u64, e: u64, x: u64) -> bool {
  let d = def_node(m, p, x);
  return same(p.src, s, e, d.s, d.e);
}

// ---- Places ----

fn path_at(c: &Checker, k: u64) -> Path {
  if k < vec_len(c.paths) {
    return vec_get(c.paths, k);
  }
  return Path { up: 0, s: 0, e: 0 };
}

/// The place `up.s..e` (the variable `s..e` when `up` is 0).
fn ck_path(c: &mut Checker, p: &Parser, up: u64, s: u64, e: u64) -> u64 {
  let mut k = 1;
  while k < vec_len(c.paths) {
    let x = vec_get(c.paths, k);
    if x.up == up && same(p.src, x.s, x.e, s, e) {
      return k;
    }
    k = k + 1;
  }
  let n = vec_len(c.paths);
  vec_push(&mut c.paths, Path { up: up, s: s, e: e });
  return n;
}

/// The place expression `i` is (a variable or a field of one), or 0.
fn place_of(c: &mut Checker, p: &Parser, i: u64) -> u64 {
  let n = node_at(p.nodes, i);
  if n.kind == E_VAR {
    return ck_path(&mut c, p, 0, n.s, n.e);
  }
  if n.kind == E_FIELD {
    let b = place_of(&mut c, p, n.a);
    if b == 0 {
      return 0;
    }
    return ck_path(&mut c, p, b, n.s, n.e);
  }
  return 0;
}

/// The place a dotted list of names (`x.f.g`) spells.
fn list_path(c: &mut Checker, p: &Parser, head: u64) -> u64 {
  let mut k = head;
  let mut r = 0;
  while k != 0 {
    let n = node_at(p.nodes, k);
    r = ck_path(&mut c, p, r, n.s, n.e);
    k = n.next;
  }
  return r;
}

/// The variable place `k` starts from.
fn root_var(c: &Checker, p: &Parser, k: u64) -> Var {
  let mut q = k;
  let mut x = path_at(c, q);
  while x.up != 0 {
    q = x.up;
    x = path_at(c, q);
  }
  let v = find_var(c, p, x.s, x.e);
  if v == 0 {
    return var_at(c, vec_len(c.vars));
  }
  return var_at(c, v - 1);
}

fn in_moved(c: &Checker, k: u64) -> bool {
  return has_id(c.moved, k);
}

/// The moved place that `k` is or lies inside, or 0.
fn prefix_moved(c: &Checker, k: u64) -> u64 {
  let mut q = k;
  while q != 0 {
    if in_moved(c, q) {
      return q;
    }
    let x = path_at(c, q);
    q = x.up;
  }
  return 0;
}

/// Does place `a` lie strictly inside place `b`?
fn inside(c: &Checker, a: u64, b: u64) -> bool {
  let x = path_at(c, a);
  let mut q = x.up;
  while q != 0 {
    if q == b {
      return true;
    }
    let y = path_at(c, q);
    q = y.up;
  }
  return false;
}

/// Has a place strictly inside `k` been moved?
fn desc_moved(c: &Checker, k: u64) -> bool {
  let mut j = 0;
  while j < vec_len(c.moved) {
    if inside(c, vec_get(c.moved, j), k) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

fn overlaps(c: &Checker, a: u64, b: u64) -> bool {
  return a == b || inside(c, a, b) || inside(c, b, a);
}

fn mark(c: &mut Checker, k: u64) {
  add_id(&mut c.moved, k);
}

/// Place `k` holds a whole value again.
fn unmove(c: &mut Checker, k: u64) {
  let mut keep = vec_new[u64]();
  let mut j = 0;
  while j < vec_len(c.moved) {
    let q = vec_get(c.moved, j);
    if q != k && !inside(c, q, k) {
      vec_push(&mut keep, q);
    }
    j = j + 1;
  }
  set_moved(&mut c, keep);
}

/// The type at place `k`; errors are reported at node `loc`.
fn path_type(c: &mut Checker, m: &Mono, p: &Parser, k: u64, loc: u64) -> u64 {
  let x = path_at(c, k);
  if x.up == 0 {
    let v = find_var(c, p, x.s, x.e);
    if v == 0 {
      if cm_new(&mut c, p, loc, C_TYPE) {
        cm_s(&mut c, "unknown variable `");
        cm_src(&mut c, p, x.s, x.e);
        cm_s(&mut c, "`");
      }
      return 0;
    }
    let vr = var_at(c, v - 1);
    return base_t(m, vr.vty);
  }
  let t = path_type(&mut c, m, p, x.up, loc);
  if c.failed {
    return 0;
  }
  // A box is looked through: `b.f` is the field `f` of the boxed struct.
  let mut u = t;
  while kind_t(m, u) == TY_BOX {
    u = inner_t(m, u);
  }
  if kind_t(m, u) == TY_STRUCT {
    let y = inner_t(m, u);
    let dn = def_node(m, p, y);
    let j = index_in(p, dn.a, x.s, x.e);
    if j != 0 {
      return fld_ty(c, y, j - 1);
    }
  }
  if cm_new(&mut c, p, loc, C_TYPE) {
    cm_s(&mut c, "`");
    cm_place(&mut c, p, x.up);
    cm_s(&mut c, "` (");
    cm_ty(&mut c, m, p, u);
    cm_s(&mut c, ") has no field `");
    cm_src(&mut c, p, x.s, x.e);
    cm_s(&mut c, "`");
  }
  return 0;
}

/// A place used as a value: moved if it is linear, copied otherwise.
fn use_place(c: &mut Checker, m: &Mono, p: &Parser, k: u64, loc: u64) -> u64 {
  let t = path_type(&mut c, m, p, k, loc);
  if c.failed {
    return 0;
  }
  let vr = root_var(c, p, k);
  let pm = prefix_moved(c, k);
  if pm != 0 {
    if cm_new(&mut c, p, loc, C_USE) {
      cm_s(&mut c, "`");
      cm_place(&mut c, p, k);
      if pm == k {
        cm_s(&mut c, "` is used after it was consumed");
      } else {
        cm_s(&mut c, "` is used after `");
        cm_place(&mut c, p, pm);
        cm_s(&mut c, "` was consumed");
      }
    }
    return 0;
  }
  if ck_linear(c, m, p, t) {
    if kind_t(m, vr.vty) == TY_REF {
      if cm_new(&mut c, p, loc, C_USE) {
        cm_s(&mut c, "cannot move out of the shared borrow `");
        cm_place(&mut c, p, vr.path);
        cm_s(&mut c, "`");
      }
      return 0;
    }
    if desc_moved(c, k) {
      if cm_new(&mut c, p, loc, C_USE) {
        cm_s(&mut c, "`");
        cm_place(&mut c, p, k);
        cm_s(&mut c, "` is used after its field `");
        cm_place(&mut c, p, cm_desc_first(c, p, k));
        cm_s(&mut c, "` was moved out");
      }
      return 0;
    }
    mark(&mut c, k);
  }
  return t;
}

/// Is nothing left to own at place `k` (of type `t`)? It was moved, or
/// (for a struct) every linear field in it was.
fn consumed(c: &mut Checker, m: &Mono, p: &Parser, k: u64, t: u64) -> bool {
  if !ck_linear(c, m, p, t) || prefix_moved(c, k) != 0 {
    return true;
  }
  if kind_t(m, t) == TY_STRUCT {
    let x = inner_t(m, t);
    let dn = def_node(m, p, x);
    let mut f = dn.a;
    let mut j = 0;
    while f != 0 && j < SRC_MAX {
      let fd = node_at(p.nodes, f);
      let fk = ck_path(&mut c, p, k, fd.s, fd.e);
      if !consumed(&mut c, m, p, fk, fld_ty(c, x, j)) {
        return false;
      }
      f = fd.next;
      j = j + 1;
    }
    return true;
  }
  return false;
}

/// Adds the consumed linear leaves of place `k` (of type `t`) to `out`.
fn leaves(c: &mut Checker, m: &Mono, p: &Parser, k: u64, t: u64, out: &mut Vec[u64], depth: u64) {
  if depth > 1000 || !ck_linear(c, m, p, t) {
    return;
  }
  let kd = kind_t(m, t);
  if kd == TY_STRUCT {
    let x = inner_t(m, t);
    let dn = def_node(m, p, x);
    let mut f = dn.a;
    let mut j = 0;
    while f != 0 && j < SRC_MAX {
      let fd = node_at(p.nodes, f);
      let fk = ck_path(&mut c, p, k, fd.s, fd.e);
      leaves(&mut c, m, p, fk, fld_ty(c, x, j), &mut out, depth + 1);
      f = fd.next;
      j = j + 1;
    }
  } else if kd == TY_BOX && prefix_moved(c, k) == 0 {
    // The box itself is a resource, and so is what is inside it.
    leaves(&mut c, m, p, k, inner_t(m, t), &mut out, depth + 1);
  } else if prefix_moved(c, k) != 0 {
    add_id(&mut out, k);
  }
}

/// The consumed linear leaves of every variable in scope: the ownership
/// state, whether a struct was moved whole or field by field.
fn own_state(c: &mut Checker, m: &Mono, p: &Parser) -> Vec[u64] {
  let mut out = vec_new[u64]();
  let mut j = 0;
  while j < vec_len(c.vars) {
    let vr = var_at(c, j);
    if kind_t(m, vr.vty) != TY_REF {
      leaves(&mut c, m, p, vr.path, base_t(m, vr.vty), &mut out, 0);
    }
    j = j + 1;
  }
  return out;
}

/// No owned linear value may be left at `loc`, and every `&mut`
/// parameter must hold a value again. `when` says where `loc` is, for the
/// message.
fn leak_check_all(c: &mut Checker, m: &Mono, p: &Parser, loc: u64, when: Str) {
  let mut live = vec_new[u64]();
  let mut j = 0;
  while j < vec_len(c.vars) {
    let vr = var_at(c, j);
    if ck_linear(c, m, p, vr.vty) && !consumed(&mut c, m, p, vr.path, vr.vty) {
      vec_push(&mut live, vr.path);
    }
    j = j + 1;
  }
  if vec_len(live) > 0 {
    if cm_new(&mut c, p, loc, C_LEAK) {
      cm_s(&mut c, "`");
      cm_places(&mut c, p, live);
      cm_s(&mut c, "` is still owned ");
      cm_s(&mut c, when);
      cm_note_consume(&mut c);
    }
    vec_free(live);
    return;
  }
  j = 0;
  while j < vec_len(c.vars) {
    let vr = var_at(c, j);
    if kind_t(m, vr.vty) == TY_MUTREF && (prefix_moved(c, vr.path) != 0 || desc_moved(c, vr.path)) {
      vec_push(&mut live, vr.path);
    }
    j = j + 1;
  }
  if vec_len(live) > 0 && cm_new(&mut c, p, loc, C_USE) {
    cm_s(&mut c, "the borrowed `");
    cm_places(&mut c, p, live);
    cm_s(&mut c, "` must hold a value again ");
    cm_s(&mut c, when);
    cm_note(&mut c, "a `&mut` parameter can be moved out of, but the caller gets it back, so assign it a new value before returning");
  }
  vec_free(live);
}

/// The first variable declared from index `start` on that still owns a
/// value: its place, or 0.
fn scope_leaks(c: &mut Checker, m: &Mono, p: &Parser, start: u64) -> u64 {
  let mut j = start;
  while j < vec_len(c.vars) {
    let vr = var_at(c, j);
    if ck_linear(c, m, p, vr.vty) && !consumed(&mut c, m, p, vr.path, vr.vty) {
      return vr.path;
    }
    j = j + 1;
  }
  return 0;
}

/// "`x` goes out of scope while still owned", for place `k`, at `loc`;
/// true when it is the first error.
fn cm_scope_leak(c: &mut Checker, p: &Parser, loc: u64, k: u64) -> bool {
  if cm_new(&mut c, p, loc, C_LEAK) {
    cm_s(&mut c, "`");
    cm_place(&mut c, p, k);
    cm_s(&mut c, "` goes out of scope while still owned");
    return true;
  }
  return false;
}

/// Ends the scope of the variables from index `start` on.
fn pop_scope(c: &mut Checker, start: u64) {
  let mut j = start;
  while j < vec_len(c.vars) {
    let vr = var_at(c, j);
    unmove(&mut c, vr.path);
    j = j + 1;
  }
  while vec_len(c.vars) > start {
    vec_pop(&mut c.vars);
  }
}

fn declare(c: &mut Checker, p: &Parser, s: u64, e: u64, t: u64, mutable: bool, loc: u64) {
  if is_spec_word(p, s, e) {
    if cm_new(&mut c, p, loc, C_TYPE) {
      cm_s(&mut c, "`");
      cm_src(&mut c, p, s, e);
      cm_s(&mut c, "` is reserved for specifications");
    }
    return;
  }
  // A name may be reused once its earlier binding's scope has ended, but
  // never shadow one still in scope. Functions, spec fns and builtins live
  // apart: a call `f(..)` always means the function, so a local may share
  // its name.
  if find_var(c, p, s, e) != 0 {
    cm_shadow(&mut c, p, loc, s, e);
    return;
  }
  let k = ck_path(&mut c, p, 0, s, e);
  vec_push(&mut c.vars, Var { s: s, e: e, path: k, vty: t, mutable: mutable });
}

/// "`x` is already defined (shadowing is not allowed)" at `loc`.
fn cm_shadow(c: &mut Checker, p: &Parser, loc: u64, s: u64, e: u64) {
  if cm_new(&mut c, p, loc, C_TYPE) {
    cm_s(&mut c, "`");
    cm_src(&mut c, p, s, e);
    cm_s(&mut c, "` is already defined (shadowing is not allowed)");
  }
}

/// "`x` is not mutable (declare it with `mut`)" at `loc`, for variable place `k`.
fn cm_not_mut(c: &mut Checker, p: &Parser, loc: u64, k: u64) {
  if cm_new(&mut c, p, loc, C_TYPE) {
    cm_s(&mut c, "`");
    cm_place(&mut c, p, k);
    cm_s(&mut c, "` is not mutable (declare it with `mut`)");
  }
}

/// "`p` is used after `m` was consumed" at `loc`.
fn cm_used_after(c: &mut Checker, p: &Parser, loc: u64, k: u64, pm: u64) {
  if cm_new(&mut c, p, loc, C_USE) {
    cm_s(&mut c, "`");
    cm_place(&mut c, p, k);
    cm_s(&mut c, "` is used after `");
    cm_place(&mut c, p, pm);
    cm_s(&mut c, "` was consumed");
  }
}

/// "unknown type `T`" at `loc`.
fn cm_unknown_type(c: &mut Checker, m: &Mono, p: &Parser, loc: u64, t: u64) {
  if cm_new(&mut c, p, loc, C_TYPE) {
    cm_s(&mut c, "unknown type `");
    cm_ty(&mut c, m, p, t);
    cm_s(&mut c, "`");
  }
}

/// A type written in the program must name a known type.
fn known_type(c: &mut Checker, m: &Mono, p: &Parser, t: u64, loc: u64) {
  let k = kind_t(m, t);
  if k == TY_UNKNOWN {
    cm_unknown_type(&mut c, m, p, loc, t);
  } else if k == TY_BOX || k == TY_VEC || k == TY_LOCK || k == TY_ATOMIC || k == TY_REF || k == TY_MUTREF {
    known_type(&mut c, m, p, inner_t(m, t), loc);
  }
}

// ---- Definitions and signatures ----

fn is_reserved_type(p: &Parser, s: u64, e: u64) -> bool {
  return span_is(p, s, e, "u64") || span_is(p, s, e, "u8") || span_is(p, s, e, "u16")
    || span_is(p, s, e, "u32") || span_is(p, s, e, "i8") || span_is(p, s, e, "i16")
    || span_is(p, s, e, "i32") || span_is(p, s, e, "i64") || span_is(p, s, e, "bool") || span_is(p, s, e, "Str")
    || span_is(p, s, e, "Buf") || span_is(p, s, e, "Bytes") || span_is(p, s, e, "Host")
    || span_is(p, s, e, "Child") || span_is(p, s, e, "Serial") || span_is(p, s, e, "Frame")
    || span_is(p, s, e, "PageTable") || span_is(p, s, e, "Pool") || span_is(p, s, e, "Mmu")
    || span_is(p, s, e, "Cpu") || span_is(p, s, e, "Ports") || span_is(p, s, e, "PortIo")
    || span_is(p, s, e, "MmioSpace") || span_is(p, s, e, "Mmio") || span_is(p, s, e, "Dma")
    || span_is(p, s, e, "Lease") || span_is(p, s, e, "Lock") || span_is(p, s, e, "Atomic");
}

/// Struct and enum instances: no reserved names, known field and payload
/// types, no type that contains itself.
fn check_structs(c: &mut Checker, m: &Mono, p: &Parser) {
  let total = ndefs(m);
  let mut k = 0;
  while k < total && !c.failed {
    let x = def_at(m, k);
    let xi = inst_at(m, x);
    let d = node_at(p.nodes, xi.def);
    if xi.n == 0 && is_reserved_type(p, d.s, d.e) {
      if cm_new(&mut c, p, xi.def, C_TYPE) {
        cm_s(&mut c, "type `");
        cm_inst(&mut c, m, p, x);
        cm_s(&mut c, "` is already defined");
      }
      return;
    }
    let n = list_len(p, d.a);
    let mut j = 0;
    while j < n {
      let mut u = fld_ty(c, x, j);
      while kind_t(m, u) == TY_BOX || kind_t(m, u) == TY_VEC || kind_t(m, u) == TY_LOCK || kind_t(m, u) == TY_ATOMIC {
        u = inner_t(m, u);
      }
      if u != 0 && kind_t(m, u) == TY_UNKNOWN {
        cm_unknown_type(&mut c, m, p, xi.def, u);
        return;
      }
      j = j + 1;
    }
    k = k + 1;
  }
  k = 0;
  while k < total && !c.failed {
    let x = def_at(m, k);
    let mut seen = vec_new[u64]();
    let r = reaches(c, m, p, x, x, &mut seen);
    vec_free(seen);
    if r {
      let xi = inst_at(m, x);
      if cm_new(&mut c, p, xi.def, C_TYPE) {
        cm_s(&mut c, "type `");
        cm_inst(&mut c, m, p, x);
        cm_s(&mut c, "` contains itself");
        cm_note(&mut c, "a value cannot hold itself; put the recursive part in a `Box[..]`");
      }
    }
    k = k + 1;
  }
}

/// Does instance `from` hold `target` directly, or through types it holds
/// directly (not through a box or vector)?
fn reaches(c: &Checker, m: &Mono, p: &Parser, from: u64, target: u64, seen: &mut Vec[u64]) -> bool {
  let dn = def_node(m, p, from);
  let n = list_len(p, dn.a);
  let mut j = 0;
  while j < n {
    let ft = fld_ty(c, from, j);
    let k = kind_t(m, ft);
    if k == TY_STRUCT || k == TY_ENUM {
      let y = inner_t(m, ft);
      if y == target {
        return true;
      }
      if !has_id(seen, y) {
        vec_push(&mut seen, y);
        if reaches(c, m, p, y, target, &mut seen) {
          return true;
        }
      }
    }
    j = j + 1;
  }
  return false;
}

/// May `main` ask for a capability of kind `k` on this target?
fn is_cap(target: u64, k: u64) -> bool {
  if target == TARGET_USER {
    return k == TY_SERIAL;
  }
  if target == TARGET_KERNEL {
    return k == TY_SERIAL || k == TY_POOL || k == TY_MMU || k == TY_CPU || k == TY_PORTS || k == TY_MMIOSPACE;
  }
  return k == TY_SERIAL || k == TY_POOL || k == TY_HOST || k == TY_PORTS || k == TY_MMIOSPACE;
}

fn available(avail: u64, target: u64) -> bool {
  if avail == AV_ALL {
    return true;
  }
  if avail == AV_HOSTED {
    return target == TARGET_HOSTED;
  }
  if avail == AV_MEM {
    return target == TARGET_HOSTED || target == TARGET_KERNEL;
  }
  if avail == AV_KERNEL {
    return target == TARGET_KERNEL;
  }
  return target == TARGET_USER;
}

/// Function signatures: known types, no builtin redefined, no borrow
/// returned; and a `main` that suits the target.
fn signatures(c: &mut Checker, m: &mut Mono, p: &Parser) {
  let mut k = 0;
  while k < vec_len(m.fns) && !c.failed {
    let x = u_at(m.fns, k);
    let xi = inst_at(m, x);
    let d = node_at(p.nodes, xi.def);
    let mut q = d.a;
    while q != 0 && !c.failed {
      let qn = node_at(p.nodes, q);
      let t = conv(&mut m, p, qn.a, x, q);
      known_type(&mut c, m, p, t, q);
      q = qn.next;
    }
    if c.failed {
      return;
    }
    let r = conv(&mut m, p, d.b, x, xi.def);
    known_type(&mut c, m, p, r, xi.def);
    if c.failed {
      return;
    }
    if xi.n == 0 && (is_builtin_name(c, p, d.s, d.e) || ghost_index(c, p, d.s, d.e) != 0 || span_is(p, d.s, d.e, "old")) {
      if cm_new(&mut c, p, xi.def, C_TYPE) {
        cm_s(&mut c, "`");
        cm_name(&mut c, p, xi.def);
        cm_s(&mut c, "` is a builtin and cannot be redefined");
      }
    } else if xi.n == 0 && any_spec(p, d.s, d.e) {
      if cm_new(&mut c, p, xi.def, C_TYPE) {
        cm_s(&mut c, "function `");
        cm_name(&mut c, p, xi.def);
        cm_s(&mut c, "` is defined twice");
      }
    } else if ck_ref(m, r) {
      if cm_new(&mut c, p, xi.def, C_TYPE) {
        cm_s(&mut c, "a function cannot return a borrow");
      }
    }
    k = k + 1;
  }
  if c.failed {
    return;
  }
  check_exports(&mut c, &mut m, p);
  if c.failed {
    return;
  }
  k = 0;
  let mut main_x = 0;
  while k < vec_len(m.fns) && main_x == 0 {
    let x = u_at(m.fns, k);
    let xi = inst_at(m, x);
    if xi.n == 0 && name_is(p, xi.def, "main") {
      main_x = x;
    }
    k = k + 1;
  }
  if main_x == 0 {
    if !any_export(m, p) && cm_new(&mut c, p, 0, C_TYPE) {
      cm_s(&mut c, "no `main` function");     // only a library may lack one
    }
    return;
  }
  check_main(&mut c, &mut m, p, main_x);
}

// ---- The C boundary (`export fn`) ----

/// Is instance `x` an `export fn`? (Exported functions are never generic.)
fn exported_x(m: &Mono, p: &Parser, x: u64) -> bool {
  let xi = inst_at(m, x);
  let d = node_at(p.nodes, xi.def);
  return xi.n == 0 && d.e2 > d.s2;
}

fn any_export(m: &Mono, p: &Parser) -> bool {
  let mut k = 0;
  while k < vec_len(m.fns) {
    if exported_x(m, p, u_at(m.fns, k)) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

/// A type C can pass to an `export fn`: a number, or bytes it lends.
fn c_param_t(m: &Mono, t: u64) -> bool {
  let k = kind_t(m, t);
  if k == TY_REF || k == TY_MUTREF {
    return kind_t(m, inner_t(m, t)) == TY_BYTES;
  }
  return c_value_k(k);
}

/// A plain number C has a type for.
fn c_value_k(k: u64) -> bool {
  return k == TY_U64 || k == TY_U32 || k == TY_U16 || k == TY_U8 || k == TY_BOOL;
}

/// A type an `export fn` can return to C: numbers, owned bytes, and
/// structs and enums made only of those.
fn c_return_t(c: &Checker, m: &Mono, p: &Parser, t: u64) -> bool {
  let k = kind_t(m, t);
  if c_value_k(k) || k == TY_UNIT || k == TY_BYTES {
    return true;
  }
  if k == TY_STRUCT || k == TY_ENUM {
    let x = inner_t(m, t);
    let dn = def_node(m, p, x);
    let n = list_len(p, dn.a);
    let mut j = 0;
    while j < n {
      let ft = fld_ty(c, x, j);
      if ft != 0 && !c_return_t(c, m, p, ft) {
        return false;
      }
      j = j + 1;
    }
    return true;
  }
  return false;
}

/// Is `b` named like `a` followed by `_len`?
fn len_name_of(p: &Parser, a: Node, b: Node) -> bool {
  if !(a.s <= a.e && a.e - a.s < SRC_MAX && b.s <= b.e && b.e <= blen(p.src)) {
    return false;
  }
  if b.e - b.s != a.e - a.s + 4 {
    return false;
  }
  return same(p.src, a.s, a.e, b.s, b.e - 4) && spells(p.src, b.e - 4, b.e, "_len");
}

/// The rules of the C boundary, for every exported function in order.
fn check_exports(c: &mut Checker, m: &mut Mono, p: &Parser) {
  let mut k = 0;
  while k < vec_len(m.fns) && !c.failed {
    let x = u_at(m.fns, k);
    if exported_x(m, p, x) {
      check_export(&mut c, &mut m, p, x);
    }
    k = k + 1;
  }
}

fn check_export(c: &mut Checker, m: &mut Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  let d = node_at(p.nodes, xi.def);
  if c.target != TARGET_HOSTED {
    if cm_new(&mut c, p, xi.def, C_EXPORT) {
      cm_s(&mut c, "`export fn` is only supported on the hosted target");
    }
    return;
  }
  if name_is(p, xi.def, "main") {
    if cm_new(&mut c, p, xi.def, C_EXPORT) {
      cm_s(&mut c, "`main` cannot be exported");
    }
    return;
  }
  if d.s <= d.e && d.e <= blen(p.src) && d.e - d.s >= 4 && spells(p.src, d.s, d.s + 4, "bst_") {
    if cm_new(&mut c, p, xi.def, C_EXPORT) {
      cm_s(&mut c, "names starting with `bst_` are reserved for the runtime");
    }
    return;
  }
  if d.c != 0 {
    if cm_new(&mut c, p, d.c, C_EXPORT) {
      cm_s(&mut c, "`");
      cm_name(&mut c, p, xi.def);
      cm_s(&mut c, "` is exported, so it cannot have a precondition");
      cm_note(&mut c, "a C caller cannot be proved to meet it; check the condition in the function and return an error instead");
    }
    return;
  }
  let mut q = d.a;
  while q != 0 && !c.failed {
    let qn = node_at(p.nodes, q);
    let t = conv(&mut m, p, qn.a, x, q);
    if !c_param_t(m, t) {
      if cm_new(&mut c, p, q, C_EXPORT) {
        cm_s(&mut c, "a parameter of an exported function cannot have type `");
        cm_ty(&mut c, m, p, t);
        cm_s(&mut c, "`");
        cm_note(&mut c, "C can pass integers, `bool`, and `&Bytes` or `&mut Bytes` (a pointer and a length)");
      }
    } else if kind_t(m, base_t(m, t)) == TY_BYTES {
      let mut r = d.a;
      while r != 0 && !c.failed {
        let rn = node_at(p.nodes, r);
        if len_name_of(p, qn, rn) && cm_new(&mut c, p, q, C_EXPORT) {
          cm_s(&mut c, "the C length parameter of `");
          cm_name(&mut c, p, q);
          cm_s(&mut c, "` would be named `");
          cm_name(&mut c, p, q);
          cm_s(&mut c, "_len`, like another parameter");
        }
        r = rn.next;
      }
    }
    q = qn.next;
  }
  if c.failed {
    return;
  }
  let r = conv(&mut m, p, d.b, x, xi.def);
  if !c_return_t(c, m, p, r) && cm_new(&mut c, p, xi.def, C_EXPORT) {
    cm_s(&mut c, "an exported function cannot return `");
    cm_ty(&mut c, m, p, r);
    cm_s(&mut c, "`");
    cm_note(&mut c, "C can receive integers, `bool`, `Bytes`, and structs and enums made only of those");
  }
}

fn check_main(c: &mut Checker, m: &mut Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  let d = node_at(p.nodes, xi.def);
  let r = conv(&mut m, p, d.b, x, xi.def);
  let np = list_len(p, d.a);
  let mut legacy = false;
  if np == 1 {
    let q0 = node_at(p.nodes, d.a);
    let t0 = conv(&mut m, p, q0.a, x, d.a);
    legacy = kind_t(m, t0) == TY_SERIAL && kind_t(m, r) == TY_SERIAL;
  }
  let mut caps_ok = kind_t(m, r) == TY_U64 || kind_t(m, r) == TY_UNIT;
  let mut seen = vec_new[u64]();
  let mut q = d.a;
  while q != 0 && caps_ok {
    let qn = node_at(p.nodes, q);
    let t = conv(&mut m, p, qn.a, x, q);
    let ik = kind_t(m, inner_t(m, t));
    if kind_t(m, t) == TY_MUTREF && is_cap(c.target, ik) && !has_id(seen, ik) {
      vec_push(&mut seen, ik);
    } else {
      caps_ok = false;
    }
    q = qn.next;
  }
  vec_free(seen);
  if !(legacy && c.target != TARGET_USER) && !caps_ok {
    if cm_new(&mut c, p, xi.def, C_TYPE) {
      cm_s(&mut c, "on this target `main` must take some of ");
      if c.target == TARGET_USER {
        cm_s(&mut c, "&mut Serial");
      } else if c.target == TARGET_KERNEL {
        cm_s(&mut c, "&mut Serial, &mut Pool, &mut Mmu, &mut Cpu, &mut Ports, &mut MmioSpace");
      } else {
        cm_s(&mut c, "&mut Serial, &mut Pool, &mut Host, &mut Ports, &mut MmioSpace");
      }
      cm_s(&mut c, " (each at most once) and return u64 or nothing");
      cm_note(&mut c, "`fn main() -> u64` and, outside user programs, `fn main(con: Serial) -> Serial` are also accepted");
    }
  } else if c.target == TARGET_USER && kind_t(m, r) != TY_U64 {
    if cm_new(&mut c, p, xi.def, C_TYPE) {
      cm_s(&mut c, "a user program's `main` returns its exit code (u64)");
    }
  }
}

/// Starts checking a function (or spec fn) returning `ret`, in instance `env`.
fn reset(c: &mut Checker, ret: u64, env: u64) {
  while vec_len(c.vars) > 0 {
    vec_pop(&mut c.vars);
  }
  set_moved(&mut c, vec_new[u64]());
  while vec_len(c.bound) > 0 {
    vec_pop(&mut c.bound);
  }
  c.ret = ret;
  c.env = env;
  c.nparams = 0;
}

/// Checks the program monomorphized into `m`.
fn check_program(c: &mut Checker, m: &mut Mono, p: &Parser) {
  check_structs(&mut c, m, p);
  if c.failed {
    return;
  }
  signatures(&mut c, &mut m, p);
  let mut j = 0;
  while j < vec_len(m.specs) && !c.failed {
    // A spec fn may only call spec fns defined before it.
    let x = u_at(m.specs, j);
    let xi = inst_at(m, x);
    c.spec_lim = xi.def;
    c.spec_pos = j + 1;
    check_spec_fn(&mut c, &mut m, p, x);
    j = j + 1;
  }
  c.spec_lim = 0;
  c.spec_pos = 0;
  j = 0;
  while j < vec_len(m.structs) && !c.failed {
    check_struct_invariants(&mut c, &mut m, p, u_at(m.structs, j));
    j = j + 1;
  }
  j = 0;
  while j < vec_len(m.fns) && !c.failed {
    check_fn(&mut c, &mut m, p, u_at(m.fns, j));
    j = j + 1;
  }
  if !c.failed {
    lock_order(&mut c, m, p);
  }
}

/// Records that the instance being checked calls instance `x`.
fn note_call(c: &mut Checker, x: u64) {
  let mut j = 0;
  while j < vec_len(c.calls) {
    let e = vec_get(c.calls, j);
    if e.from == c.env && e.to == x {
      return;
    }
    j = j + 1;
  }
  vec_push(&mut c.calls, Edge { from: c.env, to: x });
}

/// Adds the edge `a -> b` to `v` unless it is there.
fn add_edge(v: &mut Vec[Edge], a: u64, b: u64) -> bool {
  let mut j = 0;
  while j < vec_len(v) {
    let e = vec_get(v, j);
    if e.from == a && e.to == b {
      return false;
    }
    j = j + 1;
  }
  vec_push(&mut v, Edge { from: a, to: b });
  return true;
}

/// Is class `to` reachable from class `from` along `order`?
fn class_reaches(order: &Vec[Edge], from: u64, to: u64) -> bool {
  let mut seen = vec_new[u64]();
  vec_push(&mut seen, from);
  let mut i = 0;
  let mut found = false;
  while i < vec_len(seen) && !found {
    let a = vec_get(seen, i);
    if a == to {
      found = true;
    }
    let mut j = 0;
    while j < vec_len(order) {
      let e = vec_get(order, j);
      if e.from == a && !has_u(seen, e.to) {
        vec_push(&mut seen, e.to);
      }
      j = j + 1;
    }
    i = i + 1;
  }
  vec_free(seen);
  return found;
}

fn has_u(v: &Vec[u64], x: u64) -> bool {
  let mut j = 0;
  while j < vec_len(v) {
    if vec_get(v, j) == x {
      return true;
    }
    j = j + 1;
  }
  return false;
}

/// Rules out deadlock through locks, as stage0's `lock_order` does: a
/// lock's class is the type of its contents; while `locked(l, f)` holds a
/// lock of class C, `f` and everything it calls may take only locks of other
/// classes, and the classes form no cycle.
fn lock_order(c: &mut Checker, m: &Mono, p: &Parser) {
  // takes: instance -> a class it may take, itself or through its callees.
  let mut takes = vec_new[Edge]();
  let mut j = 0;
  while j < vec_len(c.lsites) {
    let s = vec_get(c.lsites, j);
    add_edge(&mut takes, s.x, s.cls);
    j = j + 1;
  }
  let mut changed = true;
  while changed {
    changed = false;
    j = 0;
    while j < vec_len(c.calls) {
      let e = vec_get(c.calls, j);
      let mut k = 0;
      while k < vec_len(takes) {
        let t = vec_get(takes, k);
        if t.from == e.to && add_edge(&mut takes, e.from, t.to) {
          changed = true;
        }
        k = k + 1;
      }
      j = j + 1;
    }
  }
  // order: class C before class D when D can be taken while C is held.
  let mut order = vec_new[Edge]();
  j = 0;
  while j < vec_len(c.lsites) {
    let s = vec_get(c.lsites, j);
    let mut k = 0;
    while k < vec_len(takes) {
      let t = vec_get(takes, k);
      if t.from == s.f {
        add_edge(&mut order, s.cls, t.to);
      }
      k = k + 1;
    }
    j = j + 1;
  }
  j = 0;
  while j < vec_len(c.lsites) && !c.failed {
    let s = vec_get(c.lsites, j);
    let mut k = 0;
    while k < vec_len(takes) && !c.failed {
      let t = vec_get(takes, k);
      if t.from == s.f && class_reaches(order, t.to, s.cls) && cm_new(&mut c, p, s.node, C_LOCK_ORDER) {
        // The same class again, or a class taken elsewhere before this one.
        cm_s(&mut c, "`");
        cm_inst(&mut c, m, p, s.f);
        cm_s(&mut c, "` may take a lock of class ");
        if t.to == s.cls {
          cm_ty(&mut c, m, p, s.cls);
          cm_s(&mut c, " while this one, also of class ");
          cm_ty(&mut c, m, p, s.cls);
          cm_s(&mut c, ", is held");
          cm_note(&mut c, "a processor spins forever on a lock it already holds; two locks with the same contents type cannot be nested. Give them different contents types to order them");
        } else {
          cm_ty(&mut c, m, p, t.to);
          cm_s(&mut c, " while this lock of class ");
          cm_ty(&mut c, m, p, s.cls);
          cm_s(&mut c, " is held, but elsewhere ");
          cm_ty(&mut c, m, p, t.to);
          cm_s(&mut c, " is held while ");
          cm_ty(&mut c, m, p, s.cls);
          cm_s(&mut c, " is taken");
          cm_note(&mut c, "two processors taking them in opposite orders can wait for each other forever; take locks of these classes in one order everywhere");
        }
        cm_in_copy(&mut c, m, p, s.x);
      }
      k = k + 1;
    }
    j = j + 1;
  }
  vec_free(takes);
  vec_free(order);
}

fn check_spec_fn(c: &mut Checker, m: &mut Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  let k = xi.def;
  let sn = node_at(p.nodes, k);
  let generic = xi.n > 0;
  // An instance is named `G[..]`, which clashes with nothing (monomorphization
  // checked the name `G`).
  if !generic && (sigs_has(c, p, sn.s, sn.e) || ghost_index(c, p, sn.s, sn.e) != 0 || find_spec(c, p, sn.s, sn.e) != 0) {
    if cm_new(&mut c, p, k, C_TYPE) {
      cm_s(&mut c, "`");
      cm_name(&mut c, p, k);
      cm_s(&mut c, "` is already defined");
    }
    return;
  }
  let r = conv(&mut m, p, sn.b, x, k);
  if r != c.tbool && r != c.tu64 {
    if cm_new(&mut c, p, k, C_TYPE) {
      cm_s(&mut c, "a spec fn returns bool or u64");
    }
    return;
  }
  let mut env = 0;
  if generic {
    env = x;
  }
  reset(&mut c, c.tunit, env);
  let mut q = sn.a;
  while q != 0 && !c.failed {
    let qn = node_at(p.nodes, q);
    let t = conv(&mut m, p, qn.a, env, q);
    known_type(&mut c, m, p, t, q);
    if !c.failed && (ck_linear(c, m, p, t) || kind_t(m, t) == TY_MUTREF) && cm_new(&mut c, p, q, C_TYPE) {
      cm_s(&mut c, "spec fn parameters are values (`u64`, `bool`) or shared borrows (`&T`)");
    }
    declare(&mut c, p, qn.s, qn.e, t, false, q);
    q = qn.next;
  }
  if c.failed {
    return;
  }
  let t = ck_spec(&mut c, &mut m, p, sn.c, false);
  if !c.failed && cm_mismatch(&mut c, p, t, r, sn.c) {
    cm_s(&mut c, "the body of spec fn `");
    cm_callee(&mut c, m, p, k, env);
    cm_s(&mut c, "`");
    cm_must(&mut c, m, p, r, t);
  }
}

/// A struct's `invariant` clauses are specifications over its fields
/// (struct instance `x`).
fn check_struct_invariants(c: &mut Checker, m: &mut Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  let d = node_at(p.nodes, xi.def);
  if d.b == 0 {
    return;
  }
  reset(&mut c, c.tunit, x);
  let mut f = d.a;
  let mut j = 0;
  while f != 0 && !c.failed && j < SRC_MAX {
    let fd = node_at(p.nodes, f);
    declare(&mut c, p, fd.s, fd.e, fld_ty(c, x, j), false, xi.def);
    f = fd.next;
    j = j + 1;
  }
  let mut e = d.b;
  while e != 0 && !c.failed {
    let t = ck_spec(&mut c, &mut m, p, e, false);
    if !c.failed {
      expect_ty(&mut c, m, p, t, c.tbool, e, "a struct invariant");
    }
    e = next_of(p, e);
  }
}

fn check_fn(c: &mut Checker, m: &mut Mono, p: &Parser, x: u64) {
  check_fn_body(&mut c, &mut m, p, x);
  if c.failed {
    // Only reached when the error was found in this function.
    cm_in_copy(&mut c, m, p, x);
  }
}

fn check_fn_body(c: &mut Checker, m: &mut Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  let d = node_at(p.nodes, xi.def);
  let r = conv(&mut m, p, d.b, x, xi.def);
  reset(&mut c, r, x);
  let mut q = d.a;
  while q != 0 && !c.failed {
    let qn = node_at(p.nodes, q);
    let t = conv(&mut m, p, qn.a, x, q);
    if ck_ref(m, t) && qn.v == 1 && cm_new(&mut c, p, q, C_TYPE) {
      cm_s(&mut c, "a borrow cannot be `mut` (a `&mut` parameter is already assignable)");
    }
    declare(&mut c, p, qn.s, qn.e, t, qn.v == 1 || kind_t(m, t) == TY_MUTREF, q);
    q = qn.next;
  }
  c.nparams = vec_len(c.vars);
  let mut e = d.c;
  while e != 0 && !c.failed {
    let t = ck_spec(&mut c, &mut m, p, e, false);
    if !c.failed {
      expect_ty(&mut c, m, p, t, c.tbool, e, "a `requires` clause");
    }
    e = next_of(p, e);
  }
  e = d.d;
  while e != 0 && !c.failed {
    let t = ck_spec(&mut c, &mut m, p, e, true);
    if !c.failed {
      expect_ty(&mut c, m, p, t, c.tbool, e, "an `ensures` clause");
    }
    e = next_of(p, e);
  }
  if c.failed {
    return;
  }
  let div = ck_block(&mut c, &mut m, p, d.x);
  if !c.failed && !div {
    if kind_t(m, r) != TY_UNIT {
      if cm_new(&mut c, p, xi.def, C_TYPE) {
        cm_s(&mut c, "function `");
        cm_inst(&mut c, m, p, x);
        cm_s(&mut c, "` can reach its end without returning a ");
        cm_ty(&mut c, m, p, r);
      }
    } else {
      leak_check_all(&mut c, m, p, xi.def, "at the end of the function");
    }
  }
}

// ---- Statements ----

/// Checks a block; returns whether it always diverges (returns).
fn ck_block(c: &mut Checker, m: &mut Mono, p: &Parser, head: u64) -> bool {
  let start = vec_len(c.vars);
  let mut div = false;
  let mut k = head;
  let mut last = 0;
  while k != 0 && !c.failed {
    if div {
      if cm_new(&mut c, p, k, C_TYPE) {
        cm_s(&mut c, "unreachable statement after `return`");
      }
      return false;
    }
    div = ck_stmt(&mut c, &mut m, p, k);
    last = k;
    k = next_of(p, k);
  }
  if c.failed {
    return false;
  }
  let lk = scope_leaks(&mut c, m, p, start);
  if !div && lk != 0 {
    if cm_scope_leak(&mut c, p, last, lk) {
      cm_note_consume(&mut c);
    }
    return false;
  }
  pop_scope(&mut c, start);
  return div;
}

fn ck_stmt(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> bool {
  if c.failed {
    return false;
  }
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == S_LET {
    // A literal takes the type written, so that is read first.
    let mut want = 0;
    if n.a != 0 {
      want = conv(&mut m, p, n.a, c.env, i);
    }
    let t = ck_expr_as(&mut c, &mut m, p, n.b, want);
    if c.failed {
      return false;
    }
    if n.a != 0 {
      known_type(&mut c, m, p, want, i);
      if !c.failed && ck_ref(m, want) && cm_new(&mut c, p, i, C_TYPE) {
        cm_s(&mut c, "a local cannot hold a borrow");
      }
      if !c.failed && cm_mismatch(&mut c, p, t, want, n.b) {
        cm_s(&mut c, "the initializer of `");
        cm_name(&mut c, p, i);
        cm_s(&mut c, "`");
        cm_must(&mut c, m, p, want, t);
      }
      if c.failed {
        return false;
      }
    }
    if kind_t(m, t) == TY_UNIT {
      if cm_new(&mut c, p, n.b, C_TYPE) {
        cm_s(&mut c, "cannot bind a value of type ()");
      }
      return false;
    }
    vec_push(&mut m.lets, LetTy { env: c.env, node: i, lty: t });
    declare(&mut c, p, n.s, n.e, t, n.v == 1, i);
    return false;
  }
  if k == S_ASSIGN {
    let pk = list_path(&mut c, p, n.a);
    let want = path_type(&mut c, m, p, pk, i);
    if c.failed {
      return false;
    }
    let vr = root_var(c, p, pk);
    if !vr.mutable {
      cm_not_mut(&mut c, p, i, vr.path);
      return false;
    }
    let t = ck_expr_as(&mut c, &mut m, p, n.b, want);
    if !c.failed && cm_mismatch(&mut c, p, t, want, n.b) {
      cm_s(&mut c, "the value assigned to `");
      cm_place(&mut c, p, pk);
      cm_s(&mut c, "`");
      cm_must(&mut c, m, p, want, t);
    }
    if c.failed {
      return false;
    }
    let pa = path_at(c, pk);
    let pm = prefix_moved(c, pa.up);
    if pa.up != 0 && pm != 0 {
      if cm_new(&mut c, p, i, C_USE) {
        cm_s(&mut c, "cannot assign to `");
        cm_place(&mut c, p, pk);
        cm_s(&mut c, "`: `");
        cm_place(&mut c, p, pm);
        cm_s(&mut c, "` was consumed");
      }
      return false;
    }
    if ck_linear(c, m, p, want) {
      if !consumed(&mut c, m, p, pk, want) {
        if cm_new(&mut c, p, i, C_LEAK) {
          cm_s(&mut c, "assigning to `");
          cm_place(&mut c, p, pk);
          cm_s(&mut c, "` would drop the value it still owns");
          cm_note(&mut c, "consume the old value first, e.g. `b = set(b, i, v);` or move the field out before putting a new one in");
        }
        return false;
      }
      unmove(&mut c, pk);
    }
    return false;
  }
  if k == S_IF {
    return ck_if(&mut c, &mut m, p, i);
  }
  if k == S_WHILE {
    ck_while(&mut c, &mut m, p, i);
    return false;
  }
  if k == S_RETURN {
    let mut t = c.tunit;
    if n.a != 0 {
      t = ck_expr_as(&mut c, &mut m, p, n.a, c.ret);
    }
    if !c.failed {
      expect_ty(&mut c, m, p, t, c.ret, i, "the returned value");
    }
    if !c.failed {
      leak_check_all(&mut c, m, p, i, "at this `return`");
    }
    return true;
  }
  if k == S_UNREACHABLE {
    // Proved unreachable, so nothing owned here can leak.
    return true;
  }
  if k == S_ASSERT {
    let t = ck_spec(&mut c, &mut m, p, n.a, false);
    if !c.failed {
      expect_ty(&mut c, m, p, t, c.tbool, n.a, "an `assert`");
    }
    return false;
  }
  if k == S_MATCH {
    return ck_match(&mut c, &mut m, p, i);
  }
  if k == S_EXPR {
    let t = ck_expr(&mut c, &mut m, p, n.a);
    if !c.failed && ck_linear(c, m, p, t) && cm_new(&mut c, p, i, C_LEAK) {
      cm_s(&mut c, "this linear value is created and immediately dropped");
    }
    return false;
  }
  return false;
}

/// `if`: both branches must leave ownership the same way, unless one of
/// them diverges.
fn ck_if(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> bool {
  let n = node_at(p.nodes, i);
  let t = ck_expr(&mut c, &mut m, p, n.a);
  if !c.failed {
    expect_ty(&mut c, m, p, t, c.tbool, n.a, "an `if` condition");
  }
  if c.failed {
    return false;
  }
  let before = copy_set(c.moved);
  let d1 = ck_block(&mut c, &mut m, p, n.b);
  let after_then = copy_set(c.moved);
  set_moved(&mut c, before);
  let d2 = ck_block(&mut c, &mut m, p, n.c);
  if c.failed {
    vec_free(after_then);
    return false;
  }
  if d1 && d2 {
    vec_free(after_then);
    return true;
  }
  if d1 {
    vec_free(after_then);
    return false;
  }
  if d2 {
    set_moved(&mut c, after_then);
    return false;
  }
  let ce = own_state(&mut c, m, p);
  let after_else = copy_set(c.moved);
  set_moved(&mut c, copy_set(after_then));
  let ct = own_state(&mut c, m, p);
  if !same_set(ct, ce) && cm_new(&mut c, p, i, C_BRANCH) {
    cm_symdiff(&mut c, p, ct, ce);
    cm_s(&mut c, " is consumed in only one branch of this `if`");
  }
  let mut all = after_then;
  union_into(&mut all, after_else);
  set_moved(&mut c, all);
  vec_free(after_else);
  vec_free(ce);
  vec_free(ct);
  return false;
}

/// `while`: the condition consumes nothing, and the body leaves every outer
/// linear value owned as it found it.
fn ck_while(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) {
  let n = node_at(p.nodes, i);
  let before_cond = copy_set(c.moved);
  let t = ck_expr(&mut c, &mut m, p, n.a);
  let changed = !same_set(before_cond, c.moved);
  vec_free(before_cond);
  if c.failed {
    return;
  }
  if changed {
    if cm_new(&mut c, p, n.a, C_USE) {
      cm_s(&mut c, "a `while` condition runs many times, so it cannot consume a linear value");
    }
    return;
  }
  expect_ty(&mut c, m, p, t, c.tbool, n.a, "a `while` condition");
  let mut v = n.b;
  c.inv = true;
  while v != 0 && !c.failed {
    let tv = ck_spec(&mut c, &mut m, p, v, false);
    if !c.failed {
      expect_ty(&mut c, m, p, tv, c.tbool, v, "a loop invariant");
    }
    v = next_of(p, v);
  }
  c.inv = false;
  if c.failed {
    return;
  }
  let before = copy_set(c.moved);
  let cb = own_state(&mut c, m, p);
  let d = ck_block(&mut c, &mut m, p, n.c);
  if !c.failed {
    let ca = own_state(&mut c, m, p);
    if !d && !same_set(ca, cb) && cm_new(&mut c, p, i, C_BRANCH) {
      cm_s(&mut c, "the loop body changes the ownership of ");
      cm_symdiff(&mut c, p, ca, cb);
      cm_note(&mut c, "a loop body must leave every outer linear value owned exactly as it found it");
    }
    vec_free(ca);
  }
  set_moved(&mut c, before);
  vec_free(cb);
}

/// "`E` has no variant `V`" at `loc`, for enum instance `x` and the
/// variant named second in node `i`.
fn cm_no_variant(c: &mut Checker, m: &Mono, p: &Parser, loc: u64, x: u64, i: u64) {
  if cm_new(&mut c, p, loc, C_TYPE) {
    cm_s(&mut c, "`");
    cm_inst(&mut c, m, p, x);
    cm_s(&mut c, "` has no variant `");
    cm_name2(&mut c, p, i);
    cm_s(&mut c, "`");
  }
}

/// The variants of enum instance `x` that no arm of `match` `i` names, as
/// `E::A`, `E::B`, joined by "`, `".
fn cm_missing(c: &mut Checker, m: &Mono, p: &Parser, i: u64, x: u64) {
  let n = node_at(p.nodes, i);
  let dn = def_node(m, p, x);
  let mut vk = dn.a;
  let mut first = true;
  while vk != 0 {
    let vn = node_at(p.nodes, vk);
    let mut hit = false;
    let mut a = n.b;
    while a != 0 {
      let an = node_at(p.nodes, a);
      if an.v != PAT_WILD && same(p.src, an.s2, an.e2, vn.s, vn.e) {
        hit = true;
      }
      a = an.next;
    }
    if !hit {
      if !first {
        cm_s(&mut c, "`, `");
      }
      cm_inst(&mut c, m, p, x);
      cm_s(&mut c, "::");
      cm_name(&mut c, p, vk);
      first = false;
    }
    vk = vn.next;
  }
}

/// The k-th set of places stored back to back in `outs`, the j-th ending
/// at `ends[j]`.
fn out_set(outs: &Vec[u64], ends: &Vec[u64], k: u64) -> Vec[u64] {
  let mut s = 0;
  if k > 0 {
    s = u_at(ends, k - 1);
  }
  let e = u_at(ends, k);
  let mut r = vec_new[u64]();
  let mut j = s;
  while j < e {
    vec_push(&mut r, u_at(outs, j));
    j = j + 1;
  }
  return r;
}

/// `match`: every variant handled once, each payload bound or, when it is
/// linear, accounted for; the arms must leave ownership the same way.
fn ck_match(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> bool {
  let n = node_at(p.nodes, i);
  let scrut = n.a;
  // A place of a borrowed enum is only inspected; anything else is moved
  // (or copied, when the enum is not linear).
  let pk = place_of(&mut c, p, scrut);
  let mut borrowed = false;
  if pk != 0 {
    path_type(&mut c, m, p, pk, scrut);
    if c.failed {
      return false;
    }
    let vr = root_var(c, p, pk);
    borrowed = kind_t(m, vr.vty) == TY_REF;
  }
  let mut t = 0;
  if borrowed {
    let pm = prefix_moved(c, pk);
    if pm != 0 {
      cm_used_after(&mut c, p, scrut, pk, pm);
      return false;
    }
    t = path_type(&mut c, m, p, pk, scrut);
  } else {
    t = ck_expr(&mut c, &mut m, p, scrut);
  }
  if c.failed {
    return false;
  }
  if kind_t(m, t) != TY_ENUM {
    if cm_new(&mut c, p, scrut, C_TYPE) {
      cm_s(&mut c, "`match` needs an enum, found ");
      cm_ty(&mut c, m, p, t);
    }
    return false;
  }
  let x = inner_t(m, t);
  let dn = def_node(m, p, x);
  let owned_linear = !borrowed && ck_linear(c, m, p, t);
  let mut covered = vec_new[u64]();
  let mut wild = false;
  let mut a = n.b;
  while a != 0 && !c.failed {
    let an = node_at(p.nodes, a);
    if wild {
      if cm_new(&mut c, p, a, C_MATCH) {
        cm_s(&mut c, "this arm can never run: `_` above already matches everything left");
      }
    } else if an.v == PAT_WILD {
      let mut vk = dn.a;
      let mut j = 0;
      while vk != 0 && j < SRC_MAX {
        let pt = fld_ty(c, x, j);
        if !has_id(covered, j) && owned_linear && pt != 0 && ck_linear(c, m, p, pt) && cm_new(&mut c, p, a, C_LEAK) {
          cm_s(&mut c, "`_` would drop the linear payload of `");
          cm_inst(&mut c, m, p, x);
          cm_s(&mut c, "::");
          cm_name(&mut c, p, vk);
          cm_s(&mut c, "`");
          cm_note(&mut c, "match that variant by name and consume its payload");
        }
        vk = next_of(p, vk);
        j = j + 1;
      }
      wild = true;
    } else if !names_enum(m, p, an.s, an.e, x) {
      if cm_new(&mut c, p, a, C_TYPE) {
        cm_s(&mut c, "this pattern is a `");
        cm_name(&mut c, p, a);
        cm_s(&mut c, "`, but the value matched is a `");
        cm_inst(&mut c, m, p, x);
        cm_s(&mut c, "`");
      }
    } else {
      let j = index_in(p, dn.a, an.s2, an.e2);
      if j == 0 {
        cm_no_variant(&mut c, m, p, a, x, a);
      } else if has_id(covered, j - 1) {
        if cm_new(&mut c, p, a, C_MATCH) {
          cm_s(&mut c, "`");
          cm_variant(&mut c, m, p, x, a);
          cm_s(&mut c, "` is matched twice");
        }
      } else {
        vec_push(&mut covered, j - 1);
        let pt = fld_ty(c, x, j - 1);
        let bind = an.v != PAT_VARIANT;
        if pt == 0 && bind {
          if cm_new(&mut c, p, a, C_TYPE) {
            cm_s(&mut c, "`");
            cm_variant(&mut c, m, p, x, a);
            cm_s(&mut c, "` has no payload");
          }
        } else if pt != 0 && !bind {
          if cm_new(&mut c, p, a, C_TYPE) {
            cm_s(&mut c, "`");
            cm_variant(&mut c, m, p, x, a);
            cm_s(&mut c, "` has a payload: write `");
            cm_variant(&mut c, m, p, x, a);
            cm_s(&mut c, "(x)` or `");
            cm_variant(&mut c, m, p, x, a);
            cm_s(&mut c, "(_)`");
          }
        } else if pt != 0 && name_is(p, an.a, "_") && ck_linear(c, m, p, pt) && owned_linear {
          if cm_new(&mut c, p, a, C_LEAK) {
            cm_s(&mut c, "`_` would drop the linear payload of `");
            cm_variant(&mut c, m, p, x, a);
            cm_s(&mut c, "`");
          }
        }
      }
    }
    a = an.next;
  }
  let ncovered = vec_len(covered);
  vec_free(covered);
  if c.failed {
    return false;
  }
  if !wild && ncovered < list_len(p, dn.a) {
    if cm_new(&mut c, p, i, C_MATCH) {
      cm_s(&mut c, "this `match` does not handle `");
      cm_missing(&mut c, m, p, i, x);
      cm_s(&mut c, "`");
    }
    return false;
  }
  // The arms, each from the same ownership state.
  let before = copy_set(c.moved);
  let mut outs = vec_new[u64]();
  let mut ends = vec_new[u64]();
  a = n.b;
  while a != 0 && !c.failed {
    let an = node_at(p.nodes, a);
    set_moved(&mut c, copy_set(before));
    let start = vec_len(c.vars);
    if (an.v == PAT_BIND || an.v == PAT_BIND_MUT) && !name_is(p, an.a, "_") {
      let bn = node_at(p.nodes, an.a);
      let j = index_in(p, dn.a, an.s2, an.e2);
      let mut pt = 0;
      if j != 0 {
        pt = fld_ty(c, x, j - 1);
      }
      // Out of a shared borrow, a linear payload is bound as a shared
      // borrow too: it can be read and lent, never moved.
      if borrowed && ck_linear(c, m, p, pt) {
        if an.v == PAT_BIND_MUT {
          if cm_new(&mut c, p, a, C_TYPE) {
            cm_s(&mut c, "`");
            cm_name(&mut c, p, an.a);
            cm_s(&mut c, "` borrows from `");
            cm_place(&mut c, p, pk);
            cm_s(&mut c, "` and cannot be `mut`");
          }
        } else {
          let rt = ref_to(&mut m, p, pt);
          declare(&mut c, p, bn.s, bn.e, rt, false, a);
        }
      } else {
        declare(&mut c, p, bn.s, bn.e, pt, an.v == PAT_BIND_MUT, a);
      }
    }
    if !c.failed {
      let d = ck_block(&mut c, &mut m, p, an.c);
      if !c.failed && !d {
        let lk = scope_leaks(&mut c, m, p, start);
        if lk != 0 && cm_scope_leak(&mut c, p, a, lk) {
          cm_note(&mut c, "the payload bound by a pattern is owned by the arm: consume it");
        }
      }
      if !c.failed {
        pop_scope(&mut c, start);
        if !d {
          let mut j = 0;
          while j < vec_len(c.moved) {
            vec_push(&mut outs, u_at(c.moved, j));
            j = j + 1;
          }
          vec_push(&mut ends, vec_len(outs));
        }
      }
    }
    a = an.next;
  }
  vec_free(before);
  let nouts = vec_len(ends);
  if c.failed || nouts == 0 {
    vec_free(outs);
    vec_free(ends);
    return !c.failed;
  }
  set_moved(&mut c, out_set(outs, ends, 0));
  let c0 = own_state(&mut c, m, p);
  let mut all = vec_new[u64]();
  let mut k = 0;
  while k < nouts {
    let o = out_set(outs, ends, k);
    union_into(&mut all, o);
    set_moved(&mut c, o);
    let ck = own_state(&mut c, m, p);
    if !same_set(ck, c0) && cm_new(&mut c, p, i, C_BRANCH) {
      cm_symdiff(&mut c, p, c0, ck);
      cm_s(&mut c, " is consumed in only some arms of this `match`");
    }
    vec_free(ck);
    k = k + 1;
  }
  set_moved(&mut c, all);
  vec_free(c0);
  vec_free(outs);
  vec_free(ends);
  return false;
}

// ---- Expressions ----

/// A code expression: linear values in value position are moved.
fn ck_expr(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  return ck_named(&mut c, &mut m, p, i, 0);
}

/// A code expression in a position that expects type `want`: a literal
/// takes that type when it is an integer type (docs/integers.md).
fn ck_expr_as(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, want: u64) -> u64 {
  if c.failed {
    return 0;
  }
  if is_lit(p, i) && is_int(m, want) {
    let n = node_at(p.nodes, i);
    let neg = n.kind == E_NEG;
    let mut v = n.v;
    if neg {
      let x = node_at(p.nodes, n.a);
      v = x.v;
    }
    if !lit_fits(m, v, neg, want) {
      if cm_new(&mut c, p, i, C_TYPE) {
        if neg && v != 0 {
          cm_s(&mut c, "-");
        }
        cm_num(&mut c, v);
        cm_s(&mut c, " does not fit in ");
        cm_ty(&mut c, m, p, want);
      }
      return 0;
    }
    return want;
  }
  return ck_expr(&mut c, &mut m, p, i);
}

/// The types of the two operands of a binary operator.
struct Ops { a: u64, b: u64 }

/// The two operands `a` and `b` of a binary operator: a literal on one
/// side takes the type of the other side, so that side is checked first.
fn operands(c: &mut Checker, m: &mut Mono, p: &Parser, a: u64, b: u64) -> Ops {
  if is_lit(p, a) && !is_lit(p, b) {
    let tb = ck_expr(&mut c, &mut m, p, b);
    let ta = ck_expr_as(&mut c, &mut m, p, a, tb);
    return Ops { a: ta, b: tb };
  }
  let ta = ck_expr(&mut c, &mut m, p, a);
  let tb = ck_expr_as(&mut c, &mut m, p, b, ta);
  return Ops { a: ta, b: tb };
}

/// An expression; a call, struct literal or variant names instance `inst`
/// instead of what is written when `inst` is not 0.
fn ck_named(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, inst: u64) -> u64 {
  if c.failed {
    return 0;
  }
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_TAPP {
    if is_typed_builtin(p, n.b) {
      let call = node_at(p.nodes, n.b);
      if name_is(p, n.b, "vec_new") {
        // `vec_new[T]()`
        if list_len(p, n.a) != 1 || call.a != 0 {
          if cm_new(&mut c, p, i, C_TYPE) {
            cm_s(&mut c, "write `vec_new[T]()`: one type argument, no arguments");
          }
          return 0;
        }
        let t = conv(&mut m, p, n.a, c.env, i);
        known_type(&mut c, m, p, t, i);
        if c.failed {
          return 0;
        }
        return intern(&mut m, p, TY_VEC, t);
      }
      // `cast[T](x)` (proved to fit) and `wrap[T](x)` (modular).
      if list_len(p, n.a) != 1 || list_len(p, call.a) != 1 {
        if cm_new(&mut c, p, i, C_TYPE) {
          cm_s(&mut c, "write `");
          cm_name(&mut c, p, n.b);
          cm_s(&mut c, "[T](x)`: one type argument, one argument");
        }
        return 0;
      }
      let t = conv(&mut m, p, n.a, c.env, i);
      if !is_int(m, t) {
        if cm_new(&mut c, p, i, C_TYPE) {
          cm_s(&mut c, "`");
          cm_name(&mut c, p, n.b);
          cm_s(&mut c, "` converts to an integer type, not ");
          cm_ty(&mut c, m, p, t);
        }
        return 0;
      }
      let ta = ck_expr(&mut c, &mut m, p, call.a);
      if !c.failed && !is_int(m, ta) && cm_new(&mut c, p, call.a, C_TYPE) {
        cm_s(&mut c, "`");
        cm_name(&mut c, p, n.b);
        cm_s(&mut c, "` converts an integer, found ");
        cm_ty(&mut c, m, p, ta);
      }
      if c.failed {
        return 0;
      }
      // The type converted from: whether it can be negative matters to the
      // proof.
      note_int_op(&mut c, m, i, ta);
      return t;
    }
    let x = tapp_inst(&mut m, p, i, c.env);
    return ck_named(&mut c, &mut m, p, n.b, x);
  }
  if k == E_INT {
    return c.tu64;
  }
  if k == E_BOOL {
    return c.tbool;
  }
  if k == E_STR || k == E_BLOB {
    return c.tstr;
  }
  if k == E_VAR {
    let v = find_var(c, p, n.s, n.e);
    if v == 0 {
      cm_unknown_var(&mut c, p, i);
      return 0;
    }
    let vr = var_at(c, v - 1);
    if kind_t(m, vr.vty) == TY_REF && ck_linear(c, m, p, inner_t(m, vr.vty)) {
      if cm_new(&mut c, p, i, C_USE) {
        cm_s(&mut c, "cannot move out of the shared borrow `");
        cm_name(&mut c, p, i);
        cm_s(&mut c, "`");
      }
      return 0;
    }
    let pk = ck_path(&mut c, p, 0, n.s, n.e);
    return use_place(&mut c, m, p, pk, i);
  }
  if k == E_FIELD {
    let pk = place_of(&mut c, p, i);
    if pk == 0 {
      if cm_new(&mut c, p, i, C_TYPE) {
        cm_s(&mut c, "a field can only be read from a variable or a field of one");
      }
      return 0;
    }
    return use_place(&mut c, m, p, pk, i);
  }
  if k == E_VARIANT {
    return ck_variant(&mut c, &mut m, p, i, inst);
  }
  if k == E_IS {
    return ck_is(&mut c, &mut m, p, i);
  }
  if k == E_SLIT {
    return ck_slit(&mut c, &mut m, p, i, inst);
  }
  if k == E_NOT {
    let t = ck_expr(&mut c, &mut m, p, n.a);
    // On an unsigned integer, `!` flips every bit. It is recorded even on a
    // u64: the verifier tells it from a boolean `!` by the record.
    if !c.failed && is_int(m, t) && !is_signed(m, t) {
      vec_push(&mut c.int_ops, IntOp { x: c.env, node: i, ty: t });
      return t;
    }
    if !c.failed {
      expect_ty(&mut c, m, p, t, c.tbool, n.a, "the operand of `!`");
    }
    return c.tbool;
  }
  if k == E_NEG {
    // A negated literal with nothing to give it a signed type would be a u64.
    let mut t = c.tu64;
    if kind_of(p, n.a) != E_INT {
      t = ck_expr(&mut c, &mut m, p, n.a);
      if c.failed {
        return 0;
      }
    }
    if !is_signed(m, t) {
      if cm_new(&mut c, p, i, C_TYPE) {
        cm_s(&mut c, "unary minus needs a signed integer, found ");
        cm_ty(&mut c, m, p, t);
      }
      return 0;
    }
    note_int_op(&mut c, m, i, t);
    return t;
  }
  if k == E_BIN {
    if n.v == P_IMPLIES {
      if cm_new(&mut c, p, i, C_TYPE) {
        cm_s(&mut c, "`==>` is only allowed in specifications");
      }
      return 0;
    }
    if n.v == P_SHL || n.v == P_SHR {
      // A shift amount has its own type: a literal there is a u64.
      let ta = ck_expr(&mut c, &mut m, p, n.a);
      let tb = ck_expr(&mut c, &mut m, p, n.b);
      if c.failed {
        return 0;
      }
      let t = bin_type(&mut c, m, p, n.v, ta, tb, i);
      note_int_op(&mut c, m, i, t);
      return t;
    }
    if n.v != P_ANDAND && n.v != P_OROR {
      let ts = operands(&mut c, &mut m, p, n.a, n.b);
      if c.failed {
        return 0;
      }
      let t = bin_type(&mut c, m, p, n.v, ts.a, ts.b, i);
      // The operands' type: the result's for arithmetic, and what a
      // comparison compares (signed or not matters to the C code).
      note_int_op(&mut c, m, i, ts.a);
      return t;
    }
    let ta = ck_expr(&mut c, &mut m, p, n.a);
    if c.failed {
      return 0;
    }
    let before = copy_set(c.moved);
    let tb = ck_expr(&mut c, &mut m, p, n.b);
    let changed = !same_set(before, c.moved);
    vec_free(before);
    if c.failed {
      return 0;
    }
    if (n.v == P_ANDAND || n.v == P_OROR) && changed {
      if cm_new(&mut c, p, n.b, C_USE) {
        cm_s(&mut c, "the right side of `");
        cm_op(&mut c, n.v);
        cm_s(&mut c, "` may not run, so it cannot consume a linear value");
      }
      return 0;
    }
    return bin_type(&mut c, m, p, n.v, ta, tb, i);
  }
  if k == E_CALL {
    return ck_call(&mut c, &mut m, p, i, inst);
  }
  // `&mut x` outside a call's arguments, or `forall` in code.
  if cm_new(&mut c, p, i, C_TYPE) {
    if k == E_MUTBORROW {
      cm_s(&mut c, "`&mut x` is only allowed as a call argument");
    } else if k == E_FORALL {
      cm_s(&mut c, "`forall` is only allowed in specifications");
    }
  }
  return 0;
}

/// "unknown variable `x`" for variable node `i`.
fn cm_unknown_var(c: &mut Checker, p: &Parser, i: u64) {
  if cm_new(&mut c, p, i, C_TYPE) {
    cm_s(&mut c, "unknown variable `");
    cm_name(&mut c, p, i);
    cm_s(&mut c, "`");
  }
}

fn ck_variant(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, inst: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let mut x = inst;
  if x == 0 {
    let d = find_in(p, p.enums.head, i);
    if d == 0 {
      if cm_new(&mut c, p, i, C_TYPE) {
        cm_s(&mut c, "unknown enum `");
        cm_name(&mut c, p, i);
        cm_s(&mut c, "`");
      }
      return 0;
    }
    x = plain_inst(&mut m, d);
  }
  let dn = def_node(m, p, x);
  let j = index_in(p, dn.a, n.s2, n.e2);
  if j == 0 {
    cm_no_variant(&mut c, m, p, i, x, i);
    return 0;
  }
  let pt = fld_ty(c, x, j - 1);
  if pt != 0 && n.a != 0 {
    let t = ck_expr_as(&mut c, &mut m, p, n.a, pt);
    if !c.failed && cm_mismatch(&mut c, p, t, pt, n.a) {
      cm_s(&mut c, "the payload of `");
      cm_variant(&mut c, m, p, x, i);
      cm_s(&mut c, "`");
      cm_must(&mut c, m, p, pt, t);
    }
  } else if pt != 0 || n.a != 0 {
    if cm_new(&mut c, p, i, C_TYPE) {
      cm_s(&mut c, "`");
      cm_variant(&mut c, m, p, x, i);
      if pt == 0 {
        cm_s(&mut c, "` has no payload");
      } else {
        cm_s(&mut c, "` needs a payload of type ");
        cm_ty(&mut c, m, p, pt);
      }
    }
  }
  if c.failed {
    return 0;
  }
  return intern(&mut m, p, TY_ENUM, x);
}

/// `e is Enum::Variant` reads the tag only: nothing is consumed.
fn ck_is(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let pk = place_of(&mut c, p, n.a);
  let mut t = 0;
  if pk != 0 {
    let pm = prefix_moved(c, pk);
    if pm != 0 {
      cm_used_after(&mut c, p, n.a, pk, pm);
      return 0;
    }
    t = path_type(&mut c, m, p, pk, n.a);
  } else {
    t = ck_expr(&mut c, &mut m, p, n.a);
    if !c.failed && ck_linear(c, m, p, t) && cm_new(&mut c, p, n.a, C_LEAK) {
      cm_s(&mut c, "`is` does not consume its operand, so this linear value would be dropped");
    }
  }
  if c.failed {
    return 0;
  }
  if kind_t(m, t) != TY_ENUM || !names_enum(m, p, n.s, n.e, inner_t(m, t)) {
    cm_is_needs(&mut c, m, p, n.a, i, t);
    return 0;
  }
  let dn = def_node(m, p, inner_t(m, t));
  if index_in(p, dn.a, n.s2, n.e2) == 0 {
    if cm_new(&mut c, p, i, C_TYPE) {
      cm_s(&mut c, "`");
      cm_name(&mut c, p, i);
      cm_s(&mut c, "` has no variant `");
      cm_name2(&mut c, p, i);
      cm_s(&mut c, "`");
    }
    return 0;
  }
  return c.tbool;
}

/// "`is E::V` needs a `E`, found T" at `loc`, for `is` node `i`.
fn cm_is_needs(c: &mut Checker, m: &Mono, p: &Parser, loc: u64, i: u64, t: u64) {
  if cm_new(&mut c, p, loc, C_TYPE) {
    cm_s(&mut c, "`is ");
    cm_name(&mut c, p, i);
    cm_s(&mut c, "::");
    cm_name2(&mut c, p, i);
    cm_s(&mut c, "` needs a `");
    cm_name(&mut c, p, i);
    cm_s(&mut c, "`, found ");
    cm_ty(&mut c, m, p, t);
  }
}

fn ck_slit(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, inst: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let mut x = inst;
  if x == 0 {
    let d = find_in(p, p.structs.head, i);
    if d == 0 {
      if cm_new(&mut c, p, i, C_TYPE) {
        cm_s(&mut c, "unknown struct `");
        cm_name(&mut c, p, i);
        cm_s(&mut c, "`");
      }
      return 0;
    }
    x = plain_inst(&mut m, d);
  }
  let dn = def_node(m, p, x);
  let mut f = dn.a;
  while f != 0 {
    let fd = node_at(p.nodes, f);
    if index_in(p, n.a, fd.s, fd.e) == 0 {
      if cm_new(&mut c, p, i, C_TYPE) {
        cm_s(&mut c, "field `");
        cm_name(&mut c, p, f);
        cm_s(&mut c, "` of `");
        cm_inst(&mut c, m, p, x);
        cm_s(&mut c, "` is missing");
      }
      return 0;
    }
    f = fd.next;
  }
  let mut q = n.a;
  while q != 0 && !c.failed {
    let qn = node_at(p.nodes, q);
    let j = index_in(p, dn.a, qn.s, qn.e);
    if j == 0 {
      if cm_new(&mut c, p, qn.a, C_TYPE) {
        cm_s(&mut c, "`");
        cm_inst(&mut c, m, p, x);
        cm_s(&mut c, "` has no field `");
        cm_name(&mut c, p, q);
        cm_s(&mut c, "`");
      }
      return 0;
    }
    let ft = fld_ty(c, x, j - 1);
    let t = ck_expr_as(&mut c, &mut m, p, qn.a, ft);
    if !c.failed && cm_mismatch(&mut c, p, t, ft, qn.a) {
      cm_s(&mut c, "field `");
      cm_name(&mut c, p, q);
      cm_s(&mut c, "`");
      cm_must(&mut c, m, p, ft, t);
    }
    q = qn.next;
  }
  if c.failed {
    return 0;
  }
  return intern(&mut m, p, TY_STRUCT, x);
}

/// Records the integer type of operator `i` if it is narrower than u64.
fn note_int_op(c: &mut Checker, m: &Mono, i: u64, t: u64) {
  if is_int(m, t) && t != c.tu64 {
    vec_push(&mut c.int_ops, IntOp { x: c.env, node: i, ty: t });
  }
}

/// `&`, `|`, `^`, `<<`, `>>`: on unsigned integers only, never in
/// specifications.
fn is_bitwise(op: u64) -> bool {
  return op == P_AMP || op == P_PIPE || op == P_CARET || op == P_SHL || op == P_SHR;
}

fn bin_type(c: &mut Checker, m: &Mono, p: &Parser, op: u64, a: u64, b: u64, loc: u64) -> u64 {
  let order = op == P_LT || op == P_LE || op == P_GT || op == P_GE;
  if op == P_PLUS || op == P_MINUS || op == P_STAR || op == P_SLASH || op == P_PERCENT || order {
    // Both operands have one integer type; there is no promotion.
    let mut want = c.tu64;
    if is_int(m, a) {
      want = a;
    }
    cm_operands(&mut c, m, p, op, a, b, want, loc);
    if order {
      return c.tbool;
    }
    return want;
  }
  if is_bitwise(op) {
    // Unsigned integers, of one type except a shift amount.
    let shift = op == P_SHL || op == P_SHR;
    if (!is_int(m, a) || is_signed(m, a) || !is_int(m, b) || is_signed(m, b) || (a != b && !shift)) && cm_new(&mut c, p, loc, C_TYPE) {
      cm_s(&mut c, "`");
      cm_op(&mut c, op);
      cm_s(&mut c, "` needs unsigned integers");
      if !shift {
        cm_s(&mut c, " of one type");
      }
      cm_s(&mut c, ", found ");
      cm_ty(&mut c, m, p, a);
      cm_s(&mut c, " and ");
      cm_ty(&mut c, m, p, b);
    }
    return a;
  }
  if op == P_EQEQ || op == P_NE {
    if (a != b || !(is_int(m, a) || a == c.tbool)) && cm_new(&mut c, p, loc, C_TYPE) {
      // Only integers and bool compare.
      cm_s(&mut c, "cannot compare ");
      cm_ty(&mut c, m, p, a);
      cm_s(&mut c, " with ");
      cm_ty(&mut c, m, p, b);
    }
    return c.tbool;
  }
  cm_operands(&mut c, m, p, op, a, b, c.tbool, loc);
  return c.tbool;
}

/// Both operands of `op` (types `a` and `b`) must have type `want`.
fn cm_operands(c: &mut Checker, m: &Mono, p: &Parser, op: u64, a: u64, b: u64, want: u64, loc: u64) {
  if cm_mismatch(&mut c, p, a, want, loc) {
    cm_s(&mut c, "the left operand of `");
    cm_op(&mut c, op);
    cm_s(&mut c, "`");
    cm_must(&mut c, m, p, want, a);
  }
  if cm_mismatch(&mut c, p, b, want, loc) {
    cm_s(&mut c, "the right operand of `");
    cm_op(&mut c, op);
    cm_s(&mut c, "`");
    cm_must(&mut c, m, p, want, b);
  }
}

/// The parameter types of function `d` read in instance `x`.
fn fn_params(m: &mut Mono, p: &Parser, d: u64, x: u64) -> Vec[u64] {
  let mut out = vec_new[u64]();
  let dn = node_at(p.nodes, d);
  let mut q = dn.a;
  while q != 0 {
    let qn = node_at(p.nodes, q);
    vec_push(&mut out, conv(&mut m, p, qn.a, x, q));
    q = qn.next;
  }
  return out;
}

fn bsig_params(b: Bsig) -> Vec[u64] {
  let mut out = vec_new[u64]();
  if b.np > 0 { vec_push(&mut out, b.p0); }
  if b.np > 1 { vec_push(&mut out, b.p1); }
  if b.np > 2 { vec_push(&mut out, b.p2); }
  if b.np > 3 { vec_push(&mut out, b.p3); }
  return out;
}

/// A call to the function of instance `x`.
fn user_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, x: u64) -> u64 {
  note_call(&mut c, x);
  let xi = inst_at(m, x);
  let ps = fn_params(&mut m, p, xi.def, x);
  let dn = node_at(p.nodes, xi.def);
  let r = conv(&mut m, p, dn.b, x, xi.def);
  let call = node_at(p.nodes, i);
  let t = call_with(&mut c, &mut m, p, ps, r, call.a, i, x);
  vec_free(ps);
  return t;
}

fn ck_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, inst: u64) -> u64 {
  let ii = inst_at(m, inst);
  if inst != 0 && kind_of(p, ii.def) == D_SPEC {
    if cm_new(&mut c, p, i, C_TYPE) {
      cm_s(&mut c, "`");
      cm_inst(&mut c, m, p, inst);
      cm_s(&mut c, "` is only allowed in specifications");
    }
    return 0;
  }
  if inst != 0 {
    return user_call(&mut c, &mut m, p, i, inst);
  }
  let n = node_at(p.nodes, i);
  let s = n.s;
  let e = n.e;
  if is_spec_word(p, s, e) || (ghost_index(c, p, s, e) != 0 && bs_index(c, p, s, e) == 0) || find_spec(c, p, s, e) != 0 {
    if cm_new(&mut c, p, i, C_TYPE) {
      cm_s(&mut c, "`");
      cm_name(&mut c, p, i);
      cm_s(&mut c, "` is only allowed in specifications");
    }
    return 0;
  }
  if is_vec_builtin(p, s, e) {
    return vec_call(&mut c, &mut m, p, i);
  }
  if is_wrap_builtin(p, s, e) {
    if list_len(p, n.a) != 2 {
      cm_arity(&mut c, p, i, 2);
      return 0;
    }
    let ts = operands(&mut c, &mut m, p, n.a, next_of(p, n.a));
    if !c.failed && (!is_int(m, ts.a) || ts.a != ts.b) && cm_new(&mut c, p, i, C_TYPE) {
      cm_s(&mut c, "`");
      cm_name(&mut c, p, i);
      cm_s(&mut c, "` needs two integers of the same type, found ");
      cm_ty(&mut c, m, p, ts.a);
      cm_s(&mut c, " and ");
      cm_ty(&mut c, m, p, ts.b);
    }
    if c.failed {
      return 0;
    }
    note_int_op(&mut c, m, i, ts.a);
    return ts.a;
  }
  if span_is(p, s, e, "box") || span_is(p, s, e, "unbox") {
    // Generic over the boxed type, so not in the builtin table.
    if list_len(p, n.a) != 1 {
      cm_arity(&mut c, p, i, 1);
      return 0;
    }
    let t = ck_expr(&mut c, &mut m, p, n.a);
    if c.failed {
      return 0;
    }
    if span_is(p, s, e, "box") {
      return intern(&mut m, p, TY_BOX, t);
    }
    if kind_t(m, t) != TY_BOX {
      cm_needs(&mut c, m, p, n.a, "`unbox` needs a box, found ", t);
      return 0;
    }
    return inner_t(m, t);
  }
  let b = bs_index(c, p, s, e);
  if b != 0 {
    let bs = bs_at(c, b - 1);
    if !available(bs.avail, c.target) {
      if cm_new(&mut c, p, i, C_TARGET) {
        cm_s(&mut c, "`");
        cm_name(&mut c, p, i);
        cm_s(&mut c, "` is not available on this target");
      }
      return 0;
    }
    let ps = bsig_params(bs);
    let t = call_with(&mut c, &mut m, p, ps, bs.ret, n.a, i, 0);
    vec_free(ps);
    return t;
  }
  if span_is(p, s, e, "main") {
    if cm_new(&mut c, p, i, C_TYPE) {
      cm_s(&mut c, "`main` cannot be called");
    }
    return 0;
  }
  if span_is(p, s, e, "lock_new") || span_is(p, s, e, "lock_end") {
    if list_len(p, n.a) != 1 {
      cm_arity(&mut c, p, i, 1);
      return 0;
    }
    let t = ck_expr(&mut c, &mut m, p, n.a);
    if c.failed {
      return 0;
    }
    if span_is(p, s, e, "lock_new") {
      if is_pinned(c, m, p, t) {
        if cm_new(&mut c, p, n.a, C_PIN) {
          cm_s(&mut c, "a ");
          cm_ty(&mut c, m, p, t);
          cm_s(&mut c, " cannot be put in a lock: it holds a capability of this processor");
          cm_note(&mut c, "`Cpu` and `Mmu` describe the processor that holds them, and a lock can be taken on any processor");
        }
        return 0;
      }
      return intern(&mut m, p, TY_LOCK, t);
    }
    if kind_t(m, t) != TY_LOCK {
      cm_needs(&mut c, m, p, n.a, "`lock_end` needs a lock, found ", t);
      return 0;
    }
    return inner_t(m, t);
  }
  if span_is(p, s, e, "locked") {
    return locked_call(&mut c, &mut m, p, i);
  }
  if is_atomic_builtin(p, s, e) {
    return atomic_call(&mut c, &mut m, p, i);
  }
  if span_is(p, s, e, "smp_run") {
    return smp_run_call(&mut c, &mut m, p, i);
  }
  if is_pt_borrow_builtin(p, s, e) {
    return pt_borrow_call(&mut c, &mut m, p, i);
  }
  let d = plain_fn(p, s, e);
  if d == 0 {
    if cm_new(&mut c, p, i, C_TYPE) {
      cm_s(&mut c, "unknown function `");
      cm_name(&mut c, p, i);
      cm_s(&mut c, "`");
    }
    return 0;
  }
  let x = plain_inst(&mut m, d);
  return user_call(&mut c, &mut m, p, i, x);
}

/// "`f` takes N argument(s), K given" for builtin call `i`.
fn cm_arity(c: &mut Checker, p: &Parser, i: u64, want: u64) {
  if cm_new(&mut c, p, i, C_TYPE) {
    let n = node_at(p.nodes, i);
    cm_s(&mut c, "`");
    cm_name(&mut c, p, i);
    cm_s(&mut c, "` takes ");
    cm_num(&mut c, want);
    cm_s(&mut c, " argument(s), ");
    cm_num(&mut c, list_len(p, n.a));
    cm_s(&mut c, " given");
  }
}

/// `what` followed by the name of type `t`, at `loc`.
fn cm_needs(c: &mut Checker, m: &Mono, p: &Parser, loc: u64, what: Str, t: u64) {
  if cm_new(&mut c, p, loc, C_TYPE) {
    cm_s(&mut c, what);
    cm_ty(&mut c, m, p, t);
  }
}

/// "`f` needs an Atomic, found T" (and the like) for call `i`.
fn cm_call_needs(c: &mut Checker, m: &Mono, p: &Parser, loc: u64, i: u64, what: Str, t: u64) {
  if cm_new(&mut c, p, loc, C_TYPE) {
    cm_s(&mut c, "`");
    cm_name(&mut c, p, i);
    cm_s(&mut c, what);
    cm_ty(&mut c, m, p, t);
  }
}

/// The function that argument `a` of a `locked` or `smp_run` call (node
/// `i`) names: its plain instance, or 0 after an error.
fn named_fn(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, a: u64) -> u64 {
  if a != 0 {
    let an = node_at(p.nodes, a);
    if an.kind == E_VAR && !span_is(p, an.s, an.e, "main") && !is_builtin_name(c, p, an.s, an.e)
      && sigs_has(c, p, an.s, an.e) && find_var(c, p, an.s, an.e) == 0 {
      return plain_inst(&mut m, plain_fn(p, an.s, an.e));
    }
    cm_needs_fn(&mut c, p, a, i);
    return 0;
  }
  cm_needs_fn(&mut c, p, i, i);
  return 0;
}

/// "`locked` needs the name of a function here", at `loc`, for call `i`.
fn cm_needs_fn(c: &mut Checker, p: &Parser, loc: u64, i: u64) {
  if cm_new(&mut c, p, loc, C_TYPE) {
    cm_s(&mut c, "`");
    cm_name(&mut c, p, i);
    cm_s(&mut c, "` needs the name of a function here");
  }
}

/// `locked(&l, f, args..)`: takes the lock, calls `f(&mut contents,
/// args..)` and releases it. The contents are reachable only during the
/// call, so no other processor can see them half updated.
fn locked_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let a0 = n.a;
  let mut pk = 0;
  if a0 != 0 {
    pk = place_of(&mut c, p, a0);
  }
  if pk == 0 {
    let mut loc = i;
    if a0 != 0 {
      loc = a0;
    }
    if cm_new(&mut c, p, loc, C_TYPE) {
      cm_s(&mut c, "the first argument of `locked` must name a lock");
    }
    return 0;
  }
  let lt = path_type(&mut c, m, p, pk, a0);
  if c.failed {
    return 0;
  }
  if kind_t(m, lt) != TY_LOCK {
    cm_needs(&mut c, m, p, a0, "`locked` needs a Lock, found ", lt);
    return 0;
  }
  let a1 = next_of(p, a0);
  let x = named_fn(&mut c, &mut m, p, i, a1);
  if c.failed {
    return 0;
  }
  let xi = inst_at(m, x);
  let fps = fn_params(&mut m, p, xi.def, x);
  let dn = node_at(p.nodes, xi.def);
  let r = conv(&mut m, p, dn.b, x, xi.def);
  let inner = inner_t(m, lt);
  if vec_len(fps) == 0 || u_at(fps, 0) != mut_to(&mut m, p, inner) {
    vec_free(fps);
    if cm_new(&mut c, p, a1, C_TYPE) {
      cm_s(&mut c, "`");
      cm_inst(&mut c, m, p, x);
      cm_s(&mut c, "` must take `&mut ");
      cm_ty(&mut c, m, p, inner);
      cm_s(&mut c, "` first, to receive the contents of the lock");
    }
    return 0;
  }
  note_call(&mut c, x);
  vec_push(&mut c.lsites, LockSite { x: c.env, node: i, cls: inner, f: x });
  // `f`'s signature with the lock, borrowed, in place of its contents.
  let mut ps = vec_new[u64]();
  vec_push(&mut ps, ref_to(&mut m, p, lt));
  let mut j = 1;
  while j < vec_len(fps) {
    vec_push(&mut ps, vec_get(fps, j));
    j = j + 1;
  }
  vec_free(fps);
  let mut args = vec_new[u64]();
  vec_push(&mut args, a0);
  let mut a = next_of(p, a1);
  while a != 0 {
    vec_push(&mut args, a);
    a = next_of(p, a);
  }
  let t = call_with_v(&mut c, &mut m, p, ps, r, args, i, x);
  vec_free(ps);
  vec_free(args);
  return t;
}

/// Can an `Atomic` hold a `t`? One word: an integer, a bool, or a struct
/// with a single such field.
fn atomic_word(c: &Checker, m: &Mono, p: &Parser, t: u64) -> bool {
  if t == c.tbool || is_int(m, t) {
    return true;
  }
  if kind_t(m, t) == TY_STRUCT {
    let x = inner_t(m, t);
    let dn = def_node(m, p, x);
    if list_len(p, dn.a) == 1 {
      let ft = fld_ty(c, x, 0);
      return ft == c.tbool || is_int(m, ft);
    }
  }
  return false;
}

/// The `Atomic` builtins, as stage0's `Ctx::atomic`.
fn atomic_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let a0 = n.a;
  if name_is(p, i, "atomic_new") || name_is(p, i, "atomic_end") {
    if list_len(p, a0) != 1 {
      cm_arity(&mut c, p, i, 1);
      return 0;
    }
    let t = ck_expr(&mut c, &mut m, p, a0);
    if c.failed {
      return 0;
    }
    if name_is(p, i, "atomic_new") {
      if !atomic_word(c, m, p, t) {
        cm_not_word(&mut c, m, p, a0, t);
        return 0;
      }
      // The verifier reads every integer as a u64.
      note_int_op(&mut c, m, i, t);
      return intern(&mut m, p, TY_ATOMIC, t);
    }
    if kind_t(m, t) != TY_ATOMIC {
      cm_needs(&mut c, m, p, a0, "`atomic_end` needs an Atomic, found ", t);
      return 0;
    }
    return inner_t(m, t);
  }
  let mut pk = 0;
  if a0 != 0 {
    pk = place_of(&mut c, p, a0);
  }
  if pk == 0 {
    let mut loc = i;
    if a0 != 0 {
      loc = a0;
    }
    if cm_new(&mut c, p, loc, C_TYPE) {
      cm_s(&mut c, "the first argument of `");
      cm_name(&mut c, p, i);
      cm_s(&mut c, "` must name an atomic");
    }
    return 0;
  }
  let aty = path_type(&mut c, m, p, pk, a0);
  if c.failed {
    return 0;
  }
  if kind_t(m, aty) != TY_ATOMIC {
    cm_call_needs(&mut c, m, p, a0, i, "` needs an Atomic, found ", aty);
    return 0;
  }
  let t = inner_t(m, aty);
  if !atomic_word(c, m, p, t) {
    cm_not_word(&mut c, m, p, a0, t);
    return 0;
  }
  let mut ps = vec_new[u64]();
  vec_push(&mut ps, ref_to(&mut m, p, aty));
  let mut r = t;
  if name_is(p, i, "atomic_store") {
    vec_push(&mut ps, t);
    r = c.tunit;
  } else if name_is(p, i, "atomic_swap") {
    vec_push(&mut ps, t);
  } else if name_is(p, i, "atomic_cas") {
    vec_push(&mut ps, t);
    vec_push(&mut ps, t);
    r = c.tbool;
  } else if name_is(p, i, "atomic_wrap_add") {
    if !is_int(m, t) {
      vec_free(ps);
      cm_needs(&mut c, m, p, a0, "`atomic_wrap_add` needs an Atomic of an integer type, found ", aty);
      return 0;
    }
    vec_push(&mut ps, t);
  }
  let r2 = call_with(&mut c, &mut m, p, ps, r, a0, i, 0);
  vec_free(ps);
  return r2;
}

/// "an Atomic cannot hold a T" at `loc`.
fn cm_not_word(c: &mut Checker, m: &Mono, p: &Parser, loc: u64, t: u64) {
  if cm_new(&mut c, p, loc, C_TYPE) {
    cm_s(&mut c, "an Atomic cannot hold a ");
    cm_ty(&mut c, m, p, t);
    cm_note(&mut c, "an Atomic holds one word: an integer, a bool, or a struct with a single field of one of those");
  }
}

/// `pt_borrow(&mut t, i, f, args..)`: calls `f(&mut child, args..)` with
/// the table in slot `i` of `t` left in place (`pt_borrow_frame`: the page
/// in slot `i` of a level-1 table), so processors running on the tree keep
/// seeing it. The verifier checks that `f` hands it back.
fn pt_borrow_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  if c.target == TARGET_USER {
    if cm_new(&mut c, p, i, C_TARGET) {
      cm_s(&mut c, "`");
      cm_name(&mut c, p, i);
      cm_s(&mut c, "` is not available on this target");
    }
    return 0;
  }
  let n = node_at(p.nodes, i);
  let a0 = n.a;
  let mut a1 = 0;
  let mut a2 = 0;
  if a0 != 0 {
    a1 = next_of(p, a0);
  }
  if a1 != 0 {
    a2 = next_of(p, a1);
  }
  let x = named_fn(&mut c, &mut m, p, i, a2);
  if c.failed {
    return 0;
  }
  let xi = inst_at(m, x);
  let fps = fn_params(&mut m, p, xi.def, x);
  let dn = node_at(p.nodes, xi.def);
  let r = conv(&mut m, p, dn.b, x, xi.def);
  let mut child = prim(&mut m, p, TY_FRAME);
  if name_is(p, i, "pt_borrow") {
    child = prim(&mut m, p, TY_PT);
  }
  if vec_len(fps) == 0 || u_at(fps, 0) != mut_to(&mut m, p, child) {
    vec_free(fps);
    if cm_new(&mut c, p, a2, C_TYPE) {
      cm_s(&mut c, "`");
      cm_inst(&mut c, m, p, x);
      cm_s(&mut c, "` must take `&mut ");
      cm_ty(&mut c, m, p, child);
      cm_s(&mut c, "` first, to receive what `");
      cm_name(&mut c, p, i);
      cm_s(&mut c, "` lends");
    }
    return 0;
  }
  note_call(&mut c, x);
  // `f`'s signature with the table and the slot in place of the child.
  let ptb = prim(&mut m, p, TY_PT);
  let mut ps = vec_new[u64]();
  vec_push(&mut ps, mut_to(&mut m, p, ptb));
  vec_push(&mut ps, c.tu64);
  let mut j = 1;
  while j < vec_len(fps) {
    vec_push(&mut ps, vec_get(fps, j));
    j = j + 1;
  }
  vec_free(fps);
  let mut args = vec_new[u64]();
  vec_push(&mut args, a0);
  vec_push(&mut args, a1);
  let mut a = next_of(p, a2);
  while a != 0 {
    vec_push(&mut args, a);
    a = next_of(p, a);
  }
  let t = call_with_v(&mut c, &mut m, p, ps, r, args, i, x);
  vec_free(ps);
  vec_free(args);
  return t;
}

/// `smp_run(f, args..)`: runs `f` on every processor at once and returns
/// when all of them have returned. Each processor's call gets its own
/// `Cpu` and `Mmu`; every other argument is a shared borrow.
fn smp_run_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  if c.target != TARGET_KERNEL {
    if cm_new(&mut c, p, i, C_TARGET) {
      cm_s(&mut c, "`smp_run` is not available on this target");
    }
    return 0;
  }
  let n = node_at(p.nodes, i);
  let a0 = n.a;
  let x = named_fn(&mut c, &mut m, p, i, a0);
  if c.failed {
    return 0;
  }
  note_call(&mut c, x);
  let xi = inst_at(m, x);
  let ps = fn_params(&mut m, p, xi.def, x);
  let dn = node_at(p.nodes, xi.def);
  let r = conv(&mut m, p, dn.b, x, xi.def);
  if r != c.tunit {
    vec_free(ps);
    if cm_new(&mut c, p, a0, C_TYPE) {
      cm_s(&mut c, "`");
      cm_inst(&mut c, m, p, x);
      cm_s(&mut c, "` must return nothing to run on every processor");
    }
    return 0;
  }
  let mut j = 0;
  while j < vec_len(ps) {
    let t = vec_get(ps, j);
    let k = kind_t(m, t);
    let ik = kind_t(m, inner_t(m, t));
    let mut ok = false;
    if k == TY_MUTREF {
      ok = ik == TY_CPU || ik == TY_MMU;
    } else if k == TY_REF {
      ok = !is_pinned(c, m, p, inner_t(m, t));
    }
    if !ok {
      // Each parameter must be `&mut Cpu`, `&mut Mmu` (every processor
      // gets its own) or a shared borrow of a value with no `Cpu` or `Mmu`.
      vec_free(ps);
      if cm_new(&mut c, p, a0, C_PIN) {
        cm_s(&mut c, "`");
        cm_inst(&mut c, m, p, x);
        cm_s(&mut c, "` cannot run on every processor: its parameter of type ");
        cm_ty(&mut c, m, p, t);
        cm_s(&mut c, " would be shared between them");
        cm_note(&mut c, "each parameter must be `&mut Cpu`, `&mut Mmu` (every processor gets its own) or a shared borrow `&T` of a value with no `Cpu` or `Mmu` in it");
      }
      return 0;
    }
    j = j + 1;
  }
  let mut args = vec_new[u64]();
  let mut a = next_of(p, a0);
  while a != 0 {
    vec_push(&mut args, a);
    a = next_of(p, a);
  }
  let t = call_with_v(&mut c, &mut m, p, ps, r, args, i, x);
  vec_free(ps);
  vec_free(args);
  return t;
}

/// A call of a `Vec` builtin: its signature is for the element type of
/// the vector its first argument names.
fn vec_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let s = n.s;
  let e = n.e;
  if span_is(p, s, e, "vec_new") {
    if cm_new(&mut c, p, i, C_TYPE) {
      cm_s(&mut c, "write the element type: `vec_new[T]()`");
    }
    return 0;
  }
  let a0 = n.a;
  let mut pk = 0;
  if a0 != 0 {
    let an = node_at(p.nodes, a0);
    if an.kind == E_MUTBORROW {
      pk = list_path(&mut c, p, an.a);
    } else {
      pk = place_of(&mut c, p, a0);
    }
  }
  if pk == 0 {
    if cm_new(&mut c, p, i, C_TYPE) {
      cm_s(&mut c, "the first argument of `");
      cm_name(&mut c, p, i);
      cm_s(&mut c, "` must name a vector");
    }
    return 0;
  }
  let vt = path_type(&mut c, m, p, pk, i);
  if c.failed {
    return 0;
  }
  if kind_t(m, vt) != TY_VEC {
    cm_call_needs(&mut c, m, p, a0, i, "` needs a Vec, found ", vt);
    return 0;
  }
  let el = inner_t(m, vt);
  let rv = ref_to(&mut m, p, vt);
  let mv = mut_to(&mut m, p, vt);
  let mut ps = vec_new[u64]();
  let mut r = c.tunit;
  if span_is(p, s, e, "vec_len") {
    vec_push(&mut ps, rv);
    r = c.tu64;
  } else if span_is(p, s, e, "vec_push") {
    vec_push(&mut ps, mv);
    vec_push(&mut ps, el);
  } else if span_is(p, s, e, "vec_pop") {
    vec_push(&mut ps, mv);
    r = el;
  } else if span_is(p, s, e, "vec_swap") {
    vec_push(&mut ps, mv);
    vec_push(&mut ps, c.tu64);
    vec_push(&mut ps, el);
    r = el;
  } else if span_is(p, s, e, "vec_free") {
    vec_push(&mut ps, vt);
  } else if ck_linear(c, m, p, el) {
    vec_free(ps);
    let is_get = span_is(p, s, e, "vec_get");
    let mut code = C_LEAK;
    if is_get {
      code = C_USE;
    }
    if cm_new(&mut c, p, i, code) {
      cm_s(&mut c, "`");
      cm_name(&mut c, p, i);
      if is_get {
        cm_s(&mut c, "` would copy a linear ");
      } else {
        cm_s(&mut c, "` would drop a linear ");
      }
      cm_ty(&mut c, m, p, el);
      cm_note(&mut c, "use `vec_swap` to exchange an element, or `vec_pop`");
    }
    return 0;
  } else if span_is(p, s, e, "vec_get") {
    vec_push(&mut ps, rv);
    vec_push(&mut ps, c.tu64);
    r = el;
  } else {
    vec_push(&mut ps, mv);
    vec_push(&mut ps, c.tu64);
    vec_push(&mut ps, el);
  }
  let t = call_with(&mut c, &mut m, p, ps, r, a0, i, 0);
  vec_free(ps);
  return t;
}

/// Checks a call's arguments (list `args`) against the parameter types
/// `ps`: scalars first, then borrows, then moves, so a scalar argument may
/// read a value that a later argument consumes (`set(b, i, get(b, j))`).
/// The function called is instance `fx`, or the builtin call `loc` names
/// when `fx` is 0.
fn call_with(c: &mut Checker, m: &mut Mono, p: &Parser, ps: &Vec[u64], r: u64, args: u64, loc: u64, fx: u64) -> u64 {
  let mut v = vec_new[u64]();
  let mut a = args;
  while a != 0 {
    vec_push(&mut v, a);
    a = next_of(p, a);
  }
  let t = call_with_v(&mut c, &mut m, p, ps, r, v, loc, fx);
  vec_free(v);
  return t;
}

/// `call_with` over the argument nodes `args`, in order.
fn call_with_v(c: &mut Checker, m: &mut Mono, p: &Parser, ps: &Vec[u64], r: u64, args: &Vec[u64], loc: u64, fx: u64) -> u64 {
  let builtin = fx == 0;
  if vec_len(args) != vec_len(ps) {
    if cm_new(&mut c, p, loc, C_TYPE) {
      cm_s(&mut c, "`");
      cm_callee(&mut c, m, p, loc, fx);
      cm_s(&mut c, "` takes ");
      cm_num(&mut c, vec_len(ps));
      cm_s(&mut c, " argument(s), ");
      cm_num(&mut c, vec_len(args));
      cm_s(&mut c, " given");
    }
    return 0;
  }
  let mut j = 0;
  while j < vec_len(args) && !c.failed {
    let a = vec_get(args, j);
    let pt = u_at(ps, j);
    if !ck_linear(c, m, p, pt) && !ck_ref(m, pt) {
      let t = ck_expr_as(&mut c, &mut m, p, a, pt);
      // A builtin's u64 parameter (an index, a length, a value) takes any
      // narrower unsigned value: widening is free.
      let widens = builtin && pt == c.tu64 && is_int(m, t) && !is_signed(m, t);
      if !c.failed && !widens && cm_mismatch(&mut c, p, t, pt, a) {
        cm_arg_of(&mut c, m, p, loc, fx);
        cm_must(&mut c, m, p, pt, t);
      }
    }
    j = j + 1;
  }
  if c.failed {
    return 0;
  }
  // Borrows: a place lent as `&mut` may not overlap any other borrow in
  // the same call (a place overlaps its fields).
  let mut bp = vec_new[u64]();
  let mut bm = vec_new[u64]();
  j = 0;
  while j < vec_len(args) && !c.failed {
    let a = vec_get(args, j);
    let pt = u_at(ps, j);
    if ck_ref(m, pt) {
      borrow_arg(&mut c, m, p, pt, a, &mut bp, &mut bm, loc, fx);
    }
    j = j + 1;
  }
  j = 0;
  while j < vec_len(args) && !c.failed {
    let a = vec_get(args, j);
    let pt = u_at(ps, j);
    if ck_linear(c, m, p, pt) {
      let pk = place_of(&mut c, p, a);
      if pk != 0 && overlaps_any(c, pk, bp) {
        if cm_new(&mut c, p, a, C_USE) {
          cm_s(&mut c, "`");
          cm_place(&mut c, p, pk);
          cm_s(&mut c, "` is both borrowed and moved in this call");
        }
      } else {
        let t = ck_expr(&mut c, &mut m, p, a);
        if !c.failed && cm_mismatch(&mut c, p, t, pt, a) {
          cm_arg_of(&mut c, m, p, loc, fx);
          cm_must(&mut c, m, p, pt, t);
        }
      }
    }
    j = j + 1;
  }
  vec_free(bp);
  vec_free(bm);
  if c.failed {
    return 0;
  }
  return r;
}

/// The name of the function called: instance `fx`, or the builtin call
/// `loc` names.
fn cm_callee(c: &mut Checker, m: &Mono, p: &Parser, loc: u64, fx: u64) {
  if fx != 0 {
    cm_inst(&mut c, m, p, fx);
  } else {
    cm_name(&mut c, p, loc);
  }
}

/// "argument of `f`"
fn cm_arg_of(c: &mut Checker, m: &Mono, p: &Parser, loc: u64, fx: u64) {
  cm_s(&mut c, "argument of `");
  cm_callee(&mut c, m, p, loc, fx);
  cm_s(&mut c, "`");
}

fn overlaps_any(c: &Checker, k: u64, bp: &Vec[u64]) -> bool {
  let mut j = 0;
  while j < vec_len(bp) {
    if overlaps(c, k, vec_get(bp, j)) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

/// Argument `a` lent to a parameter of borrow type `pt`; the places lent
/// so far in the call are `bp` (with `bm` saying which were `&mut`).
/// The call is to instance `fx`, or the builtin call `loc` names.
fn borrow_arg(c: &mut Checker, m: &Mono, p: &Parser, pt: u64, a: u64, bp: &mut Vec[u64], bm: &mut Vec[u64], loc: u64, fx: u64) {
  let an = node_at(p.nodes, a);
  let mut_p = kind_t(m, pt) == TY_MUTREF;
  let mut pk = 0;
  if an.kind == E_MUTBORROW && mut_p {
    pk = list_path(&mut c, p, an.a);
  } else if !mut_p {
    pk = place_of(&mut c, p, a);
  }
  if pk == 0 {
    if cm_new(&mut c, p, a, C_TYPE) {
      cm_arg_of(&mut c, m, p, loc, fx);
      if mut_p {
        cm_s(&mut c, " must be `&mut x` for a variable or field `x`");
      } else {
        cm_s(&mut c, " must name a value to borrow");
      }
    }
    return;
  }
  let t = path_type(&mut c, m, p, pk, a);
  if c.failed {
    return;
  }
  if t != base_t(m, pt) {
    if cm_new(&mut c, p, a, C_TYPE) {
      cm_arg_of(&mut c, m, p, loc, fx);
      cm_must(&mut c, m, p, base_t(m, pt), t);
    }
    return;
  }
  let vr = root_var(c, p, pk);
  if mut_p {
    if kind_t(m, vr.vty) == TY_REF {
      if cm_new(&mut c, p, a, C_USE) {
        cm_s(&mut c, "`");
        cm_place(&mut c, p, vr.path);
        cm_s(&mut c, "` is a shared borrow and cannot be lent as `&mut`");
      }
      return;
    }
    if !vr.mutable {
      cm_not_mut(&mut c, p, a, vr.path);
      return;
    }
  }
  if prefix_moved(c, pk) != 0 {
    if cm_new(&mut c, p, a, C_USE) {
      cm_s(&mut c, "`");
      cm_place(&mut c, p, pk);
      cm_s(&mut c, "` is borrowed after it was consumed");
    }
    return;
  }
  if desc_moved(c, pk) {
    if cm_new(&mut c, p, a, C_USE) {
      cm_s(&mut c, "`");
      cm_place(&mut c, p, pk);
      cm_s(&mut c, "` is borrowed after its field `");
      cm_place(&mut c, p, cm_desc_first(c, p, pk));
      cm_s(&mut c, "` was moved out");
    }
    return;
  }
  let mut j = 0;
  while j < vec_len(bp) && j < vec_len(bm) {
    let q = vec_get(bp, j);
    if overlaps(c, pk, q) && (vec_get(bm, j) == 1 || mut_p) {
      if cm_new(&mut c, p, a, C_USE) {
        cm_s(&mut c, "`");
        cm_place(&mut c, p, q);
        if q == pk {
          cm_s(&mut c, "` is lent as `&mut` while also borrowed in this call");
        } else {
          cm_s(&mut c, "` and `");
          cm_place(&mut c, p, pk);
          cm_s(&mut c, "` overlap, and one of them is lent as `&mut` in this call");
        }
      }
      return;
    }
    j = j + 1;
  }
  vec_push(&mut bp, pk);
  if mut_p {
    vec_push(&mut bm, 1);
  } else {
    vec_push(&mut bm, 0);
  }
}

// ---- Specifications ----

/// Does an argument that stands for a linear value name one?
fn spec_named(p: &Parser, i: u64) -> bool {
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_VAR || k == E_STR || k == E_BLOB {
    return true;
  }
  if k == E_CALL && name_is(p, i, "old") {
    return list_len(p, n.a) == 1 && kind_of(p, n.a) == E_VAR;
  }
  if k == E_CALL && name_is(p, i, "vget") {
    return list_len(p, n.a) == 2 && spec_named(p, n.a);
  }
  if k == E_FIELD {
    return spec_named(p, n.a);
  }
  return false;
}

/// A specification expression: ghost, never consumes. `ens` says whether
/// it is in an `ensures` clause.
fn ck_spec(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, ens: bool) -> u64 {
  if c.failed {
    return 0;
  }
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_TAPP && kind_of(p, n.b) == E_CALL && generic_spec(p, n.b) != 0 {
    let x = tapp_inst(&mut m, p, i, c.env);
    if m.failed {
      cfail(&mut c, p, i, C_TYPE);              // not reached: monomorphization made it
      return 0;
    }
    if spec_visible(c, m, x) {
      let xi = inst_at(m, x);
      return spec_fn_call(&mut c, &mut m, p, n.b, xi.def, x, ens);
    }
  }
  if k == E_TAPP {
    // A generic instance cannot be called or built in a specification
    // (stage0 has renamed it by now), nor can a typed builtin.
    if is_typed_builtin(p, n.b) {
      if cm_new(&mut c, p, i, C_TYPE) {
        cm_s(&mut c, "`vec_new` cannot be called in a specification");
      }
    } else if cm_new(&mut c, p, n.b, C_TYPE) {
      if kind_of(p, n.b) == E_CALL {
        cm_s(&mut c, "`");
        cm_name(&mut c, p, n.b);
        cm_s(&mut c, "[");
        let mut q = n.a;
        while q != 0 {
          if q != n.a {
            cm_s(&mut c, ", ");
          }
          let qt = conv(&mut m, p, q, c.env, i);
          cm_ty(&mut c, m, p, qt);
          q = next_of(p, q);
        }
        cm_s(&mut c, "]");
        cm_not_in_spec(&mut c);
      } else {
        cm_s(&mut c, "struct and enum values cannot be built in a specification");
      }
    }
    return 0;
  }
  if k == E_INT {
    return c.tu64;
  }
  if k == E_BOOL {
    return c.tbool;
  }
  if k == E_STR || k == E_BLOB {
    return c.tstr;
  }
  if k == E_IS {
    let t = ck_spec(&mut c, &mut m, p, n.a, ens);
    if c.failed {
      return 0;
    }
    let x = inner_t(m, t);
    let dn = def_node(m, p, x);
    if !(kind_t(m, t) == TY_ENUM && names_enum(m, p, n.s, n.e, x) && index_in(p, dn.a, n.s2, n.e2) != 0) {
      cm_is_needs(&mut c, m, p, i, i, t);
      return 0;
    }
    return c.tbool;
  }
  if k == E_FIELD {
    let t = ck_spec(&mut c, &mut m, p, n.a, ens);
    if c.failed {
      return 0;
    }
    let mut u = t;
    while kind_t(m, u) == TY_BOX {
      u = inner_t(m, u);
    }
    let ku = kind_t(m, u);
    if ku == TY_STRUCT || ku == TY_ENUM {
      // In a specification, `o.V` is the payload of variant V.
      let x = inner_t(m, u);
      let dn = def_node(m, p, x);
      let j = index_in(p, dn.a, n.s, n.e);
      if j != 0 && fld_ty(c, x, j - 1) != 0 {
        return fld_ty(c, x, j - 1);
      }
    }
    if cm_new(&mut c, p, i, C_TYPE) {
      if ku == TY_STRUCT || ku == TY_ENUM {
        cm_s(&mut c, "`");
        cm_ty(&mut c, m, p, u);
        if ku == TY_STRUCT {
          cm_s(&mut c, "` has no field `");
        } else {
          cm_s(&mut c, "` has no variant `");
        }
        cm_name(&mut c, p, i);
        if ku == TY_STRUCT {
          cm_s(&mut c, "`");
        } else {
          cm_s(&mut c, "` with a payload");
        }
      } else {
        cm_ty(&mut c, m, p, u);
        cm_s(&mut c, " has no fields");
      }
    }
    return 0;
  }
  if k == E_VAR {
    if is_bound(c, p, n.s, n.e) {
      return c.tu64;
    }
    if span_is(p, n.s, n.e, "result") {
      if !ens || c.ret == c.tunit {
        if cm_new(&mut c, p, i, C_TYPE) {
          if !ens {
            cm_s(&mut c, "`result` is only allowed in `ensures`");
          } else {
            cm_s(&mut c, "this function returns nothing, so `result` does not exist");
          }
        }
        return 0;
      }
      return c.ret;
    }
    let v = find_var(c, p, n.s, n.e);
    if v == 0 {
      cm_unknown_var(&mut c, p, i);
      return 0;
    }
    if c.old_only && v > c.nparams {
      if cm_new(&mut c, p, i, C_TYPE) {
        cm_s(&mut c, "`old(..)` in a loop invariant can only name the function's parameters");
      }
      return 0;
    }
    let vr = var_at(c, v - 1);
    return base_t(m, vr.vty);
  }
  if k == E_NOT {
    let t = ck_spec(&mut c, &mut m, p, n.a, ens);
    if !c.failed {
      expect_ty(&mut c, m, p, t, c.tbool, n.a, "the operand of `!`");
    }
    return c.tbool;
  }
  if k == E_NEG {
    let t = ck_spec(&mut c, &mut m, p, n.a, ens);
    if !c.failed && !is_int(m, t) {
      cm_needs(&mut c, m, p, i, "unary minus needs an integer, found ", t);
    }
    return c.tu64;
  }
  if k == E_BIN {
    if is_bitwise(n.v) {
      if cm_new(&mut c, p, i, C_TYPE) {
        cm_s(&mut c, "`");
        cm_op(&mut c, n.v);
        cm_s(&mut c, "` is not available in specifications yet");
      }
      return 0;
    }
    let ta = ck_spec(&mut c, &mut m, p, n.a, ens);
    let tb = ck_spec(&mut c, &mut m, p, n.b, ens);
    if c.failed {
      return 0;
    }
    return bin_type(&mut c, m, p, n.v, spec_norm(c, m, ta), spec_norm(c, m, tb), i);
  }
  if k == E_FORALL {
    if find_var(c, p, n.s, n.e) != 0 || is_bound(c, p, n.s, n.e) {
      cm_shadow(&mut c, p, i, n.s, n.e);
      return 0;
    }
    vec_push(&mut c.bound, i);
    let t = ck_spec(&mut c, &mut m, p, n.a, ens);
    if vec_len(c.bound) > 0 {
      vec_pop(&mut c.bound);
    }
    if !c.failed {
      expect_ty(&mut c, m, p, t, c.tbool, n.a, "the body of `forall`");
    }
    return c.tbool;
  }
  if k == E_CALL {
    return spec_call(&mut c, &mut m, p, i, ens);
  }
  // `&mut`, or a struct or enum value being built.
  if cm_new(&mut c, p, i, C_TYPE) {
    if k == E_MUTBORROW {
      cm_s(&mut c, "`&mut` has no meaning in a specification");
    } else if k == E_SLIT || k == E_VARIANT {
      cm_s(&mut c, "struct and enum values cannot be built in a specification");
    }
  }
  return 0;
}

/// The argument of a linear-valued position must name a value.
fn check_lin(c: &mut Checker, p: &Parser, a: u64) {
  if !spec_named(p, a) && cm_new(&mut c, p, a, C_TYPE) {
    cm_s(&mut c, "a value in this position must be a variable, a field of one, `result` or `old(x)`");
  }
}

/// An index argument: an integer.
fn spec_index(c: &mut Checker, m: &mut Mono, p: &Parser, a: u64, ens: bool) {
  let t = ck_spec(&mut c, &mut m, p, a, ens);
  if !c.failed {
    expect_ty(&mut c, m, p, spec_norm(c, m, t), c.tu64, a, "an index");
  }
}

/// ", K given": the end of "`f` takes N argument(s)" for spec call `i`
/// with `want` parameters.
fn cm_spec_arity(c: &mut Checker, p: &Parser, i: u64, want: u64, na: u64) {
  if cm_new(&mut c, p, i, C_TYPE) {
    cm_s(&mut c, "`");
    cm_name(&mut c, p, i);
    cm_s(&mut c, "` takes ");
    cm_num(&mut c, want);
    cm_s(&mut c, " argument(s), ");
    cm_num(&mut c, na);
    cm_s(&mut c, " given");
  }
}

/// " cannot be called in a specification (allowed: ..)"
fn cm_not_in_spec(c: &mut Checker) {
  cm_s(&mut c, "` cannot be called in a specification (allowed: len, get, slen, sget, blen, bget, vlen, vget, vcount, old, ghost accessors and spec fns)");
}

/// "argument of `f` must be T" for spec call `i`, then ", found U" when
/// `got` is not 0.
fn cm_spec_arg(c: &mut Checker, m: &Mono, p: &Parser, loc: u64, i: u64, want: u64, got: u64) {
  if cm_new(&mut c, p, loc, C_TYPE) {
    cm_s(&mut c, "argument of `");
    cm_name(&mut c, p, i);
    cm_s(&mut c, "` must be ");
    cm_ty(&mut c, m, p, want);
    if got != 0 {
      cm_s(&mut c, ", found ");
      cm_ty(&mut c, m, p, got);
    }
  }
}

/// Is spec fn instance `x` defined before the spec fn being checked?
fn spec_visible(c: &Checker, m: &Mono, x: u64) -> bool {
  if c.spec_pos == 0 {
    return true;
  }
  let mut j = 0;
  while j < c.spec_pos - 1 && j < vec_len(m.specs) {
    if vec_get(m.specs, j) == x {
      return true;
    }
    j = j + 1;
  }
  return false;
}

/// A call `i` of spec fn `sf`, generic instance `x` of it when `x` is not 0.
fn spec_fn_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, sf: u64, x: u64, ens: bool) -> u64 {
  let n = node_at(p.nodes, i);
  let na = list_len(p, n.a);
  let sn = node_at(p.nodes, sf);
  if na != list_len(p, sn.a) {
    if cm_new(&mut c, p, i, C_TYPE) {
      cm_s(&mut c, "`");
      cm_callee(&mut c, m, p, i, x);
      cm_s(&mut c, "` takes ");
      cm_num(&mut c, list_len(p, sn.a));
      cm_s(&mut c, " argument(s), ");
      cm_num(&mut c, na);
      cm_s(&mut c, " given");
    }
    return 0;
  }
  let mut q = sn.a;
  let mut a = n.a;
  while q != 0 && a != 0 && !c.failed {
    let qn = node_at(p.nodes, q);
    let bt = base_t(m, conv(&mut m, p, qn.a, x, q));
    let t = ck_spec(&mut c, &mut m, p, a, ens);
    if !c.failed && spec_norm(c, m, t) != spec_norm(c, m, bt) && cm_new(&mut c, p, a, C_TYPE) {
      cm_s(&mut c, "argument of `");
      cm_callee(&mut c, m, p, i, x);
      cm_s(&mut c, "` must be ");
      cm_ty(&mut c, m, p, bt);
      cm_s(&mut c, ", found ");
      cm_ty(&mut c, m, p, spec_norm(c, m, t));
    }
    if !c.failed && ck_linear(c, m, p, bt) {
      check_lin(&mut c, p, a);
    }
    q = qn.next;
    a = next_of(p, a);
  }
  if c.failed {
    return 0;
  }
  return conv(&mut m, p, sn.b, x, sf);
}

fn spec_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, ens: bool) -> u64 {
  let n = node_at(p.nodes, i);
  let s = n.s;
  let e = n.e;
  let na = list_len(p, n.a);
  let a0 = n.a;
  let a1 = next_of(p, a0);
  if span_is(p, s, e, "old") {
    if na != 1 {
      cm_spec_arity(&mut c, p, i, 1, na);
      return 0;
    }
    if c.inv {
      // The values at the call: only parameters have one.
      c.inv = false;
      c.old_only = true;
      let t = ck_spec(&mut c, &mut m, p, a0, false);
      c.old_only = false;
      c.inv = true;
      return t;
    }
    if !ens {
      if cm_new(&mut c, p, i, C_TYPE) {
        cm_s(&mut c, "`old(..)` is only allowed in `ensures` and loop invariants");
      }
      return 0;
    }
    return ck_spec(&mut c, &mut m, p, a0, false);
  }
  let sf = find_spec(c, p, s, e);
  if sf != 0 {
    return spec_fn_call(&mut c, &mut m, p, i, sf, 0, ens);
  }
  let g = ghost_index(c, p, s, e);
  if g != 0 {
    let gh = ghost_at(c, g - 1);
    let mut want = 1;
    if gh.idx {
      want = 2;
    }
    if na != want {
      cm_spec_arity(&mut c, p, i, want, na);
      return 0;
    }
    let t = ck_spec(&mut c, &mut m, p, a0, ens);
    if !c.failed && t != gh.arg {
      cm_spec_arg(&mut c, m, p, a0, i, gh.arg, t);
    }
    if !c.failed {
      check_lin(&mut c, p, a0);
    }
    if !c.failed && gh.idx {
      spec_index(&mut c, &mut m, p, a1, ens);
    }
    return gh.ret;
  }
  if span_is(p, s, e, "vcount") {
    // The number of elements equal to a value: integer elements only, so
    // that equality is plain.
    if na != 2 {
      cm_spec_arity(&mut c, p, i, 2, na);
      return 0;
    }
    let t = ck_spec(&mut c, &mut m, p, a0, ens);
    if !c.failed && kind_t(m, t) != TY_VEC && cm_new(&mut c, p, a0, C_TYPE) {
      cm_s(&mut c, "argument of `vcount` must be a Vec, found ");
      cm_ty(&mut c, m, p, t);
    }
    if !c.failed && !is_int(m, inner_t(m, t)) && cm_new(&mut c, p, a0, C_TYPE) {
      cm_s(&mut c, "`vcount` counts the elements of a vector of integers, not of ");
      cm_ty(&mut c, m, p, t);
    }
    if !c.failed {
      check_lin(&mut c, p, a0);
    }
    if c.failed {
      return 0;
    }
    let tx = ck_spec(&mut c, &mut m, p, a1, ens);
    if !c.failed {
      expect_ty(&mut c, m, p, spec_norm(c, m, tx), c.tu64, a1, "the value counted");
    }
    if c.failed {
      return 0;
    }
    return c.tu64;
  }
  if span_is(p, s, e, "vlen") || span_is(p, s, e, "vget") {
    let is_len = span_is(p, s, e, "vlen");
    let mut want = 2;
    if is_len {
      want = 1;
    }
    if na != want {
      cm_spec_arity(&mut c, p, i, want, na);
      return 0;
    }
    let t = ck_spec(&mut c, &mut m, p, a0, ens);
    if !c.failed && kind_t(m, t) != TY_VEC && cm_new(&mut c, p, a0, C_TYPE) {
      cm_s(&mut c, "argument of `");
      cm_name(&mut c, p, i);
      cm_s(&mut c, "` must be a Vec, found ");
      cm_ty(&mut c, m, p, t);
    }
    if !c.failed {
      check_lin(&mut c, p, a0);
    }
    if c.failed {
      return 0;
    }
    if is_len {
      return c.tu64;
    }
    spec_index(&mut c, &mut m, p, a1, ens);
    return inner_t(m, t);
  }
  if !(span_is(p, s, e, "len") || span_is(p, s, e, "get") || span_is(p, s, e, "slen")
       || span_is(p, s, e, "sget") || span_is(p, s, e, "blen") || span_is(p, s, e, "bget")) {
    if cm_new(&mut c, p, i, C_TYPE) {
      cm_s(&mut c, "`");
      cm_name(&mut c, p, i);
      cm_not_in_spec(&mut c);
    }
    return 0;
  }
  let bi = bs_index(c, p, s, e);
  if bi == 0 {
    cfail(&mut c, p, i, C_TYPE);              // not reached: these are all builtins
    return 0;
  }
  let bs = bs_at(c, bi - 1);
  if na != bs.np {
    cm_spec_arity(&mut c, p, i, bs.np, na);
    return 0;
  }
  let tb = ck_spec(&mut c, &mut m, p, a0, ens);
  if !c.failed && tb != base_t(m, bs.p0) {
    cm_spec_arg(&mut c, m, p, a0, i, base_t(m, bs.p0), 0);
  }
  if !c.failed {
    check_lin(&mut c, p, a0);
  }
  if !c.failed && na == 2 {
    spec_index(&mut c, &mut m, p, a1, ens);
  }
  return c.tu64;
}
