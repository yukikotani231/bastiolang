// Type and linearity checking, as stage0/src/check.rs does it, on the
// program as the monomorphizer left it (every function an instance).
//
// stage0 stops at the first error, so this does too: an error is recorded
// once (`cfail`) and every function returns as soon as one is.
//
// Ownership is tracked per place, as in stage0: a place is a variable with
// a chain of field names (`p`, `p.root`, `p.inner.buf`), interned in
// `Checker.paths`, and `Checker.moved` is the set of places that have been
// consumed. Sets of places are vectors without repeats.
import "mono.bastio";

const C_TYPE: u64 = 1;
const C_USE: u64 = 2;
const C_LEAK: u64 = 3;
const C_BRANCH: u64 = 4;
const C_MATCH: u64 = 5;
const C_TARGET: u64 = 6;

const TARGET_HOSTED: u64 = 0;
const TARGET_KERNEL: u64 = 1;
const TARGET_USER: u64 = 2;

// Where a builtin is available.
const AV_ALL: u64 = 0;
const AV_HOSTED: u64 = 1;
const AV_MEM: u64 = 2;       // hosted and kernel
const AV_KERNEL: u64 = 3;
const AV_USER: u64 = 4;

/// A builtin's signature: up to four parameter types.
struct Bsig { name: Str, avail: u64, np: u64, p0: u64, p1: u64, p2: u64, p3: u64, ret: u64 }

/// A ghost accessor (specifications only): its argument type, whether it
/// also takes an index, and its result type.
struct Ghost { name: Str, arg: u64, idx: bool, ret: u64 }

/// A place: the field `s..e` of place `up`, or the variable `s..e` when
/// `up` is 0.
struct Path { up: u64, s: u64, e: u64 }

/// A variable in scope; `path` is its place.
struct Var { s: u64, e: u64, path: u64, vty: u64, mutable: bool }

struct Checker {
  bs: Vec[Bsig],
  ghosts: Vec[Ghost],
  /// The field (or payload) types of each struct and enum instance: those
  /// of instance x start at `ftys[fstart[x] - 1]`; a variant without a
  /// payload has type 0.
  fstart: Vec[u64],
  ftys: Vec[u64],
  /// Places; index 0 is unused.
  paths: Vec[Path],
  /// The variables in scope, innermost last.
  vars: Vec[Var],
  moved: Vec[u64],
  /// The variables bound by enclosing `forall`s (their nodes).
  bound: Vec[u64],
  target: u64,
  /// The return type of the function being checked.
  ret: u64,
  /// The instance being checked (0 for a spec fn).
  env: u64,
  /// Only the spec fns before this one are visible (0: all of them).
  spec_lim: u64,
  tu64: u64,
  tbool: u64,
  tunit: u64,
  tstr: u64,
  failed: bool,
  efile: u64,
  eline: u64,
  ecol: u64,
  ecode: u64
}

fn checker_free(c: Checker) {
  vec_free(c.bs);
  vec_free(c.ghosts);
  vec_free(c.fstart);
  vec_free(c.ftys);
  vec_free(c.paths);
  vec_free(c.vars);
  vec_free(c.moved);
  vec_free(c.bound);
}

fn bsig(c: &mut Checker, name: Str, avail: u64, np: u64, p0: u64, p1: u64, p2: u64, p3: u64, ret: u64) {
  vec_push(&mut c.bs, Bsig { name: name, avail: avail, np: np, p0: p0, p1: p1, p2: p2, p3: p3, ret: ret });
}

fn ghost(c: &mut Checker, name: Str, arg: u64, idx: bool, ret: u64) {
  vec_push(&mut c.ghosts, Ghost { name: name, arg: arg, idx: idx, ret: ret });
}

fn prim(m: &mut Mono, p: &Parser, kind: u64) -> u64 {
  return intern(&mut m, p, kind, 0);
}

fn ref_to(m: &mut Mono, p: &Parser, t: u64) -> u64 {
  return intern(&mut m, p, TY_REF, t);
}

fn mut_to(m: &mut Mono, p: &Parser, t: u64) -> u64 {
  return intern(&mut m, p, TY_MUTREF, t);
}

/// A checker for the program monomorphized into `m`, on `target`.
fn checker_new(m: &mut Mono, p: &Parser, target: u64) -> Checker {
  let u = prim(&mut m, p, TY_U64);
  let b = prim(&mut m, p, TY_BOOL);
  let un = prim(&mut m, p, TY_UNIT);
  let st = prim(&mut m, p, TY_STR);
  let mut paths = vec_new[Path]();
  vec_push(&mut paths, Path { up: 0, s: 0, e: 0 });
  let mut c = Checker {
    bs: vec_new[Bsig](), ghosts: vec_new[Ghost](), fstart: vec_new[u64](), ftys: vec_new[u64](),
    paths: paths, vars: vec_new[Var](), moved: vec_new[u64](), bound: vec_new[u64](),
    target: target, ret: un, env: 0, spec_lim: 0, tu64: u, tbool: b, tunit: un, tstr: st,
    failed: false, efile: 0, eline: 0, ecol: 0, ecode: 0
  };
  let buf = prim(&mut m, p, TY_BUF);
  let byt = prim(&mut m, p, TY_BYTES);
  let hst = prim(&mut m, p, TY_HOST);
  let chd = prim(&mut m, p, TY_CHILD);
  let ser = prim(&mut m, p, TY_SERIAL);
  let frm = prim(&mut m, p, TY_FRAME);
  let ptb = prim(&mut m, p, TY_PT);
  let pol = prim(&mut m, p, TY_POOL);
  let mmu = prim(&mut m, p, TY_MMU);
  let cpu = prim(&mut m, p, TY_CPU);
  let prt = prim(&mut m, p, TY_PORTS);
  let pio = prim(&mut m, p, TY_PORTIO);
  let rbuf = ref_to(&mut m, p, buf);
  let rbyt = ref_to(&mut m, p, byt);
  let mbyt = mut_to(&mut m, p, byt);
  let rhst = ref_to(&mut m, p, hst);
  let vbyt = intern(&mut m, p, TY_VEC, byt);
  let rvbyt = ref_to(&mut m, p, vbyt);
  let mchd = mut_to(&mut m, p, chd);
  let rser = ref_to(&mut m, p, ser);
  let rpol = ref_to(&mut m, p, pol);
  let mpol = mut_to(&mut m, p, pol);
  let rfrm = ref_to(&mut m, p, frm);
  let mfrm = mut_to(&mut m, p, frm);
  let rptb = ref_to(&mut m, p, ptb);
  let mptb = mut_to(&mut m, p, ptb);
  let rmmu = ref_to(&mut m, p, mmu);
  let mmmu = mut_to(&mut m, p, mmu);
  let rcpu = ref_to(&mut m, p, cpu);
  let mcpu = mut_to(&mut m, p, cpu);
  let mprt = mut_to(&mut m, p, prt);
  let rpio = ref_to(&mut m, p, pio);
  let mpio = mut_to(&mut m, p, pio);
  bsig(&mut c, "alloc", AV_ALL, 1, u, 0, 0, 0, buf);
  bsig(&mut c, "len", AV_ALL, 1, rbuf, 0, 0, 0, u);
  bsig(&mut c, "get", AV_ALL, 2, rbuf, u, 0, 0, u);
  bsig(&mut c, "set", AV_ALL, 3, buf, u, u, 0, buf);
  bsig(&mut c, "free", AV_ALL, 1, buf, 0, 0, 0, un);
  bsig(&mut c, "print", AV_ALL, 1, u, 0, 0, 0, un);
  bsig(&mut c, "balloc", AV_ALL, 1, u, 0, 0, 0, byt);
  bsig(&mut c, "blen", AV_ALL, 1, rbyt, 0, 0, 0, u);
  bsig(&mut c, "bget", AV_ALL, 2, rbyt, u, 0, 0, u);
  bsig(&mut c, "bset", AV_ALL, 3, mbyt, u, u, 0, un);
  bsig(&mut c, "bfree", AV_ALL, 1, byt, 0, 0, 0, un);
  bsig(&mut c, "bfrom", AV_ALL, 1, st, 0, 0, 0, byt);
  bsig(&mut c, "host_argc", AV_HOSTED, 1, rhst, 0, 0, 0, u);
  bsig(&mut c, "host_arg", AV_HOSTED, 2, rhst, u, 0, 0, byt);
  bsig(&mut c, "host_read", AV_HOSTED, 3, rhst, rbyt, mbyt, 0, b);
  bsig(&mut c, "host_write", AV_HOSTED, 3, rhst, rbyt, rbyt, 0, b);
  bsig(&mut c, "host_spawn", AV_HOSTED, 2, rhst, rvbyt, 0, 0, chd);
  bsig(&mut c, "child_write", AV_HOSTED, 2, mchd, rbyt, 0, 0, b);
  bsig(&mut c, "child_close", AV_HOSTED, 1, mchd, 0, 0, 0, un);
  bsig(&mut c, "child_read_line", AV_HOSTED, 2, mchd, mbyt, 0, 0, b);
  bsig(&mut c, "child_wait", AV_HOSTED, 1, chd, 0, 0, 0, u);
  bsig(&mut c, "slen", AV_ALL, 1, st, 0, 0, 0, u);
  bsig(&mut c, "sget", AV_ALL, 2, st, u, 0, 0, u);
  bsig(&mut c, "serial_write", AV_ALL, 2, rser, u, 0, 0, un);
  bsig(&mut c, "serial_read", AV_ALL, 1, rser, 0, 0, 0, u);
  bsig(&mut c, "serial_poll", AV_KERNEL, 1, rser, 0, 0, 0, u);
  bsig(&mut c, "pool_size", AV_MEM, 1, rpol, 0, 0, 0, u);
  bsig(&mut c, "pool_take", AV_MEM, 2, mpol, u, 0, 0, frm);
  bsig(&mut c, "pool_give", AV_MEM, 2, mpol, frm, 0, 0, un);
  bsig(&mut c, "frame_id", AV_MEM, 1, rfrm, 0, 0, 0, u);
  bsig(&mut c, "frame_read", AV_MEM, 2, rfrm, u, 0, 0, u);
  bsig(&mut c, "frame_write", AV_MEM, 3, mfrm, u, u, 0, un);
  bsig(&mut c, "frame_read8", AV_MEM, 2, rfrm, u, 0, 0, u);
  bsig(&mut c, "frame_write8", AV_MEM, 3, mfrm, u, u, 0, un);
  bsig(&mut c, "pt_new", AV_MEM, 2, frm, u, 0, 0, ptb);
  bsig(&mut c, "pt_free", AV_MEM, 1, ptb, 0, 0, 0, frm);
  bsig(&mut c, "pt_free_root", AV_KERNEL, 2, rmmu, ptb, 0, 0, frm);
  bsig(&mut c, "pt_has", AV_MEM, 2, rptb, u, 0, 0, b);
  bsig(&mut c, "pt_put", AV_MEM, 3, mptb, u, ptb, 0, un);
  bsig(&mut c, "pt_take", AV_MEM, 2, mptb, u, 0, 0, ptb);
  bsig(&mut c, "pt_put_frame", AV_MEM, 4, mptb, u, frm, b, un);
  bsig(&mut c, "pt_take_frame", AV_MEM, 2, mptb, u, 0, 0, frm);
  bsig(&mut c, "mmu_switch", AV_KERNEL, 2, mmmu, rptb, 0, 0, un);
  bsig(&mut c, "mmu_kernel", AV_KERNEL, 1, mmmu, 0, 0, 0, un);
  bsig(&mut c, "cpu_run", AV_KERNEL, 2, mcpu, rmmu, 0, 0, u);
  bsig(&mut c, "cpu_idle", AV_KERNEL, 1, mcpu, 0, 0, 0, u);
  bsig(&mut c, "cpu_get", AV_KERNEL, 2, rcpu, u, 0, 0, u);
  bsig(&mut c, "cpu_set", AV_KERNEL, 3, mcpu, u, u, 0, un);
  bsig(&mut c, "cpu_fpu_save", AV_KERNEL, 2, mcpu, mfrm, 0, 0, un);
  bsig(&mut c, "cpu_fpu_load", AV_KERNEL, 2, mcpu, rfrm, 0, 0, un);
  bsig(&mut c, "cpu_count", AV_KERNEL, 1, rcpu, 0, 0, 0, u);
  bsig(&mut c, "port_claim", AV_MEM, 3, mprt, u, u, 0, pio);
  bsig(&mut c, "port_release", AV_MEM, 2, mprt, pio, 0, 0, un);
  bsig(&mut c, "port_base", AV_MEM, 1, rpio, 0, 0, 0, u);
  bsig(&mut c, "port_count", AV_MEM, 1, rpio, 0, 0, 0, u);
  bsig(&mut c, "pio_in8", AV_MEM, 2, mpio, u, 0, 0, u);
  bsig(&mut c, "pio_in16", AV_MEM, 2, mpio, u, 0, 0, u);
  bsig(&mut c, "pio_in32", AV_MEM, 2, mpio, u, 0, 0, u);
  bsig(&mut c, "pio_out8", AV_MEM, 3, mpio, u, u, 0, un);
  bsig(&mut c, "pio_out16", AV_MEM, 3, mpio, u, u, 0, un);
  bsig(&mut c, "pio_out32", AV_MEM, 3, mpio, u, u, 0, un);
  bsig(&mut c, "sys_spawn", AV_USER, 3, rbuf, u, u, 0, u);
  bsig(&mut c, "sys_wait", AV_USER, 1, u, 0, 0, 0, u);
  bsig(&mut c, "sys_kill", AV_USER, 1, u, 0, 0, 0, u);
  bsig(&mut c, "sys_yield", AV_USER, 0, 0, 0, 0, 0, un);
  bsig(&mut c, "sys_getpid", AV_USER, 0, 0, 0, 0, 0, u);
  bsig(&mut c, "sys_info", AV_USER, 1, u, 0, 0, 0, u);
  bsig(&mut c, "sys_ps", AV_USER, 0, 0, 0, 0, 0, un);
  bsig(&mut c, "sys_poweroff", AV_USER, 0, 0, 0, 0, 0, un);
  bsig(&mut c, "sys_call", AV_USER, 3, u, u, u, 0, u);
  bsig(&mut c, "sys_send", AV_USER, 4, u, u, rbyt, u, u);
  bsig(&mut c, "sys_recv", AV_USER, 3, u, u, mbyt, 0, u);
  ghost(&mut c, "frame_id", frm, false, u);
  ghost(&mut c, "pt_id", ptb, false, u);
  ghost(&mut c, "pt_level", ptb, false, u);
  ghost(&mut c, "pt_used", ptb, true, b);
  ghost(&mut c, "pool_has", pol, true, b);
  ghost(&mut c, "pool_size", pol, false, u);
  ghost(&mut c, "mmu_root", mmu, false, u);
  ghost(&mut c, "port_base", pio, false, u);
  ghost(&mut c, "port_count", pio, false, u);
  ghost(&mut c, "port_free", prt, true, b);
  field_types(&mut c, &mut m, p);
  return c;
}

/// Fills in `fstart` and `ftys` for every struct and enum instance.
fn field_types(c: &mut Checker, m: &mut Mono, p: &Parser) {
  let mut k = 0;
  while k < vec_len(m.insts) {
    vec_push(&mut c.fstart, 0);
    k = k + 1;
  }
  k = 0;
  while k < ndefs(m) {
    let x = def_at(m, k);
    if x < vec_len(c.fstart) {
      vec_set(&mut c.fstart, x, vec_len(c.ftys) + 1);
    }
    let xi = inst_at(m, x);
    let dn = node_at(p.nodes, xi.def);
    let mut f = dn.a;
    while f != 0 {
      let fd = node_at(p.nodes, f);
      let mut t = 0;
      if fd.a != 0 {
        t = conv(&mut m, p, fd.a, x, xi.def);
      }
      vec_push(&mut c.ftys, t);
      f = fd.next;
    }
    k = k + 1;
  }
}

/// The number of struct and enum instances.
fn ndefs(m: &Mono) -> u64 {
  if vec_len(m.structs) > SRC_MAX || vec_len(m.enums) > SRC_MAX {
    return 0;
  }
  return vec_len(m.structs) + vec_len(m.enums);
}

/// The k-th struct or enum instance of the program: the structs, then the enums.
fn def_at(m: &Mono, k: u64) -> u64 {
  let ns = vec_len(m.structs);
  if k < ns {
    return vec_get(m.structs, k);
  }
  if k - ns < vec_len(m.enums) {
    return vec_get(m.enums, k - ns);
  }
  return 0;
}

// ---- Small helpers ----

fn u_at(v: &Vec[u64], i: u64) -> u64 {
  if i < vec_len(v) {
    return vec_get(v, i);
  }
  return 0;
}

fn has_id(v: &Vec[u64], x: u64) -> bool {
  let mut k = 0;
  while k < vec_len(v) {
    if vec_get(v, k) == x {
      return true;
    }
    k = k + 1;
  }
  return false;
}

fn copy_set(v: &Vec[u64]) -> Vec[u64] {
  let mut out = vec_new[u64]();
  let mut k = 0;
  while k < vec_len(v) {
    vec_push(&mut out, vec_get(v, k));
    k = k + 1;
  }
  return out;
}

/// Do `a` and `b` (vectors without repeats) hold the same elements?
fn same_set(a: &Vec[u64], b: &Vec[u64]) -> bool {
  if vec_len(a) != vec_len(b) {
    return false;
  }
  let mut k = 0;
  while k < vec_len(a) {
    if !has_id(b, vec_get(a, k)) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

fn add_id(v: &mut Vec[u64], x: u64) {
  if !has_id(v, x) {
    vec_push(&mut v, x);
  }
}

fn union_into(a: &mut Vec[u64], b: &Vec[u64]) {
  let mut k = 0;
  while k < vec_len(b) {
    add_id(&mut a, vec_get(b, k));
    k = k + 1;
  }
}

fn set_moved(c: &mut Checker, v: Vec[u64]) {
  let prev = c.moved;
  c.moved = v;
  vec_free(prev);
}

fn kind_t(m: &Mono, t: u64) -> u64 {
  let x = ty_at(m, t);
  return x.kind;
}

fn inner_t(m: &Mono, t: u64) -> u64 {
  let x = ty_at(m, t);
  return x.a;
}

fn ck_ref(m: &Mono, t: u64) -> bool {
  let k = kind_t(m, t);
  return k == TY_REF || k == TY_MUTREF;
}

/// The type with any borrow removed.
fn base_t(m: &Mono, t: u64) -> u64 {
  if ck_ref(m, t) {
    return inner_t(m, t);
  }
  return t;
}

/// The j-th field (or payload) type of instance `x`.
fn fld_ty(c: &Checker, x: u64, j: u64) -> u64 {
  let st = u_at(c.fstart, x);
  if st == 0 || st > SRC_MAX || j > SRC_MAX {
    return 0;
  }
  return u_at(c.ftys, st - 1 + j);
}

/// The index + 1 of the node named `s..e` in the list from `head`, or 0.
fn index_in(p: &Parser, head: u64, s: u64, e: u64) -> u64 {
  let mut k = head;
  let mut j = 0;
  while k != 0 && j < SRC_MAX {
    let n = node_at(p.nodes, k);
    if same(p.src, n.s, n.e, s, e) {
      return j + 1;
    }
    k = n.next;
    j = j + 1;
  }
  return 0;
}

fn def_node(m: &Mono, p: &Parser, x: u64) -> Node {
  let xi = inst_at(m, x);
  return node_at(p.nodes, xi.def);
}

/// Is a value of type `t` linear (must it be consumed exactly once)?
fn ck_linear(c: &Checker, m: &Mono, p: &Parser, t: u64) -> bool {
  let k = kind_t(m, t);
  if (k >= TY_BUF && k <= TY_PORTIO) || k == TY_BOX || k == TY_VEC {
    return true;
  }
  if k == TY_STRUCT || k == TY_ENUM {
    let x = inner_t(m, t);
    let dn = def_node(m, p, x);
    let n = list_len(p, dn.a);
    let mut j = 0;
    while j < n {
      let ft = fld_ty(c, x, j);
      if ft != 0 && ck_linear(c, m, p, ft) {
        return true;
      }
      j = j + 1;
    }
  }
  return false;
}

/// Records an error at node `loc`, unless one is recorded already.
fn cfail(c: &mut Checker, p: &Parser, loc: u64, code: u64) {
  if !c.failed {
    let n = node_at(p.nodes, loc);
    c.failed = true;
    c.efile = n.file;
    c.eline = n.line;
    c.ecol = n.col;
    c.ecode = code;
  }
}

fn expect_ty(c: &mut Checker, p: &Parser, got: u64, want: u64, loc: u64) {
  if got != want {
    cfail(&mut c, p, loc, C_TYPE);
  }
}

// ---- Names ----

fn span_is(p: &Parser, s: u64, e: u64, w: Str) -> bool {
  if s <= e && e <= blen(p.src) {
    return spells(p.src, s, e, w);
  }
  return false;
}

fn bs_at(c: &Checker, k: u64) -> Bsig {
  if k < vec_len(c.bs) {
    return vec_get(c.bs, k);
  }
  return Bsig { name: "", avail: 0, np: 0, p0: 0, p1: 0, p2: 0, p3: 0, ret: 0 };
}

fn ghost_at(c: &Checker, k: u64) -> Ghost {
  if k < vec_len(c.ghosts) {
    return vec_get(c.ghosts, k);
  }
  return Ghost { name: "", arg: 0, idx: false, ret: 0 };
}

/// The builtin named `s..e` in the table: its index + 1, or 0.
fn bs_index(c: &Checker, p: &Parser, s: u64, e: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(c.bs) {
    let b = vec_get(c.bs, k);
    if span_is(p, s, e, b.name) {
      return k + 1;
    }
    k = k + 1;
  }
  return 0;
}

fn ghost_index(c: &Checker, p: &Parser, s: u64, e: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(c.ghosts) {
    let g = vec_get(c.ghosts, k);
    if span_is(p, s, e, g.name) {
      return k + 1;
    }
    k = k + 1;
  }
  return 0;
}

fn is_vec_builtin(p: &Parser, s: u64, e: u64) -> bool {
  return span_is(p, s, e, "vec_new") || span_is(p, s, e, "vec_len") || span_is(p, s, e, "vec_push")
    || span_is(p, s, e, "vec_pop") || span_is(p, s, e, "vec_get") || span_is(p, s, e, "vec_set")
    || span_is(p, s, e, "vec_swap") || span_is(p, s, e, "vec_free");
}

fn is_builtin_name(c: &Checker, p: &Parser, s: u64, e: u64) -> bool {
  return span_is(p, s, e, "box") || span_is(p, s, e, "unbox") || is_vec_builtin(p, s, e) || bs_index(c, p, s, e) != 0;
}

/// `result` and `old` belong to specifications.
fn is_spec_word(p: &Parser, s: u64, e: u64) -> bool {
  return span_is(p, s, e, "result") || span_is(p, s, e, "old");
}

/// The first function named `s..e`, when it is not generic; otherwise 0.
fn plain_fn(p: &Parser, s: u64, e: u64) -> u64 {
  let mut k = p.fns.head;
  while k != 0 {
    let n = node_at(p.nodes, k);
    if same(p.src, n.s, n.e, s, e) {
      if n.v != 0 {
        return 0;
      }
      return k;
    }
    k = n.next;
  }
  return 0;
}

/// Is `s..e` the name of a function with a signature (a builtin in the
/// table or a function that is not generic)?
fn sigs_has(c: &Checker, p: &Parser, s: u64, e: u64) -> bool {
  return bs_index(c, p, s, e) != 0 || plain_fn(p, s, e) != 0;
}

/// The visible spec fn named `s..e`, or 0.
fn find_spec(c: &Checker, p: &Parser, s: u64, e: u64) -> u64 {
  let mut k = p.specs.head;
  while k != 0 && k != c.spec_lim {
    let n = node_at(p.nodes, k);
    if same(p.src, n.s, n.e, s, e) {
      return k;
    }
    k = n.next;
  }
  return 0;
}

fn any_spec(p: &Parser, s: u64, e: u64) -> bool {
  return index_in(p, p.specs.head, s, e) != 0;
}

fn var_at(c: &Checker, j: u64) -> Var {
  if j < vec_len(c.vars) {
    return vec_get(c.vars, j);
  }
  return Var { s: 0, e: 0, path: 0, vty: 0, mutable: false };
}

/// The variable named `s..e` in scope: its index + 1, or 0.
fn find_var(c: &Checker, p: &Parser, s: u64, e: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(c.vars) {
    let v = vec_get(c.vars, k);
    if same(p.src, v.s, v.e, s, e) {
      return k + 1;
    }
    k = k + 1;
  }
  return 0;
}

fn is_bound(c: &Checker, p: &Parser, s: u64, e: u64) -> bool {
  let mut k = 0;
  while k < vec_len(c.bound) {
    let n = node_at(p.nodes, vec_get(c.bound, k));
    if same(p.src, n.s, n.e, s, e) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

/// Does `s..e` name the enum that instance `x` is an instance of? (A
/// generic enum may be written without its type arguments.)
fn names_enum(m: &Mono, p: &Parser, s: u64, e: u64, x: u64) -> bool {
  let d = def_node(m, p, x);
  return same(p.src, s, e, d.s, d.e);
}

// ---- Places ----

fn path_at(c: &Checker, k: u64) -> Path {
  if k < vec_len(c.paths) {
    return vec_get(c.paths, k);
  }
  return Path { up: 0, s: 0, e: 0 };
}

/// The place `up.s..e` (the variable `s..e` when `up` is 0).
fn ck_path(c: &mut Checker, p: &Parser, up: u64, s: u64, e: u64) -> u64 {
  let mut k = 1;
  while k < vec_len(c.paths) {
    let x = vec_get(c.paths, k);
    if x.up == up && same(p.src, x.s, x.e, s, e) {
      return k;
    }
    k = k + 1;
  }
  let n = vec_len(c.paths);
  vec_push(&mut c.paths, Path { up: up, s: s, e: e });
  return n;
}

/// The place expression `i` is (a variable or a field of one), or 0.
fn place_of(c: &mut Checker, p: &Parser, i: u64) -> u64 {
  let n = node_at(p.nodes, i);
  if n.kind == E_VAR {
    return ck_path(&mut c, p, 0, n.s, n.e);
  }
  if n.kind == E_FIELD {
    let b = place_of(&mut c, p, n.a);
    if b == 0 {
      return 0;
    }
    return ck_path(&mut c, p, b, n.s, n.e);
  }
  return 0;
}

/// The place a dotted list of names (`x.f.g`) spells.
fn list_path(c: &mut Checker, p: &Parser, head: u64) -> u64 {
  let mut k = head;
  let mut r = 0;
  while k != 0 {
    let n = node_at(p.nodes, k);
    r = ck_path(&mut c, p, r, n.s, n.e);
    k = n.next;
  }
  return r;
}

/// The variable place `k` starts from.
fn root_var(c: &Checker, p: &Parser, k: u64) -> Var {
  let mut q = k;
  let mut x = path_at(c, q);
  while x.up != 0 {
    q = x.up;
    x = path_at(c, q);
  }
  let v = find_var(c, p, x.s, x.e);
  if v == 0 {
    return var_at(c, vec_len(c.vars));
  }
  return var_at(c, v - 1);
}

fn in_moved(c: &Checker, k: u64) -> bool {
  return has_id(c.moved, k);
}

/// The moved place that `k` is or lies inside, or 0.
fn prefix_moved(c: &Checker, k: u64) -> u64 {
  let mut q = k;
  while q != 0 {
    if in_moved(c, q) {
      return q;
    }
    let x = path_at(c, q);
    q = x.up;
  }
  return 0;
}

/// Does place `a` lie strictly inside place `b`?
fn inside(c: &Checker, a: u64, b: u64) -> bool {
  let x = path_at(c, a);
  let mut q = x.up;
  while q != 0 {
    if q == b {
      return true;
    }
    let y = path_at(c, q);
    q = y.up;
  }
  return false;
}

/// Has a place strictly inside `k` been moved?
fn desc_moved(c: &Checker, k: u64) -> bool {
  let mut j = 0;
  while j < vec_len(c.moved) {
    if inside(c, vec_get(c.moved, j), k) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

fn overlaps(c: &Checker, a: u64, b: u64) -> bool {
  return a == b || inside(c, a, b) || inside(c, b, a);
}

fn mark(c: &mut Checker, k: u64) {
  add_id(&mut c.moved, k);
}

/// Place `k` holds a whole value again.
fn unmove(c: &mut Checker, k: u64) {
  let mut keep = vec_new[u64]();
  let mut j = 0;
  while j < vec_len(c.moved) {
    let q = vec_get(c.moved, j);
    if q != k && !inside(c, q, k) {
      vec_push(&mut keep, q);
    }
    j = j + 1;
  }
  set_moved(&mut c, keep);
}

/// The type at place `k`; errors are reported at node `loc`.
fn path_type(c: &mut Checker, m: &Mono, p: &Parser, k: u64, loc: u64) -> u64 {
  let x = path_at(c, k);
  if x.up == 0 {
    let v = find_var(c, p, x.s, x.e);
    if v == 0 {
      cfail(&mut c, p, loc, C_TYPE);          // unknown variable
      return 0;
    }
    let vr = var_at(c, v - 1);
    return base_t(m, vr.vty);
  }
  let t = path_type(&mut c, m, p, x.up, loc);
  if c.failed {
    return 0;
  }
  // A box is looked through: `b.f` is the field `f` of the boxed struct.
  let mut u = t;
  while kind_t(m, u) == TY_BOX {
    u = inner_t(m, u);
  }
  if kind_t(m, u) == TY_STRUCT {
    let y = inner_t(m, u);
    let dn = def_node(m, p, y);
    let j = index_in(p, dn.a, x.s, x.e);
    if j != 0 {
      return fld_ty(c, y, j - 1);
    }
  }
  cfail(&mut c, p, loc, C_TYPE);              // no such field
  return 0;
}

/// A place used as a value: moved if it is linear, copied otherwise.
fn use_place(c: &mut Checker, m: &Mono, p: &Parser, k: u64, loc: u64) -> u64 {
  let t = path_type(&mut c, m, p, k, loc);
  if c.failed {
    return 0;
  }
  let vr = root_var(c, p, k);
  if prefix_moved(c, k) != 0 {
    cfail(&mut c, p, loc, C_USE);             // used after it was consumed
    return 0;
  }
  if ck_linear(c, m, p, t) {
    if kind_t(m, vr.vty) == TY_REF {
      cfail(&mut c, p, loc, C_USE);           // a move out of a shared borrow
      return 0;
    }
    if desc_moved(c, k) {
      cfail(&mut c, p, loc, C_USE);           // a field of it was moved out
      return 0;
    }
    mark(&mut c, k);
  }
  return t;
}

/// Is nothing left to own at place `k` (of type `t`)? It was moved, or
/// (for a struct) every linear field in it was.
fn consumed(c: &mut Checker, m: &Mono, p: &Parser, k: u64, t: u64) -> bool {
  if !ck_linear(c, m, p, t) || prefix_moved(c, k) != 0 {
    return true;
  }
  if kind_t(m, t) == TY_STRUCT {
    let x = inner_t(m, t);
    let dn = def_node(m, p, x);
    let mut f = dn.a;
    let mut j = 0;
    while f != 0 && j < SRC_MAX {
      let fd = node_at(p.nodes, f);
      let fk = ck_path(&mut c, p, k, fd.s, fd.e);
      if !consumed(&mut c, m, p, fk, fld_ty(c, x, j)) {
        return false;
      }
      f = fd.next;
      j = j + 1;
    }
    return true;
  }
  return false;
}

/// Adds the consumed linear leaves of place `k` (of type `t`) to `out`.
fn leaves(c: &mut Checker, m: &Mono, p: &Parser, k: u64, t: u64, out: &mut Vec[u64], depth: u64) {
  if depth > 1000 || !ck_linear(c, m, p, t) {
    return;
  }
  let kd = kind_t(m, t);
  if kd == TY_STRUCT {
    let x = inner_t(m, t);
    let dn = def_node(m, p, x);
    let mut f = dn.a;
    let mut j = 0;
    while f != 0 && j < SRC_MAX {
      let fd = node_at(p.nodes, f);
      let fk = ck_path(&mut c, p, k, fd.s, fd.e);
      leaves(&mut c, m, p, fk, fld_ty(c, x, j), &mut out, depth + 1);
      f = fd.next;
      j = j + 1;
    }
  } else if kd == TY_BOX && prefix_moved(c, k) == 0 {
    // The box itself is a resource, and so is what is inside it.
    leaves(&mut c, m, p, k, inner_t(m, t), &mut out, depth + 1);
  } else if prefix_moved(c, k) != 0 {
    add_id(&mut out, k);
  }
}

/// The consumed linear leaves of every variable in scope: the ownership
/// state, whether a struct was moved whole or field by field.
fn own_state(c: &mut Checker, m: &Mono, p: &Parser) -> Vec[u64] {
  let mut out = vec_new[u64]();
  let mut j = 0;
  while j < vec_len(c.vars) {
    let vr = var_at(c, j);
    if kind_t(m, vr.vty) != TY_REF {
      leaves(&mut c, m, p, vr.path, base_t(m, vr.vty), &mut out, 0);
    }
    j = j + 1;
  }
  return out;
}

/// No owned linear value may be left at `loc`, and every `&mut`
/// parameter must hold a value again.
fn leak_check_all(c: &mut Checker, m: &Mono, p: &Parser, loc: u64) {
  let mut j = 0;
  while j < vec_len(c.vars) {
    let vr = var_at(c, j);
    if ck_linear(c, m, p, vr.vty) && !consumed(&mut c, m, p, vr.path, vr.vty) {
      cfail(&mut c, p, loc, C_LEAK);
      return;
    }
    j = j + 1;
  }
  j = 0;
  while j < vec_len(c.vars) {
    let vr = var_at(c, j);
    if kind_t(m, vr.vty) == TY_MUTREF && (prefix_moved(c, vr.path) != 0 || desc_moved(c, vr.path)) {
      cfail(&mut c, p, loc, C_USE);
      return;
    }
    j = j + 1;
  }
}

/// Is a variable declared from index `start` on still owning a value?
fn scope_leaks(c: &mut Checker, m: &Mono, p: &Parser, start: u64) -> bool {
  let mut j = start;
  while j < vec_len(c.vars) {
    let vr = var_at(c, j);
    if ck_linear(c, m, p, vr.vty) && !consumed(&mut c, m, p, vr.path, vr.vty) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

/// Ends the scope of the variables from index `start` on.
fn pop_scope(c: &mut Checker, start: u64) {
  let mut j = start;
  while j < vec_len(c.vars) {
    let vr = var_at(c, j);
    unmove(&mut c, vr.path);
    j = j + 1;
  }
  while vec_len(c.vars) > start {
    vec_pop(&mut c.vars);
  }
}

fn declare(c: &mut Checker, p: &Parser, s: u64, e: u64, t: u64, mutable: bool, loc: u64) {
  if is_spec_word(p, s, e) {
    cfail(&mut c, p, loc, C_TYPE);            // reserved for specifications
    return;
  }
  // A name may be reused once its earlier binding's scope has ended, but
  // never shadow one still in scope.
  if find_var(c, p, s, e) != 0 || sigs_has(c, p, s, e) || ghost_index(c, p, s, e) != 0 || find_spec(c, p, s, e) != 0 {
    cfail(&mut c, p, loc, C_TYPE);
    return;
  }
  let k = ck_path(&mut c, p, 0, s, e);
  vec_push(&mut c.vars, Var { s: s, e: e, path: k, vty: t, mutable: mutable });
}

/// A type written in the program must name a known type.
fn known_type(c: &mut Checker, m: &Mono, p: &Parser, t: u64, loc: u64) {
  let k = kind_t(m, t);
  if k == TY_UNKNOWN {
    cfail(&mut c, p, loc, C_TYPE);
  } else if k == TY_BOX || k == TY_VEC || k == TY_REF || k == TY_MUTREF {
    known_type(&mut c, m, p, inner_t(m, t), loc);
  }
}

// ---- Definitions and signatures ----

fn is_reserved_type(p: &Parser, s: u64, e: u64) -> bool {
  return span_is(p, s, e, "u64") || span_is(p, s, e, "bool") || span_is(p, s, e, "Str")
    || span_is(p, s, e, "Buf") || span_is(p, s, e, "Bytes") || span_is(p, s, e, "Host")
    || span_is(p, s, e, "Child") || span_is(p, s, e, "Serial") || span_is(p, s, e, "Frame")
    || span_is(p, s, e, "PageTable") || span_is(p, s, e, "Pool") || span_is(p, s, e, "Mmu")
    || span_is(p, s, e, "Cpu") || span_is(p, s, e, "Ports") || span_is(p, s, e, "PortIo");
}

/// Struct and enum instances: no reserved names, known field and payload
/// types, no type that contains itself.
fn check_structs(c: &mut Checker, m: &Mono, p: &Parser) {
  let total = ndefs(m);
  let mut k = 0;
  while k < total && !c.failed {
    let x = def_at(m, k);
    let xi = inst_at(m, x);
    let d = node_at(p.nodes, xi.def);
    if xi.n == 0 && is_reserved_type(p, d.s, d.e) {
      cfail(&mut c, p, xi.def, C_TYPE);       // already defined
      return;
    }
    let n = list_len(p, d.a);
    let mut j = 0;
    while j < n {
      let mut u = fld_ty(c, x, j);
      while kind_t(m, u) == TY_BOX || kind_t(m, u) == TY_VEC {
        u = inner_t(m, u);
      }
      if u != 0 && kind_t(m, u) == TY_UNKNOWN {
        cfail(&mut c, p, xi.def, C_TYPE);     // unknown type
        return;
      }
      j = j + 1;
    }
    k = k + 1;
  }
  k = 0;
  while k < total && !c.failed {
    let x = def_at(m, k);
    let mut seen = vec_new[u64]();
    let r = reaches(c, m, p, x, x, &mut seen);
    vec_free(seen);
    if r {
      let xi = inst_at(m, x);
      cfail(&mut c, p, xi.def, C_TYPE);       // contains itself
    }
    k = k + 1;
  }
}

/// Does instance `from` hold `target` directly, or through types it holds
/// directly (not through a box or vector)?
fn reaches(c: &Checker, m: &Mono, p: &Parser, from: u64, target: u64, seen: &mut Vec[u64]) -> bool {
  let dn = def_node(m, p, from);
  let n = list_len(p, dn.a);
  let mut j = 0;
  while j < n {
    let ft = fld_ty(c, from, j);
    let k = kind_t(m, ft);
    if k == TY_STRUCT || k == TY_ENUM {
      let y = inner_t(m, ft);
      if y == target {
        return true;
      }
      if !has_id(seen, y) {
        vec_push(&mut seen, y);
        if reaches(c, m, p, y, target, &mut seen) {
          return true;
        }
      }
    }
    j = j + 1;
  }
  return false;
}

/// May `main` ask for a capability of kind `k` on this target?
fn is_cap(target: u64, k: u64) -> bool {
  if target == TARGET_USER {
    return k == TY_SERIAL;
  }
  if target == TARGET_KERNEL {
    return k == TY_SERIAL || k == TY_POOL || k == TY_MMU || k == TY_CPU || k == TY_PORTS;
  }
  return k == TY_SERIAL || k == TY_POOL || k == TY_HOST || k == TY_PORTS;
}

fn available(avail: u64, target: u64) -> bool {
  if avail == AV_ALL {
    return true;
  }
  if avail == AV_HOSTED {
    return target == TARGET_HOSTED;
  }
  if avail == AV_MEM {
    return target == TARGET_HOSTED || target == TARGET_KERNEL;
  }
  if avail == AV_KERNEL {
    return target == TARGET_KERNEL;
  }
  return target == TARGET_USER;
}

/// Function signatures: known types, no builtin redefined, no borrow
/// returned; and a `main` that suits the target.
fn signatures(c: &mut Checker, m: &mut Mono, p: &Parser) {
  let mut k = 0;
  while k < vec_len(m.fns) && !c.failed {
    let x = u_at(m.fns, k);
    let xi = inst_at(m, x);
    let d = node_at(p.nodes, xi.def);
    let mut q = d.a;
    while q != 0 && !c.failed {
      let qn = node_at(p.nodes, q);
      let t = conv(&mut m, p, qn.a, x, q);
      known_type(&mut c, m, p, t, q);
      q = qn.next;
    }
    if c.failed {
      return;
    }
    let r = conv(&mut m, p, d.b, x, xi.def);
    known_type(&mut c, m, p, r, xi.def);
    if c.failed {
      return;
    }
    if xi.n == 0 && (is_builtin_name(c, p, d.s, d.e) || ghost_index(c, p, d.s, d.e) != 0 || span_is(p, d.s, d.e, "old")) {
      cfail(&mut c, p, xi.def, C_TYPE);       // a builtin redefined
    } else if xi.n == 0 && any_spec(p, d.s, d.e) {
      cfail(&mut c, p, xi.def, C_TYPE);       // defined twice
    } else if ck_ref(m, r) {
      cfail(&mut c, p, xi.def, C_TYPE);       // returns a borrow
    }
    k = k + 1;
  }
  if c.failed {
    return;
  }
  k = 0;
  let mut main_x = 0;
  while k < vec_len(m.fns) && main_x == 0 {
    let x = u_at(m.fns, k);
    let xi = inst_at(m, x);
    if xi.n == 0 && name_is(p, xi.def, "main") {
      main_x = x;
    }
    k = k + 1;
  }
  if main_x == 0 {
    cfail(&mut c, p, 0, C_TYPE);              // no `main`
    return;
  }
  check_main(&mut c, &mut m, p, main_x);
}

fn check_main(c: &mut Checker, m: &mut Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  let d = node_at(p.nodes, xi.def);
  let r = conv(&mut m, p, d.b, x, xi.def);
  let np = list_len(p, d.a);
  let mut legacy = false;
  if np == 1 {
    let q0 = node_at(p.nodes, d.a);
    let t0 = conv(&mut m, p, q0.a, x, d.a);
    legacy = kind_t(m, t0) == TY_SERIAL && kind_t(m, r) == TY_SERIAL;
  }
  let mut caps_ok = kind_t(m, r) == TY_U64 || kind_t(m, r) == TY_UNIT;
  let mut seen = vec_new[u64]();
  let mut q = d.a;
  while q != 0 && caps_ok {
    let qn = node_at(p.nodes, q);
    let t = conv(&mut m, p, qn.a, x, q);
    let ik = kind_t(m, inner_t(m, t));
    if kind_t(m, t) == TY_MUTREF && is_cap(c.target, ik) && !has_id(seen, ik) {
      vec_push(&mut seen, ik);
    } else {
      caps_ok = false;
    }
    q = qn.next;
  }
  vec_free(seen);
  if !(legacy && c.target != TARGET_USER) && !caps_ok {
    cfail(&mut c, p, xi.def, C_TYPE);         // the wrong capabilities
  } else if c.target == TARGET_USER && kind_t(m, r) != TY_U64 {
    cfail(&mut c, p, xi.def, C_TYPE);         // a user program returns its exit code
  }
}

/// Starts checking a function (or spec fn) returning `ret`, in instance `env`.
fn reset(c: &mut Checker, ret: u64, env: u64) {
  while vec_len(c.vars) > 0 {
    vec_pop(&mut c.vars);
  }
  set_moved(&mut c, vec_new[u64]());
  while vec_len(c.bound) > 0 {
    vec_pop(&mut c.bound);
  }
  c.ret = ret;
  c.env = env;
}

/// Checks the program monomorphized into `m`.
fn check_program(c: &mut Checker, m: &mut Mono, p: &Parser) {
  check_structs(&mut c, m, p);
  if c.failed {
    return;
  }
  signatures(&mut c, &mut m, p);
  let mut k = p.specs.head;
  while k != 0 && !c.failed {
    // A spec fn may only call spec fns defined before it.
    c.spec_lim = k;
    check_spec_fn(&mut c, &mut m, p, k);
    k = next_of(p, k);
  }
  c.spec_lim = 0;
  let mut j = 0;
  while j < vec_len(m.fns) && !c.failed {
    check_fn(&mut c, &mut m, p, u_at(m.fns, j));
    j = j + 1;
  }
}

fn check_spec_fn(c: &mut Checker, m: &mut Mono, p: &Parser, k: u64) {
  let sn = node_at(p.nodes, k);
  if sigs_has(c, p, sn.s, sn.e) || ghost_index(c, p, sn.s, sn.e) != 0 || find_spec(c, p, sn.s, sn.e) != 0 {
    cfail(&mut c, p, k, C_TYPE);              // already defined
    return;
  }
  let r = conv(&mut m, p, sn.b, 0, k);
  if r != c.tbool && r != c.tu64 {
    cfail(&mut c, p, k, C_TYPE);              // returns bool or u64
    return;
  }
  reset(&mut c, c.tunit, 0);
  let mut q = sn.a;
  while q != 0 && !c.failed {
    let qn = node_at(p.nodes, q);
    let t = conv(&mut m, p, qn.a, 0, q);
    known_type(&mut c, m, p, t, q);
    if !c.failed && (ck_linear(c, m, p, t) || kind_t(m, t) == TY_MUTREF) {
      cfail(&mut c, p, q, C_TYPE);            // values or shared borrows only
    }
    declare(&mut c, p, qn.s, qn.e, t, false, q);
    q = qn.next;
  }
  if c.failed {
    return;
  }
  let t = ck_spec(&mut c, &mut m, p, sn.c, false);
  if !c.failed {
    expect_ty(&mut c, p, t, r, sn.c);
  }
}

fn check_fn(c: &mut Checker, m: &mut Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  let d = node_at(p.nodes, xi.def);
  let r = conv(&mut m, p, d.b, x, xi.def);
  reset(&mut c, r, x);
  let mut q = d.a;
  while q != 0 && !c.failed {
    let qn = node_at(p.nodes, q);
    let t = conv(&mut m, p, qn.a, x, q);
    if ck_ref(m, t) && qn.v == 1 {
      cfail(&mut c, p, q, C_TYPE);            // a borrow cannot be `mut`
    }
    declare(&mut c, p, qn.s, qn.e, t, qn.v == 1 || kind_t(m, t) == TY_MUTREF, q);
    q = qn.next;
  }
  let mut e = d.c;
  while e != 0 && !c.failed {
    let t = ck_spec(&mut c, &mut m, p, e, false);
    if !c.failed {
      expect_ty(&mut c, p, t, c.tbool, e);
    }
    e = next_of(p, e);
  }
  e = d.d;
  while e != 0 && !c.failed {
    let t = ck_spec(&mut c, &mut m, p, e, true);
    if !c.failed {
      expect_ty(&mut c, p, t, c.tbool, e);
    }
    e = next_of(p, e);
  }
  if c.failed {
    return;
  }
  let div = ck_block(&mut c, &mut m, p, d.x);
  if !c.failed && !div {
    if kind_t(m, r) != TY_UNIT {
      cfail(&mut c, p, xi.def, C_TYPE);       // can reach its end without returning
    } else {
      leak_check_all(&mut c, m, p, xi.def);
    }
  }
}

// ---- Statements ----

/// Checks a block; returns whether it always diverges (returns).
fn ck_block(c: &mut Checker, m: &mut Mono, p: &Parser, head: u64) -> bool {
  let start = vec_len(c.vars);
  let mut div = false;
  let mut k = head;
  let mut last = 0;
  while k != 0 && !c.failed {
    if div {
      cfail(&mut c, p, k, C_TYPE);            // unreachable statement after `return`
      return false;
    }
    div = ck_stmt(&mut c, &mut m, p, k);
    last = k;
    k = next_of(p, k);
  }
  if c.failed {
    return false;
  }
  if !div && scope_leaks(&mut c, m, p, start) {
    cfail(&mut c, p, last, C_LEAK);           // goes out of scope while still owned
    return false;
  }
  pop_scope(&mut c, start);
  return div;
}

fn ck_stmt(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> bool {
  if c.failed {
    return false;
  }
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == S_LET {
    let t = ck_expr(&mut c, &mut m, p, n.b);
    if c.failed {
      return false;
    }
    if n.a != 0 {
      let want = conv(&mut m, p, n.a, c.env, i);
      known_type(&mut c, m, p, want, i);
      if !c.failed && ck_ref(m, want) {
        cfail(&mut c, p, i, C_TYPE);          // a local cannot hold a borrow
      }
      if !c.failed {
        expect_ty(&mut c, p, t, want, n.b);
      }
      if c.failed {
        return false;
      }
    }
    if kind_t(m, t) == TY_UNIT {
      cfail(&mut c, p, n.b, C_TYPE);          // cannot bind ()
      return false;
    }
    vec_push(&mut m.lets, LetTy { env: c.env, node: i, lty: t });
    declare(&mut c, p, n.s, n.e, t, n.v == 1, i);
    return false;
  }
  if k == S_ASSIGN {
    let pk = list_path(&mut c, p, n.a);
    let want = path_type(&mut c, m, p, pk, i);
    if c.failed {
      return false;
    }
    let vr = root_var(c, p, pk);
    if !vr.mutable {
      cfail(&mut c, p, i, C_TYPE);            // not mutable
      return false;
    }
    let t = ck_expr(&mut c, &mut m, p, n.b);
    if !c.failed {
      expect_ty(&mut c, p, t, want, n.b);
    }
    if c.failed {
      return false;
    }
    let pa = path_at(c, pk);
    if pa.up != 0 && prefix_moved(c, pa.up) != 0 {
      cfail(&mut c, p, i, C_USE);             // assigning into a consumed value
      return false;
    }
    if ck_linear(c, m, p, want) {
      if !consumed(&mut c, m, p, pk, want) {
        cfail(&mut c, p, i, C_LEAK);          // would drop the value it still owns
        return false;
      }
      unmove(&mut c, pk);
    }
    return false;
  }
  if k == S_IF {
    return ck_if(&mut c, &mut m, p, i);
  }
  if k == S_WHILE {
    ck_while(&mut c, &mut m, p, i);
    return false;
  }
  if k == S_RETURN {
    let mut t = c.tunit;
    if n.a != 0 {
      t = ck_expr(&mut c, &mut m, p, n.a);
    }
    if !c.failed {
      expect_ty(&mut c, p, t, c.ret, i);
    }
    if !c.failed {
      leak_check_all(&mut c, m, p, i);
    }
    return true;
  }
  if k == S_UNREACHABLE {
    // Proved unreachable, so nothing owned here can leak.
    return true;
  }
  if k == S_ASSERT {
    let t = ck_spec(&mut c, &mut m, p, n.a, false);
    if !c.failed {
      expect_ty(&mut c, p, t, c.tbool, n.a);
    }
    return false;
  }
  if k == S_MATCH {
    return ck_match(&mut c, &mut m, p, i);
  }
  if k == S_EXPR {
    let t = ck_expr(&mut c, &mut m, p, n.a);
    if !c.failed && ck_linear(c, m, p, t) {
      cfail(&mut c, p, i, C_LEAK);            // created and immediately dropped
    }
    return false;
  }
  return false;
}

/// `if`: both branches must leave ownership the same way, unless one of
/// them diverges.
fn ck_if(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> bool {
  let n = node_at(p.nodes, i);
  let t = ck_expr(&mut c, &mut m, p, n.a);
  if !c.failed {
    expect_ty(&mut c, p, t, c.tbool, n.a);
  }
  if c.failed {
    return false;
  }
  let before = copy_set(c.moved);
  let d1 = ck_block(&mut c, &mut m, p, n.b);
  let after_then = copy_set(c.moved);
  set_moved(&mut c, before);
  let d2 = ck_block(&mut c, &mut m, p, n.c);
  if c.failed {
    vec_free(after_then);
    return false;
  }
  if d1 && d2 {
    vec_free(after_then);
    return true;
  }
  if d1 {
    vec_free(after_then);
    return false;
  }
  if d2 {
    set_moved(&mut c, after_then);
    return false;
  }
  let ce = own_state(&mut c, m, p);
  let after_else = copy_set(c.moved);
  set_moved(&mut c, copy_set(after_then));
  let ct = own_state(&mut c, m, p);
  if !same_set(ct, ce) {
    cfail(&mut c, p, i, C_BRANCH);            // consumed in only one branch
  }
  let mut all = after_then;
  union_into(&mut all, after_else);
  set_moved(&mut c, all);
  vec_free(after_else);
  vec_free(ce);
  vec_free(ct);
  return false;
}

/// `while`: the condition consumes nothing, and the body leaves every outer
/// linear value owned as it found it.
fn ck_while(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) {
  let n = node_at(p.nodes, i);
  let before_cond = copy_set(c.moved);
  let t = ck_expr(&mut c, &mut m, p, n.a);
  let changed = !same_set(before_cond, c.moved);
  vec_free(before_cond);
  if c.failed {
    return;
  }
  if changed {
    cfail(&mut c, p, n.a, C_USE);             // the condition runs many times
    return;
  }
  expect_ty(&mut c, p, t, c.tbool, n.a);
  let mut v = n.b;
  while v != 0 && !c.failed {
    let tv = ck_spec(&mut c, &mut m, p, v, false);
    if !c.failed {
      expect_ty(&mut c, p, tv, c.tbool, v);
    }
    v = next_of(p, v);
  }
  if c.failed {
    return;
  }
  let before = copy_set(c.moved);
  let cb = own_state(&mut c, m, p);
  let d = ck_block(&mut c, &mut m, p, n.c);
  if !c.failed {
    let ca = own_state(&mut c, m, p);
    if !d && !same_set(ca, cb) {
      cfail(&mut c, p, i, C_BRANCH);          // the body changes ownership
    }
    vec_free(ca);
  }
  set_moved(&mut c, before);
  vec_free(cb);
}

/// The k-th set of places stored back to back in `outs`, the j-th ending
/// at `ends[j]`.
fn out_set(outs: &Vec[u64], ends: &Vec[u64], k: u64) -> Vec[u64] {
  let mut s = 0;
  if k > 0 {
    s = u_at(ends, k - 1);
  }
  let e = u_at(ends, k);
  let mut r = vec_new[u64]();
  let mut j = s;
  while j < e {
    vec_push(&mut r, u_at(outs, j));
    j = j + 1;
  }
  return r;
}

/// `match`: every variant handled once, each payload bound or, when it is
/// linear, accounted for; the arms must leave ownership the same way.
fn ck_match(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> bool {
  let n = node_at(p.nodes, i);
  let scrut = n.a;
  // A place of a borrowed enum is only inspected; anything else is moved
  // (or copied, when the enum is not linear).
  let pk = place_of(&mut c, p, scrut);
  let mut borrowed = false;
  if pk != 0 {
    path_type(&mut c, m, p, pk, scrut);
    if c.failed {
      return false;
    }
    let vr = root_var(c, p, pk);
    borrowed = kind_t(m, vr.vty) == TY_REF;
  }
  let mut t = 0;
  if borrowed {
    if prefix_moved(c, pk) != 0 {
      cfail(&mut c, p, scrut, C_USE);
      return false;
    }
    t = path_type(&mut c, m, p, pk, scrut);
  } else {
    t = ck_expr(&mut c, &mut m, p, scrut);
  }
  if c.failed {
    return false;
  }
  if kind_t(m, t) != TY_ENUM {
    cfail(&mut c, p, scrut, C_TYPE);          // `match` needs an enum
    return false;
  }
  let x = inner_t(m, t);
  let dn = def_node(m, p, x);
  let owned_linear = !borrowed && ck_linear(c, m, p, t);
  let mut covered = vec_new[u64]();
  let mut wild = false;
  let mut a = n.b;
  while a != 0 && !c.failed {
    let an = node_at(p.nodes, a);
    if wild {
      cfail(&mut c, p, a, C_MATCH);           // after `_`, this arm never runs
    } else if an.v == PAT_WILD {
      let mut vk = dn.a;
      let mut j = 0;
      while vk != 0 && j < SRC_MAX {
        let pt = fld_ty(c, x, j);
        if !has_id(covered, j) && owned_linear && pt != 0 && ck_linear(c, m, p, pt) {
          cfail(&mut c, p, a, C_LEAK);        // `_` would drop a linear payload
        }
        vk = next_of(p, vk);
        j = j + 1;
      }
      wild = true;
    } else if !names_enum(m, p, an.s, an.e, x) {
      cfail(&mut c, p, a, C_TYPE);            // a pattern of another enum
    } else {
      let j = index_in(p, dn.a, an.s2, an.e2);
      if j == 0 {
        cfail(&mut c, p, a, C_TYPE);          // no such variant
      } else if has_id(covered, j - 1) {
        cfail(&mut c, p, a, C_MATCH);         // matched twice
      } else {
        vec_push(&mut covered, j - 1);
        let pt = fld_ty(c, x, j - 1);
        let bind = an.v != PAT_VARIANT;
        if pt == 0 && bind {
          cfail(&mut c, p, a, C_TYPE);        // no payload to bind
        } else if pt != 0 && !bind {
          cfail(&mut c, p, a, C_TYPE);        // a payload left unbound
        } else if pt != 0 && name_is(p, an.a, "_") && ck_linear(c, m, p, pt) && owned_linear {
          cfail(&mut c, p, a, C_LEAK);        // `_` would drop a linear payload
        }
      }
    }
    a = an.next;
  }
  let ncovered = vec_len(covered);
  vec_free(covered);
  if c.failed {
    return false;
  }
  if !wild && ncovered < list_len(p, dn.a) {
    cfail(&mut c, p, i, C_MATCH);             // a variant not handled
    return false;
  }
  // The arms, each from the same ownership state.
  let before = copy_set(c.moved);
  let mut outs = vec_new[u64]();
  let mut ends = vec_new[u64]();
  a = n.b;
  while a != 0 && !c.failed {
    let an = node_at(p.nodes, a);
    set_moved(&mut c, copy_set(before));
    let start = vec_len(c.vars);
    if (an.v == PAT_BIND || an.v == PAT_BIND_MUT) && !name_is(p, an.a, "_") {
      let bn = node_at(p.nodes, an.a);
      let j = index_in(p, dn.a, an.s2, an.e2);
      let mut pt = 0;
      if j != 0 {
        pt = fld_ty(c, x, j - 1);
      }
      // Out of a shared borrow, a linear payload is bound as a shared
      // borrow too: it can be read and lent, never moved.
      if borrowed && ck_linear(c, m, p, pt) {
        if an.v == PAT_BIND_MUT {
          cfail(&mut c, p, a, C_TYPE);        // a borrow cannot be `mut`
        } else {
          let rt = ref_to(&mut m, p, pt);
          declare(&mut c, p, bn.s, bn.e, rt, false, a);
        }
      } else {
        declare(&mut c, p, bn.s, bn.e, pt, an.v == PAT_BIND_MUT, a);
      }
    }
    if !c.failed {
      let d = ck_block(&mut c, &mut m, p, an.c);
      if !c.failed && !d && scope_leaks(&mut c, m, p, start) {
        cfail(&mut c, p, a, C_LEAK);          // the payload is still owned
      }
      if !c.failed {
        pop_scope(&mut c, start);
        if !d {
          let mut j = 0;
          while j < vec_len(c.moved) {
            vec_push(&mut outs, u_at(c.moved, j));
            j = j + 1;
          }
          vec_push(&mut ends, vec_len(outs));
        }
      }
    }
    a = an.next;
  }
  vec_free(before);
  let nouts = vec_len(ends);
  if c.failed || nouts == 0 {
    vec_free(outs);
    vec_free(ends);
    return !c.failed;
  }
  set_moved(&mut c, out_set(outs, ends, 0));
  let c0 = own_state(&mut c, m, p);
  let mut all = vec_new[u64]();
  let mut k = 0;
  while k < nouts {
    let o = out_set(outs, ends, k);
    union_into(&mut all, o);
    set_moved(&mut c, o);
    let ck = own_state(&mut c, m, p);
    if !same_set(ck, c0) {
      cfail(&mut c, p, i, C_BRANCH);          // consumed in only some arms
    }
    vec_free(ck);
    k = k + 1;
  }
  set_moved(&mut c, all);
  vec_free(c0);
  vec_free(outs);
  vec_free(ends);
  return false;
}

// ---- Expressions ----

/// A code expression: linear values in value position are moved.
fn ck_expr(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  return ck_named(&mut c, &mut m, p, i, 0);
}

/// An expression; a call, struct literal or variant names instance `inst`
/// instead of what is written when `inst` is not 0.
fn ck_named(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, inst: u64) -> u64 {
  if c.failed {
    return 0;
  }
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_TAPP {
    if is_typed_builtin(p, n.b) {
      // `vec_new[T]()`: the only builtin that needs its type written.
      let call = node_at(p.nodes, n.b);
      if list_len(p, n.a) != 1 || call.a != 0 {
        cfail(&mut c, p, i, C_TYPE);
        return 0;
      }
      let t = conv(&mut m, p, n.a, c.env, i);
      known_type(&mut c, m, p, t, i);
      if c.failed {
        return 0;
      }
      return intern(&mut m, p, TY_VEC, t);
    }
    let x = tapp_inst(&mut m, p, i, c.env);
    return ck_named(&mut c, &mut m, p, n.b, x);
  }
  if k == E_INT {
    return c.tu64;
  }
  if k == E_BOOL {
    return c.tbool;
  }
  if k == E_STR || k == E_BLOB {
    return c.tstr;
  }
  if k == E_VAR {
    let v = find_var(c, p, n.s, n.e);
    if v == 0 {
      cfail(&mut c, p, i, C_TYPE);            // unknown variable
      return 0;
    }
    let vr = var_at(c, v - 1);
    if kind_t(m, vr.vty) == TY_REF && ck_linear(c, m, p, inner_t(m, vr.vty)) {
      cfail(&mut c, p, i, C_USE);             // a move out of a shared borrow
      return 0;
    }
    let pk = ck_path(&mut c, p, 0, n.s, n.e);
    return use_place(&mut c, m, p, pk, i);
  }
  if k == E_FIELD {
    let pk = place_of(&mut c, p, i);
    if pk == 0 {
      cfail(&mut c, p, i, C_TYPE);            // a field of something not a place
      return 0;
    }
    return use_place(&mut c, m, p, pk, i);
  }
  if k == E_VARIANT {
    return ck_variant(&mut c, &mut m, p, i, inst);
  }
  if k == E_IS {
    return ck_is(&mut c, &mut m, p, i);
  }
  if k == E_SLIT {
    return ck_slit(&mut c, &mut m, p, i, inst);
  }
  if k == E_NOT {
    let t = ck_expr(&mut c, &mut m, p, n.a);
    if !c.failed {
      expect_ty(&mut c, p, t, c.tbool, n.a);
    }
    return c.tbool;
  }
  if k == E_BIN {
    if n.v == P_IMPLIES {
      cfail(&mut c, p, i, C_TYPE);            // `==>` belongs to specifications
      return 0;
    }
    let ta = ck_expr(&mut c, &mut m, p, n.a);
    if c.failed {
      return 0;
    }
    let before = copy_set(c.moved);
    let tb = ck_expr(&mut c, &mut m, p, n.b);
    let changed = !same_set(before, c.moved);
    vec_free(before);
    if c.failed {
      return 0;
    }
    if (n.v == P_ANDAND || n.v == P_OROR) && changed {
      cfail(&mut c, p, n.b, C_USE);           // the right side may not run
      return 0;
    }
    return bin_type(&mut c, p, n.v, ta, tb, i);
  }
  if k == E_CALL {
    return ck_call(&mut c, &mut m, p, i, inst);
  }
  // `&mut x` outside a call's arguments, or `forall` in code.
  cfail(&mut c, p, i, C_TYPE);
  return 0;
}

fn ck_variant(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, inst: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let mut x = inst;
  if x == 0 {
    let d = find_in(p, p.enums.head, i);
    if d == 0 {
      cfail(&mut c, p, i, C_TYPE);            // unknown enum
      return 0;
    }
    x = plain_inst(&mut m, d);
  }
  let dn = def_node(m, p, x);
  let j = index_in(p, dn.a, n.s2, n.e2);
  if j == 0 {
    cfail(&mut c, p, i, C_TYPE);              // no such variant
    return 0;
  }
  let pt = fld_ty(c, x, j - 1);
  if pt != 0 && n.a != 0 {
    let t = ck_expr(&mut c, &mut m, p, n.a);
    if !c.failed {
      expect_ty(&mut c, p, t, pt, n.a);
    }
  } else if pt != 0 || n.a != 0 {
    cfail(&mut c, p, i, C_TYPE);              // a payload missing or extra
  }
  if c.failed {
    return 0;
  }
  return intern(&mut m, p, TY_ENUM, x);
}

/// `e is Enum::Variant` reads the tag only: nothing is consumed.
fn ck_is(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let pk = place_of(&mut c, p, n.a);
  let mut t = 0;
  if pk != 0 {
    if prefix_moved(c, pk) != 0 {
      cfail(&mut c, p, n.a, C_USE);
      return 0;
    }
    t = path_type(&mut c, m, p, pk, n.a);
  } else {
    t = ck_expr(&mut c, &mut m, p, n.a);
    if !c.failed && ck_linear(c, m, p, t) {
      cfail(&mut c, p, n.a, C_LEAK);          // the linear operand would be dropped
    }
  }
  if c.failed {
    return 0;
  }
  if kind_t(m, t) != TY_ENUM || !names_enum(m, p, n.s, n.e, inner_t(m, t)) {
    cfail(&mut c, p, n.a, C_TYPE);
    return 0;
  }
  let dn = def_node(m, p, inner_t(m, t));
  if index_in(p, dn.a, n.s2, n.e2) == 0 {
    cfail(&mut c, p, i, C_TYPE);              // no such variant
    return 0;
  }
  return c.tbool;
}

fn ck_slit(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, inst: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let mut x = inst;
  if x == 0 {
    let d = find_in(p, p.structs.head, i);
    if d == 0 {
      cfail(&mut c, p, i, C_TYPE);            // unknown struct
      return 0;
    }
    x = plain_inst(&mut m, d);
  }
  let dn = def_node(m, p, x);
  let mut f = dn.a;
  while f != 0 {
    let fd = node_at(p.nodes, f);
    if index_in(p, n.a, fd.s, fd.e) == 0 {
      cfail(&mut c, p, i, C_TYPE);            // a field missing
      return 0;
    }
    f = fd.next;
  }
  let mut q = n.a;
  while q != 0 && !c.failed {
    let qn = node_at(p.nodes, q);
    let j = index_in(p, dn.a, qn.s, qn.e);
    if j == 0 {
      cfail(&mut c, p, qn.a, C_TYPE);         // no such field
      return 0;
    }
    let t = ck_expr(&mut c, &mut m, p, qn.a);
    if !c.failed {
      expect_ty(&mut c, p, t, fld_ty(c, x, j - 1), qn.a);
    }
    q = qn.next;
  }
  if c.failed {
    return 0;
  }
  return intern(&mut m, p, TY_STRUCT, x);
}

fn bin_type(c: &mut Checker, p: &Parser, op: u64, a: u64, b: u64, loc: u64) -> u64 {
  if op == P_PLUS || op == P_MINUS || op == P_STAR || op == P_SLASH || op == P_PERCENT {
    if a != c.tu64 || b != c.tu64 {
      cfail(&mut c, p, loc, C_TYPE);
    }
    return c.tu64;
  }
  if op == P_LT || op == P_LE || op == P_GT || op == P_GE {
    if a != c.tu64 || b != c.tu64 {
      cfail(&mut c, p, loc, C_TYPE);
    }
    return c.tbool;
  }
  if op == P_EQEQ || op == P_NE {
    if a != b || (a != c.tu64 && a != c.tbool) {
      cfail(&mut c, p, loc, C_TYPE);          // only u64 and bool compare
    }
    return c.tbool;
  }
  if a != c.tbool || b != c.tbool {
    cfail(&mut c, p, loc, C_TYPE);
  }
  return c.tbool;
}

/// The parameter types of function `d` read in instance `x`.
fn fn_params(m: &mut Mono, p: &Parser, d: u64, x: u64) -> Vec[u64] {
  let mut out = vec_new[u64]();
  let dn = node_at(p.nodes, d);
  let mut q = dn.a;
  while q != 0 {
    let qn = node_at(p.nodes, q);
    vec_push(&mut out, conv(&mut m, p, qn.a, x, q));
    q = qn.next;
  }
  return out;
}

fn bsig_params(b: Bsig) -> Vec[u64] {
  let mut out = vec_new[u64]();
  if b.np > 0 { vec_push(&mut out, b.p0); }
  if b.np > 1 { vec_push(&mut out, b.p1); }
  if b.np > 2 { vec_push(&mut out, b.p2); }
  if b.np > 3 { vec_push(&mut out, b.p3); }
  return out;
}

/// A call to the function of instance `x`.
fn user_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, x: u64) -> u64 {
  let xi = inst_at(m, x);
  let ps = fn_params(&mut m, p, xi.def, x);
  let dn = node_at(p.nodes, xi.def);
  let r = conv(&mut m, p, dn.b, x, xi.def);
  let call = node_at(p.nodes, i);
  let t = call_with(&mut c, &mut m, p, ps, r, call.a, i);
  vec_free(ps);
  return t;
}

fn ck_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, inst: u64) -> u64 {
  if inst != 0 {
    return user_call(&mut c, &mut m, p, i, inst);
  }
  let n = node_at(p.nodes, i);
  let s = n.s;
  let e = n.e;
  if is_spec_word(p, s, e) || (ghost_index(c, p, s, e) != 0 && bs_index(c, p, s, e) == 0) || find_spec(c, p, s, e) != 0 {
    cfail(&mut c, p, i, C_TYPE);              // only allowed in specifications
    return 0;
  }
  if is_vec_builtin(p, s, e) {
    return vec_call(&mut c, &mut m, p, i);
  }
  if span_is(p, s, e, "box") || span_is(p, s, e, "unbox") {
    // Generic over the boxed type, so not in the builtin table.
    if list_len(p, n.a) != 1 {
      cfail(&mut c, p, i, C_TYPE);
      return 0;
    }
    let t = ck_expr(&mut c, &mut m, p, n.a);
    if c.failed {
      return 0;
    }
    if span_is(p, s, e, "box") {
      return intern(&mut m, p, TY_BOX, t);
    }
    if kind_t(m, t) != TY_BOX {
      cfail(&mut c, p, n.a, C_TYPE);          // `unbox` needs a box
      return 0;
    }
    return inner_t(m, t);
  }
  let b = bs_index(c, p, s, e);
  if b != 0 {
    let bs = bs_at(c, b - 1);
    if !available(bs.avail, c.target) {
      cfail(&mut c, p, i, C_TARGET);
      return 0;
    }
    let ps = bsig_params(bs);
    let t = call_with(&mut c, &mut m, p, ps, bs.ret, n.a, i);
    vec_free(ps);
    return t;
  }
  let d = plain_fn(p, s, e);
  if d == 0 {
    cfail(&mut c, p, i, C_TYPE);              // unknown function
    return 0;
  }
  let x = plain_inst(&mut m, d);
  return user_call(&mut c, &mut m, p, i, x);
}

/// A call of a `Vec` builtin: its signature is for the element type of
/// the vector its first argument names.
fn vec_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let s = n.s;
  let e = n.e;
  if span_is(p, s, e, "vec_new") {
    cfail(&mut c, p, i, C_TYPE);              // write `vec_new[T]()`
    return 0;
  }
  let a0 = n.a;
  let mut pk = 0;
  if a0 != 0 {
    let an = node_at(p.nodes, a0);
    if an.kind == E_MUTBORROW {
      pk = list_path(&mut c, p, an.a);
    } else {
      pk = place_of(&mut c, p, a0);
    }
  }
  if pk == 0 {
    cfail(&mut c, p, i, C_TYPE);              // must name a vector
    return 0;
  }
  let vt = path_type(&mut c, m, p, pk, i);
  if c.failed {
    return 0;
  }
  if kind_t(m, vt) != TY_VEC {
    cfail(&mut c, p, a0, C_TYPE);             // needs a Vec
    return 0;
  }
  let el = inner_t(m, vt);
  let rv = ref_to(&mut m, p, vt);
  let mv = mut_to(&mut m, p, vt);
  let mut ps = vec_new[u64]();
  let mut r = c.tunit;
  if span_is(p, s, e, "vec_len") {
    vec_push(&mut ps, rv);
    r = c.tu64;
  } else if span_is(p, s, e, "vec_push") {
    vec_push(&mut ps, mv);
    vec_push(&mut ps, el);
  } else if span_is(p, s, e, "vec_pop") {
    vec_push(&mut ps, mv);
    r = el;
  } else if span_is(p, s, e, "vec_swap") {
    vec_push(&mut ps, mv);
    vec_push(&mut ps, c.tu64);
    vec_push(&mut ps, el);
    r = el;
  } else if span_is(p, s, e, "vec_free") {
    vec_push(&mut ps, vt);
  } else if ck_linear(c, m, p, el) {
    vec_free(ps);
    if span_is(p, s, e, "vec_get") {
      cfail(&mut c, p, i, C_USE);             // would copy a linear element
    } else {
      cfail(&mut c, p, i, C_LEAK);            // would drop a linear element
    }
    return 0;
  } else if span_is(p, s, e, "vec_get") {
    vec_push(&mut ps, rv);
    vec_push(&mut ps, c.tu64);
    r = el;
  } else {
    vec_push(&mut ps, mv);
    vec_push(&mut ps, c.tu64);
    vec_push(&mut ps, el);
  }
  let t = call_with(&mut c, &mut m, p, ps, r, a0, i);
  vec_free(ps);
  return t;
}

/// Checks a call's arguments (list `args`) against the parameter types
/// `ps`: scalars first, then borrows, then moves, so a scalar argument may
/// read a value that a later argument consumes (`set(b, i, get(b, j))`).
fn call_with(c: &mut Checker, m: &mut Mono, p: &Parser, ps: &Vec[u64], r: u64, args: u64, loc: u64) -> u64 {
  if list_len(p, args) != vec_len(ps) {
    cfail(&mut c, p, loc, C_TYPE);            // the wrong number of arguments
    return 0;
  }
  let mut a = args;
  let mut j = 0;
  while a != 0 && !c.failed && j < SRC_MAX {
    let pt = u_at(ps, j);
    if !ck_linear(c, m, p, pt) && !ck_ref(m, pt) {
      let t = ck_expr(&mut c, &mut m, p, a);
      if !c.failed {
        expect_ty(&mut c, p, t, pt, a);
      }
    }
    a = next_of(p, a);
    j = j + 1;
  }
  if c.failed {
    return 0;
  }
  // Borrows: a place lent as `&mut` may not overlap any other borrow in
  // the same call (a place overlaps its fields).
  let mut bp = vec_new[u64]();
  let mut bm = vec_new[u64]();
  a = args;
  j = 0;
  while a != 0 && !c.failed && j < SRC_MAX {
    let pt = u_at(ps, j);
    if ck_ref(m, pt) {
      borrow_arg(&mut c, m, p, pt, a, &mut bp, &mut bm);
    }
    a = next_of(p, a);
    j = j + 1;
  }
  a = args;
  j = 0;
  while a != 0 && !c.failed && j < SRC_MAX {
    let pt = u_at(ps, j);
    if ck_linear(c, m, p, pt) {
      let pk = place_of(&mut c, p, a);
      if pk != 0 && overlaps_any(c, pk, bp) {
        cfail(&mut c, p, a, C_USE);           // both borrowed and moved
      } else {
        let t = ck_expr(&mut c, &mut m, p, a);
        if !c.failed {
          expect_ty(&mut c, p, t, pt, a);
        }
      }
    }
    a = next_of(p, a);
    j = j + 1;
  }
  vec_free(bp);
  vec_free(bm);
  if c.failed {
    return 0;
  }
  return r;
}

fn overlaps_any(c: &Checker, k: u64, bp: &Vec[u64]) -> bool {
  let mut j = 0;
  while j < vec_len(bp) {
    if overlaps(c, k, vec_get(bp, j)) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

/// Argument `a` lent to a parameter of borrow type `pt`; the places lent
/// so far in the call are `bp` (with `bm` saying which were `&mut`).
fn borrow_arg(c: &mut Checker, m: &Mono, p: &Parser, pt: u64, a: u64, bp: &mut Vec[u64], bm: &mut Vec[u64]) {
  let an = node_at(p.nodes, a);
  let mut_p = kind_t(m, pt) == TY_MUTREF;
  let mut pk = 0;
  if an.kind == E_MUTBORROW && mut_p {
    pk = list_path(&mut c, p, an.a);
  } else if !mut_p {
    pk = place_of(&mut c, p, a);
  }
  if pk == 0 {
    cfail(&mut c, p, a, C_TYPE);              // must name a value to borrow
    return;
  }
  let t = path_type(&mut c, m, p, pk, a);
  if c.failed {
    return;
  }
  if t != base_t(m, pt) {
    cfail(&mut c, p, a, C_TYPE);
    return;
  }
  let vr = root_var(c, p, pk);
  if mut_p {
    if kind_t(m, vr.vty) == TY_REF {
      cfail(&mut c, p, a, C_USE);             // a shared borrow lent as `&mut`
      return;
    }
    if !vr.mutable {
      cfail(&mut c, p, a, C_TYPE);            // not mutable
      return;
    }
  }
  if prefix_moved(c, pk) != 0 || desc_moved(c, pk) {
    cfail(&mut c, p, a, C_USE);               // borrowed after a move
    return;
  }
  let mut j = 0;
  while j < vec_len(bp) && j < vec_len(bm) {
    if overlaps(c, pk, vec_get(bp, j)) && (vec_get(bm, j) == 1 || mut_p) {
      cfail(&mut c, p, a, C_USE);             // overlapping borrows, one `&mut`
      return;
    }
    j = j + 1;
  }
  vec_push(&mut bp, pk);
  if mut_p {
    vec_push(&mut bm, 1);
  } else {
    vec_push(&mut bm, 0);
  }
}

// ---- Specifications ----

/// Does an argument that stands for a linear value name one?
fn spec_named(p: &Parser, i: u64) -> bool {
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_VAR || k == E_STR || k == E_BLOB {
    return true;
  }
  if k == E_CALL && name_is(p, i, "old") {
    return list_len(p, n.a) == 1 && kind_of(p, n.a) == E_VAR;
  }
  if k == E_CALL && name_is(p, i, "vget") {
    return list_len(p, n.a) == 2 && spec_named(p, n.a);
  }
  if k == E_FIELD {
    return spec_named(p, n.a);
  }
  return false;
}

/// A specification expression: ghost, never consumes. `ens` says whether
/// it is in an `ensures` clause.
fn ck_spec(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, ens: bool) -> u64 {
  if c.failed {
    return 0;
  }
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_TAPP {
    // A generic instance cannot be called or built in a specification
    // (stage0 has renamed it by now), nor can `vec_new[T]()`.
    if is_typed_builtin(p, n.b) {
      cfail(&mut c, p, i, C_TYPE);
    } else {
      cfail(&mut c, p, n.b, C_TYPE);
    }
    return 0;
  }
  if k == E_INT {
    return c.tu64;
  }
  if k == E_BOOL {
    return c.tbool;
  }
  if k == E_STR || k == E_BLOB {
    return c.tstr;
  }
  if k == E_IS {
    let t = ck_spec(&mut c, &mut m, p, n.a, ens);
    if c.failed {
      return 0;
    }
    let x = inner_t(m, t);
    let dn = def_node(m, p, x);
    if !(kind_t(m, t) == TY_ENUM && names_enum(m, p, n.s, n.e, x) && index_in(p, dn.a, n.s2, n.e2) != 0) {
      cfail(&mut c, p, i, C_TYPE);
      return 0;
    }
    return c.tbool;
  }
  if k == E_FIELD {
    let t = ck_spec(&mut c, &mut m, p, n.a, ens);
    if c.failed {
      return 0;
    }
    let mut u = t;
    while kind_t(m, u) == TY_BOX {
      u = inner_t(m, u);
    }
    let ku = kind_t(m, u);
    if ku == TY_STRUCT || ku == TY_ENUM {
      // In a specification, `o.V` is the payload of variant V.
      let x = inner_t(m, u);
      let dn = def_node(m, p, x);
      let j = index_in(p, dn.a, n.s, n.e);
      if j != 0 && fld_ty(c, x, j - 1) != 0 {
        return fld_ty(c, x, j - 1);
      }
    }
    cfail(&mut c, p, i, C_TYPE);              // no such field
    return 0;
  }
  if k == E_VAR {
    if is_bound(c, p, n.s, n.e) {
      return c.tu64;
    }
    if span_is(p, n.s, n.e, "result") {
      if !ens || c.ret == c.tunit {
        cfail(&mut c, p, i, C_TYPE);          // no `result` here
        return 0;
      }
      return c.ret;
    }
    let v = find_var(c, p, n.s, n.e);
    if v == 0 {
      cfail(&mut c, p, i, C_TYPE);            // unknown variable
      return 0;
    }
    let vr = var_at(c, v - 1);
    return base_t(m, vr.vty);
  }
  if k == E_NOT {
    let t = ck_spec(&mut c, &mut m, p, n.a, ens);
    if !c.failed {
      expect_ty(&mut c, p, t, c.tbool, n.a);
    }
    return c.tbool;
  }
  if k == E_BIN {
    let ta = ck_spec(&mut c, &mut m, p, n.a, ens);
    let tb = ck_spec(&mut c, &mut m, p, n.b, ens);
    if c.failed {
      return 0;
    }
    return bin_type(&mut c, p, n.v, ta, tb, i);
  }
  if k == E_FORALL {
    if find_var(c, p, n.s, n.e) != 0 || is_bound(c, p, n.s, n.e) {
      cfail(&mut c, p, i, C_TYPE);            // shadowing
      return 0;
    }
    vec_push(&mut c.bound, i);
    let t = ck_spec(&mut c, &mut m, p, n.a, ens);
    if vec_len(c.bound) > 0 {
      vec_pop(&mut c.bound);
    }
    if !c.failed {
      expect_ty(&mut c, p, t, c.tbool, n.a);
    }
    return c.tbool;
  }
  if k == E_CALL {
    return spec_call(&mut c, &mut m, p, i, ens);
  }
  // `&mut`, or a struct or enum value being built.
  cfail(&mut c, p, i, C_TYPE);
  return 0;
}

/// The argument of a linear-valued position must name a value.
fn check_lin(c: &mut Checker, p: &Parser, a: u64) {
  if !spec_named(p, a) {
    cfail(&mut c, p, a, C_TYPE);
  }
}

/// An index argument: `u64`.
fn spec_index(c: &mut Checker, m: &mut Mono, p: &Parser, a: u64, ens: bool) {
  let t = ck_spec(&mut c, &mut m, p, a, ens);
  if !c.failed {
    expect_ty(&mut c, p, t, c.tu64, a);
  }
}

fn spec_call(c: &mut Checker, m: &mut Mono, p: &Parser, i: u64, ens: bool) -> u64 {
  let n = node_at(p.nodes, i);
  let s = n.s;
  let e = n.e;
  let na = list_len(p, n.a);
  let a0 = n.a;
  let a1 = next_of(p, a0);
  if span_is(p, s, e, "old") {
    if na != 1 || !ens {
      cfail(&mut c, p, i, C_TYPE);
      return 0;
    }
    return ck_spec(&mut c, &mut m, p, a0, false);
  }
  let sf = find_spec(c, p, s, e);
  if sf != 0 {
    let sn = node_at(p.nodes, sf);
    if na != list_len(p, sn.a) {
      cfail(&mut c, p, i, C_TYPE);
      return 0;
    }
    let mut q = sn.a;
    let mut a = n.a;
    while q != 0 && a != 0 && !c.failed {
      let qn = node_at(p.nodes, q);
      let bt = base_t(m, conv(&mut m, p, qn.a, 0, q));
      let t = ck_spec(&mut c, &mut m, p, a, ens);
      if !c.failed && t != bt {
        cfail(&mut c, p, a, C_TYPE);
      }
      if !c.failed && ck_linear(c, m, p, bt) {
        check_lin(&mut c, p, a);
      }
      q = qn.next;
      a = next_of(p, a);
    }
    if c.failed {
      return 0;
    }
    return conv(&mut m, p, sn.b, 0, sf);
  }
  let g = ghost_index(c, p, s, e);
  if g != 0 {
    let gh = ghost_at(c, g - 1);
    let mut want = 1;
    if gh.idx {
      want = 2;
    }
    if na != want {
      cfail(&mut c, p, i, C_TYPE);
      return 0;
    }
    let t = ck_spec(&mut c, &mut m, p, a0, ens);
    if !c.failed && t != gh.arg {
      cfail(&mut c, p, a0, C_TYPE);
    }
    if !c.failed {
      check_lin(&mut c, p, a0);
    }
    if !c.failed && gh.idx {
      spec_index(&mut c, &mut m, p, a1, ens);
    }
    return gh.ret;
  }
  if span_is(p, s, e, "vlen") || span_is(p, s, e, "vget") {
    let is_len = span_is(p, s, e, "vlen");
    let mut want = 2;
    if is_len {
      want = 1;
    }
    if na != want {
      cfail(&mut c, p, i, C_TYPE);
      return 0;
    }
    let t = ck_spec(&mut c, &mut m, p, a0, ens);
    if !c.failed && kind_t(m, t) != TY_VEC {
      cfail(&mut c, p, a0, C_TYPE);
    }
    if !c.failed {
      check_lin(&mut c, p, a0);
    }
    if c.failed {
      return 0;
    }
    if is_len {
      return c.tu64;
    }
    spec_index(&mut c, &mut m, p, a1, ens);
    return inner_t(m, t);
  }
  if !(span_is(p, s, e, "len") || span_is(p, s, e, "get") || span_is(p, s, e, "slen")
       || span_is(p, s, e, "sget") || span_is(p, s, e, "blen") || span_is(p, s, e, "bget")) {
    cfail(&mut c, p, i, C_TYPE);              // cannot be called in a specification
    return 0;
  }
  let bi = bs_index(c, p, s, e);
  if bi == 0 {
    cfail(&mut c, p, i, C_TYPE);
    return 0;
  }
  let bs = bs_at(c, bi - 1);
  if na != bs.np {
    cfail(&mut c, p, i, C_TYPE);
    return 0;
  }
  let tb = ck_spec(&mut c, &mut m, p, a0, ens);
  if !c.failed && tb != base_t(m, bs.p0) {
    cfail(&mut c, p, a0, C_TYPE);
  }
  if !c.failed {
    check_lin(&mut c, p, a0);
  }
  if !c.failed && na == 2 {
    spec_index(&mut c, &mut m, p, a1, ens);
  }
  return c.tu64;
}
