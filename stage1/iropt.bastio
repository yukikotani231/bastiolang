// Passes over the IR (stage1/ir.bastio, docs/ir.md), run between the
// lowering and the register allocator.
//
// `iropt_slots` (scalar replacement of frame slots): a `slot` whose address
// is only ever the base of a one-word `load` or `store` at a constant word
// index never needs to be in memory. Each of its words becomes a virtual
// register of its own, a `store` becomes a `mov` into it and a `load` a
// `mov` out of it, so the allocator can keep the word in a machine
// register. This is what a `Vec` parameter (passed as three words, stored
// in a slot so the `vec_*` forms can address the header) costs today: every
// `vec_len` and every element access reads the header from the frame.
//
// `iropt_copies` (copy propagation) and `iropt_thread` (jump threading)
// follow it; see docs/ir.md.
//
// A slot whose address is read in any other way (passed to a call, handed to
// `vgrow`, returned from, added to, stored) stays in memory. A word that is
// read before the first instruction that writes it (the lowering does not
// do this, but the IR allows it) starts as 0, so the register is never read
// without being written; the memory it replaces would have held garbage.
import "irra.bastio";

/// How many times each register is written (a parameter counts as one).
fn iropt_ndef(f: &IrFn) -> Vec[u64] {
  let mut ndef = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut ndef, 0);
    r = r + 1;
  }
  let mut j = 0;
  while j < vec_len(f.params) {
    let pr = vec_get(f.params, j);
    ra_set(&mut ndef, pr, wrap_add(u_at(ndef, pr), 1));
    j = j + 1;
  }
  let mut i = 0;
  while i < vec_len(f.ins) {
    let mut ws = vec_new[u64]();
    ra_writes(vec_get(f.ins, i), &mut ws);
    j = 0;
    while j < vec_len(ws) {
      let wr = vec_get(ws, j);
      ra_set(&mut ndef, wr, wrap_add(u_at(ndef, wr), 1));
      j = j + 1;
    }
    vec_free(ws);
    i = i + 1;
  }
  return ndef;
}

/// For each register that is written once, by a `const`, that constant;
/// IR_NONE for any other.
fn iropt_consts(f: &IrFn, ndef: &Vec[u64]) -> Vec[u64] {
  let mut cv = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut cv, IR_NONE);
    r = r + 1;
  }
  let mut i = 0;
  while i < vec_len(f.ins) {
    let q = vec_get(f.ins, i);
    if q.op == IR_CONST && u_at(ndef, q.d) == 1 {
      ra_set(&mut cv, q.d, q.a);
    }
    i = i + 1;
  }
  return cv;
}

/// `iropt_fold`: an arithmetic instruction on two registers that are written
/// once, each by a `const`, becomes a `const`, which `iropt_dce` then makes
/// the operands' definitions dead for. The lowering leaves `8 + 5` of a named
/// offset as two constants and an `add`. Only instructions that do not wrap
/// to a narrower type are folded (`c == 1` marks the others), and a division
/// only by a nonzero constant.
fn iropt_fold(f: &mut IrFn) -> u64 {
  let ndef = iropt_ndef(f);
  let mut cv = iropt_consts(f, ndef);
  let mut n = 0;
  let mut nbr = 0;
  // What a register holds at this point of the block, where it is written
  // more than once (a loop counter set to 0 just before the loop's test).
  let mut kr = vec_new[u64]();
  let mut kv = vec_new[u64]();
  let mut i = 0;
  while i < vec_len(f.ins) {
    let q0 = vec_get(f.ins, i);
    if q0.op == IR_LABEL {
      vec_free(kr);
      vec_free(kv);
      kr = vec_new[u64]();
      kv = vec_new[u64]();
    }
    let q = vec_get(f.ins, i);
    let op = q.op;
    let mut folded = false;
    if (op == IR_ADD || op == IR_SUB || op == IR_MUL || op == IR_AND || op == IR_OR || op == IR_XOR || op == IR_DIV || op == IR_REM || op == IR_SHL || op == IR_SHR) && q.c != 1 && q.d != IR_NONE {
      let x = iropt_cval2(cv, kr, kv, q.a);
      let y = iropt_cval2(cv, kr, kv, q.b);
      if x != IR_NONE && y != IR_NONE && (y != 0 || (op != IR_DIV && op != IR_REM)) && (y < 64 || (op != IR_SHL && op != IR_SHR)) {
        let mut v = 0;
        if op == IR_ADD {
          v = wrap_add(x, y);
        } else if op == IR_SUB {
          v = wrap_sub(x, y);
        } else if op == IR_MUL {
          v = wrap_mul(x, y);
        } else if op == IR_AND {
          v = x & y;
        } else if op == IR_OR {
          v = x | y;
        } else if op == IR_XOR {
          v = x ^ y;
        } else if op == IR_DIV {
          v = x / y;
        } else if op == IR_SHL {
          // (A shift that would lose bits is left for the program to do.)
          if x <= (0xFFFFFFFFFFFFFFFF >> y) {
            v = x << y;
          } else {
            v = IR_NONE;
          }
        } else if op == IR_SHR {
          v = x >> y;
        } else {
          v = x % y;
        }
        if v != IR_NONE {
          vec_set(&mut f.ins, i, IrIns { op: IR_CONST, d: q.d, a: v, b: 0, c: 0, ty: 0 });
          if u_at(ndef, q.d) == 1 {
            ra_set(&mut cv, q.d, v);
          }
          n = wrap_add(n, 1);
          folded = true;
        }
      }
    }
    // Compares and negation of constants, and the operations that leave an
    // operand as it was (`x + 0`, `x * 1`, `x << 0`) or give a constant
    // whatever the other operand is (`x * 0`, `x & 0`).
    if q.d != IR_NONE && q.c != 1 && !folded {
      let x = iropt_cval2(cv, kr, kv, q.a);
      let y = iropt_cval2(cv, kr, kv, q.b);
      let mut r = IrIns { op: 0, d: q.d, a: 0, b: 0, c: 0, ty: 0 };
      if (op >= IR_EQ && op <= IR_SGE) && x != IR_NONE && y != IR_NONE {
        let mut t = false;
        if op == IR_EQ {
          t = x == y;
        } else if op == IR_NE {
          t = x != y;
        } else if op == IR_LT {
          t = x < y;
        } else if op == IR_LE {
          t = x <= y;
        } else if op == IR_GT {
          t = x > y;
        } else if op == IR_GE {
          t = x >= y;
        } else {
          // Signed: flip the sign bit and compare as unsigned.
          let xs = x ^ 0x8000000000000000;
          let ys = y ^ 0x8000000000000000;
          if op == IR_SLT {
            t = xs < ys;
          } else if op == IR_SLE {
            t = xs <= ys;
          } else if op == IR_SGT {
            t = xs > ys;
          } else {
            t = xs >= ys;
          }
        }
        r = IrIns { op: IR_CONST, d: q.d, a: 0, b: 0, c: 0, ty: 0 };
        if t {
          r.a = 1;
        }
      } else if op == IR_NEG && x != IR_NONE {
        r = IrIns { op: IR_CONST, d: q.d, a: wrap_sub(0, x), b: 0, c: 0, ty: 0 };
      } else if (op == IR_ADD || op == IR_SUB || op == IR_OR || op == IR_XOR || op == IR_SHL || op == IR_SHR || op == IR_SAR) && y == 0 {
        r = IrIns { op: IR_MOV, d: q.d, a: q.a, b: 0, c: 0, ty: 0 };
      } else if (op == IR_MUL || op == IR_DIV) && y == 1 {
        r = IrIns { op: IR_MOV, d: q.d, a: q.a, b: 0, c: 0, ty: 0 };
      } else if (op == IR_ADD || op == IR_OR || op == IR_XOR) && x == 0 {
        r = IrIns { op: IR_MOV, d: q.d, a: q.b, b: 0, c: 0, ty: 0 };
      } else if op == IR_MUL && x == 1 {
        r = IrIns { op: IR_MOV, d: q.d, a: q.b, b: 0, c: 0, ty: 0 };
      } else if (op == IR_MUL || op == IR_AND) && (x == 0 || y == 0) {
        r = IrIns { op: IR_CONST, d: q.d, a: 0, b: 0, c: 0, ty: 0 };
      } else if op == IR_REM && y == 1 {
        r = IrIns { op: IR_CONST, d: q.d, a: 0, b: 0, c: 0, ty: 0 };
      }
      if r.op != 0 && !(r.op == IR_MOV && r.a == q.d) {
        vec_set(&mut f.ins, i, r);
        if r.op == IR_CONST && u_at(ndef, q.d) == 1 {
          ra_set(&mut cv, q.d, r.a);
        }
        n = wrap_add(n, 1);
      }
    }
    // A branch on a constant is a jump; what it skips is dropped below.
    if q.op == IR_BR {
      let x = iropt_cval2(cv, kr, kv, q.a);
      if x != IR_NONE {
        let mut t = q.c;
        if x != 0 {
          t = q.b;
        }
        vec_set(&mut f.ins, i, IrIns { op: IR_JMP, d: q.d, a: t, b: 0, c: 0, ty: 0 });
        nbr = wrap_add(nbr, 1);
        n = wrap_add(n, 1);
      }
    }
    let cur = vec_get(f.ins, i);
    if cur.op == IR_JMP || cur.op == IR_BR || cur.op == IR_RET {
      vec_free(kr);
      vec_free(kv);
      kr = vec_new[u64]();
      kv = vec_new[u64]();
    } else {
      iropt_step(&mut kr, &mut kv, cur);
    }
    i = i + 1;
  }
  vec_free(kr);
  vec_free(kv);
  vec_free(ndef);
  vec_free(cv);
  if nbr > 0 {
    iropt_reach(&mut f);
  }
  return n;
}

/// The constant that register `r` holds here: its constant if it is written
/// once, else what the block has set it to (IR_NONE: not known).
fn iropt_cval2(cv: &Vec[u64], kr: &Vec[u64], kv: &Vec[u64], r: u64) -> u64 {
  let x = iropt_cval(cv, r);
  if x != IR_NONE || r == IR_NONE {
    return x;
  }
  return iropt_known(kr, kv, r);
}

/// The constant that register `r` holds (IR_NONE: not known to be one).
fn iropt_cval(cv: &Vec[u64], r: u64) -> u64 {
  if r == IR_NONE {
    return IR_NONE;
  }
  return u_at(cv, r);
}

/// How many instructions read each register.
fn iropt_nuse(f: &IrFn) -> Vec[u64] {
  let mut nuse = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut nuse, 0);
    r = r + 1;
  }
  let mut i = 0;
  while i < vec_len(f.ins) {
    let mut rs = vec_new[u64]();
    ra_reads(f, vec_get(f.ins, i), &mut rs);
    let mut j = 0;
    while j < vec_len(rs) {
      let x = vec_get(rs, j);
      ra_set(&mut nuse, x, wrap_add(u_at(nuse, x), 1));
      j = j + 1;
    }
    vec_free(rs);
    i = i + 1;
  }
  return nuse;
}

/// The test `k = const K; c = eq x, k; br c, lt, lf` at `p`, where `k` and
/// `c` are used nowhere else: `ok`, `x`, `kv` (K), `lt` and `lf`.
struct IrTest { ok: bool, x: u64, kv: u64, lt: u64, lf: u64 }

fn iropt_test_at(f: &IrFn, p: u64, nuse: &Vec[u64], ndef: &Vec[u64]) -> IrTest {
  let none = IrTest { ok: false, x: 0, kv: 0, lt: 0, lf: 0 };
  if p >= vec_len(f.ins) || vec_len(f.ins) - p < 3 {
    return none;
  }
  let q0 = vec_get(f.ins, p);
  let q1 = vec_get(f.ins, p + 1);
  let q2 = vec_get(f.ins, p + 2);
  if q0.op != IR_CONST || q0.a == IR_NONE || q1.op != IR_EQ || q2.op != IR_BR || q2.a != q1.d {
    return none;
  }
  if u_at(nuse, q0.d) != 1 || u_at(ndef, q0.d) != 1 || u_at(nuse, q1.d) != 1 || u_at(ndef, q1.d) != 1 {
    return none;
  }
  if q1.b == q0.d && q1.a != q0.d && q1.a != IR_NONE {
    return IrTest { ok: true, x: q1.a, kv: q0.a, lt: q2.b, lf: q2.c };
  }
  if q1.a == q0.d && q1.b != q0.d && q1.b != IR_NONE {
    return IrTest { ok: true, x: q1.b, kv: q0.a, lt: q2.b, lf: q2.c };
  }
  return none;
}

/// A chain of six or more tests of one register against constants
/// (`if x == 1 {..} else if x == 2 {..}`, `x == 1 || x == 2 || ..`) becomes a
/// binary search: `lt` compares halve the sorted constants, and runs of
/// three or fewer are tested one by one. The first of equal constants wins,
/// as in the chain. The tests after the first go, with their labels, which
/// only the test before them named. Returns how many chains it replaced.
fn iropt_switch(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let ndef = iropt_ndef(f);
  let nuse = iropt_nuse(f);
  let mut lpos = vec_new[u64]();
  let mut refs = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut lpos, IR_NONE);
    vec_push(&mut refs, 0);
    l = l + 1;
  }
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_LABEL {
      ra_set(&mut lpos, q.a, i);
    } else if q.op == IR_JMP {
      ra_set(&mut refs, q.a, wrap_add(u_at(refs, q.a), 1));
    } else if q.op == IR_BR {
      ra_set(&mut refs, q.b, wrap_add(u_at(refs, q.b), 1));
      ra_set(&mut refs, q.c, wrap_add(u_at(refs, q.c), 1));
    }
    i = i + 1;
  }
  // What replaces the instruction at each position: 0 keep, 1 drop, 2 the
  // tree of chain number `rep_at[i]`.
  let mut act = vec_new[u64]();
  i = 0;
  while i < n {
    vec_push(&mut act, 0);
    i = i + 1;
  }
  let mut all = vec_new[u64]();
  let mut tstart = vec_new[u64]();
  let mut tend = vec_new[u64]();
  let mut tree_at = vec_new[u64]();
  let mut found = 0;
  i = 0;
  while i < n {
    let t0 = iropt_test_at(f, i, nuse, ndef);
    if t0.ok && u_at(act, i) == 0 {
      // The chain from here: constants, targets, and the test positions.
      let mut ks = vec_new[u64]();
      let mut ts = vec_new[u64]();
      let mut ps = vec_new[u64]();
      // Where each test's last instruction (the `br`) is.
      let mut es = vec_new[u64]();
      vec_push(&mut ks, t0.kv);
      vec_push(&mut ts, t0.lt);
      vec_push(&mut ps, i);
      vec_push(&mut es, wrap_add(i, 2));
      let mut lf = t0.lf;
      let mut going = true;
      while going && vec_len(ks) < 100000 {
        let lp = u_at(lpos, lf);
        going = false;
        if lf < vec_len(lpos) && lp != IR_NONE && lp > 0 && u_at(refs, lf) == 1 {
          // The label is entered by the branch alone (a terminator before
          // it), and the labels after it, up to the test, by nothing.
          let pq = iropt_at(f, wrap_sub(lp, 1));
          let mut tp = wrap_add(lp, 1);
          let mut clean = pq.op == IR_BR || pq.op == IR_JMP || pq.op == IR_RET;
          let mut more = clean;
          while more && tp < vec_len(f.ins) {
            let lq = iropt_at(f, tp);
            if lq.op == IR_LABEL {
              if u_at(refs, lq.a) != 0 {
                clean = false;
                more = false;
              }
              tp = wrap_add(tp, 1);
            } else {
              more = false;
            }
          }
          let t = iropt_test_at(f, tp, nuse, ndef);
          if clean && t.ok && t.x == t0.x && u_at(act, tp) == 0 {
            vec_push(&mut ks, t.kv);
            vec_push(&mut ts, t.lt);
            vec_push(&mut ps, lp);
            vec_push(&mut es, wrap_add(tp, 2));
            lf = t.lf;
            going = true;
          }
        }
      }
      if vec_len(ks) >= 6 {
        // The first test is replaced by the tree; the others, from their
        // label on, are dropped.
        let mut k = 0;
        while k < vec_len(ps) {
          let at = u_at(ps, k);
          if k == 0 {
            ra_set(&mut act, at, 2);
            ra_set(&mut act, wrap_add(at, 1), 1);
            ra_set(&mut act, wrap_add(at, 2), 1);
          } else {
            let mut d = at;
            while d <= u_at(es, k) {
              ra_set(&mut act, d, 1);
              d = wrap_add(d, 1);
            }
          }
          k = k + 1;
        }
        // The tree: a sorted copy of the constants without repeats.
        let mut sk = vec_new[u64]();
        let mut st = vec_new[u64]();
        k = 0;
        while k < vec_len(ks) {
          let kv = u_at(ks, k);
          let mut at = 0;
          let mut dup = false;
          while at < vec_len(sk) && u_at(sk, at) < kv {
            at = at + 1;
          }
          if at < vec_len(sk) && u_at(sk, at) == kv {
            dup = true;
          }
          if !dup {
            // Insert at `at`.
            vec_push(&mut sk, kv);
            vec_push(&mut st, u_at(ts, k));
            let mut m = vec_len(sk) - 1;
            while m > at {
              ra_set(&mut sk, m, u_at(sk, m - 1));
              ra_set(&mut st, m, u_at(st, m - 1));
              m = m - 1;
            }
            ra_set(&mut sk, at, kv);
            ra_set(&mut st, at, u_at(ts, k));
          }
          k = k + 1;
        }
        // Runs of three or more consecutive constants with one target
        // become one interval, tested as `x - lo < len`: sk[j]..sh[j].
        let mut mk = vec_new[u64]();
        let mut mh = vec_new[u64]();
        let mut mt = vec_new[u64]();
        let mut j0 = 0;
        while j0 < vec_len(sk) {
          let mut e = j0;
          while wrap_add(e, 1) < vec_len(sk) && u_at(sk, wrap_add(e, 1)) == wrap_add(u_at(sk, e), 1) && u_at(st, wrap_add(e, 1)) == u_at(st, j0) {
            e = wrap_add(e, 1);
          }
          if wrap_sub(e, j0) >= 2 {
            vec_push(&mut mk, u_at(sk, j0));
            vec_push(&mut mh, u_at(sk, e));
            vec_push(&mut mt, u_at(st, j0));
            j0 = wrap_add(e, 1);
          } else {
            vec_push(&mut mk, u_at(sk, j0));
            vec_push(&mut mh, u_at(sk, j0));
            vec_push(&mut mt, u_at(st, j0));
            j0 = wrap_add(j0, 1);
          }
        }
        vec_free(sk);
        vec_free(st);
        sk = mk;
        st = mt;
        let sh = mh;
        let mut code = vec_new[u64]();
        // Packed as groups of six words: op, d, a, b, c, ty.
        let mut work = vec_new[u64]();
        // A range to emit: low, high (inclusive), and the label before it.
        vec_push(&mut work, 0);
        vec_push(&mut work, wrap_sub(vec_len(sk), 1));
        vec_push(&mut work, IR_NONE);
        while vec_len(work) >= 3 {
          let lab = vec_pop(&mut work);
          let hi = vec_pop(&mut work);
          let lo = vec_pop(&mut work);
          if lab != IR_NONE {
            iropt_push6(&mut code, IR_LABEL, 0, lab, 0, 0, 0);
          }
          if wrap_sub(hi, lo) < 3 {
            let mut j = lo;
            while j <= hi && j < vec_len(sk) {
              let kr = ir_reg(&mut f);
              let cr = ir_reg(&mut f);
              iropt_push6(&mut code, IR_CONST, kr, u_at(sk, j), 0, 0, 0);
              if u_at(sh, j) == u_at(sk, j) {
                iropt_push6(&mut code, IR_EQ, cr, t0.x, kr, 0, 0);
              } else {
                let dr = ir_reg(&mut f);
                let nr = ir_reg(&mut f);
                iropt_push6(&mut code, IR_SUB, dr, t0.x, kr, 0, 0);
                iropt_push6(&mut code, IR_CONST, nr, wrap_add(wrap_sub(u_at(sh, j), u_at(sk, j)), 1), 0, 0, 0);
                iropt_push6(&mut code, IR_LT, cr, dr, nr, 0, 0);
              }
              if j == hi {
                let lnext = ir_label(&mut f);
                iropt_push6(&mut code, IR_BR, 0, cr, u_at(st, j), lnext, 0);
                iropt_push6(&mut code, IR_LABEL, 0, lnext, 0, 0, 0);
                iropt_push6(&mut code, IR_JMP, 0, lf, 0, 0, 0);
              } else {
                let lnext = ir_label(&mut f);
                iropt_push6(&mut code, IR_BR, 0, cr, u_at(st, j), lnext, 0);
                iropt_push6(&mut code, IR_LABEL, 0, lnext, 0, 0, 0);
              }
              j = j + 1;
            }
          } else {
            let mid = wrap_add(wrap_add(lo, wrap_sub(hi, lo) / 2), 1);
            let kr = ir_reg(&mut f);
            let cr = ir_reg(&mut f);
            let lleft = ir_label(&mut f);
            let lright = ir_label(&mut f);
            iropt_push6(&mut code, IR_CONST, kr, u_at(sk, mid), 0, 0, 0);
            iropt_push6(&mut code, IR_LT, cr, t0.x, kr, 0, 0);
            iropt_push6(&mut code, IR_BR, 0, cr, lleft, lright, 0);
            // The right half is emitted after the left one: push it first.
            vec_push(&mut work, mid);
            vec_push(&mut work, hi);
            vec_push(&mut work, lright);
            vec_push(&mut work, lo);
            vec_push(&mut work, wrap_sub(mid, 1));
            vec_push(&mut work, lleft);
          }
        }
        vec_free(work);
        vec_push(&mut tstart, vec_len(all));
        let mut cw = 0;
        while cw < vec_len(code) {
          vec_push(&mut all, u_at(code, cw));
          cw = cw + 1;
        }
        vec_push(&mut tend, vec_len(all));
        vec_free(code);
        vec_push(&mut tree_at, i);
        found = wrap_add(found, 1);
        vec_free(sk);
        vec_free(st);
        vec_free(sh);
      }
      vec_free(ks);
      vec_free(ts);
      vec_free(ps);
      vec_free(es);
    }
    i = i + 1;
  }
  if found > 0 {
    let mut out = vec_new[IrIns]();
    let mut ti = 0;
    i = 0;
    while i < n {
      let q = vec_get(f.ins, i);
      let a = u_at(act, i);
      if a == 0 {
        vec_push(&mut out, q);
      } else if a == 2 {
        let mut w = u_at(tstart, ti);
        let e = u_at(tend, ti);
        while wrap_add(w, 5) < e && e <= vec_len(all) {
          vec_push(&mut out, IrIns { op: u_at(all, w), d: u_at(all, wrap_add(w, 1)), a: u_at(all, wrap_add(w, 2)), b: u_at(all, wrap_add(w, 3)), c: u_at(all, wrap_add(w, 4)), ty: u_at(all, wrap_add(w, 5)) });
          w = wrap_add(w, 6);
        }
        ti = wrap_add(ti, 1);
      }
      i = i + 1;
    }
    vec_free(f.ins);
    f.ins = out;
  }
  vec_free(all);
  vec_free(tstart);
  vec_free(tend);
  vec_free(tree_at);
  vec_free(act);
  vec_free(lpos);
  vec_free(refs);
  vec_free(ndef);
  vec_free(nuse);
  return found;
}

fn iropt_push6(v: &mut Vec[u64], op: u64, d: u64, a: u64, b: u64, c: u64, ty: u64) {
  vec_push(&mut v, op);
  vec_push(&mut v, d);
  vec_push(&mut v, a);
  vec_push(&mut v, b);
  vec_push(&mut v, c);
  vec_push(&mut v, ty);
}

/// Is the slot register `s` (of `words` words) used only as the base of
/// one-word loads and stores at constant indices below `words`?
fn iropt_slot_ok(f: &IrFn, s: u64, words: u64, cv: &Vec[u64]) -> bool {
  let mut ok = true;
  let mut i = 0;
  while ok && i < vec_len(f.ins) {
    let q = vec_get(f.ins, i);
    let mut rs = vec_new[u64]();
    ra_reads(f, q, &mut rs);
    let mut uses = false;
    let mut j = 0;
    while j < vec_len(rs) {
      if vec_get(rs, j) == s {
        uses = true;
      }
      j = j + 1;
    }
    vec_free(rs);
    if uses {
      if (q.op == IR_LOAD || q.op == IR_STORE) && q.a == s && q.b != s && q.c == 8 {
        let k = u_at(cv, q.b);
        if k >= words {
          ok = false;
        }
        if q.op == IR_STORE && q.d == s {
          ok = false;
        }
      } else if q.op == IR_VGROW && q.a == s {
        // The header goes to the frame just before and comes back just after.
      } else {
        ok = false;
      }
    }
    i = i + 1;
  }
  return ok;
}

/// Does a `vgrow` name the slot register `s`?
fn iropt_slot_grows(f: &IrFn, s: u64) -> bool {
  let mut i = 0;
  while i < vec_len(f.ins) {
    let q = vec_get(f.ins, i);
    if q.op == IR_VGROW && q.a == s {
      return true;
    }
    i = i + 1;
  }
  return false;
}

/// Replaces the promotable slots of `f` by registers. Returns how many.
fn iropt_slots(f: &mut IrFn) -> u64 {
  let ndef = iropt_ndef(f);
  let cv = iropt_consts(f, ndef);
  // The register of word k of the slot defined by instruction i: base[i] + k.
  let mut base = vec_new[u64]();
  let mut promoted = 0;
  let mut i = 0;
  while i < vec_len(f.ins) {
    let q = vec_get(f.ins, i);
    let mut b = IR_NONE;
    if q.op == IR_SLOT && u_at(ndef, q.d) == 1 && q.c > 0 && q.c <= 64 && iropt_slot_ok(f, q.d, q.c, cv) {
      b = f.nreg;
      f.nreg = wrap_add(f.nreg, q.c);
      promoted = wrap_add(promoted, 1);
    }
    vec_push(&mut base, b);
    i = i + 1;
  }
  if promoted == 0 {
    vec_free(base);
    vec_free(cv);
    vec_free(ndef);
    return 0;
  }
  // Slot register -> instruction that defines it.
  let mut out = vec_new[IrIns]();
  i = 0;
  while i < vec_len(f.ins) {
    let q = vec_get(f.ins, i);
    let mut keep = true;
    if q.op == IR_SLOT && u_at(base, i) != IR_NONE {
      // A slot that a `vgrow` names stays, for the header to go through.
      let grows = iropt_slot_grows(f, q.d);
      keep = false;
      let mut k = 0;
      while k < q.c {
        if grows || iropt_first_is_load(f, i, q.d, k, cv) {
          vec_push(&mut out, IrIns { op: IR_CONST, d: wrap_add(u_at(base, i), k), a: 0, b: 0, c: 0, ty: 0 });
        }
        k = k + 1;
      }
      if grows {
        vec_push(&mut out, q);
        keep = false;
      }
    } else if q.op == IR_VGROW {
      let mut j = 0;
      while j < vec_len(f.ins) {
        let sq = vec_get(f.ins, j);
        if sq.op == IR_SLOT && sq.d == q.a && u_at(base, j) != IR_NONE {
          let mut k = 0;
          while k < sq.c {
            let kr = ir_reg(&mut f);
            vec_push(&mut out, IrIns { op: IR_CONST, d: kr, a: k, b: 0, c: 0, ty: 0 });
            vec_push(&mut out, IrIns { op: IR_STORE, d: wrap_add(u_at(base, j), k), a: q.a, b: kr, c: 8, ty: 0 });
            k = k + 1;
          }
          vec_push(&mut out, q);
          k = 0;
          while k < sq.c {
            let kr = ir_reg(&mut f);
            vec_push(&mut out, IrIns { op: IR_CONST, d: kr, a: k, b: 0, c: 0, ty: 0 });
            vec_push(&mut out, IrIns { op: IR_LOAD, d: wrap_add(u_at(base, j), k), a: q.a, b: kr, c: 8, ty: 0 });
            k = k + 1;
          }
          keep = false;
        }
        j = j + 1;
      }
    } else if q.op == IR_LOAD || q.op == IR_STORE {
      // Which promoted slot is `a`, if any?
      let mut j = 0;
      while j < vec_len(f.ins) {
        let sq = vec_get(f.ins, j);
        if sq.op == IR_SLOT && sq.d == q.a && u_at(base, j) != IR_NONE {
          let w = wrap_add(u_at(base, j), u_at(cv, q.b));
          if q.op == IR_LOAD {
            vec_push(&mut out, IrIns { op: IR_MOV, d: q.d, a: w, b: 0, c: 0, ty: 0 });
          } else {
            vec_push(&mut out, IrIns { op: IR_MOV, d: w, a: q.d, b: 0, c: 0, ty: 0 });
          }
          keep = false;
        }
        j = j + 1;
      }
    }
    if keep {
      vec_push(&mut out, q);
    }
    i = i + 1;
  }
  vec_free(f.ins);
  f.ins = out;
  vec_free(base);
  vec_free(cv);
  vec_free(ndef);
  return promoted;
}

/// Is the first instruction after position `j` (the `slot` of register `s`)
/// that touches word `k` a `load`?
fn iropt_first_is_load(f: &IrFn, j: u64, s: u64, k: u64, cv: &Vec[u64]) -> bool {
  let mut n = wrap_add(j, 1);
  while n < vec_len(f.ins) {
    let q = vec_get(f.ins, n);
    if (q.op == IR_LOAD || q.op == IR_STORE) && q.a == s && u_at(cv, q.b) == k {
      return q.op == IR_LOAD;
    }
    n = n + 1;
  }
  return false;
}

/// `q` with every read of register `from` replaced by `to` (the argument
/// registers of a call are renamed by the caller).
fn iropt_rename(q: IrIns, from: u64, to: u64) -> IrIns {
  let mut r = q;
  let op = q.op;
  if ra_is_binary(op) || op == IR_LOAD {
    if r.a == from {
      r.a = to;
    }
    if r.b == from {
      r.b = to;
    }
  } else if op == IR_MOV || op == IR_NOT || op == IR_NEG || op == IR_WRAP || op == IR_ALLOC || op == IR_FREE || op == IR_RT || op == IR_ZERO || op == IR_PIN || op == IR_DEVR || op == IR_LOCKINC || op == IR_LOCKDEC || op == IR_LOCKACQ
    || op == IR_PRINT || op == IR_PUTC || op == IR_VGROW || op == IR_BR {
    if r.a == from {
      r.a = to;
    }
  } else if op == IR_RET {
    // (`b` of a return of registers is a position in args, renamed below.)
    if r.a == from {
      r.a = to;
    }
    if r.b == from && !(q.c > 0 && q.a == IR_NONE) {
      r.b = to;
    }
  } else if op == IR_CAS || op == IR_COPY || op == IR_FILL {
    if r.a == from {
      r.a = to;
    }
    if r.b == from {
      r.b = to;
    }
    if r.c == from {
      r.c = to;
    }
  } else if op == IR_DEVW || op == IR_POUT || op == IR_MMCHK || op == IR_COPYPAGE || op == IR_PCALL || op == IR_XCHG {
    if r.a == from {
      r.a = to;
    }
    if r.b == from {
      r.b = to;
    }
  } else if op == IR_STORE {
    if r.d == from {
      r.d = to;
    }
    if r.a == from {
      r.a = to;
    }
    if r.b == from {
      r.b = to;
    }
  }
  return r;
}

/// Instruction `i` of `f` (an instruction of op 0 past the end).
fn iropt_at(f: &IrFn, i: u64) -> IrIns {
  if i < vec_len(f.ins) {
    return vec_get(f.ins, i);
  }
  return IrIns { op: 0, d: IR_NONE, a: IR_NONE, b: IR_NONE, c: 0, ty: 0 };
}

/// A body instruction `iropt_unroll` can copy: straight-line, one result in
/// `d` (a store's `d` is the value it reads), no slot and no call.
fn iropt_unroll_ok(q: IrIns) -> bool {
  let op = q.op;
  if op == IR_PCALL {
    return q.c == 3 || q.c == 6;
  }
  return op == IR_CONST || op == IR_MOV || op == IR_NOT || op == IR_NEG || op == IR_WRAP || op == IR_LOAD || op == IR_STORE || ra_is_binary(op);
}

/// `q` with the register `from` renamed to `to`, read or written.
fn iropt_unroll_ren(q: IrIns, from: u64, to: u64) -> IrIns {
  let mut r = iropt_rename(q, from, to);
  if q.op != IR_STORE && q.op != IR_PCALL && r.d == from {
    r.d = to;
  }
  if q.op == IR_PCALL && q.d == from {
    r.d = to;
  }
  return r;
}

/// Full unrolling of a loop that runs a small, known number of times:
///
///     i = const c0
///   L3: t = lt i, bound      (bound a constant)
///     br t, L4, L5
///   L4: body                 (straight-line)
///     i = mov x              (x = add i, step, the last instruction)
///     jmp L3
///   L5:
///
/// becomes the body written out once per trip, with `i` a constant in each
/// copy and the registers the body only uses privately renamed per copy, so
/// the constants fold into the instructions that read them. The 21-word
/// register save of a system call is such a loop. Returns 1 if it unrolled
/// one loop, else 0.
fn iropt_unroll1(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let ndef = iropt_ndef(f);
  let cv = iropt_consts(f, ndef);
  let nuse = iropt_nuse(f);
  let mut lpos = vec_new[u64]();
  let mut refs = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut lpos, IR_NONE);
    vec_push(&mut refs, 0);
    l = wrap_add(l, 1);
  }
  let mut i = 0;
  while i < n {
    let q = iropt_at(f, i);
    if q.op == IR_LABEL {
      ra_set(&mut lpos, q.a, i);
    } else if q.op == IR_JMP {
      ra_set(&mut refs, q.a, wrap_add(u_at(refs, q.a), 1));
    } else if q.op == IR_BR {
      ra_set(&mut refs, q.b, wrap_add(u_at(refs, q.b), 1));
      ra_set(&mut refs, q.c, wrap_add(u_at(refs, q.c), 1));
    }
    i = wrap_add(i, 1);
  }
  let mut done = 0;
  let mut p = 1;
  while done == 0 && p < n
    invariant p >= 1
  {
    let q0 = iropt_at(f, p - 1);
    let ql = iropt_at(f, p);
    // Constants at the head of the test (the bound) are written once per trip.
    let mut hq = wrap_add(p, 1);
    let mut scanning = true;
    while scanning && hq < n {
      let qh = iropt_at(f, hq);
      if qh.op == IR_CONST {
        hq = wrap_add(hq, 1);
      } else {
        scanning = false;
      }
    }
    let q1 = iropt_at(f, hq);
    let q2 = iropt_at(f, wrap_add(hq, 1));
    let q3 = iropt_at(f, wrap_add(hq, 2));
    // The header: `i = const c0; L3: t = lt i, bound; br t, L4, L5; L4:`.
    let mut shape = q0.op == IR_CONST && ql.op == IR_LABEL && q1.op == IR_LT && q2.op == IR_BR && q3.op == IR_LABEL;
    if shape {
      shape = q1.a == q0.d && q2.a == q1.d && q2.b == q3.a && u_at(refs, ql.a) == 1 && u_at(refs, q3.a) == 1 && u_at(ndef, q0.d) == 2 && u_at(ndef, q1.d) == 1 && u_at(nuse, q1.d) == 1;
    }
    let bound = iropt_cval(cv, q1.b);
    let c0 = q0.a;
    if shape && bound != IR_NONE && c0 != IR_NONE && c0 < bound && bound < 1000 {
      // The end of the body: the jump back to L3.
      let mut e = wrap_add(hq, 3);
      let mut straight = true;
      while straight && e < n {
        let qe = iropt_at(f, e);
        if qe.op == IR_JMP {
          straight = false;
        } else if !iropt_unroll_ok(qe) {
          e = n;
        } else {
          e = wrap_add(e, 1);
        }
      }
      let mut qj = IrIns { op: 0, d: IR_NONE, a: IR_NONE, b: IR_NONE, c: 0, ty: 0 };
      if e < n {
        qj = iropt_at(f, e);
      }
      let bs = wrap_add(hq, 3);
      if e < n && qj.op == IR_JMP && qj.a == ql.a && e > bs && wrap_add(e, 1) < n {
        let qm = iropt_at(f, e - 1);
        // The last body instruction is `i = mov x`, x = i + step.
        let mut step = IR_NONE;
        if qm.op == IR_MOV && qm.d == q0.d && u_at(ndef, qm.a) == 1 && u_at(nuse, qm.a) == 1 {
          let mut k = bs;
          while wrap_add(k, 1) < e {
            let qk = iropt_at(f, k);
            if qk.op == IR_ADD && qk.d == qm.a && qk.c != 1 {
              if qk.a == q0.d && iropt_cval(cv, qk.b) != IR_NONE {
                step = iropt_cval(cv, qk.b);
              } else if qk.b == q0.d && iropt_cval(cv, qk.a) != IR_NONE {
                step = iropt_cval(cv, qk.a);
              }
            }
            k = wrap_add(k, 1);
          }
        }
        let span = bound - c0;
        if step != IR_NONE && step > 0 && step <= span {
          let trips = wrap_add(span, step - 1) / step;
          let blen = e - 1 - bs;
          if trips >= 2 && trips <= 64 && wrap_mul(trips, blen) <= 400 {
            // Which registers does the body write, and which of those does
            // it read before writing or leave to code outside it?
            let mut inb = vec_new[u64]();
            let mut seen = vec_new[u64]();
            let mut bad = vec_new[u64]();
            let mut nin = vec_new[u64]();
            let mut r = 0;
            while r < f.nreg && r < 1000000000 {
              vec_push(&mut inb, 0);
              vec_push(&mut seen, 0);
              vec_push(&mut bad, 0);
              vec_push(&mut nin, 0);
              r = wrap_add(r, 1);
            }
            let mut k = bs;
            while wrap_add(k, 1) < e {
              let qk = iropt_at(f, k);
              let mut ws = vec_new[u64]();
              ra_writes(qk, &mut ws);
              let mut j = 0;
              while j < vec_len(ws) {
                ra_set(&mut inb, vec_get(ws, j), 1);
                j = wrap_add(j, 1);
              }
              vec_free(ws);
              k = wrap_add(k, 1);
            }
            k = bs;
            while wrap_add(k, 1) < e {
              let qk = iropt_at(f, k);
              let mut rs = vec_new[u64]();
              ra_reads(f, qk, &mut rs);
              let mut j = 0;
              while j < vec_len(rs) {
                let x = vec_get(rs, j);
                ra_set(&mut nin, x, wrap_add(u_at(nin, x), 1));
                if u_at(inb, x) == 1 && u_at(seen, x) == 0 {
                  ra_set(&mut bad, x, 1);
                }
                j = wrap_add(j, 1);
              }
              vec_free(rs);
              let mut ws = vec_new[u64]();
              ra_writes(qk, &mut ws);
              j = 0;
              while j < vec_len(ws) {
                ra_set(&mut seen, vec_get(ws, j), 1);
                j = wrap_add(j, 1);
              }
              vec_free(ws);
              k = wrap_add(k, 1);
            }
            // The privately used registers get a fresh name per copy.
            let mut priv = vec_new[u64]();
            r = 0;
            while r < f.nreg && r < 1000000000 {
              if u_at(inb, r) == 1 && u_at(bad, r) == 0 && r != q0.d && u_at(nuse, r) == u_at(nin, r) {
                vec_push(&mut priv, r);
              }
              r = wrap_add(r, 1);
            }
            let mut out = vec_new[IrIns]();
            k = 0;
            while k < p {
              vec_push(&mut out, iropt_at(f, k));
              k = wrap_add(k, 1);
            }
            k = wrap_add(p, 1);
            while k < hq {
              vec_push(&mut out, iropt_at(f, k));
              k = wrap_add(k, 1);
            }
            let mut t = 0;
            while t < trips {
              let ck = ir_reg(&mut f);
              vec_push(&mut out, IrIns { op: IR_CONST, d: ck, a: wrap_add(c0, wrap_mul(t, step)), b: 0, c: 0, ty: 0 });
              let mut mt = vec_new[u64]();
              let mut j = 0;
              while j < vec_len(priv) {
                vec_push(&mut mt, ir_reg(&mut f));
                j = wrap_add(j, 1);
              }
              k = bs;
              while wrap_add(k, 1) < e {
                let mut qk = iropt_unroll_ren(iropt_at(f, k), q0.d, ck);
                j = 0;
                while j < vec_len(priv) && j < vec_len(mt) {
                  qk = iropt_unroll_ren(qk, vec_get(priv, j), vec_get(mt, j));
                  j = wrap_add(j, 1);
                }
                vec_push(&mut out, qk);
                k = wrap_add(k, 1);
              }
              vec_free(mt);
              t = wrap_add(t, 1);
            }
            // `i` ends where the loop left it.
            vec_push(&mut out, IrIns { op: IR_CONST, d: q0.d, a: wrap_add(c0, wrap_mul(trips, step)), b: 0, c: 0, ty: 0 });
            // The code after the loop is reached by falling through; it
            // starts with L5 unless something else sits between.
            let qa = iropt_at(f, wrap_add(e, 1));
            if !(qa.op == IR_LABEL && qa.a == q2.c) {
              vec_push(&mut out, IrIns { op: IR_JMP, d: IR_NONE, a: q2.c, b: 0, c: 0, ty: 0 });
            }
            k = wrap_add(e, 1);
            while k < n {
              vec_push(&mut out, iropt_at(f, k));
              k = wrap_add(k, 1);
            }
            vec_free(f.ins);
            f.ins = out;
            done = 1;
            vec_free(inb);
            vec_free(seen);
            vec_free(bad);
            vec_free(nin);
            vec_free(priv);
          }
        }
      }
    }
    p = wrap_add(p, 1);
  }
  vec_free(ndef);
  vec_free(cv);
  vec_free(nuse);
  vec_free(lpos);
  vec_free(refs);
  return done;
}

/// `iropt_unroll1` until no loop is left to unroll (at most eight).
fn iropt_unroll(f: &mut IrFn) -> u64 {
  let mut total = 0;
  let mut again = true;
  while again && total < 8 {
    again = false;
    if iropt_unroll1(&mut f) > 0 {
      total = wrap_add(total, 1);
      again = true;
    }
  }
  return total;
}

/// Copy propagation: `d = mov a`, where `d` and `a` are each written once
/// (a parameter counts as a write), makes `d` a second name for `a`. Every
/// read of `d` becomes a read of `a` and the `mov` goes. `a` must keep the
/// value it had at the `mov` until the last read of `d`: `a` is a
/// parameter, or its definition comes before the `mov` and no label (so no
/// jump that could skip the `mov` or re-run the definition) lies between
/// that definition and the last read of `d`; and `d` is not read before the
/// `mov`. Returns how many copies it removed.
fn iropt_copies(f: &mut IrFn) -> u64 {
  let mut total = 0;
  let mut again = true;
  let mut rounds = 0;
  while again && rounds < 64 {
    again = false;
    rounds = rounds + 1;
    let n = vec_len(f.ins);
    let ndef = iropt_ndef(f);
    // Per register: where it is written (IR_NONE: not by an instruction),
    // and its first and last read (IR_NONE: never).
    let mut defpos = vec_new[u64]();
    let mut first = vec_new[u64]();
    let mut last = vec_new[u64]();
    let mut r = 0;
    while r < f.nreg && r < 1000000000 {
      vec_push(&mut defpos, IR_NONE);
      vec_push(&mut first, IR_NONE);
      vec_push(&mut last, IR_NONE);
      r = r + 1;
    }
    // labels[i]: how many labels lie in instructions 0 .. i - 1.
    let mut labels = vec_new[u64]();
    let mut i = 0;
    while i < n {
      let q = vec_get(f.ins, i);
      vec_push(&mut labels, 0);
      let mut ws = vec_new[u64]();
      ra_writes(q, &mut ws);
      let mut j = 0;
      while j < vec_len(ws) {
        ra_set(&mut defpos, vec_get(ws, j), i);
        j = j + 1;
      }
      vec_free(ws);
      let mut rs = vec_new[u64]();
      ra_reads(f, q, &mut rs);
      j = 0;
      while j < vec_len(rs) {
        let rr = vec_get(rs, j);
        if u_at(first, rr) == IR_NONE {
          ra_set(&mut first, rr, i);
        }
        ra_set(&mut last, rr, i);
        j = j + 1;
      }
      vec_free(rs);
      i = i + 1;
    }
    vec_push(&mut labels, 0);
    i = 0;
    while i <= n {
      let mut prev = 0;
      if i > 0 {
        prev = u_at(labels, wrap_sub(i, 1));
      }
      let mut isl = 0;
      if i > 0 {
        let pq = vec_get(f.ins, wrap_sub(i, 1));
        if pq.op == IR_LABEL {
          isl = 1;
        }
      }
      ra_set(&mut labels, i, wrap_add(prev, isl));
      i = i + 1;
    }
    // loopy[i] > 0: instruction i lies in a loop, the stretch from a label
    // to a jump or branch back to it.
    let mut lpos = vec_new[u64]();
    let mut l = 0;
    while l < f.nlabel && l < 1000000000 {
      vec_push(&mut lpos, IR_NONE);
      l = l + 1;
    }
    let mut loopy = vec_new[u64]();
    i = 0;
    while i <= n {
      vec_push(&mut loopy, 0);
      i = i + 1;
    }
    i = 0;
    while i < n {
      let q = vec_get(f.ins, i);
      if q.op == IR_LABEL && q.a < f.nlabel {
        ra_set(&mut lpos, q.a, i);
      }
      i = i + 1;
    }
    i = 0;
    while i < n {
      let q = vec_get(f.ins, i);
      let mut k = 0;
      while k < 2 {
        let mut tl = IR_NONE;
        if q.op == IR_JMP && k == 0 {
          tl = q.a;
        } else if q.op == IR_BR && k == 0 {
          tl = q.b;
        } else if q.op == IR_BR {
          tl = q.c;
        }
        if tl < f.nlabel {
          let lp = u_at(lpos, tl);
          if lp != IR_NONE && lp < i {
            ra_set(&mut loopy, lp, wrap_add(u_at(loopy, lp), 1));
            ra_set(&mut loopy, i + 1, wrap_sub(u_at(loopy, i + 1), 1));
          }
        }
        k = k + 1;
      }
      i = i + 1;
    }
    let mut run = 0;
    i = 0;
    while i < n {
      run = wrap_add(run, u_at(loopy, i));
      ra_set(&mut loopy, i, run);
      i = i + 1;
    }
    // Pick the copies to remove in this round: no source is itself a
    // copy removed in the same round (the next round takes those).
    let mut isdst = vec_new[u64]();
    r = 0;
    while r < f.nreg && r < 1000000000 {
      vec_push(&mut isdst, 0);
      r = r + 1;
    }
    let mut pick = vec_new[u64]();
    i = 0;
    while i < n {
      let q = vec_get(f.ins, i);
      if q.op == IR_MOV && q.d != q.a && q.d < f.nreg && q.a < f.nreg && u_at(ndef, q.d) == 1 && u_at(ndef, q.a) == 1
        && u_at(isdst, q.a) == 0 && u_at(first, q.d) != IR_NONE && u_at(first, q.d) > i {
        let pa = u_at(defpos, q.a);
        let lu = u_at(last, q.d);
        let qa = iropt_at(f, pa);
        let mut ok = false;
        if pa == IR_NONE {
          ok = true;
        } else if pa < i && (qa.op == IR_CONST || qa.op == IR_SLOT) {
          // A constant is the same wherever the copy of it is read, and so is
          // the address of a frame slot (one per instruction).
          ok = true;
        } else if pa < i && u_at(loopy, pa) == 0 {
          // Written once, outside every loop: it keeps its value.
          ok = true;
        } else if pa < i && lu >= i {
          // No label among instructions pa + 1 .. lu.
          let upto = wrap_add(lu, 1);
          ok = u_at(labels, upto) == u_at(labels, wrap_add(pa, 1));
        }
        if ok {
          ra_set(&mut isdst, q.d, 1);
          vec_push(&mut pick, i);
        }
      }
      i = i + 1;
    }
    if vec_len(pick) > 0 {
      again = true;
      total = wrap_add(total, vec_len(pick));
      let mut out = vec_new[IrIns]();
      i = 0;
      while i < n {
        let mut q = vec_get(f.ins, i);
        let mut drop = false;
        let mut k = 0;
        while k < vec_len(pick) {
          let pi = vec_get(pick, k);
          if pi < vec_len(f.ins) {
            let m = vec_get(f.ins, pi);
            if pi == i {
              drop = true;
            } else {
              q = iropt_rename(q, m.d, m.a);
              if q.op == IR_CALL || q.op == IR_CALLM || (q.op == IR_RET && q.a == IR_NONE) {
                let mut j = 0;
                while j < q.c && j < 4096 {
                  let ai = wrap_add(q.b, j);
                  if u_at(f.args, ai) == m.d {
                    ra_set(&mut f.args, ai, m.a);
                  }
                  j = j + 1;
                }
              }
            }
          }
          k = k + 1;
        }
        if !drop {
          vec_push(&mut out, q);
        }
        i = i + 1;
      }
      vec_free(f.ins);
      f.ins = out;
    }
    vec_free(pick);
    vec_free(isdst);
    vec_free(lpos);
    vec_free(loopy);
    vec_free(labels);
    vec_free(last);
    vec_free(first);
    vec_free(defpos);
    vec_free(ndef);
  }
  return total;
}

/// The instruction after label `l` and any labels that follow it
/// (IR_NONE: there is none, or `l` is not placed).
fn iropt_after_label(f: &IrFn, lpos: &Vec[u64], l: u64) -> u64 {
  let mut p = u_at(lpos, l);
  if p == IR_NONE {
    return IR_NONE;
  }
  p = wrap_add(p, 1);
  let mut going = true;
  while going && p < vec_len(f.ins) {
    let q = vec_get(f.ins, p);
    if q.op == IR_LABEL {
      p = wrap_add(p, 1);
    } else {
      going = false;
    }
  }
  if going {
    return IR_NONE;
  }
  return p;
}

/// Loop rotation. A loop whose test is at the top, `L: t = cmp a, b; br t,
/// B, E; B: ...; jmp L`, tests again at the bottom instead of jumping back to
/// the test: the `jmp L` becomes `t' = cmp a, b; br t', B, E`, so a pass of
/// the loop runs one jump fewer. The first test stays where it is. Returns
/// how many jumps it replaced.
fn iropt_rotate(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let nl = f.nlabel;
  if nl > 100000000 || n > 4000000 {
    return 0;
  }
  // Where each label is, and for a label heading `t = cmp; br t, B, E; B:`
  // where t is read nowhere else, the position of the compare.
  let mut lpos = vec_new[u64]();
  let mut hdr = vec_new[u64]();
  let mut l = 0;
  while l < nl {
    vec_push(&mut lpos, IR_NONE);
    vec_push(&mut hdr, IR_NONE);
    l = wrap_add(l, 1);
  }
  let mut i = 0;
  while i < n {
    let q = iropt_at(f, i);
    if q.op == IR_LABEL && q.a < nl {
      ra_set(&mut lpos, q.a, i);
    }
    i = wrap_add(i, 1);
  }
  let nuse = iropt_nuse(f);
  let ndef = iropt_ndef(f);
  l = 0;
  while l < nl {
    let h = u_at(lpos, l);
    if h != IR_NONE && wrap_add(h, 3) < n {
      let c = iropt_at(f, wrap_add(h, 1));
      let b = iropt_at(f, wrap_add(h, 2));
      let lb = iropt_at(f, wrap_add(h, 3));
      if iropt_is_cmp(c.op) && c.d < f.nreg && b.op == IR_BR && b.a == c.d && lb.op == IR_LABEL && lb.a == b.b && b.b != b.c && u_at(nuse, c.d) == 1 && u_at(ndef, c.d) == 1 {
        ra_set(&mut hdr, l, wrap_add(h, 1));
      }
    }
    l = wrap_add(l, 1);
  }
  let mut out = vec_new[IrIns]();
  let mut done = 0;
  i = 0;
  while i < n {
    let q = iropt_at(f, i);
    let mut rotated = false;
    if q.op == IR_JMP && q.a < nl {
      let h = u_at(hdr, q.a);
      if h != IR_NONE && h < i {
        let c = iropt_at(f, h);
        let b = iropt_at(f, wrap_add(h, 1));
        let t2 = ir_reg(&mut f);
        vec_push(&mut out, IrIns { op: c.op, d: t2, a: c.a, b: c.b, c: c.c, ty: c.ty });
        vec_push(&mut out, IrIns { op: IR_BR, d: b.d, a: t2, b: b.b, c: b.c, ty: b.ty });
        done = wrap_add(done, 1);
        rotated = true;
      }
    }
    if !rotated {
      vec_push(&mut out, q);
    }
    i = wrap_add(i, 1);
  }
  vec_free(lpos);
  vec_free(hdr);
  vec_free(nuse);
  vec_free(ndef);
  if done == 0 {
    vec_free(out);
    return 0;
  }
  vec_free(f.ins);
  f.ins = out;
  return done;
}

/// Jump threading: when `br r, T, F` leads to a label whose first
/// instruction is another `br r, T2, F2` on the same register (nothing
/// between can change `r`), the outcome is already known on that edge, so
/// the edge goes straight to T2 or F2. This is what `&&` and `||` leave
/// behind: the result is materialised in a register, then tested again.
/// An edge to a label whose first instruction is a `jmp` goes to the target
/// of that `jmp`. Returns how many edges it redirected.
fn iropt_thread(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let mut lpos = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut lpos, IR_NONE);
    l = l + 1;
  }
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_LABEL {
      ra_set(&mut lpos, q.a, i);
    }
    i = i + 1;
  }
  let mut changed = 0;
  i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_BR {
      let mut tt = q.b;
      let mut ff = q.c;
      let mut k = 0;
      while k < 8 {
        let p = iropt_after_label(f, lpos, tt);
        if p < vec_len(f.ins) {
          let t = vec_get(f.ins, p);
          if t.op == IR_BR && t.a == q.a && t.b != tt {
            tt = t.b;
            changed = wrap_add(changed, 1);
          } else if t.op == IR_JMP && t.a != tt {
            // A label that only jumps on: go there directly.
            tt = t.a;
            changed = wrap_add(changed, 1);
          }
        }
        k = k + 1;
      }
      k = 0;
      while k < 8 {
        let p = iropt_after_label(f, lpos, ff);
        if p < vec_len(f.ins) {
          let t = vec_get(f.ins, p);
          if t.op == IR_BR && t.a == q.a && t.c != ff {
            ff = t.c;
            changed = wrap_add(changed, 1);
          } else if t.op == IR_JMP && t.a != ff {
            ff = t.a;
            changed = wrap_add(changed, 1);
          }
        }
        k = k + 1;
      }
      if (tt != q.b || ff != q.c) && i < vec_len(f.ins) {
        vec_set(&mut f.ins, i, IrIns { op: IR_BR, d: q.d, a: q.a, b: tt, c: ff, ty: q.ty });
      }
    }
    i = i + 1;
  }
  vec_free(lpos);
  return changed;
}

/// Label clean-up: a `jmp L` whose target follows it (with only labels in
/// between) goes, and so does every label that no `jmp` or `br` names. The
/// lowering of `a && b` and of an inlined `return` leaves both behind, and a
/// label that nothing jumps to still stops copy propagation from looking
/// past it. Returns how many instructions it removed.
fn iropt_labels(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let mut dead = vec_new[u64]();
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    vec_push(&mut dead, 0);
    if q.op == IR_JMP {
      let mut p = wrap_add(i, 1);
      let mut going = true;
      while going && p < n {
        let t = vec_get(f.ins, p);
        if t.op == IR_LABEL {
          if t.a == q.a {
            ra_set(&mut dead, i, 1);
            going = false;
          }
          p = wrap_add(p, 1);
        } else {
          going = false;
        }
      }
    }
    i = i + 1;
  }
  let mut refs = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut refs, 0);
    l = l + 1;
  }
  i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if u_at(dead, i) == 0 {
      if q.op == IR_JMP && q.a < f.nlabel {
        ra_set(&mut refs, q.a, 1);
      }
      if q.op == IR_BR {
        if q.b < f.nlabel {
          ra_set(&mut refs, q.b, 1);
        }
        if q.c < f.nlabel {
          ra_set(&mut refs, q.c, 1);
        }
      }
    }
    i = i + 1;
  }
  let mut out = vec_new[IrIns]();
  let mut total = 0;
  i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    let mut drop = u_at(dead, i) == 1;
    if q.op == IR_LABEL && q.a < f.nlabel && u_at(refs, q.a) == 0 {
      drop = true;
    }
    if drop {
      total = wrap_add(total, 1);
    } else {
      vec_push(&mut out, q);
    }
    i = i + 1;
  }
  vec_free(dead);
  vec_free(refs);
  vec_free(f.ins);
  f.ins = out;
  return total;
}

/// The value that the register `r` is known to hold: `kv` at the position
/// where `kr` has it (IR_NONE: not known).
fn iropt_known(kr: &Vec[u64], kv: &Vec[u64], r: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(kr) {
    if vec_get(kr, k) == r {
      return u_at(kv, k);
    }
    k = k + 1;
  }
  return IR_NONE;
}

/// Notes that `r` now holds `v` (IR_NONE: something unknown).
fn iropt_note(kr: &mut Vec[u64], kv: &mut Vec[u64], r: u64, v: u64) {
  let mut k = 0;
  while k < vec_len(kr) {
    if vec_get(kr, k) == r {
      ra_set(&mut kv, k, v);
      return;
    }
    k = k + 1;
  }
  vec_push(&mut kr, r);
  vec_push(&mut kv, v);
}

/// What the registers known to hold constants hold after `t`.
fn iropt_step(kr: &mut Vec[u64], kv: &mut Vec[u64], t: IrIns) {
  if t.op == IR_CONST && t.a != IR_NONE {
    iropt_note(&mut kr, &mut kv, t.d, t.a);
  } else if t.op == IR_MOV && iropt_known(kr, kv, t.a) != IR_NONE {
    iropt_note(&mut kr, &mut kv, t.d, iropt_known(kr, kv, t.a));
  } else if (t.op == IR_EQ || t.op == IR_NE) && iropt_known(kr, kv, t.a) != IR_NONE && iropt_known(kr, kv, t.b) != IR_NONE {
    let same = iropt_known(kr, kv, t.a) == iropt_known(kr, kv, t.b);
    let mut v = 0;
    if same == (t.op == IR_EQ) {
      v = 1;
    }
    iropt_note(&mut kr, &mut kv, t.d, v);
  } else {
    let mut ws = vec_new[u64]();
    ra_writes(t, &mut ws);
    let mut j = 0;
    while j < vec_len(ws) {
      iropt_note(&mut kr, &mut kv, vec_get(ws, j), IR_NONE);
      j = j + 1;
    }
    vec_free(ws);
  }
}

/// The register that stands for `r` in the copy of a block: its entry in
/// `mr`/`mn` (the last one written), or `r`.
fn iropt_renamed(mr: &Vec[u64], mn: &Vec[u64], r: u64) -> u64 {
  let mut k = vec_len(mr);
  while k > 0 {
    k = k - 1;
    if u_at(mr, k) == r {
      return u_at(mn, k);
    }
  }
  return r;
}

/// Do all the reads of `r` in `f` sit in the instructions after the label
/// of position `from` up to position `to` (the `br` ending the block), each
/// after an instruction of the block wrote `r`? (`nread` counts the reads of
/// each register over the whole function.)
fn iropt_local(f: &IrFn, nread: &Vec[u64], lpos: &Vec[u64], l: u64, to: u64, r: u64) -> bool {
  if r == IR_NONE {
    return false;
  }
  let mut e = wrap_add(u_at(lpos, l), 1);
  let mut written = false;
  let mut inside = 0;
  while e <= to && e < vec_len(f.ins) {
    let t = vec_get(f.ins, e);
    let mut rs = vec_new[u64]();
    ra_reads(f, t, &mut rs);
    let mut k = 0;
    while k < vec_len(rs) {
      if vec_get(rs, k) == r {
        if !written {
          vec_free(rs);
          return false;
        }
        inside = wrap_add(inside, 1);
      }
      k = k + 1;
    }
    vec_free(rs);
    if t.d == r && t.op != IR_BR {
      written = true;
    }
    e = e + 1;
  }
  return written && inside == u_at(nread, r);
}

/// Drops the instructions that control cannot reach: those after a jump,
/// branch or return up to a label that nothing jumps to, and so on. Returns
/// how many it dropped.
fn iropt_reach(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let mut lpos = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut lpos, IR_NONE);
    l = l + 1;
  }
  let mut reach = vec_new[u64]();
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    vec_push(&mut reach, 0);
    if q.op == IR_LABEL {
      ra_set(&mut lpos, q.a, i);
    }
    i = i + 1;
  }
  let mut work = vec_new[u64]();
  vec_push(&mut work, 0);
  while vec_len(work) > 0 {
    let mut p = vec_pop(&mut work);
    let mut going = true;
    while going && p < n {
      if u_at(reach, p) != 0 {
        going = false;
      } else {
        ra_set(&mut reach, p, 1);
        let q = vec_get(f.ins, p);
        if q.op == IR_JMP {
          vec_push(&mut work, u_at(lpos, q.a));
          going = false;
        } else if q.op == IR_BR {
          vec_push(&mut work, u_at(lpos, q.b));
          vec_push(&mut work, u_at(lpos, q.c));
          going = false;
        } else if q.op == IR_RET || q.op == IR_UNREACH {
          going = false;
        } else {
          p = p + 1;
        }
      }
    }
  }
  let mut out = vec_new[IrIns]();
  i = 0;
  while i < n {
    if u_at(reach, i) != 0 {
      vec_push(&mut out, vec_get(f.ins, i));
    }
    i = i + 1;
  }
  let dropped = wrap_sub(n, vec_len(out));
  vec_free(work);
  vec_free(reach);
  vec_free(lpos);
  if dropped > 0 {
    vec_free(f.ins);
    f.ins = out;
  } else {
    vec_free(out);
  }
  return dropped;
}

/// A comparison of `x` with a constant, as the set of values of `x` for
/// which it is true: [lo, hi] (unsigned). `ok` is false for anything but
/// `lt`, `le`, `gt` and `ge` against a nonempty set.
struct IrSpan { ok: bool, x: u64, lo: u64, hi: u64 }

/// The span of `c = op a, b` when one operand is a register written once by
/// a `const` and the other is not. `neg` takes the span of the negation.
fn iropt_span(cv: &Vec[u64], q: IrIns, neg: bool) -> IrSpan {
  let none = IrSpan { ok: false, x: 0, lo: 0, hi: 0 };
  if q.a == IR_NONE || q.b == IR_NONE {
    return none;
  }
  let ka = iropt_cval(cv, q.a);
  let kb = iropt_cval(cv, q.b);
  let mut op = q.op;
  let mut x = q.a;
  let mut k = kb;
  if ka != IR_NONE && kb == IR_NONE {
    op = iropt_cmp_swap(q.op);
    x = q.b;
    k = ka;
  } else if ka != IR_NONE || kb == IR_NONE {
    return none;
  }
  if op < IR_LT || op > IR_GE {
    return none;
  }
  if neg {
    op = iropt_cmp_neg(op);
  }
  if op == IR_LT && k >= 1 {
    return IrSpan { ok: true, x: x, lo: 0, hi: k - 1 };
  }
  if op == IR_LE {
    return IrSpan { ok: true, x: x, lo: 0, hi: k };
  }
  if op == IR_GT && k < IR_NONE {
    return IrSpan { ok: true, x: x, lo: k + 1, hi: IR_NONE };
  }
  if op == IR_GE {
    return IrSpan { ok: true, x: x, lo: k, hi: IR_NONE };
  }
  return none;
}

/// Range checks. `x < a || x > b` (and `a <= x && x <= b`, which the lowering
/// writes as the same two branches to the same place) is two compares and
/// two branches; with `t = x - a` it is the one unsigned compare `t > b - a`.
/// The pair `c1 = cmp x, K1; br c1, T, N; N: [const..] c2 = cmp x, K2; br c2,
/// T, M` (either branch may name its target on the false side), where the
/// two compares are unsigned and one covers the values from 0 up, the other
/// the values down from the largest, and nothing else enters `N`, becomes
/// `t = sub x, a; c = gt t, b - a; br c, T, M`. Returns how many pairs it
/// replaced.
fn iropt_range(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let ndef = iropt_ndef(f);
  let nuse = iropt_nuse(f);
  let cv = iropt_consts(f, ndef);
  let mut refs = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut refs, 0);
    l = l + 1;
  }
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_JMP && q.a < f.nlabel {
      ra_set(&mut refs, q.a, wrap_add(u_at(refs, q.a), 1));
    }
    if q.op == IR_BR {
      if q.b < f.nlabel {
        ra_set(&mut refs, q.b, wrap_add(u_at(refs, q.b), 1));
      }
      if q.c < f.nlabel {
        ra_set(&mut refs, q.c, wrap_add(u_at(refs, q.c), 1));
      }
    }
    i = i + 1;
  }
  let mut out = vec_new[IrIns]();
  let mut done = 0;
  i = 0;
  while i < n {
    let q0 = vec_get(f.ins, i);
    let mut used = false;
    if iropt_is_cmp(q0.op) && i + 1 < n && u_at(ndef, q0.d) == 1 && u_at(nuse, q0.d) == 1 {
      let q1 = vec_get(f.ins, i + 1);
      if q1.op == IR_BR && q1.a == q0.d && q1.b != q1.c {
        // The label N that the first branch falls to, on either side.
        let mut nl = q1.c;
        let mut tl = q1.b;
        let mut neg1 = false;
        if i + 2 < n {
          let w = vec_get(f.ins, i + 2);
          if w.op == IR_LABEL && w.a == q1.b {
            nl = q1.b;
            tl = q1.c;
            neg1 = true;
          }
        }
        // Skip the labels, then constants, to the second compare.
        let mut p = i + 2;
        let mut clean = true;
        let mut sawn = false;
        let mut going = true;
        while going && p < n
          invariant p <= n
        {
          let w = vec_get(f.ins, p);
          if w.op == IR_LABEL {
            let mut want = 0;
            if w.a == nl {
              want = 1;
              sawn = true;
            }
            if w.a >= f.nlabel || u_at(refs, w.a) != want {
              clean = false;
            }
            p = p + 1;
          } else if w.op == IR_CONST {
            p = p + 1;
          } else {
            going = false;
          }
        }
        if clean && sawn && p + 1 < n {
          let q2 = vec_get(f.ins, p);
          let q3 = vec_get(f.ins, p + 1);
          if iropt_is_cmp(q2.op) && q3.op == IR_BR && q3.a == q2.d && u_at(ndef, q2.d) == 1 && u_at(nuse, q2.d) == 1 {
            let mut ml = q3.c;
            let mut neg2 = false;
            let mut ok = false;
            if q3.b == tl && q3.c != tl {
              ok = true;
            } else if q3.c == tl && q3.b != tl {
              ok = true;
              neg2 = true;
              ml = q3.b;
            }
            if ok && ml != nl {
              let s1 = iropt_span(cv, q0, neg1);
              let s2 = iropt_span(cv, q2, neg2);
              if s1.ok && s2.ok && s1.x == s2.x && s1.x != q0.d && s1.x != q2.d {
                // The values that go to T: [0, a-1] and [b+1, max].
                let mut a = IR_NONE;
                let mut b = IR_NONE;
                if s1.lo == 0 && s2.hi == IR_NONE && s1.hi < IR_NONE && s2.lo >= 1 && s1.hi + 1 < s2.lo {
                  a = s1.hi + 1;
                  b = s2.lo - 1;
                } else if s2.lo == 0 && s1.hi == IR_NONE && s2.hi < IR_NONE && s1.lo >= 1 && s2.hi + 1 < s1.lo {
                  a = s2.hi + 1;
                  b = s1.lo - 1;
                }
                if a != IR_NONE {
                  // The constants of the second block stay (written once).
                  let mut j = i + 2;
                  while j < p {
                    let w = vec_get(f.ins, j);
                    if w.op == IR_CONST {
                      vec_push(&mut out, w);
                    }
                    j = j + 1;
                  }
                  let ra = ir_reg(&mut f);
                  let rw = ir_reg(&mut f);
                  let rt = ir_reg(&mut f);
                  vec_push(&mut out, IrIns { op: IR_CONST, d: ra, a: a, b: 0, c: 0, ty: 0 });
                  vec_push(&mut out, IrIns { op: IR_SUB, d: rt, a: s1.x, b: ra, c: 0, ty: 0 });
                  vec_push(&mut out, IrIns { op: IR_CONST, d: rw, a: b - a, b: 0, c: 0, ty: 0 });
                  vec_push(&mut out, IrIns { op: IR_GT, d: q0.d, a: rt, b: rw, c: 0, ty: q0.ty });
                  vec_push(&mut out, IrIns { op: IR_BR, d: q1.d, a: q0.d, b: tl, c: ml, ty: q1.ty });
                  done = wrap_add(done, 1);
                  used = true;
                  i = p + 2;
                }
              }
            }
          }
        }
      }
    }
    if !used {
      vec_push(&mut out, q0);
      i = i + 1;
    }
  }
  vec_free(ndef);
  vec_free(nuse);
  vec_free(cv);
  vec_free(refs);
  if done > 0 {
    vec_free(f.ins);
    f.ins = out;
  } else {
    vec_free(out);
  }
  return done;
}

/// Collapses chains of moves inside a straight-line run: after `b = mov a`,
/// a later `c = mov b` in the same run (neither written between) reads `a`,
/// and so does a later binary operation, load, store or branch that reads
/// `b`. Returns how many instructions it changed.
fn iropt_chain(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let mut cd = vec_new[u64]();
  let mut cs = vec_new[u64]();
  let mut changed = 0;
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_LABEL || q.op == IR_JMP || q.op == IR_BR || q.op == IR_RET || q.op == IR_UNREACH {
      vec_free(cd);
      vec_free(cs);
      cd = vec_new[u64]();
      cs = vec_new[u64]();
    } else {
      let mut u = q;
      if q.op == IR_MOV {
        let mut k = 0;
        while k < vec_len(cd) {
          if vec_get(cd, k) == u.a {
            u.a = u_at(cs, k);
            k = vec_len(cd);
          } else {
            k = k + 1;
          }
        }
        if u.a != q.a {
          vec_set(&mut f.ins, i, u);
          changed = wrap_add(changed, 1);
        }
      } else if q.op == IR_BR {
        // A read of the copy reads its source, so that a comparison feeds
        // the branch that tests it and the copy can go.
        let mut k = 0;
        while k < vec_len(cd) {
          u = iropt_rename(u, vec_get(cd, k), u_at(cs, k));
          k = k + 1;
        }
        if u.a != q.a || u.b != q.b || u.d != q.d {
          vec_set(&mut f.ins, i, u);
          changed = wrap_add(changed, 1);
        }
      }
      let mut ws = vec_new[u64]();
      ra_writes(u, &mut ws);
      let mut j = 0;
      while j < vec_len(ws) {
        let w = vec_get(ws, j);
        let mut keepd = vec_new[u64]();
        let mut keeps = vec_new[u64]();
        let mut k = 0;
        while k < vec_len(cd) {
          if vec_get(cd, k) != w && u_at(cs, k) != w {
            vec_push(&mut keepd, vec_get(cd, k));
            vec_push(&mut keeps, u_at(cs, k));
          }
          k = k + 1;
        }
        vec_free(cd);
        vec_free(cs);
        cd = keepd;
        cs = keeps;
        j = j + 1;
      }
      vec_free(ws);
      if u.op == IR_MOV && u.a != u.d && u.a != IR_NONE {
        vec_push(&mut cd, u.d);
        vec_push(&mut cs, u.a);
      }
    }
    i = i + 1;
  }
  vec_free(cd);
  vec_free(cs);
  return changed;
}

/// Jump threading through a merge block. When `jmp L` is reached with some
/// registers known to hold constants, and the block at `L` is a few moves,
/// constants and comparisons followed by a `br` whose condition those make
/// known, the `jmp` takes a copy of the block and goes straight to the
/// branch's target. (A label inside the block, after its first instruction,
/// ends the search: another path may enter there.) This is what an inlined function that returns an enum
/// leaves behind: each return writes the tag and the fields into a few
/// registers and jumps to one block that tests the tag. Returns how many
/// jumps it redirected.
fn iropt_merge(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let mut lpos = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut lpos, IR_NONE);
    l = l + 1;
  }
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_LABEL {
      ra_set(&mut lpos, q.a, i);
    }
    i = i + 1;
  }
  let mut nread = vec_new[u64]();
  l = 0;
  while l < f.nreg && l < 1000000000 {
    vec_push(&mut nread, 0);
    l = l + 1;
  }
  i = 0;
  while i < n {
    let mut rs = vec_new[u64]();
    ra_reads(f, vec_get(f.ins, i), &mut rs);
    let mut k = 0;
    while k < vec_len(rs) {
      let r = vec_get(rs, k);
      ra_set(&mut nread, r, wrap_add(u_at(nread, r), 1));
      k = k + 1;
    }
    vec_free(rs);
    i = i + 1;
  }
  let mut out = vec_new[IrIns]();
  let mut kr = vec_new[u64]();
  let mut kv = vec_new[u64]();
  let mut changed = 0;
  i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    let mut threaded = false;
    if q.op == IR_JMP && q.a < f.nlabel && vec_len(out) < 1000000 {
      let mut sr = vec_new[u64]();
      let mut sv = vec_new[u64]();
      let mut k = 0;
      while k < vec_len(kr) {
        vec_push(&mut sr, vec_get(kr, k));
        vec_push(&mut sv, u_at(kv, k));
        k = k + 1;
      }
      let mut j = u_at(lpos, q.a);
      let mut target = IR_NONE;
      let mut len = 0;
      let mut going = j != IR_NONE;
      if going {
        j = j + 1;
      }
      while going && j < n && len < 24 {
        let t = vec_get(f.ins, j);
        if t.op == IR_LABEL && len == 0 {
          j = j + 1;
        } else if t.op == IR_BR {
          let v = iropt_known(sr, sv, t.a);
          if v != IR_NONE {
            if v != 0 {
              target = t.b;
            } else {
              target = t.c;
            }
          }
          going = false;
        } else if t.op == IR_CONST || t.op == IR_MOV || t.op == IR_EQ || t.op == IR_NE {
          iropt_step(&mut sr, &mut sv, t);
          j = j + 1;
          len = len + 1;
        } else {
          going = false;
        }
      }
      if target != IR_NONE {
        // The copy of the block. A register that only the block reads, after
        // the block wrote it, is a temporary: the copy writes a new one, which
        // nothing reads and `iropt_dce` removes. A move from a register that
        // holds a known constant becomes a constant.
        let mut cr = vec_new[u64]();
        let mut cv = vec_new[u64]();
        let mut mr = vec_new[u64]();
        let mut mn = vec_new[u64]();
        let mut e = wrap_add(u_at(lpos, q.a), 1);
        while e < j && e < n {
          let t = vec_get(f.ins, e);
          if t.op != IR_LABEL {
            let mut u = t;
            // Reads go through the renaming made so far.
            if t.op == IR_MOV || t.op == IR_EQ || t.op == IR_NE {
              u.a = iropt_renamed(mr, mn, t.a);
              if t.op != IR_MOV {
                u.b = iropt_renamed(mr, mn, t.b);
              }
            }
            if t.op == IR_MOV && iropt_known(cr, cv, u.a) != IR_NONE {
              u = IrIns { op: IR_CONST, d: t.d, a: iropt_known(cr, cv, u.a), b: 0, c: 0, ty: 0 };
            }
            iropt_step(&mut cr, &mut cv, u);
            if iropt_local(f, nread, lpos, q.a, j, t.d) {
              let fresh = ir_reg(&mut f);
              u.d = fresh;
              vec_push(&mut mr, t.d);
              vec_push(&mut mn, fresh);
            }
            vec_push(&mut out, u);
          }
          e = e + 1;
        }
        vec_free(cr);
        vec_free(cv);
        vec_free(mr);
        vec_free(mn);
        vec_push(&mut out, IrIns { op: IR_JMP, d: q.d, a: target, b: q.b, c: q.c, ty: q.ty });
        changed = wrap_add(changed, 1);
        threaded = true;
      }
      vec_free(sr);
      vec_free(sv);
    }
    if !threaded {
      vec_push(&mut out, q);
    }
    if q.op == IR_LABEL {
      vec_free(kr);
      vec_free(kv);
      kr = vec_new[u64]();
      kv = vec_new[u64]();
    } else {
      iropt_step(&mut kr, &mut kv, q);
    }
    i = i + 1;
  }
  vec_free(lpos);
  vec_free(nread);
  vec_free(kr);
  vec_free(kv);
  if changed > 0 {
    vec_free(f.ins);
    f.ins = out;
    iropt_reach(&mut f);
    iropt_chain(&mut f);
  } else {
    vec_free(out);
  }
  return changed;
}

/// Moves a block that only one `jmp` reaches to that `jmp`. `L:` must have
/// no other reference and sit after an instruction that ends a block (so
/// nothing falls into it), and the block must run to its own end without
/// another label. The `jmp` and the label go, and the block's instructions
/// take the `jmp`'s place: what was a join of a few paths with one entry
/// becomes straight-line code, where copies can be followed. Returns how many
/// blocks it moved.
fn iropt_hoist1(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let mut refs = vec_new[u64]();
  let mut lpos = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut refs, 0);
    vec_push(&mut lpos, IR_NONE);
    l = l + 1;
  }
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_LABEL && q.a < f.nlabel {
      ra_set(&mut lpos, q.a, i);
    }
    if q.op == IR_JMP && q.a < f.nlabel {
      ra_set(&mut refs, q.a, wrap_add(u_at(refs, q.a), 1));
    }
    if q.op == IR_BR {
      if q.b < f.nlabel {
        ra_set(&mut refs, q.b, wrap_add(u_at(refs, q.b), 1));
      }
      if q.c < f.nlabel {
        ra_set(&mut refs, q.c, wrap_add(u_at(refs, q.c), 1));
      }
    }
    i = i + 1;
  }
  // kind[i]: 1 inside a block that moves, 2 a `jmp` that takes one.
  let mut kind = vec_new[u64]();
  let mut bs = vec_new[u64]();
  let mut be = vec_new[u64]();
  i = 0;
  while i < n {
    vec_push(&mut kind, 0);
    vec_push(&mut bs, 0);
    vec_push(&mut be, 0);
    i = i + 1;
  }
  let mut moved = 0;
  i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if q.op == IR_JMP && q.a < f.nlabel && u_at(refs, q.a) == 1 && u_at(kind, i) == 0 {
      let p = u_at(lpos, q.a);
      if p != IR_NONE && p > 0 && p < n && p != i {
        let before = vec_get(f.ins, wrap_sub(p, 1));
        if ra_is_end(before.op) {
          // The block: instructions p + 1 .. e, no label, ending in an end.
          let mut e = wrap_add(p, 1);
          let mut going = true;
          let mut good = false;
          while going && e < n {
            let t = vec_get(f.ins, e);
            if t.op == IR_LABEL {
              going = false;
            } else if ra_is_end(t.op) {
              good = true;
              going = false;
            } else {
              e = wrap_add(e, 1);
            }
          }
          if good && e < n {
            let mut free = true;
            let mut k = p;
            while k <= e && k < n {
              if u_at(kind, k) != 0 || k == i {
                free = false;
              }
              k = wrap_add(k, 1);
            }
            if free {
              k = p;
              while k <= e && k < n {
                ra_set(&mut kind, k, 1);
                k = wrap_add(k, 1);
              }
              ra_set(&mut kind, i, 2);
              ra_set(&mut bs, i, p);
              ra_set(&mut be, i, e);
              moved = wrap_add(moved, 1);
            }
          }
        }
      }
    }
    i = i + 1;
  }
  if moved > 0 {
    let mut out = vec_new[IrIns]();
    i = 0;
    while i < n {
      let k = u_at(kind, i);
      if k == 0 {
        vec_push(&mut out, vec_get(f.ins, i));
      } else if k == 2 {
        let mut j = wrap_add(u_at(bs, i), 1);
        let e = u_at(be, i);
        while j <= e && j < n {
          vec_push(&mut out, vec_get(f.ins, j));
          j = wrap_add(j, 1);
        }
      }
      i = i + 1;
    }
    vec_free(f.ins);
    f.ins = out;
  }
  vec_free(refs);
  vec_free(lpos);
  vec_free(kind);
  vec_free(bs);
  vec_free(be);
  return moved;
}

/// `iropt_hoist1` until nothing moves: a block that took another block's
/// `jmp` has a `jmp` of its own that can then take its target.
fn iropt_hoist(f: &mut IrFn) -> u64 {
  let mut total = 0;
  let mut rounds = 0;
  let mut again = true;
  while again && rounds < 6 {
    rounds = rounds + 1;
    let k = iropt_hoist1(&mut f);
    total = wrap_add(total, k);
    again = k > 0;
  }
  return total;
}

/// Dead stores by liveness: a pure instruction whose result is live on no
/// path after it goes. `iropt_dce` only sees registers nobody reads or that
/// are overwritten in the same run; this also removes a write to a register
/// that is read elsewhere but not from here on. Returns how many it removed.
fn iropt_dead_live(f: &mut IrFn) -> u64 {
  let mut total = 0;
  let mut again = true;
  let mut rounds = 0;
  while again && rounds < 2 {
    again = false;
    rounds = rounds + 1;
    let bl = ra_blocks(f);
    let lv = ra_live(f, bl);
    let nr = f.nreg;
    let n = vec_len(f.ins);
    let mut dead = vec_new[u64]();
    let mut i = 0;
    while i < n {
      vec_push(&mut dead, 0);
      i = i + 1;
    }
    let mut live = vec_new[u64]();
    let mut r = 0;
    while r < nr && r < 1000000000 {
      vec_push(&mut live, 0);
      r = r + 1;
    }
    let mut b = 0;
    while b < vec_len(bl) {
      let blk = vec_get(bl, b);
      r = 0;
      while r < nr && r < 1000000000 {
        if ra_out(lv, b, r) {
          ra_set(&mut live, r, 1);
        } else {
          ra_set(&mut live, r, 0);
        }
        r = r + 1;
      }
      let mut k = blk.e;
      while k > blk.s && k <= n {
        k = k - 1;
        let q = vec_get(f.ins, k);
        if iropt_pure(q) && q.d < nr && u_at(live, q.d) == 0 {
          ra_set(&mut dead, k, 1);
        } else {
          let mut ws = vec_new[u64]();
          ra_writes(q, &mut ws);
          let mut j = 0;
          while j < vec_len(ws) {
            let w = vec_get(ws, j);
            if w < nr {
              ra_set(&mut live, w, 0);
            }
            j = j + 1;
          }
          vec_free(ws);
          let mut rs = vec_new[u64]();
          ra_reads(f, q, &mut rs);
          j = 0;
          while j < vec_len(rs) {
            let rr = vec_get(rs, j);
            if rr < nr {
              ra_set(&mut live, rr, 1);
            }
            j = j + 1;
          }
          vec_free(rs);
        }
      }
      b = b + 1;
    }
    vec_free(live);
    let mut out = vec_new[IrIns]();
    i = 0;
    while i < n {
      if u_at(dead, i) == 1 {
        total = wrap_add(total, 1);
        again = true;
      } else {
        vec_push(&mut out, vec_get(f.ins, i));
      }
      i = i + 1;
    }
    vec_free(dead);
    vec_free(f.ins);
    f.ins = out;
    vec_free(bl);
    vec_free(lv.inn);
    vec_free(lv.out);
    vec_free(lv.bit);
  }
  return total;
}

/// Does `q` only compute a register (no effect, no trap)? Division is left
/// out: removing it would be sound (the verifier proved the divisor), but a
/// `div` that the allocator keeps costs nothing against one it never saw.
fn iropt_pure(q: IrIns) -> bool {
  let op = q.op;
  // The routines that switch the page table (`mmu_enter`, `mmu_exit`) have an
  // effect even when nobody reads their result.
  if op == IR_RT && (q.c == IRS_USER_TABLE || q.c == IRS_KERNEL_TABLE) {
    return false;
  }
  return op == IR_CONST || op == IR_MOV || op == IR_NOT || op == IR_NEG || op == IR_WRAP || op == IR_RT || op == IR_GLOBAL || op == IR_LOAD
    || op == IR_SLOT || op == IR_STRLIT || (ra_is_binary(op) && op != IR_DIV && op != IR_SDIV && op != IR_REM && op != IR_SREM);
}

/// Dead code elimination. Two kinds of pure instruction go: one whose result
/// no instruction reads (repeated until nothing changes, for chains), and
/// one whose result is overwritten later in the same straight-line run of
/// instructions with no read between (the lowering leaves `v = const 0` then
/// `v = mov x` behind when it fills a result tuple). Returns how many
/// instructions it removed.
fn iropt_dce(f: &mut IrFn) -> u64 {
  let mut total = 0;
  let mut again = true;
  let mut rounds = 0;
  while again && rounds < 16 {
    again = false;
    rounds = rounds + 1;
    let n = vec_len(f.ins);
    let mut nread = vec_new[u64]();
    let mut r = 0;
    while r < f.nreg && r < 1000000000 {
      vec_push(&mut nread, 0);
      r = r + 1;
    }
    let mut dead = vec_new[u64]();
    // pend[r]: the pure instruction that wrote r with no read since (IR_NONE: none).
    let mut pend = vec_new[u64]();
    r = 0;
    while r < f.nreg && r < 1000000000 {
      vec_push(&mut pend, IR_NONE);
      r = r + 1;
    }
    let mut touched = vec_new[u64]();
    let mut i = 0;
    while i < n {
      let q = vec_get(f.ins, i);
      vec_push(&mut dead, 0);
      let mut rs = vec_new[u64]();
      ra_reads(f, q, &mut rs);
      let mut j = 0;
      while j < vec_len(rs) {
        let rr = vec_get(rs, j);
        ra_set(&mut nread, rr, wrap_add(u_at(nread, rr), 1));
        ra_set(&mut pend, rr, IR_NONE);
        j = j + 1;
      }
      vec_free(rs);
      let mut ws = vec_new[u64]();
      ra_writes(q, &mut ws);
      j = 0;
      while j < vec_len(ws) {
        let wr = vec_get(ws, j);
        let pp = u_at(pend, wr);
        if pp != IR_NONE && pp < vec_len(dead) {
          vec_set(&mut dead, pp, 1);
        }
        if iropt_pure(q) && wr < f.nreg {
          ra_set(&mut pend, wr, i);
          vec_push(&mut touched, wr);
        } else {
          ra_set(&mut pend, wr, IR_NONE);
        }
        j = j + 1;
      }
      vec_free(ws);
      if q.op == IR_LABEL || q.op == IR_JMP || q.op == IR_BR || q.op == IR_RET || q.op == IR_UNREACH {
        while vec_len(touched) > 0 {
          let tr = vec_pop(&mut touched);
          ra_set(&mut pend, tr, IR_NONE);
        }
      }
      i = i + 1;
    }
    // A pure instruction whose result is never read.
    i = 0;
    while i < n {
      let q = vec_get(f.ins, i);
      if iropt_pure(q) && q.d < f.nreg && u_at(nread, q.d) == 0 {
        ra_set(&mut dead, i, 1);
      }
      i = i + 1;
    }
    let mut out = vec_new[IrIns]();
    i = 0;
    while i < n {
      let q = vec_get(f.ins, i);
      if u_at(dead, i) == 1 {
        total = wrap_add(total, 1);
        again = true;
      } else {
        vec_push(&mut out, q);
      }
      i = i + 1;
    }
    vec_free(f.ins);
    f.ins = out;
    vec_free(touched);
    vec_free(pend);
    vec_free(dead);
    vec_free(nread);
  }
  return total;
}

// ---- Common subexpressions ----

fn iropt_pop(v: &mut Vec[u64]) -> u64 {
  if vec_len(v) > 0 {
    return vec_pop(&mut v);
  }
  return 0;
}

fn iropt_blk(bl: &Vec[IrBlock], b: u64) -> IrBlock {
  if b < vec_len(bl) {
    return vec_get(bl, b);
  }
  return IrBlock { s: 0, e: 0, n1: 0, n2: 0 };
}

/// Is `op` commutative among the pure binary operations?
fn iropt_commutes(op: u64) -> bool {
  return op == IR_ADD || op == IR_MUL || op == IR_AND || op == IR_OR || op == IR_XOR || op == IR_EQ || op == IR_NE;
}

/// An operand of a key: a register that is written once stands for what it
/// copies, and one that holds a constant for the constant itself. `kind` is
/// 1 for a constant, 0 for a register.
struct IrKey { v: u64, kind: u64 }

fn iropt_keyed(ndef: &Vec[u64], cv: &Vec[u64], rep: &Vec[u64], r: u64) -> IrKey {
  let mut x = r;
  let rx = u_at(rep, x);
  if rx != IR_NONE {
    x = rx;
  }
  let k = u_at(cv, x);
  if k != IR_NONE {
    return IrKey { v: k, kind: 1 };
  }
  return IrKey { v: x, kind: 0 };
}

/// Does `op` possibly write memory, or depend on anything but registers and
/// memory it reads? Everything not listed does.
fn iropt_kills(op: u64) -> bool {
  if ra_is_binary(op) {
    return false;
  }
  return !(op == IR_CONST || op == IR_MOV || op == IR_NOT || op == IR_NEG || op == IR_WRAP || op == IR_LABEL || op == IR_JMP || op == IR_BR || op == IR_RET || op == IR_UNREACH || op == IR_LOAD || op == IR_SLOT || op == IR_GLOBAL || op == IR_STRLIT);
}

/// A load whose address registers and result register are written once.
fn iropt_lelig(q: IrIns, nr: u64, ndef: &Vec[u64]) -> bool {
  return q.op == IR_LOAD && q.d < nr && q.a < nr && q.b < nr && q.d != q.a && q.d != q.b && u_at(ndef, q.d) == 1 && u_at(ndef, q.a) == 1 && u_at(ndef, q.b) == 1;
}

fn iropt_lhash(q: IrIns, ndef: &Vec[u64], cv: &Vec[u64], rep: &Vec[u64]) -> u64 {
  let ka = iropt_keyed(ndef, cv, rep, q.a);
  let kb = iropt_keyed(ndef, cv, rep, q.b);
  return wrap_add(wrap_mul(ka.v, 7919), wrap_add(wrap_mul(kb.v, 104729), wrap_add(wrap_mul(wrap_add(ka.kind, wrap_mul(2, kb.kind)), 31), wrap_add(wrap_mul(q.c, 17), wrap_mul(q.ty, 131))))) % 4096;
}

fn iropt_lsame(p: IrIns, q: IrIns, ndef: &Vec[u64], cv: &Vec[u64], rep: &Vec[u64]) -> bool {
  if p.c != q.c || p.ty != q.ty {
    return false;
  }
  let pa = iropt_keyed(ndef, cv, rep, p.a);
  let pb = iropt_keyed(ndef, cv, rep, p.b);
  let qa = iropt_keyed(ndef, cv, rep, q.a);
  let qb = iropt_keyed(ndef, cv, rep, q.b);
  return pa.v == qa.v && pa.kind == qa.kind && pb.v == qb.v && pb.kind == qb.kind;
}

fn iropt_bit(set: &Vec[u64], w: u64, id: u64) -> bool {
  return (u_at(set, w) & (1 << (id % 64))) != 0;
}

/// Redundant loads. A load is available at a point when, on every path to
/// it, the same load ran and no instruction that may write memory ran after
/// it. Its result register (written once, like the address registers) still
/// holds the value, so a second load of the same address is a copy of it.
/// A forward dataflow over the blocks; the sets are bit sets of the loads.
/// Returns how many loads it turned into copies.
fn iropt_loads(f: &mut IrFn, bl: &Vec[IrBlock], nb: u64, pstart: &Vec[u64], plist: &Vec[u64], seen: &Vec[u64], rpo: &Vec[u64], ndef: &Vec[u64], cv: &Vec[u64], rep: &Vec[u64]) -> u64 {
  let n = vec_len(f.ins);
  let nr = f.nreg;
  // Number the eligible loads.
  let mut lid = vec_new[u64]();
  let mut lins = vec_new[u64]();
  let mut lh = vec_new[u64]();
  let mut head = vec_new[u64]();
  let mut lnext = vec_new[u64]();
  let mut k = 0;
  while k < 4096 {
    vec_push(&mut head, IR_NONE);
    k = wrap_add(k, 1);
  }
  let mut i = 0;
  while i < n {
    let q = vec_get(f.ins, i);
    if iropt_lelig(q, nr, ndef) {
      let id = vec_len(lins);
      let h = iropt_lhash(q, ndef, cv, rep);
      vec_push(&mut lid, id);
      vec_push(&mut lins, i);
      vec_push(&mut lh, h);
      vec_push(&mut lnext, u_at(head, h));
      ra_set(&mut head, h, id);
    } else {
      vec_push(&mut lid, IR_NONE);
    }
    i = wrap_add(i, 1);
  }
  let ni = vec_len(lins);
  let nw = wrap_add(ni / 64, 1);
  let mut found = 0;
  if ni > 1 && ni <= 16384 && wrap_mul(nb, nw) <= 4000000 {
    // Per block: whether it holds a write, and the loads after its last one.
    let tot = wrap_mul(nb, nw);
    let mut gen = vec_new[u64]();
    let mut inn = vec_new[u64]();
    let mut out = vec_new[u64]();
    let mut hk = vec_new[u64]();
    k = 0;
    while k < tot {
      vec_push(&mut gen, 0);
      vec_push(&mut inn, 0);
      vec_push(&mut out, 18446744073709551615);
      k = wrap_add(k, 1);
    }
    let mut b = 0;
    while b < nb {
      let blk = iropt_blk(bl, b);
      let mut kill = 0;
      let mut j = blk.s;
      while j < blk.e && j < n {
        let q = vec_get(f.ins, j);
        if iropt_kills(q.op) {
          kill = 1;
          let mut w = 0;
          while w < nw {
            ra_set(&mut gen, wrap_add(wrap_mul(b, nw), w), 0);
            w = wrap_add(w, 1);
          }
        } else if q.op == IR_LOAD {
          let id = u_at(lid, j);
          if id != IR_NONE {
            let wi = wrap_add(wrap_mul(b, nw), id / 64);
            ra_set(&mut gen, wi, u_at(gen, wi) | (1 << (id % 64)));
          }
        }
        j = wrap_add(j, 1);
      }
      vec_push(&mut hk, kill);
      b = wrap_add(b, 1);
    }
    // Iterate to a fixed point, blocks in reverse postorder.
    let mut changed = true;
    let mut rounds = 0;
    while changed && rounds < 50 {
      changed = false;
      rounds = wrap_add(rounds, 1);
      let mut ri = vec_len(rpo);
      while ri > 0 {
        ri = wrap_sub(ri, 1);
        let bb = u_at(rpo, ri);
        let mut w = 0;
        while w < nw {
          let wo = wrap_add(wrap_mul(bb, nw), w);
          let mut acc = 18446744073709551615;
          if bb == 0 {
            acc = 0;
          } else {
            let mut pi = u_at(pstart, bb);
            let pe = u_at(pstart, wrap_add(bb, 1));
            while pi < pe {
              let pp = u_at(plist, pi);
              if u_at(seen, pp) != 0 {
                acc = acc & u_at(out, wrap_add(wrap_mul(pp, nw), w));
              }
              pi = wrap_add(pi, 1);
            }
          }
          ra_set(&mut inn, wo, acc);
          let mut o = u_at(gen, wo);
          if u_at(hk, bb) == 0 {
            o = o | acc;
          }
          if o != u_at(out, wo) {
            ra_set(&mut out, wo, o);
            changed = true;
          }
          w = wrap_add(w, 1);
        }
      }
    }
    if !changed {
      // Rewrite.
      let mut cur = vec_new[u64]();
      k = 0;
      while k < nw {
        vec_push(&mut cur, 0);
        k = wrap_add(k, 1);
      }
      b = 0;
      while b < nb {
        if u_at(seen, b) != 0 {
          let blk = iropt_blk(bl, b);
          let mut w = 0;
          while w < nw {
            ra_set(&mut cur, w, u_at(inn, wrap_add(wrap_mul(b, nw), w)));
            w = wrap_add(w, 1);
          }
          let mut j = blk.s;
          while j < blk.e && j < n {
            let q = vec_get(f.ins, j);
            if iropt_kills(q.op) {
              w = 0;
              while w < nw {
                ra_set(&mut cur, w, 0);
                w = wrap_add(w, 1);
              }
            } else if q.op == IR_LOAD {
              let id = u_at(lid, j);
              if id != IR_NONE {
                let mut e = u_at(head, u_at(lh, id));
                let mut hit = IR_NONE;
                let mut guard = 0;
                while e != IR_NONE && hit == IR_NONE && guard < 100000 {
                  if e != id && iropt_bit(cur, e / 64, e) {
                    let p = iropt_at(f, u_at(lins, e));
                    if iropt_lsame(p, q, ndef, cv, rep) {
                      hit = p.d;
                    }
                  }
                  e = u_at(lnext, e);
                  guard = wrap_add(guard, 1);
                }
                if hit != IR_NONE {
                  vec_set(&mut f.ins, j, IrIns { op: IR_MOV, d: q.d, a: hit, b: 0, c: 0, ty: 0 });
                  found = wrap_add(found, 1);
                }
                ra_set(&mut cur, id / 64, u_at(cur, id / 64) | (1 << (id % 64)));
              }
            }
            j = wrap_add(j, 1);
          }
        }
        b = wrap_add(b, 1);
      }
      vec_free(cur);
    }
    vec_free(gen);
    vec_free(inn);
    vec_free(out);
    vec_free(hk);
  }
  vec_free(lid);
  vec_free(lins);
  vec_free(lh);
  vec_free(head);
  vec_free(lnext);
  return found;
}

/// The table of the walk: entries are expressions (op, two keyed operands, c
/// and ty), each with the register that holds its result, or with a known
/// value (`val` not IR_NONE). Entries with op 0 say a register is known;
/// ops 1000 and 1001 say a register equals / differs from a constant.
struct IrTab { op: Vec[u64], av: Vec[u64], ak: Vec[u64], bv: Vec[u64], bk: Vec[u64], cc: Vec[u64], ty: Vec[u64], res: Vec[u64], val: Vec[u64], next: Vec[u64], buck: Vec[u64], head: Vec[u64] }

fn iropt_tab_new() -> IrTab {
  let mut head = vec_new[u64]();
  let mut k = 0;
  while k < 16384 {
    vec_push(&mut head, IR_NONE);
    k = wrap_add(k, 1);
  }
  return IrTab { op: vec_new[u64](), av: vec_new[u64](), ak: vec_new[u64](), bv: vec_new[u64](), bk: vec_new[u64](), cc: vec_new[u64](), ty: vec_new[u64](), res: vec_new[u64](), val: vec_new[u64](), next: vec_new[u64](), buck: vec_new[u64](), head: head };
}

fn iropt_tab_free(t: IrTab) {
  vec_free(t.op);
  vec_free(t.av);
  vec_free(t.ak);
  vec_free(t.bv);
  vec_free(t.bk);
  vec_free(t.cc);
  vec_free(t.ty);
  vec_free(t.res);
  vec_free(t.val);
  vec_free(t.next);
  vec_free(t.buck);
  vec_free(t.head);
}

fn iropt_tab_hash(op: u64, av: u64, ak: u64, bv: u64, bk: u64, cc: u64, ty: u64) -> u64 {
  if op >= 1000 || op == 0 {
    return wrap_add(wrap_mul(op, 1000003), wrap_mul(av, 7919)) % 16384;
  }
  return wrap_add(wrap_mul(op, 1000003), wrap_add(wrap_mul(av, 7919), wrap_add(wrap_mul(bv, 104729), wrap_add(wrap_mul(wrap_add(ak, wrap_mul(2, bk)), 31), wrap_add(wrap_mul(cc, 17), wrap_mul(ty, 131)))))) % 16384;
}

/// The newest entry with exactly this key, or IR_NONE.
fn iropt_tab_find(t: &IrTab, op: u64, av: u64, ak: u64, bv: u64, bk: u64, cc: u64, ty: u64) -> u64 {
  let h = iropt_tab_hash(op, av, ak, bv, bk, cc, ty);
  let mut e = u_at(t.head, h);
  let mut guard = 0;
  while e != IR_NONE && guard < 100000 {
    if u_at(t.op, e) == op && u_at(t.av, e) == av && u_at(t.ak, e) == ak && u_at(t.bv, e) == bv && u_at(t.bk, e) == bk && u_at(t.cc, e) == cc && u_at(t.ty, e) == ty {
      return e;
    }
    e = u_at(t.next, e);
    guard = wrap_add(guard, 1);
  }
  return IR_NONE;
}

/// The newest entry of op `op` (1000 or 1001) for register `x`, any constant.
fn iropt_tab_findx(t: &IrTab, op: u64, x: u64) -> u64 {
  let h = iropt_tab_hash(op, x, 0, 0, 0, 0, 0);
  let mut e = u_at(t.head, h);
  let mut guard = 0;
  while e != IR_NONE && guard < 100000 {
    if u_at(t.op, e) == op && u_at(t.av, e) == x {
      return e;
    }
    e = u_at(t.next, e);
    guard = wrap_add(guard, 1);
  }
  return IR_NONE;
}

fn iropt_tab_add(t: &mut IrTab, op: u64, av: u64, ak: u64, bv: u64, bk: u64, cc: u64, ty: u64, res: u64, val: u64) {
  let id = vec_len(t.op);
  let h = iropt_tab_hash(op, av, ak, bv, bk, cc, ty);
  vec_push(&mut t.op, op);
  vec_push(&mut t.av, av);
  vec_push(&mut t.ak, ak);
  vec_push(&mut t.bv, bv);
  vec_push(&mut t.bk, bk);
  vec_push(&mut t.cc, cc);
  vec_push(&mut t.ty, ty);
  vec_push(&mut t.res, res);
  vec_push(&mut t.val, val);
  vec_push(&mut t.next, u_at(t.head, h));
  vec_push(&mut t.buck, h);
  ra_set(&mut t.head, h, id);
}

/// Drop the entries added since the table had `mark` of them.
fn iropt_tab_trim(t: &mut IrTab, mark: u64) {
  while vec_len(t.op) > mark {
    let id = wrap_sub(vec_len(t.op), 1);
    ra_set(&mut t.head, u_at(t.buck, id), u_at(t.next, id));
    iropt_pop(&mut t.op);
    iropt_pop(&mut t.av);
    iropt_pop(&mut t.ak);
    iropt_pop(&mut t.bv);
    iropt_pop(&mut t.bk);
    iropt_pop(&mut t.cc);
    iropt_pop(&mut t.ty);
    iropt_pop(&mut t.res);
    iropt_pop(&mut t.val);
    iropt_pop(&mut t.next);
    iropt_pop(&mut t.buck);
  }
}

fn iropt_is_cmp(op: u64) -> bool {
  return op >= IR_EQ && op <= IR_SGE;
}

/// The comparison that is true exactly when `op` is false.
fn iropt_cmp_neg(op: u64) -> u64 {
  if op == IR_EQ { return IR_NE; }
  if op == IR_NE { return IR_EQ; }
  if op == IR_LT { return IR_GE; }
  if op == IR_GE { return IR_LT; }
  if op == IR_LE { return IR_GT; }
  if op == IR_GT { return IR_LE; }
  if op == IR_SLT { return IR_SGE; }
  if op == IR_SGE { return IR_SLT; }
  if op == IR_SLE { return IR_SGT; }
  return IR_SLE;
}

/// The comparison with its operands exchanged.
fn iropt_cmp_swap(op: u64) -> u64 {
  if op == IR_LT { return IR_GT; }
  if op == IR_GT { return IR_LT; }
  if op == IR_LE { return IR_GE; }
  if op == IR_GE { return IR_LE; }
  if op == IR_SLT { return IR_SGT; }
  if op == IR_SGT { return IR_SLT; }
  if op == IR_SLE { return IR_SGE; }
  if op == IR_SGE { return IR_SLE; }
  return op;
}

/// A comparison of a register with a constant, as "x op k" (op unsigned),
/// from the keyed operands of a comparison.
struct IrCmpX { ok: bool, x: u64, k: u64, op: u64 }

fn iropt_cmpx(op: u64, ka: IrKey, kb: IrKey) -> IrCmpX {
  if op < IR_EQ || op > IR_GE {
    return IrCmpX { ok: false, x: 0, k: 0, op: 0 };
  }
  if ka.kind == 0 && kb.kind == 1 {
    return IrCmpX { ok: true, x: ka.v, k: kb.v, op: op };
  }
  if ka.kind == 1 && kb.kind == 0 {
    return IrCmpX { ok: true, x: kb.v, k: ka.v, op: iropt_cmp_swap(op) };
  }
  return IrCmpX { ok: false, x: 0, k: 0, op: 0 };
}

/// The tightest bound the table has for register `x`: its lowest (op 1002)
/// or highest (op 1003) value; IR_NONE when it has none.
fn iropt_bound(t: &IrTab, x: u64, op: u64) -> u64 {
  let h = iropt_tab_hash(op, x, 0, 0, 0, 0, 0);
  let mut e = u_at(t.head, h);
  let mut best = IR_NONE;
  let mut guard = 0;
  while e != IR_NONE && guard < 100000 {
    if u_at(t.op, e) == op && u_at(t.av, e) == x {
      let v = u_at(t.bv, e);
      if best == IR_NONE || (op == 1002 && v > best) || (op == 1003 && v < best) {
        best = v;
      }
    }
    e = u_at(t.next, e);
    guard = wrap_add(guard, 1);
  }
  return best;
}

/// What "x op k = v" says about the range of x, recorded as bounds.
fn iropt_bounds(t: &mut IrTab, c: IrCmpX, v: u64) {
  let mut op = c.op;
  if v == 0 {
    op = iropt_cmp_neg(op);
  }
  let k = c.k;
  if op == IR_LT && k > 0 {
    iropt_tab_add(&mut t, 1003, c.x, 0, wrap_sub(k, 1), 1, 0, 0, IR_NONE, 1);
  } else if op == IR_LE {
    iropt_tab_add(&mut t, 1003, c.x, 0, k, 1, 0, 0, IR_NONE, 1);
  } else if op == IR_GT && k < 18446744073709551615 {
    iropt_tab_add(&mut t, 1002, c.x, 0, wrap_add(k, 1), 1, 0, 0, IR_NONE, 1);
  } else if op == IR_GE {
    iropt_tab_add(&mut t, 1002, c.x, 0, k, 1, 0, 0, IR_NONE, 1);
  } else if op == IR_EQ {
    iropt_tab_add(&mut t, 1002, c.x, 0, k, 1, 0, 0, IR_NONE, 1);
    iropt_tab_add(&mut t, 1003, c.x, 0, k, 1, 0, 0, IR_NONE, 1);
  }
}

/// Whether the range of c.x the table knows decides "x op k": 0, 1 or IR_NONE.
fn iropt_by_range(t: &IrTab, c: IrCmpX) -> u64 {
  let mut lo = iropt_bound(t, c.x, 1002);
  let mut hi = iropt_bound(t, c.x, 1003);
  if lo == IR_NONE {
    lo = 0;
  }
  if hi == IR_NONE {
    hi = 18446744073709551615;
  }
  let k = c.k;
  let op = c.op;
  if op == IR_LT {
    if hi < k { return 1; }
    if lo >= k { return 0; }
  } else if op == IR_LE {
    if hi <= k { return 1; }
    if lo > k { return 0; }
  } else if op == IR_GT {
    if lo > k { return 1; }
    if hi <= k { return 0; }
  } else if op == IR_GE {
    if lo >= k { return 1; }
    if hi < k { return 0; }
  } else if op == IR_EQ {
    if lo > k || hi < k { return 0; }
    if lo == k && hi == k { return 1; }
  } else if op == IR_NE {
    if lo > k || hi < k { return 1; }
    if lo == k && hi == k { return 0; }
  }
  return IR_NONE;
}


/// Where a branch fact holds: the branch is the instruction `bri` of the
/// block that starts at `ps`; `lo`..`hi` are the dominator-tree numbers of
/// the blocks that learn it, and `chk` says whether a register written more
/// than once must have no write among them.
struct IrEdge { bri: u64, ps: u64, lo: u64, hi: u64, chk: bool }

/// Does register `x` have no write in a block numbered `lo`..`hi`?
fn iropt_nodef(dstart: &Vec[u64], dlist: &Vec[u64], x: u64, lo: u64, hi: u64) -> bool {
  let mut p = u_at(dstart, x);
  let e = u_at(dstart, wrap_add(x, 1));
  while p < e {
    let b = u_at(dlist, p);
    if b >= lo && b <= hi {
      return false;
    }
    p = wrap_add(p, 1);
  }
  return true;
}

/// Do the operands of comparison `d` (instruction `di`), whose result the
/// branch `e.bri` tests, still mean the same where the fact holds? A
/// register written once always does. One written more often must not change
/// between the comparison and the branch (the comparison is in the branch's
/// block), and with `e.chk` must not be written in the blocks that learn it.
fn iropt_stable(f: &IrFn, ndef: &Vec[u64], dstart: &Vec[u64], dlist: &Vec[u64], d: IrIns, di: u64, e: IrEdge) -> bool {
  let am = u_at(ndef, d.a) != 1;
  let bm = u_at(ndef, d.b) != 1;
  if !am && !bm {
    return true;
  }
  if di < e.ps || di >= e.bri {
    return false;
  }
  let mut ok = true;
  let mut j = wrap_add(di, 1);
  while j < e.bri {
    let mut ws = vec_new[u64]();
    ra_writes(iropt_at(f, j), &mut ws);
    let mut k = 0;
    while k < vec_len(ws) {
      let w = vec_get(ws, k);
      if (am && w == d.a) || (bm && w == d.b) {
        ok = false;
      }
      k = wrap_add(k, 1);
    }
    vec_free(ws);
    j = wrap_add(j, 1);
  }
  if e.chk {
    if am && !iropt_nodef(dstart, dlist, d.a, e.lo, e.hi) {
      ok = false;
    }
    if bm && !iropt_nodef(dstart, dlist, d.b, e.lo, e.hi) {
      ok = false;
    }
  }
  return ok;
}

/// Record that register `c`, a comparison written once, is `v` (0 or 1):
/// the comparison itself and its negation and mirror images, and, for a
/// comparison with a constant, what that says about the other operand.
fn iropt_fact(f: &IrFn, ndef: &Vec[u64], cv: &Vec[u64], rep: &Vec[u64], defi: &Vec[u64], dstart: &Vec[u64], dlist: &Vec[u64], t: &mut IrTab, c: u64, v: u64, e: IrEdge) {
  iropt_tab_add(&mut t, 0, c, 0, 0, 0, 0, 0, IR_NONE, v);
  let di = u_at(defi, c);
  if di == IR_NONE {
    return;
  }
  let d = iropt_at(f, di);
  if !iropt_is_cmp(d.op) || d.d != c || d.a >= f.nreg || d.b >= f.nreg || d.a == d.d || d.b == d.d {
    return;
  }
  if !iropt_stable(f, ndef, dstart, dlist, d, di, e) {
    return;
  }
  let ka = iropt_keyed(ndef, cv, rep, d.a);
  let kb = iropt_keyed(ndef, cv, rep, d.b);
  let nv = wrap_sub(1, v);
  let sw = iropt_cmp_swap(d.op);
  let ng = iropt_cmp_neg(d.op);
  let ns = iropt_cmp_neg(sw);
  iropt_tab_add(&mut t, d.op, ka.v, ka.kind, kb.v, kb.kind, d.c, d.ty, IR_NONE, v);
  iropt_tab_add(&mut t, ng, ka.v, ka.kind, kb.v, kb.kind, d.c, d.ty, IR_NONE, nv);
  iropt_tab_add(&mut t, sw, kb.v, kb.kind, ka.v, ka.kind, d.c, d.ty, IR_NONE, v);
  iropt_tab_add(&mut t, ns, kb.v, kb.kind, ka.v, ka.kind, d.c, d.ty, IR_NONE, nv);
  let cx = iropt_cmpx(d.op, ka, kb);
  if cx.ok {
    iropt_bounds(&mut t, cx, v);
  }
  if d.op == IR_EQ || d.op == IR_NE {
    let mut x = ka;
    let mut k = kb;
    if ka.kind == 1 {
      x = kb;
      k = ka;
    }
    if x.kind == 0 && k.kind == 1 {
      let mut same = 0;
      if d.op == IR_EQ && v == 1 {
        same = 1;
      }
      if d.op == IR_NE && v == 0 {
        same = 1;
      }
      if same == 1 {
        iropt_tab_add(&mut t, 1000, x.v, 0, k.v, 1, 0, 0, IR_NONE, 1);
      } else {
        iropt_tab_add(&mut t, 1001, x.v, 0, k.v, 1, 0, 0, IR_NONE, 1);
      }
    }
  }
}

/// What the table says the comparison `q` evaluates to: 0, 1 or IR_NONE.
fn iropt_decide(t: &IrTab, ndef: &Vec[u64], cv: &Vec[u64], rep: &Vec[u64], q: IrIns) -> u64 {
  let ka = iropt_keyed(ndef, cv, rep, q.a);
  let kb = iropt_keyed(ndef, cv, rep, q.b);
  let e = iropt_tab_find(t, q.op, ka.v, ka.kind, kb.v, kb.kind, q.c, q.ty);
  if e != IR_NONE {
    let v = u_at(t.val, e);
    if v != IR_NONE {
      return v;
    }
  }
  if q.op == IR_EQ || q.op == IR_NE {
    let mut x = ka;
    let mut k = kb;
    if ka.kind == 1 {
      x = kb;
      k = ka;
    }
    if x.kind == 0 && k.kind == 1 {
      let mut eq = IR_NONE;
      let ee = iropt_tab_findx(t, 1000, x.v);
      if ee != IR_NONE {
        if u_at(t.bv, ee) == k.v {
          eq = 1;
        } else {
          eq = 0;
        }
      } else if iropt_tab_find(t, 1001, x.v, 0, k.v, 1, 0, 0) != IR_NONE {
        eq = 0;
      }
      if eq != IR_NONE {
        if q.op == IR_EQ {
          return eq;
        }
        return wrap_sub(1, eq);
      }
    }
  }
  let cx = iropt_cmpx(q.op, ka, kb);
  if cx.ok {
    return iropt_by_range(t, cx);
  }
  return IR_NONE;
}

/// An edge into block `sb` (a block number plus one, as `ra_blocks` has it)
/// that holds only a label, constants read once and a comparison with its
/// branch. When the table (and the branch `c` = `v` the edge itself makes,
/// unless `c` is IR_NONE) decides the comparison, the label the edge should
/// go to instead; IR_NONE when it is not decided or `sb` has another shape.
fn iropt_jt_edge(f: &IrFn, bl: &Vec[IrBlock], ndef: &Vec[u64], cv: &Vec[u64], rep: &Vec[u64], nuse: &Vec[u64], defi: &Vec[u64], dstart: &Vec[u64], dlist: &Vec[u64], t: &mut IrTab, sb: u64, from: u64, ps: u64, bri: u64, c: u64, v: u64) -> u64 {
  let nr = f.nreg;
  if sb == 0 {
    return IR_NONE;
  }
  let mut s = wrap_sub(sb, 1);
  let mut blk = iropt_blk(bl, s);
  // Past blocks that only hold labels, or a label and a jump.
  let mut hop = 0;
  let mut going = true;
  while going && hop < 8 && blk.n1 != 0 {
    let h0 = iropt_at(f, blk.s);
    let h1 = iropt_at(f, wrap_add(blk.s, 1));
    if h0.op == IR_LABEL && (blk.e == wrap_add(blk.s, 1) || (blk.e == wrap_add(blk.s, 2) && h1.op == IR_JMP)) {
      s = wrap_sub(blk.n1, 1);
      blk = iropt_blk(bl, s);
      hop = wrap_add(hop, 1);
    } else {
      going = false;
    }
  }
  if s == from || blk.e < wrap_add(blk.s, 3) {
    return IR_NONE;
  }
  let first = iropt_at(f, blk.s);
  let cm = iropt_at(f, wrap_sub(blk.e, 2));
  let br = iropt_at(f, wrap_sub(blk.e, 1));
  if first.op != IR_LABEL || br.op != IR_BR || !iropt_is_cmp(cm.op) || cm.d != br.a {
    return IR_NONE;
  }
  if cm.d >= nr || cm.a >= nr || cm.b >= nr || u_at(ndef, cm.d) != 1 || u_at(nuse, cm.d) != 1 {
    return IR_NONE;
  }
  let mut p = wrap_add(blk.s, 1);
  let stop = wrap_sub(blk.e, 2);
  while p < stop {
    let q = iropt_at(f, p);
    // Each constant must be one of the comparison's own operands: a constant
    // read once elsewhere (by an arm of the branch) would be left unset on
    // the path that skips this block.
    if q.op != IR_CONST || q.d >= nr || u_at(ndef, q.d) != 1 || u_at(nuse, q.d) != 1 || (q.d != cm.a && q.d != cm.b) {
      return IR_NONE;
    }
    p = wrap_add(p, 1);
  }
  let mark = vec_len(t.op);
  if c != IR_NONE {
    iropt_fact(f, ndef, cv, rep, defi, dstart, dlist, &mut t, c, v, IrEdge { bri: bri, ps: ps, lo: 1, hi: 0, chk: false });
  }
  let r = iropt_decide(t, ndef, cv, rep, cm);
  iropt_tab_trim(&mut t, mark);
  if r == 1 {
    return br.b;
  }
  if r == 0 {
    return br.c;
  }
  return IR_NONE;
}

/// Common subexpression elimination over the dominator tree. A binary
/// operation whose operands are registers written once (or constants), and
/// whose result lands in a register written once, is remembered while the
/// walk is inside the blocks its block dominates. The same operation on the
/// same operands there becomes a copy of the first result: the first one has
/// run on every path to the second, and nothing can have changed the
/// operands. `pid * 72` after `pid * 72` inlined from two table reads is the
/// case this is for. Returns how many operations it turned into copies.
fn iropt_cse(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let bl = ra_blocks(f);
  let nb = vec_len(bl);
  let nr = f.nreg;
  if nb < 2 || nb > 200000 || n > 4000000 {
    vec_free(bl);
    return 0;
  }
  // Predecessors, as lists in one vector: pstart[b] .. pstart[b + 1].
  let mut pcount = vec_new[u64]();
  let mut b = 0;
  while b <= nb {
    vec_push(&mut pcount, 0);
    b = wrap_add(b, 1);
  }
  b = 0;
  while b < nb {
    let blk = iropt_blk(bl, b);
    if blk.n1 != 0 {
      ra_set(&mut pcount, wrap_sub(blk.n1, 1), wrap_add(u_at(pcount, wrap_sub(blk.n1, 1)), 1));
    }
    if blk.n2 != 0 && blk.n2 != blk.n1 {
      ra_set(&mut pcount, wrap_sub(blk.n2, 1), wrap_add(u_at(pcount, wrap_sub(blk.n2, 1)), 1));
    }
    b = wrap_add(b, 1);
  }
  let mut pstart = vec_new[u64]();
  let mut acc = 0;
  b = 0;
  while b <= nb {
    vec_push(&mut pstart, acc);
    acc = wrap_add(acc, u_at(pcount, b));
    b = wrap_add(b, 1);
  }
  let mut pfill = vec_new[u64]();
  let mut plist = vec_new[u64]();
  b = 0;
  while b < nb {
    vec_push(&mut pfill, u_at(pstart, b));
    b = wrap_add(b, 1);
  }
  let mut k = 0;
  while k < acc && k < 400000 {
    vec_push(&mut plist, 0);
    k = wrap_add(k, 1);
  }
  b = 0;
  while b < nb {
    let blk = iropt_blk(bl, b);
    if blk.n1 != 0 {
      let t = wrap_sub(blk.n1, 1);
      ra_set(&mut plist, u_at(pfill, t), b);
      ra_set(&mut pfill, t, wrap_add(u_at(pfill, t), 1));
    }
    if blk.n2 != 0 && blk.n2 != blk.n1 {
      let t = wrap_sub(blk.n2, 1);
      ra_set(&mut plist, u_at(pfill, t), b);
      ra_set(&mut pfill, t, wrap_add(u_at(pfill, t), 1));
    }
    b = wrap_add(b, 1);
  }
  // Postorder numbers by an iterative depth-first search from block 0.
  let mut po = vec_new[u64]();
  let mut seen = vec_new[u64]();
  let mut cursor = vec_new[u64]();
  b = 0;
  while b < nb {
    vec_push(&mut po, IR_NONE);
    vec_push(&mut seen, 0);
    vec_push(&mut cursor, 0);
    b = wrap_add(b, 1);
  }
  let mut rpo = vec_new[u64]();
  let mut stack = vec_new[u64]();
  let mut npo = 0;
  vec_push(&mut stack, 0);
  ra_set(&mut seen, 0, 1);
  while vec_len(stack) > 0 {
    let top = u_at(stack, wrap_sub(vec_len(stack), 1));
    let blk = iropt_blk(bl, top);
    let c = u_at(cursor, top);
    ra_set(&mut cursor, top, wrap_add(c, 1));
    let mut nxt = 0;
    if c == 0 {
      nxt = blk.n1;
    } else if c == 1 {
      nxt = blk.n2;
    } else {
      ra_set(&mut po, top, npo);
      npo = wrap_add(npo, 1);
      vec_push(&mut rpo, top);
      iropt_pop(&mut stack);
    }
    if nxt != 0 && c < 2 {
      let t = wrap_sub(nxt, 1);
      if u_at(seen, t) == 0 {
        ra_set(&mut seen, t, 1);
        vec_push(&mut stack, t);
      }
    }
  }
  let ndef = iropt_ndef(f);
  let cv = iropt_consts(f, ndef);
  let mut rep = vec_new[u64]();
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut rep, IR_NONE);
    r = wrap_add(r, 1);
  }
  let nload = iropt_loads(&mut f, bl, nb, pstart, plist, seen, rpo, ndef, cv, rep);
  // Immediate dominators (Cooper, Harvey and Kennedy), blocks in reverse
  // postorder; rpo holds the postorder, so walk it backwards.
  let mut idom = vec_new[u64]();
  b = 0;
  while b < nb {
    vec_push(&mut idom, IR_NONE);
    b = wrap_add(b, 1);
  }
  ra_set(&mut idom, 0, 0);
  let mut changed = true;
  let mut rounds = 0;
  while changed && rounds < 100 {
    changed = false;
    rounds = wrap_add(rounds, 1);
    let mut ri = vec_len(rpo);
    while ri > 0 {
      ri = wrap_sub(ri, 1);
      let bb = u_at(rpo, ri);
      if bb != 0 {
        let mut nd = IR_NONE;
        let mut pi = u_at(pstart, bb);
        let pe = u_at(pstart, wrap_add(bb, 1));
        while pi < pe {
          let p = u_at(plist, pi);
          if u_at(idom, p) != IR_NONE && u_at(seen, p) != 0 {
            if nd == IR_NONE {
              nd = p;
            } else {
              let mut x = p;
              let mut y = nd;
              let mut guard = 0;
              while x != y && guard < 1000000 {
                while u_at(po, x) < u_at(po, y) && guard < 1000000 {
                  x = u_at(idom, x);
                  guard = wrap_add(guard, 1);
                }
                while u_at(po, y) < u_at(po, x) && guard < 1000000 {
                  y = u_at(idom, y);
                  guard = wrap_add(guard, 1);
                }
              }
              nd = x;
            }
          }
          pi = wrap_add(pi, 1);
        }
        if nd != IR_NONE && nd != u_at(idom, bb) {
          ra_set(&mut idom, bb, nd);
          changed = true;
        }
      }
    }
  }
  // The dominator tree: first child and next sibling.
  let mut child = vec_new[u64]();
  let mut sib = vec_new[u64]();
  b = 0;
  while b < nb {
    vec_push(&mut child, IR_NONE);
    vec_push(&mut sib, IR_NONE);
    b = wrap_add(b, 1);
  }
  b = nb;
  while b > 1 {
    b = wrap_sub(b, 1);
    let id = u_at(idom, b);
    if id != IR_NONE && u_at(seen, b) != 0 && id < nb {
      ra_set(&mut sib, b, u_at(child, id));
      ra_set(&mut child, id, b);
    }
  }
  // Preorder numbers of the dominator tree; a block's subtree is the numbers
  // from its own for `size` of them.
  let mut pre = vec_new[u64]();
  let mut size = vec_new[u64]();
  b = 0;
  while b < nb {
    vec_push(&mut pre, IR_NONE);
    vec_push(&mut size, 1);
    b = wrap_add(b, 1);
  }
  let mut ord = vec_new[u64]();
  let mut st2 = vec_new[u64]();
  vec_push(&mut st2, 0);
  while vec_len(st2) > 0 {
    let bb = iropt_pop(&mut st2);
    if bb < nb && u_at(pre, bb) == IR_NONE {
      ra_set(&mut pre, bb, vec_len(ord));
      vec_push(&mut ord, bb);
      let mut ch = u_at(child, bb);
      while ch != IR_NONE && ch < nb {
        vec_push(&mut st2, ch);
        ch = u_at(sib, ch);
      }
    }
  }
  let mut oi = vec_len(ord);
  while oi > 1 {
    oi = wrap_sub(oi, 1);
    let bb = u_at(ord, oi);
    let id = u_at(idom, bb);
    if id < nb {
      ra_set(&mut size, id, wrap_add(u_at(size, id), u_at(size, bb)));
    }
  }
  // The blocks (by number) that write each register written more than once.
  let mut dstart = vec_new[u64]();
  let mut dfill = vec_new[u64]();
  r = 0;
  while r <= nr && r < 1000000000 {
    vec_push(&mut dstart, 0);
    vec_push(&mut dfill, 0);
    r = wrap_add(r, 1);
  }
  b = 0;
  while b < nb {
    if u_at(pre, b) != IR_NONE {
      let blk = iropt_blk(bl, b);
      let mut j = blk.s;
      while j < blk.e && j < n {
        let mut ws = vec_new[u64]();
        ra_writes(vec_get(f.ins, j), &mut ws);
        let mut k2 = 0;
        while k2 < vec_len(ws) {
          let w = vec_get(ws, k2);
          if w < nr && u_at(ndef, w) > 1 {
            ra_set(&mut dstart, wrap_add(w, 1), wrap_add(u_at(dstart, wrap_add(w, 1)), 1));
          }
          k2 = wrap_add(k2, 1);
        }
        vec_free(ws);
        j = wrap_add(j, 1);
      }
    }
    b = wrap_add(b, 1);
  }
  r = 0;
  let mut dtot = 0;
  while r < nr && r < 1000000000 {
    dtot = wrap_add(dtot, u_at(dstart, wrap_add(r, 1)));
    ra_set(&mut dstart, wrap_add(r, 1), dtot);
    ra_set(&mut dfill, r, u_at(dstart, r));
    r = wrap_add(r, 1);
  }
  let mut dlist = vec_new[u64]();
  k = 0;
  while k < dtot && k < 8000000 {
    vec_push(&mut dlist, IR_NONE);
    k = wrap_add(k, 1);
  }
  b = 0;
  while b < nb {
    if u_at(pre, b) != IR_NONE {
      let blk = iropt_blk(bl, b);
      let mut j = blk.s;
      while j < blk.e && j < n {
        let mut ws = vec_new[u64]();
        ra_writes(vec_get(f.ins, j), &mut ws);
        let mut k2 = 0;
        while k2 < vec_len(ws) {
          let w = vec_get(ws, k2);
          if w < nr && u_at(ndef, w) > 1 {
            ra_set(&mut dlist, u_at(dfill, w), u_at(pre, b));
            ra_set(&mut dfill, w, wrap_add(u_at(dfill, w), 1));
          }
          k2 = wrap_add(k2, 1);
        }
        vec_free(ws);
        j = wrap_add(j, 1);
      }
    }
    b = wrap_add(b, 1);
  }
  // The walk.
  let mut defi = vec_new[u64]();
  r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut defi, IR_NONE);
    r = wrap_add(r, 1);
  }
  let mut ii = 0;
  while ii < n {
    let q = vec_get(f.ins, ii);
    if iropt_is_cmp(q.op) && q.d < nr && u_at(ndef, q.d) == 1 {
      ra_set(&mut defi, q.d, ii);
    }
    ii = wrap_add(ii, 1);
  }
  let nuse = iropt_nuse(f);
  let mut tab = iropt_tab_new();
  let mut found = nload;
  let mut work = vec_new[u64]();
  let mut wtop = vec_new[u64]();
  vec_push(&mut work, 0);
  vec_push(&mut wtop, 0);
  // Each frame: block, and (in `cursor`) the next child to visit; the first
  // visit processes the block.
  b = 0;
  while b < nb {
    ra_set(&mut cursor, b, IR_NONE);
    b = wrap_add(b, 1);
  }
  let mut steps = 0;
  while vec_len(work) > 0 && steps < 4000000 {
    steps = wrap_add(steps, 1);
    let top = u_at(work, wrap_sub(vec_len(work), 1));
    if u_at(cursor, top) == IR_NONE {
      // Enter: process the block.
      let mut c0 = u_at(child, top);
      if c0 == IR_NONE {
        c0 = nb;
      }
      ra_set(&mut cursor, top, c0);
      // What the edge into the block says about the branch before it, when
      // that edge is the only way in.
      if top != 0 {
        let id = u_at(idom, top);
        if id < nb && wrap_sub(u_at(pstart, wrap_add(top, 1)), u_at(pstart, top)) == 1 {
          let pb = iropt_blk(bl, id);
          if pb.e > 0 {
            let last = iropt_at(f, wrap_sub(pb.e, 1));
            if last.op == IR_BR && last.a < nr && u_at(ndef, last.a) == 1 {
              let tn = wrap_add(top, 1);
              let lo = u_at(pre, top);
              let hi = wrap_sub(wrap_add(lo, u_at(size, top)), 1);
              let ed = IrEdge { bri: wrap_sub(pb.e, 1), ps: pb.s, lo: lo, hi: hi, chk: true };
              if pb.n1 == tn && pb.n2 != tn {
                iropt_fact(f, ndef, cv, rep, defi, dstart, dlist, &mut tab, last.a, 1, ed);
              } else if pb.n2 == tn && pb.n1 != tn {
                iropt_fact(f, ndef, cv, rep, defi, dstart, dlist, &mut tab, last.a, 0, ed);
              }
            }
          }
        }
      }
      let blk = iropt_blk(bl, top);
      let mut i = blk.s;
      while i < blk.e && i < n {
        let q = vec_get(f.ins, i);
        if q.op == IR_MOV && q.d < nr && q.a < nr && u_at(ndef, q.d) == 1 && u_at(ndef, q.a) == 1 && q.d != q.a {
          let ra = u_at(rep, q.a);
          if ra != IR_NONE {
            ra_set(&mut rep, q.d, ra);
          } else {
            ra_set(&mut rep, q.d, q.a);
          }
        } else if q.op == IR_MUL && q.d < nr && q.a < nr && q.b < nr && q.d != q.a && q.d != q.b {
          if u_at(ndef, q.a) == 1 && u_at(ndef, q.b) == 1 {
            let mut ka = iropt_keyed(ndef, cv, rep, q.a);
            let mut kb = iropt_keyed(ndef, cv, rep, q.b);
            if iropt_commutes(q.op) && (kb.kind < ka.kind || (kb.kind == ka.kind && kb.v < ka.v)) {
              let tk = ka;
              ka = kb;
              kb = tk;
            }
            let e = iropt_tab_find(tab, q.op, ka.v, ka.kind, kb.v, kb.kind, q.c, q.ty);
            if e != IR_NONE {
              let hit = u_at(tab.res, e);
              vec_set(&mut f.ins, i, IrIns { op: IR_MOV, d: q.d, a: hit, b: 0, c: 0, ty: 0 });
              found = wrap_add(found, 1);
              if u_at(ndef, q.d) == 1 {
                ra_set(&mut rep, q.d, hit);
              }
            } else if u_at(ndef, q.d) == 1 {
              iropt_tab_add(&mut tab, q.op, ka.v, ka.kind, kb.v, kb.kind, q.c, q.ty, q.d, IR_NONE);
            }
          }
        } else if q.op == IR_RT && (q.c == IRS_FRAME_ID || q.c == IRS_PAGE_AT) && q.d < nr && q.a < nr && q.d != q.a && u_at(ndef, q.a) == 1 && u_at(ndef, q.d) == 1 {
          // The runs of RAM are fixed once the pool is set up, so the page
          // number of an address (and the address of a page) is a function
          // of the register alone.
          let ka = iropt_keyed(ndef, cv, rep, q.a);
          let e = iropt_tab_find(tab, q.op, ka.v, ka.kind, 0, 2, q.c, 0);
          if e != IR_NONE {
            let hit = u_at(tab.res, e);
            vec_set(&mut f.ins, i, IrIns { op: IR_MOV, d: q.d, a: hit, b: 0, c: 0, ty: 0 });
            found = wrap_add(found, 1);
            ra_set(&mut rep, q.d, hit);
          } else {
            iropt_tab_add(&mut tab, q.op, ka.v, ka.kind, 0, 2, q.c, 0, q.d, IR_NONE);
          }
        } else if iropt_is_cmp(q.op) && q.d < nr && q.a < nr && q.b < nr && q.d != q.a && q.d != q.b {
          let v = iropt_decide(tab, ndef, cv, rep, q);
          if v != IR_NONE {
            vec_set(&mut f.ins, i, IrIns { op: IR_CONST, d: q.d, a: v, b: 0, c: 0, ty: 0 });
            found = wrap_add(found, 1);
          }
        } else if q.op == IR_BR && q.a < nr && u_at(ndef, q.a) == 1 {
          let e = iropt_tab_find(tab, 0, q.a, 0, 0, 0, 0, 0);
          if e != IR_NONE {
            let v = u_at(tab.val, e);
            if v == 1 {
              vec_set(&mut f.ins, i, IrIns { op: IR_JMP, d: q.d, a: q.b, b: 0, c: 0, ty: 0 });
              found = wrap_add(found, 1);
            } else if v == 0 {
              vec_set(&mut f.ins, i, IrIns { op: IR_JMP, d: q.d, a: q.c, b: 0, c: 0, ty: 0 });
              found = wrap_add(found, 1);
            }
          }
        }
        i = wrap_add(i, 1);
      }
      // Edges out of the block into a test the block has decided.
      if blk.e > blk.s && blk.e <= n {
        let li = wrap_sub(blk.e, 1);
        let last = vec_get(f.ins, li);
        if last.op == IR_JMP {
          let nl = iropt_jt_edge(f, bl, ndef, cv, rep, nuse, defi, dstart, dlist, &mut tab, blk.n1, top, blk.s, li, IR_NONE, 0);
          if nl != IR_NONE && nl != last.a {
            vec_set(&mut f.ins, li, IrIns { op: IR_JMP, d: last.d, a: nl, b: 0, c: 0, ty: 0 });
            found = wrap_add(found, 1);
          }
        } else if last.op == IR_BR && last.b != last.c && last.a < nr && u_at(ndef, last.a) == 1 {
          let nt = iropt_jt_edge(f, bl, ndef, cv, rep, nuse, defi, dstart, dlist, &mut tab, blk.n1, top, blk.s, li, last.a, 1);
          let nf = iropt_jt_edge(f, bl, ndef, cv, rep, nuse, defi, dstart, dlist, &mut tab, blk.n2, top, blk.s, li, last.a, 0);
          let mut tl = last.b;
          let mut fl = last.c;
          if nt != IR_NONE {
            tl = nt;
          }
          if nf != IR_NONE {
            fl = nf;
          }
          if tl != last.b || fl != last.c {
            vec_set(&mut f.ins, li, IrIns { op: IR_BR, d: last.d, a: last.a, b: tl, c: fl, ty: last.ty });
            found = wrap_add(found, 1);
          }
        }
      }
    }
    // Next child, or leave.
    let cur = u_at(cursor, top);
    if cur != IR_NONE && cur < nb {
      let mut nx = u_at(sib, cur);
      if nx == IR_NONE {
        nx = nb;
      }
      ra_set(&mut cursor, top, nx);
      vec_push(&mut work, cur);
      vec_push(&mut wtop, vec_len(tab.op));
    } else {
      let mark = iropt_pop(&mut wtop);
      iropt_pop(&mut work);
      iropt_tab_trim(&mut tab, mark);
    }
  }
  iropt_tab_free(tab);
  vec_free(defi);
  vec_free(nuse);
  vec_free(pre);
  vec_free(size);
  vec_free(ord);
  vec_free(st2);
  vec_free(dstart);
  vec_free(dfill);
  vec_free(dlist);
  vec_free(work);
  vec_free(wtop);
  vec_free(rep);
  vec_free(cv);
  vec_free(ndef);
  vec_free(child);
  vec_free(sib);
  vec_free(idom);
  vec_free(stack);
  vec_free(rpo);
  vec_free(cursor);
  vec_free(seen);
  vec_free(po);
  vec_free(plist);
  vec_free(pfill);
  vec_free(pstart);
  vec_free(pcount);
  vec_free(bl);
  return found;
}

// ---- Strength reduction of induction variables ----

/// Where each label is (IR_NONE: nowhere), the lowest and highest position
/// of a jump to it, and how many of those jumps come from after the label.
struct IrLabs { pos: Vec[u64], lo: Vec[u64], hi: Vec[u64], back: Vec[u64] }

fn iropt_labs_ref(lb: &mut IrLabs, l: u64, i: u64) {
  if l < vec_len(lb.pos) {
    if i < u_at(lb.lo, l) {
      ra_set(&mut lb.lo, l, i);
    }
    if i > u_at(lb.hi, l) {
      ra_set(&mut lb.hi, l, i);
    }
    let p = u_at(lb.pos, l);
    if p != IR_NONE && i > p {
      ra_set(&mut lb.back, l, wrap_add(u_at(lb.back, l), 1));
    }
  }
}

fn iropt_labs(f: &IrFn) -> IrLabs {
  let mut lb = IrLabs { pos: vec_new[u64](), lo: vec_new[u64](), hi: vec_new[u64](), back: vec_new[u64]() };
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut lb.pos, IR_NONE);
    vec_push(&mut lb.lo, IR_NONE);
    vec_push(&mut lb.hi, 0);
    vec_push(&mut lb.back, 0);
    l = l + 1;
  }
  let n = vec_len(f.ins);
  let mut i = 0;
  while i < n {
    let q = iropt_at(f, i);
    if q.op == IR_LABEL {
      ra_set(&mut lb.pos, q.a, i);
    }
    i = wrap_add(i, 1);
  }
  i = 0;
  while i < n {
    let q = iropt_at(f, i);
    if q.op == IR_JMP {
      iropt_labs_ref(&mut lb, q.a, i);
    }
    if q.op == IR_BR {
      iropt_labs_ref(&mut lb, q.b, i);
      iropt_labs_ref(&mut lb, q.c, i);
    }
    i = wrap_add(i, 1);
  }
  return lb;
}

fn iropt_labs_free(lb: IrLabs) {
  vec_free(lb.pos);
  vec_free(lb.lo);
  vec_free(lb.hi);
  vec_free(lb.back);
}

/// Is the stretch p .. q of a loop (header label at p, the jump back at q)
/// one that is entered only at p, and has no jump backwards but the one at q?
fn iropt_ivs_span_ok(f: &IrFn, lb: &IrLabs, p: u64, q: u64) -> bool {
  let mut i = wrap_add(p, 1);
  let mut ok = true;
  while ok && i < q {
    let t = iropt_at(f, i);
    if t.op == IR_LABEL {
      if t.a >= f.nlabel || u_at(lb.lo, t.a) < p || u_at(lb.hi, t.a) > q {
        ok = false;
      }
    } else if t.op == IR_JMP {
      if t.a >= f.nlabel || u_at(lb.pos, t.a) == IR_NONE || u_at(lb.pos, t.a) <= i {
        ok = false;
      }
    } else if t.op == IR_BR {
      if t.b >= f.nlabel || t.c >= f.nlabel || u_at(lb.pos, t.b) == IR_NONE || u_at(lb.pos, t.c) == IR_NONE || u_at(lb.pos, t.b) <= i || u_at(lb.pos, t.c) <= i {
        ok = false;
      }
    } else if t.op == IR_UNREACH {
      ok = false;
    }
    i = wrap_add(i, 1);
  }
  return ok;
}

/// What a register holds in a loop: kind 0, the same in every pass; kind 1,
/// `scale * k + (the same in every pass)` for the loop's counter k; kind 2,
/// anything else.
struct IrKind { kind: u64, scale: u64 }

fn iropt_kind_at(kind: &Vec[u64], scale: &Vec[u64], r: u64) -> IrKind {
  return IrKind { kind: u_at(kind, r), scale: u_at(scale, r) };
}

/// The kind of the result of `q` from the kinds of its operands (`ca` and
/// `cb`: the constant an operand is, or IR_NONE).
fn iropt_ivs_classify(q: IrIns, ka: IrKind, kb: IrKind, ca: u64, cb: u64) -> IrKind {
  let other = IrKind { kind: 2, scale: 0 };
  if q.op == IR_CONST {
    return IrKind { kind: 0, scale: 0 };
  }
  if q.op == IR_MOV {
    return ka;
  }
  if q.c != 0 {
    return other;
  }
  if q.op == IR_ADD {
    if ka.kind == 0 && kb.kind == 0 {
      return IrKind { kind: 0, scale: 0 };
    }
    if ka.kind == 1 && kb.kind == 0 {
      return ka;
    }
    if ka.kind == 0 && kb.kind == 1 {
      return kb;
    }
  }
  if q.op == IR_SUB {
    if ka.kind == 0 && kb.kind == 0 {
      return IrKind { kind: 0, scale: 0 };
    }
    if ka.kind == 1 && kb.kind == 0 {
      return ka;
    }
  }
  if q.op == IR_MUL {
    if ka.kind == 0 && kb.kind == 0 {
      return IrKind { kind: 0, scale: 0 };
    }
    if ka.kind == 1 && kb.kind == 0 && cb != IR_NONE && cb < 1048576 && ka.scale < 1048576 && cb > 0 {
      return IrKind { kind: 1, scale: wrap_mul(ka.scale, cb) };
    }
    if ka.kind == 0 && kb.kind == 1 && ca != IR_NONE && ca < 1048576 && kb.scale < 1048576 && ca > 0 {
      return IrKind { kind: 1, scale: wrap_mul(kb.scale, ca) };
    }
  }
  return other;
}

/// The single register `q` writes, or IR_NONE.
fn iropt_ivs_dest(q: IrIns) -> u64 {
  let mut ws = vec_new[u64]();
  ra_writes(q, &mut ws);
  let mut d = IR_NONE;
  if vec_len(ws) == 1 {
    d = vec_get(ws, 0);
  }
  vec_free(ws);
  return d;
}

/// Strength reduction of a loop counter's multiples. In a loop
/// `L: ..; t = k + c; k = t; jmp L` (the one way back, `k` written outside
/// the loop and by that move only, the move last), a register `r = k * M + x`
/// (or `x + k * M`, `k * M - x`, ..: `x` the same in every pass) that is
/// written once and read only after that and before `t = k + c` becomes a
/// register `R` of its own: set before the loop by a copy of the
/// instructions that compute `r` for the first pass, and stepped by `M * c`
/// just before `t = k + c`. A pass then adds where it multiplied
/// (`a[i * 400 + k]`). The loop's entry from outside goes through the new
/// label. Only a register whose computation has at least two instructions
/// that become dead is reduced, so the step is paid for. Does one register
/// of one loop; returns whether it changed anything.
fn iropt_ivs_try(f: &mut IrFn, lb: &IrLabs, l: u64, ndef: &Vec[u64], nuse: &Vec[u64], cv: &Vec[u64], fu: &Vec[u64], lu: &Vec[u64], dp: &Vec[u64], dl: &Vec[u64]) -> bool {
  let n = vec_len(f.ins);
  let nr = f.nreg;
  let p = u_at(lb.pos, l);
  let q = u_at(lb.hi, l);
  if p == IR_NONE || q >= n || q < wrap_add(p, 4) {
    return false;
  }
  let jq = iropt_at(f, q);
  if jq.op != IR_JMP || jq.a != l {
    return false;
  }
  let u = wrap_sub(q, 1);
  let mv = iropt_at(f, u);
  if mv.op != IR_MOV || mv.d >= nr || mv.a >= nr {
    return false;
  }
  let k = mv.d;
  let t = mv.a;
  if u_at(ndef, k) != 2 || u_at(ndef, t) != 1 || u_at(nuse, t) != 1 {
    return false;
  }
  let w = u_at(dp, t);
  if w == IR_NONE || w <= p || w >= u {
    return false;
  }
  let ad = iropt_at(f, w);
  if ad.op != IR_ADD || ad.c != 0 || ad.d != t {
    return false;
  }
  let mut vc = IR_NONE;
  if ad.a == k {
    vc = ad.b;
  } else if ad.b == k {
    vc = ad.a;
  }
  if vc >= nr || u_at(cv, vc) == IR_NONE {
    return false;
  }
  let step = u_at(cv, vc);
  if step == 0 || step > 1048576 {
    return false;
  }
  // k is written once outside the loop, before it, and by the move.
  let first = u_at(dp, k);
  let last = u_at(dl, k);
  // The constant k starts at, if its first value is one.
  let mut k0 = IR_NONE;
  if first == u && last == u {
    if !ra_is_param(f, k) {
      return false;
    }
  } else if first == u {
    if last >= p {
      return false;
    }
    let e = iropt_at(f, last);
    if e.op == IR_CONST && e.d == k {
      k0 = e.a;
    }
  } else if last == u {
    if first >= p {
      return false;
    }
    let e = iropt_at(f, first);
    if e.op == IR_CONST && e.d == k {
      k0 = e.a;
    }
  } else {
    return false;
  }
  if !iropt_ivs_span_ok(f, lb, p, q) {
    return false;
  }
  // Writes inside the loop, and what each register holds there.
  let mut indef = vec_new[u64]();
  let mut kind = vec_new[u64]();
  let mut scale = vec_new[u64]();
  let mut r = 0;
  while r < nr && r < 1000000000 {
    vec_push(&mut indef, 0);
    r = r + 1;
  }
  let mut i = p;
  while i < q {
    let mut ws = vec_new[u64]();
    ra_writes(iropt_at(f, i), &mut ws);
    let mut j = 0;
    while j < vec_len(ws) {
      let x = vec_get(ws, j);
      ra_set(&mut indef, x, wrap_add(u_at(indef, x), 1));
      j = j + 1;
    }
    vec_free(ws);
    i = wrap_add(i, 1);
  }
  r = 0;
  while r < nr && r < 1000000000 {
    if u_at(indef, r) == 0 {
      vec_push(&mut kind, 0);
    } else {
      vec_push(&mut kind, 2);
    }
    vec_push(&mut scale, 0);
    r = r + 1;
  }
  ra_set(&mut kind, k, 1);
  ra_set(&mut scale, k, 1);
  i = p;
  while i < u {
    let qi = iropt_at(f, i);
    let d = iropt_ivs_dest(qi);
    if d < nr && u_at(ndef, d) == 1 && u_at(indef, d) == 1 && d != t {
      let mut ca = IR_NONE;
      let mut cb = IR_NONE;
      let mut ka = IrKind { kind: 2, scale: 0 };
      let mut kb = IrKind { kind: 2, scale: 0 };
      if ra_is_binary(qi.op) || qi.op == IR_MOV {
        if qi.a < nr {
          ca = u_at(cv, qi.a);
          ka = iropt_kind_at(kind, scale, qi.a);
        }
        if qi.op != IR_MOV && qi.b < nr {
          cb = u_at(cv, qi.b);
          kb = iropt_kind_at(kind, scale, qi.b);
        }
      }
      if qi.op == IR_CONST || qi.op == IR_MOV || ra_is_binary(qi.op) {
        let kd = iropt_ivs_classify(qi, ka, kb, ca, cb);
        ra_set(&mut kind, d, kd.kind);
        ra_set(&mut scale, d, kd.scale);
      }
    }
    i = wrap_add(i, 1);
  }
  // A register to reduce: a counter multiple that something other than
  // another such register reads.
  let mut done = false;
  i = wrap_add(p, 1);
  while !done && i < w {
    let qi = iropt_at(f, i);
    let d = iropt_ivs_dest(qi);
    if d < nr && d != k && d != t && u_at(kind, d) == 1 && u_at(ndef, d) == 1 && u_at(indef, d) == 1 && u_at(scale, d) != 0 && qi.op != IR_MOV && u_at(nuse, d) > 0
      && u_at(fu, d) > i && u_at(lu, d) < w {
      if iropt_ivs_apply(&mut f, lb, l, p, q, w, i, k, k0, step, ad.ty, ndef, nuse, cv, dp, indef, kind, scale) {
        done = true;
      }
    }
    i = wrap_add(i, 1);
  }
  vec_free(indef);
  vec_free(kind);
  vec_free(scale);
  return done;
}

/// Reduces register `d`, written at `di` in the loop p .. q whose counter
/// `k` (which starts at the constant `k0`, unless that is IR_NONE) is stepped
/// by the addition at `u`, which every read of `d` comes before and the new
/// register is stepped ahead of, if its computation is worth it (see
/// `iropt_ivs_try`).
fn iropt_ivs_apply(f: &mut IrFn, lb: &IrLabs, l: u64, p: u64, q: u64, u: u64, di: u64, k: u64, k0: u64, step: u64, ty: u64, ndef: &Vec[u64], nuse: &Vec[u64], cv: &Vec[u64], dp: &Vec[u64], indef: &Vec[u64], kind: &Vec[u64], scale: &Vec[u64]) -> bool {
  let n = vec_len(f.ins);
  let nr = f.nreg;
  let qd = iropt_at(f, di);
  let d = qd.d;
  // Is every read of d one that computes another such register?
  let mut ext = 0;
  let mut i = wrap_add(di, 1);
  while i < u {
    let qi = iropt_at(f, i);
    if ra_reads_has(f, qi, d) {
      let e = iropt_ivs_dest(qi);
      let inner = e < nr && e != d && u_at(ndef, e) == 1 && u_at(indef, e) == 1 && u_at(kind, e) <= 1 && (qi.op == IR_ADD || qi.op == IR_SUB || qi.op == IR_MUL);
      if !inner {
        ext = wrap_add(ext, 1);
      }
    }
    i = wrap_add(i, 1);
  }
  if ext == 0 {
    return false;
  }
  // The instructions that compute d: positions, in order.
  let mut cone = vec_new[u64]();
  vec_push(&mut cone, di);
  let mut c = 0;
  let mut ok = true;
  while ok && c < vec_len(cone) {
    let qc = iropt_at(f, vec_get(cone, c));
    let mut rs = vec_new[u64]();
    ra_reads(f, qc, &mut rs);
    let mut j = 0;
    while j < vec_len(rs) {
      let x = vec_get(rs, j);
      if x != k && x < nr && u_at(indef, x) >= 1 {
        let px = u_at(dp, x);
        if u_at(ndef, x) != 1 || u_at(indef, x) != 1 || px == IR_NONE || px <= p || px >= u || u_at(kind, x) > 1 {
          ok = false;
        } else if !has_id(cone, px) {
          vec_push(&mut cone, px);
        }
      }
      j = j + 1;
    }
    vec_free(rs);
    if vec_len(cone) > 16 {
      ok = false;
    }
    c = wrap_add(c, 1);
  }
  if !ok {
    vec_free(cone);
    return false;
  }
  // Ascending.
  let mut a = 1;
  while a < vec_len(cone) {
    let mut b = a;
    while b > 0 && u_at(cone, wrap_sub(b, 1)) > u_at(cone, b) {
      let x = u_at(cone, b);
      ra_set(&mut cone, b, u_at(cone, wrap_sub(b, 1)));
      ra_set(&mut cone, wrap_sub(b, 1), x);
      b = wrap_sub(b, 1);
    }
    a = wrap_add(a, 1);
  }
  // How many of them become dead: the step costs one.
  let mut dead = 0;
  c = 0;
  while c < vec_len(cone) {
    let qc = iropt_at(f, vec_get(cone, c));
    if qc.op == IR_ADD || qc.op == IR_SUB || qc.op == IR_MUL {
      if qc.d == d {
        dead = wrap_add(dead, 1);
      } else {
        let mut inside = 0;
        let mut e = 0;
        while e < vec_len(cone) {
          if ra_reads_has(f, iropt_at(f, vec_get(cone, e)), qc.d) {
            inside = wrap_add(inside, 1);
          }
          e = wrap_add(e, 1);
        }
        if inside == u_at(nuse, qc.d) {
          dead = wrap_add(dead, 1);
        }
      }
    }
    c = wrap_add(c, 1);
  }
  let by = wrap_mul(u_at(scale, d), step);
  if dead < 2 || by == 0 || by > 1099511627776 {
    vec_free(cone);
    return false;
  }
  // The new code: a label for the way in, the first value, the step.
  let top = ir_label(&mut f);
  let rr = ir_reg(&mut f);
  let rs = ir_reg(&mut f);
  let mut out = vec_new[IrIns]();
  let mut mfrom = vec_new[u64]();
  let mut mto = vec_new[u64]();
  i = 0;
  while i < n {
    if i == p {
      vec_push(&mut out, IrIns { op: IR_LABEL, d: IR_NONE, a: top, b: 0, c: 0, ty: 0 });
      // k's first value, as a constant of its own where it is known.
      if k0 != IR_NONE {
        let kc = ir_reg(&mut f);
        vec_push(&mut out, IrIns { op: IR_CONST, d: kc, a: k0, b: 0, c: 0, ty: 0 });
        vec_push(&mut mfrom, k);
        vec_push(&mut mto, kc);
      }
      c = 0;
      while c < vec_len(cone) {
        let mut qc = iropt_at(f, vec_get(cone, c));
        let mut m = 0;
        while m < vec_len(mfrom) {
          qc = iropt_rename(qc, u_at(mfrom, m), u_at(mto, m));
          m = wrap_add(m, 1);
        }
        let mut nd = rr;
        if qc.d != d {
          nd = ir_reg(&mut f);
        }
        vec_push(&mut mfrom, qc.d);
        vec_push(&mut mto, nd);
        qc.d = nd;
        vec_push(&mut out, qc);
        c = wrap_add(c, 1);
      }
      vec_push(&mut out, IrIns { op: IR_CONST, d: rs, a: by, b: 0, c: 0, ty: 0 });
    }
    let mut qi = iropt_at(f, i);
    if i < p || i > q {
      if qi.op == IR_JMP && qi.a == l {
        qi.a = top;
      }
      if qi.op == IR_BR {
        if qi.b == l {
          qi.b = top;
        }
        if qi.c == l {
          qi.c = top;
        }
      }
    } else if i == u {
      vec_push(&mut out, IrIns { op: IR_ADD, d: rr, a: rr, b: rs, c: 0, ty: ty });
    } else if i > di && i < u {
      qi = iropt_rename(qi, d, rr);
      if ra_reads_has(f, qi, d) {
        ok = false;
      }
    }
    vec_push(&mut out, qi);
    i = wrap_add(i, 1);
  }
  vec_free(cone);
  vec_free(mfrom);
  vec_free(mto);
  if !ok {
    vec_free(out);
    return false;
  }
  vec_free(f.ins);
  f.ins = out;
  return true;
}

/// `iropt_ivs_try` on every loop until nothing changes. Returns how many
/// registers it reduced.
fn iropt_ivs(f: &mut IrFn) -> u64 {
  let mut total = 0;
  let mut again = true;
  while again && total < 200 {
    again = false;
    let n = vec_len(f.ins);
    if n > 4000000 || f.nreg > 100000000 || f.nlabel > 100000000 {
      return total;
    }
    let ndef = iropt_ndef(f);
    let nuse = iropt_nuse(f);
    let cv = iropt_consts(f, ndef);
    let lb = iropt_labs(f);
    let mut fu = vec_new[u64]();
    let mut lu = vec_new[u64]();
    let mut dp = vec_new[u64]();
    let mut dl = vec_new[u64]();
    let mut r = 0;
    while r < f.nreg {
      vec_push(&mut fu, IR_NONE);
      vec_push(&mut lu, 0);
      vec_push(&mut dp, IR_NONE);
      vec_push(&mut dl, IR_NONE);
      r = wrap_add(r, 1);
    }
    let mut i = 0;
    while i < n {
      let qi = iropt_at(f, i);
      let mut rs = vec_new[u64]();
      ra_reads(f, qi, &mut rs);
      ra_writes(qi, &mut rs);
      let mut nrd = vec_len(rs);
      let mut reads = vec_new[u64]();
      ra_reads(f, qi, &mut reads);
      nrd = vec_len(reads);
      let mut j = 0;
      while j < vec_len(rs) {
        let x = vec_get(rs, j);
        if j < nrd {
          if i < u_at(fu, x) {
            ra_set(&mut fu, x, i);
          }
          if i > u_at(lu, x) {
            ra_set(&mut lu, x, i);
          }
        } else {
          if u_at(dp, x) == IR_NONE {
            ra_set(&mut dp, x, i);
          }
          ra_set(&mut dl, x, i);
        }
        j = j + 1;
      }
      vec_free(rs);
      vec_free(reads);
      i = wrap_add(i, 1);
    }
    let mut l = 0;
    while !again && l < f.nlabel {
      if u_at(lb.back, l) == 1 && iropt_ivs_try(&mut f, lb, l, ndef, nuse, cv, fu, lu, dp, dl) {
        again = true;
        total = wrap_add(total, 1);
      }
      l = wrap_add(l, 1);
    }
    vec_free(ndef);
    vec_free(nuse);
    vec_free(cv);
    iropt_labs_free(lb);
    vec_free(fu);
    vec_free(lu);
    vec_free(dp);
    vec_free(dl);
  }
  return total;
}

/// Is the stretch p .. q of a loop (header label at p, the last jump back at
/// q) one that no jump enters except at its header?
fn iropt_wide_entry_ok(f: &IrFn, lb: &IrLabs, p: u64, q: u64) -> bool {
  let mut i = wrap_add(p, 1);
  let mut ok = true;
  while ok && i <= q && i < vec_len(f.ins) {
    let t = iropt_at(f, i);
    if t.op == IR_LABEL {
      if t.a >= f.nlabel || u_at(lb.lo, t.a) < p || u_at(lb.hi, t.a) > q {
        ok = false;
      }
    }
    i = wrap_add(i, 1);
  }
  return ok;
}

/// A constant too wide for an immediate (it needs a 64-bit move) that a loop
/// computes in every pass is moved in front of the outermost loop around it
/// that has a single way in, where the allocator can keep it in a register.
/// A power of two stays: the emitter turns an operation with it into a shift
/// or a mask.
/// Returns how many it moved.
fn iropt_wide(f: &mut IrFn) -> u64 {
  let mut total = 0;
  let mut again = true;
  while again && total < 200 {
    again = false;
    let n = vec_len(f.ins);
    if n > 4000000 || f.nreg > 100000000 || f.nlabel > 100000000 {
      return total;
    }
    let ndef = iropt_ndef(f);
    let lb = iropt_labs(f);
    let mut i = 0;
    while !again && i < n {
      let qi = iropt_at(f, i);
      if qi.op == IR_CONST && qi.d < f.nreg && u_at(ndef, qi.d) == 1 && qi.a >= 2147483648 && qi.a < 18446744071562067968 && (qi.a & wrap_sub(qi.a, 1)) != 0 {
        let mut best = IR_NONE;
        let mut l = 0;
        while l < f.nlabel {
          let p = u_at(lb.pos, l);
          if u_at(lb.back, l) >= 1 && p != IR_NONE && p < i && u_at(lb.hi, l) >= i && (best == IR_NONE || p < u_at(lb.pos, best)) {
            if iropt_wide_entry_ok(f, lb, p, u_at(lb.hi, l)) {
              best = l;
            }
          }
          l = wrap_add(l, 1);
        }
        if best != IR_NONE {
          let p = u_at(lb.pos, best);
          let q = u_at(lb.hi, best);
          let top = ir_label(&mut f);
          let mut out = vec_new[IrIns]();
          let mut j = 0;
          while j < n {
            if j == p {
              vec_push(&mut out, IrIns { op: IR_LABEL, d: IR_NONE, a: top, b: 0, c: 0, ty: 0 });
              vec_push(&mut out, qi);
            }
            if j != i {
              let mut t = iropt_at(f, j);
              if j < p || j > q {
                if t.op == IR_JMP && t.a == best {
                  t.a = top;
                }
                if t.op == IR_BR {
                  if t.b == best {
                    t.b = top;
                  }
                  if t.c == best {
                    t.c = top;
                  }
                }
              }
              vec_push(&mut out, t);
            }
            j = wrap_add(j, 1);
          }
          vec_free(f.ins);
          f.ins = out;
          again = true;
          total = wrap_add(total, 1);
        }
      }
      i = wrap_add(i, 1);
    }
    vec_free(ndef);
    iropt_labs_free(lb);
  }
  return total;
}

fn iropt_put(f: &mut IrFn, i: u64, q: IrIns) {
  if i < vec_len(f.ins) {
    vec_set(&mut f.ins, i, q);
  }
}

/// Do registers `x` and `y` hold the same value: the same register (after
/// `al` maps a register that is a copy of another written once to it), or two
/// registers that are each written once by a `const` of one value?
fn iropt_ebb_same(cv: &Vec[u64], al: &Vec[u64], x0: u64, y0: u64) -> bool {
  let mut x = x0;
  let mut y = y0;
  if x < vec_len(al) && u_at(al, x) != IR_NONE {
    x = u_at(al, x);
  }
  if y < vec_len(al) && u_at(al, y) != IR_NONE {
    y = u_at(al, y);
  }
  if x == y {
    return true;
  }
  if x >= vec_len(cv) || y >= vec_len(cv) {
    return false;
  }
  return u_at(cv, x) != IR_NONE && u_at(cv, x) == u_at(cv, y);
}

/// Is `op` an instruction that cannot change memory, so that a load made
/// before it still holds after it?
fn iropt_ebb_keeps_loads(op: u64) -> bool {
  return op == IR_CONST || op == IR_MOV || ra_is_binary(op) || op == IR_NOT || op == IR_NEG || op == IR_WRAP || op == IR_LOAD || op == IR_LABEL || op == IR_BR || op == IR_SLOT || op == IR_STRLIT;
}

/// Value numbering along extended basic blocks: a block that only the one
/// before it can reach (a label whose every jump is the branch just above)
/// continues what that one knew. An operation or a load whose operands are
/// the same registers, with none of them written since, and (for a load) no
/// store or call between, becomes a copy of the first result. Unlike
/// `iropt_cse`, the registers may be written more than once, which is what a
/// loop's counter is: `a[j - 1]` read in the test and again in the body.
/// Returns how many it turned into copies.
fn iropt_ebb(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  if n > 4000000 || f.nlabel > 100000000 {
    return 0;
  }
  let ndef = iropt_ndef(f);
  let cv = iropt_consts(f, ndef);
  let mut al = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut al, IR_NONE);
    r = wrap_add(r, 1);
  }
  let mut cnt = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel {
    vec_push(&mut cnt, 0);
    l = wrap_add(l, 1);
  }
  let mut i = 0;
  while i < n {
    let q = iropt_at(f, i);
    if q.op == IR_JMP && q.a < f.nlabel {
      ra_set(&mut cnt, q.a, wrap_add(u_at(cnt, q.a), 1));
    }
    if q.op == IR_BR {
      if q.b < f.nlabel {
        ra_set(&mut cnt, q.b, wrap_add(u_at(cnt, q.b), 1));
      }
      if q.c < f.nlabel {
        ra_set(&mut cnt, q.c, wrap_add(u_at(cnt, q.c), 1));
      }
    }
    i = wrap_add(i, 1);
  }
  // The table: operation, operands, result; op 0 is a free slot.
  let mut te_op = vec_new[u64]();
  let mut te_a = vec_new[u64]();
  let mut te_b = vec_new[u64]();
  let mut te_c = vec_new[u64]();
  let mut te_ty = vec_new[u64]();
  let mut te_d = vec_new[u64]();
  let mut te_nf = vec_new[u64]();
  let nuse = iropt_nuse(f);
  let mut done = 0;
  let mut prev = IrIns { op: IR_JMP, d: IR_NONE, a: IR_NONE, b: 0, c: 0, ty: 0 };
  i = 0;
  while i < n {
    let mut q = iropt_at(f, i);
    let mut clear = false;
    if q.op == IR_LABEL {
      let mut own = 0;
      if prev.op == IR_BR {
        if prev.b == q.a {
          own = wrap_add(own, 1);
        }
        if prev.c == q.a {
          own = wrap_add(own, 1);
        }
      }
      if prev.op == IR_JMP || prev.op == IR_RET || prev.op == IR_UNREACH || q.a >= f.nlabel || u_at(cnt, q.a) != own {
        clear = true;
      }
    } else if prev.op == IR_JMP || prev.op == IR_BR || prev.op == IR_RET || prev.op == IR_UNREACH {
      clear = true;
    }
    let mut t = 0;
    while t < vec_len(te_op) {
      if clear || (u_at(te_op, t) == IR_LOAD && !iropt_ebb_keeps_loads(q.op)) {
        ra_set(&mut te_op, t, 0);
      }
      t = wrap_add(t, 1);
    }
    let pure = ra_is_binary(q.op) || q.op == IR_NOT || q.op == IR_NEG || q.op == IR_WRAP;
    if pure || q.op == IR_LOAD {
      // Is it there already?
      let mut hit = IR_NONE;
      t = 0;
      while hit == IR_NONE && t < vec_len(te_op) {
        if u_at(te_op, t) == q.op && iropt_ebb_same(cv, al, u_at(te_a, t), q.a) && iropt_ebb_same(cv, al, u_at(te_b, t), q.b) && u_at(te_c, t) == q.c && u_at(te_ty, t) == q.ty {
          if u_at(te_nf, t) == 0 {
            hit = u_at(te_d, t);
          }
        }
        t = wrap_add(t, 1);
      }
      if hit != IR_NONE && hit != q.d {
        let orig = q;
        q = IrIns { op: IR_MOV, d: orig.d, a: hit, b: 0, c: 0, ty: 0 };
        iropt_put(&mut f, i, q);
        done = wrap_add(done, 1);
        if orig.d < vec_len(al) && hit < vec_len(al) && u_at(ndef, orig.d) == 1 && u_at(ndef, hit) == 1 {
          ra_set(&mut al, orig.d, hit);
        }
        // The old entry for the new result is gone by the write below.
        let mut rs = vec_new[u64]();
        ra_writes(q, &mut rs);
        let mut w = 0;
        while w < vec_len(rs) {
          let x = vec_get(rs, w);
          t = 0;
          while t < vec_len(te_op) {
            if u_at(te_op, t) != 0 && (u_at(te_a, t) == x || u_at(te_b, t) == x || u_at(te_d, t) == x) {
              ra_set(&mut te_op, t, 0);
            }
            t = wrap_add(t, 1);
          }
          w = wrap_add(w, 1);
        }
        vec_free(rs);
      } else {
        let mut rs = vec_new[u64]();
        ra_writes(q, &mut rs);
        let mut w = 0;
        while w < vec_len(rs) {
          let x = vec_get(rs, w);
          t = 0;
          while t < vec_len(te_op) {
            if u_at(te_op, t) != 0 && (u_at(te_a, t) == x || u_at(te_b, t) == x || u_at(te_d, t) == x) {
              ra_set(&mut te_op, t, 0);
            }
            t = wrap_add(t, 1);
          }
          w = wrap_add(w, 1);
        }
        vec_free(rs);
        if q.d != q.a && q.d != q.b && q.d != IR_NONE {
          let mut slot = IR_NONE;
          t = 0;
          while slot == IR_NONE && t < vec_len(te_op) {
            if u_at(te_op, t) == 0 {
              slot = t;
            }
            t = wrap_add(t, 1);
          }
          if slot == IR_NONE && vec_len(te_op) < 64 {
            vec_push(&mut te_op, 0);
            vec_push(&mut te_a, 0);
            vec_push(&mut te_b, 0);
            vec_push(&mut te_c, 0);
            vec_push(&mut te_ty, 0);
            vec_push(&mut te_d, 0);
            vec_push(&mut te_nf, 0);
            slot = wrap_sub(vec_len(te_op), 1);
          }
          if slot != IR_NONE {
            ra_set(&mut te_op, slot, q.op);
            ra_set(&mut te_a, slot, q.a);
            ra_set(&mut te_b, slot, q.b);
            ra_set(&mut te_c, slot, q.c);
            ra_set(&mut te_ty, slot, q.ty);
            ra_set(&mut te_d, slot, q.d);
            // A load that only a compare with a constant reads becomes `cmp $k, mem`: keep it.
            let mut nf = 0;
            if q.op == IR_LOAD && q.d < vec_len(nuse) && u_at(nuse, q.d) == 1 {
              let mut k = wrap_add(i, 1);
              let mut seen = false;
              while !seen && k < n && k < wrap_add(i, 4) {
                let nx = iropt_at(f, k);
                if nx.op == IR_CONST {
                  k = wrap_add(k, 1);
                } else {
                  seen = true;
                  if (nx.op == IR_EQ || nx.op == IR_NE) && ((nx.a == q.d && nx.b < vec_len(cv) && u_at(cv, nx.b) != IR_NONE) || (nx.b == q.d && nx.a < vec_len(cv) && u_at(cv, nx.a) != IR_NONE)) {
                    nf = 1;
                  }
                }
              }
            }
            ra_set(&mut te_nf, slot, nf);
          }
        }
      }
    } else {
      let mut rs = vec_new[u64]();
      ra_writes(q, &mut rs);
      let mut w = 0;
      while w < vec_len(rs) {
        let x = vec_get(rs, w);
        t = 0;
        while t < vec_len(te_op) {
          if u_at(te_op, t) != 0 && (u_at(te_a, t) == x || u_at(te_b, t) == x || u_at(te_d, t) == x) {
            ra_set(&mut te_op, t, 0);
          }
          t = wrap_add(t, 1);
        }
        w = wrap_add(w, 1);
      }
      vec_free(rs);
    }
    prev = q;
    i = wrap_add(i, 1);
  }
  vec_free(ndef);
  vec_free(cv);
  vec_free(al);
  vec_free(cnt);
  vec_free(te_op);
  vec_free(te_a);
  vec_free(te_b);
  vec_free(te_c);
  vec_free(te_ty);
  vec_free(te_d);
  vec_free(te_nf);
  vec_free(nuse);
  return done;
}

/// `x % 2 == 1` is `x % 2 != 0` the same way.
/// `(x & m) == m` for a one-bit mask m is `(x & m) != 0` (and `!=` the other
/// way): the comparison with zero can use the flags the `and` has already
/// set. Rewrites a comparison with the mask of an `and` right before it
/// (constants may stand between), when nothing else reads the `and`'s result.
/// Returns how many it rewrote.
fn iropt_bits(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  if n > 4000000 || f.nreg > 100000000 {
    return 0;
  }
  let ndef = iropt_ndef(f);
  let nuse = iropt_nuse(f);
  let cv = iropt_consts(f, ndef);
  let mut out = vec_new[IrIns]();
  let mut done = 0;
  let mut i = 0;
  while i < n {
    let mut q = iropt_at(f, i);
    if q.op == IR_EQ || q.op == IR_NE {
      let mut t = IR_NONE;
      let mut k = IR_NONE;
      if q.a < vec_len(cv) && q.b < vec_len(cv) {
        if u_at(cv, q.b) != IR_NONE && u_at(cv, q.a) == IR_NONE {
          t = q.a;
          k = q.b;
        } else if u_at(cv, q.a) != IR_NONE && u_at(cv, q.b) == IR_NONE {
          t = q.b;
          k = q.a;
        }
      }
      if t != IR_NONE && u_at(ndef, t) == 1 && u_at(nuse, t) == 1 {
        let m = u_at(cv, k);
        if m != 0 && (m & wrap_sub(m, 1)) == 0 {
          // The `and` among the last few instructions.
          let mut found = false;
          let mut back = 1;
          while !found && back <= 4 && back <= vec_len(out) {
            let mut pq = IrIns { op: 0, d: IR_NONE, a: IR_NONE, b: IR_NONE, c: 0, ty: 0 };
            let pos = wrap_sub(vec_len(out), back);
            if pos < vec_len(out) {
              pq = vec_get(out, pos);
            }
            if (pq.op == IR_AND || pq.op == IR_REM) && pq.d == t {
              if pq.op == IR_AND && ((pq.a < vec_len(cv) && u_at(cv, pq.a) == m) || (pq.b < vec_len(cv) && u_at(cv, pq.b) == m)) {
                found = true;
              }
              // x % 2 is 0 or 1.
              if pq.op == IR_REM && m == 1 && pq.b < vec_len(cv) && u_at(cv, pq.b) == 2 {
                found = true;
              }
              back = 5;
            } else if pq.op != IR_CONST {
              back = 5;
            }
            back = wrap_add(back, 1);
          }
          if found {
            let z = ir_reg(&mut f);
            vec_push(&mut out, IrIns { op: IR_CONST, d: z, a: 0, b: 0, c: 0, ty: 0 });
            let mut nop = IR_NE;
            if q.op == IR_NE {
              nop = IR_EQ;
            }
            q = IrIns { op: nop, d: q.d, a: t, b: z, c: q.c, ty: q.ty };
            done = wrap_add(done, 1);
          }
        }
      }
    }
    vec_push(&mut out, q);
    i = wrap_add(i, 1);
  }
  vec_free(ndef);
  vec_free(nuse);
  vec_free(cv);
  if done == 0 {
    vec_free(out);
    return 0;
  }
  vec_free(f.ins);
  f.ins = out;
  return done;
}

/// Can `iropt_ifconv` run `q` whether or not its arm is taken? It only
/// computes a register and cannot trap: no load, no store, no call, and a
/// division only by a nonzero constant.
fn iropt_spec_ok(q: IrIns, cv: &Vec[u64]) -> bool {
  let op = q.op;
  if q.d == IR_NONE {
    return false;
  }
  if op == IR_CONST || op == IR_MOV || op == IR_NOT || op == IR_NEG || op == IR_WRAP {
    return true;
  }
  if op == IR_DIV || op == IR_REM {
    return u_at(cv, q.b) != IR_NONE && u_at(cv, q.b) != 0;
  }
  return ra_is_binary(op) && op != IR_SDIV && op != IR_SREM;
}

/// The position of the `jmp` or label that closes the arm of an `if` that
/// starts at `s`, or IR_NONE if the arm is longer than eight instructions
/// or holds one `iropt_spec_ok` does not accept.
fn iropt_arm_end(f: &IrFn, s: u64, cv: &Vec[u64]) -> u64 {
  let mut k = s;
  while k < vec_len(f.ins) && k < wrap_add(s, 9) {
    let q = iropt_at(f, k);
    if q.op == IR_JMP || q.op == IR_LABEL {
      return k;
    }
    if !iropt_spec_ok(q, cv) {
      return IR_NONE;
    }
    k = wrap_add(k, 1);
  }
  return IR_NONE;
}

/// How often `x` is in `v`.
fn iropt_count(v: &Vec[u64], x: u64) -> u64 {
  let mut n = 0;
  let mut k = 0;
  while k < vec_len(v) {
    if vec_get(v, k) == x {
      n = wrap_add(n, 1);
    }
    k = wrap_add(k, 1);
  }
  return n;
}

/// The register that holds `r` in an arm: the fresh register it was last
/// written to there, or `r`.
fn iropt_arm_reg(mo: &Vec[u64], mn: &Vec[u64], r: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(mo) && k < vec_len(mn) {
    if vec_get(mo, k) == r {
      return vec_get(mn, k);
    }
    k = wrap_add(k, 1);
  }
  return r;
}

/// Appends the instructions `s` to `e` of an arm to `out`. A register in
/// `shared` (written in an arm and read elsewhere, or written more than
/// once) is written to a fresh register instead, which `mo`/`mn` record, and
/// the later reads of the arm follow it; the other registers keep their
/// names, since nothing outside the arm reads them.
fn iropt_conv_arm(f: &mut IrFn, out: &mut Vec[IrIns], s: u64, e: u64, shared: &Vec[u64], mo: &mut Vec[u64], mn: &mut Vec[u64]) {
  let mut k = s;
  while k < e {
    let mut q = iropt_at(f, k);
    let mut j = 0;
    while j < vec_len(mo) && j < vec_len(mn) {
      q = ra_subst(q, vec_get(mo, j), vec_get(mn, j));
      j = wrap_add(j, 1);
    }
    if iropt_count(shared, q.d) > 0 {
      let t = ir_reg(&mut f);
      let mut found = false;
      j = 0;
      while j < vec_len(mo) && j < vec_len(mn) {
        if vec_get(mo, j) == q.d {
          vec_set(&mut mn, j, t);
          found = true;
        }
        j = wrap_add(j, 1);
      }
      if !found {
        vec_push(&mut mo, q.d);
        vec_push(&mut mn, t);
      }
      q.d = t;
    }
    vec_push(&mut out, q);
    k = wrap_add(k, 1);
  }
}

/// The instruction within eight before position `i`, in the same straight-line
/// run, that writes `r` (IR_NONE if there is none).
fn iropt_def_before(f: &IrFn, i: u64, r: u64) -> u64 {
  let mut k = i;
  let mut steps = 0;
  while k > 0 && steps < 8 {
    k = k - 1;
    let q = iropt_at(f, k);
    if q.op == IR_LABEL || q.op == IR_JMP || q.op == IR_BR {
      return IR_NONE;
    }
    if ra_writes_has(q, r) {
      return k;
    }
    steps = wrap_add(steps, 1);
  }
  return IR_NONE;
}

/// The register that holds the condition of the branch at `i` as 0 or 1: for
/// `x % 2 == 1`, `x % 2 != 0` and the same with `x & 1`, the register
/// `x % 2` / `x & 1` itself, whose negation is then the mask without a
/// compare; the condition register otherwise.
fn iropt_flag(f: &IrFn, i: u64, c: u64, cv: &Vec[u64], ndef: &Vec[u64]) -> u64 {
  let dc = iropt_def_before(f, i, c);
  if dc == IR_NONE {
    return c;
  }
  let qc = iropt_at(f, dc);
  let mut t = IR_NONE;
  if qc.op == IR_NE && iropt_cval(cv, qc.b) == 0 {
    t = qc.a;
  } else if qc.op == IR_EQ && iropt_cval(cv, qc.b) == 1 {
    t = qc.a;
  }
  if t == IR_NONE || u_at(ndef, t) != 1 {
    return c;
  }
  let dt = iropt_def_before(f, dc, t);
  if dt == IR_NONE {
    return c;
  }
  let qt = iropt_at(f, dt);
  if qt.op == IR_REM && iropt_cval(cv, qt.b) == 2 {
    return t;
  }
  if qt.op == IR_AND && (iropt_cval(cv, qt.b) == 1 || iropt_cval(cv, qt.a) == 1) {
    return t;
  }
  return c;
}

/// How many instructions of positions `s` to `e` write register `r`.
fn iropt_count_defs(f: &IrFn, s: u64, e: u64, r: u64) -> u64 {
  let mut n = 0;
  let mut k = s;
  while k < e {
    if ra_writes_has(iropt_at(f, k), r) {
      n = wrap_add(n, 1);
    }
    k = wrap_add(k, 1);
  }
  return n;
}

/// Appends `n` fresh registers to `v` (copy `m` of an unrolled body; none for copy 0).
fn w_fresh(v: &mut Vec[u64], f: &mut IrFn, n: u64, m: u64) {
  if m > 0 {
    let mut k = 0;
    while k < n {
      vec_push(&mut v, ir_reg(&mut f));
      k = wrap_add(k, 1);
    }
  }
}

/// Is register `x` one of the induction variables in `ivr`: its index there, or IR_NONE?
fn iropt_iv_index(ivr: &Vec[u64], x: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(ivr) {
    if vec_get(ivr, k) == x {
      return k;
    }
    k = wrap_add(k, 1);
  }
  return IR_NONE;
}

/// Partial unrolling of a counted loop with a straight-line body:
///
///   L3: [consts]; t = lt k, B; br t, L4, L5
///   L4: body                       (k and other induction variables x = x + c)
///       jmp L3
///
/// where k starts at a constant, steps by a constant and takes a number of
/// trips divisible by 2 or 4. The body is written out U times in a row, each
/// register it only uses privately renamed per copy, and each induction
/// variable stepped once per round by U times its step: a read of x in copy m
/// becomes `x + m * step` (a displacement the address folding then absorbs).
/// The loop test, the pointer increments and the jump are paid once for U
/// iterations. Each loop is considered once, in one pass over the function.
/// Returns how many loops it unrolled.
fn iropt_punroll(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  if n > 400000 || f.nreg > 10000000 {
    return 0;
  }
  let ndef = iropt_ndef(f);
  let nuse = iropt_nuse(f);
  let cv = iropt_consts(f, ndef);
  let mut refs = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut refs, 0);
    l = wrap_add(l, 1);
  }
  let mut i = 0;
  while i < n {
    let q = iropt_at(f, i);
    if q.op == IR_JMP && q.a < f.nlabel {
      ra_set(&mut refs, q.a, wrap_add(u_at(refs, q.a), 1));
    }
    if q.op == IR_BR {
      if q.b < f.nlabel {
        ra_set(&mut refs, q.b, wrap_add(u_at(refs, q.b), 1));
      }
      if q.c < f.nlabel {
        ra_set(&mut refs, q.c, wrap_add(u_at(refs, q.c), 1));
      }
    }
    i = wrap_add(i, 1);
  }
  let mut out = vec_new[IrIns]();
  let mut done = 0;
  let mut p = 0;
  while p < n {
    let ql = iropt_at(f, p);
    let mut next = wrap_add(p, 1);
    let mut hq = wrap_add(p, 1);
    if ql.op == IR_LABEL && u_at(refs, ql.a) == 1 {
      let mut scanning = true;
      while scanning && hq < n {
        let qc0 = iropt_at(f, hq);
        if qc0.op == IR_CONST {
          hq = wrap_add(hq, 1);
        } else {
          scanning = false;
        }
      }
      let q1 = iropt_at(f, hq);
      let q2 = iropt_at(f, wrap_add(hq, 1));
      let q3 = iropt_at(f, wrap_add(hq, 2));
      let bound = iropt_cval(cv, q1.b);
      if q1.op == IR_LT && q2.op == IR_BR && q2.a == q1.d && q3.op == IR_LABEL && q3.a == q2.b && u_at(refs, q3.a) == 1 && u_at(ndef, q1.d) == 1 && u_at(nuse, q1.d) == 1 && bound != IR_NONE {
        let bs = wrap_add(hq, 3);
        let mut e = bs;
        let mut going = true;
        while going && e < n && e < wrap_add(bs, 49) {
          let qe = iropt_at(f, e);
          if qe.op == IR_JMP {
            going = false;
          } else if !iropt_unroll_ok(qe) {
            e = n;
          } else {
            e = wrap_add(e, 1);
          }
        }
        let qj = iropt_at(f, e);
        if e < n && qj.op == IR_JMP && qj.a == ql.a && e > bs && wrap_add(e, 1) <= n {
          // The induction variables: x = add x, c, or t = add x, c ... x = mov t.
          let mut ivr = vec_new[u64]();
          let mut ivs = vec_new[u64]();
          let mut ivu = vec_new[u64]();
          let mut iva = vec_new[u64]();
          let mut j = bs;
          while j < e {
            let qj2 = iropt_at(f, j);
            if qj2.op == IR_ADD && qj2.d == qj2.a && qj2.c != 1 && iropt_cval(cv, qj2.b) != IR_NONE && iropt_count_defs(f, bs, e, qj2.d) == 1 {
              vec_push(&mut ivr, qj2.d);
              vec_push(&mut ivs, iropt_cval(cv, qj2.b));
              vec_push(&mut ivu, j);
              vec_push(&mut iva, IR_NONE);
            } else if qj2.op == IR_MOV && iropt_count_defs(f, bs, e, qj2.d) == 1 && u_at(ndef, qj2.a) == 1 && u_at(nuse, qj2.a) == 1 {
              let mut k2 = bs;
              while k2 < j {
                let qa = iropt_at(f, k2);
                if qa.op == IR_ADD && qa.d == qj2.a && qa.a == qj2.d && qa.c != 1 && iropt_cval(cv, qa.b) != IR_NONE {
                  vec_push(&mut ivr, qj2.d);
                  vec_push(&mut ivs, iropt_cval(cv, qa.b));
                  vec_push(&mut ivu, j);
                  vec_push(&mut iva, k2);
                }
                k2 = wrap_add(k2, 1);
              }
            }
            j = wrap_add(j, 1);
          }
          let kix = iropt_iv_index(ivr, q1.a);
          let mut c0 = IR_NONE;
          let mut step = 0;
          if kix != IR_NONE && u_at(ndef, q1.a) == 2 {
            step = u_at(ivs, kix);
            let mut k3 = 0;
            while k3 < n {
              let qd = iropt_at(f, k3);
              if qd.op == IR_CONST && qd.d == q1.a && (k3 < bs || k3 >= e) {
                c0 = qd.a;
              }
              k3 = wrap_add(k3, 1);
            }
          }
          let mut u = 0;
          if c0 != IR_NONE && step > 0 && step < 1000000 && c0 < bound && bound < 1000000000 && (bound - c0) % step == 0 {
            let trips = (bound - c0) / step;
            if trips >= 8 && trips % 4 == 0 {
              u = 4;
            } else if trips >= 4 && trips % 2 == 0 {
              u = 2;
            }
          }
          if u > 0 && wrap_mul(wrap_sub(e, bs), u) <= 160 {
            // Registers the body writes once and only reads after that, nowhere else.
            let mut inb = vec_new[u64]();
            let mut seen = vec_new[u64]();
            let mut bad = vec_new[u64]();
            let mut nin = vec_new[u64]();
            let mut r = 0;
            while r < f.nreg && r < 1000000000 {
              vec_push(&mut inb, 0);
              vec_push(&mut seen, 0);
              vec_push(&mut bad, 0);
              vec_push(&mut nin, 0);
              r = wrap_add(r, 1);
            }
            let mut k = bs;
            while k < e {
              let mut ws = vec_new[u64]();
              ra_writes(iropt_at(f, k), &mut ws);
              let mut w = 0;
              while w < vec_len(ws) {
                ra_set(&mut inb, vec_get(ws, w), 1);
                w = wrap_add(w, 1);
              }
              vec_free(ws);
              k = wrap_add(k, 1);
            }
            k = bs;
            while k < e {
              let qk = iropt_at(f, k);
              let mut rs = vec_new[u64]();
              ra_reads(f, qk, &mut rs);
              let mut w = 0;
              while w < vec_len(rs) {
                let x = vec_get(rs, w);
                ra_set(&mut nin, x, wrap_add(u_at(nin, x), 1));
                if u_at(inb, x) == 1 && u_at(seen, x) == 0 {
                  ra_set(&mut bad, x, 1);
                }
                w = wrap_add(w, 1);
              }
              vec_free(rs);
              let mut ws = vec_new[u64]();
              ra_writes(qk, &mut ws);
              w = 0;
              while w < vec_len(ws) {
                ra_set(&mut seen, vec_get(ws, w), 1);
                w = wrap_add(w, 1);
              }
              vec_free(ws);
              k = wrap_add(k, 1);
            }
            let mut priv = vec_new[u64]();
            r = 0;
            while r < f.nreg && r < 1000000000 {
              if u_at(inb, r) == 1 && u_at(bad, r) == 0 && u_at(ndef, r) == 1 && u_at(nuse, r) == u_at(nin, r) && iropt_iv_index(ivr, r) == IR_NONE {
                vec_push(&mut priv, r);
              }
              r = wrap_add(r, 1);
            }
            // The loop's header and its first label, as they are.
            k = p;
            while k < bs {
              vec_push(&mut out, iropt_at(f, k));
              k = wrap_add(k, 1);
            }
            let mut m = 0;
            while m < u {
              let mut mt = vec_new[u64]();
              w_fresh(&mut mt, &mut f, vec_len(priv), m);
              k = bs;
              while k < e {
                let mut skip = false;
                j = 0;
                while j < vec_len(ivr) {
                  if k == u_at(ivu, j) || k == u_at(iva, j) {
                    skip = true;
                  }
                  j = wrap_add(j, 1);
                }
                if !skip {
                  let mut qk = iropt_at(f, k);
                  j = 0;
                  while j < vec_len(ivr) {
                    let x = vec_get(ivr, j);
                    if ra_reads_has(f, qk, x) {
                      let mut rounds = m;
                      if k > u_at(ivu, j) {
                        rounds = wrap_add(m, 1);
                      }
                      if rounds > 0 {
                        let ck = ir_reg(&mut f);
                        let xt = ir_reg(&mut f);
                        vec_push(&mut out, IrIns { op: IR_CONST, d: ck, a: wrap_mul(rounds, u_at(ivs, j)), b: 0, c: 0, ty: 0 });
                        vec_push(&mut out, IrIns { op: IR_ADD, d: xt, a: x, b: ck, c: 0, ty: 0 });
                        qk = ra_subst(qk, x, xt);
                      }
                    }
                    j = wrap_add(j, 1);
                  }
                  if m > 0 {
                    j = 0;
                    while j < vec_len(priv) && j < vec_len(mt) {
                      qk = iropt_unroll_ren(qk, vec_get(priv, j), vec_get(mt, j));
                      j = wrap_add(j, 1);
                    }
                  }
                  vec_push(&mut out, qk);
                }
                k = wrap_add(k, 1);
              }
              vec_free(mt);
              m = wrap_add(m, 1);
            }
            j = 0;
            while j < vec_len(ivr) {
              let ck = ir_reg(&mut f);
              vec_push(&mut out, IrIns { op: IR_CONST, d: ck, a: wrap_mul(u, u_at(ivs, j)), b: 0, c: 0, ty: 0 });
              vec_push(&mut out, IrIns { op: IR_ADD, d: vec_get(ivr, j), a: vec_get(ivr, j), b: ck, c: 0, ty: 0 });
              j = wrap_add(j, 1);
            }
            vec_push(&mut out, qj);
            next = wrap_add(e, 1);
            done = wrap_add(done, 1);
            vec_free(inb);
            vec_free(seen);
            vec_free(bad);
            vec_free(nin);
            vec_free(priv);
          }
          vec_free(ivr);
          vec_free(ivs);
          vec_free(ivu);
          vec_free(iva);
        }
      }
    }
    if next == wrap_add(p, 1) {
      vec_push(&mut out, ql);
    }
    p = next;
  }
  vec_free(ndef);
  vec_free(nuse);
  vec_free(cv);
  vec_free(refs);
  if done == 0 {
    vec_free(out);
    return 0;
  }
  vec_free(f.ins);
  f.ins = out;
  return done;
}

/// Does the condition register `c` of the branch at `i` depend on a `load`
/// within the straight-line run before it (at most twelve instructions)? Such
/// a branch tests memory, and the predictor often runs ahead of the load; a
/// mask would make the code after it wait for that load.
fn iropt_cond_loads(f: &IrFn, i: u64, c: u64) -> bool {
  let mut cone = vec_new[u64]();
  vec_push(&mut cone, c);
  let mut hit = false;
  let mut k = i;
  let mut steps = 0;
  while k > 0 && steps < 12 && !hit {
    k = k - 1;
    let q = iropt_at(f, k);
    if q.op == IR_LABEL || q.op == IR_JMP || q.op == IR_BR {
      steps = 12;
    } else {
      let mut ws = vec_new[u64]();
      ra_writes(q, &mut ws);
      let mut w = 0;
      let mut in_cone = false;
      while w < vec_len(ws) {
        if iropt_count(cone, vec_get(ws, w)) > 0 {
          in_cone = true;
        }
        w = wrap_add(w, 1);
      }
      vec_free(ws);
      if in_cone {
        if q.op == IR_LOAD {
          hit = true;
        } else {
          ra_reads(f, q, &mut cone);
        }
      }
    }
    steps = wrap_add(steps, 1);
  }
  vec_free(cone);
  return hit;
}

/// Instruction `k` of `v` (an instruction of op 0 past the end).
fn iropt_ins_in(v: &Vec[IrIns], k: u64) -> IrIns {
  if k < vec_len(v) {
    return vec_get(v, k);
  }
  return IrIns { op: 0, d: IR_NONE, a: IR_NONE, b: IR_NONE, c: 0, ty: 0 };
}

/// Like `iropt_arm_end`, for a run that ends in a conditional branch: the
/// position of that `br`, or IR_NONE.
fn iropt_run_end(f: &IrFn, s: u64, cv: &Vec[u64]) -> u64 {
  let mut k = s;
  while k < vec_len(f.ins) && k < wrap_add(s, 9) {
    let q = iropt_at(f, k);
    if q.op == IR_BR {
      return k;
    }
    if q.op == IR_JMP || q.op == IR_LABEL || !iropt_spec_ok(q, cv) {
      return IR_NONE;
    }
    k = wrap_add(k, 1);
  }
  return IR_NONE;
}

/// Whether the code at label `l` is a short, non-empty pure arm (see
/// `iropt_arm_end`) that ends at label `other`, by falling into it or by a
/// `jmp`: the `if` without `else` that `iropt_ifconv` converts.
fn iropt_label_arm(f: &IrFn, l: u64, other: u64, cv: &Vec[u64]) -> bool {
  let mut k = 0;
  while k < vec_len(f.ins) {
    let q = iropt_at(f, k);
    if q.op == IR_LABEL && q.a == l {
      let e = iropt_arm_end(f, wrap_add(k, 1), cv);
      if e == IR_NONE || e <= wrap_add(k, 1) {
        return false;
      }
      let z = iropt_at(f, e);
      return z.a == other;
    }
    k = wrap_add(k, 1);
  }
  return false;
}

/// `a || b` and `a && b` of two comparisons as one branch. In
///
///     br c1, T, M          br c1, M, F
///   M: ops                M: ops
///     br c2, T, F          br c2, T, F
///
/// `c1` and `c2` hold 0 or 1 (comparisons), `M` is entered only by the first
/// branch and `ops` (at most six) only compute registers, so they may run
/// whether or not `c1` decides: the code becomes `ops; r = or c1, c2; br r, T, F`
/// (`and` for the second shape). One branch instead of two, and for a test
/// of data the second is as unpredictable as the first. Returns how many it
/// joined, and only where one side is a short pure arm, which `iropt_ifconv`
/// can then turn into a mask.
fn iropt_cmpfuse(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  if n > 4000000 || f.nreg > 100000000 {
    return 0;
  }
  let ndef = iropt_ndef(f);
  let cv = iropt_consts(f, ndef);
  let mut refs = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut refs, 0);
    l = wrap_add(l, 1);
  }
  let mut cmp = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut cmp, 0);
    r = wrap_add(r, 1);
  }
  let mut i = 0;
  while i < n {
    let q = iropt_at(f, i);
    if q.op == IR_JMP && q.a < f.nlabel {
      ra_set(&mut refs, q.a, wrap_add(u_at(refs, q.a), 1));
    }
    if q.op == IR_BR {
      if q.b < f.nlabel {
        ra_set(&mut refs, q.b, wrap_add(u_at(refs, q.b), 1));
      }
      if q.c < f.nlabel {
        ra_set(&mut refs, q.c, wrap_add(u_at(refs, q.c), 1));
      }
    }
    if q.d != IR_NONE && q.d < f.nreg && u_at(ndef, q.d) == 1 {
      if iropt_is_cmp(q.op) {
        ra_set(&mut cmp, q.d, 1);
      } else if (q.op == IR_OR || q.op == IR_AND) && u_at(cmp, q.a) == 1 && u_at(cmp, q.b) == 1 {
        ra_set(&mut cmp, q.d, 1);
      }
    }
    i = wrap_add(i, 1);
  }
  let mut out = vec_new[IrIns]();
  let mut done = 0;
  i = 0;
  while i < n {
    let q = iropt_at(f, i);
    let mut next = wrap_add(i, 1);
    let l0 = iropt_at(f, wrap_add(i, 1));
    if q.op == IR_BR && q.b != q.c && q.b < f.nlabel && q.c < f.nlabel && u_at(cmp, q.a) == 1 && l0.op == IR_LABEL {
      // Which target is M: the false one (||) or the true one (&&)?
      let mut is_or = false;
      if l0.a == q.c && u_at(refs, q.c) == 1 {
        is_or = true;
      }
      if is_or || (l0.a == q.b && u_at(refs, q.b) == 1) {
        let s1 = wrap_add(i, 2);
        let e1 = iropt_run_end(f, s1, cv);
        let b2 = iropt_at(f, e1);
        if e1 != IR_NONE && wrap_sub(e1, s1) <= 6 && b2.op == IR_BR && u_at(cmp, b2.a) == 1 {
          let mut ok = false;
          if is_or && b2.b == q.b && b2.c != q.c {
            ok = true;
          }
          if !is_or && b2.c == q.c && b2.b != q.b {
            ok = true;
          }
          // Only worth it when `iropt_ifconv` can then take the branch: one
          // side is a short pure arm. Elsewhere (an error check) both
          // branches predict well and two are cheaper than the extra ops.
          if ok && !(iropt_label_arm(f, b2.b, b2.c, cv) || iropt_label_arm(f, b2.c, b2.b, cv)) {
            ok = false;
          }
          if ok {
            let mut k = s1;
            while k < e1 {
              vec_push(&mut out, iropt_at(f, k));
              k = wrap_add(k, 1);
            }
            let t = ir_reg(&mut f);
            let mut op = IR_AND;
            if is_or {
              op = IR_OR;
            }
            vec_push(&mut out, IrIns { op: op, d: t, a: q.a, b: b2.a, c: 0, ty: 0 });
            vec_push(&mut out, IrIns { op: IR_BR, d: IR_NONE, a: t, b: b2.b, c: b2.c, ty: 0 });
            done = wrap_add(done, 1);
            next = wrap_add(e1, 1);
          }
        }
      }
    }
    if next == wrap_add(i, 1) {
      vec_push(&mut out, q);
    }
    i = next;
  }
  vec_free(ndef);
  vec_free(cv);
  vec_free(refs);
  vec_free(cmp);
  if done == 0 {
    vec_free(out);
    return 0;
  }
  vec_free(f.ins);
  f.ins = out;
  return done;
}

/// Branchless `if`: an `if` (or `if`/`else`) whose arms are a few
/// instructions that only compute registers, and whose condition is a
/// comparison, runs both arms and selects the results with a mask,
/// `r = e ^ ((t ^ e) & -c)`. A branch the program cannot predict (a test of
/// a data bit, the sign of a difference) costs more than the dozen
/// instructions that replace it; gcc and clang do the same with `cmov`.
/// Arms with a load, a store, a call or a division the proof does not cover
/// stay branches, as do arms that write more than three registers other
/// than their own temporaries. Returns how many it converted.
fn iropt_ifconv(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  if n > 4000000 || f.nreg > 100000000 {
    return 0;
  }
  let ndef = iropt_ndef(f);
  let nuse = iropt_nuse(f);
  let cv = iropt_consts(f, ndef);
  let mut refs = vec_new[u64]();
  let mut l = 0;
  while l < f.nlabel && l < 1000000000 {
    vec_push(&mut refs, 0);
    l = wrap_add(l, 1);
  }
  let mut cmp = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    vec_push(&mut cmp, 0);
    r = wrap_add(r, 1);
  }
  let mut i = 0;
  while i < n {
    let q = iropt_at(f, i);
    if q.op == IR_JMP && q.a < f.nlabel {
      ra_set(&mut refs, q.a, wrap_add(u_at(refs, q.a), 1));
    }
    if q.op == IR_BR {
      if q.b < f.nlabel {
        ra_set(&mut refs, q.b, wrap_add(u_at(refs, q.b), 1));
      }
      if q.c < f.nlabel {
        ra_set(&mut refs, q.c, wrap_add(u_at(refs, q.c), 1));
      }
    }
    // A register written once by a comparison (or `and`/`or` of two) holds 0 or 1.
    if q.d != IR_NONE && q.d < f.nreg && u_at(ndef, q.d) == 1 {
      if iropt_is_cmp(q.op) {
        ra_set(&mut cmp, q.d, 1);
      } else if (q.op == IR_OR || q.op == IR_AND) && u_at(cmp, q.a) == 1 && u_at(cmp, q.b) == 1 {
        ra_set(&mut cmp, q.d, 1);
      }
    }
    i = wrap_add(i, 1);
  }
  let mut out = vec_new[IrIns]();
  let mut done = 0;
  i = 0;
  while i < n {
    let q = iropt_at(f, i);
    let mut next = wrap_add(i, 1);
    let l0 = iropt_at(f, wrap_add(i, 1));
    if q.op == IR_BR && q.b != q.c && q.b < f.nlabel && q.c < f.nlabel && u_at(cmp, q.a) == 1 && l0.op == IR_LABEL && (l0.a == q.b || l0.a == q.c) && u_at(refs, l0.a) == 1 {
      let mut other = q.b;
      if l0.a == q.b {
        other = q.c;
      }
      let s1 = wrap_add(i, 2);
      let e1 = iropt_arm_end(f, s1, cv);
      let c1 = iropt_at(f, e1);
      // The arms: [s1, e1) behind label l0.a, [s2, e2) behind `other`
      // (empty when `other` is the join itself), and where the join label
      // `resume` is.
      let mut s2 = 0;
      let mut e2 = 0;
      let mut resume = IR_NONE;
      if e1 != IR_NONE {
        if c1.op == IR_LABEL && c1.a == other {
          resume = e1;
        } else if c1.op == IR_JMP {
          let m1 = iropt_at(f, wrap_add(e1, 1));
          if m1.op == IR_LABEL && m1.a == other && c1.a == other {
            resume = wrap_add(e1, 1);
          } else if m1.op == IR_LABEL && m1.a == other && u_at(refs, other) == 1 && c1.a != l0.a {
            s2 = wrap_add(e1, 2);
            let x2 = iropt_arm_end(f, s2, cv);
            if x2 != IR_NONE {
              let c2 = iropt_at(f, x2);
              let m2 = iropt_at(f, wrap_add(x2, 1));
              if c2.op == IR_LABEL && c2.a == c1.a {
                resume = x2;
                e2 = x2;
              } else if c2.op == IR_JMP && c2.a == c1.a && m2.op == IR_LABEL && m2.a == c1.a {
                resume = wrap_add(x2, 1);
                e2 = x2;
              }
            }
          }
        }
      }
      if resume != IR_NONE {
        // The registers the arms write and something else reads or writes.
        let mut rr = vec_new[u64]();
        let mut k = s1;
        while k < e1 {
          ra_reads(f, iropt_at(f, k), &mut rr);
          k = wrap_add(k, 1);
        }
        k = s2;
        while k < e2 {
          ra_reads(f, iropt_at(f, k), &mut rr);
          k = wrap_add(k, 1);
        }
        let mut shared = vec_new[u64]();
        // (A register written once, by an arm, and read after it has no value
        // on the other path: it stays a branch.)
        let mut fresh_only = false;
        k = s1;
        while k < resume && vec_len(shared) < 8 {
          let w = iropt_at(f, k);
          if (k < e1 || (k >= s2 && k < e2)) && w.d != IR_NONE && w.d < f.nreg {
            let local = u_at(ndef, w.d) == 1 && iropt_count(rr, w.d) == u_at(nuse, w.d);
            if !local && u_at(ndef, w.d) < 2 {
              fresh_only = true;
            }
            if !local && iropt_count(shared, w.d) == 0 {
              vec_push(&mut shared, w.d);
            }
          }
          k = wrap_add(k, 1);
        }
        // A branch that tests a load stays a branch when an arm accumulates into
        // a register (the predictor runs ahead of the load; a mask would put the
        // load on the chain through that register).
        let mut chained = false;
        if vec_len(shared) >= 1 && iropt_cond_loads(f, i, q.a) {
          let mut sx = 0;
          while sx < vec_len(shared) {
            if iropt_count(rr, vec_get(shared, sx)) > 0 {
              chained = true;
            }
            sx = wrap_add(sx, 1);
          }
        }
        if vec_len(shared) >= 1 && vec_len(shared) <= 3 && !fresh_only && !chained {
          // The first arm is the then-arm when its label is the true target.
          let m = ir_reg(&mut f);
          let fl = iropt_flag(f, i, q.a, cv, ndef);
          vec_push(&mut out, IrIns { op: IR_NEG, d: m, a: fl, b: 0, c: 0, ty: 0 });
          let mut mo1 = vec_new[u64]();
          let mut mn1 = vec_new[u64]();
          let mut mo2 = vec_new[u64]();
          let mut mn2 = vec_new[u64]();
          iropt_conv_arm(&mut f, &mut out, s1, e1, shared, &mut mo1, &mut mn1);
          iropt_conv_arm(&mut f, &mut out, s2, e2, shared, &mut mo2, &mut mn2);
          let mut j = 0;
          while j < vec_len(shared) {
            let d = vec_get(shared, j);
            let mut vt = iropt_arm_reg(mo1, mn1, d);
            let mut ve = iropt_arm_reg(mo2, mn2, d);
            if l0.a != q.b {
              let sw = vt;
              vt = ve;
              ve = sw;
            }
            // `if c { d = d + k }` (also -, |, ^): d = d + (k & -c), or d + c for
            // k = 1, one instruction on the chain through d instead of three.
            let mut simple = false;
            if ve == d {
              let mut di = vec_len(out);
              let mut tries = 0;
              let mut want = vt;
              while di > 0 && tries < 40 && !simple {
                di = di - 1;
                tries = wrap_add(tries, 1);
                let qd = iropt_ins_in(out, di);
                if qd.d == want && qd.op == IR_MOV {
                  // d = mov t: look for the instruction that wrote t.
                  want = qd.a;
                }
                if qd.d == want && qd.a == d && qd.c == 0 && (qd.op == IR_ADD || qd.op == IR_SUB || qd.op == IR_OR || qd.op == IR_XOR) && iropt_cval(cv, qd.b) != IR_NONE {
                  simple = true;
                  if iropt_cval(cv, qd.b) == 1 {
                    vec_push(&mut out, IrIns { op: qd.op, d: d, a: d, b: fl, c: 0, ty: 0 });
                  } else {
                    let x2 = ir_reg(&mut f);
                    vec_push(&mut out, IrIns { op: IR_AND, d: x2, a: m, b: qd.b, c: 0, ty: 0 });
                    vec_push(&mut out, IrIns { op: qd.op, d: d, a: d, b: x2, c: 0, ty: 0 });
                  }
                }
              }
            }
            if !simple {
              let x1 = ir_reg(&mut f);
              let x2 = ir_reg(&mut f);
              vec_push(&mut out, IrIns { op: IR_XOR, d: x1, a: vt, b: ve, c: 0, ty: 0 });
              vec_push(&mut out, IrIns { op: IR_AND, d: x2, a: x1, b: m, c: 0, ty: 0 });
              vec_push(&mut out, IrIns { op: IR_XOR, d: d, a: ve, b: x2, c: 0, ty: 0 });
            }
            j = wrap_add(j, 1);
          }
          vec_free(mo1);
          vec_free(mn1);
          vec_free(mo2);
          vec_free(mn2);
          done = wrap_add(done, 1);
          next = resume;
        }
        vec_free(shared);
        vec_free(rr);
      }
    }
    if next == wrap_add(i, 1) {
      vec_push(&mut out, q);
    }
    i = next;
  }
  vec_free(ndef);
  vec_free(nuse);
  vec_free(cv);
  vec_free(refs);
  vec_free(cmp);
  if done == 0 {
    vec_free(out);
    return 0;
  }
  vec_free(f.ins);
  f.ins = out;
  return done;
}

/// Can `iropt_licm` move an instruction with this operation out of a loop? It
/// must have no effect but its result and not trap.
fn iropt_licm_op(op: u64) -> bool {
  return op == IR_ADD || op == IR_SUB || op == IR_MUL || op == IR_AND || op == IR_OR || op == IR_XOR || op == IR_SHL || op == IR_SHR || op == IR_SAR || op == IR_NOT || op == IR_NEG || op == IR_WRAP || (op >= IR_EQ && op <= IR_SGE);
}

/// Is register `r` the same in every pass of the loop whose header label is at
/// `p`: a constant, a register written once outside the loop (a parameter
/// counts), or one `moved` says is moved out?
fn iropt_licm_inv(r: u64, p: u64, ndef: &Vec[u64], cv: &Vec[u64], dp: &Vec[u64], moved: &Vec[u64]) -> bool {
  if r >= vec_len(ndef) || r >= vec_len(cv) || r >= vec_len(dp) || r >= vec_len(moved) {
    return false;
  }
  if u_at(cv, r) != IR_NONE || u_at(moved, r) != 0 {
    return true;
  }
  return u_at(ndef, r) == 1 && (u_at(dp, r) == IR_NONE || u_at(dp, r) < p);
}

/// Loop-invariant code motion: an operation whose result is written once and
/// whose operands are the same in every pass of a loop (constants, registers
/// written once before the loop, results of operations moved the same way) is
/// made once in front of the loop, entered through a new label, instead of in
/// every pass. A loop with more than one way in stays. The innermost loop goes
/// first; a result that is invariant in the loop around it moves again on the
/// next round. Returns how many instructions it moved.
fn iropt_licm(f: &mut IrFn) -> u64 {
  let mut total = 0;
  let mut again = true;
  let mut rounds = 0;
  while again && rounds < 60 {
    again = false;
    rounds = wrap_add(rounds, 1);
    let n = vec_len(f.ins);
    if n > 4000000 || f.nreg > 100000000 || f.nlabel > 100000000 {
      return total;
    }
    let ndef = iropt_ndef(f);
    let cv = iropt_consts(f, ndef);
    let lb = iropt_labs(f);
    let mut dp = vec_new[u64]();
    let mut r = 0;
    while r < f.nreg {
      vec_push(&mut dp, IR_NONE);
      r = wrap_add(r, 1);
    }
    let mut i = 0;
    while i < n {
      let qi = iropt_at(f, i);
      let mut ws = vec_new[u64]();
      ra_writes(qi, &mut ws);
      let mut w = 0;
      while w < vec_len(ws) {
        let x = vec_get(ws, w);
        if x < vec_len(dp) && u_at(dp, x) == IR_NONE {
          ra_set(&mut dp, x, i);
        }
        w = wrap_add(w, 1);
      }
      vec_free(ws);
      i = wrap_add(i, 1);
    }
    // The loop with the largest header position that has something to move.
    let mut best = IR_NONE;
    let mut best_set = vec_new[u64]();
    let mut l = 0;
    while l < f.nlabel {
      let p = u_at(lb.pos, l);
      if u_at(lb.back, l) >= 1 && p != IR_NONE && (best == IR_NONE || p > u_at(lb.pos, best)) {
        let q = u_at(lb.hi, l);
        if q > p && q < n && iropt_wide_entry_ok(f, lb, p, q) {
          let mut moved = vec_new[u64]();
          r = 0;
          while r < f.nreg {
            vec_push(&mut moved, 0);
            r = wrap_add(r, 1);
          }
          let mut set = vec_new[u64]();
          let mut grew = true;
          while grew && vec_len(set) < 64 {
            grew = false;
            i = wrap_add(p, 1);
            while i <= q && i < n {
              let qi = iropt_at(f, i);
              if iropt_licm_op(qi.op) && qi.d < vec_len(moved) && u_at(ndef, qi.d) == 1 && u_at(moved, qi.d) == 0 && qi.d != qi.a && qi.d != qi.b {
                let mut ok = iropt_licm_inv(qi.a, p, ndef, cv, dp, moved);
                if ok && qi.op != IR_NOT && qi.op != IR_NEG && qi.op != IR_WRAP {
                  ok = iropt_licm_inv(qi.b, p, ndef, cv, dp, moved);
                }
                if ok {
                  ra_set(&mut moved, qi.d, 1);
                  vec_push(&mut set, i);
                  grew = true;
                }
              }
              i = wrap_add(i, 1);
            }
          }
          if vec_len(set) > 0 {
            // Instructions that read a constant defined in the loop take it along.
            best = l;
            vec_free(best_set);
            best_set = set;
          } else {
            vec_free(set);
          }
          vec_free(moved);
        }
      }
      l = wrap_add(l, 1);
    }
    if best != IR_NONE {
      let p = u_at(lb.pos, best);
      let q = u_at(lb.hi, best);
      // Constants the moved instructions read, if they lie in the loop, go too.
      let mut mv = vec_new[u64]();
      let mut inset = vec_new[u64]();
      i = 0;
      while i < n {
        vec_push(&mut inset, 0);
        i = wrap_add(i, 1);
      }
      let mut k = 0;
      while k < vec_len(best_set) {
        ra_set(&mut inset, vec_get(best_set, k), 1);
        k = wrap_add(k, 1);
      }
      i = wrap_add(p, 1);
      while i <= q && i < n {
        let qi = iropt_at(f, i);
        if qi.op == IR_CONST && qi.d < vec_len(ndef) && u_at(ndef, qi.d) == 1 {
          // Is it read by a moved instruction?
          let mut used = false;
          k = 0;
          while k < vec_len(best_set) && !used {
            let mq = iropt_at(f, vec_get(best_set, k));
            if mq.a == qi.d || mq.b == qi.d {
              used = true;
            }
            k = wrap_add(k, 1);
          }
          if used {
            ra_set(&mut inset, i, 2);
          }
        }
        i = wrap_add(i, 1);
      }
      let top = ir_label(&mut f);
      let mut out = vec_new[IrIns]();
      i = 0;
      while i < n {
        if i == p {
          vec_push(&mut out, IrIns { op: IR_LABEL, d: IR_NONE, a: top, b: 0, c: 0, ty: 0 });
          let mut j = wrap_add(p, 1);
          while j <= q && j < n {
            if u_at(inset, j) != 0 {
              vec_push(&mut out, iropt_at(f, j));
            }
            j = wrap_add(j, 1);
          }
        }
        if !(i > p && i <= q && u_at(inset, i) != 0) {
          let mut t = iropt_at(f, i);
          if i < p || i > q {
            if t.op == IR_JMP && t.a == best {
              t.a = top;
            }
            if t.op == IR_BR {
              if t.b == best {
                t.b = top;
              }
              if t.c == best {
                t.c = top;
              }
            }
          }
          vec_push(&mut out, t);
        }
        i = wrap_add(i, 1);
      }
      total = wrap_add(total, vec_len(best_set));
      vec_free(f.ins);
      f.ins = out;
      vec_free(mv);
      vec_free(inset);
      again = true;
    }
    vec_free(best_set);
    vec_free(ndef);
    vec_free(cv);
    vec_free(dp);
    iropt_labs_free(lb);
  }
  return total;
}

/// The smallest 2^n - 1 that is at least `x`.
fn iropt_pow2m1(x: u64) -> u64 {
  let mut m = 0;
  let mut k = 0;
  while m < x && k < 64 {
    m = wrap_add(wrap_mul(m, 2), 1);
    k = wrap_add(k, 1);
  }
  return m;
}

/// An upper bound of the result of `q` (an operation `iropt_zext` knows)
/// given the bounds `ub` of its operands; 0xFFFFFFFFFFFFFFFF if none.
fn iropt_ub_ins(q: IrIns, ub: &Vec[u64], cv: &Vec[u64]) -> u64 {
  let op = q.op;
  let top = 0xFFFFFFFFFFFFFFFF;
  let ua = iropt_cval(ub, q.a);
  let ub2 = iropt_cval(ub, q.b);
  let kb = iropt_cval(cv, q.b);
  if op == IR_CONST {
    return q.a;
  }
  if op == IR_MOV {
    return ua;
  }
  if op == IR_AND {
    if ua < ub2 {
      return ua;
    }
    return ub2;
  }
  if op == IR_OR || op == IR_XOR {
    if ua > ub2 {
      return iropt_pow2m1(ua);
    }
    return iropt_pow2m1(ub2);
  }
  if op == IR_SHR && kb < 64 {
    return ua >> kb;
  }
  if op == IR_DIV && kb != IR_NONE && kb > 0 {
    return ua / kb;
  }
  if op == IR_REM && kb != IR_NONE && kb > 0 {
    if ua < kb {
      return ua;
    }
    return kb - 1;
  }
  if iropt_is_cmp(op) {
    return 1;
  }
  if op == IR_LOAD && q.c == 1 {
    return 255;
  }
  if op == IR_ADD && q.c != 1 {
    if ua <= top - ub2 {
      return ua + ub2;
    }
    return top;
  }
  if op == IR_MUL && q.c != 1 {
    if ua == 0 || ub2 == 0 {
      return 0;
    }
    if ub2 <= top / ua {
      return ua * ub2;
    }
    return top;
  }
  if op == IR_SHL && kb < 64 && ua <= (top >> kb) {
    return ua << kb;
  }
  return top;
}

/// Drops a reduction that cannot change its operand: `x % 4294967296` and
/// `x & 0xffffffff` (and any `% k` or `& (2^n - 1)`) of a value already below
/// the modulus become a `mov`. The bound of a register is the largest value
/// any instruction that writes it can give, found by iterating over the
/// function until nothing grows (a register that still grows after a few
/// rounds is unbounded); the arguments, calls and every operation not listed
/// in `iropt_ub_ins` are unbounded. A CRC step `(c / 2 ^ K) % 2^32` of a `c`
/// below 2^32 then loses the reduction. Returns how many it dropped.
fn iropt_zext(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  if n > 4000000 || f.nreg > 100000000 {
    return 0;
  }
  let top = 0xFFFFFFFFFFFFFFFF;
  let ndef = iropt_ndef(f);
  let cv = iropt_consts(f, ndef);
  let mut ub = vec_new[u64]();
  let mut r = 0;
  while r < f.nreg && r < 1000000000 {
    if u_at(ndef, r) == 0 {
      vec_push(&mut ub, top);
    } else {
      vec_push(&mut ub, 0);
    }
    r = wrap_add(r, 1);
  }
  // A parameter holds its argument on entry, whatever the body writes to it.
  let mut pi = 0;
  while pi < vec_len(f.params) {
    let pr = vec_get(f.params, pi);
    if pr < f.nreg {
      ra_set(&mut ub, pr, top);
    }
    pi = wrap_add(pi, 1);
  }
  pi = 0;
  while pi < vec_len(f.lent) {
    let pr = vec_get(f.lent, pi);
    if pr < f.nreg {
      ra_set(&mut ub, pr, top);
    }
    pi = wrap_add(pi, 1);
  }
  let mut round = 0;
  let mut changed = true;
  while changed && round < 16 {
    changed = false;
    let mut i = 0;
    while i < n {
      let q = iropt_at(f, i);
      let mut w = vec_new[u64]();
      ra_writes(q, &mut w);
      let mut j = 0;
      while j < vec_len(w) {
        let d = vec_get(w, j);
        if d < f.nreg {
          let mut nb = top;
          if d == q.d && q.op != IR_CALL && q.op != IR_CALLM {
            nb = iropt_ub_ins(q, ub, cv);
          }
          let prev = u_at(ub, d);
          if nb > prev {
            if round >= 4 {
              nb = top;
            }
            ra_set(&mut ub, d, nb);
            changed = true;
          }
        }
        j = wrap_add(j, 1);
      }
      vec_free(w);
      i = wrap_add(i, 1);
    }
    round = wrap_add(round, 1);
  }
  let mut done = 0;
  if !changed {
    let mut i = 0;
    while i < n {
      let q = iropt_at(f, i);
      if q.d != IR_NONE && q.d < f.nreg && q.a < f.nreg {
        let kb = iropt_cval(cv, q.b);
        let ka = iropt_cval(cv, q.a);
        let mut drop = false;
        if q.op == IR_REM && kb != IR_NONE && kb > 0 && iropt_cval(ub, q.a) < kb {
          drop = true;
        }
        if q.op == IR_AND && kb != IR_NONE && kb & wrap_add(kb, 1) == 0 && iropt_cval(ub, q.a) <= kb {
          drop = true;
        }
        if drop && ka == IR_NONE {
          vec_set(&mut f.ins, i, IrIns { op: IR_MOV, d: q.d, a: q.a, b: 0, c: 0, ty: q.ty });
          done = wrap_add(done, 1);
        }
      }
      i = wrap_add(i, 1);
    }
  }
  vec_free(ndef);
  vec_free(cv);
  vec_free(ub);
  return done;
}

/// The register that holds `a ^ b` where `a` was set a few instructions
/// before position `i`, in the same block, to `b ^ y` or `y ^ b`, and neither
/// `b` nor `y` has been written since: `y`. IR_NONE if not.
fn iropt_xor_other(f: &IrFn, i: u64, a: u64, b: u64) -> u64 {
  let k = iropt_def_before(f, i, a);
  if k == IR_NONE {
    return IR_NONE;
  }
  let q = iropt_at(f, k);
  if q.op != IR_XOR || q.c == 1 || q.d != a || q.d == q.a || q.d == q.b {
    return IR_NONE;
  }
  let mut y = IR_NONE;
  if q.a == b {
    y = q.b;
  } else if q.b == b {
    y = q.a;
  }
  if y == IR_NONE || y == a {
    return IR_NONE;
  }
  let mut j = wrap_add(k, 1);
  while j < i {
    let p = iropt_at(f, j);
    if ra_writes_has(p, b) || ra_writes_has(p, y) {
      return IR_NONE;
    }
    j = wrap_add(j, 1);
  }
  return y;
}

/// `(e ^ k) ^ e` is `k`: the mask select `r = e ^ ((t ^ e) & -c)` of
/// `iropt_ifconv` with a `t` that is `e ^ k`, once `iropt_zext` has dropped
/// the reduction between them, is `r = e ^ (k & -c)`. Returns how many it
/// rewrote.
fn iropt_xorcancel(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  let mut done = 0;
  let mut i = 0;
  while i < n {
    let q = iropt_at(f, i);
    if q.op == IR_XOR && q.c != 1 && q.d != IR_NONE && q.a != IR_NONE && q.b != IR_NONE {
      let mut y = iropt_xor_other(f, i, q.a, q.b);
      if y == IR_NONE {
        y = iropt_xor_other(f, i, q.b, q.a);
      }
      if y != IR_NONE {
        vec_set(&mut f.ins, i, IrIns { op: IR_MOV, d: q.d, a: y, b: 0, c: 0, ty: q.ty });
        done = wrap_add(done, 1);
      }
    }
    i = wrap_add(i, 1);
  }
  return done;
}

/// The position of the call of function `x` that sets register `r` and
/// stands right before position `at`, or IR_NONE.
fn iropt_self_call(f: &IrFn, x: u64, at: u64, r: u64) -> u64 {
  if at == 0 {
    return IR_NONE;
  }
  let j = at - 1;
  let q = iropt_at(f, j);
  if q.op == IR_CALL && q.a == x && q.d == r && q.ty == IR_NONE && q.c == vec_len(f.params) {
    return j;
  }
  return IR_NONE;
}

/// `return t + f(a)` in a function `f` that returns one word, with the add
/// wrapping, is `acc = acc + t; params = a; goto top`, and every other
/// `return v` is `return v + acc`: the second recursive call of `fib(n - 1) +
/// fib(n - 2)` becomes a loop, which halves the calls (gcc does the same). The
/// wrapping add is associative, so the order of the additions does not
/// change the result. A function that takes the address of its frame, takes a
/// buffer parameter or returns more than one word is left alone. Returns how
/// many returns it rewrote.
fn iropt_accrec(f: &mut IrFn) -> u64 {
  let n = vec_len(f.ins);
  if n > 100000 || f.nreg > 100000000 || f.failed || vec_len(f.lent) > 0 || vec_len(f.params) > 8 {
    return 0;
  }
  let x = f.x;
  let mut sites = 0;
  let mut aty = 0;
  let mut i = 0;
  while i < n {
    let q = iropt_at(f, i);
    if q.op == IR_SLOT || q.op == IR_CALLM || q.op == IR_VGROW {
      return 0;
    }
    if q.op == IR_RET && (q.c != 0 || q.a == IR_NONE || q.b != IR_NONE) {
      return 0;
    }
    if q.op == IR_RET && i >= 2 {
      let s = iropt_at(f, i - 1);
      if s.op == IR_ADD && s.c == 1 && s.d == q.a {
        let mut j = iropt_self_call(f, x, i - 1, s.b);
        if j == IR_NONE {
          j = iropt_self_call(f, x, i - 1, s.a);
        }
        if j != IR_NONE {
          sites = wrap_add(sites, 1);
          aty = s.ty;
        }
      }
    }
    i = wrap_add(i, 1);
  }
  if sites == 0 {
    return 0;
  }
  let acc = ir_reg(&mut f);
  let top = ir_label(&mut f);
  let mut out = vec_new[IrIns]();
  vec_push(&mut out, IrIns { op: IR_CONST, d: acc, a: 0, b: 0, c: 0, ty: 0 });
  vec_push(&mut out, IrIns { op: IR_LABEL, d: IR_NONE, a: top, b: 0, c: 0, ty: 0 });
  i = 0;
  while i < n {
    let q = iropt_at(f, i);
    let mut handled = false;
    // The call, the add and the return are three instructions in a row.
    if q.op == IR_CALL && q.a == x && q.ty == IR_NONE && q.c == vec_len(f.params) && wrap_add(i, 2) < n {
      let s = iropt_at(f, wrap_add(i, 1));
      let rt = iropt_at(f, wrap_add(i, 2));
      if s.op == IR_ADD && s.c == 1 && rt.op == IR_RET && s.d == rt.a && (s.a == q.d || s.b == q.d) && s.a != s.b && q.d != IR_NONE {
        let mut t = s.a;
        if s.a == q.d {
          t = s.b;
        }
        // `t` must not be the call's own result, and all the reads of the
        // arguments happen before the parameters are written.
        if t != q.d {
          vec_push(&mut out, IrIns { op: IR_ADD, d: acc, a: acc, b: t, c: 1, ty: s.ty });
          let mut tmps = vec_new[u64]();
          let mut k = 0;
          while k < q.c && k < 8 {
            let tmp = ir_reg(&mut f);
            vec_push(&mut tmps, tmp);
            vec_push(&mut out, IrIns { op: IR_MOV, d: tmp, a: u_at(f.args, wrap_add(q.b, k)), b: 0, c: 0, ty: 0 });
            k = wrap_add(k, 1);
          }
          k = 0;
          while k < q.c && k < 8 {
            vec_push(&mut out, IrIns { op: IR_MOV, d: u_at(f.params, k), a: u_at(tmps, k), b: 0, c: 0, ty: 0 });
            k = wrap_add(k, 1);
          }
          vec_free(tmps);
          vec_push(&mut out, IrIns { op: IR_JMP, d: IR_NONE, a: top, b: 0, c: 0, ty: 0 });
          handled = true;
          i = wrap_add(i, 3);
        }
      }
    }
    if !handled {
      if q.op == IR_RET && q.a != IR_NONE {
        let y = ir_reg(&mut f);
        vec_push(&mut out, IrIns { op: IR_ADD, d: y, a: q.a, b: acc, c: 1, ty: aty });
        vec_push(&mut out, IrIns { op: IR_RET, d: q.d, a: y, b: q.b, c: q.c, ty: q.ty });
      } else {
        vec_push(&mut out, q);
      }
      i = wrap_add(i, 1);
    }
  }
  vec_free(f.ins);
  f.ins = out;
  return sites;
}
