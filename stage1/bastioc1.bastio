// bastioc1 -- the self-hosted compiler for Bastio: the whole pipeline of
// stage0's bastioc0 (stage0/src/main.rs), written in Bastio.
//
// Pipeline: load -> monomorphize -> check (types and linearity) -> verify
// (Z3) -> C -> the system C compiler.
//
// usage: bastioc1 [--help] [--check] [--emit-c] [--target T] [--arch A] [--lib DIR] [--pkg NAME=DIR] [--backend B] [--emit-asm] [--self-link|--gnu-link|--musl-link] [--header F] [--dump-smt] [-o out] <file.bastio>...
//   (default)   verify, then build a native executable `out` (default: a.out)
//               with the C compiler `$CC` (default: cc)
//   --check     stop after verification
//   --emit-c    write the generated C to `out` (default: out.c) instead of
//               building
//   --target    `hosted` (default): a normal program on the C library
//               `kernel`: freestanding C for a bare-metal kernel (implies --emit-c)
//               `user`: freestanding C for a user program under BastiOS (implies --emit-c)
//   --arch      `x86_64` (default) or `aarch64`, as for bastioc0: aarch64
//               changes the default C compiler to `aarch64-linux-gnu-gcc`
//               (`CC` still overrides it); with `--backend native` it writes
//               AArch64 assembly (hosted, programs with a `main`, the
//               functions the IR covers: stage1/irarm64.bastio). With `--target
//               kernel` or `user` it selects the AArch64 prelude (stage1
//               only: bastioc0 knows only x86-64 bare metal)
//   --lib DIR   also look for imported files in DIR (see `resolve` in
//               loader.bastio); may be given more than once
//   --pkg NAME=DIR  `import "NAME/rest"` is the file `rest` in DIR, before any
//               other place is searched; may be given more than once (the
//               `bastio` tool passes one per package of a project)
//   --backend native  generate x86-64 (or, with `--arch aarch64`, AArch64)
//               assembly directly instead of C, then
//               assemble and link it (hosted); with `--target user` or
//               `kernel`, write the assembly to `out` (default: out.s), to
//               be linked with BastiOS's start code or platform
//   --emit-asm  with `--backend native`: write the assembly to `out`
//               (default: out.s) instead of building
//   --header F  also write a C header for the program's `export fn`s to F
//   --dump-smt  once every proof succeeds, print every query sent to Z3 on
//               standard output, as bastioc0 does
//   --trusted-base  list and count the hand-written trusted base, then exit
//               (for AArch64's preludes after `--arch aarch64`)
//   --help      print the options, then exit
// Several input files form one program, as for bastioc0.
//
// Errors are reported on standard error as bastioc0 reports them:
// `file:line:col: error[CODE]: what is wrong`, the source line with a caret
// under the position, then hints or a failed proof's counterexample.
import "loader.bastio";
import "libenv.bastio";
import "solve.bastio";
import "header.bastio";
import "x86.bastio";
import "irx86.bastio";
import "irarm64.bastio";
import "wasm.bastio";
import "winpe.bastio";
import "prune.bastio";
import "elf.bastio";
import "machold.bastio";

/// The index of the first `=` in `b`, or its length when there is none.
fn b1_find_eq(b: &Bytes) -> u64 {
  let n = blen(b);
  let mut i = 0;
  while i < n && bget(b, i) != 61
    invariant i <= n && n == blen(b)
  {
    i = i + 1;
  }
  return i;
}

fn b1_code(code: u64) -> Str {
  if code == C_USE { return "E-LINEAR-USE"; }
  if code == C_LEAK { return "E-LINEAR-LEAK"; }
  if code == C_BRANCH { return "E-LINEAR-BRANCH"; }
  if code == C_MATCH { return "E-MATCH"; }
  if code == C_TARGET { return "E-TARGET"; }
  if code == C_EXPORT { return "E-EXPORT"; }
  if code == C_PIN { return "E-PIN"; }
  if code == C_LOCK_ORDER { return "E-LOCK-ORDER"; }
  return "E-TYPE";
}

fn b1_bytes(out: &mut Vec[u64], b: &Bytes) {
  let mut k = 0;
  while k < blen(b) {
    vec_push(&mut out, cast[u64](bget(b, k)));
    k = k + 1;
  }
}

fn loaded_at(ld: &Loader, k: u64) -> Loaded {
  if k < vec_len(ld.files) {
    return vec_get(ld.files, k);
  }
  return Loaded { start: 0, len: 0, done: false, raw: 0, rawlen: 0, src: 0 };
}

/// The error at `file:line:col` with code `code`, as bastioc0 renders it
/// (diag.rs), followed by the notes in `notes`.
fn b1_render(out: &mut Vec[u64], p: &Parser, ld: &Loader, file: u64, line: u64, col: u64, code: Str, msg: &Vec[u64], notes: &Vec[u64]) {
  let f = loaded_at(ld, file);
  let mut k = f.raw;
  let rend = cg_add(f.raw, f.rawlen);
  while k < rend {
    vec_push(&mut out, u_at(ld.paths, k));
    k = k + 1;
  }
  // Line 0 is no line of the program (the solver failed to start, say):
  // the file name alone, and no source line (stage0's `Diag::render`).
  if line > 0 {
    w_s(&mut out, ":");
    w_num(&mut out, line);
    w_s(&mut out, ":");
    w_num(&mut out, col);
  }
  w_s(&mut out, ": error[");
  w_s(&mut out, code);
  w_s(&mut out, "]");
  if vec_len(msg) > 0 {
    w_s(&mut out, ": ");
    k = 0;
    while k < vec_len(msg) {
      vec_push(&mut out, u_at(msg, k));
      k = k + 1;
    }
  }
  w_s(&mut out, "\n");
  // The source line: the file's text runs to where the next file's starts.
  let mut end = blen(p.src);
  let nf = cg_add(file, 1);
  if nf < vec_len(ld.files) {
    let g = loaded_at(ld, nf);
    if g.src < end {
      end = g.src;
    }
  }
  let mut i = f.src;
  let mut l = 1;
  while l < line && i < end {
    if src_at(p, i) == 10 {
      l = l + 1;
    }
    i = i + 1;
  }
  // The gutter: " 12 | " before the source line, as wide before the
  // caret line and the notes.
  let mut digits = vec_new[u64]();
  w_num(&mut digits, line);
  if line > 0 && l >= line && i < end {
    w_s(&mut out, " ");
    k = 0;
    while k < vec_len(digits) {
      vec_push(&mut out, u_at(digits, k));
      k = k + 1;
    }
    w_s(&mut out, " | ");
    let mut j = i;
    while j < end && src_at(p, j) != 10 {
      j = j + 1;
    }
    let mut e = j;
    if e > i && src_at(p, e - 1) == 13 {
      e = e - 1;
    }
    let ls = i;
    while i < e {
      vec_push(&mut out, src_at(p, i));
      i = i + 1;
    }
    w_s(&mut out, "\n");
    b1_pad(&mut out, vec_len(digits));
    w_s(&mut out, " | ");
    // Columns count characters (a UTF-8 continuation byte is not one);
    // tabs before the error stay tabs, so the caret lines up.
    let mut q = ls;
    let mut c = 1;
    while c < col {
      if q < e {
        if src_at(p, q) == 9 {
          w_s(&mut out, "\t");
        } else {
          w_s(&mut out, " ");
        }
        q = q + 1;
        while q < e && src_at(p, q) >= 128 && src_at(p, q) < 192 {
          q = q + 1;
        }
      } else {
        w_s(&mut out, " ");
      }
      c = c + 1;
    }
    let mut n = b1_token_len(p, q, e);
    while n > 0 {
      w_s(&mut out, "^");
      n = n - 1;
    }
    w_s(&mut out, "\n");
  }
  // Each note line comes as "  = ...": its "=" goes under the gutter's "|".
  k = 0;
  let mut bol = true;
  while k < vec_len(notes) {
    if bol && k + 2 < vec_len(notes) && u_at(notes, k) == 32 && u_at(notes, k + 1) == 32 && u_at(notes, k + 2) == 61 {
      b1_pad(&mut out, vec_len(digits));
      w_s(&mut out, " ");
      k = k + 2;
    }
    let ch = u_at(notes, k);
    vec_push(&mut out, ch);
    bol = ch == 10;
    k = k + 1;
  }
  vec_free(digits);
}

/// `n + 1` spaces: the gutter of a line number of `n` digits.
fn b1_pad(out: &mut Vec[u64], n: u64) {
  w_s(&mut out, " ");
  let mut k = 0;
  while k < n {
    w_s(&mut out, " ");
    k = k + 1;
  }
}

fn b1_word(ch: u64) -> bool {
  return (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95;
}

/// The length in characters of the token at byte `q` of a line ending at
/// byte `e`: a word (a name or a number), a string literal, or else one
/// character (diag.rs's `token_len`).
fn b1_token_len(p: &Parser, q: u64, e: u64) -> u64 {
  if q >= e {
    return 1;
  }
  let ch = src_at(p, q);
  if b1_word(ch) {
    let mut j = q;
    while j < e && b1_word(src_at(p, j))
      invariant q <= j
    {
      j = j + 1;
    }
    return j - q;
  }
  if ch == 34 {
    // Characters up to the closing quote, or to the end of the line.
    let mut n = 1;
    let mut j = q + 1;
    while j < e && src_at(p, j) != 34 {
      let step = src_at(p, j) == 92;
      if src_at(p, j) < 128 || src_at(p, j) >= 192 {
        n = cg_add(n, 1);
      }
      j = j + 1;
      if step && j < e {
        if src_at(p, j) < 128 || src_at(p, j) >= 192 {
          n = cg_add(n, 1);
        }
        j = j + 1;
      }
    }
    if j < e {
      return cg_add(n, 1);
    }
    return n;
  }
  return 1;
}

/// Writes the bytes in `out` to standard error and empties it.
fn b1_flush(host: &Host, out: &mut Vec[u64]) {
  let mut b = balloc(vec_len(out));
  let mut k = 0;
  while k < vec_len(out) && k < blen(b) {
    let ch = u_at(out, k);
    if ch <= 255 {
      bset(&mut b, k, cast[u8](ch));
    }
    k = k + 1;
  }
  host_eprint(host, b);
  bfree(b);
  while vec_len(out) > 0 {
    vec_pop(&mut out);
  }
}

/// Writes the bytes in `text` to the file `path`.
fn b1_write(host: &Host, path: &Bytes, text: &Vec[u64]) -> bool {
  let mut b = balloc(vec_len(text));
  let mut k = 0;
  while k < vec_len(text) && k < blen(b) {
    let ch = u_at(text, k);
    if ch <= 255 {
      bset(&mut b, k, cast[u8](ch));
    }
    k = k + 1;
  }
  let ok = host_write(host, path, b);
  bfree(b);
  return ok;
}

fn b1_concat(a: &Bytes, s: Str) -> Bytes {
  let mut n = blen(a);
  if n < 1152921504606846976 && slen(s) < 1152921504606846976 - n {
    n = n + slen(s);
  }
  let mut b = balloc(n);
  let mut k = 0;
  while k < blen(a) && k < blen(b) {
    bset(&mut b, k, bget(a, k));
    k = k + 1;
  }
  let mut j = 0;
  while j < slen(s) && k < blen(b) {
    bset(&mut b, k, sget(s, j));
    k = k + 1;
    j = j + 1;
  }
  return b;
}

fn b1_is(b: &Bytes, w: Str) -> bool {
  return spells(b, 0, blen(b), w);
}

/// Whether the C library is glibc's, the one `elf.bastio` writes executables
/// for (musl names its dynamic loader and library differently).
fn b1_glibc(host: &Host, loader: Str) -> bool {
  let path = bfrom(loader);
  let mut b = balloc(0);
  let ok = host_read(host, path, &mut b) && blen(b) > 0;
  bfree(b);
  bfree(path);
  return ok;
}

/// Whether this compiler is itself an x86-64 ELF program, that is, whether
/// it runs on x86-64 Linux: the native backends write ELF for that and
/// nothing else (macOS and AArch64 hosts build through the C backend).
fn b1_host_x86_64_elf(host: &Host) -> bool {
  let path = bfrom("/proc/self/exe");
  let mut b = balloc(0);
  let mut ok = false;
  if host_read(host, path, &mut b) && blen(b) > 19 {
    ok = bget(b, 0) == 127 && bget(b, 1) == 69 && bget(b, 2) == 76 && bget(b, 3) == 70 && bget(b, 18) == 62;
  }
  bfree(b);
  bfree(path);
  return ok;
}

/// Whether an assembler named `as` is in a directory of `PATH`: the native
/// backends need one, and a machine without it (BastiOS's own guests build
/// with `tcc`) has to keep the C backend.
fn b1_have_as(host: &Host) -> bool {
  let mut path = balloc(0);
  let mut found = false;
  if host_env(host, "PATH", &mut path) {
    let n = blen(path);
    let mut start = 0;
    let mut i = 0;
    while i <= n && i < blen(path) + 1 && !found {
      if i == n || bget(path, i) == 58 {
        if i > start && i <= blen(path) {
          let mut d = balloc(i - start);
          let mut k = 0;
          while k < blen(d) && start + k < blen(path) {
            bset(&mut d, k, bget(path, start + k));
            k = k + 1;
          }
          let f = b1_concat(d, "/as");
          let mut b = balloc(0);
          if host_read(host, f, &mut b) {
            found = true;
          }
          bfree(b);
          bfree(f);
          bfree(d);
        }
        start = i + 1;
      }
      i = i + 1;
    }
  }
  bfree(path);
  return found;
}

/// Runs `argv` and waits for it: its exit status (127 if it cannot run).
fn b1_run(host: &Host, argv: Vec[Bytes]) -> u64 {
  let ch = host_spawn(host, argv);
  drop_argv(argv);
  return child_wait(ch);
}

/// Runs `argv`; 0 if it succeeded, else 3 with bastioc0's message about
/// `what` in `out`.
fn b1_tool(host: &Host, argv: Vec[Bytes], what: Str, out: &mut Vec[u64]) -> u64 {
  let st = b1_run(host, argv);
  if st == 0 {
    return 0;
  }
  if st == 127 {
    w_s(&mut out, "bastioc1: cannot run ");
    w_s(&mut out, what);
    w_s(&mut out, "\n");
  } else {
    w_s(&mut out, "bastioc1: ");
    w_s(&mut out, what);
    w_s(&mut out, " failed (this is a compiler bug)\n");
  }
  return 3;
}

/// `--backend native`, as stage0's x86::build: the assembly is written to
/// `outp` (`--emit-asm`), or assembled and linked into the executable
/// `outp`. Returns the exit status.
fn b1_native(host: &Host, c: &Checker, m: &mut Mono, p: &Parser, target: u64, aarch64: bool, wasm: bool, macos: bool, windows: bool, linkchoice: u64, ir: bool, emit_asm: bool, lib: bool, outp: &Bytes, has_out: bool, out: &mut Vec[u64]) -> u64 {
  let mut g = x86_new();
  g.macos = macos;
  g.windows = windows;
  // A BastiOS user program or kernel: the assembly is the output (as the C
  // is with the C backend), to be linked with BastiOS's start code.
  g.target = target;
  let mut status = 0;
  let mut built = false;
  if wasm {
    built = wa_program(&mut g, c, &mut m, p);
  } else if aarch64 {
    built = a64_program(&mut g, c, &mut m, p);
  } else if ir {
    built = x86_program_ir(&mut g, c, &mut m, p);
  } else {
    built = x86_program(&mut g, c, &mut m, p);
  }
  if built && (ir || aarch64) && !wasm {
    // The functions the IR passes inlined everywhere are still written.
    let kept = asm_prune_dead(g.out);
    vec_free(g.out);
    g.out = kept;
  }
  if built && macos && !aarch64 && target == TARGET_HOSTED {
    let mo = macho_text_x86(g.out);
    vec_free(g.out);
    g.out = mo;
  }
  if built && windows && target == TARGET_HOSTED {
    let wn = winpe_text(g.out);
    vec_free(g.out);
    g.out = wn;
  }
  if !built {
    w_s(&mut out, "bastioc1: ");
    let mut k = 0;
    while k < vec_len(g.fmsg) {
      vec_push(&mut out, u_at(g.fmsg, k));
      k = k + 1;
    }
    w_s(&mut out, "\n");
    status = 4;
  } else if wasm {
    // The module is the output: no assembler, no linker.
    let mut path = b1_concat(outp, "");
    if !has_out {
      bfree(path);
      path = bfrom("a.wasm");
    }
    if !b1_write(host, path, g.out) {
      w_s(&mut out, "bastioc1: cannot write ");
      b1_bytes(&mut out, path);
      w_s(&mut out, "\n");
      status = 2;
    }
    bfree(path);
  } else if lib && !emit_asm && target == TARGET_HOSTED && !windows && !macos && ((linkchoice == 1 || linkchoice == 3) || (linkchoice == 0 && ((!aarch64 && (b1_glibc(host, "/lib64/ld-linux-x86-64.so.2") || b1_glibc(host, "/lib/ld-musl-x86_64.so.1"))) || (aarch64 && b1_glibc(host, "/lib/ld-linux-aarch64.so.1"))))) {
    // A library is an object file for the C program that calls it, written
    // by elf.bastio: no `as`.
    let mut obj = b1_concat(outp, "");
    if !has_out {
      bfree(obj);
      obj = bfrom("a.out");
    }
    let mut text = balloc(vec_len(g.out));
    let mut k = 0;
    while k < vec_len(g.out) && k < blen(text) {
      let ch = u_at(g.out, k);
      if ch <= 255 {
        bset(&mut text, k, cast[u8](ch));
      }
      k = k + 1;
    }
    let st = elf_build_rel(host, obj, text, aarch64);
    if st != 0 {
      w_s(&mut out, "bastioc1: the assembler of our own failed (status ");
      w_num(&mut out, st);
      w_s(&mut out, ")\n");
      status = 4;
    }
    bfree(text);
    bfree(obj);
  } else if ((linkchoice == 1 || linkchoice == 3) || (linkchoice == 0 && (windows || macos || (ir && !aarch64 && (b1_glibc(host, "/lib64/ld-linux-x86-64.so.2") || b1_glibc(host, "/lib/ld-musl-x86_64.so.1"))) || (aarch64 && b1_glibc(host, "/lib/ld-linux-aarch64.so.1"))))) && !emit_asm && target == TARGET_HOSTED && !lib {
    // The program is assembled and linked by pe.bastio: no `as`, no `cc`.
    let mut exe = b1_concat(outp, "");
    if !has_out {
      bfree(exe);
      exe = bfrom("a.exe");
    }
    let mut text = balloc(vec_len(g.out));
    let mut k = 0;
    while k < vec_len(g.out) && k < blen(text) {
      let ch = u_at(g.out, k);
      if ch <= 255 {
        bset(&mut text, k, cast[u8](ch));
      }
      k = k + 1;
    }
    let mut st = 0;
    if windows {
      st = pe_build(host, exe, text);
    } else if macos {
      st = ml_build(host, exe, text, aarch64);
      if st == 0 {
        let mut cm = vec_new[Bytes]();
        push_arg(&mut cm, "chmod");
        push_arg(&mut cm, "+x");
        vec_push(&mut cm, b1_concat(exe, ""));
        b1_run(host, cm);
      }
    } else if aarch64 {
      st = elf_build_a64(host, exe, text);
      if st == 0 {
        let mut cm = vec_new[Bytes]();
        push_arg(&mut cm, "chmod");
        push_arg(&mut cm, "+x");
        vec_push(&mut cm, b1_concat(exe, ""));
        b1_run(host, cm);
      }
    } else {
      st = elf_build(host, exe, text, linkchoice == 3 || !b1_glibc(host, "/lib64/ld-linux-x86-64.so.2"));
      if st == 0 {
        let mut cm = vec_new[Bytes]();
        push_arg(&mut cm, "chmod");
        push_arg(&mut cm, "+x");
        vec_push(&mut cm, b1_concat(exe, ""));
        b1_run(host, cm);
      }
    }
    if st != 0 {
      w_s(&mut out, "bastioc1: the linker of our own failed (status ");
      w_num(&mut out, st);
      w_s(&mut out, ")\n");
      status = 4;
    }
    bfree(text);
    bfree(exe);
  } else if emit_asm || target != TARGET_HOSTED {
    let mut path = b1_concat(outp, "");
    if !has_out {
      bfree(path);
      path = bfrom("out.s");
    }
    if !b1_write(host, path, g.out) {
      w_s(&mut out, "bastioc1: cannot write ");
      b1_bytes(&mut out, path);
      w_s(&mut out, "\n");
      status = 2;
    }
    bfree(path);
  } else {
    let mut exe = b1_concat(outp, "");
    if !has_out {
      bfree(exe);
      exe = bfrom("a.out");
    }
    let sfile = b1_concat(exe, ".s");
    let ofile = b1_concat(exe, ".o");
    if !b1_write(host, sfile, g.out) {
      w_s(&mut out, "bastioc1: cannot write ");
      b1_bytes(&mut out, sfile);
      w_s(&mut out, "\n");
      status = 2;
    } else {
      let mut asm = vec_new[Bytes]();
      if macos {
        // Apple's assembler takes the architecture as an option.
        push_arg(&mut asm, "as");
        push_arg(&mut asm, "-arch");
        if aarch64 {
          push_arg(&mut asm, "arm64");
        } else {
          push_arg(&mut asm, "x86_64");
        }
      } else if aarch64 {
        push_arg(&mut asm, "aarch64-linux-gnu-as");
      } else {
        push_arg(&mut asm, "as");
        push_arg(&mut asm, "--64");
      }
      push_arg(&mut asm, "-o");
      vec_push(&mut asm, b1_concat(ofile, ""));
      vec_push(&mut asm, b1_concat(sfile, ""));
      status = b1_tool(host, asm, "the assembler", &mut out);
      if status == 0 && lib {
        // A library is an object file for the C program that calls it.
        let mut mv = vec_new[Bytes]();
        push_arg(&mut mv, "mv");
        push_arg(&mut mv, "-f");
        vec_push(&mut mv, b1_concat(ofile, ""));
        vec_push(&mut mv, b1_concat(exe, ""));
        b1_run(host, mv);
      } else if status == 0 {
        // The linker: `CC`, as for bastioc0, or `cc`.
        let mut cc = balloc(0);
        if !host_env(host, "CC", &mut cc) {
          bfree(cc);
          if aarch64 && !macos {
            cc = bfrom("aarch64-linux-gnu-gcc");
          } else {
            cc = bfrom("cc");
          }
        }
        let mut ld = vec_new[Bytes]();
        vec_push(&mut ld, cc);
        push_arg(&mut ld, "-o");
        vec_push(&mut ld, b1_concat(exe, ""));
        vec_push(&mut ld, b1_concat(ofile, ""));
        status = b1_tool(host, ld, "the linker", &mut out);
      }
      if status == 0 {
        let mut rm = vec_new[Bytes]();
        push_arg(&mut rm, "rm");
        push_arg(&mut rm, "-f");
        vec_push(&mut rm, b1_concat(sfile, ""));
        vec_push(&mut rm, b1_concat(ofile, ""));
        b1_run(host, rm);
      }
    }
    bfree(sfile);
    bfree(ofile);
    bfree(exe);
  }
  x86_free(g);
  return status;
}

/// What `--help` prints (stage0's `HELP`, with this compiler's name and
/// options).
fn b1_help(out: &mut Vec[u64]) {
  w_s(&mut out, "usage: bastioc1 [options] <file.bastio>...\n");
  w_s(&mut out, "Proves the program memory safe with Z3, then compiles it with `cc`.\n");
  w_s(&mut out, "\n");
  w_s(&mut out, "  --check          verify only; write nothing\n");
  w_s(&mut out, "  --emit-c         write the generated C instead of an executable\n");
  w_s(&mut out, "  --target T       hosted (the default), or kernel or user for BastiOS (these write C, or assembly with --backend native)\n");
  w_s(&mut out, "  --arch A         x86_64 (the default) or aarch64 (hosted programs compile with aarch64-linux-gnu-gcc; --backend native: partial)\n");
  w_s(&mut out, "  --os O           linux (the default), macos (--backend native --arch aarch64, or --backend native-ir: Mach-O assembly for Apple's assembler and linker driver) or windows (--backend native-ir: assembly for MinGW-w64)\n");
  w_s(&mut out, "  --backend B      c, or native (x86-64 assembly, or AArch64 with --arch aarch64); hosted programs on x86-64 Linux use native-ir unless --backend or --emit-c says otherwise\n");
  w_s(&mut out, "  --self-link      with --backend native-ir: assemble and link with the built-in assembler and linker (the default on Windows, macOS and glibc or musl Linux hosts; --musl-link writes an executable for musl's loader)\n");
  w_s(&mut out, "  --gnu-link       with --backend native-ir: assemble and link with the platform's as and cc instead\n");
  w_s(&mut out, "  --emit-asm       with --backend native: write the assembly instead of an executable\n");
  w_s(&mut out, "  --lib DIR        also look for imported files in DIR\n");
  w_s(&mut out, "  --pkg NAME=DIR   import \"NAME/rest\" is the file rest in DIR\n");
  w_s(&mut out, "  --header FILE    also write a C header for the program's `export fn`s\n");
  w_s(&mut out, "  -o FILE          the output file (default: a.out, or out.c for C and out.s for assembly)\n");
  w_s(&mut out, "  --dump-smt       print every query sent to the solver\n");
  w_s(&mut out, "  --trusted-base   print the trusted runtime code and exit\n");
  w_s(&mut out, "  --help           print this and exit\n");
}

fn main(con: &mut Serial, host: &mut Host) -> u64 {

  let mut out = vec_new[u64]();
  let mut check_only = false;
  let mut emit_c = false;
  let mut native = false;
  let mut native_ir = false;
  let mut backend_set = false;
  let mut emit_asm = false;
  let mut dump_smt = false;
  let mut target = TARGET_HOSTED;
  let mut aarch64 = false;
  let mut wasm = false;
  let mut macos = false;
  let mut windows = false;
  let mut linkchoice = 0;
  let mut outp = balloc(0);
  let mut has_out = false;
  let mut hdr = balloc(0);
  let mut has_hdr = false;
  let mut listed = false;
  let mut inputs = vec_new[Bytes]();
  let mut ld = loader_new();
  let mut status = 0;
  let mut i = 1;
  while i < host_argc(host) && status == 0 {
    let a = host_arg(host, i);
    if b1_is(a, "--check") {
      check_only = true;
      bfree(a);
    } else if b1_is(a, "--emit-c") {
      emit_c = true;
      bfree(a);
    } else if b1_is(a, "--emit-asm") {
      emit_asm = true;
      bfree(a);
    } else if b1_is(a, "--self-link") {
      linkchoice = 1;
      bfree(a);
    } else if b1_is(a, "--musl-link") {
      linkchoice = 3;
      bfree(a);
    } else if b1_is(a, "--gnu-link") {
      linkchoice = 2;
      bfree(a);
    } else if b1_is(a, "--dump-smt") {
      dump_smt = true;
      bfree(a);
    } else if b1_is(a, "--backend") {
      bfree(a);
      i = cg_add(i, 1);
      let b = host_arg(host, i);
      backend_set = true;
      if b1_is(b, "c") {
        native = false;
      } else if b1_is(b, "native") {
        native = true;
      } else if b1_is(b, "native-ir") {
        // Not in --help: the native backend writing the functions the IR
        // covers from the IR (stage1/irx86.bastio), for the tests.
        native = true;
        native_ir = true;
      } else {
        w_s(&mut out, "bastioc1: unknown backend `");
        b1_bytes(&mut out, b);
        w_s(&mut out, "` (expected `c` or `native`)\n");
        status = 2;
      }
      bfree(b);
    } else if b1_is(a, "--target") {
      bfree(a);
      i = cg_add(i, 1);
      let t = host_arg(host, i);
      if b1_is(t, "hosted") {
        target = TARGET_HOSTED;
      } else if b1_is(t, "kernel") {
        target = TARGET_KERNEL;
        emit_c = true;
      } else if b1_is(t, "user") {
        target = TARGET_USER;
        emit_c = true;
      } else {
        w_s(&mut out, "bastioc1: unknown target `");
        b1_bytes(&mut out, t);
        w_s(&mut out, "` (expected `hosted`, `kernel` or `user`)\n");
        status = 2;
      }
      bfree(t);
    } else if b1_is(a, "--arch") {
      bfree(a);
      i = cg_add(i, 1);
      let t = host_arg(host, i);
      if b1_is(t, "x86_64") {
        aarch64 = false;
        wasm = false;
      } else if b1_is(t, "aarch64") {
        aarch64 = true;
        wasm = false;
      } else if b1_is(t, "wasm32") {
        aarch64 = false;
        wasm = true;
      } else {
        w_s(&mut out, "bastioc1: unknown architecture `");
        b1_bytes(&mut out, t);
        w_s(&mut out, "` (expected `x86_64`, `aarch64` or `wasm32`)\n");
        status = 2;
      }
      bfree(t);
    } else if b1_is(a, "--os") {
      bfree(a);
      i = cg_add(i, 1);
      let t = host_arg(host, i);
      if b1_is(t, "linux") {
        macos = false;
        windows = false;
      } else if b1_is(t, "macos") {
        macos = true;
        windows = false;
      } else if b1_is(t, "windows") {
        macos = false;
        windows = true;
      } else {
        w_s(&mut out, "bastioc1: unknown operating system `");
        b1_bytes(&mut out, t);
        w_s(&mut out, "` (expected `linux`, `macos` or `windows`)\n");
        status = 2;
      }
      bfree(t);
    } else if b1_is(a, "--help") || b1_is(a, "-h") {
      bfree(a);
      let mut hl = vec_new[u64]();
      b1_help(&mut hl);
      let mut j = 0;
      while j < vec_len(hl) {
        let ch = vec_get(hl, j);
        if ch <= 255 {
          serial_write(con, cast[u8](ch));
        }
        j = j + 1;
      }
      vec_free(hl);
      listed = true;
      i = host_argc(host);
    } else if b1_is(a, "--trusted-base") {
      bfree(a);
      let mut tb = vec_new[u64]();
      let mut tb_arch = ARCH_X86_64;
      if aarch64 {
        tb_arch = ARCH_AARCH64;
      }
      trusted_base(&mut tb, tb_arch);
      let mut j = 0;
      while j < vec_len(tb) {
        let ch = vec_get(tb, j);
        if ch <= 255 {
          serial_write(con, cast[u8](ch));
        }
        j = j + 1;
      }
      vec_free(tb);
      listed = true;
      i = host_argc(host);
    } else if b1_is(a, "--header") {
      bfree(a);
      i = cg_add(i, 1);
      bfree(hdr);
      hdr = host_arg(host, i);
      has_hdr = true;
    } else if b1_is(a, "--lib") {
      bfree(a);
      i = cg_add(i, 1);
      loader_lib(&mut ld, host_arg(host, i));
    } else if b1_is(a, "--pkg") {
      bfree(a);
      i = cg_add(i, 1);
      let pspec = host_arg(host, i);
      let eq = b1_find_eq(pspec);
      if eq == 0 || eq >= blen(pspec) {
        w_s(&mut out, "bastioc1: --pkg wants NAME=DIR\n");
        status = 2;
        bfree(pspec);
      } else {
        loader_pkg(&mut ld, byte_range(pspec, 0, eq), byte_range(pspec, eq + 1, blen(pspec)));
        bfree(pspec);
      }
    } else if b1_is(a, "-o") {
      bfree(a);
      i = cg_add(i, 1);
      bfree(outp);
      outp = host_arg(host, i);
      has_out = true;
    } else if blen(a) > 0 && bget(a, 0) == 45 {
      w_s(&mut out, "bastioc1: unknown option `");
      b1_bytes(&mut out, a);
      w_s(&mut out, "`\n");
      bfree(a);
      status = 2;
    } else {
      vec_push(&mut inputs, a);
    }
    i = cg_add(i, 1);
  }
  loader_env_libs(host, &mut ld);
  if listed {
    loader_free(ld);
    vec_free(out);
    drop_argv(inputs);
    bfree(outp);
    bfree(hdr);
    return 0;
  }
  if status == 0 && vec_len(inputs) == 0 {
    w_s(&mut out, "usage: bastioc1 [--check] [--emit-c] [--target hosted|kernel|user] [--arch x86_64|aarch64] [--lib DIR] [--pkg NAME=DIR] [--backend c|native] [--emit-asm] [--header F] [-o out] <file.bastio>...\n");
    status = 2;
  }
  // A hosted program on x86-64 Linux is built by the native backend, if the
  // machine has an assembler, unless `--backend c` or `--emit-c` asks for C.
  if status == 0 && !backend_set && !aarch64 && !emit_c && target == TARGET_HOSTED && b1_host_x86_64_elf(host) && b1_have_as(host) {
    native = true;
    native_ir = true;
  }
  if status == 0 && wasm {
    native = true;
    native_ir = true;
    if macos || windows || target != TARGET_HOSTED {
      w_s(&mut out, "bastioc1: --arch wasm32 builds hosted programs only\n");
      status = 2;
    }
  }
  if status == 0 && macos && !(native && (aarch64 || native_ir)) {
    w_s(&mut out, "bastioc1: --os macos needs --backend native (AArch64) or native-ir (x86-64)\n");
    status = 2;
  }
  if status == 0 && windows && !(native_ir && !aarch64) {
    w_s(&mut out, "bastioc1: --os windows needs --backend native-ir (x86-64)\n");
    status = 2;
  }
  if status == 0 && aarch64 && native_ir {
    w_s(&mut out, "bastioc1: --backend native-ir is for x86-64\n");
    status = 2;
  }
  // The inputs, as one string for messages.
  let mut input = vec_new[u64]();
  let mut k = 0;
  while k < vec_len(inputs) {
    if k > 0 {
      w_s(&mut input, " ");
    }
    let b = vec_swap(&mut inputs, k, balloc(0));
    b1_bytes(&mut input, b);
    bfree(vec_swap(&mut inputs, k, b));
    k = k + 1;
  }
  let mut p = parser_new(balloc(0), vec_new[Tok](), 0);
  let none = vec_new[u64]();
  k = 0;
  while status == 0 && k < vec_len(inputs) {
    let path = vec_swap(&mut inputs, k, balloc(0));
    let r = load(host, &mut p, &mut ld, path, 0, 0, 0, false);
    if r == 2 {
      w_s(&mut out, "bastioc1: cannot read ");
      b1_bytes(&mut out, path);
      w_s(&mut out, "\n");
      status = 2;
    } else if r != 0 {
      if p.ecode == CODE_IMPORT {
        b1_render(&mut out, p, ld, p.efile, p.eline, p.ecol, "E-IMPORT", p.emsg, none);
      } else {
        b1_render(&mut out, p, ld, p.efile, p.eline, p.ecol, "E-PARSE", p.emsg, p.enotes);
      }
      status = 1;
    }
    bfree(vec_swap(&mut inputs, k, path));
    k = k + 1;
  }
  if status == 0 {
    let mut m = mono_new();
    monomorphize(&mut m, p);
    if m.failed {
      b1_render(&mut out, p, ld, m.efile, m.eline, m.ecol, "E-TYPE", m.emsg, none);
      status = 1;
    } else {
      let mut c = checker_new(&mut m, p, target);
      if aarch64 {
        c.arch = ARCH_AARCH64;
      }
      check_program(&mut c, &mut m, p);
      if c.failed {
        b1_render(&mut out, p, ld, c.efile, c.eline, c.ecol, b1_code(c.ecode), c.emsg, c.enotes);
        status = 1;
      } else {
        let mut v = vr_new(&mut m, p);
        vr_set_arch(&mut v, c.arch);
        let mut rep = vec_new[u64]();
        let starts = solver_starts(host);
        // `--dump-smt` prints every query once all are proved, so it keeps
        // the whole log instead of proving in batches.
        let mut proved = false;
        if starts {
          if dump_smt {
            verify_program(&mut v, c, &mut m, p);
            proved = solve_par(&mut v, m, p, host, &mut rep, solve_jobs(host));
            if proved {
              put_log(con, v);
            }
          } else {
            proved = verify_batched(&mut v, c, &mut m, p, host, &mut rep, solve_jobs(host));
          }
        }
        if !starts {
          let mut msg = vec_new[u64]();
          w_s(&mut msg, "could not start the SMT solver `");
          solver_name(host, &mut msg);
          w_s(&mut msg, "` (install Z3 and put `z3` on PATH)");
          b1_render(&mut out, p, ld, 0, 0, 0, "E-SOLVER", msg, rep);
          vec_free(msg);
          status = 1;
        } else if !proved {
          let n = node_at(p.nodes, v.fail_at);
          let mut code = "E-SOLVER";
          if v.fail_code != 0 {
            code = vc_name(v.fail_code);
          }
          let mut msg = vec_new[u64]();
          fail_msg(v, &mut msg);
          b1_render(&mut out, p, ld, n.file, n.line, n.col, code, msg, rep);
          vec_free(msg);
          status = 1;
        } else {
          w_s(&mut out, "bastioc1: ");
          k = 0;
          while k < vec_len(input) {
            vec_push(&mut out, u_at(input, k));
            k = k + 1;
          }
          w_s(&mut out, ": ");
          w_num(&mut out, v.obligations);
          w_s(&mut out, " proof obligation(s) discharged\n");
        }
        vec_free(rep);
        vr_free(v);
        if status == 0 && !check_only && has_hdr {
          let guard = header_guard(hdr);
          let mut h = cg_new(target);
          h.arch = c.arch;
          header(&mut h, c, &mut m, p, guard);
          if !b1_write(host, hdr, h.out) {
            w_s(&mut out, "bastioc1: cannot write ");
            b1_bytes(&mut out, hdr);
            w_s(&mut out, "\n");
            status = 2;
          }
          cg_free(h);
          vec_free(guard);
        }
        if status == 0 && !check_only {
          // A program without `main` is a library: its C is linked into a
          // C program.
          let mut has_main = false;
          k = 0;
          while k < vec_len(m.fns) {
            let xi = inst_at(m, u_at(m.fns, k));
            if name_is(p, xi.def, "main") {
              has_main = true;
            }
            k = k + 1;
          }
          if !emit_c && !has_main && !native {
            w_s(&mut out, "bastioc1: ");
            k = 0;
            while k < vec_len(input) {
              vec_push(&mut out, u_at(input, k));
              k = k + 1;
            }
            w_s(&mut out, " is a library (it has no `main`): build it with --emit-c (or --backend native) and link the result into a program\n");
            status = 2;
          } else if native && windows && linkchoice == 2 && !emit_asm {
            w_s(&mut out, "bastioc1: --gnu-link does not apply to --os windows: the executable is written and linked by bastioc1's own PE writer (--emit-asm gives the assembly)\n");
            status = 2;
          } else if native {
            b1_flush(host, &mut out);
            status = b1_native(host, c, &mut m, p, target, aarch64, wasm, macos, windows, linkchoice, native_ir, emit_asm, !has_main, outp, has_out, &mut out);
          } else {
            let mut g = cg_new(target);
            g.arch = c.arch;
            cg_program(&mut g, c, &mut m, p);
            b1_flush(host, &mut out);
            if emit_c {
              if !has_out {
                bfree(outp);
                outp = bfrom("out.c");
              }
              if !b1_write(host, outp, g.out) {
                w_s(&mut out, "bastioc1: cannot write ");
                b1_bytes(&mut out, outp);
                w_s(&mut out, "\n");
                status = 2;
              }
            } else {
              if !has_out {
                bfree(outp);
                outp = bfrom("a.out");
              }
              let cfile = b1_concat(outp, ".c");
              if !b1_write(host, cfile, g.out) {
                w_s(&mut out, "bastioc1: cannot write ");
                b1_bytes(&mut out, cfile);
                w_s(&mut out, "\n");
                status = 2;
              } else {
                // The C compiler: `CC`, as for bastioc0, or `cc`
                // (`aarch64-linux-gnu-gcc` for --arch aarch64).
                let mut cc = balloc(0);
                if !host_env(host, "CC", &mut cc) {
                  bfree(cc);
                  if aarch64 {
                    cc = bfrom("aarch64-linux-gnu-gcc");
                  } else {
                    cc = bfrom("cc");
                  }
                }
                let mut argv = vec_new[Bytes]();
                vec_push(&mut argv, b1_concat(cc, ""));
                push_arg(&mut argv, "-O2");
                push_arg(&mut argv, "-std=c11");
                push_arg(&mut argv, "-w");
                push_arg(&mut argv, "-o");
                vec_push(&mut argv, b1_concat(outp, ""));
                vec_push(&mut argv, b1_concat(cfile, ""));
                let st = b1_run(host, argv);
                let mut rm = vec_new[Bytes]();
                push_arg(&mut rm, "rm");
                push_arg(&mut rm, "-f");
                vec_push(&mut rm, b1_concat(cfile, ""));
                b1_run(host, rm);
                if st == 127 {
                  w_s(&mut out, "bastioc1: cannot run `");
                  b1_bytes(&mut out, cc);
                  w_s(&mut out, "`\n");
                  status = 3;
                } else if st != 0 {
                  w_s(&mut out, "bastioc1: the C compiler failed (this is a compiler bug)\n");
                  status = 3;
                }
                bfree(cc);
              }
              bfree(cfile);
            }
            cg_free(g);
          }
        }
      }
      checker_free(c);
    }
    mono_free(m);
  }
  b1_flush(host, &mut out);
  vec_free(out);
  vec_free(input);
  vec_free(none);
  drop_argv(inputs);
  bfree(outp);
  bfree(hdr);
  loader_free(ld);
  bfree(parser_free(p));
  return status;
}
