// A linker and writer of macOS executables (Mach-O, x86-64, dynamically
// linked against libSystem) for the assembly `asmobj.bastio` assembles, the
// counterpart of `elf.bastio` and `pe.bastio`: the whole program is one
// object, so linking means giving each section an address, resolving every
// relocation against it, and turning the symbols the object does not define
// into imports from `/usr/lib/libSystem.B.dylib`.
//
// The image is not position independent and has a fixed base (4 GiB, behind
// the zero page). Each import gets one eight-byte slot that dyld fills in at
// start-up (a bind opcode in `LC_DYLD_INFO_ONLY`) and a six-byte
// `jmp *slot(%rip)` thunk in `__text` (a call to an import is a call to the
// thunk; `@GOTPCREL` is the slot). The entry point is `_main`, which dyld
// calls through `LC_MAIN`. An x86-64 executable needs no code signature.
//
// Part of the trusted base once the macOS build uses it instead of Apple's
// assembler and linker driver.
import "elf.bastio";
import "sha256.bastio";

const ML_BASE: u64 = 4294967296;
const ML_PAGE: u64 = 4096;
const ML_NCMDS: u64 = 11;
const ML_CMDS: u64 = 896;

fn ml_name(out: &mut Vec[u64], s: Str) {
  let at = vec_len(out);
  pe_put(&mut out, s);
  pe_pad_to(&mut out, wrap_add(at, 16));
}

fn ml_uleb(out: &mut Vec[u64], x0: u64) {
  let mut x = x0;
  let mut more = true;
  while more {
    let b = x & 127;
    x = x / 128;
    if x > 0 {
      as_byte(&mut out, b | 128);
    } else {
      as_byte(&mut out, b);
      more = false;
    }
  }
}

fn ml_seg(out: &mut Vec[u64], name: Str, vmaddr: u64, vmsize: u64, fileoff: u64, filesize: u64, prot: u64, nsects: u64) {
  as_le(&mut out, 25, 4);
  as_le(&mut out, wrap_add(72, wrap_mul(80, nsects)), 4);
  ml_name(&mut out, name);
  as_le(&mut out, vmaddr, 8);
  as_le(&mut out, vmsize, 8);
  as_le(&mut out, fileoff, 8);
  as_le(&mut out, filesize, 8);
  as_le(&mut out, prot, 4);
  as_le(&mut out, prot, 4);
  as_le(&mut out, nsects, 4);
  as_le(&mut out, 0, 4);
}

fn ml_sect(out: &mut Vec[u64], name: Str, seg: Str, addr: u64, size: u64, off: u64, align: u64, flags: u64) {
  ml_name(&mut out, name);
  ml_name(&mut out, seg);
  as_le(&mut out, addr, 8);
  as_le(&mut out, size, 8);
  as_le(&mut out, off, 4);
  as_le(&mut out, align, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, flags, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, 0, 4);
}

/// Links the assembled program `g` (laid out by `ao_layout`) into a macOS
/// executable, x86-64 or (`arm`) arm64; the bytes of the file, or an empty
/// vector when something is undefined that cannot be an import.
fn ml_be(out: &mut Vec[u64], x: u64, n: u64) {
  if n > 8 {
    return;
  }
  let mut k = n;
  while k > 0
    invariant k <= 8
  {
    k = wrap_sub(k, 1);
    as_byte(&mut out, (x >> wrap_mul(k, 8)) & 255);
  }
}

/// Appends the ad-hoc code signature of the first `sig_off` bytes of `out`:
/// a SuperBlob holding one CodeDirectory, which has a SHA-256 for each page
/// of 4096 bytes. `seg` is the size of the executable segment.
fn ml_sign(out: &mut Vec[u64], sig_off: u64, nslots: u64, sig_len: u64, seg: u64) {
  let cd = wrap_sub(sig_len, 20);
  let ident = "a.out";
  ml_be(&mut out, 4208856256, 4);
  ml_be(&mut out, sig_len, 4);
  ml_be(&mut out, 1, 4);
  ml_be(&mut out, 0, 4);
  ml_be(&mut out, 20, 4);
  // the CodeDirectory
  ml_be(&mut out, 4208856066, 4);
  ml_be(&mut out, cd, 4);
  ml_be(&mut out, 132096, 4);
  ml_be(&mut out, 131074, 4);
  ml_be(&mut out, 94, 4);
  ml_be(&mut out, 88, 4);
  ml_be(&mut out, 0, 4);
  ml_be(&mut out, nslots, 4);
  ml_be(&mut out, sig_off, 4);
  as_byte(&mut out, 32);
  as_byte(&mut out, 2);
  as_byte(&mut out, 0);
  as_byte(&mut out, 12);
  ml_be(&mut out, 0, 4);
  ml_be(&mut out, 0, 4);
  ml_be(&mut out, 0, 4);
  ml_be(&mut out, 0, 4);
  ml_be(&mut out, 0, 8);
  ml_be(&mut out, 0, 8);
  ml_be(&mut out, seg, 8);
  ml_be(&mut out, 1, 8);
  pe_put(&mut out, ident);
  as_byte(&mut out, 0);
  let mut digest = vec_new[u64]();
  let mut p = 0;
  while p < nslots {
    let start = wrap_mul(p, 4096);
    let mut len = wrap_sub(sig_off, start);
    if len > 4096 {
      len = 4096;
    }
    sha256(out, start, len, &mut digest);
    p = wrap_add(p, 1);
  }
  let dl = vec_len(digest);
  let mut k = 0;
  while k < dl {
    as_byte(&mut out, u_at(digest, k));
    k = wrap_add(k, 1);
  }
  vec_free(digest);
}

fn ml_link(g: &mut AsObj, arm: bool) -> Vec[u64] {
  let mut page = ML_PAGE;
  let mut tsz = 8;
  let mut cmds = ML_CMDS;
  let mut ncmds = ML_NCMDS;
  if arm {
    page = 16384;
    tsz = 16;
    cmds = wrap_add(ML_CMDS, 16);
    ncmds = wrap_add(ML_NCMDS, 1);
  }
  let mut rel = vec_new[u64]();
  let mut text = ao_emit(g, AB_TEXT, &mut rel);
  let mut ro = ao_emit(g, AB_RODATA, &mut rel);
  let mut data = ao_emit(g, AB_DATA, &mut rel);
  let bss0 = ao_sec_size(g, AB_BSS);
  // common symbols get their room at the end of .bss
  let nsym = ao_nsyms(g);
  let mut bss = pe_align(bss0, 16);
  let mut cs = 0;
  let mut comm = vec_new[u64]();
  while cs < nsym {
    if (ao_sym(g, cs, 4) & 2) != 0 {
      vec_push(&mut comm, cs);
      vec_push(&mut comm, bss);
      bss = pe_align(wrap_add(bss, ao_sym(g, cs, 5)), 16);
    }
    cs = wrap_add(cs, 1);
  }
  // the imports: the undefined symbols the relocations name
  let mut imports = vec_new[u64]();
  let mut r = 0;
  while wrap_add(r, 5) <= vec_len(rel) {
    let sym = u_at(rel, wrap_add(r, 3));
    if ao_sym(g, sym, 2) == AS_NONE && (ao_sym(g, sym, 4) & 2) == 0 && !has_id(imports, sym) {
      vec_push(&mut imports, sym);
    }
    r = wrap_add(r, 5);
  }
  let nimp = vec_len(imports);
  // the read-only and executable segment: the headers, .text and its thunks, .rodata
  let text_off = pe_align(wrap_add(32, cmds), 16);
  let tstart = pe_align(vec_len(text), 16);
  let ttotal = wrap_add(tstart, wrap_mul(nimp, tsz));
  let ro_off = pe_align(wrap_add(text_off, ttotal), 16);
  let ro_len = vec_len(ro);
  let text_end = wrap_add(ro_off, ro_len);
  let tseg = pe_align(text_end, page);
  // the writable segment: .data, the import slots, then .bss
  let data_off = tseg;
  let data_len = vec_len(data);
  let got_off = wrap_add(data_off, pe_align(data_len, 8));
  let data_end = wrap_add(got_off, wrap_mul(nimp, 8));
  let dseg = pe_align(wrap_sub(data_end, data_off), page);
  let bss_off = wrap_add(data_off, dseg);
  let dvm = wrap_add(dseg, pe_align(bss, page));
  // the link-edit segment: the bind opcodes and an empty symbol table
  let le_off = wrap_add(data_off, dseg);
  let le_vm = wrap_add(data_off, dvm);
  let mut bind = vec_new[u64]();
  let mut k = 0;
  while k < nimp {
    let id = u_at(imports, k);
    as_byte(&mut bind, 17);
    as_byte(&mut bind, 64);
    let ns = ao_sym(g, id, 0);
    let mut c = 0;
    while c < ao_sym(g, id, 1) {
      as_byte(&mut bind, u_at(g.names, wrap_add(ns, c)));
      c = wrap_add(c, 1);
    }
    as_byte(&mut bind, 0);
    as_byte(&mut bind, 81);
    as_byte(&mut bind, 114);
    ml_uleb(&mut bind, wrap_add(wrap_sub(got_off, data_off), wrap_mul(k, 8)));
    as_byte(&mut bind, 144);
    k = wrap_add(k, 1);
  }
  as_byte(&mut bind, 0);
  let bind_len = vec_len(bind);
  let bind_size = pe_align(bind_len, 8);
  // arm64: the ad-hoc code signature closes the segment, 16-byte aligned,
  // one SHA-256 for each 4096 bytes of the file before it
  let sig_off = pe_align(wrap_add(le_off, wrap_add(bind_size, 8)), 16);
  let nslots = wrap_add(sig_off, 4095) / 4096;
  let mut sig_len = 0;
  let mut le_size = wrap_add(bind_size, 8);
  if arm {
    sig_len = wrap_add(114, wrap_mul(32, nslots));
    le_size = wrap_add(wrap_sub(sig_off, le_off), sig_len);
  }
  // the address of every symbol, for the relocations
  let mut bad = false;
  r = 0;
  while wrap_add(r, 5) <= vec_len(rel) {
    let sec = u_at(rel, r);
    let at = u_at(rel, wrap_add(r, 1));
    let kind = u_at(rel, wrap_add(r, 2));
    let sym = u_at(rel, wrap_add(r, 3));
    let addend = u_at(rel, wrap_add(r, 4));
    let mut target = 0;
    let ssec = ao_sym(g, sym, 2);
    if ssec == AS_NONE && (ao_sym(g, sym, 4) & 2) != 0 {
      let mut q = 0;
      while wrap_add(q, 2) <= vec_len(comm) {
        if u_at(comm, q) == sym {
          target = wrap_add(ML_BASE, wrap_add(bss_off, u_at(comm, wrap_add(q, 1))));
        }
        q = wrap_add(q, 2);
      }
      if elf_is_got(kind, arm) {
        bad = true;
      }
    } else if ssec == AS_NONE {
      let mut q = 0;
      while q < nimp {
        if u_at(imports, q) == sym {
          if elf_is_got(kind, arm) {
            target = wrap_add(ML_BASE, wrap_add(got_off, wrap_mul(q, 8)));
          } else if elf_is_call(kind, arm) {
            target = wrap_add(ML_BASE, wrap_add(text_off, wrap_add(tstart, wrap_mul(q, tsz))));
          } else {
            bad = true;
          }
        }
        q = wrap_add(q, 1);
      }
    } else {
      let off = ao_sym_off(g, sym);
      if ssec == AB_TEXT {
        target = wrap_add(ML_BASE, wrap_add(text_off, off));
      } else if ssec == AB_RODATA {
        target = wrap_add(ML_BASE, wrap_add(ro_off, off));
      } else if ssec == AB_DATA {
        target = wrap_add(ML_BASE, wrap_add(data_off, off));
      } else {
        target = wrap_add(ML_BASE, wrap_add(bss_off, off));
      }
      if elf_is_got(kind, arm) {
        bad = true;
      }
    }
    let mut base = wrap_add(ML_BASE, text_off);
    if sec == AB_RODATA {
      base = wrap_add(ML_BASE, ro_off);
    } else if sec == AB_DATA {
      base = wrap_add(ML_BASE, data_off);
    }
    let value = wrap_sub(wrap_add(target, addend), wrap_add(base, at));
    if arm {
      let sa = wrap_add(target, addend);
      let place = wrap_add(base, at);
      if sec == AB_TEXT {
        if !elf_a64_apply(&mut text, at, kind, sa, place) { bad = true; }
      } else if sec == AB_RODATA {
        if !elf_a64_apply(&mut ro, at, kind, sa, place) { bad = true; }
      } else if sec == AB_DATA {
        if !elf_a64_apply(&mut data, at, kind, sa, place) { bad = true; }
      } else {
        bad = true;
      }
    } else if sec == AB_TEXT {
      pe_patch(&mut text, at, value, 4);
    } else if sec == AB_RODATA {
      pe_patch(&mut ro, at, value, 4);
    } else if sec == AB_DATA {
      pe_patch(&mut data, at, value, 4);
    } else {
      bad = true;
    }
    if target == 0 {
      bad = true;
    }
    r = wrap_add(r, 5);
  }
  // the entry point
  let entry = pe_find(g, "_main");
  if entry == AS_NONE || ao_sym(g, entry, 2) != AB_TEXT {
    bad = true;
  }
  let mut out = vec_new[u64]();
  if bad {
    vec_free(text);
    vec_free(ro);
    vec_free(data);
    vec_free(rel);
    vec_free(imports);
    vec_free(comm);
    vec_free(bind);
    return out;
  }
  // the thunks
  pe_pad_to(&mut text, tstart);
  k = 0;
  while k < nimp {
    let slot = wrap_add(ML_BASE, wrap_add(got_off, wrap_mul(k, 8)));
    let here = wrap_add(ML_BASE, wrap_add(text_off, wrap_add(tstart, wrap_mul(k, tsz))));
    if arm {
      elf_a64_stub(&mut text, tstart, k, slot, here);
    } else {
      as_byte(&mut text, 255);
      as_byte(&mut text, 37);
      as_le(&mut text, wrap_sub(slot, wrap_add(here, 6)), 4);
      as_byte(&mut text, 204);
      as_byte(&mut text, 204);
    }
    k = wrap_add(k, 1);
  }
  // the header
  as_le(&mut out, 4277009103, 4);
  if arm {
    as_le(&mut out, 16777228, 4);
    as_le(&mut out, 0, 4);
  } else {
    as_le(&mut out, 16777223, 4);
    as_le(&mut out, 3, 4);
  }
  as_le(&mut out, 2, 4);
  as_le(&mut out, ncmds, 4);
  as_le(&mut out, cmds, 4);
  if arm {
    as_le(&mut out, 2097285, 4);
  } else {
    as_le(&mut out, 133, 4);
  }
  as_le(&mut out, 0, 4);
  // the load commands
  ml_seg(&mut out, "__PAGEZERO", 0, ML_BASE, 0, 0, 0, 0);
  ml_seg(&mut out, "__TEXT", ML_BASE, tseg, 0, tseg, 5, 2);
  ml_sect(&mut out, "__text", "__TEXT", wrap_add(ML_BASE, text_off), ttotal, text_off, 4, 2147484672);
  ml_sect(&mut out, "__const", "__TEXT", wrap_add(ML_BASE, ro_off), ro_len, ro_off, 4, 0);
  ml_seg(&mut out, "__DATA", wrap_add(ML_BASE, data_off), dvm, data_off, dseg, 3, 2);
  ml_sect(&mut out, "__data", "__DATA", wrap_add(ML_BASE, data_off), wrap_sub(data_end, data_off), data_off, 4, 0);
  ml_sect(&mut out, "__bss", "__DATA", wrap_add(ML_BASE, bss_off), bss, 0, 4, 1);
  ml_seg(&mut out, "__LINKEDIT", wrap_add(ML_BASE, le_vm), pe_align(le_size, page), le_off, le_size, 1, 0);
  // LC_DYLD_INFO_ONLY: no rebases, the binds, no lazy binds and no exports
  as_le(&mut out, 2147483682, 4);
  as_le(&mut out, 48, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, le_off, 4);
  as_le(&mut out, bind_len, 4);
  k = 0;
  while k < 6 {
    as_le(&mut out, 0, 4);
    k = wrap_add(k, 1);
  }
  // LC_SYMTAB: no symbols, a string table of eight bytes
  as_le(&mut out, 2, 4);
  as_le(&mut out, 24, 4);
  as_le(&mut out, wrap_add(le_off, bind_size), 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, wrap_add(le_off, bind_size), 4);
  as_le(&mut out, 8, 4);
  // LC_DYSYMTAB: all zero
  as_le(&mut out, 11, 4);
  as_le(&mut out, 80, 4);
  k = 0;
  while k < 18 {
    as_le(&mut out, 0, 4);
    k = wrap_add(k, 1);
  }
  // LC_LOAD_DYLINKER
  as_le(&mut out, 14, 4);
  as_le(&mut out, 32, 4);
  as_le(&mut out, 12, 4);
  pe_put(&mut out, "/usr/lib/dyld");
  pe_pad_to(&mut out, pe_align(vec_len(out), 8));
  // LC_MAIN
  as_le(&mut out, 2147483688, 4);
  as_le(&mut out, 24, 4);
  as_le(&mut out, wrap_add(text_off, ao_sym_off(g, entry)), 8);
  as_le(&mut out, 0, 8);
  // LC_LOAD_DYLIB: libSystem
  as_le(&mut out, 12, 4);
  as_le(&mut out, 56, 4);
  as_le(&mut out, 24, 4);
  as_le(&mut out, 2, 4);
  as_le(&mut out, 84082688, 4);
  as_le(&mut out, 65536, 4);
  pe_put(&mut out, "/usr/lib/libSystem.B.dylib");
  pe_pad_to(&mut out, pe_align(vec_len(out), 8));
  // LC_BUILD_VERSION: macOS 10.15 (11.0 on arm64), no tools
  as_le(&mut out, 50, 4);
  as_le(&mut out, 24, 4);
  as_le(&mut out, 1, 4);
  if arm {
    as_le(&mut out, 720896, 4);
    as_le(&mut out, 720896, 4);
  } else {
    as_le(&mut out, 659200, 4);
    as_le(&mut out, 659200, 4);
  }
  as_le(&mut out, 0, 4);
  if arm {
    // LC_CODE_SIGNATURE
    as_le(&mut out, 29, 4);
    as_le(&mut out, 16, 4);
    as_le(&mut out, sig_off, 4);
    as_le(&mut out, sig_len, 4);
  }
  if vec_len(out) != wrap_add(32, cmds) {
    vec_free(text);
    vec_free(ro);
    vec_free(data);
    vec_free(rel);
    vec_free(imports);
    vec_free(comm);
    vec_free(bind);
    vec_free(out);
    return vec_new[u64]();
  }
  let text_len = vec_len(text);
  pe_pad_to(&mut out, text_off);
  pe_append(&mut out, text, text_len);
  pe_pad_to(&mut out, ro_off);
  pe_append(&mut out, ro, ro_len);
  pe_pad_to(&mut out, data_off);
  pe_append(&mut out, data, data_len);
  pe_pad_to(&mut out, data_end);
  pe_pad_to(&mut out, le_off);
  pe_append(&mut out, bind, bind_len);
  if arm {
    pe_pad_to(&mut out, sig_off);
    ml_sign(&mut out, sig_off, nslots, sig_len, tseg);
  }
  pe_pad_to(&mut out, wrap_add(le_off, le_size));
  vec_free(rel);
  vec_free(imports);
  vec_free(comm);
  return out;
}

/// Links the program into the macOS executable at `outp`: arm64 when `arm`
/// (the text is the AArch64 assembly), x86-64 otherwise.
fn ml_build(host: &Host, outp: &Bytes, data: &Bytes, arm: bool) -> u64 {
  let mut g = pe_feed(data, "", arm);
  if g.errs > 0 {
    ao_free(g);
    return 3;
  }
  ao_layout(&mut g);
  let image = ml_link(&mut g, arm);
  ao_free(g);
  if vec_len(image) == 0 {
    vec_free(image);
    return 4;
  }
  return pe_write(host, outp, image);
}

/// One section header of an object file: like `ml_sect`, with the place of
/// its relocations.
fn mo_sect(out: &mut Vec[u64], name: Str, seg: Str, addr: u64, size: u64, off: u64, reloff: u64, nreloc: u64, flags: u64) {
  ml_name(&mut out, name);
  ml_name(&mut out, seg);
  as_le(&mut out, addr, 8);
  as_le(&mut out, size, 8);
  as_le(&mut out, off, 4);
  as_le(&mut out, 4, 4);
  as_le(&mut out, reloff, 4);
  as_le(&mut out, nreloc, 4);
  as_le(&mut out, flags, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, 0, 4);
}

/// One `relocation_info`: the field at `at` refers to symbol `sym` (always
/// by its symbol table index: `r_extern` is 1).
fn mo_reloc(v: &mut Vec[u64], at: u64, sym: u64, pcrel: u64, kind: u64) {
  as_le(&mut v, at, 4);
  as_le(&mut v, (sym & 16777215) | ((pcrel & 1) << 24) | (2 << 25) | (1 << 27) | ((kind & 15) << 28), 4);
}

/// `ARM64_RELOC_ADDEND`: the constant `addend` for the relocation after it.
fn mo_addend(v: &mut Vec[u64], at: u64, addend: u64) {
  as_le(&mut v, at, 4);
  as_le(&mut v, (addend & 16777215) | (2 << 25) | (10 << 28), 4);
}

/// The index of `id` in the symbols written: the local ones, then the
/// defined global ones, then the undefined ones. AS_NONE when it is in none.
fn mo_symidx(gl: &Vec[u64], ge: &Vec[u64], gu: &Vec[u64], id: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(gl) {
    if u_at(gl, k) == id {
      return k;
    }
    k = wrap_add(k, 1);
  }
  k = 0;
  while k < vec_len(ge) {
    if u_at(ge, k) == id {
      return wrap_add(vec_len(gl), k);
    }
    k = wrap_add(k, 1);
  }
  k = 0;
  while k < vec_len(gu) {
    if u_at(gu, k) == id {
      return wrap_add(wrap_add(vec_len(gl), vec_len(ge)), k);
    }
    k = wrap_add(k, 1);
  }
  return AS_NONE;
}

/// The relocations `v` (8 bytes each; an `ARM64_RELOC_ADDEND` comes before the
/// relocation it belongs to) in the order Apple's tools write them: by
/// descending address.
fn mo_rev(v: Vec[u64]) -> Vec[u64] {
  let mut out = vec_new[u64]();
  let mut k = vec_len(v) / 8;
  while k > 0 {
    let mut take = 1;
    if k >= 2 && (u_at(v, wrap_sub(wrap_mul(k, 8), 9)) >> 4) == 10 {
      take = 2;
    }
    let first = wrap_sub(k, take);
    let mut b = wrap_mul(first, 8);
    while b < wrap_mul(k, 8) {
      as_byte(&mut out, u_at(v, b));
      b = wrap_add(b, 1);
    }
    k = first;
  }
  vec_free(v);
  return out;
}

/// How many bytes follow the four-byte field at `at` of section `sec` in its
/// instruction (an immediate after a `rip`-relative operand), from `tr`, the
/// (section, field offset, bytes after) of every relocated instruction; `cur`
/// is the position reached so far in each section (relocations come in the
/// order of their instructions).
fn mo_trail(tr: &Vec[u64], cur: &mut Vec[u64], sec: u64, at: u64) -> u64 {
  let mut c = u_at(cur, sec);
  while wrap_add(c, 3) <= vec_len(tr) && (u_at(tr, c) != sec || u_at(tr, wrap_add(c, 1)) < at) {
    c = wrap_add(c, 3);
  }
  ao_set(&mut cur, sec, c);
  if wrap_add(c, 3) <= vec_len(tr) && u_at(tr, c) == sec && u_at(tr, wrap_add(c, 1)) == at {
    return u_at(tr, wrap_add(c, 2));
  }
  return 0;
}

/// Adds symbol `s` to the list it belongs to, if it is in none.
fn mo_addsym(g: &AsObj, gl: &mut Vec[u64], ge: &mut Vec[u64], gu: &mut Vec[u64], s: u64) {
  if has_id(gl, s) || has_id(ge, s) || has_id(gu, s) {
    return;
  }
  let ssec = ao_sym(g, s, 2);
  if ssec == AS_NONE {
    vec_push(&mut gu, s);
  } else if (ao_sym(g, s, 4) & 1) != 0 {
    vec_push(&mut ge, s);
  } else {
    vec_push(&mut gl, s);
  }
}

/// Is the AArch64 relocation `kind` one that Mach-O has no type for (the
/// 14-bit and 19-bit branches)?
fn mo_inline(kind: u64) -> bool {
  return kind == 279 || kind == 280;
}

/// The assembled program `g` (laid out by `ao_layout`) as a Mach-O object
/// file, the file Apple's `as` would write: `__text`, `__const`, `__data`
/// and `__bss` in one segment, the relocations a linker still has to apply
/// (always against a symbol: the local ones are written too), and the
/// symbols. Empty when a relocation cannot be written.
fn mo_rel(g: &mut AsObj, arm: bool) -> Vec[u64] {
  let mut rel = vec_new[u64]();
  let mut text = ao_emit(g, AB_TEXT, &mut rel);
  let mut ro = ao_emit(g, AB_RODATA, &mut rel);
  let mut data = ao_emit(g, AB_DATA, &mut rel);
  let bss = ao_sec_size(g, AB_BSS);
  let nsym = ao_nsyms(g);
  // the symbols: the ones a relocation uses, and the global ones
  let mut gl = vec_new[u64]();
  let mut ge = vec_new[u64]();
  let mut gu = vec_new[u64]();
  let mut r = 0;
  while wrap_add(r, 5) <= vec_len(rel) {
    let s = u_at(rel, wrap_add(r, 3));
    if s < nsym && !(arm && mo_inline(u_at(rel, wrap_add(r, 2)))) {
      mo_addsym(g, &mut gl, &mut ge, &mut gu, s);
    }
    r = wrap_add(r, 5);
  }
  let mut id = 0;
  while id < nsym {
    if (ao_sym(g, id, 4) & 3) != 0 && ao_sym(g, id, 1) > 0 {
      mo_addsym(g, &mut gl, &mut ge, &mut gu, id);
    }
    id = wrap_add(id, 1);
  }
  // where the instructions with a relocation end
  let mut tr = vec_new[u64]();
  let nitems = ao_nitems(g);
  let mut i = 0;
  while i < nitems {
    if ao_item(g, i, 0) == AB_RELOC {
      let o = ao_item(g, i, 7);
      let off = ao_item(g, i, 5) & 4294967295;
      vec_push(&mut tr, ao_item(g, i, 1));
      vec_push(&mut tr, wrap_add(o, off));
      vec_push(&mut tr, wrap_sub(wrap_sub(ao_size(g, i, o), off), 4));
    }
    i = wrap_add(i, 1);
  }
  let mut cur = vec_new[u64]();
  vec_push(&mut cur, 0);
  vec_push(&mut cur, 0);
  vec_push(&mut cur, 0);
  vec_push(&mut cur, 0);
  // the relocations by section, ascending; each entry is 8 bytes, or 16 with
  // an addend in front
  let mut rt = vec_new[u64]();
  let mut rr = vec_new[u64]();
  let mut rd = vec_new[u64]();
  let mut bad = false;
  r = 0;
  while wrap_add(r, 5) <= vec_len(rel) {
    let sec = u_at(rel, r);
    let at = u_at(rel, wrap_add(r, 1));
    let kind = u_at(rel, wrap_add(r, 2));
    let s = u_at(rel, wrap_add(r, 3));
    let addend = u_at(rel, wrap_add(r, 4));
    let si = mo_symidx(gl, ge, gu, s);
    let mut part = vec_new[u64]();
    if arm && mo_inline(kind) {
      // a conditional branch has no relocation in Mach-O: the target must be
      // in the same section, and the distance is written here
      if ao_sym(g, s, 2) != sec || sec != AB_TEXT || !elf_a64_apply(&mut text, at, kind, wrap_add(ao_sym_off(g, s), addend), at) {
        bad = true;
      }
    } else if si == AS_NONE || sec > AB_DATA {
      bad = true;
    } else if arm {
      let mut ty = 99;
      let mut pcrel = 0;
      if kind == 275 {
        ty = 3;
        pcrel = 1;
      } else if kind == 277 || kind == 278 || kind == 284 || kind == 285 || kind == 286 {
        ty = 4;
      } else if kind == 282 || kind == 283 {
        ty = 2;
        pcrel = 1;
      } else if kind == 311 {
        ty = 5;
        pcrel = 1;
      } else if kind == 312 {
        ty = 6;
      } else {
        bad = true;
      }
      if addend != 0 {
        if ty == 5 || ty == 6 || !as_fits(addend, 24) {
          bad = true;
        }
        mo_addend(&mut part, at, addend);
      }
      mo_reloc(&mut part, at, si, pcrel, ty);
    } else {
      // x86-64: the field holds the ELF addend plus the four bytes of the
      // field (the linker measures from its end); an immediate after the
      // field only changes the type, which tells the linker how far the
      // instruction goes on
      let n = mo_trail(tr, &mut cur, sec, at);
      let k = wrap_add(addend, 4);
      let mut ty = 1;
      if kind == AR_PLT32 {
        ty = 2;
      } else if kind == AR_GOT32 {
        ty = 3;
      } else if kind != AR_PC32 {
        bad = true;
      } else if n == 1 {
        ty = 6;
      } else if n == 2 {
        ty = 7;
      } else if n == 4 {
        ty = 8;
      } else if n != 0 {
        bad = true;
      }
      if (ty == 2 || ty == 3) && k != 0 {
        bad = true;
      }
      if sec == AB_TEXT {
        pe_patch(&mut text, at, k, 4);
      } else if sec == AB_RODATA {
        pe_patch(&mut ro, at, k, 4);
      } else {
        pe_patch(&mut data, at, k, 4);
      }
      mo_reloc(&mut part, at, si, 1, ty);
    }
    let plen = vec_len(part);
    if sec == AB_TEXT {
      pe_append(&mut rt, part, plen);
    } else if sec == AB_RODATA {
      pe_append(&mut rr, part, plen);
    } else {
      pe_append(&mut rd, part, plen);
    }
    r = wrap_add(r, 5);
  }
  vec_free(rel);
  vec_free(tr);
  vec_free(cur);
  rt = mo_rev(rt);
  rr = mo_rev(rr);
  rd = mo_rev(rd);
  // the symbol table and its names
  let a_ro = pe_align(vec_len(text), 16);
  let a_data = pe_align(wrap_add(a_ro, vec_len(ro)), 16);
  let a_bss = pe_align(wrap_add(a_data, vec_len(data)), 16);
  let nl = vec_len(gl);
  let ne = vec_len(ge);
  let nu = vec_len(gu);
  let mut strtab = vec_new[u64]();
  as_byte(&mut strtab, 0);
  let mut symtab = vec_new[u64]();
  let mut k = 0;
  while k < wrap_add(wrap_add(nl, ne), nu) {
    let mut s = 0;
    if k < nl {
      s = u_at(gl, k);
    } else if k < wrap_add(nl, ne) {
      s = u_at(ge, wrap_sub(k, nl));
    } else {
      s = u_at(gu, wrap_sub(wrap_sub(k, nl), ne));
    }
    as_le(&mut symtab, vec_len(strtab), 4);
    let nstart = ao_sym(g, s, 0);
    let nlen = ao_sym(g, s, 1);
    let mut c = 0;
    while c < nlen {
      as_byte(&mut strtab, u_at(g.names, wrap_add(nstart, c)));
      c = wrap_add(c, 1);
    }
    as_byte(&mut strtab, 0);
    let ssec = ao_sym(g, s, 2);
    if ssec == AS_NONE && (ao_sym(g, s, 4) & 2) != 0 {
      // a common symbol: its size, and 2^4 for the alignment
      as_byte(&mut symtab, 1);
      as_byte(&mut symtab, 0);
      as_le(&mut symtab, 1024, 2);
      as_le(&mut symtab, ao_sym(g, s, 5), 8);
    } else if ssec == AS_NONE {
      as_byte(&mut symtab, 1);
      as_byte(&mut symtab, 0);
      as_le(&mut symtab, 0, 2);
      as_le(&mut symtab, 0, 8);
    } else if ssec <= AB_BSS {
      let mut ty = 14;
      if (ao_sym(g, s, 4) & 1) != 0 {
        ty = 15;
      }
      let mut base = 0;
      if ssec == AB_RODATA {
        base = a_ro;
      } else if ssec == AB_DATA {
        base = a_data;
      } else if ssec == AB_BSS {
        base = a_bss;
      }
      as_byte(&mut symtab, ty);
      as_byte(&mut symtab, wrap_add(ssec, 1));
      as_le(&mut symtab, 0, 2);
      as_le(&mut symtab, wrap_add(base, ao_sym_off(g, s)), 8);
    } else {
      bad = true;
      as_le(&mut symtab, 0, 12);
    }
    k = wrap_add(k, 1);
  }
  pe_pad_to(&mut strtab, pe_align(vec_len(strtab), 8));
  // the file: the header, four sections, the relocations, the symbols
  let ncmds = 4;
  let cmds = 520;
  let off_text = pe_align(wrap_add(32, cmds), 16);
  let off_ro = wrap_add(off_text, a_ro);
  let off_data = wrap_add(off_text, a_data);
  let off_rel = pe_align(wrap_add(off_data, vec_len(data)), 8);
  let off_rr = wrap_add(off_rel, vec_len(rt));
  let off_rd = wrap_add(off_rr, vec_len(rr));
  let off_sym = pe_align(wrap_add(off_rd, vec_len(rd)), 8);
  let off_str = wrap_add(off_sym, vec_len(symtab));
  let mut out = vec_new[u64]();
  if !bad {
    as_le(&mut out, 4277009103, 4);
    if arm {
      as_le(&mut out, 16777228, 4);
      as_le(&mut out, 0, 4);
    } else {
      as_le(&mut out, 16777223, 4);
      as_le(&mut out, 3, 4);
    }
    as_le(&mut out, 1, 4);
    as_le(&mut out, ncmds, 4);
    as_le(&mut out, cmds, 4);
    as_le(&mut out, 0, 4);
    as_le(&mut out, 0, 4);
    // the one segment, without a name
    ml_seg(&mut out, "", 0, wrap_add(a_bss, bss), off_text, wrap_add(a_data, vec_len(data)), 7, 4);
    mo_sect(&mut out, "__text", "__TEXT", 0, vec_len(text), off_text, off_rel, vec_len(rt) / 8, 2147484672);
    mo_sect(&mut out, "__const", "__TEXT", a_ro, vec_len(ro), off_ro, off_rr, vec_len(rr) / 8, 0);
    mo_sect(&mut out, "__data", "__DATA", a_data, vec_len(data), off_data, off_rd, vec_len(rd) / 8, 0);
    mo_sect(&mut out, "__bss", "__DATA", a_bss, bss, 0, 0, 0, 1);
    // LC_SYMTAB
    as_le(&mut out, 2, 4);
    as_le(&mut out, 24, 4);
    as_le(&mut out, off_sym, 4);
    as_le(&mut out, wrap_add(wrap_add(nl, ne), nu), 4);
    as_le(&mut out, off_str, 4);
    as_le(&mut out, vec_len(strtab), 4);
    // LC_DYSYMTAB: the local, defined global and undefined symbols
    as_le(&mut out, 11, 4);
    as_le(&mut out, 80, 4);
    as_le(&mut out, 0, 4);
    as_le(&mut out, nl, 4);
    as_le(&mut out, nl, 4);
    as_le(&mut out, ne, 4);
    as_le(&mut out, wrap_add(nl, ne), 4);
    as_le(&mut out, nu, 4);
    k = 0;
    while k < 12 {
      as_le(&mut out, 0, 4);
      k = wrap_add(k, 1);
    }
    // LC_BUILD_VERSION: macOS 10.15 (11.0 on arm64), no tools
    as_le(&mut out, 50, 4);
    as_le(&mut out, 24, 4);
    as_le(&mut out, 1, 4);
    if arm {
      as_le(&mut out, 720896, 4);
      as_le(&mut out, 720896, 4);
    } else {
      as_le(&mut out, 659200, 4);
      as_le(&mut out, 659200, 4);
    }
    as_le(&mut out, 0, 4);
    if vec_len(out) != wrap_add(32, cmds) {
      bad = true;
    }
  }
  if bad {
    vec_free(out);
    out = vec_new[u64]();
  } else {
    let n_text = vec_len(text);
    let n_ro = vec_len(ro);
    let n_data = vec_len(data);
    let n_rt = vec_len(rt);
    let n_rr = vec_len(rr);
    let n_rd = vec_len(rd);
    let n_sym = vec_len(symtab);
    let n_str = vec_len(strtab);
    pe_pad_to(&mut out, off_text);
    pe_append(&mut out, text, n_text);
    pe_pad_to(&mut out, off_ro);
    pe_append(&mut out, ro, n_ro);
    pe_pad_to(&mut out, off_data);
    pe_append(&mut out, data, n_data);
    pe_pad_to(&mut out, off_rel);
    pe_append(&mut out, rt, n_rt);
    pe_append(&mut out, rr, n_rr);
    pe_append(&mut out, rd, n_rd);
    pe_pad_to(&mut out, off_sym);
    pe_append(&mut out, symtab, n_sym);
    pe_append(&mut out, strtab, n_str);
    vec_free(gl);
    vec_free(ge);
    vec_free(gu);
    return out;
  }
  vec_free(text);
  vec_free(ro);
  vec_free(data);
  vec_free(rt);
  vec_free(rr);
  vec_free(rd);
  vec_free(symtab);
  vec_free(strtab);
  vec_free(gl);
  vec_free(ge);
  vec_free(gu);
  return out;
}

/// Writes the program's assembly as the Mach-O object at `outp`.
fn mo_build(host: &Host, outp: &Bytes, data: &Bytes, arm: bool) -> u64 {
  let mut g = pe_feed(data, "", arm);
  if g.errs > 0 {
    ao_free(g);
    return 3;
  }
  ao_layout(&mut g);
  let image = mo_rel(&mut g, arm);
  ao_free(g);
  if vec_len(image) == 0 {
    vec_free(image);
    return 4;
  }
  return pe_write(host, outp, image);
}
