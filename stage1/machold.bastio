// A linker and writer of macOS executables (Mach-O, x86-64, dynamically
// linked against libSystem) for the assembly `asmobj.bastio` assembles, the
// counterpart of `elf.bastio` and `pe.bastio`: the whole program is one
// object, so linking means giving each section an address, resolving every
// relocation against it, and turning the symbols the object does not define
// into imports from `/usr/lib/libSystem.B.dylib`.
//
// The image is not position independent and has a fixed base (4 GiB, behind
// the zero page). Each import gets one eight-byte slot that dyld fills in at
// start-up (a bind opcode in `LC_DYLD_INFO_ONLY`) and a six-byte
// `jmp *slot(%rip)` thunk in `__text` (a call to an import is a call to the
// thunk; `@GOTPCREL` is the slot). The entry point is `_main`, which dyld
// calls through `LC_MAIN`. An x86-64 executable needs no code signature.
//
// Part of the trusted base once the macOS build uses it instead of Apple's
// assembler and linker driver.
import "elf.bastio";

const ML_BASE: u64 = 4294967296;
const ML_PAGE: u64 = 4096;
const ML_NCMDS: u64 = 11;
const ML_CMDS: u64 = 896;

fn ml_name(out: &mut Vec[u64], s: Str) {
  let at = vec_len(out);
  pe_put(&mut out, s);
  pe_pad_to(&mut out, wrap_add(at, 16));
}

fn ml_uleb(out: &mut Vec[u64], x0: u64) {
  let mut x = x0;
  let mut more = true;
  while more {
    let b = x & 127;
    x = x / 128;
    if x > 0 {
      as_byte(&mut out, b | 128);
    } else {
      as_byte(&mut out, b);
      more = false;
    }
  }
}

fn ml_seg(out: &mut Vec[u64], name: Str, vmaddr: u64, vmsize: u64, fileoff: u64, filesize: u64, prot: u64, nsects: u64) {
  as_le(&mut out, 25, 4);
  as_le(&mut out, wrap_add(72, wrap_mul(80, nsects)), 4);
  ml_name(&mut out, name);
  as_le(&mut out, vmaddr, 8);
  as_le(&mut out, vmsize, 8);
  as_le(&mut out, fileoff, 8);
  as_le(&mut out, filesize, 8);
  as_le(&mut out, prot, 4);
  as_le(&mut out, prot, 4);
  as_le(&mut out, nsects, 4);
  as_le(&mut out, 0, 4);
}

fn ml_sect(out: &mut Vec[u64], name: Str, seg: Str, addr: u64, size: u64, off: u64, align: u64, flags: u64) {
  ml_name(&mut out, name);
  ml_name(&mut out, seg);
  as_le(&mut out, addr, 8);
  as_le(&mut out, size, 8);
  as_le(&mut out, off, 4);
  as_le(&mut out, align, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, flags, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, 0, 4);
}

fn ml_link(g: &mut AsObj) -> Vec[u64] {
  let mut rel = vec_new[u64]();
  let mut text = ao_emit(g, AB_TEXT, &mut rel);
  let mut ro = ao_emit(g, AB_RODATA, &mut rel);
  let mut data = ao_emit(g, AB_DATA, &mut rel);
  let bss0 = ao_sec_size(g, AB_BSS);
  // common symbols get their room at the end of .bss
  let nsym = ao_nsyms(g);
  let mut bss = pe_align(bss0, 16);
  let mut cs = 0;
  let mut comm = vec_new[u64]();
  while cs < nsym {
    if (ao_sym(g, cs, 4) & 2) != 0 {
      vec_push(&mut comm, cs);
      vec_push(&mut comm, bss);
      bss = pe_align(wrap_add(bss, ao_sym(g, cs, 5)), 16);
    }
    cs = wrap_add(cs, 1);
  }
  // the imports: the undefined symbols the relocations name
  let mut imports = vec_new[u64]();
  let mut r = 0;
  while wrap_add(r, 5) <= vec_len(rel) {
    let sym = u_at(rel, wrap_add(r, 3));
    if ao_sym(g, sym, 2) == AS_NONE && (ao_sym(g, sym, 4) & 2) == 0 && !has_id(imports, sym) {
      vec_push(&mut imports, sym);
    }
    r = wrap_add(r, 5);
  }
  let nimp = vec_len(imports);
  // the read-only and executable segment: the headers, .text and its thunks, .rodata
  let text_off = pe_align(wrap_add(32, ML_CMDS), 16);
  let tstart = pe_align(vec_len(text), 16);
  let ttotal = wrap_add(tstart, wrap_mul(nimp, 8));
  let ro_off = pe_align(wrap_add(text_off, ttotal), 16);
  let ro_len = vec_len(ro);
  let text_end = wrap_add(ro_off, ro_len);
  let tseg = pe_align(text_end, ML_PAGE);
  // the writable segment: .data, the import slots, then .bss
  let data_off = tseg;
  let data_len = vec_len(data);
  let got_off = wrap_add(data_off, pe_align(data_len, 8));
  let data_end = wrap_add(got_off, wrap_mul(nimp, 8));
  let dseg = pe_align(wrap_sub(data_end, data_off), ML_PAGE);
  let bss_off = wrap_add(data_off, dseg);
  let dvm = wrap_add(dseg, pe_align(bss, ML_PAGE));
  // the link-edit segment: the bind opcodes and an empty symbol table
  let le_off = wrap_add(data_off, dseg);
  let le_vm = wrap_add(data_off, dvm);
  let mut bind = vec_new[u64]();
  let mut k = 0;
  while k < nimp {
    let id = u_at(imports, k);
    as_byte(&mut bind, 17);
    as_byte(&mut bind, 64);
    let ns = ao_sym(g, id, 0);
    let mut c = 0;
    while c < ao_sym(g, id, 1) {
      as_byte(&mut bind, u_at(g.names, wrap_add(ns, c)));
      c = wrap_add(c, 1);
    }
    as_byte(&mut bind, 0);
    as_byte(&mut bind, 81);
    as_byte(&mut bind, 114);
    ml_uleb(&mut bind, wrap_add(wrap_sub(got_off, data_off), wrap_mul(k, 8)));
    as_byte(&mut bind, 144);
    k = wrap_add(k, 1);
  }
  as_byte(&mut bind, 0);
  let bind_len = vec_len(bind);
  let bind_size = pe_align(bind_len, 8);
  let le_size = wrap_add(bind_size, 8);
  // the address of every symbol, for the relocations
  let mut bad = false;
  r = 0;
  while wrap_add(r, 5) <= vec_len(rel) {
    let sec = u_at(rel, r);
    let at = u_at(rel, wrap_add(r, 1));
    let kind = u_at(rel, wrap_add(r, 2));
    let sym = u_at(rel, wrap_add(r, 3));
    let addend = u_at(rel, wrap_add(r, 4));
    let mut target = 0;
    let ssec = ao_sym(g, sym, 2);
    if ssec == AS_NONE && (ao_sym(g, sym, 4) & 2) != 0 {
      let mut q = 0;
      while wrap_add(q, 2) <= vec_len(comm) {
        if u_at(comm, q) == sym {
          target = wrap_add(ML_BASE, wrap_add(bss_off, u_at(comm, wrap_add(q, 1))));
        }
        q = wrap_add(q, 2);
      }
      if elf_is_got(kind, false) {
        bad = true;
      }
    } else if ssec == AS_NONE {
      let mut q = 0;
      while q < nimp {
        if u_at(imports, q) == sym {
          if elf_is_got(kind, false) {
            target = wrap_add(ML_BASE, wrap_add(got_off, wrap_mul(q, 8)));
          } else if elf_is_call(kind, false) {
            target = wrap_add(ML_BASE, wrap_add(text_off, wrap_add(tstart, wrap_mul(q, 8))));
          } else {
            bad = true;
          }
        }
        q = wrap_add(q, 1);
      }
    } else {
      let off = ao_sym_off(g, sym);
      if ssec == AB_TEXT {
        target = wrap_add(ML_BASE, wrap_add(text_off, off));
      } else if ssec == AB_RODATA {
        target = wrap_add(ML_BASE, wrap_add(ro_off, off));
      } else if ssec == AB_DATA {
        target = wrap_add(ML_BASE, wrap_add(data_off, off));
      } else {
        target = wrap_add(ML_BASE, wrap_add(bss_off, off));
      }
      if elf_is_got(kind, false) {
        bad = true;
      }
    }
    let mut base = wrap_add(ML_BASE, text_off);
    if sec == AB_RODATA {
      base = wrap_add(ML_BASE, ro_off);
    } else if sec == AB_DATA {
      base = wrap_add(ML_BASE, data_off);
    }
    let value = wrap_sub(wrap_add(target, addend), wrap_add(base, at));
    if sec == AB_TEXT {
      pe_patch(&mut text, at, value, 4);
    } else if sec == AB_RODATA {
      pe_patch(&mut ro, at, value, 4);
    } else if sec == AB_DATA {
      pe_patch(&mut data, at, value, 4);
    } else {
      bad = true;
    }
    if target == 0 {
      bad = true;
    }
    r = wrap_add(r, 5);
  }
  // the entry point
  let entry = pe_find(g, "_main");
  if entry == AS_NONE || ao_sym(g, entry, 2) != AB_TEXT {
    bad = true;
  }
  let mut out = vec_new[u64]();
  if bad {
    vec_free(text);
    vec_free(ro);
    vec_free(data);
    vec_free(rel);
    vec_free(imports);
    vec_free(comm);
    vec_free(bind);
    return out;
  }
  // the thunks
  pe_pad_to(&mut text, tstart);
  k = 0;
  while k < nimp {
    let slot = wrap_add(ML_BASE, wrap_add(got_off, wrap_mul(k, 8)));
    let here = wrap_add(ML_BASE, wrap_add(text_off, wrap_add(tstart, wrap_mul(k, 8))));
    as_byte(&mut text, 255);
    as_byte(&mut text, 37);
    as_le(&mut text, wrap_sub(slot, wrap_add(here, 6)), 4);
    as_byte(&mut text, 204);
    as_byte(&mut text, 204);
    k = wrap_add(k, 1);
  }
  // the header
  as_le(&mut out, 4277009103, 4);
  as_le(&mut out, 16777223, 4);
  as_le(&mut out, 3, 4);
  as_le(&mut out, 2, 4);
  as_le(&mut out, ML_NCMDS, 4);
  as_le(&mut out, ML_CMDS, 4);
  as_le(&mut out, 133, 4);
  as_le(&mut out, 0, 4);
  // the load commands
  ml_seg(&mut out, "__PAGEZERO", 0, ML_BASE, 0, 0, 0, 0);
  ml_seg(&mut out, "__TEXT", ML_BASE, tseg, 0, tseg, 5, 2);
  ml_sect(&mut out, "__text", "__TEXT", wrap_add(ML_BASE, text_off), ttotal, text_off, 4, 2147484672);
  ml_sect(&mut out, "__const", "__TEXT", wrap_add(ML_BASE, ro_off), ro_len, ro_off, 4, 0);
  ml_seg(&mut out, "__DATA", wrap_add(ML_BASE, data_off), dvm, data_off, dseg, 3, 2);
  ml_sect(&mut out, "__data", "__DATA", wrap_add(ML_BASE, data_off), wrap_sub(data_end, data_off), data_off, 4, 0);
  ml_sect(&mut out, "__bss", "__DATA", wrap_add(ML_BASE, bss_off), bss, 0, 4, 1);
  ml_seg(&mut out, "__LINKEDIT", wrap_add(ML_BASE, le_vm), pe_align(le_size, ML_PAGE), le_off, le_size, 1, 0);
  // LC_DYLD_INFO_ONLY: no rebases, the binds, no lazy binds and no exports
  as_le(&mut out, 2147483682, 4);
  as_le(&mut out, 48, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, le_off, 4);
  as_le(&mut out, bind_len, 4);
  k = 0;
  while k < 6 {
    as_le(&mut out, 0, 4);
    k = wrap_add(k, 1);
  }
  // LC_SYMTAB: no symbols, a string table of eight bytes
  as_le(&mut out, 2, 4);
  as_le(&mut out, 24, 4);
  as_le(&mut out, wrap_add(le_off, bind_size), 4);
  as_le(&mut out, 0, 4);
  as_le(&mut out, wrap_add(le_off, bind_size), 4);
  as_le(&mut out, 8, 4);
  // LC_DYSYMTAB: all zero
  as_le(&mut out, 11, 4);
  as_le(&mut out, 80, 4);
  k = 0;
  while k < 18 {
    as_le(&mut out, 0, 4);
    k = wrap_add(k, 1);
  }
  // LC_LOAD_DYLINKER
  as_le(&mut out, 14, 4);
  as_le(&mut out, 32, 4);
  as_le(&mut out, 12, 4);
  pe_put(&mut out, "/usr/lib/dyld");
  pe_pad_to(&mut out, pe_align(vec_len(out), 8));
  // LC_MAIN
  as_le(&mut out, 2147483688, 4);
  as_le(&mut out, 24, 4);
  as_le(&mut out, wrap_add(text_off, ao_sym_off(g, entry)), 8);
  as_le(&mut out, 0, 8);
  // LC_LOAD_DYLIB: libSystem
  as_le(&mut out, 12, 4);
  as_le(&mut out, 56, 4);
  as_le(&mut out, 24, 4);
  as_le(&mut out, 2, 4);
  as_le(&mut out, 84082688, 4);
  as_le(&mut out, 65536, 4);
  pe_put(&mut out, "/usr/lib/libSystem.B.dylib");
  pe_pad_to(&mut out, pe_align(vec_len(out), 8));
  // LC_BUILD_VERSION: macOS 10.15, no tools
  as_le(&mut out, 50, 4);
  as_le(&mut out, 24, 4);
  as_le(&mut out, 1, 4);
  as_le(&mut out, 659200, 4);
  as_le(&mut out, 659200, 4);
  as_le(&mut out, 0, 4);
  if vec_len(out) != wrap_add(32, ML_CMDS) {
    vec_free(text);
    vec_free(ro);
    vec_free(data);
    vec_free(rel);
    vec_free(imports);
    vec_free(comm);
    vec_free(bind);
    vec_free(out);
    return vec_new[u64]();
  }
  let text_len = vec_len(text);
  pe_pad_to(&mut out, text_off);
  pe_append(&mut out, text, text_len);
  pe_pad_to(&mut out, ro_off);
  pe_append(&mut out, ro, ro_len);
  pe_pad_to(&mut out, data_off);
  pe_append(&mut out, data, data_len);
  pe_pad_to(&mut out, data_end);
  pe_pad_to(&mut out, le_off);
  pe_append(&mut out, bind, bind_len);
  pe_pad_to(&mut out, wrap_add(le_off, le_size));
  vec_free(rel);
  vec_free(imports);
  vec_free(comm);
  return out;
}

/// Links the program into the macOS executable at `outp`.
fn ml_build(host: &Host, outp: &Bytes, data: &Bytes) -> u64 {
  let mut g = pe_feed(data, "", false);
  if g.errs > 0 {
    ao_free(g);
    return 3;
  }
  ao_layout(&mut g);
  let image = ml_link(&mut g);
  ao_free(g);
  if vec_len(image) == 0 {
    vec_free(image);
    return 4;
  }
  return pe_write(host, outp, image);
}
