// Prints the x86-64 assembly a program compiles to, in the format of
// `bastioc0 --backend native --emit-asm` (type and linearity checking, then
// code generation; no verification), for differential testing against
// stage0 (with --stage0, which leaves out what only stage1 does). A
// program the native backend does not support yet exits 4, as stage0 does.
// With --user or --kernel, the program is a BastiOS user program or kernel
// (`--target user`, `--target kernel`).
//   usage: asmdump [--stage0 | --user | --kernel] FILE
import "loader.bastio";
import "out.bastio";
import "x86.bastio";

fn main(con: &mut Serial, host: &mut Host) -> u64 {
  let mut file_arg = 1;
  let mut compat = false;
  let mut target = TARGET_HOSTED;
  if host_argc(host) > 2 {
    let flag = host_arg(host, 1);
    compat = spells(flag, 0, blen(flag), "--stage0");
    if spells(flag, 0, blen(flag), "--user") {
      target = TARGET_USER;
    }
    if spells(flag, 0, blen(flag), "--kernel") {
      target = TARGET_KERNEL;
    }
    bfree(flag);
    file_arg = 2;
  }
  let path = host_arg(host, file_arg);
  let mut p = parser_new(balloc(0), vec_new[Tok](), 0);
  let mut ld = loader_new();
  let r = load(host, &mut p, &mut ld, path, 0, 0, 0, false);
  bfree(path);
  loader_free(ld);
  let mut code = 0;
  if r != 0 {
    put(con, "error\n");
    code = 1;
  } else {
    let mut m = mono_new();
    monomorphize(&mut m, p);
    if m.failed {
      put(con, "error\n");
      code = 1;
    } else {
      let mut c = checker_new(&mut m, p, target);
      check_program(&mut c, &mut m, p);
      if c.failed {
        put(con, "error\n");
        code = 1;
      } else {
        let mut g = x86_new();
        g.stage0 = compat;
        g.target = target;
        if x86_program(&mut g, c, &mut m, p) {
          let mut k = 0;
          while k < vec_len(g.out) {
            let ch = u_at(g.out, k);
            if ch <= 255 {
              serial_write(con, cast[u8](ch));
            }
            k = k + 1;
          }
        } else {
          put(con, "unsupported\n");
          code = 4;
        }
        x86_free(g);
      }
      checker_free(c);
    }
    mono_free(m);
  }
  bfree(parser_free(p));
  return code;
}
