  w_s(&mut out, "bst_rt_fpu_load:                // x0 = the page holding q0-q31, FPSR and FPCR\n");
  w_s(&mut out, "\tldp q0, q1, [x0, #0]\n");
  w_s(&mut out, "\tldp q2, q3, [x0, #32]\n");
  w_s(&mut out, "\tldp q4, q5, [x0, #64]\n");
  w_s(&mut out, "\tldp q6, q7, [x0, #96]\n");
  w_s(&mut out, "\tldp q8, q9, [x0, #128]\n");
  w_s(&mut out, "\tldp q10, q11, [x0, #160]\n");
  w_s(&mut out, "\tldp q12, q13, [x0, #192]\n");
