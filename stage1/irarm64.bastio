  w_s(&mut out, "\tstr x10, [x19, #8]\n");
  w_s(&mut out, "\tb 4f\n");
  w_s(&mut out, "1:\tcbz x19, 2f\n");
  w_s(&mut out, "\tadrp x10, bst_rt_pt_gen\n");
