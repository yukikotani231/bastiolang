  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tadrp x9, _end\n");
  w_s(&mut out, "\tadd x9, x9, :lo12:_end\n");
  w_s(&mut out, "\tadd x9, x9, #4095\n");
  w_s(&mut out, "\tand x20, x9, #0xfffffffffffff000     // base: the end of the image\n");
  w_s(&mut out, "\tmov x21, #0x8000000000      // limit: where the platform's map of RAM stops, at most 512 GiB\n");
  w_s(&mut out, "\tadrp x9, bst_rt_ram_limit_ptr\n");
  w_s(&mut out, "\tldr x9, [x9, :lo12:bst_rt_ram_limit_ptr]\n");
  w_s(&mut out, "\tcbz x9, 1f\n");
  w_s(&mut out, "\tldr x9, [x9]\n");
  w_s(&mut out, "\tcmp x9, x21\n");
