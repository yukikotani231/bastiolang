  w_s(&mut out, "1:\tmov x22, #0                 // n\n");
  w_s(&mut out, "\tcbz x19, 8f\n");
  w_s(&mut out, "\tldr x10, [x19]\n");
  w_s(&mut out, "\tmov x11, #0\n");
  w_s(&mut out, "2:\tcmp x11, x10\n");
  w_s(&mut out, "\tb.hs 8f\n");
  w_s(&mut out, "\tcmp x11, #64\n");
  w_s(&mut out, "\tb.hs 8f\n");
  w_s(&mut out, "\tadd x12, x19, x11, lsl #4\n");
  w_s(&mut out, "\tldr x3, [x12, #8]\n");
  w_s(&mut out, "\tldr x4, [x12, #16]\n");
  w_s(&mut out, "\tadds x4, x3, x4             // b = a + length, saturating\n");
