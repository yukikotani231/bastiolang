  w_s(&mut out, "\tstp x12, x13, [sp, #16]\n");
  w_s(&mut out, "\tstp x14, x15, [sp, #32]\n");
  w_s(&mut out, "\tstr x0, [sp, #48]\n");
  w_s(&mut out, "\tbl bst_platform_ctx\n");
  w_s(&mut out, "\tldr x2, [sp, #48]\n");
  w_s(&mut out, "\tldr x0, [x0, x2, lsl #3]\n");
  w_s(&mut out, "\tldp x12, x13, [sp, #16]\n");
  w_s(&mut out, "\tldp x14, x15, [sp, #32]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #64\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_cpu_set:                 // x0 = a word of the saved context, x1 = its new value; keeps x12-x15\n");
