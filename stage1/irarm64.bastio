  w_s(&mut out, "\tldp q20, q21, [x0, #320]\n");
  w_s(&mut out, "\tldp q22, q23, [x0, #352]\n");
  w_s(&mut out, "\tldp q24, q25, [x0, #384]\n");
  w_s(&mut out, "\tldp q26, q27, [x0, #416]\n");
  w_s(&mut out, "\tldp q28, q29, [x0, #448]\n");
  w_s(&mut out, "\tldp q30, q31, [x0, #480]\n");
  w_s(&mut out, "\tldr x9, [x0, #512]\n");
  w_s(&mut out, "\tldr x10, [x0, #520]\n");
  w_s(&mut out, "\tmsr fpsr, x9\n");
  w_s(&mut out, "\tmsr fpcr, x10\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_fpu_save:                // x0 = the page to hold them\n");
  w_s(&mut out, "\tstp q0, q1, [x0, #0]\n");
  w_s(&mut out, "\tstp q2, q3, [x0, #32]\n");
  w_s(&mut out, "\tstp q4, q5, [x0, #64]\n");
  w_s(&mut out, "\tstp q6, q7, [x0, #96]\n");
  w_s(&mut out, "\tstp q8, q9, [x0, #128]\n");
  w_s(&mut out, "\tstp q10, q11, [x0, #160]\n");
  w_s(&mut out, "\tstp q12, q13, [x0, #192]\n");
  w_s(&mut out, "\tstp q14, q15, [x0, #224]\n");
  w_s(&mut out, "\tstp q16, q17, [x0, #256]\n");
  w_s(&mut out, "\tstp q18, q19, [x0, #288]\n");
  w_s(&mut out, "\tstp q20, q21, [x0, #320]\n");
  w_s(&mut out, "\tstp q22, q23, [x0, #352]\n");
  w_s(&mut out, "\tstp q24, q25, [x0, #384]\n");
  w_s(&mut out, "\tstp q26, q27, [x0, #416]\n");
  w_s(&mut out, "\tstp q28, q29, [x0, #448]\n");
  w_s(&mut out, "\tstp q30, q31, [x0, #480]\n");
  w_s(&mut out, "\tmrs x9, fpsr\n");
  w_s(&mut out, "\tmrs x10, fpcr\n");
  w_s(&mut out, "\tstr x9, [x0, #512]\n");
  w_s(&mut out, "\tstr x10, [x0, #520]\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_mmio_check:              // x0 = base, x1 = length: stops the machine if the block overlaps RAM; keeps x12-x15\n");
  w_s(&mut out, "\tcbz x1, 9f\n");
  w_s(&mut out, "\tadd x2, x0, x1\n");
  w_s(&mut out, "\tadrp x3, bst_rt_carved_hi\n");
  w_s(&mut out, "\tldr x3, [x3, :lo12:bst_rt_carved_hi]\n");
  w_s(&mut out, "\tcmp x0, x3\n");
  w_s(&mut out, "\tb.hs 1f\n");
  w_s(&mut out, "\tadrp x4, bst_rt_carved_lo\n");
  w_s(&mut out, "\tldr x4, [x4, :lo12:bst_rt_carved_lo]\n");
  w_s(&mut out, "\tcmp x4, x2\n");
  w_s(&mut out, "\tb.lo 8f\n");
  w_s(&mut out, "1:\tadrp x5, bst_rt_mbi\n");
  w_s(&mut out, "\tldr x5, [x5, :lo12:bst_rt_mbi]\n");
  w_s(&mut out, "\tcbz x5, 4f\n");
  w_s(&mut out, "\tldr x6, [x5]\n");
  w_s(&mut out, "\tmov x7, #0\n");
  w_s(&mut out, "2:\tcmp x7, x6\n");
  w_s(&mut out, "\tb.hs 4f\n");
  w_s(&mut out, "\tcmp x7, #64\n");
  w_s(&mut out, "\tb.hs 4f\n");
  w_s(&mut out, "\tadd x8, x5, x7, lsl #4\n");
  w_s(&mut out, "\tldr x3, [x8, #8]\n");
  w_s(&mut out, "\tldr x4, [x8, #16]\n");
  w_s(&mut out, "\tadds x4, x3, x4\n");
  w_s(&mut out, "\tcsinv x4, x4, xzr, cc\n");
  w_s(&mut out, "\tcmp x0, x4\n");
  w_s(&mut out, "\tb.hs 3f\n");
  w_s(&mut out, "\tcmp x3, x2\n");
  w_s(&mut out, "\tb.lo 8f\n");
  w_s(&mut out, "3:\tadd x7, x7, #1\n");
  w_s(&mut out, "\tb 2b\n");
  w_s(&mut out, "4:\tadrp x5, bst_rt_run_at\n");
  w_s(&mut out, "\tadd x5, x5, :lo12:bst_rt_run_at\n");
  w_s(&mut out, "\tadrp x6, bst_rt_run_id\n");
  w_s(&mut out, "\tadd x6, x6, :lo12:bst_rt_run_id\n");
  w_s(&mut out, "\tadrp x7, bst_rt_runs\n");
  w_s(&mut out, "\tldr x7, [x7, :lo12:bst_rt_runs]\n");
  w_s(&mut out, "\tmov x8, #0\n");
  w_s(&mut out, "5:\tcmp x8, x7\n");
  w_s(&mut out, "\tb.hs 9f\n");
  w_s(&mut out, "\tldr x3, [x5, x8, lsl #3]\n");
  w_s(&mut out, "\tldr x4, [x6, x8, lsl #3]\n");
  w_s(&mut out, "\tadd x9, x8, #1\n");
  w_s(&mut out, "\tldr x10, [x6, x9, lsl #3]\n");
  w_s(&mut out, "\tsub x10, x10, x4\n");
  w_s(&mut out, "\tadd x4, x3, x10, lsl #12\n");
  w_s(&mut out, "\tcmp x0, x4\n");
  w_s(&mut out, "\tb.hs 6f\n");
  w_s(&mut out, "\tcmp x3, x2\n");
  w_s(&mut out, "\tb.lo 8f\n");
  w_s(&mut out, "6:\tmov x8, x9\n");
  w_s(&mut out, "\tb 5b\n");
  w_s(&mut out, "8:\tmov x19, x0\n");
  w_s(&mut out, "\tadrp x1, .Lrt_mmio\n");
  w_s(&mut out, "\tadd x1, x1, :lo12:.Lrt_mmio\n");
  w_s(&mut out, "\tmov x2, #29\n");
  w_s(&mut out, "\tbl bst_rt_puts\n");
  w_s(&mut out, "\tmov x0, x19\n");
  w_s(&mut out, "\tbl bst_rt_puthex\n");
  w_s(&mut out, "\tmov w0, #10\n");
  w_s(&mut out, "\tbl bst_rt_putc\n");
  w_s(&mut out, "\tb bst_rt_halt\n");
  w_s(&mut out, "9:\tret\n");
}

/// The page pool: the runs of RAM the platform lists, the bookkeeping carved off the front of one of them, and the
/// page lookups over them (the C prelude's `bst_run_put`, `bst_pool_init`, `bst_page_at` and `bst_frame_id`).
/// The lookups keep to x0-x11, x16 and x17, which the emitter leaves free; `bst_rt_pool_init` runs before any
/// Bastio code and saves what it uses.
fn a64_rt_pool(out: &mut Vec[u64]) {
  w_s(&mut out, "bst_rt_run_put:\n");
  w_s(&mut out, "\tmov x5, #0\n");
  w_s(&mut out, "\tmov x6, #0\n");
  w_s(&mut out, "1:\tcmp x6, x2\n");
  w_s(&mut out, "\tb.hs 4f\n");
  w_s(&mut out, "\tldr x7, [x0, x6, lsl #3]\n");
  w_s(&mut out, "\tldr x8, [x1, x6, lsl #3]\n");
  w_s(&mut out, "\tcmp x8, x3\n");
  w_s(&mut out, "\tb.lo 2f\n");
  w_s(&mut out, "\tcmp x4, x7\n");
  w_s(&mut out, "\tb.lo 2f\n");
  w_s(&mut out, "\tcmp x7, x3\n");
  w_s(&mut out, "\tcsel x3, x7, x3, lo\n");
  w_s(&mut out, "\tcmp x8, x4\n");
  w_s(&mut out, "\tcsel x4, x8, x4, hi\n");
  w_s(&mut out, "\tb 3f\n");
  w_s(&mut out, "2:\tstr x7, [x0, x5, lsl #3]\n");
  w_s(&mut out, "\tstr x8, [x1, x5, lsl #3]\n");
  w_s(&mut out, "\tadd x5, x5, #1\n");
  w_s(&mut out, "3:\tadd x6, x6, #1\n");
  w_s(&mut out, "\tb 1b\n");
  w_s(&mut out, "4:\tcmp x5, #32\n");
  w_s(&mut out, "\tb.eq 9f\n");
  w_s(&mut out, "\tmov x6, x5\n");
  w_s(&mut out, "5:\tcbz x6, 6f\n");
  w_s(&mut out, "\tsub x7, x6, #1\n");
  w_s(&mut out, "\tldr x8, [x0, x7, lsl #3]\n");
  w_s(&mut out, "\tcmp x8, x3\n");
  w_s(&mut out, "\tb.ls 6f\n");
  w_s(&mut out, "\tldr x9, [x1, x7, lsl #3]\n");
  w_s(&mut out, "\tstr x8, [x0, x6, lsl #3]\n");
  w_s(&mut out, "\tstr x9, [x1, x6, lsl #3]\n");
  w_s(&mut out, "\tmov x6, x7\n");
  w_s(&mut out, "\tb 5b\n");
  w_s(&mut out, "6:\tstr x3, [x0, x6, lsl #3]\n");
  w_s(&mut out, "\tstr x4, [x1, x6, lsl #3]\n");
  w_s(&mut out, "\tadd x0, x5, #1\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "9:\tmov x0, x5\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_pool_init:\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-96]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
