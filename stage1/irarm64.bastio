  w_s(&mut out, "\tb.hs 9f\n");
  w_s(&mut out, "\tcmp x28, x22\n");
  w_s(&mut out, "\tb.ne 9f\n");
  w_s(&mut out, "\tcbz x16, 61f\n");
  w_s(&mut out, "\tmov x27, #0                 // the second try is for the counters alone\n");
