  w_s(&mut out, "\tadd x10, x10, :lo12:bst_rt_pt_gen\n");
  w_s(&mut out, "\tldar x10, [x10]\n");
  w_s(&mut out, "\tldr x11, [x20, #8]\n");
  w_s(&mut out, "\tcmp x10, x11\n");
  w_s(&mut out, "\tb.eq 6f\n");
  w_s(&mut out, "5:\tmov x0, x20\n");
  w_s(&mut out, "\tmov x1, x19\n");
  w_s(&mut out, "\tbl bst_rt_root_load\n");
  w_s(&mut out, "6:\tcbz x20, 9f\n");
  w_s(&mut out, "\tldr x21, [x20]\n");
  w_s(&mut out, "\tcbz x21, 9f\n");
  w_s(&mut out, "\tstr xzr, [x20]\n");
  w_s(&mut out, "\tmov x0, x21\n");
  w_s(&mut out, "\tbl bst_rt_lease_drop\n");
  w_s(&mut out, "9:\tmov x0, x19\n");
  w_s(&mut out, "\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldr x21, [sp, #32]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #48\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_mmu_exit:                // x0 = the lease (the table)\n");
