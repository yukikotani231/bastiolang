  w_s(&mut out, "\tmov x0, x20\n");
  w_s(&mut out, "\tbl bst_rt_lease_drop\n");
  w_s(&mut out, "9:\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #32\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_mmu_settle_on:           // x0 = a table: settle if it is the parked one\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-32]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tbl bst_rt_mmu_state\n");
  w_s(&mut out, "\tcbz x0, 9f\n");
  w_s(&mut out, "\tldr x9, [x0]\n");
  w_s(&mut out, "\tcmp x9, x19\n");
  w_s(&mut out, "\tb.ne 9f\n");
  w_s(&mut out, "\tbl bst_rt_mmu_settle\n");
  w_s(&mut out, "9:\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #32\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_lock_depth:              // x0 = +1 or -1 locks held\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-32]!\n");
