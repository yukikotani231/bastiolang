  w_s(&mut out, "4:\tcmp x11, x22\n");
  w_s(&mut out, "\tb.hs 5f\n");
  w_s(&mut out, "\tldr x3, [x23, x11, lsl #3]\n");
  w_s(&mut out, "\tldr x4, [x24, x11, lsl #3]\n");
  w_s(&mut out, "\tsub x5, x4, x3\n");
  w_s(&mut out, "\tlsr x5, x5, #12\n");
  w_s(&mut out, "\tadd x6, x25, x5\n");
  w_s(&mut out, "\tcmp x6, x9\n");
