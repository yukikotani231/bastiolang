  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tbl bst_rt_mmu_state\n");
  w_s(&mut out, "\tmov x20, x0\n");
  w_s(&mut out, "\tadrp x9, bst_rt_deferred_ptr\n");
  w_s(&mut out, "\tldr x9, [x9, :lo12:bst_rt_deferred_ptr]\n");
  w_s(&mut out, "\tcbz x9, 2f\n");
  w_s(&mut out, "\tstr xzr, [x20, #24]\n");
  w_s(&mut out, "\tb 3f\n");
  w_s(&mut out, "2:\tcbz x20, 4f\n");
  w_s(&mut out, "\tstr x19, [x20]\n");
  w_s(&mut out, "\tb 9f\n");
