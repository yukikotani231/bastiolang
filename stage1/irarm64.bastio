  w_s(&mut out, "\tstr x4, [x9, :lo12:bst_rt_arena2]\n");
  w_s(&mut out, "\tlsl x5, x27, #9\n");
  w_s(&mut out, "\tadrp x9, bst_rt_arena2_words\n");
  w_s(&mut out, "\tstr x5, [x9, :lo12:bst_rt_arena2_words]\n");
  w_s(&mut out, "\tadrp x9, bst_rt_carved_lo\n");
  w_s(&mut out, "\tstr x3, [x9, :lo12:bst_rt_carved_lo]\n");
  w_s(&mut out, "\tadd x4, x26, x27\n");
  w_s(&mut out, "\tadd x4, x3, x4, lsl #12\n");
  w_s(&mut out, "\tadrp x9, bst_rt_carved_hi\n");
  w_s(&mut out, "\tstr x4, [x9, :lo12:bst_rt_carved_hi]\n");
  w_s(&mut out, "\tstr x4, [x23, x28, lsl #3]  // the run starts after what was carved\n");
  w_s(&mut out, "\tadrp x9, bst_rt_run_at\n");
  w_s(&mut out, "\tadd x9, x9, :lo12:bst_rt_run_at\n");
  w_s(&mut out, "\tadrp x10, bst_rt_run_id\n");
  w_s(&mut out, "\tadd x10, x10, :lo12:bst_rt_run_id\n");
  w_s(&mut out, "\tstr xzr, [x10]\n");
  w_s(&mut out, "\tmov x11, #0\n");
  w_s(&mut out, "13:\tcmp x11, x22\n");
  w_s(&mut out, "\tb.hs 14f\n");
  w_s(&mut out, "\tldr x3, [x23, x11, lsl #3]\n");
  w_s(&mut out, "\tldr x4, [x24, x11, lsl #3]\n");
  w_s(&mut out, "\tstr x3, [x9, x11, lsl #3]\n");
  w_s(&mut out, "\tsub x4, x4, x3\n");
  w_s(&mut out, "\tlsr x4, x4, #12\n");
  w_s(&mut out, "\tldr x5, [x10, x11, lsl #3]\n");
  w_s(&mut out, "\tadd x5, x5, x4\n");
  w_s(&mut out, "\tadd x6, x11, #1\n");
  w_s(&mut out, "\tstr x5, [x10, x6, lsl #3]\n");
  w_s(&mut out, "\tmov x11, x6\n");
  w_s(&mut out, "\tb 13b\n");
  w_s(&mut out, "14:\tadrp x9, bst_rt_runs\n");
  w_s(&mut out, "\tstr x22, [x9, :lo12:bst_rt_runs]\n");
  w_s(&mut out, "\tldr x0, [x23]\n");
  w_s(&mut out, "\tldr x1, [x10, x22, lsl #3]\n");
  w_s(&mut out, "99:\tmov sp, x29\n");
  w_s(&mut out, "\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tldp x23, x24, [sp, #48]\n");
  w_s(&mut out, "\tldp x25, x26, [sp, #64]\n");
  w_s(&mut out, "\tldp x27, x28, [sp, #80]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #96\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_page_at:                 // x0 = a page's index -> its address\n");
  w_s(&mut out, "\tadrp x9, bst_rt_run_id\n");
  w_s(&mut out, "\tadd x9, x9, :lo12:bst_rt_run_id\n");
  w_s(&mut out, "\tadrp x10, bst_rt_run_at\n");
  w_s(&mut out, "\tadd x10, x10, :lo12:bst_rt_run_at\n");
  w_s(&mut out, "\tadrp x11, bst_rt_runs\n");
  w_s(&mut out, "\tldr x11, [x11, :lo12:bst_rt_runs]\n");
  w_s(&mut out, "\tmov x16, #0\n");
  w_s(&mut out, "1:\tadd x17, x16, #1\n");
  w_s(&mut out, "\tcmp x17, x11\n");
  w_s(&mut out, "\tb.hs 2f\n");
  w_s(&mut out, "\tldr x8, [x9, x17, lsl #3]\n");
  w_s(&mut out, "\tcmp x0, x8\n");
  w_s(&mut out, "\tb.lo 2f\n");
  w_s(&mut out, "\tmov x16, x17\n");
  w_s(&mut out, "\tb 1b\n");
  w_s(&mut out, "2:\tldr x8, [x9, x16, lsl #3]\n");
  w_s(&mut out, "\tsub x0, x0, x8\n");
  w_s(&mut out, "\tldr x8, [x10, x16, lsl #3]\n");
  w_s(&mut out, "\tadd x0, x8, x0, lsl #12\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_frame_id:                // x0 = a page's address -> its index\n");
  w_s(&mut out, "\tadrp x9, bst_rt_run_id\n");
  w_s(&mut out, "\tadd x9, x9, :lo12:bst_rt_run_id\n");
  w_s(&mut out, "\tadrp x10, bst_rt_run_at\n");
  w_s(&mut out, "\tadd x10, x10, :lo12:bst_rt_run_at\n");
  w_s(&mut out, "\tadrp x11, bst_rt_runs\n");
  w_s(&mut out, "\tldr x11, [x11, :lo12:bst_rt_runs]\n");
  w_s(&mut out, "\tmov x16, #0\n");
  w_s(&mut out, "1:\tadd x17, x16, #1\n");
  w_s(&mut out, "\tcmp x17, x11\n");
  w_s(&mut out, "\tb.hs 2f\n");
  w_s(&mut out, "\tldr x8, [x10, x16, lsl #3]\n");
  w_s(&mut out, "\tsub x8, x0, x8\n");
  w_s(&mut out, "\tldr x7, [x9, x16, lsl #3]\n");
  w_s(&mut out, "\tldr x6, [x9, x17, lsl #3]\n");
  w_s(&mut out, "\tsub x6, x6, x7\n");
  w_s(&mut out, "\tlsl x6, x6, #12\n");
  w_s(&mut out, "\tcmp x8, x6\n");
  w_s(&mut out, "\tb.lo 2f\n");
  w_s(&mut out, "\tmov x16, x17\n");
  w_s(&mut out, "\tb 1b\n");
  w_s(&mut out, "2:\tldr x8, [x10, x16, lsl #3]\n");
  w_s(&mut out, "\tsub x0, x0, x8\n");
  w_s(&mut out, "\tlsr x0, x0, #12\n");
  w_s(&mut out, "\tldr x7, [x9, x16, lsl #3]\n");
  w_s(&mut out, "\tadd x0, x0, x7\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_sync_icache:             // x0 = a page's address, kept: clean it to the PoU, invalidate the I-cache over it\n");
  w_s(&mut out, "\tmrs x9, ctr_el0\n");
  w_s(&mut out, "\tubfx x10, x9, #16, #4\n");
  w_s(&mut out, "\tmov x11, #4\n");
  w_s(&mut out, "\tlsl x10, x11, x10\n");
  w_s(&mut out, "\tand x9, x9, #15\n");
  w_s(&mut out, "\tlsl x9, x11, x9\n");
  w_s(&mut out, "\tadd x17, x0, #4096\n");
  w_s(&mut out, "\tmov x16, x0\n");
  w_s(&mut out, "1:\tdc cvau, x16\n");
  w_s(&mut out, "\tadd x16, x16, x10\n");
  w_s(&mut out, "\tcmp x16, x17\n");
  w_s(&mut out, "\tb.lo 1b\n");
  w_s(&mut out, "\tdsb ish\n");
  w_s(&mut out, "\tmov x16, x0\n");
  w_s(&mut out, "2:\tic ivau, x16\n");
  w_s(&mut out, "\tadd x16, x16, x9\n");
  w_s(&mut out, "\tcmp x16, x17\n");
  w_s(&mut out, "\tb.lo 2b\n");
  w_s(&mut out, "\tdsb ish\n");
  w_s(&mut out, "\tisb\n");
  w_s(&mut out, "\tret\n");
}

/// The allocator over a fixed arena of `words` words (`bst_rt_arena`, with `bst_rt_arena_top` and
/// `bst_rt_free_list` beside it in the .bss) and the Vec growth built on it.
fn a64_rt_arena(out: &mut Vec[u64], words: u64, second: bool) {
  w_s(&mut out, "bst_rt_try_balloc:              // as bst_rt_balloc, but x0 = 0 when out of memory\n");
  w_s(&mut out, "\tadd x0, x0, #7\n");
  w_s(&mut out, "\tlsr x0, x0, #3\n");
  w_s(&mut out, "bst_rt_try_alloc:\n");
  w_s(&mut out, "\tmov x9, #1\n");
  w_s(&mut out, "\tb 0f\n");
  w_s(&mut out, "bst_rt_balloc:                  // x0 = x0 zeroed bytes (at least one)\n");
  w_s(&mut out, "\tadd x0, x0, #7\n");
  w_s(&mut out, "\tlsr x0, x0, #3\n");
  w_s(&mut out, "bst_rt_alloc:                   // x0 = x0 zeroed words (at least one), after a header word\n");
  w_s(&mut out, "\tmov x9, #0                  // out of memory stops the program\n");
  w_s(&mut out, "0:\tcbnz x0, 1f\n");
  w_s(&mut out, "\tmov x0, #1\n");
  w_s(&mut out, "1:\tadds x0, x0, #1             // the block's words, header included\n");
  w_s(&mut out, "\tb.cs 6f\n");
  w_s(&mut out, "\tadrp x10, bst_rt_free_list\n");
  w_s(&mut out, "\tadd x10, x10, :lo12:bst_rt_free_list\n");
  w_s(&mut out, "2:\tldr x11, [x10]            // a free block of exactly that size first\n");
  w_s(&mut out, "\tcbz x11, 4f\n");
  w_s(&mut out, "\tldr x12, [x11]\n");
  w_s(&mut out, "\tcmp x12, x0\n");
  w_s(&mut out, "\tb.eq 3f\n");
  w_s(&mut out, "\tadd x10, x11, #8\n");
  w_s(&mut out, "\tb 2b\n");
  w_s(&mut out, "3:\tldr x12, [x11, #8]\n");
  w_s(&mut out, "\tstr x12, [x10]\n");
  w_s(&mut out, "\tmov x13, x11\n");
  w_s(&mut out, "\tb 5f\n");
  w_s(&mut out, "4:\tadrp x14, bst_rt_arena_top\n");
  w_s(&mut out, "\tadd x14, x14, :lo12:bst_rt_arena_top\n");
  w_s(&mut out, "\tldr x11, [x14]\n");
  w_s(&mut out, "\tmov x12, #");
  w_num(&mut out, words);
  w_s(&mut out, "              // the arena's words\n");
  w_s(&mut out, "\tsub x12, x12, x11\n");
  w_s(&mut out, "\tcmp x0, x12\n");
  if second {
    w_s(&mut out, "\tb.hi 9f\n");
  } else {
    w_s(&mut out, "\tb.hi 6f\n");
  }
  w_s(&mut out, "\tadd x12, x11, x0\n");
  w_s(&mut out, "\tstr x12, [x14]\n");
  w_s(&mut out, "\tadrp x13, bst_rt_arena\n");
  w_s(&mut out, "\tadd x13, x13, :lo12:bst_rt_arena\n");
  w_s(&mut out, "\tadd x13, x13, x11, lsl #3\n");
  w_s(&mut out, "\tstr x0, [x13]\n");
  w_s(&mut out, "5:\tadd x1, x13, #8             // the payload, zeroed\n");
  w_s(&mut out, "\tmov x14, x1\n");
  w_s(&mut out, "\tsub x15, x0, #1\n");
  w_s(&mut out, "7:\tcbz x15, 8f\n");
  w_s(&mut out, "\tstr xzr, [x14], #8\n");
  w_s(&mut out, "\tsub x15, x15, #1\n");
  w_s(&mut out, "\tb 7b\n");
  w_s(&mut out, "8:\tmov x0, x1\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "6:\tcbz x9, bst_rt_oom\n");
  w_s(&mut out, "\tmov x0, #0\n");
  w_s(&mut out, "\tret\n");
  if second {
    // The extension the pool carves from RAM (bst_rt_pool_init), once the first arena is full.
    w_s(&mut out, "9:\tadrp x14, bst_rt_arena2_top\n");
    w_s(&mut out, "\tadd x14, x14, :lo12:bst_rt_arena2_top\n");
    w_s(&mut out, "\tldr x11, [x14]\n");
    w_s(&mut out, "\tadrp x12, bst_rt_arena2_words\n");
    w_s(&mut out, "\tldr x12, [x12, :lo12:bst_rt_arena2_words]\n");
    w_s(&mut out, "\tsub x12, x12, x11\n");
    w_s(&mut out, "\tcmp x0, x12\n");
    w_s(&mut out, "\tb.hi 6b\n");
    w_s(&mut out, "\tadd x12, x11, x0\n");
    w_s(&mut out, "\tstr x12, [x14]\n");
    w_s(&mut out, "\tadrp x13, bst_rt_arena2\n");
    w_s(&mut out, "\tldr x13, [x13, :lo12:bst_rt_arena2]\n");
    w_s(&mut out, "\tadd x13, x13, x11, lsl #3\n");
    w_s(&mut out, "\tstr x0, [x13]\n");
    w_s(&mut out, "\tb 5b\n");
  }
  w_s(&mut out, "bst_rt_free:                    // give the block at x0 back to the free list (0: none)\n");
  w_s(&mut out, "\tcbz x0, 1f\n");
  w_s(&mut out, "\tadrp x9, bst_rt_free_list\n");
  w_s(&mut out, "\tadd x9, x9, :lo12:bst_rt_free_list\n");
  w_s(&mut out, "\tldr x1, [x9]\n");
  w_s(&mut out, "\tstr x1, [x0]\n");
  w_s(&mut out, "\tsub x0, x0, #8\n");
  w_s(&mut out, "\tstr x0, [x9]\n");
  w_s(&mut out, "1:\tret\n");
  w_s(&mut out, "bst_rt_vec_grow:                // grow the Vec at (x0), elements of x1 bytes\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-48]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tstp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tmov x21, x1\n");
  w_s(&mut out, "\tldr x9, [x19, #8]            // the old words\n");
  w_s(&mut out, "\tmul x10, x9, x21\n");
  w_s(&mut out, "\tadd x10, x10, #7\n");
  w_s(&mut out, "\tlsr x22, x10, #3\n");
  w_s(&mut out, "\tadd x20, x9, x9              // new capacity: double, or 4 when empty\n");
  w_s(&mut out, "\tcbnz x20, 1f\n");
  w_s(&mut out, "\tmov x20, #4\n");
  w_s(&mut out, "1:\tumulh x9, x20, x21         // bytes; past 64 bits the request cannot be met\n");
  w_s(&mut out, "\tcbnz x9, bst_rt_oom\n");
  w_s(&mut out, "\tmul x0, x20, x21\n");
  w_s(&mut out, "\tadds x0, x0, #7\n");
  w_s(&mut out, "\tb.cs bst_rt_oom\n");
  w_s(&mut out, "\tlsr x0, x0, #3\n");
  w_s(&mut out, "\tbl bst_rt_alloc\n");
  w_s(&mut out, "\tmov x21, x0\n");
  w_s(&mut out, "\tldr x1, [x19, #16]\n");
  w_s(&mut out, "\tcbz x1, 3f\n");
  w_s(&mut out, "\tmov x2, x21\n");
  w_s(&mut out, "\tmov x3, x22\n");
  w_s(&mut out, "2:\tcbz x3, 4f\n");
  w_s(&mut out, "\tldr x4, [x1], #8\n");
  w_s(&mut out, "\tstr x4, [x2], #8\n");
  w_s(&mut out, "\tsub x3, x3, #1\n");
  w_s(&mut out, "\tb 2b\n");
  w_s(&mut out, "4:\tldr x0, [x19, #16]\n");
  w_s(&mut out, "\tbl bst_rt_free\n");
  w_s(&mut out, "3:\tstr x21, [x19, #16]\n");
  w_s(&mut out, "\tstr x20, [x19, #8]\n");
  w_s(&mut out, "\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #48\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_vec_try_reserve:         // room for x1 more elements of x2 bytes in the Vec at (x0): w0 = 1, or 0 and unchanged\n");
  w_s(&mut out, "\tldr x3, [x0, #8]\n");
  w_s(&mut out, "\tldr x4, [x0]\n");
  w_s(&mut out, "\tsub x3, x3, x4\n");
  w_s(&mut out, "\tcmp x3, x1\n");
  w_s(&mut out, "\tb.lo 1f\n");
  w_s(&mut out, "\tmov w0, #1\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "1:\tstp x29, x30, [sp, #-64]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tstp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tstp x23, x24, [sp, #48]\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tmov x20, x2\n");
  w_s(&mut out, "\tmov x21, x1\n");
  w_s(&mut out, "\tmov x3, #1                  // lim = 2^60 / size: the capacity stays at most 2^60\n");
  w_s(&mut out, "\tlsl x3, x3, #60\n");
  w_s(&mut out, "\tudiv x3, x3, x20\n");
  w_s(&mut out, "\tldr x4, [x19]\n");
  w_s(&mut out, "\tcmp x4, x3\n");
  w_s(&mut out, "\tb.hi 3f\n");
  w_s(&mut out, "\tsub x5, x3, x4\n");
  w_s(&mut out, "\tcmp x21, x5\n");
  w_s(&mut out, "\tb.hi 3f\n");
  w_s(&mut out, "\tadd x22, x4, x21            // new capacity: len + k, or double when that is more and fits\n");
  w_s(&mut out, "\tldr x6, [x19, #8]\n");
  w_s(&mut out, "\tlsr x3, x3, #1\n");
  w_s(&mut out, "\tcmp x6, x3\n");
  w_s(&mut out, "\tb.hi 2f\n");
  w_s(&mut out, "\tadd x6, x6, x6\n");
  w_s(&mut out, "\tcmp x6, x22\n");
  w_s(&mut out, "\tb.ls 2f\n");
  w_s(&mut out, "\tmov x22, x6\n");
  w_s(&mut out, "2:\tldr x7, [x19, #8]            // the old words\n");
  w_s(&mut out, "\tmul x7, x7, x20\n");
  w_s(&mut out, "\tadd x7, x7, #7\n");
  w_s(&mut out, "\tlsr x23, x7, #3\n");
  w_s(&mut out, "\tmul x0, x22, x20             // the new words\n");
  w_s(&mut out, "\tadd x0, x0, #7\n");
  w_s(&mut out, "\tlsr x0, x0, #3\n");
  w_s(&mut out, "\tbl bst_rt_try_alloc\n");
  w_s(&mut out, "\tcbz x0, 3f\n");
  w_s(&mut out, "\tmov x24, x0\n");
  w_s(&mut out, "\tldr x1, [x19, #16]\n");
  w_s(&mut out, "\tcbz x1, 4f\n");
  w_s(&mut out, "\tmov x2, x24\n");
  w_s(&mut out, "\tmov x3, x23\n");
  w_s(&mut out, "6:\tcbz x3, 7f\n");
  w_s(&mut out, "\tldr x4, [x1], #8\n");
  w_s(&mut out, "\tstr x4, [x2], #8\n");
  w_s(&mut out, "\tsub x3, x3, #1\n");
  w_s(&mut out, "\tb 6b\n");
  w_s(&mut out, "7:\tldr x0, [x19, #16]\n");
  w_s(&mut out, "\tbl bst_rt_free\n");
  w_s(&mut out, "4:\tstr x24, [x19, #16]\n");
  w_s(&mut out, "\tstr x22, [x19, #8]\n");
  w_s(&mut out, "\tmov w0, #1\n");
  w_s(&mut out, "\tb 5f\n");
  w_s(&mut out, "3:\tmov w0, #0\n");
  w_s(&mut out, "5:\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tldp x23, x24, [sp, #48]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #64\n");
  w_s(&mut out, "\tret\n");
}

/// The runtime of a BastiOS user program: the C prelude's `user` and
/// `bytes_arena` parts in assembly (`svc` system calls, the console buffer,
/// a 64 KiB arena with a free list), with no C library. Part of the trusted
/// base; the same routines as `x86_runtime_user`.
fn a64_runtime_user(out: &mut Vec[u64]) {
  w_s(&mut out, "\n// ---- runtime: BastiOS user programs (trusted base) ----\n");
  w_s(&mut out, "\t.text\n");
  w_s(&mut out, "bst_rt_sys:                     // system call x8 with x0, x1, x2: x0 = its result\n");
  w_s(&mut out, "\tsvc #0\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_fsys:                    // the same, after the console output so far\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-48]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x0, x1, [sp, #16]\n");
  w_s(&mut out, "\tstp x2, x8, [sp, #32]\n");
  w_s(&mut out, "\tbl bst_rt_flush\n");
  w_s(&mut out, "\tldp x0, x1, [sp, #16]\n");
  w_s(&mut out, "\tldp x2, x8, [sp, #32]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #48\n");
  w_s(&mut out, "\tsvc #0\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_flush:                   // write out the console buffer\n");
  w_s(&mut out, "\tadrp x9, bst_rt_out_n\n");
  w_s(&mut out, "\tadd x9, x9, :lo12:bst_rt_out_n\n");
  w_s(&mut out, "\tldr x1, [x9]\n");
  w_s(&mut out, "\tcbz x1, 1f\n");
  w_s(&mut out, "\tmov x8, #1                  // SYS_WRITE\n");
  w_s(&mut out, "\tadrp x0, bst_rt_out\n");
  w_s(&mut out, "\tadd x0, x0, :lo12:bst_rt_out\n");
  w_s(&mut out, "\tmov x2, #0\n");
  w_s(&mut out, "\tsvc #0\n");
  w_s(&mut out, "\tstr xzr, [x9]\n");
  w_s(&mut out, "1:\tret\n");
  w_s(&mut out, "bst_rt_putc:                    // write byte x0 to the console; flush at a newline or when full\n");
  w_s(&mut out, "\tadrp x9, bst_rt_out_n\n");
  w_s(&mut out, "\tadd x9, x9, :lo12:bst_rt_out_n\n");
  w_s(&mut out, "\tldr x1, [x9]\n");
  w_s(&mut out, "\tadrp x2, bst_rt_out\n");
  w_s(&mut out, "\tadd x2, x2, :lo12:bst_rt_out\n");
  w_s(&mut out, "\tstrb w0, [x2, x1]\n");
  w_s(&mut out, "\tadd x1, x1, #1\n");
  w_s(&mut out, "\tstr x1, [x9]\n");
  w_s(&mut out, "\tand w0, w0, #0xff\n");
  w_s(&mut out, "\tcmp w0, #10\n");
  w_s(&mut out, "\tb.eq bst_rt_flush\n");
  w_s(&mut out, "\tcmp x1, #256\n");
  w_s(&mut out, "\tb.eq bst_rt_flush\n");
  w_s(&mut out, "\tret\n");
  a64_rt_print(&mut out);
  w_s(&mut out, "bst_rt_getc:                    // x0 = the next byte of console input\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-16]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tbl bst_rt_flush\n");
  w_s(&mut out, "\tmov x8, #2                  // SYS_READ\n");
  w_s(&mut out, "\tmov x0, #0\n");
  w_s(&mut out, "\tmov x1, #0\n");
  w_s(&mut out, "\tmov x2, #0\n");
  w_s(&mut out, "\tsvc #0\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #16\n");
  w_s(&mut out, "\tret\n");
  a64_rt_arena(&mut out, 8192, false);
  w_s(&mut out, "bst_rt_sys_spawn:               // start the program named by words x1..x2 of the Buf data at x0\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-80]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tmov x3, #0                  // the name's bytes, at most 64\n");
  w_s(&mut out, "\tadd x4, sp, #16\n");
  w_s(&mut out, "1:\tcmp x1, x2\n");
  w_s(&mut out, "\tb.hs 2f\n");
  w_s(&mut out, "\tcmp x3, #64\n");
  w_s(&mut out, "\tb.hs 2f\n");
  w_s(&mut out, "\tldr x5, [x0, x1, lsl #3]\n");
  w_s(&mut out, "\tstrb w5, [x4, x3]\n");
  w_s(&mut out, "\tadd x3, x3, #1\n");
  w_s(&mut out, "\tadd x1, x1, #1\n");
  w_s(&mut out, "\tb 1b\n");
  w_s(&mut out, "2:\tmov x8, #3                 // SYS_SPAWN\n");
  w_s(&mut out, "\tmov x0, x4\n");
  w_s(&mut out, "\tmov x1, x3\n");
  w_s(&mut out, "\tmov x2, #0\n");
  w_s(&mut out, "\tsvc #0\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #80\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_oom:\n");
  w_s(&mut out, "\tbl bst_rt_flush\n");
  w_s(&mut out, "\tmov x8, #1\n");
  w_s(&mut out, "\tadrp x0, .Lrt_oom\n");
  w_s(&mut out, "\tadd x0, x0, :lo12:.Lrt_oom\n");
  w_s(&mut out, "\tmov x1, #22\n");
  w_s(&mut out, "\tmov x2, #0\n");
  w_s(&mut out, "\tsvc #0\n");
  w_s(&mut out, "\tmov x8, #0                  // SYS_EXIT\n");
  w_s(&mut out, "\tmov x0, #255\n");
  w_s(&mut out, "\tsvc #0\n");
  w_s(&mut out, "\tbrk #0\n");
  w_s(&mut out, "\t.set bst_rt_alloc_raw, bst_rt_alloc    // the arena hands out zeroed words either way\n");
  w_s(&mut out, "\t.bss\n");
  w_s(&mut out, "\t.p2align 3\n");
  w_s(&mut out, "bst_rt_out_n:\t.quad 0\n");
  w_s(&mut out, "bst_rt_arena_top:\t.quad 0\n");
  w_s(&mut out, "bst_rt_free_list:\t.quad 0\n");
  w_s(&mut out, "bst_rt_out:\t.zero 256\n");
  w_s(&mut out, "bst_rt_arena:\t.zero 65536\n");
  w_s(&mut out, "\t.section .rodata\n");
  w_s(&mut out, ".Lrt_oom:\n");
  w_s(&mut out, "\t.string \"bastio: out of memory\\n\"\n");
  w_s(&mut out, "\t.text\n");
}

/// The runtime of an AArch64 kernel: the console on a PL011 UART (at the
/// address of `bst_uart_base` when the platform defines one, else QEMU virt's
/// 0x09000000; the baud rate is left as the firmware set it) and a 1 MiB
/// arena for `Buf`. Part of the trusted base; the C prelude's
/// `bst_serial_*` and `bst_arena` are what it replaces.
fn a64_runtime_kernel(out: &mut Vec[u64]) {
  w_s(&mut out, "\n// ---- runtime: AArch64 kernel (trusted base) ----\n");
  w_s(&mut out, "\t.text\n");
  // x9 = the UART's base.
  w_s(&mut out, "bst_rt_serial_init:\n");
  w_s(&mut out, "\tadrp x9, bst_uart_base\n");
  w_s(&mut out, "\tldr x9, [x9, :lo12:bst_uart_base]\n");
  w_s(&mut out, "\tcbnz x9, 1f\n");
  w_s(&mut out, "\tmov x9, #0x9000000\n");
  w_s(&mut out, "1:\tstr wzr, [x9, #0x30]       // off while configuring\n");
  w_s(&mut out, "\tmov w10, #0x70\n");
  w_s(&mut out, "\tstr w10, [x9, #0x2c]         // 8N1, FIFOs on\n");
  w_s(&mut out, "\tmov w10, #0x10\n");
  w_s(&mut out, "\tstr w10, [x9, #0x38]         // interrupt on received data\n");
  w_s(&mut out, "\tmov w10, #0x301\n");
  w_s(&mut out, "\tstr w10, [x9, #0x30]         // on: transmit and receive\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_flush:                   // nothing is buffered\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_putc:                    // write byte x0 to the UART once its FIFO has room\n");
  w_s(&mut out, "\tadrp x9, bst_uart_base\n");
  w_s(&mut out, "\tldr x9, [x9, :lo12:bst_uart_base]\n");
  w_s(&mut out, "\tcbnz x9, 1f\n");
  w_s(&mut out, "\tmov x9, #0x9000000\n");
  w_s(&mut out, "1:\tldr w10, [x9, #0x18]\n");
  w_s(&mut out, "\ttbnz w10, #5, 1b              // transmit FIFO full\n");
  w_s(&mut out, "\tand w0, w0, #0xff\n");
  w_s(&mut out, "\tstr w0, [x9]\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_getc:                    // x0 = the next byte received\n");
  w_s(&mut out, "\tadrp x9, bst_uart_base\n");
  w_s(&mut out, "\tldr x9, [x9, :lo12:bst_uart_base]\n");
  w_s(&mut out, "\tcbnz x9, 1f\n");
  w_s(&mut out, "\tmov x9, #0x9000000\n");
  w_s(&mut out, "1:\tldr w10, [x9, #0x18]\n");
  w_s(&mut out, "\ttbz w10, #4, 2f               // receive FIFO empty: wait\n");
  w_s(&mut out, "\tyield\n");
  w_s(&mut out, "\tb 1b\n");
  w_s(&mut out, "2:\tldr w0, [x9]\n");
  w_s(&mut out, "\tand w0, w0, #0xff\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_serial_poll:             // x0 = the next byte received, or 256 when there is none\n");
  w_s(&mut out, "\tadrp x9, bst_uart_base\n");
  w_s(&mut out, "\tldr x9, [x9, :lo12:bst_uart_base]\n");
  w_s(&mut out, "\tcbnz x9, 1f\n");
  w_s(&mut out, "\tmov x9, #0x9000000\n");
  w_s(&mut out, "1:\tldr w10, [x9, #0x18]\n");
  w_s(&mut out, "\tmov x0, #256\n");
  w_s(&mut out, "\ttbnz w10, #4, 2f              // receive FIFO empty\n");
  w_s(&mut out, "\tldr w0, [x9]\n");
  w_s(&mut out, "\tand w0, w0, #0xff\n");
  w_s(&mut out, "2:\tret\n");
  a64_rt_print(&mut out);
  a64_rt_arena(&mut out, 131072, true);
  a64_rt_pool(&mut out);
  a64_rt_cpu(&mut out);
  w_s(&mut out, "bst_rt_oom:\n");
  w_s(&mut out, "\tadrp x1, .Lrt_oom\n");
  w_s(&mut out, "\tadd x1, x1, :lo12:.Lrt_oom\n");
  w_s(&mut out, "\tmov x2, #22\n");
  w_s(&mut out, "\tbl bst_rt_puts\n");
  w_s(&mut out, "bst_rt_halt:\n");
  w_s(&mut out, "\tmsr daifset, #0xf\n");
  w_s(&mut out, "\twfe\n");
  w_s(&mut out, "\tb bst_rt_halt\n");
  w_s(&mut out, "bst_rt_puts:                    // write the x2 bytes at x1\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-32]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tmov x19, x1\n");
  w_s(&mut out, "\tmov x20, x2\n");
  w_s(&mut out, "1:\tcbz x20, 2f\n");
  w_s(&mut out, "\tldrb w0, [x19], #1\n");
  w_s(&mut out, "\tbl bst_rt_putc\n");
  w_s(&mut out, "\tsub x20, x20, #1\n");
  w_s(&mut out, "\tb 1b\n");
  w_s(&mut out, "2:\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #32\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_puthex:                  // write \"0x\" and x0 as 16 hex digits\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-32]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tmov w0, #48\n");
  w_s(&mut out, "\tbl bst_rt_putc\n");
  w_s(&mut out, "\tmov w0, #120\n");
  w_s(&mut out, "\tbl bst_rt_putc\n");
  w_s(&mut out, "\tmov x20, #60\n");
  w_s(&mut out, "1:\tlsr x0, x19, x20\n");
  w_s(&mut out, "\tand w0, w0, #15\n");
  w_s(&mut out, "\tcmp w0, #10\n");
  w_s(&mut out, "\tb.lo 2f\n");
  w_s(&mut out, "\tadd w0, w0, #39               // 'a' - '0' - 10\n");
  w_s(&mut out, "2:\tadd w0, w0, #48\n");
  w_s(&mut out, "\tbl bst_rt_putc\n");
  w_s(&mut out, "\tsubs x20, x20, #4\n");
  w_s(&mut out, "\tb.ge 1b\n");
  w_s(&mut out, "\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #32\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "\t.globl bst_kernel_fault       // called by the platform on a fault in kernel mode (x0 vector, x1 pc, x2 far, x3 esr)\n");
  w_s(&mut out, "bst_kernel_fault:\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-48]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x0, x1, [sp, #16]\n");
  w_s(&mut out, "\tstp x2, x3, [sp, #32]\n");
  w_s(&mut out, "\tadrp x1, .Lrt_fault1\n");
  w_s(&mut out, "\tadd x1, x1, :lo12:.Lrt_fault1\n");
  w_s(&mut out, "\tmov x2, #30\n");
  w_s(&mut out, "\tbl bst_rt_puts\n");
  w_s(&mut out, "\tldr x0, [sp, #16]\n");
  w_s(&mut out, "\tbl bst_rt_puthex\n");
  w_s(&mut out, "\tadrp x1, .Lrt_fault2\n");
  w_s(&mut out, "\tadd x1, x1, :lo12:.Lrt_fault2\n");
  w_s(&mut out, "\tmov x2, #4\n");
  w_s(&mut out, "\tbl bst_rt_puts\n");
  w_s(&mut out, "\tldr x0, [sp, #24]\n");
  w_s(&mut out, "\tbl bst_rt_puthex\n");
  w_s(&mut out, "\tadrp x1, .Lrt_fault3\n");
  w_s(&mut out, "\tadd x1, x1, :lo12:.Lrt_fault3\n");
  w_s(&mut out, "\tmov x2, #5\n");
  w_s(&mut out, "\tbl bst_rt_puts\n");
  w_s(&mut out, "\tldr x0, [sp, #32]\n");
  w_s(&mut out, "\tbl bst_rt_puthex\n");
  w_s(&mut out, "\tadrp x1, .Lrt_fault4\n");
  w_s(&mut out, "\tadd x1, x1, :lo12:.Lrt_fault4\n");
  w_s(&mut out, "\tmov x2, #5\n");
  w_s(&mut out, "\tbl bst_rt_puts\n");
  w_s(&mut out, "\tldr x0, [sp, #40]\n");
  w_s(&mut out, "\tbl bst_rt_puthex\n");
  w_s(&mut out, "\tmov w0, #10\n");
  w_s(&mut out, "\tbl bst_rt_putc\n");
  w_s(&mut out, "\tb bst_rt_halt\n");
  w_s(&mut out, "\t.set bst_rt_alloc_raw, bst_rt_alloc    // the arena hands out zeroed words either way\n");
  w_s(&mut out, "\t.data\n");
  w_s(&mut out, "\t.p2align 3\n");
  w_s(&mut out, "\t.weak bst_platform_mmu_state\n");
  w_s(&mut out, "\t.weak bst_platform_table_free\n");
  w_s(&mut out, "\t.weak bst_platform_deferred_ttbr0   // defined by a platform that loads user tables from a trampoline\n");
  w_s(&mut out, "\t.weak bst_ram_limit            // where the platform's map of RAM stops, if it says\n");
  w_s(&mut out, "\t.weak bst_uart_base           // a platform with the UART elsewhere defines its own\n");
  w_s(&mut out, "bst_uart_base:\t.quad 0x9000000\n");
  w_s(&mut out, "bst_rt_deferred_ptr:\t.quad bst_platform_deferred_ttbr0   // 0 for a platform without it (an adrp of a weak symbol is not 0)\n");
  w_s(&mut out, "bst_rt_mmu_state_ptr:\t.quad bst_platform_mmu_state\n");
  w_s(&mut out, "bst_rt_table_free_ptr:\t.quad bst_platform_table_free\n");
  w_s(&mut out, "bst_rt_ram_limit_ptr:\t.quad bst_ram_limit\n");
  w_s(&mut out, "\t.bss\n");
  w_s(&mut out, "\t.p2align 3\n");
  w_s(&mut out, "bst_rt_mbi:\t.quad 0\n");
  w_s(&mut out, "bst_rt_arena_top:\t.quad 0\n");
  w_s(&mut out, "bst_rt_free_list:\t.quad 0\n");
  w_s(&mut out, "bst_rt_arena:\t.zero 1048576\n");
  w_s(&mut out, "bst_rt_pt_gen:\t.quad 0\n");
  w_s(&mut out, "bst_rt_arena2:\t.quad 0\n");
  w_s(&mut out, "bst_rt_arena2_words:\t.quad 0\n");
  w_s(&mut out, "bst_rt_arena2_top:\t.quad 0\n");
  w_s(&mut out, "bst_rt_runs:\t.quad 0\n");
  w_s(&mut out, "bst_rt_carved_lo:\t.quad 0\n");
  w_s(&mut out, "bst_rt_carved_hi:\t.quad 0\n");
  w_s(&mut out, "bst_rt_pt_leases:\t.quad 0\n");
  w_s(&mut out, "bst_rt_shared_refs:\t.quad 0\n");
  w_s(&mut out, "bst_rt_run_at:\t.zero 256\n");
  w_s(&mut out, "bst_rt_run_id:\t.zero 264\n");
  w_s(&mut out, "\t.section .rodata\n");
  w_s(&mut out, ".Lrt_oom:\n");
  w_s(&mut out, "\t.string \"bastio: out of memory\\n\"\n");
  w_s(&mut out, ".Lrt_mmio:\n");
  w_s(&mut out, "\t.ascii \"bastio: mmio_claim of RAM at \"\n");
  w_s(&mut out, ".Lrt_fault1:\n");
  w_s(&mut out, "\t.ascii \"\\nbastio: kernel fault, vector \"\n");
  w_s(&mut out, ".Lrt_fault2:\n");
  w_s(&mut out, "\t.ascii \" pc \"\n");
  w_s(&mut out, ".Lrt_fault3:\n");
  w_s(&mut out, "\t.ascii \" far \"\n");
  w_s(&mut out, ".Lrt_fault4:\n");
  w_s(&mut out, "\t.ascii \" esr \"\n");
  w_s(&mut out, "\t.text\n");
}

/// The allocator's fallible calls, the Vec reserve and the console, over the C library.
fn a64_runtime_alloc(out: &mut Vec[u64]) {
  w_s(&mut out, "\t.text\n");
  w_s(&mut out, "bst_rt_try_alloc:               // x0 = x0 zeroed words, or 0 when out of memory\n");
  w_s(&mut out, "\tmov x1, #8\n");
  w_s(&mut out, "\tb 1f\n");
  w_s(&mut out, "bst_rt_try_balloc:              // x0 = x0 zeroed bytes, or 0 when out of memory\n");
  w_s(&mut out, "\tmov x1, #1\n");
  w_s(&mut out, "1:\tstp x29, x30, [sp, #-16]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tcbnz x0, 2f\n");
  w_s(&mut out, "\tmov x0, #1\n");
  w_s(&mut out, "2:\tbl calloc\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #16\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_alloc_raw:               // x0 = x0 words (at least one), not zeroed: the caller writes all of them\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-16]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tcbnz x0, 1f\n");
  w_s(&mut out, "\tmov x0, #1\n");
  w_s(&mut out, "1:\tlsl x0, x0, #3\n");
  w_s(&mut out, "\tbl malloc\n");
  w_s(&mut out, "\tcbz x0, bst_rt_oom\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #16\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_vec_try_reserve:         // room for x1 more elements of x2 bytes in the Vec at (x0): w0 = 1, or 0 and unchanged\n");
  w_s(&mut out, "\tldr x3, [x0, #8]\n");
  w_s(&mut out, "\tldr x4, [x0]\n");
  w_s(&mut out, "\tsub x3, x3, x4\n");
  w_s(&mut out, "\tcmp x3, x1\n");
  w_s(&mut out, "\tb.lo 1f\n");
  w_s(&mut out, "\tmov w0, #1\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "1:\tstp x29, x30, [sp, #-48]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tstp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tmov x20, x2\n");
  w_s(&mut out, "\tmov x21, x1\n");
  w_s(&mut out, "\tmov x3, #1                  // lim = 2^60 / size: the capacity stays at most 2^60\n");
  w_s(&mut out, "\tlsl x3, x3, #60\n");
  w_s(&mut out, "\tudiv x3, x3, x20\n");
  w_s(&mut out, "\tldr x4, [x19]\n");
  w_s(&mut out, "\tcmp x4, x3\n");
  w_s(&mut out, "\tb.hi 3f\n");
  w_s(&mut out, "\tsub x5, x3, x4\n");
  w_s(&mut out, "\tcmp x21, x5\n");
  w_s(&mut out, "\tb.hi 3f\n");
  w_s(&mut out, "\tadd x22, x4, x21            // new capacity: len + k, or double when that is more and fits\n");
  w_s(&mut out, "\tldr x6, [x19, #8]\n");
  w_s(&mut out, "\tlsr x3, x3, #1\n");
  w_s(&mut out, "\tcmp x6, x3\n");
  w_s(&mut out, "\tb.hi 2f\n");
  w_s(&mut out, "\tadd x6, x6, x6\n");
  w_s(&mut out, "\tcmp x6, x22\n");
  w_s(&mut out, "\tb.ls 2f\n");
  w_s(&mut out, "\tmov x22, x6\n");
  w_s(&mut out, "2:\tmul x1, x22, x20\n");
  w_s(&mut out, "\tldr x0, [x19, #16]\n");
  w_s(&mut out, "\tbl realloc\n");
  w_s(&mut out, "\tcbz x0, 3f\n");
  w_s(&mut out, "\tstr x0, [x19, #16]\n");
  w_s(&mut out, "\tstr x22, [x19, #8]\n");
  w_s(&mut out, "\tmov w0, #1\n");
  w_s(&mut out, "\tb 4f\n");
  w_s(&mut out, "3:\tmov w0, #0\n");
  w_s(&mut out, "4:\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #48\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_putc:                    // write byte x0 to stdout; flush at a newline\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-32]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstr x19, [sp, #16]\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tand w0, w0, #0xff\n");
  w_s(&mut out, "\tbl putchar\n");
  w_s(&mut out, "\tcmp x19, #10\n");
  w_s(&mut out, "\tb.ne 1f\n");
  w_s(&mut out, "\tadrp x1, :got:stdout\n");
  w_s(&mut out, "\tldr x1, [x1, :got_lo12:stdout]\n");
  w_s(&mut out, "\tldr x0, [x1]\n");
  w_s(&mut out, "\tbl fflush\n");
  w_s(&mut out, "1:\tldr x19, [sp, #16]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #32\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_getc:                    // x0 = next byte of stdin, 4 at the end\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-16]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tadrp x1, :got:stdout\n");
  w_s(&mut out, "\tldr x1, [x1, :got_lo12:stdout]\n");
  w_s(&mut out, "\tldr x0, [x1]\n");
  w_s(&mut out, "\tbl fflush\n");
  w_s(&mut out, "\tbl getchar\n");
  w_s(&mut out, "\tcmn w0, #1\n");
  w_s(&mut out, "\tb.ne 1f\n");
  w_s(&mut out, "\tmov w0, #4\n");
  w_s(&mut out, "1:\tsxtw x0, w0\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #16\n");
  w_s(&mut out, "\tret\n");
}

/// The hosted target's files, environment and arguments, over the C library.
fn a64_runtime_host(out: &mut Vec[u64]) {
  w_s(&mut out, "\t.text\n");
  w_s(&mut out, "bst_rt_host_arg:                // argument x0 as Bytes: x0 = data, x1 = len\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-32]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tadrp x2, bst_rt_argc\n");
  w_s(&mut out, "\tldrsw x2, [x2, :lo12:bst_rt_argc]\n");
  w_s(&mut out, "\tcmp x0, x2\n");
  w_s(&mut out, "\tb.lo 1f\n");
  w_s(&mut out, "\tmov x0, #0                  // past the end: empty\n");
  w_s(&mut out, "\tbl bst_rt_balloc\n");
  w_s(&mut out, "\tmov x1, #0\n");
  w_s(&mut out, "\tb 2f\n");
  w_s(&mut out, "1:\tadrp x2, bst_rt_argv\n");
  w_s(&mut out, "\tldr x2, [x2, :lo12:bst_rt_argv]\n");
  w_s(&mut out, "\tldr x19, [x2, x0, lsl #3]\n");
  w_s(&mut out, "\tmov x0, x19\n");
  w_s(&mut out, "\tbl strlen\n");
  w_s(&mut out, "\tmov x20, x0\n");
  w_s(&mut out, "\tbl bst_rt_balloc\n");
  w_s(&mut out, "\tmov x1, x19\n");
  w_s(&mut out, "\tmov x2, x20\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tbl memcpy\n");
  w_s(&mut out, "\tmov x0, x19\n");
  w_s(&mut out, "\tmov x1, x20\n");
  w_s(&mut out, "2:\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #32\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_cpath:                   // x0 = a NUL-terminated copy of the x1 bytes at x0 (a NUL inside ends the path)\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-32]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tmov x20, x1\n");
  w_s(&mut out, "\tadd x0, x1, #1\n");
  w_s(&mut out, "\tbl malloc\n");
  w_s(&mut out, "\tcbz x0, bst_rt_oom\n");
  w_s(&mut out, "\tmov x1, x19\n");
  w_s(&mut out, "\tmov x2, x20\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tbl memcpy\n");
  w_s(&mut out, "\tstrb wzr, [x19, x20]\n");
  w_s(&mut out, "\tmov x0, x19\n");
  w_s(&mut out, "\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #32\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_host_read:               // read the file named by x0/x1 into the Bytes at (x2); x0 = 1 if it worked\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-64]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tstp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tstp x23, x24, [sp, #48]\n");
  w_s(&mut out, "\tmov x19, x2\n");
  w_s(&mut out, "\tbl bst_rt_cpath\n");
  w_s(&mut out, "\tmov x21, x0\n");
  w_s(&mut out, "\tmov x1, #0                  // O_RDONLY\n");
  w_s(&mut out, "\tbl open\n");
  w_s(&mut out, "\tsxtw x20, w0\n");
  w_s(&mut out, "\tmov x0, x21\n");
  w_s(&mut out, "\tbl free\n");
  w_s(&mut out, "\ttbnz x20, #63, 8f\n");
  w_s(&mut out, "\tmov x23, #4096              // capacity, doubled when full\n");
  w_s(&mut out, "\tmov x0, x23\n");
  w_s(&mut out, "\tbl malloc\n");
  w_s(&mut out, "\tcbz x0, bst_rt_oom\n");
  w_s(&mut out, "\tmov x22, x0\n");
  w_s(&mut out, "\tmov x24, #0                 // bytes read\n");
  w_s(&mut out, "1:\tmov x0, x20\n");
  w_s(&mut out, "\tadd x1, x22, x24\n");
  w_s(&mut out, "\tsub x2, x23, x24\n");
  w_s(&mut out, "\tbl read\n");
  w_s(&mut out, "\tcmp x0, #0\n");
  w_s(&mut out, "\tb.lt 3f\n");
  w_s(&mut out, "\tb.eq 4f\n");
  w_s(&mut out, "\tadd x24, x24, x0\n");
  w_s(&mut out, "\tcmp x24, x23\n");
  w_s(&mut out, "\tb.ne 1b\n");
  w_s(&mut out, "\tadd x23, x23, x23\n");
  w_s(&mut out, "\tmov x0, x22\n");
  w_s(&mut out, "\tmov x1, x23\n");
  w_s(&mut out, "\tbl realloc\n");
  w_s(&mut out, "\tcbz x0, bst_rt_oom\n");
  w_s(&mut out, "\tmov x22, x0\n");
  w_s(&mut out, "\tb 1b\n");
  w_s(&mut out, "3:\tmov x0, x20                 // a read error: nothing changes\n");
  w_s(&mut out, "\tbl close\n");
  w_s(&mut out, "\tmov x0, x22\n");
  w_s(&mut out, "\tbl free\n");
  w_s(&mut out, "\tb 8f\n");
  w_s(&mut out, "4:\tmov x0, x20\n");
  w_s(&mut out, "\tbl close\n");
  w_s(&mut out, "\tldr x0, [x19, #8]           // replace the old contents\n");
  w_s(&mut out, "\tbl free\n");
  w_s(&mut out, "\tstr x24, [x19]\n");
  w_s(&mut out, "\tstr x22, [x19, #8]\n");
  w_s(&mut out, "\tmov x0, #1\n");
  w_s(&mut out, "\tb 9f\n");
  w_s(&mut out, "8:\tmov x0, #0\n");
  w_s(&mut out, "9:\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tldp x23, x24, [sp, #48]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #64\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_host_write:              // write the x3 bytes at x2 to the file named by x0/x1; x0 = 1 if it worked\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-64]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tstp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tstr x23, [sp, #48]\n");
  w_s(&mut out, "\tmov x19, x2\n");
  w_s(&mut out, "\tmov x22, x3\n");
  w_s(&mut out, "\tbl bst_rt_cpath\n");
  w_s(&mut out, "\tmov x21, x0\n");
  w_s(&mut out, "\tmov w1, #0x241              // O_WRONLY | O_CREAT | O_TRUNC\n");
  w_s(&mut out, "\tmov w2, #0x1b6              // 0666\n");
  w_s(&mut out, "\tbl open\n");
  w_s(&mut out, "\tsxtw x20, w0\n");
  w_s(&mut out, "\tmov x0, x21\n");
  w_s(&mut out, "\tbl free\n");
  w_s(&mut out, "\ttbnz x20, #63, 8f\n");
  w_s(&mut out, "\tmov x23, #0                 // bytes written\n");
  w_s(&mut out, "1:\tcmp x23, x22\n");
  w_s(&mut out, "\tb.hs 4f\n");
  w_s(&mut out, "\tmov x0, x20\n");
  w_s(&mut out, "\tadd x1, x19, x23\n");
  w_s(&mut out, "\tsub x2, x22, x23\n");
  w_s(&mut out, "\tbl write\n");
  w_s(&mut out, "\tcmp x0, #0\n");
  w_s(&mut out, "\tb.le 3f\n");
  w_s(&mut out, "\tadd x23, x23, x0\n");
  w_s(&mut out, "\tb 1b\n");
  w_s(&mut out, "3:\tmov x0, x20\n");
  w_s(&mut out, "\tbl close\n");
  w_s(&mut out, "\tb 8f\n");
  w_s(&mut out, "4:\tmov x0, x20\n");
  w_s(&mut out, "\tbl close\n");
  w_s(&mut out, "\tcbnz w0, 8f\n");
  w_s(&mut out, "\tmov x0, #1\n");
  w_s(&mut out, "\tb 9f\n");
  w_s(&mut out, "8:\tmov x0, #0\n");
  w_s(&mut out, "9:\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tldr x23, [sp, #48]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #64\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_host_env:                // the variable named by the x1 bytes at x0 into the Bytes at (x2); x0 = 1 if it is set\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-64]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tstp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tstr x23, [sp, #48]\n");
  w_s(&mut out, "\tmov x19, x2\n");
  w_s(&mut out, "\tbl bst_rt_cpath\n");
  w_s(&mut out, "\tmov x20, x0\n");
  w_s(&mut out, "\tbl getenv\n");
  w_s(&mut out, "\tmov x21, x0\n");
  w_s(&mut out, "\tmov x0, x20\n");
  w_s(&mut out, "\tbl free\n");
  w_s(&mut out, "\tcbz x21, 8f\n");
  w_s(&mut out, "\tmov x0, x21\n");
  w_s(&mut out, "\tbl strlen\n");
  w_s(&mut out, "\tmov x22, x0\n");
  w_s(&mut out, "\tbl bst_rt_balloc\n");
  w_s(&mut out, "\tmov x23, x0\n");
  w_s(&mut out, "\tmov x1, x21\n");
  w_s(&mut out, "\tmov x2, x22\n");
  w_s(&mut out, "\tbl memcpy\n");
  w_s(&mut out, "\tldr x0, [x19, #8]           // replace the old contents\n");
  w_s(&mut out, "\tbl bst_rt_free\n");
  w_s(&mut out, "\tstr x22, [x19]\n");
  w_s(&mut out, "\tstr x23, [x19, #8]\n");
  w_s(&mut out, "\tmov x0, #1\n");
  w_s(&mut out, "\tb 9f\n");
  w_s(&mut out, "8:\tmov x0, #0\n");
  w_s(&mut out, "9:\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tldr x23, [sp, #48]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #64\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_host_cpus:               // x0 = the processors online (at least 1)\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-16]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tmov x0, #84                 // _SC_NPROCESSORS_ONLN\n");
  w_s(&mut out, "\tbl sysconf\n");
  w_s(&mut out, "\tcmp x0, #1\n");
  w_s(&mut out, "\tb.ge 1f\n");
  w_s(&mut out, "\tmov x0, #1\n");
  w_s(&mut out, "1:\tldp x29, x30, [sp], #16\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_eprint:                  // write the x1 bytes at x0 to stderr, after flushing stdout\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-32]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tmov x20, x1\n");
  w_s(&mut out, "\tadrp x2, :got:stdout\n");
  w_s(&mut out, "\tldr x2, [x2, :got_lo12:stdout]\n");
  w_s(&mut out, "\tldr x0, [x2]\n");
  w_s(&mut out, "\tbl fflush\n");
  w_s(&mut out, "\tmov x0, x19\n");
  w_s(&mut out, "\tmov x1, #1\n");
  w_s(&mut out, "\tmov x2, x20\n");
  w_s(&mut out, "\tadrp x3, :got:stderr\n");
  w_s(&mut out, "\tldr x3, [x3, :got_lo12:stderr]\n");
  w_s(&mut out, "\tldr x3, [x3]\n");
  w_s(&mut out, "\tbl fwrite\n");
  w_s(&mut out, "\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #32\n");
  w_s(&mut out, "\tret\n");
}

/// The hosted target's child processes, over the C library.
fn a64_runtime_child(out: &mut Vec[u64]) {
  w_s(&mut out, "\t.text\n");
  w_s(&mut out, "// A Child is three words: process id, the pipe to its input, and its output\n");
  w_s(&mut out, "// (a FILE *). One that cannot be started is -1, -1, 0, and behaves like one\n");
  w_s(&mut out, "// that exited with 127 without output.\n");
  w_s(&mut out, "bst_rt_spawn:                   // run the x2 Bytes at x0 (argv): x0 = output, x1 = input, x2 = pid\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-192]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tstp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tstp x23, x24, [sp, #48]\n");
  w_s(&mut out, "\tstr x25, [sp, #64]          // sp+80: to[2]; sp+88: from[2]; sp+96: pid; sp+104: file actions\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tmov x20, x2\n");
  w_s(&mut out, "\tmov x21, #-1\n");
  w_s(&mut out, "\tmov x22, #-1\n");
  w_s(&mut out, "\tmov x23, #0\n");
  w_s(&mut out, "\tcbz x20, 9f\n");
  w_s(&mut out, "\tadd x0, sp, #80\n");
  w_s(&mut out, "\tbl pipe\n");
  w_s(&mut out, "\tcbnz w0, 9f\n");
  w_s(&mut out, "\tadd x0, sp, #88\n");
  w_s(&mut out, "\tbl pipe\n");
  w_s(&mut out, "\tcbz w0, 1f\n");
  w_s(&mut out, "\tldrsw x0, [sp, #80]\n");
  w_s(&mut out, "\tbl close\n");
  w_s(&mut out, "\tldrsw x0, [sp, #84]\n");
  w_s(&mut out, "\tbl close\n");
  w_s(&mut out, "\tb 9f\n");
  w_s(&mut out, "1:\tldrsw x0, [sp, #84]         // the parent's ends are not inherited by later children,\n");
  w_s(&mut out, "\tmov x1, #2                  // so closing a child's input reaches it as end of file\n");
  w_s(&mut out, "\tmov x2, #1                  // (F_SETFD, FD_CLOEXEC)\n");
  w_s(&mut out, "\tbl fcntl\n");
  w_s(&mut out, "\tldrsw x0, [sp, #88]\n");
  w_s(&mut out, "\tmov x1, #2\n");
  w_s(&mut out, "\tmov x2, #1\n");
  w_s(&mut out, "\tbl fcntl\n");
  w_s(&mut out, "\tlsl x0, x20, #3             // argv for execvp, NULL-terminated\n");
  w_s(&mut out, "\tadd x0, x0, #8\n");
  w_s(&mut out, "\tbl malloc\n");
  w_s(&mut out, "\tcbz x0, bst_rt_oom\n");
  w_s(&mut out, "\tmov x24, x0\n");
  w_s(&mut out, "\tmov x25, #0\n");
  w_s(&mut out, "2:\tcmp x25, x20\n");
  w_s(&mut out, "\tb.hs 3f\n");
  w_s(&mut out, "\tlsl x2, x25, #4\n");
  w_s(&mut out, "\tadd x2, x19, x2\n");
  w_s(&mut out, "\tldr x0, [x2, #8]\n");
  w_s(&mut out, "\tldr x1, [x2]\n");
  w_s(&mut out, "\tbl bst_rt_cpath\n");
  w_s(&mut out, "\tstr x0, [x24, x25, lsl #3]\n");
  w_s(&mut out, "\tadd x25, x25, #1\n");
  w_s(&mut out, "\tb 2b\n");
  w_s(&mut out, "3:\tstr xzr, [x24, x20, lsl #3]\n");
  w_s(&mut out, "\tmov x0, #0\n");
  w_s(&mut out, "\tbl fflush\n");
  w_s(&mut out, "\tmov w0, #-1                 // posix_spawnp, not fork: the parent's memory is never copied\n");
  w_s(&mut out, "\tstr w0, [sp, #96]\n");
  w_s(&mut out, "\tadd x0, sp, #104\n");
  w_s(&mut out, "\tbl posix_spawn_file_actions_init\n");
  w_s(&mut out, "\tcbnz w0, 4f\n");
  w_s(&mut out, "\tadd x0, sp, #104            // to[0] becomes 0, from[1] becomes 1\n");
  w_s(&mut out, "\tldr w1, [sp, #80]\n");
  w_s(&mut out, "\tmov w2, #0\n");
  w_s(&mut out, "\tbl posix_spawn_file_actions_adddup2\n");
  w_s(&mut out, "\tmov w25, w0\n");
  w_s(&mut out, "\tadd x0, sp, #104\n");
  w_s(&mut out, "\tldr w1, [sp, #92]\n");
  w_s(&mut out, "\tmov w2, #1\n");
  w_s(&mut out, "\tbl posix_spawn_file_actions_adddup2\n");
  w_s(&mut out, "\torr w25, w25, w0\n");
  w_s(&mut out, "\tadd x0, sp, #104\n");
  w_s(&mut out, "\tldr w1, [sp, #80]\n");
  w_s(&mut out, "\tbl posix_spawn_file_actions_addclose\n");
  w_s(&mut out, "\torr w25, w25, w0\n");
  w_s(&mut out, "\tadd x0, sp, #104\n");
  w_s(&mut out, "\tldr w1, [sp, #92]\n");
  w_s(&mut out, "\tbl posix_spawn_file_actions_addclose\n");
  w_s(&mut out, "\torr w25, w25, w0\n");
  w_s(&mut out, "\tcbnz w25, 10f\n");
  w_s(&mut out, "\tadd x0, sp, #96\n");
  w_s(&mut out, "\tldr x1, [x24]\n");
  w_s(&mut out, "\tadd x2, sp, #104\n");
  w_s(&mut out, "\tmov x3, #0\n");
  w_s(&mut out, "\tmov x4, x24\n");
  w_s(&mut out, "\tadrp x5, :got:environ\n");
  w_s(&mut out, "\tldr x5, [x5, :got_lo12:environ]\n");
  w_s(&mut out, "\tldr x5, [x5]\n");
  w_s(&mut out, "\tbl posix_spawnp\n");
  w_s(&mut out, "\tcbz w0, 10f\n");
  w_s(&mut out, "\tmov w0, #-1                 // not started\n");
  w_s(&mut out, "\tstr w0, [sp, #96]\n");
  w_s(&mut out, "10:\tadd x0, sp, #104\n");
  w_s(&mut out, "\tbl posix_spawn_file_actions_destroy\n");
  w_s(&mut out, "4:\tldrsw x21, [sp, #96]\n");
  w_s(&mut out, "\tmov x25, #0\n");
  w_s(&mut out, "5:\tcmp x25, x20\n");
  w_s(&mut out, "\tb.hs 6f\n");
  w_s(&mut out, "\tldr x0, [x24, x25, lsl #3]\n");
  w_s(&mut out, "\tbl free\n");
  w_s(&mut out, "\tadd x25, x25, #1\n");
  w_s(&mut out, "\tb 5b\n");
  w_s(&mut out, "6:\tmov x0, x24\n");
  w_s(&mut out, "\tbl free\n");
  w_s(&mut out, "\tldrsw x0, [sp, #80]\n");
  w_s(&mut out, "\tbl close\n");
  w_s(&mut out, "\tldrsw x0, [sp, #92]\n");
  w_s(&mut out, "\tbl close\n");
  w_s(&mut out, "\tmov x22, #-1\n");
  w_s(&mut out, "\tmov x23, #0\n");
  w_s(&mut out, "\ttbz x21, #63, 7f\n");
  w_s(&mut out, "\tldrsw x0, [sp, #84]         // no process\n");
  w_s(&mut out, "\tbl close\n");
  w_s(&mut out, "\tldrsw x0, [sp, #88]\n");
  w_s(&mut out, "\tbl close\n");
  w_s(&mut out, "\tmov x21, #-1\n");
  w_s(&mut out, "\tb 9f\n");
  w_s(&mut out, "7:\tmov w0, #13                 // SIGPIPE ignored: writing to a child that has exited fails instead\n");
  w_s(&mut out, "\tmov x1, #1\n");
  w_s(&mut out, "\tbl signal\n");
  w_s(&mut out, "\tldrsw x22, [sp, #84]\n");
  w_s(&mut out, "\tldrsw x0, [sp, #88]\n");
  w_s(&mut out, "\tadrp x1, .Lrt_rb\n");
  w_s(&mut out, "\tadd x1, x1, :lo12:.Lrt_rb\n");
  w_s(&mut out, "\tbl fdopen\n");
  w_s(&mut out, "\tcbz x0, bst_rt_oom\n");
  w_s(&mut out, "\tmov x23, x0\n");
  w_s(&mut out, "9:\tmov x0, x23\n");
  w_s(&mut out, "\tmov x1, x22\n");
  w_s(&mut out, "\tmov x2, x21\n");
  w_s(&mut out, "\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tldp x23, x24, [sp, #48]\n");
  w_s(&mut out, "\tldr x25, [sp, #64]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #192\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_child_write:             // write the x1 bytes at x0 to the Child at (x2); x0 = 1 if it worked\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-48]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tstp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tldr x19, [x2, #8]\n");
  w_s(&mut out, "\tmov x20, x0\n");
  w_s(&mut out, "\tmov x21, x1\n");
  w_s(&mut out, "\tmov x22, #0\n");
  w_s(&mut out, "\ttbnz x19, #63, 8f\n");
  w_s(&mut out, "1:\tcmp x22, x21\n");
  w_s(&mut out, "\tb.hs 4f\n");
  w_s(&mut out, "\tmov x0, x19\n");
  w_s(&mut out, "\tadd x1, x20, x22\n");
  w_s(&mut out, "\tsub x2, x21, x22\n");
  w_s(&mut out, "\tbl write\n");
  w_s(&mut out, "\tcmp x0, #0\n");
  w_s(&mut out, "\tb.le 8f\n");
  w_s(&mut out, "\tadd x22, x22, x0\n");
  w_s(&mut out, "\tb 1b\n");
  w_s(&mut out, "4:\tmov x0, #1\n");
  w_s(&mut out, "\tb 9f\n");
  w_s(&mut out, "8:\tmov x0, #0\n");
  w_s(&mut out, "9:\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #48\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_child_close:             // close the input of the Child at (x0)\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-32]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstr x19, [sp, #16]\n");
  w_s(&mut out, "\tmov x19, x0\n");
  w_s(&mut out, "\tldr x0, [x19, #8]\n");
  w_s(&mut out, "\ttbnz x0, #63, 1f\n");
  w_s(&mut out, "\tbl close\n");
  w_s(&mut out, "\tmov x0, #-1\n");
  w_s(&mut out, "\tstr x0, [x19, #8]\n");
  w_s(&mut out, "1:\tldr x19, [sp, #16]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #32\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_child_read_line:         // the next line of the Child at (x0) into the Bytes at (x1); x0 = 1 if there was one\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-64]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tstp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tstr x23, [sp, #48]\n");
  w_s(&mut out, "\tldr x19, [x0, #16]\n");
  w_s(&mut out, "\tmov x20, x1\n");
  w_s(&mut out, "\tcbz x19, 8f\n");
  w_s(&mut out, "\tmov x22, #64                // capacity, doubled when full\n");
  w_s(&mut out, "\tmov x0, x22\n");
  w_s(&mut out, "\tbl malloc\n");
  w_s(&mut out, "\tcbz x0, bst_rt_oom\n");
  w_s(&mut out, "\tmov x21, x0\n");
  w_s(&mut out, "\tmov x23, #0                 // bytes in the line\n");
  w_s(&mut out, "1:\tcmp x22, x23\n");
  w_s(&mut out, "\tb.ne 2f\n");
  w_s(&mut out, "\tadd x22, x22, x22\n");
  w_s(&mut out, "\tmov x0, x21\n");
  w_s(&mut out, "\tmov x1, x22\n");
  w_s(&mut out, "\tbl realloc\n");
  w_s(&mut out, "\tcbz x0, bst_rt_oom\n");
  w_s(&mut out, "\tmov x21, x0\n");
  w_s(&mut out, "2:\tmov x0, x19\n");
  w_s(&mut out, "\tbl getc\n");
  w_s(&mut out, "\tcmn w0, #1\n");
  w_s(&mut out, "\tb.eq 3f\n");
  w_s(&mut out, "\tcmp w0, #10\n");
  w_s(&mut out, "\tb.eq 4f\n");
  w_s(&mut out, "\tstrb w0, [x21, x23]\n");
  w_s(&mut out, "\tadd x23, x23, #1\n");
  w_s(&mut out, "\tb 1b\n");
  w_s(&mut out, "3:\tcbnz x23, 4f                // the end: a last line without a newline, or none\n");
  w_s(&mut out, "\tmov x0, x21\n");
  w_s(&mut out, "\tbl free\n");
  w_s(&mut out, "\tb 8f\n");
  w_s(&mut out, "4:\tldr x0, [x20, #8]           // replace the old contents\n");
  w_s(&mut out, "\tbl free\n");
  w_s(&mut out, "\tstr x23, [x20]\n");
  w_s(&mut out, "\tstr x21, [x20, #8]\n");
  w_s(&mut out, "\tmov x0, #1\n");
  w_s(&mut out, "\tb 9f\n");
  w_s(&mut out, "8:\tmov x0, #0\n");
  w_s(&mut out, "9:\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x21, x22, [sp, #32]\n");
  w_s(&mut out, "\tldr x23, [sp, #48]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #64\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_child_wait:              // wait for the Child x2 (pid), x1 (input), x0 (output): x0 = its exit status\n");
  w_s(&mut out, "\tstp x29, x30, [sp, #-48]!\n");
  w_s(&mut out, "\tmov x29, sp\n");
  w_s(&mut out, "\tstp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tmov x19, x2\n");
  w_s(&mut out, "\tmov x20, x0\n");
  w_s(&mut out, "\ttbnz x1, #63, 1f\n");
  w_s(&mut out, "\tmov x0, x1\n");
  w_s(&mut out, "\tbl close\n");
  w_s(&mut out, "1:\tcbz x20, 2f\n");
  w_s(&mut out, "\tmov x0, x20\n");
  w_s(&mut out, "\tbl fclose\n");
  w_s(&mut out, "2:\ttbz x19, #63, 3f\n");
  w_s(&mut out, "\tmov x0, #127\n");
  w_s(&mut out, "\tb 9f\n");
  w_s(&mut out, "3:\tmov w0, w19\n");
  w_s(&mut out, "\tadd x1, sp, #32\n");
  w_s(&mut out, "\tmov w2, #0\n");
  w_s(&mut out, "\tbl waitpid\n");
  w_s(&mut out, "\tcmp w0, #0\n");
  w_s(&mut out, "\tb.lt 3b\n");
  w_s(&mut out, "\tldr w0, [sp, #32]\n");
  w_s(&mut out, "\tand w1, w0, #0x7f\n");
  w_s(&mut out, "\tcbnz w1, 4f\n");
  w_s(&mut out, "\tlsr w0, w0, #8              // exited: its status\n");
  w_s(&mut out, "\tand w0, w0, #0xff\n");
  w_s(&mut out, "\tb 9f\n");
  w_s(&mut out, "4:\tcmp w1, #0x7f\n");
  w_s(&mut out, "\tb.eq 5f\n");
  w_s(&mut out, "\tadd w0, w1, #128            // killed by a signal: 128 + the signal\n");
  w_s(&mut out, "\tb 9f\n");
  w_s(&mut out, "5:\tmov w0, #255\n");
  w_s(&mut out, "9:\tldp x19, x20, [sp, #16]\n");
  w_s(&mut out, "\tldp x29, x30, [sp], #48\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "\t.section .rodata\n");
  w_s(&mut out, ".Lrt_rb:\n");
  w_s(&mut out, "\t.string \"rb\"\n");
  w_s(&mut out, "\t.bss\n");
  w_s(&mut out, "\t.p2align 3\n");
  w_s(&mut out, "bst_rt_argc:\n");
  w_s(&mut out, "\t.zero 8\n");
  w_s(&mut out, "bst_rt_argv:\n");
  w_s(&mut out, "\t.zero 8\n");
  w_s(&mut out, "bst_rt_pool_base:\n");
  w_s(&mut out, "\t.zero 8\n");
  w_s(&mut out, "bst_rt_port_cell:\t\t\t// the simulated I/O ports\n");
  w_s(&mut out, "\t.zero 262144\n");
  w_s(&mut out, "bst_rt_mmio_cell:\t\t\t// the simulated MMIO window\n");
  w_s(&mut out, "\t.zero 1048576\n");
  w_s(&mut out, "bst_rt_pt_leases:\t\t\t// a 32-bit lease count per pool frame\n");
  w_s(&mut out, "\t.zero 1048576\n");
  w_s(&mut out, "bst_rt_shared_refs:\t\t// a 32-bit reference count per shared pool frame\n");
  w_s(&mut out, "\t.zero 1048576\n");
  w_s(&mut out, "\t.text\n");
}

/// The number of parameters of the hosted `main` x (a kernel's: `Serial`s only) when they are all `Host`s or `Serial`s
/// (by value, or by `&mut`: the address of a frame word), which the entry
/// passes as zero words; 1000 for any other kind.
fn a64_main_words(m: &mut Mono, p: &Parser, x: u64, kernel: bool) -> u64 {
  let xi = inst_at(m, x);
  let dn = node_at(p.nodes, xi.def);
  let mut n = 0;
  let mut q = dn.a;
  while q != 0 {
    let qn = node_at(p.nodes, q);
    let pt = conv(&mut m, p, qn.a, x, q);
    let tk = kind_t(m, base_t(m, pt));
    if kernel && tk != TY_SERIAL && tk != TY_POOL && tk != TY_MMU && tk != TY_CPU && tk != TY_MMIOSPACE {
      return 1000;                      // the ports and the host are not the kernel's
    }
    if tk == TY_POOL {
      if kind_t(m, pt) == TY_POOL {
        n = wrap_add(n, 1);
      }
    } else if tk != TY_HOST && tk != TY_SERIAL && tk != TY_PORTS && tk != TY_MMIOSPACE && !(kernel && (tk == TY_MMU || tk == TY_CPU)) {
      return 1000;
    }
    n = wrap_add(n, 1);
    q = qn.next;
  }
  return n;
}

/// The routine IR_PCALL `c` calls in a kernel.
fn a64_kcall(c: u64) -> Str {
  if c == 0 { return "bst_platform_info"; }
  if c == 1 { return "bst_platform_acpi"; }
  if c == 2 { return "bst_platform_cpus"; }
  if c == 3 { return "bst_rt_cpu_get"; }
  if c == 4 { return "bst_rt_cpu_idle"; }
  if c == 6 { return "bst_rt_cpu_set"; }
  if c == 7 { return "bst_rt_fpu_load"; }
  if c == 8 { return "bst_rt_fpu_save"; }
  if c == 9 { return "bst_rt_cpu_run"; }
  if c == 40 { return "bst_rt_mmu_enter"; }
  if c == 41 { return "bst_rt_mmu_exit"; }
  if c == 42 { return "bst_rt_mmu_kernel"; }
  if c == 43 { return "bst_rt_lock_depth"; }
  if c == 44 { return "bst_rt_mmu_settle"; }
  if c == 45 { return "bst_rt_mmu_settle_on"; }
  return "bst_rt_free_root";
}

/// A program for AArch64: every function from its IR, then `main` as the
/// C library's entry point, the runtime and the string data. False, with
/// the reason in `g`, when something is not covered yet.
fn a64_program(g: &mut X86, c: &Checker, m: &mut Mono, p: &Parser) -> bool {
  let mut main_x = 0;
  let mut k = 0;
  while k < vec_len(m.fns) {
    let x = u_at(m.fns, k);
    let xi = inst_at(m, x);
    if name_is(p, xi.def, "main") {
      main_x = x;
    }
    k = k + 1;
  }
  if main_x == 0 || (g.target != TARGET_HOSTED && g.target != TARGET_USER && g.target != TARGET_KERNEL) {
    x86_fail(&mut g, "the AArch64 backend builds hosted, user and kernel programs with a `main` only so far");
    return false;
  }
  w_s(&mut g.out, "// generated by bastioc1 --arch aarch64 --backend native -- do not edit\n\t.text\n");
  k = 0;
  while k < vec_len(m.fns) {
    let x = u_at(m.fns, k);
    if !a64_function(&mut g, c, &mut m, p, x) {
      return false;
    }
    k = k + 1;
  }
  if g.target == TARGET_KERNEL {
    // Called by the platform's boot code with the memory map; what it
    // returns is ignored (the platform powers off). The UART is set up only
    // for a kernel that uses `Serial`.
    w_s(&mut g.out, "\t.globl bst_kmain\n\t.type bst_kmain, %function\nbst_kmain:\n\tstp x29, x30, [sp, #-16]!\n\tmov x29, sp\n\tadrp x2, bst_rt_mbi\n\tstr x0, [x2, :lo12:bst_rt_mbi]\n");
    let kxi = inst_at(m, main_x);
    let kdn = node_at(p.nodes, kxi.def);
    let mut kq = kdn.a;
    while kq != 0 {
      let kqn = node_at(p.nodes, kq);
      if kind_t(m, base_t(m, conv(&mut m, p, kqn.a, main_x, kq))) == TY_SERIAL {
        w_s(&mut g.out, "\tbl bst_rt_serial_init\n");
      }
      kq = kqn.next;
    }
  } else if g.target == TARGET_USER {
    // Called by user/start-aarch64.S; its result is the exit code.
    w_s(&mut g.out, "\t.globl bst_umain\n\t.type bst_umain, %function\nbst_umain:\n\tstp x29, x30, [sp, #-32]!\n\tmov x29, sp\n\tstr x19, [sp, #16]\n");
  } else {
    w_s(&mut g.out, "\t.globl main\n\t.type main, %function\nmain:\n\tstp x29, x30, [sp, #-16]!\n\tmov x29, sp\n\tadrp x2, bst_rt_argc\n\tstr w0, [x2, :lo12:bst_rt_argc]\n\tadrp x2, bst_rt_argv\n\tstr x1, [x2, :lo12:bst_rt_argv]\n");
  }
  // The capabilities of `main` are zero words; one lent by `&mut` is the
  // address of its word on the frame.
  let mxi = inst_at(m, main_x);
  let mdn = node_at(p.nodes, mxi.def);
  // The capabilities of `main` live in frame words (zero, except a pool:
  // its base, then its page count); `main` gets them by value or, lent by
  // `&mut`, by address.
  let mut off = 0;
  let mut mq = mdn.a;
  while mq != 0 && off < 8 {
    let mqn = node_at(p.nodes, mq);
    let mpt = conv(&mut m, p, mqn.a, main_x, mq);
    if off == 0 {
      w_s(&mut g.out, "\tsub sp, sp, #64\n");
    }
    if kind_t(m, base_t(m, mpt)) == TY_POOL {
      if g.target == TARGET_KERNEL {
        w_s(&mut g.out, "\tadrp x0, bst_rt_mbi\n\tldr x0, [x0, :lo12:bst_rt_mbi]\n");
      }
      w_s(&mut g.out, "\tbl bst_rt_pool_init\n\tstr x0, [sp, #");
      w_num(&mut g.out, wrap_mul(8, off));
      w_s(&mut g.out, "]\n\tstr x1, [sp, #");
      w_num(&mut g.out, wrap_mul(8, wrap_add(off, 1)));
      w_s(&mut g.out, "]\n");
      off = wrap_add(off, 2);
    } else {
      w_s(&mut g.out, "\tstr xzr, [sp, #");
      w_num(&mut g.out, wrap_mul(8, off));
      w_s(&mut g.out, "]\n");
      off = wrap_add(off, 1);
    }
    mq = mqn.next;
  }
  let mut at = 0;
  let mut rn = 0;
  mq = mdn.a;
  while mq != 0 && rn < 8 {
    let mqn = node_at(p.nodes, mq);
    let mpt = conv(&mut m, p, mqn.a, main_x, mq);
    let mut w = 1;
    if kind_t(m, base_t(m, mpt)) == TY_POOL {
      w = 2;
    }
    if kind_t(m, mpt) == TY_MUTREF {
      w_s(&mut g.out, "\tadd x");
      w_num(&mut g.out, rn);
      w_s(&mut g.out, ", sp, #");
      w_num(&mut g.out, wrap_mul(8, at));
      w_s(&mut g.out, "\n");
      rn = wrap_add(rn, 1);
    } else {
      let mut j = 0;
      while j < w {
        w_s(&mut g.out, "\tldr x");
        w_num(&mut g.out, rn);
        w_s(&mut g.out, ", [sp, #");
        w_num(&mut g.out, wrap_mul(8, wrap_add(at, j)));
        w_s(&mut g.out, "]\n");
        rn = wrap_add(rn, 1);
        j = wrap_add(j, 1);
      }
    }
    at = wrap_add(at, w);
    mq = mqn.next;
  }
  w_s(&mut g.out, "\tbl ");
  let mut ms = vec_new[u64]();
  ix_sym(&mut ms, &mut g, m, p, main_x);
  w_append(&mut g.out, ms);
  vec_free(ms);
  if g.target == TARGET_KERNEL {
    w_s(&mut g.out, "\n\tmov sp, x29\n\tldp x29, x30, [sp], #16\n\tret\n");
    w_s(&mut g.out, "\n");
    w_append(&mut g.out, g.smp);
    a64_runtime_kernel(&mut g.out);
  } else if g.target == TARGET_USER {
    w_s(&mut g.out, "\n\tmov x19, x0\n\tbl bst_rt_flush\n\tmov x0, x19\n\tmov sp, x29\n\tldr x19, [sp, #16]\n\tldp x29, x30, [sp], #32\n\tret\n");
    a64_runtime_user(&mut g.out);
  } else {
    w_s(&mut g.out, "\n\tmov sp, x29\n\tldp x29, x30, [sp], #16\n\tret\n");
    a64_runtime(&mut g.out);
  }
  w_s(&mut g.out, "\t.section .rodata\n");
  k = 0;
  while k < vec_len(g.slens) {
    w_s(&mut g.out, ".Lstr");
    w_num(&mut g.out, k);
    w_s(&mut g.out, ":\n");
    let from = u_at(g.sstart, k);
    let n = u_at(g.slens, k);
    let mut j = 0;
    while j < n {
      if j % 24 == 0 {
        w_s(&mut g.out, "\t.byte ");
      } else {
        w_s(&mut g.out, ",");
      }
      w_num(&mut g.out, u_at(g.sdata, wrap_add(from, j)));
      j = j + 1;
      if j % 24 == 0 || j == n {
        w_s(&mut g.out, "\n");
      }
    }
    k = k + 1;
  }
  w_s(&mut g.out, "\t.section .note.GNU-stack,\"\",%progbits\n");
  return true;
}
