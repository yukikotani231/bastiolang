  w_s(&mut out, "\tcbz x9, 2f\n");
  w_s(&mut out, "\tmov x0, x19\n");
  w_s(&mut out, "\tbl bst_rt_lease_take\n");
  w_s(&mut out, "\tstr x19, [x20, #24]\n");
  w_s(&mut out, "\tb 9f\n");
  w_s(&mut out, "2:\tcbz x20, 3f\n");
  w_s(&mut out, "\tldr x9, [x20]\n");
  w_s(&mut out, "\tcmp x9, x19\n");
  w_s(&mut out, "\tb.ne 3f\n");
  w_s(&mut out, "\tstr xzr, [x20]\n");
  w_s(&mut out, "\tb 4f\n");
  w_s(&mut out, "3:\tmov x0, x19\n");
  w_s(&mut out, "\tbl bst_rt_lease_take\n");
  w_s(&mut out, "4:\tmrs x9, ttbr0_el1\n");
