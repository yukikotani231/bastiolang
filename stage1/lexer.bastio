// The lexer of bastioc1, the self-hosted Bastio compiler.
//
// It turns source bytes into tokens. A token does not copy its text: it
// records where the text is (`start` to `end` in the source), so tokens are
// plain values and a vector of them needs no ownership bookkeeping. It must
// agree with stage0's lexer token for token: `difftest.sh` compares the two
// on every source file in the repository.

// Token kinds.
const K_EOF: u64 = 0;
const K_INT: u64 = 1;          // `val` is the value
const K_STR: u64 = 2;          // the text between the quotes, escapes not yet decoded
const K_IDENT: u64 = 3;
const K_KEYWORD: u64 = 4;      // `val` is its code (KW_*)
const K_PUNCT: u64 = 5;        // `val` is its code (P_*)
const K_ERROR: u64 = 6;        // a lexical error at `line`:`col`

// Sources are at most 2^40 bytes, so positions and counts never overflow.
const SRC_MAX: u64 = 1099511627776;
const U64_MAX: u64 = 18446744073709551615;

// Keyword codes.
const KW_FN: u64 = 1;
const KW_STRUCT: u64 = 2;
const KW_ENUM: u64 = 3;
const KW_MATCH: u64 = 4;
const KW_IS: u64 = 5;
const KW_SPEC: u64 = 6;
const KW_CONST: u64 = 7;
const KW_LET: u64 = 8;
const KW_MUT: u64 = 9;
const KW_IF: u64 = 10;
const KW_ELSE: u64 = 11;
const KW_WHILE: u64 = 12;
const KW_RETURN: u64 = 13;
const KW_IMPORT: u64 = 14;
const KW_UNREACHABLE: u64 = 15;
const KW_REQUIRES: u64 = 16;
const KW_ENSURES: u64 = 17;
const KW_INVARIANT: u64 = 18;
const KW_ASSERT: u64 = 19;
const KW_FORALL: u64 = 20;
const KW_TRUE: u64 = 21;
const KW_FALSE: u64 = 22;
const KW_EXPORT: u64 = 23;

// Operator and punctuation codes.
const P_IMPLIES: u64 = 30;     // ==>
const P_EQEQ: u64 = 31;
const P_FATARROW: u64 = 32;    // =>
const P_NE: u64 = 33;
const P_LE: u64 = 34;
const P_GE: u64 = 35;
const P_ANDAND: u64 = 36;
const P_OROR: u64 = 37;
const P_ARROW: u64 = 38;       // ->
const P_COLONCOLON: u64 = 39;
const P_LPAREN: u64 = 40;
const P_RPAREN: u64 = 41;
const P_LBRACKET: u64 = 42;
const P_RBRACKET: u64 = 43;
const P_LBRACE: u64 = 44;
const P_RBRACE: u64 = 45;
const P_COMMA: u64 = 46;
const P_SEMI: u64 = 47;
const P_COLON: u64 = 48;
const P_AMP: u64 = 49;
const P_DOT: u64 = 50;
const P_PLUS: u64 = 51;
const P_MINUS: u64 = 52;
const P_STAR: u64 = 53;
const P_SLASH: u64 = 54;
const P_PERCENT: u64 = 55;
const P_EQ: u64 = 56;
const P_LT: u64 = 57;
const P_GT: u64 = 58;
const P_BANG: u64 = 59;
const P_SHL: u64 = 60;        // <<
const P_SHR: u64 = 61;        // >>
const P_PIPE: u64 = 62;       // |
const P_CARET: u64 = 63;      // ^

struct Tok { kind: u64, start: u64, end: u64, line: u64, col: u64, val: u64 }

fn is_digit(c: u64) -> bool
  ensures result == (c >= 48 && c <= 57)
{
  return c >= 48 && c <= 57;
}

fn hex_val(c: u64) -> u64
  ensures result <= 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  if c >= 65 && c <= 70 { return c - 55; }
  return 16;
}

fn is_alpha(c: u64) -> bool {
  return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
}

fn is_space(c: u64) -> bool {
  // space, \t, \n, \v, \f, \r
  return c == 32 || (c >= 9 && c <= 13);
}

/// Does `src[s..e]` spell `w`?
fn spells(src: &Bytes, s: u64, e: u64, w: Str) -> bool
  requires s <= e && e <= blen(src)
{
  if e - s != slen(w) {
    return false;
  }
  let mut k = 0;
  while k < slen(w)
    invariant k <= slen(w) && s + slen(w) <= blen(src)
  {
    if bget(src, s + k) != sget(w, k) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

/// The keyword code of `src[s..e]`, or 0 if it is not a keyword.
fn keyword(src: &Bytes, s: u64, e: u64) -> u64
  requires s <= e && e <= blen(src)
{
  if spells(src, s, e, "fn") { return KW_FN; }
  if spells(src, s, e, "struct") { return KW_STRUCT; }
  if spells(src, s, e, "enum") { return KW_ENUM; }
  if spells(src, s, e, "match") { return KW_MATCH; }
  if spells(src, s, e, "is") { return KW_IS; }
  if spells(src, s, e, "spec") { return KW_SPEC; }
  if spells(src, s, e, "const") { return KW_CONST; }
  if spells(src, s, e, "let") { return KW_LET; }
  if spells(src, s, e, "mut") { return KW_MUT; }
  if spells(src, s, e, "if") { return KW_IF; }
  if spells(src, s, e, "else") { return KW_ELSE; }
  if spells(src, s, e, "while") { return KW_WHILE; }
  if spells(src, s, e, "return") { return KW_RETURN; }
  if spells(src, s, e, "import") { return KW_IMPORT; }
  if spells(src, s, e, "export") { return KW_EXPORT; }
  if spells(src, s, e, "unreachable") { return KW_UNREACHABLE; }
  if spells(src, s, e, "requires") { return KW_REQUIRES; }
  if spells(src, s, e, "ensures") { return KW_ENSURES; }
  if spells(src, s, e, "invariant") { return KW_INVARIANT; }
  if spells(src, s, e, "assert") { return KW_ASSERT; }
  if spells(src, s, e, "forall") { return KW_FORALL; }
  if spells(src, s, e, "true") { return KW_TRUE; }
  if spells(src, s, e, "false") { return KW_FALSE; }
  return 0;
}

/// The byte at `i`, or 0 past the end.
fn at(src: &Bytes, i: u64) -> u64
  ensures result <= 255 && (i >= blen(src) ==> result == 0)
{
  if i < blen(src) {
    return bget(src, i);
  }
  return 0;
}

/// The operator or punctuation at `i`: its code, or 0 if the byte starts
/// none. `punct_len` gives its length.
fn punct(src: &Bytes, i: u64) -> u64
  requires i < blen(src)
{
  let c = bget(src, i);
  let d = at(src, i + 1);
  if c == 61 && d == 61 && at(src, i + 2) == 62 { return P_IMPLIES; }
  if c == 61 && d == 61 { return P_EQEQ; }
  if c == 61 && d == 62 { return P_FATARROW; }
  if c == 33 && d == 61 { return P_NE; }
  if c == 60 && d == 60 { return P_SHL; }
  if c == 62 && d == 62 { return P_SHR; }
  if c == 60 && d == 61 { return P_LE; }
  if c == 62 && d == 61 { return P_GE; }
  if c == 38 && d == 38 { return P_ANDAND; }
  if c == 124 && d == 124 { return P_OROR; }
  if c == 45 && d == 62 { return P_ARROW; }
  if c == 58 && d == 58 { return P_COLONCOLON; }
  if c == 40 { return P_LPAREN; }
  if c == 41 { return P_RPAREN; }
  if c == 91 { return P_LBRACKET; }
  if c == 93 { return P_RBRACKET; }
  if c == 123 { return P_LBRACE; }
  if c == 125 { return P_RBRACE; }
  if c == 44 { return P_COMMA; }
  if c == 59 { return P_SEMI; }
  if c == 58 { return P_COLON; }
  if c == 38 { return P_AMP; }
  if c == 124 { return P_PIPE; }
  if c == 94 { return P_CARET; }
  if c == 46 { return P_DOT; }
  if c == 43 { return P_PLUS; }
  if c == 45 { return P_MINUS; }
  if c == 42 { return P_STAR; }
  if c == 47 { return P_SLASH; }
  if c == 37 { return P_PERCENT; }
  if c == 61 { return P_EQ; }
  if c == 60 { return P_LT; }
  if c == 62 { return P_GT; }
  if c == 33 { return P_BANG; }
  return 0;
}

fn punct_len(code: u64) -> u64
  ensures result <= 3
{
  if code == P_IMPLIES { return 3; }
  if code >= P_EQEQ && code <= P_COLONCOLON { return 2; }
  if code == P_SHL || code == P_SHR { return 2; }
  if code == 0 { return 0; }
  return 1;
}

fn err(line: u64, col: u64) -> Tok {
  return Tok { kind: K_ERROR, start: 0, end: 0, line: line, col: col, val: 0 };
}

/// Appends the tokens of `src` from byte `from` on to `out`, ending with an
/// EOF token. Returns that EOF token, or an error token (and stops) at the
/// first lexical error. Lines and columns count from `from`, so several
/// files can share one buffer, each lexed from where it starts.
fn lex(src: &Bytes, from: u64, out: &mut Vec[Tok]) -> Tok
  requires blen(src) <= SRC_MAX
{
  let n = blen(src);
  let mut i = from;
  if i > n {
    i = n;
  }
  let mut line = 1;
  let mut col = 1;
  while i < n
    invariant i <= n && 1 <= line && line <= i + 1 && 1 <= col && col <= i + 1
  {
    let c = bget(src, i);
    let tl = line;
    let tc = col;
    if c == 10 {
      i = i + 1;
      line = line + 1;
      col = 1;
    } else if is_space(c) {
      i = i + 1;
      col = col + 1;
    } else if c == 47 && at(src, i + 1) == 47 {
      // A line comment runs to the newline, which the loop then sees.
      while i < n && bget(src, i) != 10
        invariant i <= n && 1 <= col && col <= i + 1 && line <= i + 1
      {
        i = i + 1;
      }
    } else if c == 34 {
      let start = i + 1;
      i = i + 1;
      col = col + 1;
      let mut open = true;
      while open
        invariant i <= n && 1 <= col && col <= i + 1 && line <= i + 1 && start <= i
      {
        if i >= n || bget(src, i) == 10 {
          return err(tl, tc);                    // unterminated
        }
        let ch = bget(src, i);
        if ch == 34 {
          vec_push(&mut out, Tok { kind: K_STR, start: start, end: i, line: tl, col: tc, val: 0 });
          open = false;
        } else if ch == 92 {
          let e = at(src, i + 1);
          if !(e == 110 || e == 114 || e == 116 || e == 48 || e == 92 || e == 34) {
            return err(tl, tc);                  // unknown escape
          }
          i = i + 1;
          col = col + 1;
        }
        i = i + 1;
        // Columns count characters: UTF-8 continuation bytes add nothing.
        if ch < 128 || ch >= 192 {
          col = col + 1;
        }
      }
    } else if is_digit(c) {
      let start = i;
      let mut v = 0;
      let mut ok = true;
      if c == 48 && (at(src, i + 1) == 120 || at(src, i + 1) == 88) {
        i = i + 2;
        let mut digits = 0;
        while i < n && (hex_val(bget(src, i)) < 16 || bget(src, i) == 95)
          invariant i <= n && start <= i && line <= start + 1 && 1 <= col && col <= start + 1
        {
          let h = hex_val(bget(src, i));
          if h < 16 {
            if v > (U64_MAX - h) / 16 { ok = false; } else { v = v * 16 + h; }
            digits = 1;
          }
          i = i + 1;
        }
        if digits == 0 { ok = false; }
      } else {
        while i < n && (is_digit(bget(src, i)) || bget(src, i) == 95)
          invariant i <= n && start <= i && line <= start + 1 && 1 <= col && col <= start + 1
        {
          let ch = bget(src, i);
          if ch != 95 {
            if v > (U64_MAX - (ch - 48)) / 10 { ok = false; } else { v = v * 10 + (ch - 48); }
          }
          i = i + 1;
        }
      }
      if !ok {
        return err(tl, tc);
      }
      vec_push(&mut out, Tok { kind: K_INT, start: start, end: i, line: tl, col: tc, val: v });
      col = col + (i - start);
    } else if is_alpha(c) {
      let start = i;
      while i < n && (is_alpha(bget(src, i)) || is_digit(bget(src, i)))
        invariant i <= n && start <= i && line <= start + 1 && 1 <= col && col <= start + 1
      {
        i = i + 1;
      }
      let kw = keyword(src, start, i);
      let mut kind = K_IDENT;
      if kw != 0 { kind = K_KEYWORD; }
      vec_push(&mut out, Tok { kind: kind, start: start, end: i, line: tl, col: tc, val: kw });
      col = col + (i - start);
    } else {
      let code = punct(src, i);
      let k = punct_len(code);
      if k == 0 || i + k > n {
        return err(tl, tc);
      }
      vec_push(&mut out, Tok { kind: K_PUNCT, start: i, end: i + k, line: tl, col: tc, val: code });
      i = i + k;
      col = col + k;
    }
  }
  let eof = Tok { kind: K_EOF, start: n, end: n, line: line, col: col, val: 0 };
  vec_push(&mut out, eof);
  return eof;
}
