// Verification-condition generation by symbolic execution, as stage0's
// verify.rs does it.
//
// The verifier walks each function once, keeping a path condition, and at
// every place the program could go wrong it asks the solver whether the bad
// case is reachable (bounds, overflow, underflow, division by zero,
// allocation size, preconditions at calls, postconditions at returns, loop
// invariants, `assert`, `unreachable`, and the ghost state of pages, page
// tables, the pool and the MMU). See the long comment at the top of
// stage0/src/verify.rs for the model; this file follows it function by
// function, so the two produce the same SMT-LIB commands, character for
// character. `difftest.sh` checks that on every program stage0 verifies.
//
// For now the commands are only collected (`Vr.log`) and printed, and
// every proof is assumed to succeed: the solver is not run yet.
//
// SMT terms live in an arena (`Vr.tms`) and are shared, not copied: a term
// is an atom (text in `Vr.pool`), a number, an application of an operator,
// or a `forall`. Two terms are compared by what they print as (`tm_eq`),
// as stage0 compares strings. Values (`Vr.vals`) are immutable too: an
// update builds a new value that shares the unchanged parts.
import "files.bastio";
import "check.bastio";

// Terms.
const VT_ATOM: u64 = 1;       // the text pool[a .. a + b]
const VT_NUM: u64 = 2;        // the number a
const VT_APP: u64 = 3;        // operator a applied to targs[b .. b + c]
const VT_FORALL: u64 = 4;     // (forall ((a Int)) b)
const VT_LAMBDA: u64 = 5;     // (lambda ((a Int)) b)
const VT_FORALLP: u64 = 6;    // (forall ((a Int)) (! b :pattern (p) :pattern (q))), p and q targs[c], targs[c + 1]

const OP_ADD: u64 = 1;
const OP_SUB: u64 = 2;
const OP_MUL: u64 = 3;
const OP_DIV: u64 = 4;
const OP_MOD: u64 = 5;
const OP_EQ: u64 = 6;
const OP_LT: u64 = 7;
const OP_LE: u64 = 8;
const OP_GT: u64 = 9;
const OP_GE: u64 = 10;
const OP_AND: u64 = 11;
const OP_OR: u64 = 12;
const OP_NOT: u64 = 13;
const OP_IMP: u64 = 14;
const OP_ITE: u64 = 15;
const OP_SELECT: u64 = 16;
const OP_STORE: u64 = 17;
const OP_CNT: u64 = 18;       // vcount: (cnt elements length value)

// Sorts: Int or Bool, under `depth` levels of (Array Int ..): base + 2 * depth.
const SO_INT: u64 = 0;
const SO_BOOL: u64 = 1;

// Values.
const VV_U: u64 = 1;          // a: the term
const VV_B: u64 = 2;          // a: the term
const VV_BUF: u64 = 3;        // a: length, b: data
const VV_STR: u64 = 4;        // a: length, b: data
const VV_OBJ: u64 = 5;        // type ty; ghost fields a, b, c (n of them, see `obj_fields`)
const VV_STRUCT: u64 = 6;     // type ty; fields kids[a .. a + n]
const VV_ENUM: u64 = 7;       // type ty; tag a; payloads kids[b .. b + n] (unit for none)
const VV_BOXK: u64 = 8;       // a box holding value a
const VV_BOXO: u64 = 9;       // a box of type ty whose contents are not known yet
const VV_VEC: u64 = 10;       // element type ty; length a; lifted elements b
const VV_UNIT: u64 = 11;

// Commands.
const CMD_DECL: u64 = 1;      // (declare-const a sort b)
const CMD_ASSERT: u64 = 2;    // (assert a)
const CMD_PUSH: u64 = 3;
const CMD_POP: u64 = 4;
const CMD_CHECK: u64 = 5;
const CMD_FAIL: u64 = 6;      // not sent: a failure found without the solver (obls says which)
const CMD_RAW: u64 = 7;       // the text of atom a

/// Largest element count `alloc` accepts (2^60).
const ALLOC_MAX: u64 = 1152921504606846976;
/// Page numbers are below this; also `mmu_root` of the kernel's own tables.
const FRAME_LIMIT: u64 = 65536;
/// How many boxes deep a fresh value is unfolded.
const BOX_DEPTH: u64 = 2;

struct Tm { kind: u64, a: u64, b: u64, c: u64 }
struct Vl { kind: u64, ty: u64, a: u64, b: u64, c: u64, n: u64, d: u64 }
struct Cmd { kind: u64, a: u64, b: u64 }
/// A variable (named by its source text s..e) and its value. A variable no
/// program can name (`locked*N`, see `vlocked`) has its name in the text
/// pool instead, at pool[e .. s]: s > e tells the two apart.
struct Bind { s: u64, e: u64, val: u64 }
/// A variable bound by an enclosing `forall` (source text s..e) and its SMT name.
struct Bnd { s: u64, e: u64, q: u64 }
/// A place a loop body changes (its dotted path) and whether every change keeps its shape.
struct Chg { name: u64, keep: bool }

/// One row of a function's summary (see `summarize`): call of instance `x`
/// may change place `rel` (a path relative to parameter `j`, an atom like
/// `.f.g`, empty for the parameter itself); `keep` says only in ways that
/// keep its shape.
struct SumRow { x: u64, j: u64, rel: u64, keep: bool }

/// A proof obligation, for reporting it if it fails: the node an error
/// points at, the error code (VC_*), the instance being verified, and the
/// variables in scope (snaps[env .. env + n]).
struct Obl { at: u64, code: u64, x: u64, env: u64, n: u64 }

// Error codes of failed proofs.
const VC_ALLOC: u64 = 1;
const VC_ASSERT: u64 = 2;
const VC_BOUNDS: u64 = 3;
const VC_CAST: u64 = 5;
const VC_DIVZERO: u64 = 6;
const VC_ENSURES: u64 = 7;
const VC_INVARIANT: u64 = 8;
const VC_LEAK: u64 = 9;
const VC_MMU: u64 = 10;
const VC_OVERFLOW: u64 = 11;
const VC_OWN: u64 = 12;
const VC_PT: u64 = 13;
const VC_REQUIRES: u64 = 14;
const VC_UNDERFLOW: u64 = 15;
const VC_UNREACHABLE: u64 = 16;
/// Not a proof: an `export fn` may free or replace a buffer C lent it.
const VC_EXPORT: u64 = 17;
const VC_LOCKINV: u64 = 18;
const VC_SHIFT: u64 = 19;
const VC_LEASE: u64 = 20;

fn vc_name(code: u64) -> Str {
  if code == VC_ALLOC { return "E-VERIFY-ALLOC"; }
  if code == VC_ASSERT { return "E-VERIFY-ASSERT"; }
  if code == VC_BOUNDS { return "E-VERIFY-BOUNDS"; }
  if code == VC_CAST { return "E-VERIFY-CAST"; }
  if code == VC_DIVZERO { return "E-VERIFY-DIVZERO"; }
  if code == VC_ENSURES { return "E-VERIFY-ENSURES"; }
  if code == VC_INVARIANT { return "E-VERIFY-INVARIANT"; }
  if code == VC_LEAK { return "E-VERIFY-LEAK"; }
  if code == VC_MMU { return "E-VERIFY-MMU"; }
  if code == VC_OVERFLOW { return "E-VERIFY-OVERFLOW"; }
  if code == VC_OWN { return "E-VERIFY-OWN"; }
  if code == VC_PT { return "E-VERIFY-PT"; }
  if code == VC_REQUIRES { return "E-VERIFY-REQUIRES"; }
  if code == VC_UNDERFLOW { return "E-VERIFY-UNDERFLOW"; }
  if code == VC_EXPORT { return "E-EXPORT"; }
  if code == VC_LOCKINV { return "E-VERIFY-LOCKINV"; }
  if code == VC_SHIFT { return "E-VERIFY-SHIFT"; }
  if code == VC_LEASE { return "E-VERIFY-LEASE"; }
  return "E-VERIFY-UNREACHABLE";
}

/// The state on one path: the path condition and the variables' values.
/// `live` is false once every path has returned.
struct VState { pc: Vec[u64], env: Vec[Bind], live: bool }

struct Vr {
  pool: Vec[u64],
  tms: Vec[Tm],
  targs: Vec[u64],
  vals: Vec[Vl],
  kids: Vec[u64],
  log: Vec[Cmd],
  counter: u64,
  obligations: u64,
  /// Boxes being unfolded by `fresh_of` right now.
  box_depth: u64,
  /// A cursor for `rebuild`.
  cur: u64,
  /// The instance being verified, for reading the types written in it.
  env: u64,
  /// The function definitions whose proofs can mention `vcount` (see
  /// `count_gate`), and whether the one being verified is one of them.
  cnt_fns: Vec[u64],
  counts: bool,
  /// Every function's summaries, grouped by instance: rows
  /// sum_start[x] .. sum_start[x] + sum_n[x] are instance x's.
  sums: Vec[SumRow],
  /// Every proof obligation so far, and the variables in scope at each.
  obls: Vec[Obl],
  snaps: Vec[Bind],
  sum_start: Vec[u64],
  sum_n: Vec[u64],
  t_true: u64,
  t_false: u64,
  t_zero: u64,
  t_u64max: u64,
  t_allocmax: u64,
  t_flimit: u64,
  /// 65536: the number of x86 I/O ports.
  t_plimit: u64,
  /// The device window a Mmio lies in: physical 0x8000_0000 up to 2^46.
  t_mmio_lo: u64,
  t_mmio_hi: u64,
  t_poolsize: u64,
  t_zarr: u64,
  t_nobool: u64,
  t_k: u64,
  t_255: u64,
  unit: u64,
  ty_bytes: u64,
  ty_child: u64,
  ty_frame: u64,
  ty_pt: u64,
  ty_pool: u64,
  /// After `solve` fails: the node and code (VC_*, 0 for E-SOLVER) of the
  /// failed obligation.
  fail_at: u64,
  fail_code: u64
}

fn vr_new(m: &mut Mono, p: &Parser) -> Vr {
  let mut tms = vec_new[Tm]();
  vec_push(&mut tms, Tm { kind: 0, a: 0, b: 0, c: 0 });
  let mut vals = vec_new[Vl]();
  vec_push(&mut vals, Vl { kind: 0, ty: 0, a: 0, b: 0, c: 0, n: 0, d: 0 });
  let mut v = Vr {
    pool: vec_new[u64](), tms: tms, targs: vec_new[u64](), vals: vals, kids: vec_new[u64](),
    log: vec_new[Cmd](), counter: 0, obligations: 0, box_depth: 0, cur: 0, env: 0, cnt_fns: vec_new[u64](), counts: false,
    sums: vec_new[SumRow](), obls: vec_new[Obl](), snaps: vec_new[Bind](), sum_start: vec_new[u64](), sum_n: vec_new[u64](),
    t_true: 0, t_false: 0, t_zero: 0, t_u64max: 0, t_allocmax: 0, t_flimit: 0, t_plimit: 0, t_mmio_lo: 0, t_mmio_hi: 0, t_poolsize: 0,
    t_zarr: 0, t_nobool: 0, t_k: 0, t_255: 0, unit: 0,
    ty_bytes: prim(&mut m, p, TY_BYTES), ty_child: prim(&mut m, p, TY_CHILD), ty_frame: prim(&mut m, p, TY_FRAME),
    ty_pt: prim(&mut m, p, TY_PT), ty_pool: prim(&mut m, p, TY_POOL), fail_at: 0, fail_code: 0
  };
  v.t_true = atom_str(&mut v, "true");
  v.t_false = atom_str(&mut v, "false");
  v.t_zero = num(&mut v, 0);
  v.t_u64max = num(&mut v, U64_MAX);
  v.t_allocmax = num(&mut v, ALLOC_MAX);
  v.t_flimit = num(&mut v, FRAME_LIMIT);
  v.t_plimit = num(&mut v, 65536);
  v.t_mmio_lo = num(&mut v, 2147483648);
  v.t_mmio_hi = num(&mut v, 70368744177664);
  v.t_poolsize = atom_str(&mut v, "POOLSIZE");
  v.t_zarr = atom_str(&mut v, "((as const (Array Int Int)) 0)");
  v.t_nobool = atom_str(&mut v, "((as const (Array Int Bool)) false)");
  v.t_k = atom_str(&mut v, "k");
  v.t_255 = num(&mut v, 255);
  v.unit = mk(&mut v, VV_UNIT, 0, 0, 0, 0, 0);
  return v;
}

fn vr_free(v: Vr) {
  vec_free(v.pool);
  vec_free(v.tms);
  vec_free(v.targs);
  vec_free(v.vals);
  vec_free(v.kids);
  vec_free(v.log);
  vec_free(v.cnt_fns);
  vec_free(v.sums);
  vec_free(v.sum_start);
  vec_free(v.sum_n);
  vec_free(v.obls);
  vec_free(v.snaps);
}

/// `a + b`, or the largest u64 if that overflows (indices that large are
/// out of range anyway).
fn vadd(a: u64, b: u64) -> u64 {
  if b > U64_MAX - a {
    return U64_MAX;
  }
  return a + b;
}

// ---- Text ----

fn pool_at(v: &Vr, i: u64) -> u64 {
  return u_at(v.pool, i);
}

fn push_str(v: &mut Vr, s: Str) {
  let mut k = 0;
  while k < slen(s)
    invariant k <= slen(s)
  {
    vec_push(&mut v.pool, cast[u64](sget(s, k)));
    k = k + 1;
  }
}

fn push_src(v: &mut Vr, p: &Parser, s: u64, e: u64) {
  if s <= e && e <= blen(p.src) {
    let mut k = s;
    while k < e
      invariant k <= e && e <= blen(p.src)
    {
      vec_push(&mut v.pool, cast[u64](bget(p.src, k)));
      k = k + 1;
    }
  }
}

/// Appends the text of atom `a`.
fn push_text(v: &mut Vr, a: u64) {
  let t = tm_at(v, a);
  let mut k = 0;
  while k < t.b {
    let ch = pool_at(v, vadd(t.a, k));
    vec_push(&mut v.pool, ch);
    k = k + 1;
  }
}

fn push_num(v: &mut Vr, x: u64) {
  let mut d = vec_new[u64]();
  let mut y = x;
  vec_push(&mut d, 48 + y % 10);
  y = y / 10;
  while y > 0 {
    vec_push(&mut d, 48 + y % 10);
    y = y / 10;
  }
  let mut k = vec_len(d);
  while k > 0 {
    k = k - 1;
    vec_push(&mut v.pool, u_at(d, k));
  }
  vec_free(d);
}

/// The atom whose text is what was appended to the pool since `start`.
fn seal(v: &mut Vr, start: u64) -> u64 {
  let n = vec_len(v.pool);
  if start > n {
    return new_tm(&mut v, VT_ATOM, n, 0, 0);
  }
  return new_tm(&mut v, VT_ATOM, start, n - start, 0);
}

fn atom_str(v: &mut Vr, s: Str) -> u64 {
  let start = vec_len(v.pool);
  push_str(&mut v, s);
  return seal(&mut v, start);
}

fn atom_src(v: &mut Vr, p: &Parser, s: u64, e: u64) -> u64 {
  let start = vec_len(v.pool);
  push_src(&mut v, p, s, e);
  return seal(&mut v, start);
}

/// `s` followed by the text of `a`.
fn pre_str(v: &mut Vr, s: Str, a: u64) -> u64 {
  let start = vec_len(v.pool);
  push_str(&mut v, s);
  push_text(&mut v, a);
  return seal(&mut v, start);
}

/// The text of `a` followed by `s`.
fn cat_str(v: &mut Vr, a: u64, s: Str) -> u64 {
  let start = vec_len(v.pool);
  push_text(&mut v, a);
  push_str(&mut v, s);
  return seal(&mut v, start);
}

/// `a_s..e`: a hint for a part (field, variant) of the thing `a` names.
fn cat_src(v: &mut Vr, p: &Parser, a: u64, s: u64, e: u64) -> u64 {
  let start = vec_len(v.pool);
  push_text(&mut v, a);
  push_str(&mut v, "_");
  push_src(&mut v, p, s, e);
  return seal(&mut v, start);
}

/// The first `n` bytes of the text of `a` (a prefix of a dotted path).
fn prefix(v: &mut Vr, a: u64, n: u64) -> u64 {
  let t = tm_at(v, a);
  let mut k = n;
  if k > t.b {
    k = t.b;
  }
  return new_tm(&mut v, VT_ATOM, t.a, k, 0);
}

/// Is pool[s .. s + n] the source text x..y?
fn rng_is_src(v: &Vr, s: u64, n: u64, p: &Parser, x: u64, y: u64) -> bool {
  if !(x <= y && y <= blen(p.src)) || y - x != n {
    return false;
  }
  let mut k = 0;
  while k < n
    invariant k <= n && x <= y && y <= blen(p.src) && y - x == n
  {
    if pool_at(v, vadd(s, k)) != cast[u64](bget(p.src, x + k)) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

fn same_text(v: &Vr, a: u64, b: u64) -> bool {
  let x = tm_at(v, a);
  let y = tm_at(v, b);
  if x.b != y.b {
    return false;
  }
  let mut k = 0;
  while k < x.b {
    if pool_at(v, vadd(x.a, k)) != pool_at(v, vadd(y.a, k)) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

/// Is the text of `a` before the text of `b` (byte order, a prefix first)?
fn text_less(v: &Vr, a: u64, b: u64) -> bool {
  let x = tm_at(v, a);
  let y = tm_at(v, b);
  let mut k = 0;
  while k < x.b && k < y.b {
    let cx = pool_at(v, vadd(x.a, k));
    let cy = pool_at(v, vadd(y.a, k));
    if cx != cy {
      return cx < cy;
    }
    k = k + 1;
  }
  return x.b < y.b;
}

/// The name of type `t` as stage0 writes it (`Pair[u64, Buf]`).
fn push_ty(v: &mut Vr, m: &Mono, p: &Parser, t: u64) {
  let x = ty_at(m, t);
  let k = x.kind;
  if k == TY_U64 { push_str(&mut v, "u64"); }
  else if k == TY_BOOL { push_str(&mut v, "bool"); }
  else if k == TY_UNIT { push_str(&mut v, "()"); }
  else if k == TY_STR { push_str(&mut v, "Str"); }
  else if k == TY_BUF { push_str(&mut v, "Buf"); }
  else if k == TY_BYTES { push_str(&mut v, "Bytes"); }
  else if k == TY_HOST { push_str(&mut v, "Host"); }
  else if k == TY_CHILD { push_str(&mut v, "Child"); }
  else if k == TY_SERIAL { push_str(&mut v, "Serial"); }
  else if k == TY_FRAME { push_str(&mut v, "Frame"); }
  else if k == TY_PT { push_str(&mut v, "PageTable"); }
  else if k == TY_POOL { push_str(&mut v, "Pool"); }
  else if k == TY_MMU { push_str(&mut v, "Mmu"); }
  else if k == TY_CPU { push_str(&mut v, "Cpu"); }
  else if k == TY_PORTS { push_str(&mut v, "Ports"); }
  else if k == TY_PORTIO { push_str(&mut v, "PortIo"); }
  else if k == TY_MMIOSPACE { push_str(&mut v, "MmioSpace"); }
  else if k == TY_MMIO { push_str(&mut v, "Mmio"); }
  else if k == TY_DMA { push_str(&mut v, "Dma"); }
  else if k == TY_LEASE { push_str(&mut v, "Lease"); }
  else if k == TY_U8 { push_str(&mut v, "u8"); }
  else if k == TY_U16 { push_str(&mut v, "u16"); }
  else if k == TY_U32 { push_str(&mut v, "u32"); }
  else if k == TY_I8 { push_str(&mut v, "i8"); }
  else if k == TY_I16 { push_str(&mut v, "i16"); }
  else if k == TY_I32 { push_str(&mut v, "i32"); }
  else if k == TY_I64 { push_str(&mut v, "i64"); }
  else if k == TY_STRUCT || k == TY_ENUM { push_inst(&mut v, m, p, x.a); }
  else if k == TY_BOX { push_str(&mut v, "Box["); push_ty(&mut v, m, p, x.a); push_str(&mut v, "]"); }
  else if k == TY_VEC { push_str(&mut v, "Vec["); push_ty(&mut v, m, p, x.a); push_str(&mut v, "]"); }
  else if k == TY_REF { push_str(&mut v, "&"); push_ty(&mut v, m, p, x.a); }
  else if k == TY_MUTREF { push_str(&mut v, "&mut "); push_ty(&mut v, m, p, x.a); }
}

fn push_inst(v: &mut Vr, m: &Mono, p: &Parser, i: u64) {
  let x = inst_at(m, i);
  let d = node_at(p.nodes, x.def);
  push_src(&mut v, p, d.s, d.e);
  if x.n > 0 && x.args < SRC_MAX {
    push_str(&mut v, "[");
    let mut j = 0;
    while j < x.n && j < SRC_MAX
      invariant j <= SRC_MAX
    {
      if j > 0 {
        push_str(&mut v, ", ");
      }
      push_ty(&mut v, m, p, targ_at(m, x.args + j));
      j = j + 1;
    }
    push_str(&mut v, "]");
  }
}

fn inst_name(v: &mut Vr, m: &Mono, p: &Parser, i: u64) -> u64 {
  let start = vec_len(v.pool);
  push_inst(&mut v, m, p, i);
  return seal(&mut v, start);
}

// ---- Terms ----

fn tm_at(v: &Vr, t: u64) -> Tm {
  if t < vec_len(v.tms) {
    return vec_get(v.tms, t);
  }
  return Tm { kind: 0, a: 0, b: 0, c: 0 };
}

fn new_tm(v: &mut Vr, kind: u64, a: u64, b: u64, c: u64) -> u64 {
  let k = vec_len(v.tms);
  vec_push(&mut v.tms, Tm { kind: kind, a: a, b: b, c: c });
  return k;
}

fn num(v: &mut Vr, x: u64) -> u64 {
  return new_tm(&mut v, VT_NUM, x, 0, 0);
}

/// The number -x, written `(- x)` as stage0 writes a negative number (and
/// 0 for -0).
fn neg_num(v: &mut Vr, x: u64) -> u64 {
  let t = num(&mut v, x);
  if x == 0 {
    return t;
  }
  return app1(&mut v, OP_SUB, t);
}

fn app1(v: &mut Vr, op: u64, x: u64) -> u64 {
  let start = vec_len(v.targs);
  vec_push(&mut v.targs, x);
  return new_tm(&mut v, VT_APP, op, start, 1);
}

fn app2(v: &mut Vr, op: u64, x: u64, y: u64) -> u64 {
  let start = vec_len(v.targs);
  vec_push(&mut v.targs, x);
  vec_push(&mut v.targs, y);
  return new_tm(&mut v, VT_APP, op, start, 2);
}

fn app3(v: &mut Vr, op: u64, x: u64, y: u64, z: u64) -> u64 {
  let start = vec_len(v.targs);
  vec_push(&mut v.targs, x);
  vec_push(&mut v.targs, y);
  vec_push(&mut v.targs, z);
  return new_tm(&mut v, VT_APP, op, start, 3);
}

fn appv(v: &mut Vr, op: u64, xs: &Vec[u64]) -> u64 {
  let start = vec_len(v.targs);
  let mut k = 0;
  while k < vec_len(xs) {
    vec_push(&mut v.targs, u_at(xs, k));
    k = k + 1;
  }
  return new_tm(&mut v, VT_APP, op, start, vec_len(xs));
}

fn targ(v: &Vr, t: u64, k: u64) -> u64 {
  let x = tm_at(v, t);
  return u_at(v.targs, vadd(x.b, k));
}

/// (forall ((q Int)) body)
fn forall_tm(v: &mut Vr, q: u64, body: u64) -> u64 {
  return new_tm(&mut v, VT_FORALL, q, body, 0);
}

// ---- Counting (`vcount`) ----

/// `vcount(v, x)` is `(cnt a n x)` over the vector's element array `a` and
/// length `n`. These facts about it hold for every array and length; each
/// is a theorem about finite sequences, proved by induction on `n` outside
/// the solver, so they are part of the trusted base (docs/trusted-base.md).
/// `cnt_w` names an index where a counted value is. As stage0's
/// COUNT_LEMMAS.
fn count_lemmas(v: &mut Vr) {
  let l0 = atom_str(&mut v, "(declare-fun cnt ((Array Int Int) Int Int) Int)");
  send(&mut v, CMD_RAW, l0, 0);
  let l1 = atom_str(&mut v, "(declare-fun cnt_w ((Array Int Int) Int Int) Int)");
  send(&mut v, CMD_RAW, l1, 0);
  // A0: a count is between 0 and the length.
  let a0 = atom_str(&mut v, "(assert (forall ((a (Array Int Int)) (n Int) (x Int)) (! (=> (<= 0 n) (and (<= 0 (cnt a n x)) (<= (cnt a n x) n))) :pattern ((cnt a n x)))))");
  send(&mut v, CMD_RAW, a0, 0);
  // A1: an element is counted.
  let a1 = atom_str(&mut v, "(assert (forall ((a (Array Int Int)) (n Int) (i Int)) (! (=> (and (<= 0 i) (< i n)) (<= 1 (cnt a n (select a i)))) :pattern ((cnt a n (select a i))))))");
  send(&mut v, CMD_RAW, a1, 0);
  // A2: a counted value is an element.
  let a2 = atom_str(&mut v, "(assert (forall ((a (Array Int Int)) (n Int) (x Int)) (! (=> (<= 1 (cnt a n x)) (and (<= 0 (cnt_w a n x)) (< (cnt_w a n x) n) (= (select a (cnt_w a n x)) x))) :pattern ((cnt a n x)))))");
  send(&mut v, CMD_RAW, a2, 0);
}

/// `(ite (= y x) 1 0)`: 1 when y is the counted value `x`.
fn count_one(v: &mut Vr, y: u64) -> u64 {
  let x = atom_str(&mut v, "x");
  let eq = app2(&mut v, OP_EQ, y, x);
  let one = num(&mut v, 1);
  return app3(&mut v, OP_ITE, eq, one, v.t_zero);
}

/// How a vector operation changes every count: `(cnt a2 n2 x)` is
/// `(cnt a n x)` plus `delta` (a term over `x`), triggered by either count.
fn count_step(v: &mut Vr, a2: u64, n2: u64, a: u64, n: u64, delta: u64) -> u64 {
  let x = atom_str(&mut v, "x");
  let c2 = app3(&mut v, OP_CNT, a2, n2, x);
  let c1 = app3(&mut v, OP_CNT, a, n, x);
  let sum = app2(&mut v, OP_ADD, c1, delta);
  let eq = app2(&mut v, OP_EQ, c2, sum);
  let start = vec_len(v.targs);
  vec_push(&mut v.targs, c2);
  vec_push(&mut v.targs, c1);
  return new_tm(&mut v, VT_FORALLP, x, eq, start);
}

/// Does node `i` (an expression) call `vcount`, or name a spec fn or
/// function in `defs` (definitions whose specifications count)? As
/// stage0's `mentions_count`.
fn mentions_count(m: &Mono, p: &Parser, i: u64, defs: &Vec[u64]) -> bool {
  if i == 0 {
    return false;
  }
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_CALL {
    if name_is(p, i, "vcount") || has_u(defs, find_in(p, p.specs.head, i)) || has_u(defs, find_fn(p, i)) {
      return true;
    }
    return mentions_list(m, p, n.a, defs);
  }
  if k == E_VAR {
    return has_u(defs, find_in(p, p.specs.head, i)) || has_u(defs, find_fn(p, i));
  }
  if k == E_TAPP {
    // A generic instance: it counts when its definition does.
    if kind_of(p, n.b) == E_CALL {
      if !is_typed_builtin(p, n.b) && has_u(defs, tapp_def(p, n.b)) {
        return true;
      }
      let inner = node_at(p.nodes, n.b);
      return mentions_list(m, p, inner.a, defs);
    }
    return mentions_count(m, p, n.b, defs);
  }
  if k == E_FIELD || k == E_IS || k == E_NOT || k == E_NEG || k == E_FORALL || k == E_VARIANT {
    return mentions_count(m, p, n.a, defs);
  }
  if k == E_SLIT {
    let mut f = n.a;
    while f != 0 {
      let fi = node_at(p.nodes, f);
      if mentions_count(m, p, fi.a, defs) {
        return true;
      }
      f = fi.next;
    }
    return false;
  }
  if k == E_BIN {
    return mentions_count(m, p, n.a, defs) || mentions_count(m, p, n.b, defs);
  }
  return false;
}

fn mentions_list(m: &Mono, p: &Parser, head: u64, defs: &Vec[u64]) -> bool {
  let mut k = head;
  while k != 0 {
    if mentions_count(m, p, k, defs) {
      return true;
    }
    k = next_of(p, k);
  }
  return false;
}

fn block_mentions_count(m: &Mono, p: &Parser, head: u64, defs: &Vec[u64]) -> bool {
  let mut k = head;
  while k != 0 {
    let n = node_at(p.nodes, k);
    let sk = n.kind;
    if sk == S_LET || sk == S_ASSIGN {
      if mentions_count(m, p, n.b, defs) {
        return true;
      }
    } else if sk == S_IF {
      if mentions_count(m, p, n.a, defs) || block_mentions_count(m, p, n.b, defs) || block_mentions_count(m, p, n.c, defs) {
        return true;
      }
    } else if sk == S_WHILE {
      if mentions_count(m, p, n.a, defs) || mentions_list(m, p, n.b, defs) || block_mentions_count(m, p, n.c, defs) {
        return true;
      }
    } else if sk == S_RETURN || sk == S_ASSERT || sk == S_EXPR {
      if mentions_count(m, p, n.a, defs) {
        return true;
      }
    } else if sk == S_MATCH {
      if mentions_count(m, p, n.a, defs) {
        return true;
      }
      let mut a = n.b;
      while a != 0 {
        let arm = node_at(p.nodes, a);
        if block_mentions_count(m, p, arm.c, defs) {
          return true;
        }
        a = arm.next;
      }
    }
    k = n.next;
  }
  return false;
}

/// Fills `cnt_fns`: the functions whose own contract, loop invariants or
/// assertions use `vcount` (directly or through spec fns), or that call a
/// function whose contract does; every function when a struct invariant
/// counts. As stage0's `counting_fns`, by definition rather than instance
/// (the instances of one definition all count or all do not).
fn count_gate(v: &mut Vr, m: &Mono, p: &Parser) {
  let mut defs = vec_new[u64]();
  let mut k = p.specs.head;
  while k != 0 {
    let n = node_at(p.nodes, k);
    if mentions_count(m, p, n.c, defs) {
      vec_push(&mut defs, k);
    }
    k = n.next;
  }
  let mut all = false;
  k = p.structs.head;
  while k != 0 {
    let n = node_at(p.nodes, k);
    if n.kind == D_STRUCT && mentions_list(m, p, n.b, defs) {
      all = true;
    }
    k = n.next;
  }
  k = p.fns.head;
  while k != 0 {
    let n = node_at(p.nodes, k);
    if mentions_list(m, p, n.c, defs) || mentions_list(m, p, n.d, defs) {
      vec_push(&mut defs, k);
    }
    k = n.next;
  }
  k = p.fns.head;
  while k != 0 {
    let n = node_at(p.nodes, k);
    if all || has_u(defs, k) || block_mentions_count(m, p, n.x, defs) {
      vec_push(&mut v.cnt_fns, k);
    }
    k = n.next;
  }
  vec_free(defs);
}

/// (lambda ((q Int)) body)
fn lambda_tm(v: &mut Vr, q: u64, body: u64) -> u64 {
  return new_tm(&mut v, VT_LAMBDA, q, body, 0);
}

/// `(and (<= 0 k) (< k 65536))`: k is an I/O port.
fn all_ports(v: &mut Vr) -> u64 {
  let a = app2(&mut v, OP_LE, v.t_zero, v.t_k);
  let b = app2(&mut v, OP_LT, v.t_k, v.t_plimit);
  return app2(&mut v, OP_AND, a, b);
}

/// `(and (<= b k) (< k (+ b n)))`: k is one of the ports b .. b+n.
fn port_range(v: &mut Vr, b: u64, n: u64) -> u64 {
  let lo = app2(&mut v, OP_LE, b, v.t_k);
  let end = app2(&mut v, OP_ADD, b, n);
  let hi = app2(&mut v, OP_LT, v.t_k, end);
  return app2(&mut v, OP_AND, lo, hi);
}

/// The largest value of integer type `t`.
fn int_max(v: &mut Vr, m: &Mono, t: u64) -> u64 {
  let k = kind_t(m, t);
  if k == TY_U8 { return num(&mut v, 255); }
  if k == TY_U16 { return num(&mut v, 65535); }
  if k == TY_U32 { return num(&mut v, 4294967295); }
  if k == TY_I8 { return num(&mut v, 127); }
  if k == TY_I16 { return num(&mut v, 32767); }
  if k == TY_I32 { return num(&mut v, 2147483647); }
  if k == TY_I64 { return num(&mut v, 9223372036854775807); }
  return v.t_u64max;
}

/// Half the modulus of a signed integer type: -(the smallest value).
fn int_half(m: &Mono, t: u64) -> u64 {
  let k = kind_t(m, t);
  if k == TY_I8 { return 128; }
  if k == TY_I16 { return 32768; }
  if k == TY_I32 { return 2147483648; }
  return 9223372036854775808;
}

/// The smallest value of integer type `t`.
fn int_min(v: &mut Vr, m: &Mono, t: u64) -> u64 {
  if is_signed(m, t) {
    return neg_num(&mut v, int_half(m, t));
  }
  return v.t_zero;
}

/// 2^width of integer type `t` (2^64 does not fit in a u64, so it is text).
fn int_mod(v: &mut Vr, m: &Mono, t: u64) -> u64 {
  let k = kind_t(m, t);
  if k == TY_U8 { return num(&mut v, 256); }
  if k == TY_U16 { return num(&mut v, 65536); }
  if k == TY_U32 { return num(&mut v, 4294967296); }
  if k == TY_I8 { return num(&mut v, 256); }
  if k == TY_I16 { return num(&mut v, 65536); }
  if k == TY_I32 { return num(&mut v, 4294967296); }
  return atom_str(&mut v, "18446744073709551616");
}

/// `x` reduced to the range of integer type `t`, as a C conversion to `t`
/// does: modulo 2^width, two's complement for a signed type.
fn wrap_term(v: &mut Vr, m: &Mono, t: u64, x: u64) -> u64 {
  let md = int_mod(&mut v, m, t);
  if is_signed(m, t) {
    let h = num(&mut v, int_half(m, t));
    let a = app2(&mut v, OP_ADD, x, h);
    let r = app2(&mut v, OP_MOD, a, md);
    return app2(&mut v, OP_SUB, r, h);
  }
  return app2(&mut v, OP_MOD, x, md);
}

/// `(ite (>= x 0) x (- x))`
fn t_abs(v: &mut Vr, x: u64) -> u64 {
  let ge = app2(&mut v, OP_GE, x, v.t_zero);
  let n = app1(&mut v, OP_SUB, x);
  return app3(&mut v, OP_ITE, ge, x, n);
}

/// C's division on signed operands, which truncates toward zero (SMT-LIB's
/// `div` rounds so that the remainder is never negative).
fn c_div(v: &mut Vr, a: u64, b: u64) -> u64 {
  let aa = t_abs(&mut v, a);
  let ab = t_abs(&mut v, b);
  let q = app2(&mut v, OP_DIV, aa, ab);
  let ga = app2(&mut v, OP_GE, a, v.t_zero);
  let gb = app2(&mut v, OP_GE, b, v.t_zero);
  let sg = app2(&mut v, OP_EQ, ga, gb);
  let nq = app1(&mut v, OP_SUB, q);
  return app3(&mut v, OP_ITE, sg, q, nq);
}

/// The integer type operator node `i` of instance `x` works on.
fn int_op_ty(c: &Checker, m: &Mono, x: u64, i: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(c.int_ops) {
    let o = vec_get(c.int_ops, k);
    if o.x == x && o.node == i {
      return o.ty;
    }
    k = k + 1;
  }
  return c.tu64;
}

/// Has the checker recorded an integer type for operator node `i` of
/// instance `x`? (A `!` is bitwise exactly when it has.)
fn has_int_op(c: &Checker, x: u64, i: u64) -> bool {
  let mut k = 0;
  while k < vec_len(c.int_ops) {
    let o = vec_get(c.int_ops, k);
    if o.x == x && o.node == i {
      return true;
    }
    k = k + 1;
  }
  return false;
}

/// The width in bits of an integer type.
fn int_bits(m: &Mono, t: u64) -> u64 {
  let k = kind_t(m, t);
  if k == TY_U8 || k == TY_I8 { return 8; }
  if k == TY_U16 || k == TY_I16 { return 16; }
  if k == TY_U32 || k == TY_I32 { return 32; }
  return 64;
}

/// The number 2^k, which may not fit in a u64 (stage0 writes up to 2^127).
fn pow2_num(v: &mut Vr, k: u64) -> u64 {
  // Little-endian decimal digits, doubled k times.
  let mut d = vec_new[u64]();
  vec_push(&mut d, 1);
  let mut j = 0;
  while j < k {
    let mut carry = 0;
    let mut i = 0;
    while i < vec_len(d)
      invariant carry <= 1
    {
      let x = (vec_get(d, i) % 10) * 2 + carry;
      vec_set(&mut d, i, x % 10);
      carry = x / 10;
      i = i + 1;
    }
    if carry > 0 {
      vec_push(&mut d, carry);
    }
    j = j + 1;
  }
  let start = vec_len(v.pool);
  let mut n = vec_len(d);
  while n > 0 {
    n = n - 1;
    vec_push(&mut v.pool, 48 + u_at(d, n) % 10);
  }
  vec_free(d);
  return seal(&mut v, start);
}

/// 2^k for a shift amount `k` already proved less than `w`.
fn pow2_ite(v: &mut Vr, k: u64, w: u64) -> u64 {
  let mut t = num(&mut v, 1);
  let mut i = w;
  while i > 1 {
    i = i - 1;
    let ti = num(&mut v, i);
    let c = app2(&mut v, OP_EQ, k, ti);
    let pi = pow2_num(&mut v, i);
    t = app3(&mut v, OP_ITE, c, pi, t);
  }
  return t;
}

/// If `m` is 2^k - 1, k + 1; otherwise 0.
fn low_mask(m: u64) -> u64 {
  let mut y = m;
  let mut k = 0;
  while y % 2 == 1 && k < 64
    invariant k <= 64
  {
    y = y / 2;
    k = k + 1;
  }
  if y == 0 {
    return k + 1;
  }
  return 0;
}

/// `(not x)`
fn t_not(v: &mut Vr, x: u64) -> u64 {
  return app1(&mut v, OP_NOT, x);
}

/// `(and (<= lo x) (<= x hi))`
fn in_range(v: &mut Vr, lo: u64, x: u64, hi: u64) -> u64 {
  let a = app2(&mut v, OP_LE, lo, x);
  let b = app2(&mut v, OP_LE, x, hi);
  return app2(&mut v, OP_AND, a, b);
}

/// Do two terms print the same?
fn tm_eq(v: &Vr, a: u64, b: u64) -> bool {
  if a == b {
    return true;
  }
  let x = tm_at(v, a);
  let y = tm_at(v, b);
  if x.kind != y.kind {
    return false;
  }
  if x.kind == VT_ATOM {
    return same_text(v, a, b);
  }
  if x.kind == VT_NUM {
    return x.a == y.a;
  }
  if x.kind == VT_FORALL || x.kind == VT_LAMBDA {
    return tm_eq(v, x.a, y.a) && tm_eq(v, x.b, y.b);
  }
  if x.a != y.a || x.c != y.c {
    return false;
  }
  let mut k = 0;
  while k < x.c {
    if !tm_eq(v, targ(v, a, k), targ(v, b, k)) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

fn ite(v: &mut Vr, c: u64, a: u64, b: u64) -> u64 {
  if tm_eq(v, a, b) {
    return a;
  }
  return app3(&mut v, OP_ITE, c, a, b);
}

fn and_all(v: &mut Vr, xs: &Vec[u64]) -> u64 {
  if vec_len(xs) == 0 {
    return v.t_true;
  }
  if vec_len(xs) == 1 {
    return u_at(xs, 0);
  }
  return appv(&mut v, OP_AND, xs);
}

fn or_all(v: &mut Vr, xs: &Vec[u64]) -> u64 {
  if vec_len(xs) == 0 {
    return v.t_false;
  }
  if vec_len(xs) == 1 {
    return u_at(xs, 0);
  }
  return appv(&mut v, OP_OR, xs);
}

// ---- Printing commands (into a text buffer of bytes) ----

fn out_str(out: &mut Vec[u64], s: Str) {
  let mut k = 0;
  while k < slen(s)
    invariant k <= slen(s)
  {
    vec_push(&mut out, cast[u64](sget(s, k)));
    k = k + 1;
  }
}

fn out_num(out: &mut Vec[u64], x: u64) {
  let mut d = vec_new[u64]();
  let mut y = x;
  vec_push(&mut d, 48 + y % 10);
  y = y / 10;
  while y > 0 {
    vec_push(&mut d, 48 + y % 10);
    y = y / 10;
  }
  let mut k = vec_len(d);
  while k > 0 {
    k = k - 1;
    vec_push(&mut out, u_at(d, k));
  }
  vec_free(d);
}

fn out_op(out: &mut Vec[u64], op: u64) {
  if op == OP_ADD { out_str(&mut out, "+"); }
  else if op == OP_SUB { out_str(&mut out, "-"); }
  else if op == OP_MUL { out_str(&mut out, "*"); }
  else if op == OP_DIV { out_str(&mut out, "div"); }
  else if op == OP_MOD { out_str(&mut out, "mod"); }
  else if op == OP_EQ { out_str(&mut out, "="); }
  else if op == OP_LT { out_str(&mut out, "<"); }
  else if op == OP_LE { out_str(&mut out, "<="); }
  else if op == OP_GT { out_str(&mut out, ">"); }
  else if op == OP_GE { out_str(&mut out, ">="); }
  else if op == OP_AND { out_str(&mut out, "and"); }
  else if op == OP_OR { out_str(&mut out, "or"); }
  else if op == OP_NOT { out_str(&mut out, "not"); }
  else if op == OP_IMP { out_str(&mut out, "=>"); }
  else if op == OP_ITE { out_str(&mut out, "ite"); }
  else if op == OP_SELECT { out_str(&mut out, "select"); }
  else if op == OP_STORE { out_str(&mut out, "store"); }
  else if op == OP_CNT { out_str(&mut out, "cnt"); }
}

fn out_tm(out: &mut Vec[u64], v: &Vr, t: u64) {
  let x = tm_at(v, t);
  if x.kind == VT_ATOM {
    let mut k = 0;
    while k < x.b {
      vec_push(&mut out, pool_at(v, vadd(x.a, k)));
      k = k + 1;
    }
  } else if x.kind == VT_NUM {
    out_num(&mut out, x.a);
  } else if x.kind == VT_APP {
    out_str(&mut out, "(");
    out_op(&mut out, x.a);
    let mut k = 0;
    while k < x.c {
      out_str(&mut out, " ");
      out_tm(&mut out, v, targ(v, t, k));
      k = k + 1;
    }
    out_str(&mut out, ")");
  } else if x.kind == VT_FORALL || x.kind == VT_LAMBDA {
    if x.kind == VT_FORALL {
      out_str(&mut out, "(forall ((");
    } else {
      out_str(&mut out, "(lambda ((");
    }
    out_tm(&mut out, v, x.a);
    out_str(&mut out, " Int)) ");
    out_tm(&mut out, v, x.b);
    out_str(&mut out, ")");
  } else if x.kind == VT_FORALLP {
    out_str(&mut out, "(forall ((");
    out_tm(&mut out, v, x.a);
    out_str(&mut out, " Int)) (! ");
    out_tm(&mut out, v, x.b);
    out_str(&mut out, " :pattern (");
    out_tm(&mut out, v, u_at(v.targs, x.c));
    out_str(&mut out, ") :pattern (");
    out_tm(&mut out, v, u_at(v.targs, vadd(x.c, 1)));
    out_str(&mut out, ")))");
  }
}

fn out_sort(out: &mut Vec[u64], so: u64) {
  let mut d = so / 2;
  let depth = d;
  while d > 0 {
    out_str(&mut out, "(Array Int ");
    d = d - 1;
  }
  if so % 2 == SO_BOOL { out_str(&mut out, "Bool"); } else { out_str(&mut out, "Int"); }
  while d < depth {
    out_str(&mut out, ")");
    d = d + 1;
  }
}

/// The two commands every session starts with.
fn out_header(out: &mut Vec[u64]) {
  out_str(&mut out, "(set-option :produce-models true)\n");
  out_str(&mut out, "(set-option :timeout 10000)\n");
}

/// Command `cmd`, with its newline.
fn out_cmd(out: &mut Vec[u64], v: &Vr, cmd: Cmd) {
  if cmd.kind == CMD_DECL {
    out_str(&mut out, "(declare-const ");
    out_tm(&mut out, v, cmd.a);
    out_str(&mut out, " ");
    out_sort(&mut out, cmd.b);
    out_str(&mut out, ")\n");
  } else if cmd.kind == CMD_ASSERT {
    out_str(&mut out, "(assert ");
    out_tm(&mut out, v, cmd.a);
    out_str(&mut out, ")\n");
  } else if cmd.kind == CMD_RAW {
    out_tm(&mut out, v, cmd.a);
    out_str(&mut out, "\n");
  } else if cmd.kind == CMD_PUSH {
    out_str(&mut out, "(push 1)\n");
  } else if cmd.kind == CMD_POP {
    out_str(&mut out, "(pop 1)\n");
  } else if cmd.kind == CMD_CHECK {
    out_str(&mut out, "(check-sat)\n");
  }
}

/// Writes the bytes in `out` to the console and empties it.
fn flush_out(con: &Serial, out: &mut Vec[u64]) {
  let mut k = 0;
  while k < vec_len(out) {
    let ch = u_at(out, k);
    if ch <= 255 {
      serial_write(con, cast[u8](ch));
    }
    k = k + 1;
  }
  while vec_len(out) > 0 {
    vec_pop(&mut out);
  }
}

/// Prints every command sent so far, one per line, as `--dump-smt` does.
fn put_log(con: &Serial, v: &Vr) {
  let mut out = vec_new[u64]();
  out_header(&mut out);
  let mut k = 0;
  while k < vec_len(v.log) {
    out_cmd(&mut out, v, vec_get(v.log, k));
    if vec_len(out) > 65536 {
      flush_out(con, &mut out);
    }
    k = k + 1;
  }
  flush_out(con, &mut out);
  vec_free(out);
}

fn send(v: &mut Vr, kind: u64, a: u64, b: u64) {
  vec_push(&mut v.log, Cmd { kind: kind, a: a, b: b });
}

fn assert_tm(v: &mut Vr, t: u64) {
  send(&mut v, CMD_ASSERT, t, 0);
}

// ---- Fresh names ----

/// A new SMT name: the hint with every character that is not a letter or
/// digit made `_`, then `!` and a counter.
fn fresh_name(v: &mut Vr, hint: u64) -> u64 {
  if v.counter < U64_MAX {
    v.counter = v.counter + 1;
  }
  let start = vec_len(v.pool);
  let h = tm_at(v, hint);
  let mut k = 0;
  while k < h.b {
    let ch = pool_at(v, vadd(h.a, k));
    if (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) {
      vec_push(&mut v.pool, ch);
    } else {
      vec_push(&mut v.pool, 95);
    }
    k = k + 1;
  }
  vec_push(&mut v.pool, 33);
  push_num(&mut v, v.counter);
  return seal(&mut v, start);
}

fn fresh_int(v: &mut Vr, hint: u64, lo: u64, hi: u64) -> u64 {
  let n = fresh_name(&mut v, hint);
  send(&mut v, CMD_DECL, n, SO_INT);
  let r = in_range(&mut v, lo, n, hi);
  assert_tm(&mut v, r);
  return n;
}

fn fresh_u64(v: &mut Vr, hint: u64) -> u64 {
  let t = fresh_int(&mut v, hint, v.t_zero, v.t_u64max);
  return mk(&mut v, VV_U, 0, t, 0, 0, 0);
}

fn fresh_bool(v: &mut Vr, hint: u64) -> u64 {
  let n = fresh_name(&mut v, hint);
  send(&mut v, CMD_DECL, n, SO_BOOL);
  return mk(&mut v, VV_B, 0, n, 0, 0, 0);
}

fn fresh_len(v: &mut Vr, hint: u64) -> u64 {
  let h = pre_str(&mut v, "len_", hint);
  return fresh_int(&mut v, h, v.t_zero, v.t_allocmax);
}

/// A fresh array from Int to `so`.
fn fresh_array(v: &mut Vr, hint: u64, so: u64) -> u64 {
  let h = pre_str(&mut v, "data_", hint);
  let n = fresh_name(&mut v, h);
  send(&mut v, CMD_DECL, n, vadd(so, 2));
  return n;
}

// ---- Values ----

fn vl_at(v: &Vr, x: u64) -> Vl {
  if x < vec_len(v.vals) {
    return vec_get(v.vals, x);
  }
  return Vl { kind: 0, ty: 0, a: 0, b: 0, c: 0, n: 0, d: 0 };
}

fn mk(v: &mut Vr, kind: u64, tyx: u64, a: u64, b: u64, c: u64, n: u64) -> u64 {
  let k = vec_len(v.vals);
  vec_push(&mut v.vals, Vl { kind: kind, ty: tyx, a: a, b: b, c: c, n: n, d: 0 });
  return k;
}

/// An object of type `tyx` with ghost fields a, b, c, d (n of them).
fn mk_o(v: &mut Vr, tyx: u64, a: u64, b: u64, c: u64, d: u64, n: u64) -> u64 {
  let k = vec_len(v.vals);
  vec_push(&mut v.vals, Vl { kind: VV_OBJ, ty: tyx, a: a, b: b, c: c, n: n, d: d });
  return k;
}

fn mk_u(v: &mut Vr, t: u64) -> u64 {
  return mk(&mut v, VV_U, 0, t, 0, 0, 0);
}

fn mk_b(v: &mut Vr, t: u64) -> u64 {
  return mk(&mut v, VV_B, 0, t, 0, 0, 0);
}

/// Stores a list of child values; returns where it starts.
fn put_kids(v: &mut Vr, xs: &Vec[u64]) -> u64 {
  let start = vec_len(v.kids);
  let mut k = 0;
  while k < vec_len(xs) {
    vec_push(&mut v.kids, u_at(xs, k));
    k = k + 1;
  }
  return start;
}

fn mk_struct(v: &mut Vr, tyx: u64, xs: &Vec[u64]) -> u64 {
  let start = put_kids(&mut v, xs);
  return mk(&mut v, VV_STRUCT, tyx, start, 0, 0, vec_len(xs));
}

fn mk_enum(v: &mut Vr, tyx: u64, tag: u64, xs: &Vec[u64]) -> u64 {
  let start = put_kids(&mut v, xs);
  return mk(&mut v, VV_ENUM, tyx, tag, start, 0, vec_len(xs));
}

/// Child `j` of a struct or enum value.
fn kid(v: &Vr, x: u64, j: u64) -> u64 {
  let xv = vl_at(v, x);
  let mut start = xv.a;
  if xv.kind == VV_ENUM {
    start = xv.b;
  }
  if j >= xv.n {
    return 0;
  }
  return u_at(v.kids, vadd(start, j));
}

/// The scalar term of a U or B value.
fn term(v: &Vr, x: u64) -> u64 {
  let xv = vl_at(v, x);
  return xv.a;
}

/// How many ghost fields an object of type kind `k` has.
fn obj_fields(k: u64) -> u64 {
  if k == TY_PT { return 4; }
  if k == TY_POOL { return 2; }
  if k == TY_FRAME || k == TY_MMU || k == TY_PORTS || k == TY_MMIOSPACE || k == TY_DMA { return 1; }
  if k == TY_PORTIO || k == TY_MMIO { return 2; }
  return 0;
}

fn obj_field(v: &Vr, x: u64, j: u64) -> u64 {
  let xv = vl_at(v, x);
  if j == 0 { return xv.a; }
  if j == 1 { return xv.b; }
  if j == 2 { return xv.c; }
  return xv.d;
}

// The ghost fields by name.
fn g_id(v: &Vr, x: u64) -> u64 { return obj_field(v, x, 0); }       // Frame, PageTable, Dma
fn g_level(v: &Vr, x: u64) -> u64 { return obj_field(v, x, 1); }    // PageTable
fn g_used(v: &Vr, x: u64) -> u64 { return obj_field(v, x, 2); }     // PageTable
fn g_leases(v: &Vr, x: u64) -> u64 { return obj_field(v, x, 3); }   // PageTable
fn g_has(v: &Vr, x: u64) -> u64 { return obj_field(v, x, 0); }      // Pool
fn g_size(v: &Vr, x: u64) -> u64 { return obj_field(v, x, 1); }     // Pool
fn g_root(v: &Vr, x: u64) -> u64 { return obj_field(v, x, 0); }     // Mmu
fn g_free(v: &Vr, x: u64) -> u64 { return obj_field(v, x, 0); }     // Ports
fn g_base(v: &Vr, x: u64) -> u64 { return obj_field(v, x, 0); }     // PortIo
fn g_count(v: &Vr, x: u64) -> u64 { return obj_field(v, x, 1); }    // PortIo
fn g_len(v: &Vr, x: u64) -> u64 { return obj_field(v, x, 1); }      // Mmio

fn mk_obj(v: &mut Vr, m: &Mono, tyx: u64, a: u64, b: u64, c: u64) -> u64 {
  return mk_o(&mut v, tyx, a, b, c, 0, obj_fields(kind_t(m, tyx)));
}

/// A page table: id, level, used, leases.
fn mk_pt(v: &mut Vr, tyx: u64, id: u64, level: u64, used: u64, leases: u64) -> u64 {
  return mk_o(&mut v, tyx, id, level, used, leases, 4);
}

/// The sort of ghost field `j` of an object of type kind `k`: an array of
/// Bool for `used` and `has`, Int otherwise.
fn obj_field_sort(k: u64, j: u64) -> u64 {
  if (k == TY_PT && j == 2) || ((k == TY_POOL || k == TY_PORTS || k == TY_MMIOSPACE) && j == 0) {
    return SO_BOOL + 2;
  }
  return SO_INT;
}

/// Do two values print the same, term by term?
fn val_eq(v: &Vr, a: u64, b: u64) -> bool {
  if a == b {
    return true;
  }
  let x = vl_at(v, a);
  let y = vl_at(v, b);
  if x.kind != y.kind || x.ty != y.ty || x.n != y.n {
    return false;
  }
  let k = x.kind;
  if k == VV_U || k == VV_B {
    return tm_eq(v, x.a, y.a);
  }
  if k == VV_BUF || k == VV_STR {
    return tm_eq(v, x.a, y.a) && tm_eq(v, x.b, y.b);
  }
  if k == VV_OBJ {
    return (x.n < 1 || tm_eq(v, x.a, y.a)) && (x.n < 2 || tm_eq(v, x.b, y.b)) && (x.n < 3 || tm_eq(v, x.c, y.c))
      && (x.n < 4 || tm_eq(v, x.d, y.d));
  }
  if k == VV_STRUCT || k == VV_ENUM {
    if k == VV_ENUM && !tm_eq(v, x.a, y.a) {
      return false;
    }
    let mut j = 0;
    while j < x.n {
      if !val_eq(v, kid(v, a, j), kid(v, b, j)) {
        return false;
      }
      j = j + 1;
    }
    return true;
  }
  if k == VV_BOXK {
    return val_eq(v, x.a, y.a);
  }
  if k == VV_VEC {
    return tm_eq(v, x.a, y.a) && val_eq(v, x.b, y.b);
  }
  return true;            // VV_BOXO (same type) and VV_UNIT
}

/// `if c then a else b`, field by field.
fn merge(v: &mut Vr, c: u64, a: u64, b: u64) -> u64 {
  if a == b {
    return a;
  }
  let x = vl_at(v, a);
  let y = vl_at(v, b);
  let k = x.kind;
  if k == VV_U || k == VV_B {
    let t = ite(&mut v, c, x.a, y.a);
    return mk(&mut v, k, 0, t, 0, 0, 0);
  }
  if k == VV_BUF || k == VV_STR {
    let l = ite(&mut v, c, x.a, y.a);
    let d = ite(&mut v, c, x.b, y.b);
    return mk(&mut v, k, 0, l, d, 0, 0);
  }
  if k == VV_OBJ {
    let mut f0 = 0;
    let mut f1 = 0;
    let mut f2 = 0;
    if x.n > 0 { f0 = ite(&mut v, c, x.a, y.a); }
    if x.n > 1 { f1 = ite(&mut v, c, x.b, y.b); }
    if x.n > 2 { f2 = ite(&mut v, c, x.c, y.c); }
    let mut f3 = 0;
    if x.n > 3 { f3 = ite(&mut v, c, x.d, y.d); }
    return mk_o(&mut v, x.ty, f0, f1, f2, f3, x.n);
  }
  if k == VV_STRUCT || k == VV_ENUM {
    let mut tag = 0;
    if k == VV_ENUM {
      tag = ite(&mut v, c, x.a, y.a);
    }
    let mut xs = vec_new[u64]();
    let mut j = 0;
    while j < x.n {
      let ka = kid(v, a, j);
      let kb = kid(v, b, j);
      let mm = merge(&mut v, c, ka, kb);
      vec_push(&mut xs, mm);
      j = j + 1;
    }
    let mut r = 0;
    if k == VV_ENUM {
      r = mk_enum(&mut v, x.ty, tag, xs);
    } else {
      r = mk_struct(&mut v, x.ty, xs);
    }
    vec_free(xs);
    return r;
  }
  if k == VV_VEC {
    let l = ite(&mut v, c, x.a, y.a);
    let el = merge(&mut v, c, x.b, y.b);
    return mk(&mut v, VV_VEC, x.ty, l, el, 0, 0);
  }
  if k == VV_BOXK && y.kind == VV_BOXK {
    let inner = merge(&mut v, c, x.a, y.a);
    return mk(&mut v, VV_BOXK, 0, inner, 0, 0, 0);
  }
  // Forgetting what one side knew about a box is sound.
  if k == VV_BOXO {
    return a;
  }
  if y.kind == VV_BOXO {
    return b;
  }
  return a;               // VV_UNIT
}

/// Appends the SMT terms `x` is made of, and their sorts, in a fixed order
/// that depends only on its type. Box contents are left out; a vector's
/// element terms are arrays one level deeper than the element's own.
fn leaves_of(v: &Vr, m: &Mono, x: u64, ts: &mut Vec[u64], sorts: &mut Vec[u64]) {
  let xv = vl_at(v, x);
  let k = xv.kind;
  if k == VV_U {
    vec_push(&mut ts, xv.a);
    vec_push(&mut sorts, SO_INT);
  } else if k == VV_B {
    vec_push(&mut ts, xv.a);
    vec_push(&mut sorts, SO_BOOL);
  } else if k == VV_BUF || k == VV_STR {
    vec_push(&mut ts, xv.a);
    vec_push(&mut sorts, SO_INT);
    vec_push(&mut ts, xv.b);
    vec_push(&mut sorts, SO_INT + 2);
  } else if k == VV_OBJ {
    let tk = kind_t(m, xv.ty);
    let mut j = 0;
    while j < xv.n {
      vec_push(&mut ts, obj_field(v, x, j));
      vec_push(&mut sorts, obj_field_sort(tk, j));
      j = j + 1;
    }
  } else if k == VV_STRUCT || k == VV_ENUM {
    if k == VV_ENUM {
      vec_push(&mut ts, xv.a);
      vec_push(&mut sorts, SO_INT);
    }
    let mut j = 0;
    while j < xv.n {
      leaves_of(v, m, kid(v, x, j), &mut ts, &mut sorts);
      j = j + 1;
    }
  } else if k == VV_VEC {
    vec_push(&mut ts, xv.a);
    vec_push(&mut sorts, SO_INT);
    let mut its = vec_new[u64]();
    let mut iso = vec_new[u64]();
    leaves_of(v, m, xv.b, &mut its, &mut iso);
    let mut j = 0;
    while j < vec_len(its) {
      vec_push(&mut ts, u_at(its, j));
      vec_push(&mut sorts, vadd(u_at(iso, j), 2));
      j = j + 1;
    }
    vec_free(its);
    vec_free(iso);
  }
}

/// The value shaped like `x` whose terms are `ts[v.cur ..]`, in the order
/// of `leaves_of` (moving `v.cur` past them).
fn rebuild(v: &mut Vr, x: u64, ts: &Vec[u64]) -> u64 {
  let xv = vl_at(v, x);
  let k = xv.kind;
  if k == VV_U || k == VV_B {
    let t = next_leaf(&mut v, ts);
    return mk(&mut v, k, 0, t, 0, 0, 0);
  }
  if k == VV_BUF || k == VV_STR {
    let l = next_leaf(&mut v, ts);
    let d = next_leaf(&mut v, ts);
    return mk(&mut v, k, 0, l, d, 0, 0);
  }
  if k == VV_OBJ {
    let mut f0 = 0;
    let mut f1 = 0;
    let mut f2 = 0;
    if xv.n > 0 { f0 = next_leaf(&mut v, ts); }
    if xv.n > 1 { f1 = next_leaf(&mut v, ts); }
    if xv.n > 2 { f2 = next_leaf(&mut v, ts); }
    let mut f3 = 0;
    if xv.n > 3 { f3 = next_leaf(&mut v, ts); }
    return mk_o(&mut v, xv.ty, f0, f1, f2, f3, xv.n);
  }
  if k == VV_STRUCT || k == VV_ENUM {
    let mut tag = 0;
    if k == VV_ENUM {
      tag = next_leaf(&mut v, ts);
    }
    let mut xs = vec_new[u64]();
    let mut j = 0;
    while j < xv.n {
      let r = rebuild(&mut v, kid(v, x, j), ts);
      vec_push(&mut xs, r);
      j = j + 1;
    }
    let mut out = 0;
    if k == VV_ENUM {
      out = mk_enum(&mut v, xv.ty, tag, xs);
    } else {
      out = mk_struct(&mut v, xv.ty, xs);
    }
    vec_free(xs);
    return out;
  }
  if k == VV_VEC {
    let l = next_leaf(&mut v, ts);
    let el = rebuild(&mut v, xv.b, ts);
    return mk(&mut v, VV_VEC, xv.ty, l, el, 0, 0);
  }
  return x;               // boxes and unit stay as they are
}

fn next_leaf(v: &mut Vr, ts: &Vec[u64]) -> u64 {
  let t = u_at(ts, v.cur);
  v.cur = vadd(v.cur, 1);
  return t;
}

/// The lifted elements `elems` with `x` stored at index `i`.
fn vec_write(v: &mut Vr, m: &Mono, elems: u64, i: u64, x: u64) -> u64 {
  let mut xs = vec_new[u64]();
  let mut xso = vec_new[u64]();
  leaves_of(v, m, x, &mut xs, &mut xso);
  let mut arrs = vec_new[u64]();
  let mut aso = vec_new[u64]();
  leaves_of(v, m, elems, &mut arrs, &mut aso);
  let mut out = vec_new[u64]();
  let mut j = 0;
  while j < vec_len(arrs) {
    let st = app3(&mut v, OP_STORE, u_at(arrs, j), i, u_at(xs, j));
    vec_push(&mut out, st);
    j = j + 1;
  }
  v.cur = 0;
  let r = rebuild(&mut v, elems, out);
  vec_free(xs);
  vec_free(xso);
  vec_free(arrs);
  vec_free(aso);
  vec_free(out);
  return r;
}

/// The lifted elements read at index `i`: every array term selected.
fn select_all(v: &mut Vr, m: &Mono, elems: u64, i: u64) -> u64 {
  let mut arrs = vec_new[u64]();
  let mut aso = vec_new[u64]();
  leaves_of(v, m, elems, &mut arrs, &mut aso);
  let mut out = vec_new[u64]();
  let mut j = 0;
  while j < vec_len(arrs) {
    let s = app2(&mut v, OP_SELECT, u_at(arrs, j), i);
    vec_push(&mut out, s);
    j = j + 1;
  }
  v.cur = 0;
  let r = rebuild(&mut v, elems, out);
  vec_free(arrs);
  vec_free(aso);
  vec_free(out);
  return r;
}

/// Looks through known boxes.
fn unbox_known(v: &Vr, x: u64) -> u64 {
  let mut y = x;
  let mut xv = vl_at(v, y);
  let mut n = 0;
  while xv.kind == VV_BOXK && n < SRC_MAX {
    y = xv.a;
    xv = vl_at(v, y);
    n = n + 1;
  }
  return y;
}

// ---- Variables and places ----

fn bind_at(env: &Vec[Bind], k: u64) -> Bind {
  if k < vec_len(env) {
    return vec_get(env, k);
  }
  return Bind { s: 0, e: 0, val: 0 };
}

fn env_clone(env: &Vec[Bind]) -> Vec[Bind] {
  let mut out = vec_new[Bind]();
  let mut k = 0;
  while k < vec_len(env) {
    vec_push(&mut out, bind_at(env, k));
    k = k + 1;
  }
  return out;
}

/// The value of the variable named `s..e`, or 0.
fn env_find(env: &Vec[Bind], p: &Parser, s: u64, e: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(env) {
    let b = bind_at(env, k);
    if same(p.src, b.s, b.e, s, e) {
      return b.val;
    }
    k = k + 1;
  }
  return 0;
}

/// Is `b` the variable named pool[rs .. rs + rl]?
fn bind_named(v: &Vr, p: &Parser, b: Bind, rs: u64, rl: u64) -> bool {
  if b.s > b.e {
    // A hidden variable: its name is pool[b.e .. b.s].
    if b.s - b.e != rl {
      return false;
    }
    let mut k = 0;
    while k < rl {
      if pool_at(v, vadd(rs, k)) != pool_at(v, vadd(b.e, k)) {
        return false;
      }
      k = k + 1;
    }
    return true;
  }
  return rng_is_src(v, rs, rl, p, b.s, b.e);
}

/// The value of the variable named pool[rs .. rs + rl], or 0.
fn env_find_rng(env: &Vec[Bind], v: &Vr, p: &Parser, rs: u64, rl: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(env) {
    let b = bind_at(env, k);
    if bind_named(v, p, b, rs, rl) {
      return b.val;
    }
    k = k + 1;
  }
  return 0;
}

/// Gives the variable named `s..e` the value `x` (adding it if it is new).
fn env_put(env: &mut Vec[Bind], p: &Parser, s: u64, e: u64, x: u64) {
  let mut k = 0;
  while k < vec_len(env) {
    let b = bind_at(env, k);
    if same(p.src, b.s, b.e, s, e) {
      vec_set(&mut env, k, Bind { s: b.s, e: b.e, val: x });
      return;
    }
    k = k + 1;
  }
  vec_push(&mut env, Bind { s: s, e: e, val: x });
}

fn env_set_rng(env: &mut Vec[Bind], v: &Vr, p: &Parser, rs: u64, rl: u64, x: u64) {
  let mut k = 0;
  while k < vec_len(env) {
    let b = bind_at(env, k);
    if bind_named(v, p, b, rs, rl) {
      vec_set(&mut env, k, Bind { s: b.s, e: b.e, val: x });
      return;
    }
    k = k + 1;
  }
}

fn st_clone(st: &VState) -> VState {
  return VState { pc: copy_set(st.pc), env: env_clone(st.env), live: st.live };
}

fn st_free(st: VState) {
  vec_free(st.pc);
  vec_free(st.env);
}

/// A state no path reaches.
fn st_dead() -> VState {
  return VState { pc: vec_new[u64](), env: vec_new[Bind](), live: false };
}

/// The number of fields (or variants) of the struct or enum type `t`.
fn nparts(m: &Mono, p: &Parser, t: u64) -> u64 {
  let dn = def_node(m, p, inner_t(m, t));
  return list_len(p, dn.a);
}

/// The node of field (or variant) `j` of the struct or enum type `t`.
fn part_node(m: &Mono, p: &Parser, t: u64, j: u64) -> Node {
  let dn = def_node(m, p, inner_t(m, t));
  let mut f = dn.a;
  let mut k = 0;
  while f != 0 && k < j {
    f = next_of(p, f);
    k = k + 1;
  }
  return node_at(p.nodes, f);
}

/// The type of field (or payload of variant) `j` of type `t`, 0 for none.
fn part_ty(c: &Checker, m: &Mono, t: u64, j: u64) -> u64 {
  return fld_ty(c, inner_t(m, t), j);
}

/// The index + 1 of the variant named `s..e` of the enum type `t`, or 0.
fn variant_index(m: &Mono, p: &Parser, t: u64, s: u64, e: u64) -> u64 {
  let dn = def_node(m, p, inner_t(m, t));
  return index_in(p, dn.a, s, e);
}

/// Field pool[rs .. rs + rl] of the struct value `x`, or 0.
fn field_of(v: &Vr, m: &Mono, p: &Parser, x: u64, rs: u64, rl: u64) -> u64 {
  let xv = vl_at(v, x);
  if xv.kind != VV_STRUCT {
    return 0;
  }
  let dn = def_node(m, p, inner_t(m, xv.ty));
  let mut f = dn.a;
  let mut j = 0;
  while f != 0 && j < SRC_MAX {
    let fd = node_at(p.nodes, f);
    if rng_is_src(v, rs, rl, p, fd.s, fd.e) {
      return kid(v, x, j);
    }
    f = fd.next;
    j = j + 1;
  }
  return 0;
}

/// Where the part of the dotted path `path` that starts at `i` ends (at
/// the next `.` or the end).
fn seg_end(v: &Vr, path: u64, i: u64) -> u64 {
  let pt = tm_at(v, path);
  let mut j = i;
  while j < pt.b && pool_at(v, vadd(pt.a, j)) != 46 {
    j = j + 1;
  }
  if j < i {
    return i;
  }
  return j;
}

/// The value at a dotted path (boxes on the way already opened).
fn get_path(v: &Vr, m: &Mono, p: &Parser, env: &Vec[Bind], path: u64) -> u64 {
  let pt = tm_at(v, path);
  let mut i = seg_end(v, path, 0);
  let mut x = env_find_rng(env, v, p, pt.a, i);
  while i < pt.b {
    let fs = i + 1;
    let j = seg_end(v, path, fs);
    x = unbox_known(v, x);
    if j >= fs {
      x = field_of(v, m, p, x, vadd(pt.a, fs), j - fs);
    }
    i = j;
  }
  return x;
}

/// Replaces the value at a dotted path.
fn set_path(v: &mut Vr, m: &Mono, p: &Parser, env: &mut Vec[Bind], path: u64, nv: u64) {
  let pt = tm_at(v, path);
  let i = seg_end(v, path, 0);
  let oenv = env_find_rng(env, v, p, pt.a, i);
  let r = set_in(&mut v, m, p, oenv, path, i, nv);
  env_set_rng(&mut env, v, p, pt.a, i, r);
}

/// `x` with the part of `path` from position `i` on replaced by `nv`.
fn set_in(v: &mut Vr, m: &Mono, p: &Parser, x: u64, path: u64, i: u64, nv: u64) -> u64 {
  let pt = tm_at(v, path);
  if i >= pt.b {
    return nv;
  }
  let xv = vl_at(v, x);
  if xv.kind == VV_BOXK {
    let inner = set_in(&mut v, m, p, xv.a, path, i, nv);
    return mk(&mut v, VV_BOXK, 0, inner, 0, 0, 0);
  }
  if xv.kind != VV_STRUCT {
    return x;
  }
  let fs = i + 1;
  let j = seg_end(v, path, fs);
  if j < fs {
    return x;
  }
  let dn = def_node(m, p, inner_t(m, xv.ty));
  let mut xs = vec_new[u64]();
  let mut f = dn.a;
  let mut k = 0;
  while f != 0 && k < xv.n {
    let fd = node_at(p.nodes, f);
    let mut y = kid(v, x, k);
    if rng_is_src(v, vadd(pt.a, fs), j - fs, p, fd.s, fd.e) {
      y = set_in(&mut v, m, p, y, path, j, nv);
    }
    vec_push(&mut xs, y);
    f = fd.next;
    k = k + 1;
  }
  let r = mk_struct(&mut v, xv.ty, xs);
  vec_free(xs);
  return r;
}

/// The dotted path a place expression spells (`x.f.g`), or 0.
fn place_text(v: &mut Vr, p: &Parser, i: u64) -> u64 {
  let n = node_at(p.nodes, i);
  if n.kind != E_VAR && n.kind != E_FIELD {
    return 0;
  }
  let start = vec_len(v.pool);
  if !push_place(&mut v, p, i) {
    return 0;
  }
  return seal(&mut v, start);
}

fn push_place(v: &mut Vr, p: &Parser, i: u64) -> bool {
  let n = node_at(p.nodes, i);
  if n.kind == E_VAR {
    push_src(&mut v, p, n.s, n.e);
    return true;
  }
  if n.kind == E_FIELD {
    if !push_place(&mut v, p, n.a) {
      return false;
    }
    push_str(&mut v, ".");
    push_src(&mut v, p, n.s, n.e);
    return true;
  }
  return false;
}

/// The dotted path a list of names spells.
fn list_text(v: &mut Vr, p: &Parser, head: u64) -> u64 {
  let start = vec_len(v.pool);
  let mut k = head;
  while k != 0 {
    let n = node_at(p.nodes, k);
    if k != head {
      push_str(&mut v, ".");
    }
    push_src(&mut v, p, n.s, n.e);
    k = n.next;
  }
  return seal(&mut v, start);
}

// ---- Fresh values ----

fn fresh_field(v: &mut Vr, tk: u64, j: u64, hint: u64) -> u64 {
  if tk == TY_PT && j == 2 {
    let h = cat_str(&mut v, hint, "_used");
    return fresh_array(&mut v, h, SO_BOOL);
  }
  if tk == TY_POOL && j == 0 {
    let h = cat_str(&mut v, hint, "_has");
    return fresh_array(&mut v, h, SO_BOOL);
  }
  if tk == TY_MMIOSPACE {
    let h = cat_str(&mut v, hint, "_free");
    return fresh_array(&mut v, h, SO_BOOL);
  }
  if tk == TY_MMIO {
    if j == 1 {
      let h = cat_str(&mut v, hint, "_len");
      return fresh_int(&mut v, h, v.t_zero, v.t_mmio_hi);
    }
    let h = cat_str(&mut v, hint, "_base");
    return fresh_int(&mut v, h, v.t_mmio_lo, v.t_mmio_hi);
  }
  if tk == TY_PORTS {
    let h = cat_str(&mut v, hint, "_free");
    return fresh_array(&mut v, h, SO_BOOL);
  }
  if tk == TY_PORTIO {
    let mut h = cat_str(&mut v, hint, "_base");
    if j == 1 {
      h = cat_str(&mut v, hint, "_count");
    }
    return fresh_int(&mut v, h, v.t_zero, v.t_plimit);
  }
  if tk == TY_POOL {
    return v.t_poolsize;
  }
  if tk == TY_PT && j == 3 {
    let h = cat_str(&mut v, hint, "_leases");
    return fresh_int(&mut v, h, v.t_zero, v.t_u64max);
  }
  if tk == TY_PT && j == 1 {
    let h = cat_str(&mut v, hint, "_level");
    let one = num(&mut v, 1);
    let five = num(&mut v, 5);
    return fresh_int(&mut v, h, one, five);
  }
  if tk == TY_MMU {
    let h = cat_str(&mut v, hint, "_root");
    return fresh_int(&mut v, h, v.t_zero, v.t_flimit);
  }
  let h = cat_str(&mut v, hint, "_id");
  let n = fresh_int(&mut v, h, v.t_zero, v.t_flimit);
  let lt = app2(&mut v, OP_LT, n, v.t_poolsize);
  assert_tm(&mut v, lt);
  return n;
}

/// Ghost fields a loop keeps when only builtins that never change them
/// change the object (a page table keeps its id and level).
fn kept_by_builtins(tk: u64, j: u64) -> bool {
  return ((tk == TY_FRAME || tk == TY_PT || tk == TY_DMA) && j == 0) || (tk == TY_PT && (j == 1 || j == 3)) || (tk == TY_POOL && j == 1)
    || ((tk == TY_PORTIO || tk == TY_MMIO) && j <= 1);
}

/// Fresh ghost fields for an object of type `tyx`. `live`: a table that
/// may be live at any level (a borrowed one, see `fresh_of`).
fn fresh_obj(v: &mut Vr, m: &Mono, tyx: u64, hint: u64, live: bool) -> u64 {
  let tk = kind_t(m, tyx);
  let n = obj_fields(tk);
  let mut f0 = 0;
  let mut f1 = 0;
  let mut f2 = 0;
  if n > 0 { f0 = fresh_field(&mut v, tk, 0, hint); }
  if n > 1 { f1 = fresh_field(&mut v, tk, 1, hint); }
  if n > 2 { f2 = fresh_field(&mut v, tk, 2, hint); }
  let mut f3 = 0;
  if n > 3 { f3 = fresh_field(&mut v, tk, 3, hint); }
  if tk == TY_PORTIO || tk == TY_MMIO {
    let sum = app2(&mut v, OP_ADD, f0, f1);
    let mut lim = v.t_plimit;
    if tk == TY_MMIO {
      lim = v.t_mmio_hi;
    }
    let le = app2(&mut v, OP_LE, sum, lim);
    assert_tm(&mut v, le);
  }
  // An owned table below the top is never live: it was taken out of a
  // tree no processor ran on, or never in one (only `pt_borrow` lends a
  // live one, and only as `&mut`).
  if tk == TY_PT && !live {
    let four = num(&mut v, 4);
    let below = app2(&mut v, OP_LT, f1, four);
    let none = app2(&mut v, OP_EQ, f3, v.t_zero);
    let imp = app2(&mut v, OP_IMP, below, none);
    assert_tm(&mut v, imp);
  }
  return mk_o(&mut v, tyx, f0, f1, f2, f3, n);
}

/// A value of type `tyx` about which nothing is known but its type.
fn fresh_of(v: &mut Vr, c: &Checker, m: &Mono, p: &Parser, tyx: u64, hint: u64) -> u64 {
  let k = kind_t(m, tyx);
  if k == TY_U64 {
    return fresh_u64(&mut v, hint);
  }
  if k == TY_U8 || k == TY_U16 || k == TY_U32 || is_signed(m, tyx) {
    let min = int_min(&mut v, m, tyx);
    let max = int_max(&mut v, m, tyx);
    let t = fresh_int(&mut v, hint, min, max);
    return mk_u(&mut v, t);
  }
  if k == TY_BOOL {
    return fresh_bool(&mut v, hint);
  }
  if k == TY_BUF || k == TY_STR {
    let l = fresh_len(&mut v, hint);
    let d = fresh_array(&mut v, hint, SO_INT);
    if k == TY_STR {
      return mk(&mut v, VV_STR, 0, l, d, 0, 0);
    }
    return mk(&mut v, VV_BUF, 0, l, d, 0, 0);
  }
  if k == TY_BYTES {
    // Every byte of a Bytes value is <= 255.
    let d = fresh_array(&mut v, hint, SO_INT);
    let sel = app2(&mut v, OP_SELECT, d, v.t_k);
    let r = in_range(&mut v, v.t_zero, sel, v.t_255);
    let all = forall_tm(&mut v, v.t_k, r);
    assert_tm(&mut v, all);
    let l = fresh_len(&mut v, hint);
    return mk(&mut v, VV_BUF, 0, l, d, 0, 0);
  }
  if k == TY_REF || k == TY_MUTREF {
    // A borrowed table may be one `pt_borrow` lent, with its tree's
    // leases at any level.
    if kind_t(m, inner_t(m, tyx)) == TY_PT {
      return fresh_obj(&mut v, m, inner_t(m, tyx), hint, true);
    }
    return fresh_of(&mut v, c, m, p, inner_t(m, tyx), hint);
  }
  if k == TY_UNIT {
    return v.unit;
  }
  if k == TY_STRUCT {
    let n = nparts(m, p, tyx);
    let mut xs = vec_new[u64]();
    let mut j = 0;
    while j < n {
      let fd = part_node(m, p, tyx, j);
      let h = cat_src(&mut v, p, hint, fd.s, fd.e);
      let x = fresh_of(&mut v, c, m, p, part_ty(c, m, tyx, j), h);
      vec_push(&mut xs, x);
      j = j + 1;
    }
    let r = mk_struct(&mut v, tyx, xs);
    vec_free(xs);
    return r;
  }
  if k == TY_ENUM {
    let n = nparts(m, p, tyx);
    let ht = cat_str(&mut v, hint, "_tag");
    let mut hi = 0;
    if n > 0 {
      hi = n - 1;
    }
    let top = num(&mut v, hi);
    let tag = fresh_int(&mut v, ht, v.t_zero, top);
    let mut xs = vec_new[u64]();
    let mut j = 0;
    while j < n {
      let pt = part_ty(c, m, tyx, j);
      let mut x = v.unit;
      if pt != 0 {
        let vd = part_node(m, p, tyx, j);
        let h = cat_src(&mut v, p, hint, vd.s, vd.e);
        x = fresh_of(&mut v, c, m, p, pt, h);
      }
      vec_push(&mut xs, x);
      j = j + 1;
    }
    let r = mk_enum(&mut v, tyx, tag, xs);
    vec_free(xs);
    return r;
  }
  if k == TY_VEC {
    let el = fresh_lifted(&mut v, c, m, p, inner_t(m, tyx), hint);
    let l = fresh_len(&mut v, hint);
    return mk(&mut v, VV_VEC, inner_t(m, tyx), l, el, 0, 0);
  }
  if k == TY_BOX {
    if v.box_depth >= BOX_DEPTH {
      return mk(&mut v, VV_BOXO, inner_t(m, tyx), 0, 0, 0, 0);
    }
    v.box_depth = v.box_depth + 1;
    let inner = fresh_of(&mut v, c, m, p, inner_t(m, tyx), hint);
    if v.box_depth > 0 {
      v.box_depth = v.box_depth - 1;
    }
    return mk(&mut v, VV_BOXK, 0, inner, 0, 0, 0);
  }
  return fresh_obj(&mut v, m, tyx, hint, false);
}

/// Fresh contents for a vector of `tyx`: every term of an element becomes
/// an unconstrained array indexed by position.
fn fresh_lifted(v: &mut Vr, c: &Checker, m: &Mono, p: &Parser, tyx: u64, hint: u64) -> u64 {
  let t0 = fresh_of(&mut v, c, m, p, tyx, hint);
  let tmpl = opaque_boxes(&mut v, c, m, p, t0, tyx);
  let mut ts = vec_new[u64]();
  let mut sorts = vec_new[u64]();
  leaves_of(v, m, tmpl, &mut ts, &mut sorts);
  let mut arrs = vec_new[u64]();
  let mut j = 0;
  while j < vec_len(sorts) {
    let h = cat_str(&mut v, hint, "_elems");
    let a = fresh_array(&mut v, h, u_at(sorts, j));
    vec_push(&mut arrs, a);
    j = j + 1;
  }
  v.cur = 0;
  let r = rebuild(&mut v, tmpl, arrs);
  vec_free(ts);
  vec_free(sorts);
  vec_free(arrs);
  return r;
}

/// Makes every box in `x` (of type `tyx`) opaque: a lifted template must
/// not claim the same box contents for every index.
fn opaque_boxes(v: &mut Vr, c: &Checker, m: &Mono, p: &Parser, x: u64, tyx: u64) -> u64 {
  let xv = vl_at(v, x);
  if xv.kind == VV_STRUCT || xv.kind == VV_ENUM {
    let mut xs = vec_new[u64]();
    let mut j = 0;
    while j < xv.n {
      let pt = part_ty(c, m, xv.ty, j);
      let mut y = v.unit;
      if xv.kind == VV_STRUCT || pt != 0 {
        y = opaque_boxes(&mut v, c, m, p, kid(v, x, j), pt);
      }
      vec_push(&mut xs, y);
      j = j + 1;
    }
    let mut r = 0;
    if xv.kind == VV_ENUM {
      r = mk_enum(&mut v, xv.ty, xv.a, xs);
    } else {
      r = mk_struct(&mut v, xv.ty, xs);
    }
    vec_free(xs);
    return r;
  }
  if (xv.kind == VV_BOXK || xv.kind == VV_BOXO) && kind_t(m, tyx) == TY_BOX {
    return mk(&mut v, VV_BOXO, inner_t(m, tyx), 0, 0, 0, 0);
  }
  return x;
}

/// The element at index `i`: a fresh value (with every fact a value of its
/// type satisfies) equal, term by term, to what the vector stores.
fn vec_read(v: &mut Vr, c: &Checker, m: &Mono, p: &Parser, elem: u64, elems: u64, i: u64, st: &mut VState) -> u64 {
  let h = atom_str(&mut v, "elem");
  let x = fresh_of(&mut v, c, m, p, elem, h);
  let mut a = vec_new[u64]();
  let mut aso = vec_new[u64]();
  leaves_of(v, m, x, &mut a, &mut aso);
  let mut b = vec_new[u64]();
  let mut bso = vec_new[u64]();
  leaves_of(v, m, elems, &mut b, &mut bso);
  let mut j = 0;
  while j < vec_len(a) && j < vec_len(b) {
    let sel = app2(&mut v, OP_SELECT, u_at(b, j), i);
    let eq = app2(&mut v, OP_EQ, u_at(a, j), sel);
    vec_push(&mut st.pc, eq);
    j = j + 1;
  }
  vec_free(a);
  vec_free(aso);
  vec_free(b);
  vec_free(bso);
  return x;
}

/// Gives every opaque box on `path` (before its last part) fresh contents,
/// so the path can be read and written.
fn open_path(v: &mut Vr, c: &Checker, m: &Mono, p: &Parser, env: &mut Vec[Bind], path: u64) {
  let pt = tm_at(v, path);
  let mut i = seg_end(v, path, 0);
  while i < pt.b {
    let pre = prefix(&mut v, path, i);
    let x = get_path(v, m, p, env, pre);
    let o = open_val(&mut v, c, m, p, x, pre);
    if o != x {
      set_path(&mut v, m, p, &mut env, pre, o);
    }
    i = seg_end(v, path, i + 1);
  }
}

fn open_val(v: &mut Vr, c: &Checker, m: &Mono, p: &Parser, x: u64, hint: u64) -> u64 {
  let xv = vl_at(v, x);
  if xv.kind == VV_BOXO {
    let inner = fresh_of(&mut v, c, m, p, xv.ty, hint);
    let o = open_val(&mut v, c, m, p, inner, hint);
    return mk(&mut v, VV_BOXK, 0, o, 0, 0, 0);
  }
  if xv.kind == VV_BOXK {
    let o = open_val(&mut v, c, m, p, xv.a, hint);
    if o == xv.a {
      return x;
    }
    return mk(&mut v, VV_BOXK, 0, o, 0, 0, 0);
  }
  return x;
}

/// What a specification sees inside a box. An opaque box reads as fresh
/// values each time: only incomplete, never unsound.
fn look_inside(v: &mut Vr, c: &Checker, m: &Mono, p: &Parser, x: u64) -> u64 {
  let xv = vl_at(v, x);
  if xv.kind == VV_BOXK {
    return look_inside(&mut v, c, m, p, xv.a);
  }
  if xv.kind == VV_BOXO {
    let h = atom_str(&mut v, "opaque");
    let inner = fresh_of(&mut v, c, m, p, xv.ty, h);
    return look_inside(&mut v, c, m, p, inner);
  }
  return x;
}

/// A fresh value of the same type as `old`. With `keep` (the value was
/// changed only in shape-keeping ways, see `changed_vars`), a Buf or a Vec
/// keeps its length, an object the ghost fields builtins never change, and
/// scalars, enum tags and the fields of structs stay as they were: no
/// shape-keeping builtin changes them, and any other change to a place
/// inside is havocked separately, after this.
fn havoc(v: &mut Vr, c: &Checker, m: &Mono, p: &Parser, oenv: u64, keep: bool, name: u64) -> u64 {
  let xv = vl_at(v, oenv);
  let k = xv.kind;
  if keep && (k == VV_U || k == VV_B || k == VV_STR) {
    return oenv;
  }
  if k == VV_BUF {
    let mut l = xv.a;
    if !keep {
      l = fresh_len(&mut v, name);
    }
    let d = fresh_array(&mut v, name, SO_INT);
    return mk(&mut v, VV_BUF, 0, l, d, 0, 0);
  }
  if k == VV_STR {
    let l = fresh_len(&mut v, name);
    let d = fresh_array(&mut v, name, SO_INT);
    return mk(&mut v, VV_STR, 0, l, d, 0, 0);
  }
  if k == VV_U {
    return fresh_u64(&mut v, name);
  }
  if k == VV_B {
    return fresh_bool(&mut v, name);
  }
  if k == VV_OBJ {
    let tk = kind_t(m, xv.ty);
    let mut f0 = xv.a;
    let mut f1 = xv.b;
    let mut f2 = xv.c;
    if xv.n > 0 && !(keep && kept_by_builtins(tk, 0)) { f0 = fresh_field(&mut v, tk, 0, name); }
    if xv.n > 1 && !(keep && kept_by_builtins(tk, 1)) { f1 = fresh_field(&mut v, tk, 1, name); }
    if xv.n > 2 && !(keep && kept_by_builtins(tk, 2)) { f2 = fresh_field(&mut v, tk, 2, name); }
    let mut f3 = xv.d;
    if xv.n > 3 && !(keep && kept_by_builtins(tk, 3)) { f3 = fresh_field(&mut v, tk, 3, name); }
    return mk_o(&mut v, xv.ty, f0, f1, f2, f3, xv.n);
  }
  if k == VV_STRUCT || k == VV_ENUM {
    let mut tag = xv.a;
    if k == VV_ENUM && !keep {
      let ht = cat_str(&mut v, name, "_tag");
      let mut hi = 0;
      if xv.n > 0 {
        hi = xv.n - 1;
      }
      let top = num(&mut v, hi);
      tag = fresh_int(&mut v, ht, v.t_zero, top);
    }
    let mut xs = vec_new[u64]();
    let mut j = 0;
    while j < xv.n {
      let fd = part_node(m, p, xv.ty, j);
      let h = cat_src(&mut v, p, name, fd.s, fd.e);
      let y = havoc(&mut v, c, m, p, kid(v, oenv, j), keep, h);
      vec_push(&mut xs, y);
      j = j + 1;
    }
    let mut r = 0;
    if k == VV_ENUM {
      r = mk_enum(&mut v, xv.ty, tag, xs);
    } else {
      r = mk_struct(&mut v, xv.ty, xs);
    }
    vec_free(xs);
    return r;
  }
  if k == VV_VEC {
    let mut l = xv.a;
    if !keep {
      l = fresh_len(&mut v, name);
    }
    let el = fresh_lifted(&mut v, c, m, p, xv.ty, name);
    return mk(&mut v, VV_VEC, xv.ty, l, el, 0, 0);
  }
  if k == VV_BOXK {
    let inner = havoc(&mut v, c, m, p, xv.a, keep, name);
    return mk(&mut v, VV_BOXK, 0, inner, 0, 0, 0);
  }
  return oenv;             // opaque boxes and unit
}

/// Proves `goal` under the path condition. The query is only recorded
/// here, with what an error would report (the node `loc`, error code `code`
/// and the variables in scope); `solve` asks the solver afterwards. Nothing
/// the verifier does depends on the answers, so the solver sees exactly the
/// commands stage0 sends it, up to the first failed proof.
fn prove(v: &mut Vr, st: &VState, goal: u64, loc: u64, code: u64) {
  if v.obligations < U64_MAX {
    v.obligations = v.obligations + 1;
  }
  let start = vec_len(v.snaps);
  let mut k = 0;
  while k < vec_len(st.env) {
    vec_push(&mut v.snaps, bind_at(st.env, k));
    k = k + 1;
  }
  vec_push(&mut v.obls, Obl { at: loc, code: code, x: v.env, env: start, n: vec_len(st.env) });
  send(&mut v, CMD_PUSH, 0, 0);
  k = 0;
  while k < vec_len(st.pc) {
    assert_tm(&mut v, u_at(st.pc, k));
    k = k + 1;
  }
  let ng = t_not(&mut v, goal);
  assert_tm(&mut v, ng);
  send(&mut v, CMD_CHECK, 0, 0);
  send(&mut v, CMD_POP, 0, 0);
}

/// The value of a string literal (token text s..e): exact length and bytes.
fn str_val(v: &mut Vr, p: &Parser, s: u64, e: u64) -> u64 {
  if !(s <= e && e <= blen(p.src)) {
    return mk(&mut v, VV_STR, 0, v.t_zero, v.t_zarr, 0, 0);
  }
  let bytes = decode(p.src, s, e);
  let mut d = v.t_zarr;
  let mut k = 0;
  while k < blen(bytes)
    invariant k <= blen(bytes)
  {
    let ik = num(&mut v, k);
    let bk = num(&mut v, cast[u64](bget(bytes, k)));
    d = app3(&mut v, OP_STORE, d, ik, bk);
    k = k + 1;
  }
  let l = num(&mut v, blen(bytes));
  bfree(bytes);
  return mk(&mut v, VV_STR, 0, l, d, 0, 0);
}

// ---- Specifications ----

/// The spec fn named `s..e`, or 0.
fn vspec_def(p: &Parser, s: u64, e: u64) -> u64 {
  let mut k = p.specs.head;
  while k != 0 {
    let n = node_at(p.nodes, k);
    if same(p.src, n.s, n.e, s, e) {
      return k;
    }
    k = n.next;
  }
  return 0;
}

/// Argument `j` of a call node.
fn arg_node(p: &Parser, call: u64, j: u64) -> u64 {
  let n = node_at(p.nodes, call);
  let mut k = n.a;
  let mut q = 0;
  while k != 0 && q < j {
    k = next_of(p, k);
    q = q + 1;
  }
  return k;
}

/// The value a specification names: a variable, `result`, `old(x)`, a
/// string literal, `vget(..)` or a field of one of these. `env` is what
/// variables mean, `old` what `old(..)` reads (when `has_old`), `res` the
/// value `result` names.
fn spec_val(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, env: &Vec[Bind], oenv: &Vec[Bind], has_old: bool, res: u64, bound: &mut Vec[Bnd]) -> u64 {
  let n = node_at(p.nodes, i);
  if n.kind == E_VAR {
    if span_is(p, n.s, n.e, "result") {
      return res;
    }
    let mut k = vec_len(bound);
    while k > 0 {
      k = k - 1;
      let b = bnd_at(bound, k);
      if same(p.src, b.s, b.e, n.s, n.e) {
        return mk_u(&mut v, b.q);
      }
    }
    return env_find(env, p, n.s, n.e);
  }
  if n.kind == E_CALL && span_is(p, n.s, n.e, "old") {
    return spec_val(&mut v, c, &mut m, p, n.a, oenv, oenv, false, 0, &mut bound);
  }
  if n.kind == E_STR {
    return str_val(&mut v, p, n.s, n.e);
  }
  if n.kind == E_CALL && span_is(p, n.s, n.e, "vget") {
    let vx = spec_val(&mut v, c, &mut m, p, n.a, env, oenv, has_old, res, &mut bound);
    let ix = spec_tm(&mut v, c, &mut m, p, arg_node(p, i, 1), env, oenv, has_old, res, &mut bound);
    let xv = vl_at(v, vx);
    return select_all(&mut v, m, xv.b, ix);
  }
  if n.kind == E_FIELD {
    let b0 = spec_val(&mut v, c, &mut m, p, n.a, env, oenv, has_old, res, &mut bound);
    let b = look_inside(&mut v, c, m, p, b0);
    let bv = vl_at(v, b);
    if bv.kind == VV_STRUCT {
      let dn = def_node(m, p, inner_t(m, bv.ty));
      let j = index_in(p, dn.a, n.s, n.e);
      if j > 0 {
        return kid(v, b, j - 1);
      }
    } else if bv.kind == VV_ENUM {
      // `o.V`: the payload slot of variant V.
      let j = variant_index(m, p, bv.ty, n.s, n.e);
      if j > 0 {
        return kid(v, b, j - 1);
      }
    }
  }
  return v.unit;
}

fn bnd_at(b: &Vec[Bnd], k: u64) -> Bnd {
  if k < vec_len(b) {
    return vec_get(b, k);
  }
  return Bnd { s: 0, e: 0, q: 0 };
}

/// Translates a specification expression into a term. No obligations.
fn spec_tm(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, env: &Vec[Bind], oenv: &Vec[Bind], has_old: bool, res: u64, bound: &mut Vec[Bnd]) -> u64 {
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_INT {
    return num(&mut v, n.v);
  }
  if k == E_BOOL {
    if n.v != 0 {
      return v.t_true;
    }
    return v.t_false;
  }
  if k == E_IS {
    let x = spec_val(&mut v, c, &mut m, p, n.a, env, oenv, has_old, res, &mut bound);
    let xv = vl_at(v, x);
    let j = variant_index(m, p, xv.ty, n.s2, n.e2);
    let mut idx = 0;
    if j > 0 {
      idx = j - 1;
    }
    let tj = num(&mut v, idx);
    return app2(&mut v, OP_EQ, xv.a, tj);
  }
  if k == E_VAR || k == E_FIELD {
    let x = spec_val(&mut v, c, &mut m, p, i, env, oenv, has_old, res, &mut bound);
    return term(v, x);
  }
  if k == E_NOT {
    let x = spec_tm(&mut v, c, &mut m, p, n.a, env, oenv, has_old, res, &mut bound);
    return t_not(&mut v, x);
  }
  if k == E_NEG {
    let x = spec_tm(&mut v, c, &mut m, p, n.a, env, oenv, has_old, res, &mut bound);
    return app1(&mut v, OP_SUB, x);
  }
  if k == E_BIN {
    // `==` on a value that names a struct or enum compares it part by part
    // (the checker allows it only between such values); on a number it is
    // the same `(= a b)` as below.
    if (n.v == P_EQEQ || n.v == P_NE) && spec_place(p, n.a) {
      let x = spec_val(&mut v, c, &mut m, p, n.a, env, oenv, has_old, res, &mut bound);
      let xl = vl_at(v, x);
      let xk = xl.kind;
      let mut eq = 0;
      if xk == VV_U || xk == VV_B {
        let tb = spec_tm(&mut v, c, &mut m, p, n.b, env, oenv, has_old, res, &mut bound);
        eq = app2(&mut v, OP_EQ, term(v, x), tb);
      } else {
        let y = spec_val(&mut v, c, &mut m, p, n.b, env, oenv, has_old, res, &mut bound);
        eq = eq_term(&mut v, x, y);
      }
      if n.v == P_NE {
        return t_not(&mut v, eq);
      }
      return eq;
    }
    let ta = spec_tm(&mut v, c, &mut m, p, n.a, env, oenv, has_old, res, &mut bound);
    let tb = spec_tm(&mut v, c, &mut m, p, n.b, env, oenv, has_old, res, &mut bound);
    let op = n.v;
    if op == P_NE {
      let eq = app2(&mut v, OP_EQ, ta, tb);
      return t_not(&mut v, eq);
    }
    return app2(&mut v, bin_op(op), ta, tb);
  }
  if k == E_FORALL {
    // A fresh SMT name per quantifier, so expanding a spec fn can never capture.
    let qv = atom_src(&mut v, p, n.s, n.e);
    let h = pre_str(&mut v, "q_", qv);
    let q = fresh_name(&mut v, h);
    vec_push(&mut bound, Bnd { s: n.s, e: n.e, q: q });
    let tb = spec_tm(&mut v, c, &mut m, p, n.a, env, oenv, has_old, res, &mut bound);
    if vec_len(bound) > 0 {
      vec_pop(&mut bound);
    }
    let r = in_range(&mut v, v.t_zero, q, v.t_u64max);
    let imp = app2(&mut v, OP_IMP, r, tb);
    return forall_tm(&mut v, q, imp);
  }
  if k == E_CALL {
    return vspec_call(&mut v, c, &mut m, p, i, env, oenv, has_old, res, &mut bound);
  }
  if k == E_TAPP {
    // An instance of a generic spec fn: the only type application a checked
    // specification has.
    let x = tapp_inst(&mut m, p, i, v.env);
    let xi = inst_at(m, x);
    return vspec_expand(&mut v, c, &mut m, p, n.b, xi.def, x, env, oenv, has_old, res, &mut bound);
  }
  return v.t_false;
}

/// Two values of one struct or enum type (made of numbers) are equal: every
/// field is, and for an enum the tags are and so is the payload the tag
/// names. As stage0's `eq_term`.
fn eq_term(v: &mut Vr, a: u64, b: u64) -> u64 {
  let x = unbox_known(v, a);
  let y = unbox_known(v, b);
  let xv = vl_at(v, x);
  let yv = vl_at(v, y);
  if (xv.kind == VV_U && yv.kind == VV_U) || (xv.kind == VV_B && yv.kind == VV_B) {
    return app2(&mut v, OP_EQ, xv.a, yv.a);
  }
  let st = xv.kind == VV_STRUCT && yv.kind == VV_STRUCT;
  let en = xv.kind == VV_ENUM && yv.kind == VV_ENUM;
  if !st && !en {
    return v.t_true;
  }
  let mut ts = vec_new[u64]();
  if en {
    vec_push(&mut ts, app2(&mut v, OP_EQ, xv.a, yv.a));
  }
  let mut j = 0;
  while j < xv.n && j < yv.n && j < SRC_MAX {
    let t = eq_term(&mut v, kid(v, x, j), kid(v, y, j));
    if t != v.t_true {
      if en {
        let g = app2(&mut v, OP_EQ, xv.a, num(&mut v, j));
        vec_push(&mut ts, app2(&mut v, OP_IMP, g, t));
      } else {
        vec_push(&mut ts, t);
      }
    }
    j = j + 1;
  }
  let r = and_all(&mut v, ts);
  vec_free(ts);
  return r;
}

/// The SMT operator of a binary operator token.
fn bin_op(op: u64) -> u64 {
  if op == P_PLUS { return OP_ADD; }
  if op == P_MINUS { return OP_SUB; }
  if op == P_STAR { return OP_MUL; }
  if op == P_SLASH { return OP_DIV; }
  if op == P_PERCENT { return OP_MOD; }
  if op == P_EQEQ { return OP_EQ; }
  if op == P_LT { return OP_LT; }
  if op == P_LE { return OP_LE; }
  if op == P_GT { return OP_GT; }
  if op == P_GE { return OP_GE; }
  if op == P_ANDAND { return OP_AND; }
  if op == P_OROR { return OP_OR; }
  return OP_IMP;
}

fn vspec_call(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, env: &Vec[Bind], oenv: &Vec[Bind], has_old: bool, res: u64, bound: &mut Vec[Bnd]) -> u64 {
  let n = node_at(p.nodes, i);
  if span_is(p, n.s, n.e, "old") {
    return spec_tm(&mut v, c, &mut m, p, n.a, oenv, oenv, false, 0, &mut bound);
  }
  let sf = vspec_def(p, n.s, n.e);
  if sf != 0 {
    return vspec_expand(&mut v, c, &mut m, p, i, sf, 0, env, oenv, has_old, res, &mut bound);
  }
  return vspec_builtin(&mut v, c, &mut m, p, i, env, oenv, has_old, res, &mut bound);
}

/// Call `i` of spec fn `sf` (instance `x` of it, or 0 for a plain one),
/// expanded in place.
fn vspec_expand(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, sf: u64, x: u64, env: &Vec[Bind], oenv: &Vec[Bind], has_old: bool, res: u64, bound: &mut Vec[Bnd]) -> u64 {
  let n = node_at(p.nodes, i);
  let sd = node_at(p.nodes, sf);
  let mut senv = vec_new[Bind]();
  let mut q = sd.a;
  let mut a = n.a;
  while q != 0 && a != 0 {
    let qn = node_at(p.nodes, q);
    let pt = base_t(m, conv(&mut m, p, qn.a, x, q));
    let mut y = 0;
    if is_int(m, pt) {
      let t = spec_tm(&mut v, c, &mut m, p, a, env, oenv, has_old, res, &mut bound);
      y = mk_u(&mut v, t);
    } else if kind_t(m, pt) == TY_BOOL {
      let t = spec_tm(&mut v, c, &mut m, p, a, env, oenv, has_old, res, &mut bound);
      y = mk_b(&mut v, t);
    } else {
      y = spec_val(&mut v, c, &mut m, p, a, env, oenv, has_old, res, &mut bound);
    }
    env_put(&mut senv, p, qn.s, qn.e, y);
    q = qn.next;
    a = next_of(p, a);
  }
  // Type applications in an instance's body are read in that instance.
  let outer = v.env;
  if x != 0 {
    v.env = x;
  }
  let mut sb = vec_new[Bnd]();
  let r = spec_tm(&mut v, c, &mut m, p, sd.c, senv, senv, false, 0, &mut sb);
  v.env = outer;
  vec_free(sb);
  vec_free(senv);
  return r;
}

/// A call `i` of a ghost builtin in a specification.
fn vspec_builtin(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, env: &Vec[Bind], oenv: &Vec[Bind], has_old: bool, res: u64, bound: &mut Vec[Bnd]) -> u64 {
  let n = node_at(p.nodes, i);
  if span_is(p, n.s, n.e, "vcount") {
    let vx = spec_val(&mut v, c, &mut m, p, n.a, env, oenv, has_old, res, &mut bound);
    let xv = vl_at(v, vx);
    let el = vl_at(v, xv.b);
    let t = spec_tm(&mut v, c, &mut m, p, arg_node(p, i, 1), env, oenv, has_old, res, &mut bound);
    return app3(&mut v, OP_CNT, el.a, xv.a, t);
  }
  if span_is(p, n.s, n.e, "vget") {
    let x = spec_val(&mut v, c, &mut m, p, i, env, oenv, has_old, res, &mut bound);
    return term(v, x);
  }
  let x = spec_val(&mut v, c, &mut m, p, n.a, env, oenv, has_old, res, &mut bound);
  let xv = vl_at(v, x);
  if span_is(p, n.s, n.e, "vlen") || span_is(p, n.s, n.e, "len") || span_is(p, n.s, n.e, "slen") || span_is(p, n.s, n.e, "blen") {
    return xv.a;
  }
  if span_is(p, n.s, n.e, "get") || span_is(p, n.s, n.e, "sget") || span_is(p, n.s, n.e, "bget") {
    let ix = spec_tm(&mut v, c, &mut m, p, arg_node(p, i, 1), env, oenv, has_old, res, &mut bound);
    return app2(&mut v, OP_SELECT, xv.b, ix);
  }
  if span_is(p, n.s, n.e, "frame_id") || span_is(p, n.s, n.e, "pt_id") || span_is(p, n.s, n.e, "dma_id") {
    return g_id(v, x);
  }
  if span_is(p, n.s, n.e, "pt_level") {
    return g_level(v, x);
  }
  if span_is(p, n.s, n.e, "pt_leases") {
    return g_leases(v, x);
  }
  if span_is(p, n.s, n.e, "pool_size") {
    return g_size(v, x);
  }
  if span_is(p, n.s, n.e, "mmu_root") {
    return g_root(v, x);
  }
  if span_is(p, n.s, n.e, "port_base") {
    return g_base(v, x);
  }
  if span_is(p, n.s, n.e, "port_count") {
    return g_count(v, x);
  }
  if span_is(p, n.s, n.e, "mmio_base") {
    return g_base(v, x);
  }
  if span_is(p, n.s, n.e, "mmio_len") {
    return g_len(v, x);
  }
  if span_is(p, n.s, n.e, "pt_used") || span_is(p, n.s, n.e, "pool_has") || span_is(p, n.s, n.e, "port_free") || span_is(p, n.s, n.e, "mmio_free") {
    let mut arr = g_used(v, x);
    if !span_is(p, n.s, n.e, "pt_used") {
      arr = g_has(v, x);
    }
    let ix = spec_tm(&mut v, c, &mut m, p, arg_node(p, i, 1), env, oenv, has_old, res, &mut bound);
    return app2(&mut v, OP_SELECT, arr, ix);
  }
  return v.t_false;
}

/// A specification read in the state `st`.
fn here(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: &VState) -> u64 {
  let mut b = vec_new[Bnd]();
  let t = spec_tm(&mut v, c, &mut m, p, i, st.env, st.env, false, 0, &mut b);
  vec_free(b);
  return t;
}

/// A loop invariant read in the state `st`; `old(..)` reads the function's
/// entry values.
fn here_inv(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: &VState, entry: &Vec[Bind]) -> u64 {
  let mut b = vec_new[Bnd]();
  let t = spec_tm(&mut v, c, &mut m, p, i, st.env, entry, true, 0, &mut b);
  vec_free(b);
  return t;
}

// ---- Expressions ----

/// Evaluates a code expression, proving its safety obligations on the
/// way. A call, struct literal or variant names instance `inst` instead of
/// what is written when `inst` is not 0.
fn eval(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: &mut VState, inst: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_TAPP {
    if is_typed_builtin(p, n.b) && !name_is(p, n.b, "vec_new") {
      // `cast[T](x)` keeps the value and proves it fits; `wrap[T](x)`
      // reduces it modulo 2^width.
      let t = conv(&mut m, p, n.a, v.env, i);
      let inner = node_at(p.nodes, n.b);
      let xv = eval(&mut v, c, &mut m, p, inner.a, &mut st, 0);
      let x = term(v, xv);
      if name_is(p, n.b, "wrap") {
        let r = wrap_term(&mut v, m, t, x);
        return mk_u(&mut v, r);
      }
      // Whether the source can be negative decides the bounds proved.
      let from = int_op_ty(c, m, v.env, i);
      let max = int_max(&mut v, m, t);
      let mut g = 0;
      if !is_signed(m, from) && !is_signed(m, t) {
        g = app2(&mut v, OP_LE, x, max);
      } else {
        let min = int_min(&mut v, m, t);
        g = in_range(&mut v, min, x, max);
      }
      prove(&mut v, st, g, i, VC_CAST);
      return mk_u(&mut v, x);
    }
    if is_typed_builtin(p, n.b) {
      let t = conv(&mut m, p, n.a, v.env, i);
      let h = atom_str(&mut v, "vec");
      let el = fresh_lifted(&mut v, c, m, p, t, h);
      return mk(&mut v, VV_VEC, t, v.t_zero, el, 0, 0);
    }
    let x = tapp_inst(&mut m, p, i, v.env);
    return eval(&mut v, c, &mut m, p, n.b, &mut st, x);
  }
  if k == E_INT {
    let t = num(&mut v, n.v);
    return mk_u(&mut v, t);
  }
  if k == E_BOOL {
    if n.v != 0 {
      return mk_b(&mut v, v.t_true);
    }
    return mk_b(&mut v, v.t_false);
  }
  if k == E_STR {
    return str_val(&mut v, p, n.s, n.e);
  }
  if k == E_BLOB {
    let h = atom_str(&mut v, "blob");
    let d = fresh_array(&mut v, h, SO_INT);
    let l = num(&mut v, n.v);
    return mk(&mut v, VV_STR, 0, l, d, 0, 0);
  }
  if k == E_VAR {
    return env_find(st.env, p, n.s, n.e);
  }
  if k == E_FIELD {
    let path = place_text(&mut v, p, i);
    open_path(&mut v, c, m, p, &mut st.env, path);
    return get_path(v, m, p, st.env, path);
  }
  if k == E_SLIT {
    return eval_slit(&mut v, c, &mut m, p, i, &mut st, inst);
  }
  if k == E_VARIANT {
    return eval_variant(&mut v, c, &mut m, p, i, &mut st, inst);
  }
  if k == E_IS {
    let x = eval(&mut v, c, &mut m, p, n.a, &mut st, 0);
    let xv = vl_at(v, x);
    let j = variant_index(m, p, xv.ty, n.s2, n.e2);
    let mut idx = 0;
    if j > 0 {
      idx = j - 1;
    }
    let tj = num(&mut v, idx);
    let eq = app2(&mut v, OP_EQ, xv.a, tj);
    return mk_b(&mut v, eq);
  }
  if k == E_NOT {
    let x = eval(&mut v, c, &mut m, p, n.a, &mut st, 0);
    // Bitwise not on an unsigned integer: max - x.
    if has_int_op(c, v.env, i) {
      let max = int_max(&mut v, m, int_op_ty(c, m, v.env, i));
      let t = app2(&mut v, OP_SUB, max, term(v, x));
      return mk_u(&mut v, t);
    }
    let t = t_not(&mut v, term(v, x));
    return mk_b(&mut v, t);
  }
  if k == E_NEG {
    let a = node_at(p.nodes, n.a);
    if a.kind == E_INT {
      let t = neg_num(&mut v, a.v);
      return mk_u(&mut v, t);
    }
    let x = eval(&mut v, c, &mut m, p, n.a, &mut st, 0);
    let tx = term(v, x);
    let min = int_min(&mut v, m, int_op_ty(c, m, v.env, i));
    let eq = app2(&mut v, OP_EQ, tx, min);
    let g = t_not(&mut v, eq);
    prove(&mut v, st, g, i, VC_OVERFLOW);
    let t = app1(&mut v, OP_SUB, tx);
    return mk_u(&mut v, t);
  }
  if k == E_BIN {
    return eval_bin(&mut v, c, &mut m, p, i, &mut st);
  }
  if k == E_CALL {
    return vcall(&mut v, c, &mut m, p, i, &mut st, inst);
  }
  return v.unit;
}

fn eval_slit(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: &mut VState, inst: u64) -> u64 {
  let mut x = inst;
  if x == 0 {
    x = plain_inst(&mut m, find_in(p, p.structs.head, i));
  }
  let tyx = intern(&mut m, p, TY_STRUCT, x);
  // The fields in the order written, then in the order declared.
  let n = node_at(p.nodes, i);
  let mut inits = vec_new[u64]();
  let mut got = vec_new[u64]();
  let mut f = n.a;
  while f != 0 {
    let fi = node_at(p.nodes, f);
    let y = eval(&mut v, c, &mut m, p, fi.a, &mut st, 0);
    vec_push(&mut inits, f);
    vec_push(&mut got, y);
    f = fi.next;
  }
  let mut xs = vec_new[u64]();
  let dn = def_node(m, p, x);
  let mut d = dn.a;
  while d != 0 {
    let fd = node_at(p.nodes, d);
    let mut y = 0;
    let mut j = 0;
    while j < vec_len(inits) {
      let fi = node_at(p.nodes, u_at(inits, j));
      if same(p.src, fi.s, fi.e, fd.s, fd.e) {
        y = u_at(got, j);
      }
      j = j + 1;
    }
    vec_push(&mut xs, y);
    d = fd.next;
  }
  let r = mk_struct(&mut v, tyx, xs);
  vec_free(inits);
  vec_free(got);
  vec_free(xs);
  return r;
}

fn eval_variant(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: &mut VState, inst: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let mut x = inst;
  if x == 0 {
    x = plain_inst(&mut m, find_in(p, p.enums.head, i));
  }
  let tyx = intern(&mut m, p, TY_ENUM, x);
  let dn = def_node(m, p, x);
  let kk = index_in(p, dn.a, n.s2, n.e2);
  let mut k = 0;
  if kk > 0 {
    k = kk - 1;
  }
  let nm = inst_name(&mut v, m, p, x);
  let mut xs = vec_new[u64]();
  let mut d = dn.a;
  let mut j = 0;
  while d != 0 && j < SRC_MAX {
    let vd = node_at(p.nodes, d);
    let pt = fld_ty(c, x, j);
    let mut y = v.unit;
    if pt != 0 && n.a != 0 && j == k {
      y = eval(&mut v, c, &mut m, p, n.a, &mut st, 0);
    } else if pt != 0 {
      let h = cat_src(&mut v, p, nm, vd.s, vd.e);
      y = fresh_of(&mut v, c, m, p, pt, h);
    }
    vec_push(&mut xs, y);
    d = vd.next;
    j = j + 1;
  }
  let tag = num(&mut v, k);
  let r = mk_enum(&mut v, tyx, tag, xs);
  vec_free(xs);
  return r;
}

fn eval_bin(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: &mut VState) -> u64 {
  let n = node_at(p.nodes, i);
  let op = n.v;
  let va = eval(&mut v, c, &mut m, p, n.a, &mut st, 0);
  let ta = term(v, va);
  // && and || short-circuit: the right side runs only when needed.
  if op == P_ANDAND || op == P_OROR {
    let mut guard = ta;
    if op == P_OROR {
      guard = t_not(&mut v, ta);
    }
    let mut sub = st_clone(st);
    vec_push(&mut sub.pc, guard);
    let vb = eval(&mut v, c, &mut m, p, n.b, &mut sub, 0);
    // Facts learned on the right side hold whenever it ran.
    let extra = tail(sub.pc, vadd(vec_len(st.pc), 1));
    if vec_len(extra) > 0 {
      let all = and_all(&mut v, extra);
      let imp = app2(&mut v, OP_IMP, guard, all);
      vec_push(&mut st.pc, imp);
    }
    vec_free(extra);
    // So do the new values of anything it lent as `&mut`.
    let mut k = 0;
    while k < vec_len(st.env) {
      let b = bind_at(st.env, k);
      let sb = bind_at(sub.env, k);
      if !val_eq(v, sb.val, b.val) {
        let mm = merge(&mut v, guard, sb.val, b.val);
        vec_set(&mut st.env, k, Bind { s: b.s, e: b.e, val: mm });
      }
      k = k + 1;
    }
    st_free(sub);
    let t = app2(&mut v, bin_op(op), ta, term(v, vb));
    return mk_b(&mut v, t);
  }
  let vb = eval(&mut v, c, &mut m, p, n.b, &mut st, 0);
  let tb = term(v, vb);
  let ity = int_op_ty(c, m, v.env, i);
  if is_signed(m, ity) && (op == P_PLUS || op == P_MINUS || op == P_STAR || op == P_SLASH || op == P_PERCENT) {
    return signed_arith(&mut v, m, op, ta, tb, ity, st, i);
  }
  if op == P_AMP || op == P_PIPE || op == P_CARET || op == P_SHL || op == P_SHR {
    return bitwise(&mut v, m, p, i, op, n.a, n.b, ta, tb, ity, &mut st);
  }
  if op == P_PLUS || op == P_STAR {
    let t = app2(&mut v, bin_op(op), ta, tb);
    let max = int_max(&mut v, m, int_op_ty(c, m, v.env, i));
    let g = app2(&mut v, OP_LE, t, max);
    prove(&mut v, st, g, i, VC_OVERFLOW);
    return mk_u(&mut v, t);
  }
  if op == P_MINUS {
    let g = app2(&mut v, OP_GE, ta, tb);
    prove(&mut v, st, g, i, VC_UNDERFLOW);
    let t = app2(&mut v, OP_SUB, ta, tb);
    return mk_u(&mut v, t);
  }
  if op == P_SLASH || op == P_PERCENT {
    let eq = app2(&mut v, OP_EQ, tb, v.t_zero);
    let g = t_not(&mut v, eq);
    prove(&mut v, st, g, i, VC_DIVZERO);
    let t = app2(&mut v, bin_op(op), ta, tb);
    return mk_u(&mut v, t);
  }
  if op == P_NE {
    let eq = app2(&mut v, OP_EQ, ta, tb);
    let t = t_not(&mut v, eq);
    return mk_b(&mut v, t);
  }
  let t = app2(&mut v, bin_op(op), ta, tb);
  return mk_b(&mut v, t);
}

/// Bitwise operators on an unsigned type, as stage0's `bitwise`: a low mask
/// is `mod`, a shift is a multiplication or division by a power of two, and
/// the rest is a fresh value with facts that always hold.
fn bitwise(v: &mut Vr, m: &Mono, p: &Parser, i: u64, op: u64, a: u64, b: u64, ta: u64, tb: u64, ity: u64, st: &mut VState) -> u64 {
  if op == P_SHL || op == P_SHR {
    let w = int_bits(m, ity);
    let tw = num(&mut v, w);
    let g = app2(&mut v, OP_LT, tb, tw);
    prove(&mut v, st, g, i, VC_SHIFT);
    let bn = node_at(p.nodes, b);
    let mut pw = 0;
    if bn.kind == E_INT {
      let mut kk = bn.v;
      if kk > 127 {
        kk = 127;
      }
      pw = pow2_num(&mut v, kk);
    } else {
      pw = pow2_ite(&mut v, tb, w);
    }
    if op == P_SHR {
      let t = app2(&mut v, OP_DIV, ta, pw);
      return mk_u(&mut v, t);
    }
    let t = app2(&mut v, OP_MUL, ta, pw);
    let max = int_max(&mut v, m, ity);
    let g2 = app2(&mut v, OP_LE, t, max);
    prove(&mut v, st, g2, i, VC_OVERFLOW);
    return mk_u(&mut v, t);
  }
  // `x & (2^k - 1)` keeps the low k bits.
  if op == P_AMP {
    let bn = node_at(p.nodes, b);
    let an = node_at(p.nodes, a);
    let mut other = ta;
    let mut k = 0;
    if bn.kind == E_INT {
      k = low_mask(bn.v);
    }
    if k == 0 && an.kind == E_INT {
      other = tb;
      k = low_mask(an.v);
    }
    if k > 0 {
      let pk = pow2_num(&mut v, k - 1);
      let t = app2(&mut v, OP_MOD, other, pk);
      return mk_u(&mut v, t);
    }
  }
  let h = atom_str(&mut v, "bits");
  let max = int_max(&mut v, m, ity);
  let r = fresh_int(&mut v, h, v.t_zero, max);
  let mut fact = 0;
  if op == P_AMP {
    let x = app2(&mut v, OP_LE, r, ta);
    let y = app2(&mut v, OP_LE, r, tb);
    fact = app2(&mut v, OP_AND, x, y);
  } else if op == P_PIPE {
    let x = app2(&mut v, OP_LE, ta, r);
    let y = app2(&mut v, OP_LE, tb, r);
    let sum = app2(&mut v, OP_ADD, ta, tb);
    let z = app2(&mut v, OP_LE, r, sum);
    fact = app3(&mut v, OP_AND, x, y, z);
  } else {
    let sum = app2(&mut v, OP_ADD, ta, tb);
    fact = app2(&mut v, OP_LE, r, sum);
  }
  vec_push(&mut st.pc, fact);
  return mk_u(&mut v, r);
}

/// Arithmetic on a signed type: the result must stay between the type's
/// minimum and maximum; `/` and `%` truncate toward zero, as in C, and
/// `MIN / -1` overflows.
fn signed_arith(v: &mut Vr, m: &Mono, op: u64, ta: u64, tb: u64, ity: u64, st: &VState, i: u64) -> u64 {
  let min = int_min(&mut v, m, ity);
  let max = int_max(&mut v, m, ity);
  if op == P_SLASH || op == P_PERCENT {
    let eq = app2(&mut v, OP_EQ, tb, v.t_zero);
    let g = t_not(&mut v, eq);
    prove(&mut v, st, g, i, VC_DIVZERO);
    let am = app2(&mut v, OP_EQ, ta, min);
    let m1 = neg_num(&mut v, 1);
    let bm = app2(&mut v, OP_EQ, tb, m1);
    let both = app2(&mut v, OP_AND, am, bm);
    let g2 = t_not(&mut v, both);
    prove(&mut v, st, g2, i, VC_OVERFLOW);
    let q = c_div(&mut v, ta, tb);
    if op == P_SLASH {
      return mk_u(&mut v, q);
    }
    let bq = app2(&mut v, OP_MUL, tb, q);
    let r = app2(&mut v, OP_SUB, ta, bq);
    return mk_u(&mut v, r);
  }
  let t = app2(&mut v, bin_op(op), ta, tb);
  let hi = app2(&mut v, OP_LE, t, max);
  prove(&mut v, st, hi, i, VC_OVERFLOW);
  let lo = app2(&mut v, OP_LE, min, t);
  prove(&mut v, st, lo, i, VC_UNDERFLOW);
  return mk_u(&mut v, t);
}

/// `xs[from ..]`.
fn tail(xs: &Vec[u64], from: u64) -> Vec[u64] {
  let mut out = vec_new[u64]();
  let mut k = from;
  while k < vec_len(xs) {
    vec_push(&mut out, u_at(xs, k));
    k = k + 1;
  }
  return out;
}

/// Is call argument `a` passed as a linear value (a `&mut` borrow, or a
/// place holding something other than a u64, bool or string)?
fn is_lin_arg(v: &mut Vr, m: &Mono, p: &Parser, a: u64, st: &VState) -> bool {
  let an = node_at(p.nodes, a);
  if an.kind == E_MUTBORROW {
    return true;
  }
  if an.kind == E_VAR || an.kind == E_FIELD {
    let path = place_text(&mut v, p, a);
    let x = get_path(v, m, p, st.env, path);
    let xv = vl_at(v, x);
    return xv.kind != VV_U && xv.kind != VV_B && xv.kind != VV_STR;
  }
  return false;
}

fn vcall(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: &mut VState, inst: u64) -> u64 {
  if inst == 0 && name_is(p, i, "locked") {
    return vlocked(&mut v, c, &mut m, p, i, &mut st);
  }
  if inst == 0 && name_is(p, i, "smp_run") {
    return vsmp_run(&mut v, c, &mut m, p, i, &mut st);
  }
  if inst == 0 && (name_is(p, i, "pt_borrow") || name_is(p, i, "pt_borrow_frame")) {
    return vpt_borrow(&mut v, c, &mut m, p, i, &mut st);
  }
  let n = node_at(p.nodes, i);
  let mut args = vec_new[u64]();
  let mut a = n.a;
  while a != 0 {
    vec_push(&mut args, a);
    a = next_of(p, a);
  }
  let r = vcall_args(&mut v, c, &mut m, p, i, args, 0, &mut st, inst);
  vec_free(args);
  return r;
}

/// The call node `i` with the argument nodes `args`, calling instance
/// `inst` (0: what `i` names). An argument node 0 stands for `&mut` of the
/// hidden variable named by atom `hid`.
fn vcall_args(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, args: &Vec[u64], hid: u64, st: &mut VState, inst: u64) -> u64 {
  let n = node_at(p.nodes, i);
  let mut j = 0;
  while j < vec_len(args) {
    let a = u_at(args, j);
    let an = node_at(p.nodes, a);
    let mut path = 0;
    if a == 0 {
      path = 0;             // the hidden variable: no boxes on its path
    } else if an.kind == E_MUTBORROW {
      path = list_text(&mut v, p, an.a);
    } else {
      path = place_text(&mut v, p, a);
    }
    if path != 0 {
      open_path(&mut v, c, m, p, &mut st.env, path);
    }
    j = j + 1;
  }
  // Argument order mirrors the checker: scalars first, then linear values.
  let mut vals = vec_new[u64]();
  let mut lin = vec_new[u64]();
  j = 0;
  while j < vec_len(args) {
    let aj = u_at(args, j);
    if aj == 0 || is_lin_arg(&mut v, m, p, aj, st) {
      vec_push(&mut lin, 1);
      vec_push(&mut vals, 0);
    } else {
      vec_push(&mut lin, 0);
      let x = eval(&mut v, c, &mut m, p, aj, &mut st, 0);
      vec_push(&mut vals, x);
    }
    j = j + 1;
  }
  j = 0;
  while j < vec_len(args) {
    if u_at(lin, j) == 1 {
      let aj = u_at(args, j);
      let an = node_at(p.nodes, aj);
      let mut x = 0;
      if aj == 0 {
        x = get_path(v, m, p, st.env, hid);
      } else if an.kind == E_MUTBORROW {
        let path = list_text(&mut v, p, an.a);
        x = get_path(v, m, p, st.env, path);
      } else {
        x = eval(&mut v, c, &mut m, p, aj, &mut st, 0);
      }
      if j < vec_len(vals) {
        vec_set(&mut vals, j, x);
      }
    }
    j = j + 1;
  }
  vec_free(lin);
  let mut r = 0;
  if inst == 0 && is_builtin_name(c, p, n.s, n.e) {
    r = vbuiltin(&mut v, c, &mut m, p, i, args, vals, &mut st);
  } else {
    let mut x = inst;
    if x == 0 {
      x = plain_inst(&mut m, plain_fn(p, n.s, n.e));
    }
    r = vuser_call(&mut v, c, &mut m, p, x, i, args, vals, hid, &mut st);
  }
  vec_free(vals);
  return r;
}

/// The facts the struct invariants of value `x` state, appended to `out`.
/// Structs held directly as fields count too; ones behind a box, in a
/// vector or in an enum payload do not (yet), as in stage0.
fn invariant_terms(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, x: u64, out: &mut Vec[u64]) {
  let xv = vl_at(v, x);
  if xv.kind != VV_STRUCT {
    return;
  }
  let dn = def_node(m, p, inner_t(m, xv.ty));
  let mut env = vec_new[Bind]();
  let mut f = dn.a;
  let mut j = 0;
  while f != 0 && j < xv.n {
    let fd = node_at(p.nodes, f);
    env_put(&mut env, p, fd.s, fd.e, kid(v, x, j));
    f = fd.next;
    j = j + 1;
  }
  let mut b = vec_new[Bnd]();
  let mut i = dn.b;
  while i != 0 {
    let t = spec_tm(&mut v, c, &mut m, p, i, env, env, false, 0, &mut b);
    vec_push(&mut out, t);
    i = next_of(p, i);
  }
  vec_free(b);
  vec_free(env);
  j = 0;
  while j < xv.n {
    invariant_terms(&mut v, c, &mut m, p, kid(v, x, j), &mut out);
    j = j + 1;
  }
}

/// The type of value `x`, for `lock_new`. A Bytes value reads as a Buf:
/// the lock then forgets that every byte is <= 255, which loses facts but
/// never assumes a false one.
fn val_type(v: &Vr, m: &mut Mono, p: &Parser, x: u64) -> u64 {
  let xv = vl_at(v, x);
  let k = xv.kind;
  if k == VV_U { return intern(&mut m, p, TY_U64, 0); }
  if k == VV_B { return intern(&mut m, p, TY_BOOL, 0); }
  if k == VV_BUF { return intern(&mut m, p, TY_BUF, 0); }
  if k == VV_STR { return intern(&mut m, p, TY_STR, 0); }
  if k == VV_OBJ || k == VV_STRUCT || k == VV_ENUM { return xv.ty; }
  if k == VV_BOXK {
    let t = val_type(v, &mut m, p, xv.a);
    return intern(&mut m, p, TY_BOX, t);
  }
  if k == VV_BOXO { return intern(&mut m, p, TY_BOX, xv.ty); }
  if k == VV_VEC { return intern(&mut m, p, TY_VEC, xv.ty); }
  return intern(&mut m, p, TY_UNIT, 0);
}

/// `locked(l, f, args..)`: the contents are a fresh value about which only
/// the invariants are known (another processor may have changed them since
/// this one last looked). `f` gets them as its `&mut` first argument and
/// must hand them back with the invariants holding again.
fn vlocked(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: &mut VState) -> u64 {
  let n = node_at(p.nodes, i);
  let a0 = n.a;
  let a1 = next_of(p, a0);
  let lp = place_text(&mut v, p, a0);
  open_path(&mut v, c, m, p, &mut st.env, lp);
  let lv = vl_at(v, get_path(v, m, p, st.env, lp));
  let h = cat_str(&mut v, lp, "_contents");
  let inner = fresh_of(&mut v, c, m, p, inner_t(m, lv.ty), h);
  let mut invs = vec_new[u64]();
  invariant_terms(&mut v, c, &mut m, p, inner, &mut invs);
  let mut k = 0;
  while k < vec_len(invs) {
    vec_push(&mut st.pc, u_at(invs, k));
    k = k + 1;
  }
  vec_free(invs);
  // The contents live in a variable no program can name, for the call.
  if v.counter < U64_MAX {
    v.counter = v.counter + 1;
  }
  let start = vec_len(v.pool);
  push_str(&mut v, "locked*");
  push_num(&mut v, v.counter);
  let key = seal(&mut v, start);
  let kt = tm_at(v, key);
  vec_push(&mut st.env, Bind { s: vadd(kt.a, kt.b), e: kt.a, val: inner });
  let mut args = vec_new[u64]();
  vec_push(&mut args, 0);
  let mut a = next_of(p, a1);
  while a != 0 {
    vec_push(&mut args, a);
    a = next_of(p, a);
  }
  let an = node_at(p.nodes, a1);
  let x = plain_inst(&mut m, plain_fn(p, an.s, an.e));
  let res = vcall_args(&mut v, c, &mut m, p, i, args, key, &mut st, x);
  vec_free(args);
  let after = get_path(v, m, p, st.env, key);
  let mut env = vec_new[Bind]();
  k = 0;
  while k < vec_len(st.env) {
    let b = bind_at(st.env, k);
    if !bind_named(v, p, b, kt.a, kt.b) {
      vec_push(&mut env, b);
    }
    k = k + 1;
  }
  let prev = st.env;
  st.env = env;
  vec_free(prev);
  let mut outs = vec_new[u64]();
  invariant_terms(&mut v, c, &mut m, p, after, &mut outs);
  k = 0;
  while k < vec_len(outs) {
    prove(&mut v, st, u_at(outs, k), i, VC_LOCKINV);
    k = k + 1;
  }
  vec_free(outs);
  return res;
}

/// `pt_borrow(&mut t, i, f, args..)`: `f` gets the table in slot `i` of `t`
/// (`pt_borrow_frame`: the page) as its `&mut` first argument, left in
/// place. Nothing is known about what is under it, except that it is as
/// live as `t`: it has `t`'s leases, so `f` cannot take anything out of it
/// while a processor may be running on the tree. `f` must hand back the
/// same table (id, level and leases unchanged) or page.
fn vpt_borrow(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: &mut VState) -> u64 {
  let n = node_at(p.nodes, i);
  let a0 = n.a;
  let a1 = next_of(p, a0);
  let a2 = next_of(p, a1);
  let tn = node_at(p.nodes, a0);
  let tp = list_text(&mut v, p, tn.a);
  open_path(&mut v, c, m, p, &mut st.env, tp);
  let t = get_path(v, m, p, st.env, tp);
  let ix = term(v, eval(&mut v, c, &mut m, p, a1, &mut st, 0));
  let lvl = g_level(v, t);
  let used = g_used(v, t);
  need_lt(&mut v, st, i, ix, 512);
  let mut child = 0;
  if name_is(p, i, "pt_borrow") {
    let two = num(&mut v, 2);
    let g = app2(&mut v, OP_GE, lvl, two);
    prove(&mut v, st, g, i, VC_PT);
    let four = num(&mut v, 4);
    let top = app2(&mut v, OP_EQ, lvl, four);
    let one = num(&mut v, 1);
    let lim = num(&mut v, 256);
    let lo = app2(&mut v, OP_LE, one, ix);
    let hi = app2(&mut v, OP_LT, ix, lim);
    let r = app2(&mut v, OP_AND, lo, hi);
    let g2 = app2(&mut v, OP_IMP, top, r);
    prove(&mut v, st, g2, i, VC_PT);
    let fc = fresh_of_named(&mut v, c, m, p, v.ty_pt, "pt_borrow");
    let fv = vl_at(v, fc);
    let one2 = num(&mut v, 1);
    let below = app2(&mut v, OP_SUB, lvl, one2);
    child = mk_pt(&mut v, v.ty_pt, fv.a, below, fv.c, g_leases(v, t));
  } else {
    let one = num(&mut v, 1);
    let g = app2(&mut v, OP_EQ, lvl, one);
    prove(&mut v, st, g, i, VC_PT);
    child = fresh_of_named(&mut v, c, m, p, v.ty_frame, "pt_borrow_frame");
  }
  let sel = app2(&mut v, OP_SELECT, used, ix);
  prove(&mut v, st, sel, i, VC_OWN);
  // The child lives in a variable no program can name, for the call.
  if v.counter < U64_MAX {
    v.counter = v.counter + 1;
  }
  let start = vec_len(v.pool);
  push_str(&mut v, "borrowed*");
  push_num(&mut v, v.counter);
  let key = seal(&mut v, start);
  let kt = tm_at(v, key);
  vec_push(&mut st.env, Bind { s: vadd(kt.a, kt.b), e: kt.a, val: child });
  let mut args = vec_new[u64]();
  vec_push(&mut args, 0);
  let mut a = next_of(p, a2);
  while a != 0 {
    vec_push(&mut args, a);
    a = next_of(p, a);
  }
  let an = node_at(p.nodes, a2);
  let x = plain_inst(&mut m, plain_fn(p, an.s, an.e));
  let res = vcall_args(&mut v, c, &mut m, p, i, args, key, &mut st, x);
  vec_free(args);
  let after = get_path(v, m, p, st.env, key);
  let mut env = vec_new[Bind]();
  let mut k = 0;
  while k < vec_len(st.env) {
    let b = bind_at(st.env, k);
    if !bind_named(v, p, b, kt.a, kt.b) {
      vec_push(&mut env, b);
    }
    k = k + 1;
  }
  let prev = st.env;
  st.env = env;
  vec_free(prev);
  let mut same = app2(&mut v, OP_EQ, g_id(v, after), g_id(v, child));
  if name_is(p, i, "pt_borrow") {
    let sl = app2(&mut v, OP_EQ, g_level(v, after), g_level(v, child));
    let sn = app2(&mut v, OP_EQ, g_leases(v, after), g_leases(v, child));
    same = app3(&mut v, OP_AND, same, sl, sn);
  }
  prove(&mut v, st, same, i, VC_OWN);
  return res;
}

/// `smp_run(f, args..)`: this processor's call is an ordinary call. The
/// other processors' calls get the same shared arguments and their own
/// `Cpu` and `Mmu`, with the kernel's tables in CR3, so `f`'s precondition
/// must hold for those too.
fn vsmp_run(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: &mut VState) -> u64 {
  let n = node_at(p.nodes, i);
  let a0 = n.a;
  let fnode = node_at(p.nodes, a0);
  let x = plain_inst(&mut m, plain_fn(p, fnode.s, fnode.e));
  let xi = inst_at(m, x);
  let d = node_at(p.nodes, xi.def);
  if d.c != 0 {
    let mut pre = vec_new[Bind]();
    let mut q = d.a;
    let mut a = next_of(p, a0);
    while q != 0 && a != 0 {
      let qn = node_at(p.nodes, q);
      let pt = base_t(m, conv(&mut m, p, qn.a, x, q));
      let mut y = 0;
      if kind_t(m, pt) == TY_CPU {
        y = mk_obj(&mut v, m, pt, 0, 0, 0);
      } else if kind_t(m, pt) == TY_MMU {
        y = mk_obj(&mut v, m, pt, v.t_flimit, 0, 0);
      } else {
        y = eval(&mut v, c, &mut m, p, a, &mut st, 0);
      }
      env_put(&mut pre, p, qn.s, qn.e, y);
      q = qn.next;
      a = next_of(p, a);
    }
    let mut b = vec_new[Bnd]();
    let mut r = d.c;
    while r != 0 {
      let t = spec_tm(&mut v, c, &mut m, p, r, pre, pre, false, 0, &mut b);
      prove(&mut v, st, t, i, VC_REQUIRES);
      r = next_of(p, r);
    }
    vec_free(b);
    vec_free(pre);
  }
  let mut args = vec_new[u64]();
  let mut a = next_of(p, a0);
  while a != 0 {
    vec_push(&mut args, a);
    a = next_of(p, a);
  }
  let res = vcall_args(&mut v, c, &mut m, p, i, args, 0, &mut st, x);
  vec_free(args);
  return res;
}

/// A call of a user function (instance `x`): only its contract is used.
fn vuser_call(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, x: u64, loc: u64, args: &Vec[u64], vals: &Vec[u64], hid: u64, st: &mut VState) -> u64 {
  let xi = inst_at(m, x);
  let d = node_at(p.nodes, xi.def);
  let mut pre = vec_new[Bind]();
  let mut q = d.a;
  let mut j = 0;
  while q != 0 && j < SRC_MAX {
    let qn = node_at(p.nodes, q);
    env_put(&mut pre, p, qn.s, qn.e, u_at(vals, j));
    q = qn.next;
    j = j + 1;
  }
  let mut b = vec_new[Bnd]();
  let mut r = d.c;
  while r != 0 {
    let t = spec_tm(&mut v, c, &mut m, p, r, pre, pre, false, 0, &mut b);
    prove(&mut v, st, t, loc, VC_REQUIRES);
    r = next_of(p, r);
  }
  let rt = conv(&mut m, p, d.b, x, xi.def);
  let nm = inst_name(&mut v, m, p, x);
  let h = cat_str(&mut v, nm, "_ret");
  let res = fresh_of(&mut v, c, m, p, rt, h);
  let mut post = env_clone(pre);
  q = d.a;
  j = 0;
  while q != 0 && j < SRC_MAX {
    let qn = node_at(p.nodes, q);
    let pt = conv(&mut m, p, qn.a, x, q);
    let aj = u_at(args, j);
    let an = node_at(p.nodes, aj);
    if kind_t(m, pt) == TY_MUTREF && (aj == 0 || an.kind == E_MUTBORROW) {
      let mut path = hid;
      if aj != 0 {
        path = list_text(&mut v, p, an.a);
      }
      let start = u_at(v.sum_start, x);
      let end = vadd(start, u_at(v.sum_n, x));
      let mut k = start;
      while k < end && row_param(v, k) != j {
        k = k + 1;
      }
      let first = sum_row(v, k);
      if k < end && first.keep && tm_len(v, first.rel) == 0 {
        // The callee keeps the argument's shape: havoc only what it may
        // change, as a loop would (shallowest first).
        while k < end {
          let row = sum_row(v, k);
          if row.j == j {
            let place = cat_text(&mut v, path, row.rel);
            open_path(&mut v, c, m, p, &mut st.env, place);
            let prev = get_path(v, m, p, st.env, place);
            let nv = havoc(&mut v, c, m, p, prev, row.keep, place);
            set_path(&mut v, m, p, &mut st.env, place, nv);
          }
          k = k + 1;
        }
      } else {
        let nv = fresh_of(&mut v, c, m, p, pt, path);
        set_path(&mut v, m, p, &mut st.env, path, nv);
      }
      env_put(&mut post, p, qn.s, qn.e, get_path(v, m, p, st.env, path));
    }
    q = qn.next;
    j = j + 1;
  }
  let mut en = d.d;
  while en != 0 {
    let t = spec_tm(&mut v, c, &mut m, p, en, post, pre, true, res, &mut b);
    vec_push(&mut st.pc, t);
    en = next_of(p, en);
  }
  vec_free(b);
  vec_free(pre);
  vec_free(post);
  return res;
}

/// Writes the new value of a `&mut` argument back to its place.
fn put_back(v: &mut Vr, m: &Mono, p: &Parser, st: &mut VState, a: u64, nv: u64) {
  let an = node_at(p.nodes, a);
  if an.kind == E_MUTBORROW {
    let path = list_text(&mut v, p, an.a);
    set_path(&mut v, m, p, &mut st.env, path, nv);
  }
}

/// `(< x lim)` proved.
fn need_lt(v: &mut Vr, st: &VState, i: u64, x: u64, lim: u64) {
  let tl = num(&mut v, lim);
  let g = app2(&mut v, OP_LT, x, tl);
  prove(&mut v, st, g, i, VC_BOUNDS);
}

/// A fresh u64 that is at most `hi`.
fn fresh_upto(v: &mut Vr, st: &mut VState, hint: Str, hi: u64) -> u64 {
  let h = atom_str(&mut v, hint);
  let x = fresh_u64(&mut v, h);
  let th = num(&mut v, hi);
  let g = app2(&mut v, OP_LE, term(v, x), th);
  vec_push(&mut st.pc, g);
  return x;
}

fn fresh_u64_named(v: &mut Vr, hint: Str) -> u64 {
  let h = atom_str(&mut v, hint);
  return fresh_u64(&mut v, h);
}

fn fresh_bool_named(v: &mut Vr, hint: Str) -> u64 {
  let h = atom_str(&mut v, hint);
  return fresh_bool(&mut v, h);
}

fn fresh_of_named(v: &mut Vr, c: &Checker, m: &Mono, p: &Parser, tyx: u64, hint: Str) -> u64 {
  let h = atom_str(&mut v, hint);
  return fresh_of(&mut v, c, m, p, tyx, h);
}

/// `(forall ((k Int)) (=> (and (<= lo k) (< k hi)) (not (select used k))))`
fn all_unused(v: &mut Vr, used: u64, lo: u64, hi: u64) -> u64 {
  let tlo = num(&mut v, lo);
  let thi = num(&mut v, hi);
  let a = app2(&mut v, OP_LE, tlo, v.t_k);
  let b = app2(&mut v, OP_LT, v.t_k, thi);
  let r = app2(&mut v, OP_AND, a, b);
  let sel = app2(&mut v, OP_SELECT, used, v.t_k);
  let ns = t_not(&mut v, sel);
  let imp = app2(&mut v, OP_IMP, r, ns);
  return forall_tm(&mut v, v.t_k, imp);
}

/// Proves the invariants of value `x`, written to an atomic at node `i`.
fn prove_invariants(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, x: u64, i: u64, st: &mut VState) {
  let mut invs = vec_new[u64]();
  invariant_terms(&mut v, c, &mut m, p, x, &mut invs);
  let mut k = 0;
  while k < vec_len(invs) {
    prove(&mut v, st, u_at(invs, k), i, VC_LOCKINV);
    k = k + 1;
  }
  vec_free(invs);
}

/// A value read from an atomic of type `t`: fresh, with its invariants.
fn atomic_read(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, t: u64, st: &mut VState) -> u64 {
  let r = fresh_of_named(&mut v, c, m, p, t, "atomic");
  let mut invs = vec_new[u64]();
  invariant_terms(&mut v, c, &mut m, p, r, &mut invs);
  let mut k = 0;
  while k < vec_len(invs) {
    vec_push(&mut st.pc, u_at(invs, k));
    k = k + 1;
  }
  vec_free(invs);
  return r;
}

fn vbuiltin(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, args: &Vec[u64], vals: &Vec[u64], st: &mut VState) -> u64 {
  let x0 = u_at(vals, 0);
  let x1 = u_at(vals, 1);
  let x2 = u_at(vals, 2);
  let a0 = vl_at(v, x0);
  if name_is(p, i, "box") {
    return mk(&mut v, VV_BOXK, 0, x0, 0, 0, 0);
  }
  if name_is(p, i, "wrap_add") || name_is(p, i, "wrap_sub") || name_is(p, i, "wrap_mul") {
    let mut op = OP_MUL;
    if name_is(p, i, "wrap_add") {
      op = OP_ADD;
    } else if name_is(p, i, "wrap_sub") {
      op = OP_SUB;
    }
    let t = app2(&mut v, op, term(v, x0), term(v, x1));
    let r = wrap_term(&mut v, m, int_op_ty(c, m, v.env, i), t);
    return mk_u(&mut v, r);
  }
  if name_is(p, i, "lock_new") {
    let mut invs = vec_new[u64]();
    invariant_terms(&mut v, c, &mut m, p, x0, &mut invs);
    let mut k = 0;
    while k < vec_len(invs) {
      prove(&mut v, st, u_at(invs, k), i, VC_LOCKINV);
      k = k + 1;
    }
    vec_free(invs);
    let t = val_type(v, &mut m, p, x0);
    let lt = intern(&mut m, p, TY_LOCK, t);
    return mk_obj(&mut v, m, lt, 0, 0, 0);
  }
  // An atomic's value may change at any moment: only its invariants are
  // known when it is read, and they are proved of every value written.
  if name_is(p, i, "atomic_new") {
    prove_invariants(&mut v, c, &mut m, p, x0, i, &mut st);
    let mut t = 0;
    if has_int_op(c, v.env, i) {
      t = int_op_ty(c, m, v.env, i);
    } else {
      t = val_type(v, &mut m, p, x0);
    }
    let aty = intern(&mut m, p, TY_ATOMIC, t);
    return mk_obj(&mut v, m, aty, 0, 0, 0);
  }
  if name_is(p, i, "atomic_store") || name_is(p, i, "atomic_swap") || name_is(p, i, "atomic_cas") {
    if name_is(p, i, "atomic_cas") {
      prove_invariants(&mut v, c, &mut m, p, x2, i, &mut st);
      return fresh_bool_named(&mut v, "cas");
    }
    prove_invariants(&mut v, c, &mut m, p, x1, i, &mut st);
    if name_is(p, i, "atomic_store") {
      return v.unit;
    }
    return atomic_read(&mut v, c, &mut m, p, inner_t(m, a0.ty), &mut st);
  }
  if name_is(p, i, "atomic_end") || name_is(p, i, "atomic_load") || name_is(p, i, "atomic_wrap_add") {
    return atomic_read(&mut v, c, &mut m, p, inner_t(m, a0.ty), &mut st);
  }
  if name_is(p, i, "lock_end") {
    let r = fresh_of_named(&mut v, c, m, p, inner_t(m, a0.ty), "unlocked");
    let mut invs = vec_new[u64]();
    invariant_terms(&mut v, c, &mut m, p, r, &mut invs);
    let mut k = 0;
    while k < vec_len(invs) {
      vec_push(&mut st.pc, u_at(invs, k));
      k = k + 1;
    }
    vec_free(invs);
    return r;
  }
  if name_is(p, i, "unbox") {
    if a0.kind == VV_BOXK {
      return a0.a;
    }
    return fresh_of_named(&mut v, c, m, p, a0.ty, "unboxed");
  }
  if name_is(p, i, "alloc") || name_is(p, i, "balloc") {
    let g = app2(&mut v, OP_LE, a0.a, v.t_allocmax);
    prove(&mut v, st, g, i, VC_ALLOC);
    // alloc zero-fills.
    return mk(&mut v, VV_BUF, 0, a0.a, v.t_zarr, 0, 0);
  }
  if name_is(p, i, "len") || name_is(p, i, "slen") || name_is(p, i, "blen") || name_is(p, i, "vec_len") {
    return mk_u(&mut v, a0.a);
  }
  if name_is(p, i, "get") || name_is(p, i, "sget") || name_is(p, i, "bget") {
    let ix = term(v, x1);
    let g = app2(&mut v, OP_LT, ix, a0.a);
    prove(&mut v, st, g, i, VC_BOUNDS);
    let sel = app2(&mut v, OP_SELECT, a0.b, ix);
    let mut hi = v.t_255;
    if name_is(p, i, "get") {
      // Every stored element is a u64 (set only stores u64 values).
      hi = v.t_u64max;
    }
    let r = in_range(&mut v, v.t_zero, sel, hi);
    vec_push(&mut st.pc, r);
    return mk_u(&mut v, sel);
  }
  if name_is(p, i, "set") || name_is(p, i, "bset") {
    let ix = term(v, x1);
    let g = app2(&mut v, OP_LT, ix, a0.a);
    prove(&mut v, st, g, i, VC_BOUNDS);
    let d = app3(&mut v, OP_STORE, a0.b, ix, term(v, x2));
    let nb = mk(&mut v, VV_BUF, 0, a0.a, d, 0, 0);
    if name_is(p, i, "set") {
      return nb;
    }
    put_back(&mut v, m, p, &mut st, u_at(args, 0), nb);
    return v.unit;
  }
  // Bulk copies. A copied range is a lambda over the old arrays, so a read
  // of it reduces to a read of the source or the old data.
  if name_is(p, i, "bcopy") || name_is(p, i, "bmove") {
    let mut sx = x0;
    let d = term(v, x1);
    let mut s = term(v, x2);
    let mut n = term(v, u_at(vals, 3));
    if name_is(p, i, "bcopy") {
      sx = x2;
      s = term(v, u_at(vals, 3));
      n = term(v, u_at(vals, 4));
    }
    let src = vl_at(v, sx);
    let de = app2(&mut v, OP_ADD, d, n);
    let g = app2(&mut v, OP_LE, de, a0.a);
    prove(&mut v, st, g, i, VC_BOUNDS);
    let se = app2(&mut v, OP_ADD, s, n);
    let g2 = app2(&mut v, OP_LE, se, src.a);
    prove(&mut v, st, g2, i, VC_BOUNDS);
    let inr = port_range(&mut v, d, n);
    let off = app2(&mut v, OP_SUB, v.t_k, d);
    let at = app2(&mut v, OP_ADD, s, off);
    let from = app2(&mut v, OP_SELECT, src.b, at);
    let kept = app2(&mut v, OP_SELECT, a0.b, v.t_k);
    let body = app3(&mut v, OP_ITE, inr, from, kept);
    let nd = lambda_tm(&mut v, v.t_k, body);
    let nb = mk(&mut v, VV_BUF, 0, a0.a, nd, 0, 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), nb);
    return v.unit;
  }
  // From a page into bytes: what the page holds is not tracked, so the
  // copied range of the destination becomes unknown.
  if name_is(p, i, "frame_to_bytes") || name_is(p, i, "dma_to_bytes") {
    let d = term(v, x1);
    let o = term(v, u_at(vals, 3));
    let n = term(v, u_at(vals, 4));
    let oe = app2(&mut v, OP_ADD, o, n);
    let page = num(&mut v, 4096);
    let g = app2(&mut v, OP_LE, oe, page);
    prove(&mut v, st, g, i, VC_BOUNDS);
    let de = app2(&mut v, OP_ADD, d, n);
    let g2 = app2(&mut v, OP_LE, de, a0.a);
    prove(&mut v, st, g2, i, VC_BOUNDS);
    let mut h = 0;
    if name_is(p, i, "frame_to_bytes") {
      h = atom_str(&mut v, "frame_to_bytes");
    } else {
      h = atom_str(&mut v, "dma_to_bytes");
    }
    let fresh = fresh_array(&mut v, h, SO_INT);
    let inr = port_range(&mut v, d, n);
    let from = app2(&mut v, OP_SELECT, fresh, v.t_k);
    let kept = app2(&mut v, OP_SELECT, a0.b, v.t_k);
    let body = app3(&mut v, OP_ITE, inr, from, kept);
    let nd = lambda_tm(&mut v, v.t_k, body);
    let nb = mk(&mut v, VV_BUF, 0, a0.a, nd, 0, 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), nb);
    return v.unit;
  }
  // From bytes into a page: the page's contents are not tracked, and it
  // stays the same page.
  if name_is(p, i, "bytes_to_frame") || name_is(p, i, "bytes_to_dma") {
    let o = term(v, x1);
    let src = vl_at(v, x2);
    let s = term(v, u_at(vals, 3));
    let n = term(v, u_at(vals, 4));
    let oe = app2(&mut v, OP_ADD, o, n);
    let page = num(&mut v, 4096);
    let g = app2(&mut v, OP_LE, oe, page);
    prove(&mut v, st, g, i, VC_BOUNDS);
    let se = app2(&mut v, OP_ADD, s, n);
    let g2 = app2(&mut v, OP_LE, se, src.a);
    prove(&mut v, st, g2, i, VC_BOUNDS);
    return v.unit;
  }
  // A u8 always fits in a byte: the type says what E-VERIFY-BYTE used to prove.
  if name_is(p, i, "serial_write") {
    return v.unit;
  }
  if name_is(p, i, "serial_read") {
    return fresh_upto(&mut v, &mut st, "serial_read", 255);
  }
  if name_is(p, i, "serial_poll") {
    // 256 when no byte is waiting.
    return fresh_upto(&mut v, &mut st, "serial_poll", 256);
  }

  // ---- vectors ----
  if name_is(p, i, "vec_push") {
    // A push that cannot grow the vector aborts (out of memory), so after
    // it the length stayed below 2^60.
    let lt = app2(&mut v, OP_LT, a0.a, v.t_allocmax);
    vec_push(&mut st.pc, lt);
    let el = vec_write(&mut v, m, a0.b, a0.a, x1);
    let one = num(&mut v, 1);
    let nl = app2(&mut v, OP_ADD, a0.a, one);
    let ea = vl_at(v, a0.b);
    let eb = vl_at(v, el);
    if v.counts && ea.kind == VV_U && eb.kind == VV_U {
      let d = count_one(&mut v, term(v, x1));
      let f = count_step(&mut v, eb.a, nl, ea.a, a0.a, d);
      vec_push(&mut st.pc, f);
    }
    let nv = mk(&mut v, VV_VEC, a0.ty, nl, el, 0, 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), nv);
    return v.unit;
  }
  if name_is(p, i, "vec_pop") {
    let g = app2(&mut v, OP_GT, a0.a, v.t_zero);
    prove(&mut v, st, g, i, VC_BOUNDS);
    let one = num(&mut v, 1);
    let last = app2(&mut v, OP_SUB, a0.a, one);
    let ea = vl_at(v, a0.b);
    if v.counts && ea.kind == VV_U {
      let y = app2(&mut v, OP_SELECT, ea.a, last);
      let d1 = count_one(&mut v, y);
      let d = app1(&mut v, OP_SUB, d1);
      let f = count_step(&mut v, ea.a, last, ea.a, a0.a, d);
      vec_push(&mut st.pc, f);
    }
    let r = vec_read(&mut v, c, m, p, a0.ty, a0.b, last, &mut st);
    let nv = mk(&mut v, VV_VEC, a0.ty, last, a0.b, 0, 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), nv);
    return r;
  }
  if name_is(p, i, "vec_get") || name_is(p, i, "vec_set") || name_is(p, i, "vec_swap") {
    let ix = term(v, x1);
    let g = app2(&mut v, OP_LT, ix, a0.a);
    prove(&mut v, st, g, i, VC_BOUNDS);
    let mut prev = v.unit;
    if !name_is(p, i, "vec_set") {
      prev = vec_read(&mut v, c, m, p, a0.ty, a0.b, ix, &mut st);
    }
    if !name_is(p, i, "vec_get") {
      let el = vec_write(&mut v, m, a0.b, ix, x2);
      let ea = vl_at(v, a0.b);
      let eb = vl_at(v, el);
      if v.counts && ea.kind == VV_U && eb.kind == VV_U {
        let din = count_one(&mut v, term(v, x2));
        let y = app2(&mut v, OP_SELECT, ea.a, ix);
        let dout = count_one(&mut v, y);
        let d = app2(&mut v, OP_SUB, din, dout);
        let f = count_step(&mut v, eb.a, a0.a, ea.a, a0.a, d);
        vec_push(&mut st.pc, f);
      }
      let nv = mk(&mut v, VV_VEC, a0.ty, a0.a, el, 0, 0);
      put_back(&mut v, m, p, &mut st, u_at(args, 0), nv);
    }
    return prev;
  }
  if name_is(p, i, "vec_free") {
    if ck_linear(c, m, p, a0.ty) {
      // Freeing the storage would drop the elements still in it.
      let g = app2(&mut v, OP_EQ, a0.a, v.t_zero);
      prove(&mut v, st, g, i, VC_LEAK);
    }
    return v.unit;
  }

  // ---- bytes and the host ----
  if name_is(p, i, "bfrom") {
    return mk(&mut v, VV_BUF, 0, a0.a, a0.b, 0, 0);
  }
  if name_is(p, i, "host_argc") {
    return fresh_u64_named(&mut v, "argc");
  }
  if name_is(p, i, "host_arg") {
    return fresh_of_named(&mut v, c, m, p, v.ty_bytes, "arg");
  }
  if name_is(p, i, "host_read") {
    let nv = fresh_of_named(&mut v, c, m, p, v.ty_bytes, "file");
    put_back(&mut v, m, p, &mut st, u_at(args, 2), nv);
    return fresh_bool_named(&mut v, "read_ok");
  }
  if name_is(p, i, "host_write") {
    return fresh_bool_named(&mut v, "write_ok");
  }
  if name_is(p, i, "host_env") {
    let nv = fresh_of_named(&mut v, c, m, p, v.ty_bytes, "env");
    put_back(&mut v, m, p, &mut st, u_at(args, 2), nv);
    return fresh_bool_named(&mut v, "env_set");
  }
  if name_is(p, i, "host_cpus") {
    return fresh_u64_named(&mut v, "cpus");
  }
  if name_is(p, i, "host_spawn") {
    return fresh_of_named(&mut v, c, m, p, v.ty_child, "child");
  }
  if name_is(p, i, "child_write") {
    return fresh_bool_named(&mut v, "child_write_ok");
  }
  if name_is(p, i, "child_read_line") {
    let nv = fresh_of_named(&mut v, c, m, p, v.ty_bytes, "line");
    put_back(&mut v, m, p, &mut st, u_at(args, 1), nv);
    return fresh_bool_named(&mut v, "line_ok");
  }
  if name_is(p, i, "child_wait") {
    // An exit status, or 128 + a signal number.
    let h = atom_str(&mut v, "status");
    let t = fresh_int(&mut v, h, v.t_zero, v.t_255);
    return mk_u(&mut v, t);
  }

  // ---- physical pages ----
  if name_is(p, i, "pool_size") {
    return mk_u(&mut v, g_size(v, x0));
  }
  if name_is(p, i, "pool_take") {
    let ix = term(v, x1);
    let g = app2(&mut v, OP_LT, ix, g_size(v, x0));
    prove(&mut v, st, g, i, VC_BOUNDS);
    let g2 = app2(&mut v, OP_SELECT, g_has(v, x0), ix);
    prove(&mut v, st, g2, i, VC_OWN);
    let has = app3(&mut v, OP_STORE, g_has(v, x0), ix, v.t_false);
    let np = mk_obj(&mut v, m, v.ty_pool, has, g_size(v, x0), 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), np);
    return mk_obj(&mut v, m, v.ty_frame, ix, 0, 0);
  }
  if name_is(p, i, "pool_give") {
    let has = app3(&mut v, OP_STORE, g_has(v, x0), g_id(v, x1), v.t_true);
    let np = mk_obj(&mut v, m, v.ty_pool, has, g_size(v, x0), 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), np);
    return v.unit;
  }
  if name_is(p, i, "frame_id") {
    return mk_u(&mut v, g_id(v, x0));
  }
  if name_is(p, i, "frame_read") || name_is(p, i, "frame_write") {
    need_lt(&mut v, st, i, term(v, x1), 512);
    if name_is(p, i, "frame_write") {
      return v.unit;
    }
    return fresh_u64_named(&mut v, "frame_read");
  }
  if name_is(p, i, "frame_read8") || name_is(p, i, "frame_write8") {
    need_lt(&mut v, st, i, term(v, x1), 4096);
    if name_is(p, i, "frame_write8") {
      return v.unit;
    }
    return fresh_upto(&mut v, &mut st, "frame_read8", 255);
  }

  // ---- page tables ----
  if name_is(p, i, "pt_new") {
    let lvl = term(v, x1);
    let one = num(&mut v, 1);
    let five = num(&mut v, 5);
    let g = in_range(&mut v, one, lvl, five);
    prove(&mut v, st, g, i, VC_PT);
    return mk_pt(&mut v, v.ty_pt, g_id(v, x0), lvl, v.t_nobool, v.t_zero);
  }
  if name_is(p, i, "pt_free") || name_is(p, i, "pt_free_root") {
    let mut t = x0;
    if name_is(p, i, "pt_free_root") {
      t = x1;
    }
    let lvl = g_level(v, t);
    let used = g_used(v, t);
    let four = num(&mut v, 4);
    if name_is(p, i, "pt_free") {
      let eq = app2(&mut v, OP_EQ, lvl, four);
      let g = t_not(&mut v, eq);
      prove(&mut v, st, g, i, VC_PT);
      let g2 = all_unused(&mut v, used, 0, 512);
      prove(&mut v, st, g2, i, VC_OWN);
    } else {
      let g = app2(&mut v, OP_EQ, lvl, four);
      prove(&mut v, st, g, i, VC_PT);
      let g2 = all_unused(&mut v, used, 1, 256);
      prove(&mut v, st, g2, i, VC_OWN);
      let eq = app2(&mut v, OP_EQ, g_id(v, t), g_root(v, x0));
      let g3 = t_not(&mut v, eq);
      prove(&mut v, st, g3, i, VC_MMU);
      let g4 = app2(&mut v, OP_EQ, g_leases(v, t), v.t_zero);
      prove(&mut v, st, g4, i, VC_LEASE);
    }
    return mk_obj(&mut v, m, v.ty_frame, g_id(v, t), 0, 0);
  }
  if name_is(p, i, "pt_has") {
    let ix = term(v, x1);
    need_lt(&mut v, st, i, ix, 512);
    // Slot 0 of a top-level table maps the kernel on the kernel target: the
    // hardware entry is present although the table does not own it, so what
    // pt_has says there is unknown.
    let k = fresh_bool_named(&mut v, "pt_has_kernel");
    let four = num(&mut v, 4);
    let top = app2(&mut v, OP_EQ, g_level(v, x0), four);
    let zero = app2(&mut v, OP_EQ, ix, v.t_zero);
    let at0 = app2(&mut v, OP_AND, top, zero);
    let sel = app2(&mut v, OP_SELECT, g_used(v, x0), ix);
    let r = app3(&mut v, OP_ITE, at0, term(v, k), sel);
    return mk_b(&mut v, r);
  }
  if name_is(p, i, "pt_writable") {
    // Whether the page in slot i of a last-level table may be written.
    // Nothing the proof tracks: the answer is unknown.
    let ix = term(v, x1);
    need_lt(&mut v, st, i, ix, 512);
    let one = num(&mut v, 1);
    let g = app2(&mut v, OP_EQ, g_level(v, x0), one);
    prove(&mut v, st, g, i, VC_PT);
    return fresh_bool_named(&mut v, "pt_writable");
  }

  // ---- I/O ports ----
  if name_is(p, i, "port_claim") {
    let b = term(v, x1);
    let n = term(v, x2);
    let end = app2(&mut v, OP_ADD, b, n);
    let g = app2(&mut v, OP_LE, end, v.t_plimit);
    prove(&mut v, st, g, i, VC_BOUNDS);
    let inr = port_range(&mut v, b, n);
    let sel = app2(&mut v, OP_SELECT, g_free(v, x0), v.t_k);
    let imp = app2(&mut v, OP_IMP, inr, sel);
    let g2 = forall_tm(&mut v, v.t_k, imp);
    prove(&mut v, st, g2, i, VC_OWN);
    // A lambda, not a fresh array with a quantified definition: reads of it
    // reduce directly, so chains of claims stay quantifier-free.
    let ni = t_not(&mut v, inr);
    let body = app2(&mut v, OP_AND, sel, ni);
    let nf = lambda_tm(&mut v, v.t_k, body);
    let np = mk_obj(&mut v, m, a0.ty, nf, 0, 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), np);
    return mk_obj(&mut v, m, kind_ty(m, p, TY_PORTIO), b, n, 0);
  }
  if name_is(p, i, "port_release") {
    let inr = port_range(&mut v, g_base(v, x1), g_count(v, x1));
    let sel = app2(&mut v, OP_SELECT, g_free(v, x0), v.t_k);
    let body = app2(&mut v, OP_OR, sel, inr);
    let nf = lambda_tm(&mut v, v.t_k, body);
    let np = mk_obj(&mut v, m, a0.ty, nf, 0, 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), np);
    return v.unit;
  }
  // ---- memory-mapped device registers ----
  if name_is(p, i, "mmio_claim") {
    let b = term(v, x1);
    let n = term(v, x2);
    let lo = app2(&mut v, OP_LE, v.t_mmio_lo, b);
    let end = app2(&mut v, OP_ADD, b, n);
    let hi = app2(&mut v, OP_LE, end, v.t_mmio_hi);
    let g = app2(&mut v, OP_AND, lo, hi);
    prove(&mut v, st, g, i, VC_BOUNDS);
    let inr = port_range(&mut v, b, n);
    let sel = app2(&mut v, OP_SELECT, g_free(v, x0), v.t_k);
    let imp = app2(&mut v, OP_IMP, inr, sel);
    let g2 = forall_tm(&mut v, v.t_k, imp);
    prove(&mut v, st, g2, i, VC_OWN);
    let ni = t_not(&mut v, inr);
    let body = app2(&mut v, OP_AND, sel, ni);
    let nf = lambda_tm(&mut v, v.t_k, body);
    let np = mk_obj(&mut v, m, a0.ty, nf, 0, 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), np);
    return mk_obj(&mut v, m, kind_ty(m, p, TY_MMIO), b, n, 0);
  }
  if name_is(p, i, "mmio_release") {
    let inr = port_range(&mut v, g_base(v, x1), g_len(v, x1));
    let sel = app2(&mut v, OP_SELECT, g_free(v, x0), v.t_k);
    let body = app2(&mut v, OP_OR, sel, inr);
    let nf = lambda_tm(&mut v, v.t_k, body);
    let np = mk_obj(&mut v, m, a0.ty, nf, 0, 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), np);
    return v.unit;
  }
  if name_is(p, i, "mmio_base") {
    return mk_u(&mut v, g_base(v, x0));
  }
  if name_is(p, i, "mmio_len") {
    return mk_u(&mut v, g_len(v, x0));
  }
  if name_is(p, i, "mmio_read8") || name_is(p, i, "mmio_read16") || name_is(p, i, "mmio_read32") || name_is(p, i, "mmio_read64")
    || name_is(p, i, "mmio_write8") || name_is(p, i, "mmio_write16") || name_is(p, i, "mmio_write32") || name_is(p, i, "mmio_write64") {
    let mut bytes = 8;
    let mut max = U64_MAX;
    if name_is(p, i, "mmio_read8") || name_is(p, i, "mmio_write8") {
      bytes = 1;
      max = 255;
    } else if name_is(p, i, "mmio_read16") || name_is(p, i, "mmio_write16") {
      bytes = 2;
      max = 65535;
    } else if name_is(p, i, "mmio_read32") || name_is(p, i, "mmio_write32") {
      bytes = 4;
      max = 4294967295;
    }
    let off = term(v, x1);
    let tb = num(&mut v, bytes);
    let end = app2(&mut v, OP_ADD, off, tb);
    let g = app2(&mut v, OP_LE, end, g_len(v, x0));
    prove(&mut v, st, g, i, VC_BOUNDS);
    // Devices want naturally aligned accesses (and an unaligned one could
    // straddle into the next register).
    let addr = app2(&mut v, OP_ADD, g_base(v, x0), off);
    let md = app2(&mut v, OP_MOD, addr, tb);
    let g2 = app2(&mut v, OP_EQ, md, v.t_zero);
    prove(&mut v, st, g2, i, VC_BOUNDS);
    let tm = num(&mut v, max);
    if name_is(p, i, "mmio_write8") || name_is(p, i, "mmio_write16") || name_is(p, i, "mmio_write32") || name_is(p, i, "mmio_write64") {
      return v.unit;
    }
    let n = node_at(p.nodes, i);
    let h = atom_src(&mut v, p, n.s, n.e);
    let r = fresh_u64(&mut v, h);
    let le = app2(&mut v, OP_LE, term(v, r), tm);
    vec_push(&mut st.pc, le);
    return r;
  }
  // Pages lent to devices: lending and taking back keep the page number.
  if name_is(p, i, "dma_lend") {
    return mk_obj(&mut v, m, kind_ty(m, p, TY_DMA), g_id(v, x0), 0, 0);
  }
  if name_is(p, i, "dma_take") {
    return mk_obj(&mut v, m, v.ty_frame, g_id(v, x0), 0, 0);
  }
  if name_is(p, i, "dma_id") {
    return mk_u(&mut v, g_id(v, x0));
  }
  if name_is(p, i, "dma_addr") {
    return fresh_u64_named(&mut v, "dma_addr");
  }
  if name_is(p, i, "dma_read8") || name_is(p, i, "dma_read16") || name_is(p, i, "dma_read32") || name_is(p, i, "dma_read64")
    || name_is(p, i, "dma_write8") || name_is(p, i, "dma_write16") || name_is(p, i, "dma_write32") || name_is(p, i, "dma_write64") {
    let mut bytes = 8;
    let mut max = U64_MAX;
    if name_is(p, i, "dma_read8") || name_is(p, i, "dma_write8") {
      bytes = 1;
      max = 255;
    } else if name_is(p, i, "dma_read16") || name_is(p, i, "dma_write16") {
      bytes = 2;
      max = 65535;
    } else if name_is(p, i, "dma_read32") || name_is(p, i, "dma_write32") {
      bytes = 4;
      max = 4294967295;
    }
    let off = term(v, x1);
    let tb = num(&mut v, bytes);
    let end = app2(&mut v, OP_ADD, off, tb);
    let page = num(&mut v, 4096);
    let g = app2(&mut v, OP_LE, end, page);
    prove(&mut v, st, g, i, VC_BOUNDS);
    // The page is page-aligned, so an aligned offset is an aligned address.
    let md = app2(&mut v, OP_MOD, off, tb);
    let g2 = app2(&mut v, OP_EQ, md, v.t_zero);
    prove(&mut v, st, g2, i, VC_BOUNDS);
    let tm = num(&mut v, max);
    if name_is(p, i, "dma_write8") || name_is(p, i, "dma_write16") || name_is(p, i, "dma_write32") || name_is(p, i, "dma_write64") {
      return v.unit;
    }
    let n = node_at(p.nodes, i);
    let h = atom_src(&mut v, p, n.s, n.e);
    let r = fresh_u64(&mut v, h);
    let le = app2(&mut v, OP_LE, term(v, r), tm);
    vec_push(&mut st.pc, le);
    return r;
  }
  if name_is(p, i, "port_base") {
    return mk_u(&mut v, g_base(v, x0));
  }
  if name_is(p, i, "port_count") {
    return mk_u(&mut v, g_count(v, x0));
  }
  if name_is(p, i, "pio_in8") || name_is(p, i, "pio_in16") || name_is(p, i, "pio_in32")
    || name_is(p, i, "pio_out8") || name_is(p, i, "pio_out16") || name_is(p, i, "pio_out32") {
    let mut bytes = 4;
    let mut max = 4294967295;
    if name_is(p, i, "pio_in8") || name_is(p, i, "pio_out8") {
      bytes = 1;
      max = 255;
    } else if name_is(p, i, "pio_in16") || name_is(p, i, "pio_out16") {
      bytes = 2;
      max = 65535;
    }
    let tb = num(&mut v, bytes);
    let end = app2(&mut v, OP_ADD, term(v, x1), tb);
    let g = app2(&mut v, OP_LE, end, g_count(v, x0));
    prove(&mut v, st, g, i, VC_BOUNDS);
    if name_is(p, i, "pio_out8") || name_is(p, i, "pio_out16") || name_is(p, i, "pio_out32") {
      return v.unit;
    }
    let n = node_at(p.nodes, i);
    let h = atom_src(&mut v, p, n.s, n.e);
    let r = fresh_u64(&mut v, h);
    let tm = num(&mut v, max);
    let le = app2(&mut v, OP_LE, term(v, r), tm);
    vec_push(&mut st.pc, le);
    return r;
  }
  if name_is(p, i, "pt_put") || name_is(p, i, "pt_take") || name_is(p, i, "pt_put_frame") || name_is(p, i, "pt_take_frame") {
    return pt_slot(&mut v, c, m, p, i, args, vals, &mut st);
  }

  // ---- MMU and CPU ----
  // A lease counts this processor among those that may be running on the
  // table, so nothing is taken out of its tree until the lease is given back.
  if name_is(p, i, "mmu_enter") {
    let four = num(&mut v, 4);
    let g = app2(&mut v, OP_EQ, g_level(v, x1), four);
    prove(&mut v, st, g, i, VC_PT);
    let g2 = app2(&mut v, OP_EQ, g_root(v, x0), v.t_flimit);
    prove(&mut v, st, g2, i, VC_MMU);
    let id = g_id(v, x1);
    let nm = mk_obj(&mut v, m, kind_ty(m, p, TY_MMU), id, 0, 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), nm);
    let one = num(&mut v, 1);
    let up = app2(&mut v, OP_ADD, g_leases(v, x1), one);
    let nt = mk_pt(&mut v, v.ty_pt, id, g_level(v, x1), g_used(v, x1), up);
    put_back(&mut v, m, p, &mut st, u_at(args, 1), nt);
    return mk_obj(&mut v, m, kind_ty(m, p, TY_LEASE), id, 0, 0);
  }
  // Loads the kernel's tables and gives the lease back. No table's count
  // in the proof drops (none is named): they only ever overcount, which is
  // safe. `pt_lease_count` reads the true one.
  if name_is(p, i, "mmu_exit") {
    let nm = mk_obj(&mut v, m, kind_ty(m, p, TY_MMU), v.t_flimit, 0, 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), nm);
    return v.unit;
  }
  // The number of leases outstanding on the table, which only its holder
  // (this `&mut`) could raise: from here on that is what the proof knows.
  if name_is(p, i, "pt_lease_count") {
    let r = fresh_u64_named(&mut v, "pt_lease_count");
    let nt = mk_pt(&mut v, v.ty_pt, g_id(v, x0), g_level(v, x0), g_used(v, x0), term(v, r));
    put_back(&mut v, m, p, &mut st, u_at(args, 0), nt);
    return r;
  }
  if name_is(p, i, "mmu_kernel") {
    let nm = mk_obj(&mut v, m, kind_ty(m, p, TY_MMU), v.t_flimit, 0, 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 0), nm);
    return v.unit;
  }
  if name_is(p, i, "cpu_run") || name_is(p, i, "cpu_idle") {
    return fresh_upto(&mut v, &mut st, "vector", 255);
  }
  if name_is(p, i, "boot_fb") {
    // The prelude reports a framebuffer only if it ends at or below 4 GiB,
    // so every field fits in 32 bits.
    return fresh_upto(&mut v, &mut st, "fb", 4294967295);
  }
  if name_is(p, i, "cpu_count") {
    let x = fresh_u64_named(&mut v, "cpus");
    // The platform's promise: at least this processor, and no more than
    // 4096 (so per-processor tables can be allocated).
    let one = num(&mut v, 1);
    let most = num(&mut v, 4096);
    let a = app2(&mut v, OP_GE, term(v, x), one);
    let b = app2(&mut v, OP_LE, term(v, x), most);
    let g = app2(&mut v, OP_AND, a, b);
    vec_push(&mut st.pc, g);
    return x;
  }
  if name_is(p, i, "cpu_get") {
    need_lt(&mut v, st, i, term(v, x1), 21);
    return fresh_u64_named(&mut v, "reg");
  }
  if name_is(p, i, "cpu_set") {
    // Registers 0-17 and the FS base (20); the error code and fault address
    // (18, 19) are only reported by a trap.
    let r = term(v, x1);
    let lo = app2(&mut v, OP_LE, v.t_zero, r);
    let t18 = num(&mut v, 18);
    let t20 = num(&mut v, 20);
    let a = app2(&mut v, OP_LT, r, t18);
    let b = app2(&mut v, OP_EQ, r, t20);
    let ab = app2(&mut v, OP_OR, a, b);
    let g = app2(&mut v, OP_AND, lo, ab);
    prove(&mut v, st, g, i, VC_BOUNDS);
    return v.unit;
  }

  // ---- user programs ----
  if name_is(p, i, "sys_spawn") {
    let from = term(v, x1);
    let to = term(v, x2);
    let a = app2(&mut v, OP_LE, from, to);
    let b = app2(&mut v, OP_LE, to, a0.a);
    let g = app2(&mut v, OP_AND, a, b);
    prove(&mut v, st, g, i, VC_BOUNDS);
    return fresh_u64_named(&mut v, "spawn");
  }
  if name_is(p, i, "sys_send") {
    let a2 = vl_at(v, x2);
    let g = app2(&mut v, OP_LE, term(v, u_at(vals, 3)), a2.a);
    prove(&mut v, st, g, i, VC_BOUNDS);
  }
  if name_is(p, i, "sys_recv") {
    // The kernel may overwrite every byte of the buffer, but not its length.
    let a2 = vl_at(v, x2);
    let fx = fresh_of_named(&mut v, c, m, p, v.ty_bytes, "recv");
    let f = vl_at(v, fx);
    let nb = mk(&mut v, VV_BUF, 0, a2.a, f.b, 0, 0);
    put_back(&mut v, m, p, &mut st, u_at(args, 2), nb);
  }
  if name_is(p, i, "sys_wait") || name_is(p, i, "sys_kill") || name_is(p, i, "sys_getpid") || name_is(p, i, "sys_info")
    || name_is(p, i, "sys_call") || name_is(p, i, "sys_send") || name_is(p, i, "sys_recv") {
    let n = node_at(p.nodes, i);
    let h = atom_src(&mut v, p, n.s, n.e);
    return fresh_u64(&mut v, h);
  }
  // free, print, bfree, host_eprint, child_close, cpu_fpu_save and cpu_fpu_load (the
  // page's contents are not tracked), sys_yield, sys_ps, sys_poweroff
  return v.unit;
}

/// The type of kind `k` (a builtin type without arguments). Never new:
/// the checker has interned every builtin type already.
fn kind_ty(m: &Mono, p: &Parser, k: u64) -> u64 {
  let mut t = 1;
  while t < vec_len(m.tys) {
    let x = vec_get(m.tys, t);
    if x.kind == k {
      return t;
    }
    t = t + 1;
  }
  return 0;
}

/// pt_put, pt_take, pt_put_frame and pt_take_frame.
fn pt_slot(v: &mut Vr, c: &Checker, m: &Mono, p: &Parser, i: u64, args: &Vec[u64], vals: &Vec[u64], st: &mut VState) -> u64 {
  let x0 = u_at(vals, 0);
  let ix = term(v, u_at(vals, 1));
  let lvl = g_level(v, x0);
  let used = g_used(v, x0);
  need_lt(&mut v, st, i, ix, 512);
  let leaf = name_is(p, i, "pt_put_frame") || name_is(p, i, "pt_take_frame");
  if leaf {
    let one = num(&mut v, 1);
    let g = app2(&mut v, OP_EQ, lvl, one);
    prove(&mut v, st, g, i, VC_PT);
  } else {
    let two = num(&mut v, 2);
    let g = app2(&mut v, OP_GE, lvl, two);
    prove(&mut v, st, g, i, VC_PT);
    // Slot 0 of a top-level table maps the kernel; slots 256.. are never used.
    let four = num(&mut v, 4);
    let top = app2(&mut v, OP_EQ, lvl, four);
    let one = num(&mut v, 1);
    let lim = num(&mut v, 256);
    let a = app2(&mut v, OP_LE, one, ix);
    let b = app2(&mut v, OP_LT, ix, lim);
    let r = app2(&mut v, OP_AND, a, b);
    let g2 = app2(&mut v, OP_IMP, top, r);
    prove(&mut v, st, g2, i, VC_PT);
  }
  let putting = name_is(p, i, "pt_put") || name_is(p, i, "pt_put_frame");
  if putting {
    let sel = app2(&mut v, OP_SELECT, used, ix);
    let g = t_not(&mut v, sel);
    prove(&mut v, st, g, i, VC_OWN);
    if !leaf {
      let one = num(&mut v, 1);
      let up = app2(&mut v, OP_ADD, g_level(v, u_at(vals, 2)), one);
      let g2 = app2(&mut v, OP_EQ, up, lvl);
      prove(&mut v, st, g2, i, VC_PT);
    }
  } else {
    let g = app2(&mut v, OP_SELECT, used, ix);
    prove(&mut v, st, g, i, VC_OWN);
    // Taking unmaps: another processor running on the tree could still
    // reach what is taken, through its TLB or a walk under way. Putting
    // only adds.
    let g2 = app2(&mut v, OP_EQ, g_leases(v, x0), v.t_zero);
    prove(&mut v, st, g2, i, VC_LEASE);
  }
  let mut mark_t = v.t_false;
  if putting {
    mark_t = v.t_true;
  }
  let nu = app3(&mut v, OP_STORE, used, ix, mark_t);
  let nt = mk_pt(&mut v, v.ty_pt, g_id(v, x0), lvl, nu, g_leases(v, x0));
  put_back(&mut v, m, p, &mut st, u_at(args, 0), nt);
  if name_is(p, i, "pt_take") {
    let r = fresh_of_named(&mut v, c, m, p, v.ty_pt, "pt_take");
    let rv = vl_at(v, r);
    let one = num(&mut v, 1);
    let below = app2(&mut v, OP_SUB, lvl, one);
    return mk_pt(&mut v, v.ty_pt, rv.a, below, rv.c, v.t_zero);
  }
  if name_is(p, i, "pt_take_frame") {
    return fresh_of_named(&mut v, c, m, p, v.ty_frame, "pt_take_frame");
  }
  return v.unit;
}

// ---- Statements ----

/// Executes a list of statements from state `st`.
fn vblock(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, head: u64, st: VState, fdef: u64, entry: &Vec[Bind]) -> VState {
  let mut s = st;
  let mut k = head;
  while k != 0 {
    s = vstmt(&mut v, c, &mut m, p, k, s, fdef, entry);
    if !s.live {
      return s;
    }
    k = next_of(p, k);
  }
  return s;
}

fn vstmt(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: VState, fdef: u64, entry: &Vec[Bind]) -> VState {
  let n = node_at(p.nodes, i);
  let k = n.kind;
  let mut s = st;
  if k == S_LET {
    let x = eval(&mut v, c, &mut m, p, n.b, &mut s, 0);
    env_put(&mut s.env, p, n.s, n.e, x);
    return s;
  }
  if k == S_ASSIGN {
    let x = eval(&mut v, c, &mut m, p, n.b, &mut s, 0);
    let path = list_text(&mut v, p, n.a);
    open_path(&mut v, c, m, p, &mut s.env, path);
    set_path(&mut v, m, p, &mut s.env, path, x);
    return s;
  }
  if k == S_EXPR {
    eval(&mut v, c, &mut m, p, n.a, &mut s, 0);
    return s;
  }
  if k == S_ASSERT {
    let t = here(&mut v, c, &mut m, p, n.a, s);
    prove(&mut v, s, t, i, VC_ASSERT);
    vec_push(&mut s.pc, t);
    return s;
  }
  if k == S_UNREACHABLE {
    prove(&mut v, s, v.t_false, i, VC_UNREACHABLE);
    st_free(s);
    return st_dead();
  }
  if k == S_RETURN {
    let mut x = v.unit;
    if n.a != 0 {
      x = eval(&mut v, c, &mut m, p, n.a, &mut s, 0);
    }
    check_ensures(&mut v, c, &mut m, p, s, fdef, entry, x, i);
    st_free(s);
    return st_dead();
  }
  if k == S_IF {
    return stmt_if(&mut v, c, &mut m, p, i, s, fdef, entry);
  }
  if k == S_MATCH {
    return stmt_match(&mut v, c, &mut m, p, i, s, fdef, entry);
  }
  if k == S_WHILE {
    return stmt_while(&mut v, c, &mut m, p, i, s, fdef, entry);
  }
  return s;
}

fn stmt_if(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: VState, fdef: u64, entry: &Vec[Bind]) -> VState {
  let n = node_at(p.nodes, i);
  let mut s = st;
  let cv = eval(&mut v, c, &mut m, p, n.a, &mut s, 0);
  let ct = term(v, cv);
  let mut ts = st_clone(s);
  vec_push(&mut ts.pc, ct);
  let mut es = st_clone(s);
  let nc = t_not(&mut v, ct);
  vec_push(&mut es.pc, nc);
  let t_out = vblock(&mut v, c, &mut m, p, n.b, ts, fdef, entry);
  let e_out = vblock(&mut v, c, &mut m, p, n.c, es, fdef, entry);
  if !t_out.live {
    st_free(t_out);
    st_free(s);
    return e_out;
  }
  if !e_out.live {
    st_free(e_out);
    st_free(s);
    return t_out;
  }
  let mut env = vec_new[Bind]();
  let mut k = 0;
  while k < vec_len(s.env) {
    let b = bind_at(s.env, k);
    let tb = bind_at(t_out.env, k);
    let eb = bind_at(e_out.env, k);
    let x = merge(&mut v, ct, tb.val, eb.val);
    vec_push(&mut env, Bind { s: b.s, e: b.e, val: x });
    k = k + 1;
  }
  // Facts learned inside either arm are kept as implications.
  let mut pc = copy_set(s.pc);
  let from = vadd(vec_len(s.pc), 1);
  let xt = tail(t_out.pc, from);
  let xe = tail(e_out.pc, from);
  if vec_len(xt) > 0 {
    let all = and_all(&mut v, xt);
    let imp = app2(&mut v, OP_IMP, ct, all);
    vec_push(&mut pc, imp);
  }
  if vec_len(xe) > 0 {
    let all = and_all(&mut v, xe);
    let nc2 = t_not(&mut v, ct);
    let imp = app2(&mut v, OP_IMP, nc2, all);
    vec_push(&mut pc, imp);
  }
  vec_free(xt);
  vec_free(xe);
  st_free(t_out);
  st_free(e_out);
  st_free(s);
  return VState { pc: pc, env: env, live: true };
}

fn stmt_match(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: VState, fdef: u64, entry: &Vec[Bind]) -> VState {
  let n = node_at(p.nodes, i);
  let mut s = st;
  let sv = eval(&mut v, c, &mut m, p, n.a, &mut s, 0);
  let x = vl_at(v, sv);
  let nb = vec_len(s.env);
  let from = vadd(vec_len(s.pc), 1);
  let mut covered = vec_new[u64]();
  // The arms that fall through: their conditions, the facts they learned
  // (0 for none) and the values of the variables in scope at the match.
  let mut conds = vec_new[u64]();
  let mut extras = vec_new[u64]();
  let mut outv = vec_new[u64]();
  let mut keep = st_dead();
  let mut narms = 0;
  let mut a = n.b;
  while a != 0 && narms < SRC_MAX {
    let an = node_at(p.nodes, a);
    narms = narms + 1;
    let mut ast = st_clone(s);
    let mut cond = 0;
    if an.v == PAT_WILD {
      let any = or_all(&mut v, covered);
      cond = t_not(&mut v, any);
    } else {
      let j = variant_index(m, p, x.ty, an.s2, an.e2);
      let mut kx = 0;
      if j > 0 {
        kx = j - 1;
      }
      let tk = num(&mut v, kx);
      let cv = app2(&mut v, OP_EQ, x.a, tk);
      vec_push(&mut covered, cv);
      if (an.v == PAT_BIND || an.v == PAT_BIND_MUT) && !name_is(p, an.a, "_") {
        let bn = node_at(p.nodes, an.a);
        env_put(&mut ast.env, p, bn.s, bn.e, kid(v, sv, kx));
      }
      let tk2 = num(&mut v, kx);
      cond = app2(&mut v, OP_EQ, x.a, tk2);
    }
    vec_push(&mut ast.pc, cond);
    let out = vblock(&mut v, c, &mut m, p, an.c, ast, fdef, entry);
    if out.live {
      vec_push(&mut conds, cond);
      let xt = tail(out.pc, from);
      let mut ex = 0;
      if vec_len(xt) > 0 {
        ex = and_all(&mut v, xt);
      }
      vec_free(xt);
      vec_push(&mut extras, ex);
      let mut k = 0;
      while k < nb {
        let ob = bind_at(out.env, k);
        vec_push(&mut outv, ob.val);
        k = k + 1;
      }
      if vec_len(conds) == 1 {
        st_free(keep);
        keep = out;
      } else {
        st_free(out);
      }
    } else {
      st_free(out);
    }
    a = an.next;
  }
  let nouts = vec_len(conds);
  if nouts <= 1 {
    vec_free(covered);
    vec_free(conds);
    vec_free(extras);
    vec_free(outv);
    st_free(s);
    return keep;
  }
  st_free(keep);
  // Arms are disjoint, so the merged value is a chain of ites ending in
  // the last arm that falls through.
  let mut env = vec_new[Bind]();
  let mut k = 0;
  while k < nb {
    let b = bind_at(s.env, k);
    let mut y = u_at(outv, vadd(mul_sat(nouts - 1, nb), k));
    let mut j = nouts - 1;
    while j > 0 {
      j = j - 1;
      let yo = u_at(outv, vadd(mul_sat(j, nb), k));
      y = merge(&mut v, u_at(conds, j), yo, y);
    }
    vec_push(&mut env, Bind { s: b.s, e: b.e, val: y });
    k = k + 1;
  }
  let mut pc = copy_set(s.pc);
  if nouts < narms {
    let any = or_all(&mut v, conds);
    vec_push(&mut pc, any);
  }
  let mut j = 0;
  while j < nouts {
    let ex = u_at(extras, j);
    if ex != 0 {
      let imp = app2(&mut v, OP_IMP, u_at(conds, j), ex);
      vec_push(&mut pc, imp);
    }
    j = j + 1;
  }
  vec_free(covered);
  vec_free(conds);
  vec_free(extras);
  vec_free(outv);
  st_free(s);
  return VState { pc: pc, env: env, live: true };
}

/// `a * b`, or the largest u64 if that overflows.
fn mul_sat(a: u64, b: u64) -> u64 {
  if a != 0 && b > U64_MAX / a {
    return U64_MAX;
  }
  return a * b;
}

fn stmt_while(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, st: VState, fdef: u64, entry: &Vec[Bind]) -> VState {
  let n = node_at(p.nodes, i);
  let s = st;
  // 1. the invariants hold on entry
  let mut inv = n.b;
  while inv != 0 {
    let t = here_inv(&mut v, c, &mut m, p, inv, s, entry);
    prove(&mut v, s, t, inv, VC_INVARIANT);
    inv = next_of(p, inv);
  }
  // 2. havoc what the body (or the condition) changes, enclosing places
  // first, so a field's own havoc lands inside its struct's
  let mut changed = vec_new[Chg]();
  changed_vars(&mut v, c, &mut m, p, n.c, &mut changed);
  changed_in_expr(&mut v, c, &mut m, p, n.a, &mut changed);
  sort_changed(v, &mut changed);
  let mut l = st_clone(s);
  let mut k = 0;
  while k < vec_len(changed) {
    let ch = chg_at(changed, k);
    let pt = tm_at(v, ch.name);
    let root = seg_end(v, ch.name, 0);
    if env_find_rng(s.env, v, p, pt.a, root) != 0 {
      open_path(&mut v, c, m, p, &mut l.env, ch.name);
      let prev = get_path(v, m, p, l.env, ch.name);
      let nv = havoc(&mut v, c, m, p, prev, ch.keep, ch.name);
      set_path(&mut v, m, p, &mut l.env, ch.name, nv);
    }
    k = k + 1;
  }
  vec_free(changed);
  inv = n.b;
  while inv != 0 {
    let t = here_inv(&mut v, c, &mut m, p, inv, l, entry);
    vec_push(&mut l.pc, t);
    inv = next_of(p, inv);
  }
  // 3. one arbitrary iteration preserves the invariants
  let cv = eval(&mut v, c, &mut m, p, n.a, &mut l, 0);
  let ct = term(v, cv);
  let mut bst = st_clone(l);
  vec_push(&mut bst.pc, ct);
  let end = vblock(&mut v, c, &mut m, p, n.c, bst, fdef, entry);
  if end.live {
    inv = n.b;
    while inv != 0 {
      let t = here_inv(&mut v, c, &mut m, p, inv, end, entry);
      prove(&mut v, end, t, inv, VC_INVARIANT);
      inv = next_of(p, inv);
    }
  }
  st_free(end);
  // 4. after the loop: the invariants and the negated condition
  let nc = t_not(&mut v, ct);
  vec_push(&mut l.pc, nc);
  st_free(s);
  return l;
}

fn chg_at(xs: &Vec[Chg], k: u64) -> Chg {
  if k < vec_len(xs) {
    return vec_get(xs, k);
  }
  return Chg { name: 0, keep: false };
}

/// Records that the loop changes place `name`; `keep` says this change
/// keeps its shape.
fn chg_add(v: &Vr, out: &mut Vec[Chg], name: u64, keep: bool) {
  let mut k = 0;
  while k < vec_len(out) {
    let ch = chg_at(out, k);
    if same_text(v, ch.name, name) {
      vec_set(&mut out, k, Chg { name: ch.name, keep: ch.keep && keep });
      return;
    }
    k = k + 1;
  }
  vec_push(&mut out, Chg { name: name, keep: keep });
}

fn dots(v: &Vr, a: u64) -> u64 {
  let t = tm_at(v, a);
  let mut n = 0;
  let mut k = 0;
  while k < t.b
    invariant n <= k
  {
    if pool_at(v, vadd(t.a, k)) == 46 {
      n = n + 1;
    }
    k = k + 1;
  }
  return n;
}

/// Is `a` before `b`: fewer dots, then by text?
fn chg_less(v: &Vr, a: u64, b: u64) -> bool {
  let da = dots(v, a);
  let db = dots(v, b);
  if da != db {
    return da < db;
  }
  return text_less(v, a, b);
}

fn sort_changed(v: &Vr, xs: &mut Vec[Chg]) {
  let mut k = 1;
  while k < vec_len(xs) {
    let mut j = k;
    while j > 0 && j < vec_len(xs) {
      let x = chg_at(xs, j - 1);
      let y = chg_at(xs, j);
      if !chg_less(v, y.name, x.name) {
        j = 0;
      } else {
        vec_set(&mut xs, j - 1, y);
        vec_set(&mut xs, j, x);
        j = j - 1;
      }
    }
    k = k + 1;
  }
}

/// The places a loop body (or a function body) may change, with a flag that
/// is true when every change keeps the value's shape: `x = set(x, ..)` keeps
/// a Buf's length, the builtins in `shape_keeping` keep an object's id, level
/// and size, and a user function changes what its summary says. Calls are
/// resolved in instance `v.env`.
fn changed_vars(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, head: u64, out: &mut Vec[Chg]) {
  let mut i = head;
  while i != 0 {
    let n = node_at(p.nodes, i);
    let k = n.kind;
    if k == S_ASSIGN {
      let name = list_text(&mut v, p, n.a);
      let val = node_at(p.nodes, n.b);
      let mut only_set = false;
      if val.kind == E_CALL && name_is(p, n.b, "set") && val.a != 0 {
        let a0 = place_text(&mut v, p, val.a);
        only_set = a0 != 0 && same_text(v, a0, name);
      }
      chg_add(v, &mut out, name, only_set);
      changed_in_expr(&mut v, c, &mut m, p, n.b, &mut out);
    } else if k == S_LET || k == S_EXPR || k == S_RETURN {
      let e = n.a;
      if k == S_LET {
        changed_in_expr(&mut v, c, &mut m, p, n.b, &mut out);
      } else if e != 0 {
        changed_in_expr(&mut v, c, &mut m, p, e, &mut out);
      }
    } else if k == S_IF {
      changed_in_expr(&mut v, c, &mut m, p, n.a, &mut out);
      changed_vars(&mut v, c, &mut m, p, n.b, &mut out);
      changed_vars(&mut v, c, &mut m, p, n.c, &mut out);
    } else if k == S_WHILE {
      changed_in_expr(&mut v, c, &mut m, p, n.a, &mut out);
      changed_vars(&mut v, c, &mut m, p, n.c, &mut out);
    } else if k == S_MATCH {
      changed_in_expr(&mut v, c, &mut m, p, n.a, &mut out);
      let mut a = n.b;
      while a != 0 {
        let an = node_at(p.nodes, a);
        changed_vars(&mut v, c, &mut m, p, an.c, &mut out);
        a = an.next;
      }
    }
    i = n.next;
  }
}

/// Builtins whose `&mut` argument keeps the ghost fields above.
fn shape_keeping(p: &Parser, i: u64) -> bool {
  return name_is(p, i, "bset") || name_is(p, i, "vec_set") || name_is(p, i, "vec_swap") || name_is(p, i, "pt_put")
    || name_is(p, i, "pt_take") || name_is(p, i, "pt_put_frame") || name_is(p, i, "pt_take_frame")
    || name_is(p, i, "pt_borrow") || name_is(p, i, "pt_borrow_frame") || name_is(p, i, "pt_lease_count") || name_is(p, i, "pool_take") || name_is(p, i, "pool_give") || name_is(p, i, "frame_write")
    || name_is(p, i, "frame_write8") || name_is(p, i, "bcopy") || name_is(p, i, "bmove") || name_is(p, i, "frame_to_bytes")
    || name_is(p, i, "bytes_to_frame") || name_is(p, i, "dma_to_bytes") || name_is(p, i, "bytes_to_dma") || name_is(p, i, "cpu_set") || name_is(p, i, "cpu_run") || name_is(p, i, "cpu_idle")
    || name_is(p, i, "cpu_fpu_save") || name_is(p, i, "cpu_fpu_load") || name_is(p, i, "pio_in8") || name_is(p, i, "pio_in16")
    || name_is(p, i, "pio_in32") || name_is(p, i, "pio_out8") || name_is(p, i, "pio_out16") || name_is(p, i, "pio_out32")
    || name_is(p, i, "mmio_read8") || name_is(p, i, "mmio_read16") || name_is(p, i, "mmio_read32") || name_is(p, i, "mmio_read64")
    || name_is(p, i, "mmio_write8") || name_is(p, i, "mmio_write16") || name_is(p, i, "mmio_write32") || name_is(p, i, "mmio_write64")
    || name_is(p, i, "dma_read8") || name_is(p, i, "dma_read16") || name_is(p, i, "dma_read32") || name_is(p, i, "dma_read64")
    || name_is(p, i, "dma_write8") || name_is(p, i, "dma_write16") || name_is(p, i, "dma_write32") || name_is(p, i, "dma_write64");
}

/// Places deeper than this many parts are summarized by their prefix of
/// this depth, marked as changed in any way. Recursion through boxes could
/// otherwise grow paths forever.
const SUMMARY_DEPTH: u64 = 8;

/// Records that `path` may change (`keep`: only in shape-keeping ways).
fn note(v: &mut Vr, out: &mut Vec[Chg], path: u64, keep: bool) {
  if dots(v, path) < SUMMARY_DEPTH {
    chg_add(v, &mut out, path, keep);
    return;
  }
  let t = tm_at(v, path);
  let mut seen = 0;
  let mut k = 0;
  while k < t.b && seen < SUMMARY_DEPTH {
    if pool_at(v, vadd(t.a, k)) == 46 {
      seen = seen + 1;
    }
    k = k + 1;
  }
  // k is just past the SUMMARY_DEPTH-th dot.
  let mut cut = k;
  if cut > 0 {
    cut = cut - 1;
  }
  let short = prefix(&mut v, path, cut);
  chg_add(v, &mut out, short, false);
}

/// The places lent as `&mut` anywhere in `i`, and what the callee may
/// change under them.
fn changed_in_expr(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, out: &mut Vec[Chg]) {
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_CALL {
    call_changes(&mut v, c, &mut m, p, i, 0, &mut out);
  } else if k == E_TAPP {
    // A call of a generic function (stage0 has made it a plain call by now).
    if !is_typed_builtin(p, n.b) {
      let x = tapp_inst(&mut m, p, i, v.env);
      call_changes(&mut v, c, &mut m, p, n.b, x, &mut out);
    }
  } else if k == E_NOT || k == E_NEG || k == E_IS || (k == E_VARIANT && n.a != 0) {
    changed_in_expr(&mut v, c, &mut m, p, n.a, &mut out);
  } else if k == E_BIN {
    changed_in_expr(&mut v, c, &mut m, p, n.a, &mut out);
    changed_in_expr(&mut v, c, &mut m, p, n.b, &mut out);
  } else if k == E_SLIT {
    let mut f = n.a;
    while f != 0 {
      let fi = node_at(p.nodes, f);
      changed_in_expr(&mut v, c, &mut m, p, fi.a, &mut out);
      f = fi.next;
    }
  }
}

/// `changed_in_expr` for call `i` (of instance `inst`, 0 for a plain call).
fn call_changes(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, i: u64, inst: u64, out: &mut Vec[Chg]) {
  let n = node_at(p.nodes, i);
  // `locked(l, f, ..)` and `smp_run(f, ..)` lend their trailing arguments
  // to `f`: shift them onto its parameters.
  // (`j` counts parameters of the function that receives the arguments.)
  let mut fnode = i;
  let mut skip = 0;
  let mut j = 0;
  if inst == 0 && name_is(p, i, "locked") && n.a != 0 && kind_of(p, next_of(p, n.a)) == E_VAR {
    fnode = next_of(p, n.a);
    skip = 2;
    j = 1;
  } else if inst == 0 && name_is(p, i, "smp_run") && kind_of(p, n.a) == E_VAR {
    fnode = n.a;
    skip = 1;
  } else if inst == 0 && (name_is(p, i, "pt_borrow") || name_is(p, i, "pt_borrow_frame")) && n.a != 0
    && kind_of(p, n.a) == E_MUTBORROW && next_of(p, n.a) != 0 && kind_of(p, next_of(p, next_of(p, n.a))) == E_VAR {
    // `pt_borrow(t, i, f, ..)` keeps `t` and lends the rest to `f`.
    let tn = node_at(p.nodes, n.a);
    let tname = list_text(&mut v, p, tn.a);
    note(&mut v, &mut out, tname, true);
    changed_in_expr(&mut v, c, &mut m, p, next_of(p, n.a), &mut out);
    fnode = next_of(p, next_of(p, n.a));
    skip = 3;
    j = 1;
  }
  let fname = node_at(p.nodes, fnode);
  let bi = inst == 0 && is_builtin_name(c, p, fname.s, fname.e);
  let keep = bi && shape_keeping(p, fnode);
  let mut x = inst;
  if !bi && x == 0 {
    let d = plain_fn(p, fname.s, fname.e);
    if d != 0 {
      x = plain_inst(&mut m, d);
    }
  }
  let mut a = n.a;
  while skip > 0 && a != 0 {
    a = next_of(p, a);
    skip = skip - 1;
  }
  while a != 0 && j < SRC_MAX {
    let an = node_at(p.nodes, a);
    if an.kind == E_MUTBORROW {
      let name = list_text(&mut v, p, an.a);
      if bi {
        note(&mut v, &mut out, name, keep);
      } else if !apply_summary(&mut v, x, j, name, &mut out) {
        note(&mut v, &mut out, name, false);
      }
    } else {
      changed_in_expr(&mut v, c, &mut m, p, a, &mut out);
    }
    a = an.next;
    j = j + 1;
  }
}

/// The length of atom `a`'s text.
fn tm_len(v: &Vr, a: u64) -> u64 {
  let t = tm_at(v, a);
  return t.b;
}

fn row_param(v: &Vr, k: u64) -> u64 {
  let r = sum_row(v, k);
  return r.j;
}

fn sum_row(v: &Vr, k: u64) -> SumRow {
  if k < vec_len(v.sums) {
    return vec_get(v.sums, k);
  }
  return SumRow { x: 0, j: 0, rel: 0, keep: false };
}

/// Notes what instance `x`'s summary for parameter `j` says may change
/// under place `name`. False if it has none.
fn apply_summary(v: &mut Vr, x: u64, j: u64, name: u64, out: &mut Vec[Chg]) -> bool {
  let start = u_at(v.sum_start, x);
  let end = vadd(start, u_at(v.sum_n, x));
  let mut found = false;
  let mut k = start;
  while k < end {
    let r = sum_row(v, k);
    if r.j == j {
      found = true;
      let path = cat_text(&mut v, name, r.rel);
      note(&mut v, &mut out, path, r.keep);
    }
    k = k + 1;
  }
  return found;
}

/// The text of `a` followed by the text of `b`.
fn cat_text(v: &mut Vr, a: u64, b: u64) -> u64 {
  let start = vec_len(v.pool);
  push_text(&mut v, a);
  push_text(&mut v, b);
  return seal(&mut v, start);
}

/// Computes every function's summaries from its body: what `changed_vars`
/// finds under each `&mut` parameter, where lending a place to another
/// user function counts as that function's summary applied to the place.
///
/// This is a greatest fixed point: it starts from "every parameter keeps
/// its shape" and weakens summaries until none changes. Sound for recursion
/// too: a change that is not shape-keeping happens at some assignment or
/// builtin call, which is recorded there and then propagates to every
/// caller. (Each round reads the previous round's summaries; summaries only
/// ever weaken, so this reaches the same fixed point as stage0's in-place
/// updates.)
fn summarize(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser) {
  let empty = atom_str(&mut v, "");
  let mut rows = vec_new[SumRow]();
  let mut starts = vec_new[u64]();
  let mut ns = vec_new[u64]();
  sum_round(&mut v, c, &mut m, p, empty, false, &mut rows, &mut starts, &mut ns);
  let mut more = true;
  while more {
    vec_free(v.sums);
    vec_free(v.sum_start);
    vec_free(v.sum_n);
    v.sums = rows;
    v.sum_start = starts;
    v.sum_n = ns;
    rows = vec_new[SumRow]();
    starts = vec_new[u64]();
    ns = vec_new[u64]();
    sum_round(&mut v, c, &mut m, p, empty, true, &mut rows, &mut starts, &mut ns);
    more = !same_rows(v, rows);
  }
  vec_free(rows);
  vec_free(starts);
  vec_free(ns);
}

/// One round of `summarize`, into `rows`. Without `scan`, every `&mut`
/// parameter gets the starting summary ("keeps its shape").
fn sum_round(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, empty: u64, scan: bool,
             rows: &mut Vec[SumRow], starts: &mut Vec[u64], ns: &mut Vec[u64]) {
  while vec_len(starts) < vec_len(m.insts) {
    vec_push(&mut starts, 0);
    vec_push(&mut ns, 0);
  }
  let mut k = 0;
  while k < vec_len(m.fns) {
    let x = u_at(m.fns, k);
    let xi = inst_at(m, x);
    let d = node_at(p.nodes, xi.def);
    let mut out = vec_new[Chg]();
    if scan {
      v.env = x;
      changed_vars(&mut v, c, &mut m, p, d.x, &mut out);
    }
    let start = vec_len(rows);
    let mut cnt = 0;
    let mut q = d.a;
    let mut j = 0;
    while q != 0 && j < SRC_MAX {
      let qn = node_at(p.nodes, q);
      let pt = conv(&mut m, p, qn.a, x, q);
      if kind_t(m, pt) == TY_MUTREF {
        let mut s = vec_new[Chg]();
        vec_push(&mut s, Chg { name: empty, keep: true });
        let mut o = 0;
        while o < vec_len(out) {
          let ch = chg_at(out, o);
          let t = tm_at(v, ch.name);
          let root = seg_end(v, ch.name, 0);
          if root <= t.b && rng_is_src(v, t.a, root, p, qn.s, qn.e) {
            let rel = new_tm(&mut v, VT_ATOM, vadd(t.a, root), t.b - root, 0);
            chg_add(v, &mut s, rel, ch.keep);
          }
          o = o + 1;
        }
        sort_changed(v, &mut s);
        o = 0;
        while o < vec_len(s) {
          let ch = chg_at(s, o);
          vec_push(&mut rows, SumRow { x: x, j: j, rel: ch.name, keep: ch.keep });
          cnt = vadd(cnt, 1);
          o = o + 1;
        }
        vec_free(s);
      }
      q = qn.next;
      j = j + 1;
    }
    vec_free(out);
    if x < vec_len(starts) && x < vec_len(ns) {
      vec_set(&mut starts, x, start);
      vec_set(&mut ns, x, cnt);
    }
    k = k + 1;
  }
}

/// Are `rows` the summaries already in `v`?
fn same_rows(v: &Vr, rows: &Vec[SumRow]) -> bool {
  if vec_len(rows) != vec_len(v.sums) {
    return false;
  }
  let mut k = 0;
  while k < vec_len(rows) {
    let a = vec_get(rows, k);
    let b = sum_row(v, k);
    if a.x != b.x || a.j != b.j || a.keep != b.keep || !same_text(v, a.rel, b.rel) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

// ---- Functions ----

/// Proves the postconditions of function `fdef` at a return in state `st`.
/// Parameters mean their entry values, except `&mut` ones, which mean the
/// value handed back; `old(..)` reads the entry values.
fn check_ensures(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, st: &VState, fdef: u64, entry: &Vec[Bind], res: u64, loc: u64) {
  let d = node_at(p.nodes, fdef);
  let mut post = env_clone(entry);
  let mut q = d.a;
  while q != 0 {
    let qn = node_at(p.nodes, q);
    let pt = conv(&mut m, p, qn.a, v.env, q);
    if kind_t(m, pt) == TY_MUTREF {
      env_put(&mut post, p, qn.s, qn.e, env_find(st.env, p, qn.s, qn.e));
    }
    q = qn.next;
  }
  let mut b = vec_new[Bnd]();
  let mut e = d.d;
  while e != 0 {
    let t = spec_tm(&mut v, c, &mut m, p, e, post, entry, true, res, &mut b);
    prove(&mut v, st, t, loc, VC_ENSURES);
    e = next_of(p, e);
  }
  vec_free(b);
  vec_free(post);
}

fn verify_fn(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  let d = node_at(p.nodes, xi.def);
  v.env = x;
  v.counts = has_u(v.cnt_fns, xi.def);
  if v.counts {
    count_lemmas(&mut v);
  }
  let mut env = vec_new[Bind]();
  let mut q = d.a;
  while q != 0 {
    let qn = node_at(p.nodes, q);
    let pt = conv(&mut m, p, qn.a, x, q);
    let h = atom_src(&mut v, p, qn.s, qn.e);
    let y = fresh_of(&mut v, c, m, p, pt, h);
    env_put(&mut env, p, qn.s, qn.e, y);
    q = qn.next;
  }
  let mut st = VState { pc: vec_new[u64](), env: env_clone(env), live: true };
  if name_is(p, xi.def, "main") {
    // What the runtime hands to `main`: a full pool and the kernel's own
    // tables in CR3.
    q = d.a;
    while q != 0 {
      let qn = node_at(p.nodes, q);
      let bk = kind_t(m, base_t(m, conv(&mut m, p, qn.a, x, q)));
      let y = env_find(env, p, qn.s, qn.e);
      if bk == TY_POOL {
        let sel = app2(&mut v, OP_SELECT, g_has(v, y), v.t_k);
        let a = app2(&mut v, OP_LE, v.t_zero, v.t_k);
        let b = app2(&mut v, OP_LT, v.t_k, g_size(v, y));
        let r = app2(&mut v, OP_AND, a, b);
        let eq = app2(&mut v, OP_EQ, sel, r);
        let all = forall_tm(&mut v, v.t_k, eq);
        vec_push(&mut st.pc, all);
      } else if bk == TY_MMU {
        let eq = app2(&mut v, OP_EQ, g_root(v, y), v.t_flimit);
        vec_push(&mut st.pc, eq);
      } else if bk == TY_PORTS || bk == TY_MMIOSPACE {
        let sel = app2(&mut v, OP_SELECT, g_free(v, y), v.t_k);
        let mut r = all_ports(&mut v);
        if bk == TY_MMIOSPACE {
          let a = app2(&mut v, OP_LE, v.t_mmio_lo, v.t_k);
          let b = app2(&mut v, OP_LT, v.t_k, v.t_mmio_hi);
          r = app2(&mut v, OP_AND, a, b);
        }
        let eq = app2(&mut v, OP_EQ, sel, r);
        let all = forall_tm(&mut v, v.t_k, eq);
        vec_push(&mut st.pc, all);
      }
      q = qn.next;
    }
  }
  let mut b = vec_new[Bnd]();
  let mut r = d.c;
  while r != 0 {
    let t = spec_tm(&mut v, c, &mut m, p, r, env, env, false, 0, &mut b);
    vec_push(&mut st.pc, t);
    r = next_of(p, r);
  }
  vec_free(b);
  let end = vblock(&mut v, c, &mut m, p, d.x, st, xi.def, env);
  if end.live {
    // Only unit functions can fall through (checked earlier).
    check_ensures(&mut v, c, &mut m, p, end, xi.def, env, v.unit, xi.def);
  }
  st_free(end);
  vec_free(env);
}

/// Verifies every function of the program monomorphized into `m` and
/// checked by `c`.
/// A `&mut Bytes` that C lends to an `export fn` is the caller's memory:
/// the function may write its bytes but must hand back the same buffer,
/// never free or replace it. Its summary shows that: every place under the
/// parameter is changed only in shape-keeping ways. A parameter that is not
/// kept is recorded as a failure (CMD_FAIL) at this point of the log, which
/// is where stage0 reports it.
fn buffers_kept(v: &mut Vr, m: &mut Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  let d = node_at(p.nodes, xi.def);
  let mut q = d.a;
  let mut j = 0;
  let mut done = false;
  while q != 0 && j < SRC_MAX && !done {
    let qn = node_at(p.nodes, q);
    let pt = conv(&mut m, p, qn.a, x, q);
    if kind_t(m, pt) == TY_MUTREF && kind_t(m, inner_t(m, pt)) == TY_BYTES {
      let start = u_at(v.sum_start, x);
      let end = vadd(start, u_at(v.sum_n, x));
      let mut any = false;
      let mut all = true;
      let mut k = start;
      while k < end {
        let r = sum_row(v, k);
        if r.j == j {
          any = true;
          all = all && r.keep;
        }
        k = k + 1;
      }
      if !(any && all) {
        vec_push(&mut v.obls, Obl { at: q, code: VC_EXPORT, x: x, env: 0, n: 0 });
        send(&mut v, CMD_FAIL, 0, 0);
        done = true;
      }
    }
    q = qn.next;
    j = j + 1;
  }
}

fn verify_program(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser) {
  summarize(&mut v, c, &mut m, p);
  count_gate(&mut v, m, p);
  send(&mut v, CMD_DECL, v.t_poolsize, SO_INT);
  let r = in_range(&mut v, v.t_zero, v.t_poolsize, v.t_flimit);
  assert_tm(&mut v, r);
  // Each function gets its own solver scope: what is declared and assumed
  // while verifying one (some of it quantified) must not burden the queries
  // for all later ones.
  let mut k = 0;
  while k < vec_len(m.fns) {
    let x = u_at(m.fns, k);
    if exported_x(m, p, x) {
      buffers_kept(&mut v, &mut m, p, x);
    }
    send(&mut v, CMD_PUSH, 0, 0);
    verify_fn(&mut v, c, &mut m, p, x);
    send(&mut v, CMD_POP, 0, 0);
    k = k + 1;
  }
}
