// A linker and writer of Linux executables (ELF64, x86-64, dynamically linked
// against the C library) for the assembly `asmobj.bastio` assembles, the
// counterpart of `pe.bastio`: the whole program is one object, so linking
// means giving each section an address, resolving every relocation against
// it, and turning the symbols the object does not define into imports from
// `libc.so.6`.
//
// The image is not position independent and has a fixed base. Each import
// gets one slot in a table that the dynamic loader fills in at start-up
// (`R_X86_64_GLOB_DAT`) and a six-byte `jmp *slot(%rip)` thunk in `.text`
// (a call through the PLT is a call to the thunk; `@GOTPCREL` is the slot).
//
// Part of the trusted base once the Linux build uses it instead of GNU as and
// the C compiler driver.
import "pe.bastio";

const ELF_BASE: u64 = 4194304;
const ELF_PAGE: u64 = 4096;
const ELF_NPHDR: u64 = 7;
const ELF_DYNSZ: u64 = 160;

/// The text of the program's entry point: the C library starts the program,
/// calls `main` and exits with its value.
fn elf_entry() -> Str {
  return "\t.text\n\t.globl _start\n_start:\n\txor %ebp, %ebp\n\tmov %rdx, %r9\n\tpop %rsi\n\tmov %rsp, %rdx\n\tand $-16, %rsp\n\tpush %rax\n\tpush %rsp\n\txor %r8d, %r8d\n\txor %ecx, %ecx\n\tlea main(%rip), %rdi\n\tcall __libc_start_main@PLT\n\tud2\n";
}

/// The AArch64 counterpart.
fn elf_entry_a64() -> Str {
  return "\t.text\n\t.globl _start\n_start:\n\tmov x29, #0\n\tmov x30, #0\n\tmov x5, x0\n\tldr x1, [sp]\n\tadd x2, sp, #8\n\tmov x6, sp\n\tmov x3, #0\n\tmov x4, #0\n\tadrp x0, main\n\tadd x0, x0, :lo12:main\n\tbl __libc_start_main\n\tbrk #1\n";
}

fn elf_phdr(out: &mut Vec[u64], kind: u64, flags: u64, off: u64, filesz: u64, memsz: u64, align: u64) {
  as_le(&mut out, kind, 4);
  as_le(&mut out, flags, 4);
  as_le(&mut out, off, 8);
  as_le(&mut out, wrap_add(ELF_BASE, off), 8);
  as_le(&mut out, wrap_add(ELF_BASE, off), 8);
  as_le(&mut out, filesz, 8);
  as_le(&mut out, memsz, 8);
  as_le(&mut out, align, 8);
}

/// Does the relocation `kind` ask for the address of an import's table slot?
fn elf_is_got(kind: u64, arm: bool) -> bool {
  if arm {
    return kind == 311 || kind == 312;
  }
  return kind == 3;
}

/// Does it ask for a call through the PLT (the import's thunk)?
fn elf_is_call(kind: u64, arm: bool) -> bool {
  if arm {
    return kind == 282 || kind == 283;
  }
  return kind == 2;
}

/// The signed distance `d` in units of four bytes, if it fits `bits` bits:
/// the field value masked to the width, or AS_NONE.
fn elf_a64_field(d: u64, bits: u64) -> u64 {
  if (d & 3) != 0 {
    return AS_NONE;
  }
  let mut q = d >> 2;
  if d >= 9223372036854775808 {
    q = wrap_sub(0, wrap_sub(0, d) >> 2);
  }
  if !as_fits(q, bits) || bits >= 64 {
    return AS_NONE;
  }
  return q & wrap_sub(1 << bits, 1);
}

/// Applies the AArch64 relocation `rtype` to the instruction at `at`: the
/// address it refers to is `sa` (symbol plus addend), the instruction is at
/// `p`. False when the value does not fit.
fn elf_a64_apply(buf: &mut Vec[u64], at: u64, rtype: u64, sa: u64, p: u64) -> bool {
  if wrap_add(at, 4) > vec_len(buf) {
    return false;
  }
  let mut w = 0;
  let mut k = 0;
  while k < 4 {
    w = w | a6_at(u_at(buf, wrap_add(at, k)), wrap_mul(k, 8));
    k = wrap_add(k, 1);
  }
  if rtype == 275 || rtype == 311 {
    let d = wrap_sub(sa >> 12, p >> 12);
    if !as_fits(d, 21) {
      return false;
    }
    w = w | a6_at(d & 3, 29) | a6_at((d >> 2) & 524287, 5);
  } else if rtype == 277 || rtype == 278 {
    w = w | a6_at(sa & 4095, 10);
  } else if rtype == 284 || rtype == 285 || rtype == 286 || rtype == 312 {
    let mut sh = 3;
    if rtype == 284 {
      sh = 1;
    } else if rtype == 285 {
      sh = 2;
    }
    if (sa & wrap_sub(1 << sh, 1)) != 0 {
      return false;
    }
    w = w | a6_at((sa & 4095) >> sh, 10);
  } else if rtype == 279 {
    let f = elf_a64_field(wrap_sub(sa, p), 14);
    if f == AS_NONE {
      return false;
    }
    w = w | a6_at(f, 5);
  } else if rtype == 280 {
    let f = elf_a64_field(wrap_sub(sa, p), 19);
    if f == AS_NONE {
      return false;
    }
    w = w | a6_at(f, 5);
  } else if rtype == 282 || rtype == 283 {
    let f = elf_a64_field(wrap_sub(sa, p), 26);
    if f == AS_NONE {
      return false;
    }
    w = w | f;
  } else {
    return false;
  }
  k = 0;
  while k < 4 {
    ao_set(&mut buf, wrap_add(at, k), (w >> wrap_mul(k, 8)) & 255);
    k = wrap_add(k, 1);
  }
  return true;
}

/// The 16-byte stub for import `k`: load its slot and jump.
fn elf_a64_stub(text: &mut Vec[u64], tstart: u64, k: u64, slot: u64, here: u64) {
  let d = wrap_sub(slot >> 12, here >> 12) & 2097151;
  as_le(&mut text, 2415919120 | a6_at(d & 3, 29) | a6_at(d >> 2, 5), 4);
  as_le(&mut text, 4181721617 | a6_at((slot & 4095) >> 3, 10), 4);
  as_le(&mut text, 3592356384, 4);
  as_le(&mut text, 3573751839, 4);
}

/// Links the assembled program `g` (laid out by `ao_layout`) into a Linux
/// executable; the bytes of the file, or an empty vector when something is
/// undefined that cannot be an import.
fn elf_link(g: &mut AsObj, arm: bool, musl: bool) -> Vec[u64] {
  let mut page = ELF_PAGE;
  let mut tsz = 8;
  let mut ilen = 28;
  // the string table starts with the C library's name: libc.so.6, or libc.so
  // for musl, whose loader takes any libc.so* as itself
  let mut cur0 = 11;
  if musl {
    ilen = 25;
    cur0 = 9;
  }
  if arm {
    page = 65536;
    tsz = 16;
    ilen = 27;
  }
  let mut rel = vec_new[u64]();
  let mut text = ao_emit(g, AB_TEXT, &mut rel);
  let mut ro = ao_emit(g, AB_RODATA, &mut rel);
  let mut data = ao_emit(g, AB_DATA, &mut rel);
  let bss0 = ao_sec_size(g, AB_BSS);
  // common symbols get their room at the end of .bss
  let nsym = ao_nsyms(g);
  let mut bss = pe_align(bss0, 16);
  let mut cs = 0;
  let mut comm = vec_new[u64]();
  while cs < nsym {
    if (ao_sym(g, cs, 4) & 2) != 0 {
      vec_push(&mut comm, cs);
      vec_push(&mut comm, bss);
      bss = pe_align(wrap_add(bss, ao_sym(g, cs, 5)), 16);
    }
    cs = wrap_add(cs, 1);
  }
  // the imports: the undefined symbols the relocations name
  let mut imports = vec_new[u64]();
  let mut r = 0;
  while wrap_add(r, 5) <= vec_len(rel) {
    let sym = u_at(rel, wrap_add(r, 3));
    if ao_sym(g, sym, 2) == AS_NONE && (ao_sym(g, sym, 4) & 2) == 0 && !has_id(imports, sym) {
      vec_push(&mut imports, sym);
    }
    r = wrap_add(r, 5);
  }
  let nimp = vec_len(imports);
  let nds = wrap_add(nimp, 1);
  // the read-only segment: headers, the dynamic section's tables, .rodata
  let interp = wrap_add(64, wrap_mul(ELF_NPHDR, 56));
  let hash = pe_align(wrap_add(interp, ilen), 8);
  let dynsym = pe_align(wrap_add(hash, wrap_mul(4, wrap_add(3, nds))), 8);
  let dynstr = wrap_add(dynsym, wrap_mul(24, nds));
  let mut name_off = vec_new[u64]();
  let mut cur = cur0;
  let mut k = 0;
  while k < nimp {
    vec_push(&mut name_off, cur);
    cur = wrap_add(wrap_add(cur, ao_sym(g, u_at(imports, k), 1)), 1);
    k = wrap_add(k, 1);
  }
  let dynstr_len = cur;
  let rela = pe_align(wrap_add(dynstr, dynstr_len), 8);
  let ro_off = pe_align(wrap_add(rela, wrap_mul(24, nimp)), 16);
  let r_end = wrap_add(ro_off, vec_len(ro));
  // .text, then a thunk of eight bytes for each import
  let text_off = pe_align(r_end, page);
  let tstart = pe_align(vec_len(text), 16);
  let ttotal = wrap_add(tstart, wrap_mul(nimp, tsz));
  // the writable segment: .data, the import slots, the dynamic section, .bss
  let data_off = pe_align(wrap_add(text_off, ttotal), page);
  let got_off = wrap_add(data_off, pe_align(vec_len(data), 8));
  let dyn_off = wrap_add(got_off, wrap_mul(nimp, 8));
  let dyn_end = wrap_add(dyn_off, ELF_DYNSZ);
  let bss_off = pe_align(dyn_end, 16);
  let bss_end = wrap_add(bss_off, bss);
  // the address of every symbol, for the relocations
  let mut bad = false;
  r = 0;
  while wrap_add(r, 5) <= vec_len(rel) {
    let sec = u_at(rel, r);
    let at = u_at(rel, wrap_add(r, 1));
    let kind = u_at(rel, wrap_add(r, 2));
    let sym = u_at(rel, wrap_add(r, 3));
    let addend = u_at(rel, wrap_add(r, 4));
    let mut target = 0;
    let ssec = ao_sym(g, sym, 2);
    if ssec == AS_NONE && (ao_sym(g, sym, 4) & 2) != 0 {
      // a common symbol
      let mut q = 0;
      while wrap_add(q, 2) <= vec_len(comm) {
        if u_at(comm, q) == sym {
          target = wrap_add(ELF_BASE, wrap_add(bss_off, u_at(comm, wrap_add(q, 1))));
        }
        q = wrap_add(q, 2);
      }
      if elf_is_got(kind, arm) {
        bad = true;
      }
    } else if ssec == AS_NONE {
      let mut q = 0;
      while q < nimp {
        if u_at(imports, q) == sym {
          if elf_is_got(kind, arm) {
            target = wrap_add(ELF_BASE, wrap_add(got_off, wrap_mul(q, 8)));
          } else if elf_is_call(kind, arm) {
            target = wrap_add(ELF_BASE, wrap_add(text_off, wrap_add(tstart, wrap_mul(q, tsz))));
          } else {
            bad = true;
          }
        }
        q = wrap_add(q, 1);
      }
    } else {
      let off = ao_sym_off(g, sym);
      if ssec == AB_TEXT {
        target = wrap_add(ELF_BASE, wrap_add(text_off, off));
      } else if ssec == AB_RODATA {
        target = wrap_add(ELF_BASE, wrap_add(ro_off, off));
      } else if ssec == AB_DATA {
        target = wrap_add(ELF_BASE, wrap_add(data_off, off));
      } else {
        target = wrap_add(ELF_BASE, wrap_add(bss_off, off));
      }
      if elf_is_got(kind, arm) {
        bad = true;
      }
    }
    let mut base = wrap_add(ELF_BASE, text_off);
    if sec == AB_RODATA {
      base = wrap_add(ELF_BASE, ro_off);
    } else if sec == AB_DATA {
      base = wrap_add(ELF_BASE, data_off);
    }
    let value = wrap_sub(wrap_add(target, addend), wrap_add(base, at));
    if arm {
      let sa = wrap_add(target, addend);
      let place = wrap_add(base, at);
      if sec == AB_TEXT {
        if !elf_a64_apply(&mut text, at, kind, sa, place) { bad = true; }
      } else if sec == AB_RODATA {
        if !elf_a64_apply(&mut ro, at, kind, sa, place) { bad = true; }
      } else if sec == AB_DATA {
        if !elf_a64_apply(&mut data, at, kind, sa, place) { bad = true; }
      } else {
        bad = true;
      }
    } else if sec == AB_TEXT {
      pe_patch(&mut text, at, value, 4);
    } else if sec == AB_RODATA {
      pe_patch(&mut ro, at, value, 4);
    } else if sec == AB_DATA {
      pe_patch(&mut data, at, value, 4);
    } else {
      bad = true;
    }
    if target == 0 {
      bad = true;
    }
    r = wrap_add(r, 5);
  }
  // the entry point
  let entry = pe_find(g, "_start");
  if entry == AS_NONE || ao_sym(g, entry, 2) != AB_TEXT {
    bad = true;
  }
  let mut out = vec_new[u64]();
  if bad {
    vec_free(text);
    vec_free(ro);
    vec_free(data);
    vec_free(rel);
    vec_free(imports);
    vec_free(comm);
    vec_free(name_off);
    return out;
  }
  // the thunks
  pe_pad_to(&mut text, tstart);
  k = 0;
  while k < nimp {
    let slot = wrap_add(ELF_BASE, wrap_add(got_off, wrap_mul(k, 8)));
    let here = wrap_add(ELF_BASE, wrap_add(text_off, wrap_add(tstart, wrap_mul(k, tsz))));
    if arm {
      // adrp x16, slot's page; ldr x17, [x16, slot's offset]; br x17; nop
      elf_a64_stub(&mut text, tstart, k, slot, here);
    } else {
      as_byte(&mut text, 255);
      as_byte(&mut text, 37);
      as_le(&mut text, wrap_sub(slot, wrap_add(here, 6)), 4);
      as_byte(&mut text, 204);
      as_byte(&mut text, 204);
    }
    k = wrap_add(k, 1);
  }
  // the ELF header
  as_byte(&mut out, 127);
  pe_put(&mut out, "ELF");
  as_byte(&mut out, 2);
  as_byte(&mut out, 1);
  as_byte(&mut out, 1);
  pe_pad_to(&mut out, 16);
  as_le(&mut out, 2, 2);
  if arm {
    as_le(&mut out, 183, 2);
  } else {
    as_le(&mut out, 62, 2);
  }
  as_le(&mut out, 1, 4);
  as_le(&mut out, wrap_add(ELF_BASE, wrap_add(text_off, ao_sym_off(g, entry))), 8);
  as_le(&mut out, 64, 8);
  as_le(&mut out, 0, 8);
  as_le(&mut out, 0, 4);
  as_le(&mut out, 64, 2);
  as_le(&mut out, 56, 2);
  as_le(&mut out, ELF_NPHDR, 2);
  as_le(&mut out, 64, 2);
  as_le(&mut out, 0, 2);
  as_le(&mut out, 0, 2);
  // the program headers
  elf_phdr(&mut out, 6, 4, 64, wrap_mul(ELF_NPHDR, 56), wrap_mul(ELF_NPHDR, 56), 8);
  elf_phdr(&mut out, 3, 4, interp, ilen, ilen, 1);
  elf_phdr(&mut out, 1, 4, 0, r_end, r_end, page);
  elf_phdr(&mut out, 1, 5, text_off, ttotal, ttotal, page);
  elf_phdr(&mut out, 1, 6, data_off, wrap_sub(dyn_end, data_off), wrap_sub(bss_end, data_off), page);
  elf_phdr(&mut out, 2, 6, dyn_off, ELF_DYNSZ, ELF_DYNSZ, 8);
  elf_phdr(&mut out, 1685382481, 6, 0, 0, 0, 16);
  // the interpreter
  if arm {
    pe_put(&mut out, "/lib/ld-linux-aarch64.so.1");
  } else if musl {
    pe_put(&mut out, "/lib/ld-musl-x86_64.so.1");
  } else {
    pe_put(&mut out, "/lib64/ld-linux-x86-64.so.2");
  }
  as_byte(&mut out, 0);
  // the hash table: one bucket, which is empty (nothing here is exported)
  pe_pad_to(&mut out, hash);
  as_le(&mut out, 1, 4);
  as_le(&mut out, nds, 4);
  as_le(&mut out, 0, 4);
  k = 0;
  while k < nds {
    as_le(&mut out, 0, 4);
    k = wrap_add(k, 1);
  }
  // the symbols: the null one, then the imports (global, undefined)
  pe_pad_to(&mut out, dynsym);
  as_le(&mut out, 0, 8);
  as_le(&mut out, 0, 8);
  as_le(&mut out, 0, 8);
  k = 0;
  while k < nimp {
    as_le(&mut out, u_at(name_off, k), 4);
    as_byte(&mut out, 16);
    as_byte(&mut out, 0);
    as_le(&mut out, 0, 2);
    as_le(&mut out, 0, 8);
    as_le(&mut out, 0, 8);
    k = wrap_add(k, 1);
  }
  // the strings: the library's name, then the imports'
  as_byte(&mut out, 0);
  if musl {
    pe_put(&mut out, "libc.so");
  } else {
    pe_put(&mut out, "libc.so.6");
  }
  as_byte(&mut out, 0);
  k = 0;
  while k < nimp {
    let id = u_at(imports, k);
    let ns = ao_sym(g, id, 0);
    let mut c = 0;
    while c < ao_sym(g, id, 1) {
      as_byte(&mut out, u_at(g.names, wrap_add(ns, c)));
      c = wrap_add(c, 1);
    }
    as_byte(&mut out, 0);
    k = wrap_add(k, 1);
  }
  // the relocations that fill the slots
  pe_pad_to(&mut out, rela);
  k = 0;
  while k < nimp {
    as_le(&mut out, wrap_add(ELF_BASE, wrap_add(got_off, wrap_mul(k, 8))), 8);
    if arm {
      as_le(&mut out, wrap_add(wrap_mul(wrap_add(k, 1), 4294967296), 1025), 8);
    } else {
      as_le(&mut out, wrap_add(wrap_mul(wrap_add(k, 1), 4294967296), 6), 8);
    }
    as_le(&mut out, 0, 8);
    k = wrap_add(k, 1);
  }
  let ro_len = vec_len(ro);
  let text_len = vec_len(text);
  let data_len = vec_len(data);
  pe_pad_to(&mut out, ro_off);
  pe_append(&mut out, ro, ro_len);
  pe_pad_to(&mut out, text_off);
  pe_append(&mut out, text, text_len);
  pe_pad_to(&mut out, data_off);
  pe_append(&mut out, data, data_len);
  pe_pad_to(&mut out, got_off);
  pe_pad_to(&mut out, dyn_off);
  // the dynamic section
  as_le(&mut out, 1, 8);
  as_le(&mut out, 1, 8);
  as_le(&mut out, 4, 8);
  as_le(&mut out, wrap_add(ELF_BASE, hash), 8);
  as_le(&mut out, 5, 8);
  as_le(&mut out, wrap_add(ELF_BASE, dynstr), 8);
  as_le(&mut out, 6, 8);
  as_le(&mut out, wrap_add(ELF_BASE, dynsym), 8);
  as_le(&mut out, 10, 8);
  as_le(&mut out, dynstr_len, 8);
  as_le(&mut out, 11, 8);
  as_le(&mut out, 24, 8);
  as_le(&mut out, 7, 8);
  as_le(&mut out, wrap_add(ELF_BASE, rela), 8);
  as_le(&mut out, 8, 8);
  as_le(&mut out, wrap_mul(24, nimp), 8);
  as_le(&mut out, 9, 8);
  as_le(&mut out, 24, 8);
  as_le(&mut out, 0, 8);
  as_le(&mut out, 0, 8);
  vec_free(rel);
  vec_free(imports);
  vec_free(comm);
  vec_free(name_off);
  return out;
}

/// Links the program into the Linux executable at `outp`, for musl when `musl`.
fn elf_build(host: &Host, outp: &Bytes, data: &Bytes, musl: bool) -> u64 {
  let mut g = pe_feed(data, elf_entry(), false);
  if g.errs > 0 {
    ao_free(g);
    return 3;
  }
  ao_layout(&mut g);
  let image = elf_link(&mut g, false, musl);
  ao_free(g);
  if vec_len(image) == 0 {
    vec_free(image);
    return 4;
  }
  return pe_write(host, outp, image);
}

/// Links the program into the AArch64 Linux executable at `outp`.
fn elf_build_a64(host: &Host, outp: &Bytes, data: &Bytes) -> u64 {
  let mut g = pe_feed(data, elf_entry_a64(), true);
  if g.errs > 0 {
    ao_free(g);
    return 3;
  }
  ao_layout(&mut g);
  let image = elf_link(&mut g, true, false);
  ao_free(g);
  if vec_len(image) == 0 {
    vec_free(image);
    return 4;
  }
  return pe_write(host, outp, image);
}

/// Appends `s` and a NUL to a string table and returns where it starts.
fn elf_str(t: &mut Vec[u64], s: Str) -> u64 {
  let at = vec_len(t);
  pe_put(&mut t, s);
  as_byte(&mut t, 0);
  return at;
}

/// One 64-byte section header.
fn elf_shdr(out: &mut Vec[u64], name: u64, kind: u64, flags: u64, off: u64, size: u64, link: u64, info: u64, align: u64, entsize: u64) {
  as_le(&mut out, name, 4);
  as_le(&mut out, kind, 4);
  as_le(&mut out, flags, 8);
  as_le(&mut out, 0, 8);
  as_le(&mut out, off, 8);
  as_le(&mut out, size, 8);
  as_le(&mut out, link, 4);
  as_le(&mut out, info, 4);
  as_le(&mut out, align, 8);
  as_le(&mut out, entsize, 8);
}

/// One `Elf64_Rela`.
fn elf_rela(v: &mut Vec[u64], at: u64, idx: u64, kind: u64, addend: u64) {
  as_le(&mut v, at, 8);
  as_le(&mut v, wrap_add(wrap_mul(idx, 4294967296), kind), 8);
  as_le(&mut v, addend, 8);
}

/// The index in the symbol table of `id` (after the null symbol and the four
/// section symbols), or 0 when it has none.
fn elf_symidx(syms: &Vec[u64], id: u64) -> u64 {
  let mut k = 0;
  while k < vec_len(syms) {
    if u_at(syms, k) == id {
      return wrap_add(k, 5);
    }
    k = wrap_add(k, 1);
  }
  return 0;
}

/// The assembled program `g` (laid out by `ao_layout`) as a relocatable
/// object, the file `as` would write: `.text`, `.rodata`, `.data` and `.bss`,
/// the relocations a linker still has to apply, and the symbols (global ones
/// by name, local ones through their section). Empty when a relocation cannot
/// be written.
fn elf_rel(g: &mut AsObj, arm: bool) -> Vec[u64] {
  let mut rel = vec_new[u64]();
  let text = ao_emit(g, AB_TEXT, &mut rel);
  let ro = ao_emit(g, AB_RODATA, &mut rel);
  let data = ao_emit(g, AB_DATA, &mut rel);
  let bss = ao_sec_size(g, AB_BSS);
  let nsym = ao_nsyms(g);
  // the symbols that get a name: the global ones, and the undefined ones that
  // a relocation uses
  let mut gs = vec_new[u64]();
  let mut r = 0;
  while wrap_add(r, 5) <= vec_len(rel) {
    let s = u_at(rel, wrap_add(r, 3));
    if s < nsym && ao_sym(g, s, 2) == AS_NONE && !has_id(gs, s) {
      vec_push(&mut gs, s);
    }
    r = wrap_add(r, 5);
  }
  let mut id = 0;
  while id < nsym {
    if (ao_sym(g, id, 4) & 3) != 0 && !has_id(gs, id) && ao_sym(g, id, 1) > 0 {
      vec_push(&mut gs, id);
    }
    id = wrap_add(id, 1);
  }
  // the relocations, by section
  let mut rt = vec_new[u64]();
  let mut rr = vec_new[u64]();
  let mut rd = vec_new[u64]();
  let mut bad = false;
  r = 0;
  while wrap_add(r, 5) <= vec_len(rel) {
    let sec = u_at(rel, r);
    let at = u_at(rel, wrap_add(r, 1));
    let mut kind = u_at(rel, wrap_add(r, 2));
    let s = u_at(rel, wrap_add(r, 3));
    let mut addend = u_at(rel, wrap_add(r, 4));
    if !arm {
      if kind == AR_PC32 {
        kind = 2;
      } else if kind == AR_PLT32 {
        kind = 4;
      } else if kind == AR_GOT32 {
        kind = 9;
      } else {
        bad = true;
      }
    }
    let mut idx = elf_symidx(gs, s);
    if idx == 0 {
      // a local label: its section's symbol, and the label's offset
      let ssec = ao_sym(g, s, 2);
      if ssec > AB_BSS {
        bad = true;
      } else {
        idx = wrap_add(ssec, 1);
        addend = wrap_add(addend, ao_sym_off(g, s));
      }
    }
    if sec == AB_RODATA {
      elf_rela(&mut rr, at, idx, kind, addend);
    } else if sec == AB_DATA {
      elf_rela(&mut rd, at, idx, kind, addend);
    } else if sec == AB_TEXT {
      elf_rela(&mut rt, at, idx, kind, addend);
    } else {
      bad = true;
    }
    r = wrap_add(r, 5);
  }
  // the symbol table and its names
  let mut strtab = vec_new[u64]();
  as_byte(&mut strtab, 0);
  let mut symtab = vec_new[u64]();
  pe_pad_to(&mut symtab, 24);
  let mut sk = 0;
  while sk < 4 {
    // the section symbols: STT_SECTION, local
    as_le(&mut symtab, 0, 4);
    as_byte(&mut symtab, 3);
    as_byte(&mut symtab, 0);
    as_le(&mut symtab, wrap_add(sk, 1), 2);
    as_le(&mut symtab, 0, 8);
    as_le(&mut symtab, 0, 8);
    sk = wrap_add(sk, 1);
  }
  let mut gk = 0;
  while gk < vec_len(gs) {
    let s = u_at(gs, gk);
    as_le(&mut symtab, vec_len(strtab), 4);
    let nstart = ao_sym(g, s, 0);
    let nlen = ao_sym(g, s, 1);
    let mut c = 0;
    while c < nlen {
      as_byte(&mut strtab, u_at(g.names, wrap_add(nstart, c)));
      c = wrap_add(c, 1);
    }
    as_byte(&mut strtab, 0);
    let ssec = ao_sym(g, s, 2);
    if (ao_sym(g, s, 4) & 2) != 0 && ssec == AS_NONE {
      // a common symbol: its alignment and size
      as_byte(&mut symtab, 17);
      as_byte(&mut symtab, 0);
      as_le(&mut symtab, 65522, 2);
      as_le(&mut symtab, 16, 8);
      as_le(&mut symtab, ao_sym(g, s, 5), 8);
    } else if ssec == AS_NONE {
      as_byte(&mut symtab, 16);
      as_byte(&mut symtab, 0);
      as_le(&mut symtab, 0, 2);
      as_le(&mut symtab, 0, 8);
      as_le(&mut symtab, 0, 8);
    } else if ssec <= AB_BSS {
      let mut ty = 0;
      if ssec == AB_TEXT {
        ty = 2;
      }
      as_byte(&mut symtab, wrap_add(16, ty));
      as_byte(&mut symtab, 0);
      as_le(&mut symtab, wrap_add(ssec, 1), 2);
      as_le(&mut symtab, ao_sym_off(g, s), 8);
      as_le(&mut symtab, 0, 8);
    } else {
      bad = true;
    }
    gk = wrap_add(gk, 1);
  }
  let mut shstr = vec_new[u64]();
  as_byte(&mut shstr, 0);
  let n_text = elf_str(&mut shstr, ".text");
  let n_ro = elf_str(&mut shstr, ".rodata");
  let n_data = elf_str(&mut shstr, ".data");
  let n_bss = elf_str(&mut shstr, ".bss");
  let n_note = elf_str(&mut shstr, ".note.GNU-stack");
  let n_rt = elf_str(&mut shstr, ".rela.text");
  let n_rr = elf_str(&mut shstr, ".rela.rodata");
  let n_rd = elf_str(&mut shstr, ".rela.data");
  let n_sym = elf_str(&mut shstr, ".symtab");
  let n_str = elf_str(&mut shstr, ".strtab");
  let n_shs = elf_str(&mut shstr, ".shstrtab");
  let mut out = vec_new[u64]();
  if !bad {
    // the file: header, then each section at its alignment, then the headers
    as_byte(&mut out, 127);
    pe_put(&mut out, "ELF");
    as_byte(&mut out, 2);
    as_byte(&mut out, 1);
    as_byte(&mut out, 1);
    pe_pad_to(&mut out, 16);
    as_le(&mut out, 1, 2);
    if arm {
      as_le(&mut out, 183, 2);
    } else {
      as_le(&mut out, 62, 2);
    }
    as_le(&mut out, 1, 4);
    as_le(&mut out, 0, 8);
    as_le(&mut out, 0, 8);
    let off_text = 64;
    let off_ro = pe_align(wrap_add(off_text, vec_len(text)), 16);
    let off_data = pe_align(wrap_add(off_ro, vec_len(ro)), 16);
    let off_bss = wrap_add(off_data, vec_len(data));
    let off_rt = pe_align(off_bss, 8);
    let off_rr = wrap_add(off_rt, vec_len(rt));
    let off_rd = wrap_add(off_rr, vec_len(rr));
    let off_sym = wrap_add(off_rd, vec_len(rd));
    let off_str = wrap_add(off_sym, vec_len(symtab));
    let off_shs = wrap_add(off_str, vec_len(strtab));
    let off_sh = pe_align(wrap_add(off_shs, vec_len(shstr)), 8);
    as_le(&mut out, off_sh, 8);
    as_le(&mut out, 0, 4);
    as_le(&mut out, 64, 2);
    as_le(&mut out, 0, 2);
    as_le(&mut out, 0, 2);
    as_le(&mut out, 64, 2);
    as_le(&mut out, 12, 2);
    as_le(&mut out, 11, 2);
    let mut k = 0;
    while k < vec_len(text) {
      as_byte(&mut out, u_at(text, k));
      k = wrap_add(k, 1);
    }
    pe_pad_to(&mut out, off_ro);
    k = 0;
    while k < vec_len(ro) {
      as_byte(&mut out, u_at(ro, k));
      k = wrap_add(k, 1);
    }
    pe_pad_to(&mut out, off_data);
    k = 0;
    while k < vec_len(data) {
      as_byte(&mut out, u_at(data, k));
      k = wrap_add(k, 1);
    }
    pe_pad_to(&mut out, off_rt);
    k = 0;
    while k < vec_len(rt) {
      as_byte(&mut out, u_at(rt, k));
      k = wrap_add(k, 1);
    }
    k = 0;
    while k < vec_len(rr) {
      as_byte(&mut out, u_at(rr, k));
      k = wrap_add(k, 1);
    }
    k = 0;
    while k < vec_len(rd) {
      as_byte(&mut out, u_at(rd, k));
      k = wrap_add(k, 1);
    }
    k = 0;
    while k < vec_len(symtab) {
      as_byte(&mut out, u_at(symtab, k));
      k = wrap_add(k, 1);
    }
    k = 0;
    while k < vec_len(strtab) {
      as_byte(&mut out, u_at(strtab, k));
      k = wrap_add(k, 1);
    }
    k = 0;
    while k < vec_len(shstr) {
      as_byte(&mut out, u_at(shstr, k));
      k = wrap_add(k, 1);
    }
    pe_pad_to(&mut out, off_sh);
    pe_pad_to(&mut out, wrap_add(off_sh, 64));
    elf_shdr(&mut out, n_text, 1, 6, off_text, vec_len(text), 0, 0, 16, 0);
    elf_shdr(&mut out, n_ro, 1, 2, off_ro, vec_len(ro), 0, 0, 16, 0);
    elf_shdr(&mut out, n_data, 1, 3, off_data, vec_len(data), 0, 0, 16, 0);
    elf_shdr(&mut out, n_bss, 8, 3, off_bss, bss, 0, 0, 16, 0);
    elf_shdr(&mut out, n_note, 1, 0, off_bss, 0, 0, 0, 1, 0);
    elf_shdr(&mut out, n_rt, 4, 64, off_rt, vec_len(rt), 9, 1, 8, 24);
    elf_shdr(&mut out, n_rr, 4, 64, off_rr, vec_len(rr), 9, 2, 8, 24);
    elf_shdr(&mut out, n_rd, 4, 64, off_rd, vec_len(rd), 9, 3, 8, 24);
    elf_shdr(&mut out, n_sym, 2, 0, off_sym, vec_len(symtab), 10, 5, 8, 24);
    elf_shdr(&mut out, n_str, 3, 0, off_str, vec_len(strtab), 0, 0, 1, 0);
    elf_shdr(&mut out, n_shs, 3, 0, off_shs, vec_len(shstr), 0, 0, 1, 0);
  }
  vec_free(rel);
  vec_free(text);
  vec_free(ro);
  vec_free(data);
  vec_free(gs);
  vec_free(rt);
  vec_free(rr);
  vec_free(rd);
  vec_free(strtab);
  vec_free(symtab);
  vec_free(shstr);
  return out;
}

/// Writes the program's assembly as the relocatable object at `outp`.
fn elf_build_rel(host: &Host, outp: &Bytes, data: &Bytes, arm: bool) -> u64 {
  let mut g = pe_feed(data, "", arm);
  if g.errs > 0 {
    ao_free(g);
    return 3;
  }
  ao_layout(&mut g);
  let image = elf_rel(&mut g, arm);
  ao_free(g);
  if vec_len(image) == 0 {
    vec_free(image);
    return 4;
  }
  return pe_write(host, outp, image);
}
