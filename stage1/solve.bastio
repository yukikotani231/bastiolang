// Asks Z3 to discharge the proof obligations `verify.bastio` recorded, and
// reports the first one that fails as stage0 does: its error code and
// position, a counterexample (the values of the variables in scope), and
// a note when the function is a copy of a generic one.
//
// The solver runs as a child process (`z3 -in -smt2`) and sees exactly the
// commands stage0 sends it: the log, one command per line, read after each
// `(check-sat)`; then, after a failed proof, one `(get-value ..)` per value
// shown.
import "verify.bastio";

/// A value shown in a counterexample: its label (lchars[s .. s + n]) and
/// its term. For the length of a buffer or of a vector of scalars, seq is
/// the length of the label's prefix (`len(`, `vlen(`), so the name follows
/// it, and arr is the array of its elements, which are shown too when
/// there are few (SHOW_ELEMS); seq is 0 for every other value.
struct Lab { s: u64, n: u64, tm: u64, seq: u64, arr: u64 }

/// Buffers and vectors at most this long have their elements shown in a
/// counterexample, after their length (stage0's `SHOW_ELEMS`).
const SHOW_ELEMS: u64 = 8;

fn push_arg(argv: &mut Vec[Bytes], s: Str) {
  vec_push(&mut argv, bfrom(s));
}

fn drop_argv(argv: Vec[Bytes]) {
  let mut w = argv;
  while vec_len(w) > 0 {
    bfree(vec_pop(&mut w));
  }
  vec_free(w);
}

/// Writes the text in `out` to the solver and empties it.
fn z3_send(z: &mut Child, out: &mut Vec[u64]) -> bool {
  let n = vec_len(out);
  let mut b = balloc(n);
  let mut k = 0;
  while k < n && k < blen(b) {
    let ch = u_at(out, k);
    if ch <= 255 {
      bset(&mut b, k, cast[u8](ch));
    }
    k = k + 1;
  }
  let ok = child_write(&mut z, b);
  bfree(b);
  while vec_len(out) > 0 {
    vec_pop(&mut out);
  }
  return ok;
}

/// Reads one complete response into `resp`: a bare word or a balanced
/// s-expression, possibly over several lines. False if the solver stopped.
fn z3_read(z: &mut Child, resp: &mut Vec[u64]) -> bool {
  while vec_len(resp) > 0 {
    vec_pop(&mut resp);
  }
  let mut line = balloc(0);
  let mut open = 0;
  let mut close = 0;
  let mut ok = true;
  let mut done = false;
  while !done {
    if !child_read_line(&mut z, &mut line) {
      ok = false;
      done = true;
    } else {
      let mut k = 0;
      while k < blen(line) {
        let ch = bget(line, k);
        if ch == 40 && open < U64_MAX { open = open + 1; }
        if ch == 41 && close < U64_MAX { close = close + 1; }
        vec_push(&mut resp, cast[u64](ch));
        k = k + 1;
      }
      vec_push(&mut resp, 10);
      let r = trim(resp);
      // Z3 4.8.12 answers a `get-value` it cannot finish with `((error "..")`,
      // one parenthesis short: that line is the whole reply (as in stage0).
      done = (close >= open && r.e > r.s) || starts_text(resp, r, "((error");
    }
  }
  bfree(line);
  return ok;
}

/// Reads the answer to a `(get-value ..)`: `?` where Z3 gave up on it.
fn z3_read_value(z: &mut Child, resp: &mut Vec[u64]) -> bool {
  let ok = z3_read(&mut z, &mut resp);
  if starts_text(resp, trim(resp), "((error") {
    while vec_len(resp) > 0 {
      vec_pop(&mut resp);
    }
    vec_push(&mut resp, 63);
  }
  return ok;
}

/// A range s..e of a text.
struct Rng { s: u64, e: u64 }

/// The text without leading and trailing white space.
fn trim(t: &Vec[u64]) -> Rng {
  let mut s = 0;
  let mut e = vec_len(t);
  while s < e && is_space(u_at(t, s)) {
    s = s + 1;
  }
  while e > s && is_space(u_at(t, e - 1)) {
    e = e - 1;
  }
  return Rng { s: s, e: e };
}

/// Is t[r] the text `w`?
fn is_text(t: &Vec[u64], r: Rng, w: Str) -> bool {
  if r.e < r.s || r.e - r.s != slen(w) {
    return false;
  }
  let mut k = 0;
  while k < slen(w)
    invariant k <= slen(w)
  {
    if u_at(t, vadd(r.s, k)) != cast[u64](sget(w, k)) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

/// Does t[r] start with `w`?
fn starts_text(t: &Vec[u64], r: Rng, w: Str) -> bool {
  if r.e < r.s || r.e - r.s < slen(w) {
    return false;
  }
  return is_text(t, Rng { s: r.s, e: vadd(r.s, slen(w)) }, w);
}

/// Does t[r] end with `w`?
fn ends_text(t: &Vec[u64], r: Rng, w: Str) -> bool {
  if r.e < r.s || r.e - r.s < slen(w) {
    return false;
  }
  return is_text(t, Rng { s: r.e - slen(w), e: r.e }, w);
}

fn out_rng(out: &mut Vec[u64], t: &Vec[u64], r: Rng) {
  let mut k = r.s;
  while k < r.e {
    vec_push(&mut out, u_at(t, k));
    k = k + 1;
  }
}

/// Appends the value in a `(get-value ..)` response as stage0 shows it:
/// the last s-expression or atom inside `((term value))`, with `(- 3)`
/// written `-3`.
fn out_value(out: &mut Vec[u64], resp: &Vec[u64]) {
  let mut r = trim(resp);
  if r.s <= r.e && r.e - r.s >= 4 && starts_text(resp, r, "((") && ends_text(resp, r, "))") {
    r = Rng { s: r.s + 2, e: r.e - 2 };
    while r.e > r.s && is_space(u_at(resp, r.e - 1)) {
      r = Rng { s: r.s, e: r.e - 1 };
    }
  }
  // the last balanced s-expression, or the last atom
  let mut s = r.s;
  if r.e > r.s && u_at(resp, r.e - 1) == 41 {
    let mut depth = 0;
    let mut k = r.e;
    let mut found = false;
    while k > r.s && !found {
      k = k - 1;
      let ch = u_at(resp, k);
      if ch == 41 {
        depth = vadd(depth, 1);
      } else if ch == 40 {
        if depth > 0 {
          depth = depth - 1;
        }
        if depth == 0 {
          s = k;
          found = true;
        }
      }
    }
  } else {
    let mut k = r.e;
    while k > r.s && !is_space(u_at(resp, k - 1)) {
      k = k - 1;
    }
    s = k;
  }
  let mut x = trim_rng(resp, Rng { s: s, e: r.e });
  if starts_text(resp, x, "(- ") {
    vec_push(&mut out, 45);
    let mut e = x.e;
    while e > vadd(x.s, 3) && u_at(resp, e - 1) == 41 {
      e = e - 1;
    }
    out_rng(&mut out, resp, Rng { s: vadd(x.s, 3), e: e });
    return;
  }
  out_rng(&mut out, resp, x);
  out_readable(&mut out, resp, x);
}

/// What to do about a failed proof of kind `code`, as a `  = ` note
/// (stage0's `proof_hint`).
fn proof_hint(rep: &mut Vec[u64], code: u64) {
  if code == VC_OVERFLOW {
    w_s(&mut rep, "  = bound the operands with a `requires` or an `if`, or use `wrap_add`, `wrap_sub` or `wrap_mul` if wrapping around is meant\n");
  } else if code == VC_UNDERFLOW {
    w_s(&mut rep, "  = check the operands with an `if` or a `requires` first, or use `wrap_sub` if wrapping around is meant\n");
  } else if code == VC_BOUNDS {
    w_s(&mut rep, "  = check the index against the length first, with an `if` or a `requires`, or keep it in range with a loop `invariant`\n");
  } else if code == VC_DIVZERO {
    w_s(&mut rep, "  = check that the divisor is not zero first, with an `if` or a `requires`\n");
  } else if code == VC_REQUIRES {
    w_s(&mut rep, "  = the caller must make it hold: check it with an `if` before the call, or ask for it in the caller's own `requires`\n");
  } else if code == VC_ENSURES {
    w_s(&mut rep, "  = every `return` must make it hold for each input that meets the `requires`\n");
  } else if code == VC_INVARIANT || code == VC_INV_STEP {
    w_s(&mut rep, "  = an invariant must hold when the loop starts, and again after any iteration that begins with it and the loop condition true\n");
  } else if code == VC_CAST {
    w_s(&mut rep, "  = check the value first, with an `if` or a `requires`, or use `wrap[T](..)` if wrapping around is meant\n");
  } else if code == VC_SHIFT {
    w_s(&mut rep, "  = check the shift amount first, with an `if` or a `requires`\n");
  } else if code == VC_ALLOC {
    w_s(&mut rep, "  = bound the size first, with an `if` or a `requires`\n");
  } else if code == VC_LEAK {
    w_s(&mut rep, "  = pop and consume every element first, or show with a `requires` or an `if` that the vector is empty before freeing it\n");
  } else if code == VC_UNREACHABLE {
    w_s(&mut rep, "  = an `unreachable` must follow from what is known there: look at the conditions of the enclosing `if`s and the `requires`\n");
  } else if code == VC_ASSERT {
    w_s(&mut rep, "  = an `assert` must follow from what is known there: the `requires`, the conditions of the enclosing `if`s and loops, and loop invariants\n");
  }
}

/// After a value of digits `t[r]` just written: its distance from the
/// nearest power of two, when it is that close to one (stage0's
/// `readable`), since such values are where integers overflow.
fn out_readable(out: &mut Vec[u64], t: &Vec[u64], r: Rng) {
  if r.s >= r.e || r.e - r.s > 20 {
    return;
  }
  let mut x = 0;
  let mut k = r.s;
  while k < r.e {
    let ch = u_at(t, k);
    if ch < 48 || ch > 57 || x > 1844674407370955161 {
      return;
    }
    let d = ch - 48;
    if x * 10 > U64_MAX - d {
      return;
    }
    x = x * 10 + d;
    k = k + 1;
  }
  let mut n = 16;
  let mut pw = 65536;
  while n <= 64 {
    // 2^64 does not fit a u64: compare from the other side.
    if n == 64 {
      if x >= U64_MAX - 15 {
        w_s(&mut out, " (2^64 - ");
        w_num(&mut out, U64_MAX - x + 1);
        w_s(&mut out, ")");
      }
      return;
    }
    if x == pw {
      w_s(&mut out, " (2^");
      w_num(&mut out, n);
      w_s(&mut out, ")");
      return;
    }
    if x < pw && pw - x <= 16 {
      w_s(&mut out, " (2^");
      w_num(&mut out, n);
      w_s(&mut out, " - ");
      w_num(&mut out, pw - x);
      w_s(&mut out, ")");
      return;
    }
    if x > pw && x - pw <= 16 {
      w_s(&mut out, " (2^");
      w_num(&mut out, n);
      w_s(&mut out, " + ");
      w_num(&mut out, x - pw);
      w_s(&mut out, ")");
      return;
    }
    if pw > U64_MAX / 2 {
      pw = U64_MAX;
    } else {
      pw = pw * 2;
    }
    n = n + 1;
  }
}

fn trim_rng(t: &Vec[u64], r: Rng) -> Rng {
  let mut s = r.s;
  let mut e = r.e;
  while s < e && is_space(u_at(t, s)) {
    s = s + 1;
  }
  while e > s && is_space(u_at(t, e - 1)) {
    e = e - 1;
  }
  return Rng { s: s, e: e };
}

// ---- Counterexamples ----

/// The name of variable b: its source text, or for a hidden variable
/// (s > e) the pool text e..s.
fn out_name(out: &mut Vec[u64], v: &Vr, p: &Parser, b: Bind) {
  if b.s > b.e {
    let mut k = b.e;
    while k < b.s {
      vec_push(&mut out, pool_at(v, k));
      k = k + 1;
    }
  } else {
    out_src(&mut out, p, b.s, b.e);
  }
}

/// Is variable a's name before b's, in byte order?
fn name_less(v: &Vr, p: &Parser, a: Bind, b: Bind) -> bool {
  let mut x = vec_new[u64]();
  let mut y = vec_new[u64]();
  out_name(&mut x, v, p, a);
  out_name(&mut y, v, p, b);
  let mut k = 0;
  let mut r = vec_len(x) < vec_len(y);
  let mut done = false;
  while k < vec_len(x) && k < vec_len(y) && !done {
    if u_at(x, k) != u_at(y, k) {
      r = u_at(x, k) < u_at(y, k);
      done = true;
    }
    k = k + 1;
  }
  vec_free(x);
  vec_free(y);
  return r;
}

fn src_at(p: &Parser, i: u64) -> u64 {
  if i < blen(p.src) {
    return cast[u64](bget(p.src, i));
  }
  return 0;
}

fn out_src(out: &mut Vec[u64], p: &Parser, s: u64, e: u64) {
  let mut k = s;
  while k < e {
    vec_push(&mut out, src_at(p, k));
    k = k + 1;
  }
}

fn add_lab(labs: &mut Vec[Lab], chars: &mut Vec[u64], pre: Str, name: &Vec[u64], post: Str, tm: u64) {
  let s = vec_len(chars);
  w_s(&mut chars, pre);
  let mut k = 0;
  while k < vec_len(name) {
    vec_push(&mut chars, u_at(name, k));
    k = k + 1;
  }
  w_s(&mut chars, post);
  let n = vec_len(chars);
  if n >= s {
    vec_push(&mut labs, Lab { s: s, n: n - s, tm: tm, seq: 0, arr: 0 });
  }
}

/// Marks the label just added as a sequence's length (see `Lab`).
fn set_seq(labs: &mut Vec[Lab], seq: u64, arr: u64) {
  let n = vec_len(labs);
  if n > 0 {
    let l = vec_get(labs, n - 1);
    vec_set(&mut labs, n - 1, Lab { s: l.s, n: l.n, tm: l.tm, seq: seq, arr: arr });
  }
}

/// The accessor that shows ghost field j of an object of type kind k
/// ("" for the array fields, which are not shown).
fn ghost_acc(k: u64, j: u64) -> Str {
  if k == TY_FRAME && j == 0 { return "frame_id"; }
  if k == TY_DMA && j == 0 { return "dma_id"; }
  if k == TY_SHARED && j == 0 { return "shared_id"; }
  if k == TY_DIRTY && j == 0 { return "dirty_id"; }
  if k == TY_PT && j == 0 { return "pt_id"; }
  if k == TY_PT && j == 1 { return "pt_level"; }
  if k == TY_PT && j == 3 { return "pt_leases"; }
  if k == TY_POOL && j == 1 { return "pool_size"; }
  if k == TY_MMU && j == 0 { return "mmu_root"; }
  if (k == TY_PORTIO || k == TY_MMIO) && j == 0 {
    if k == TY_PORTIO { return "port_base"; }
    return "mmio_base";
  }
  if k == TY_PORTIO && j == 1 { return "port_count"; }
  if k == TY_MMIO && j == 1 { return "mmio_len"; }
  return "";
}

fn trunc(t: &mut Vec[u64], n: u64) {
  while vec_len(t) > n {
    vec_pop(&mut t);
  }
}

/// The values shown for variable (or place) `name` holding value x.
fn show(v: &Vr, m: &Mono, p: &Parser, name: &mut Vec[u64], x: u64, labs: &mut Vec[Lab], chars: &mut Vec[u64]) {
  let xv = vl_at(v, x);
  let k = xv.kind;
  if k == VV_U || k == VV_B {
    add_lab(&mut labs, &mut chars, "", name, "", xv.a);
  } else if k == VV_BUF {
    add_lab(&mut labs, &mut chars, "len(", name, ")", xv.a);
    set_seq(&mut labs, 4, xv.b);
  } else if k == VV_STR {
    add_lab(&mut labs, &mut chars, "slen(", name, ")", xv.a);
  } else if k == VV_VEC {
    add_lab(&mut labs, &mut chars, "vlen(", name, ")", xv.a);
    let ev = vl_at(v, xv.b);
    if ev.kind == VV_U || ev.kind == VV_B {
      set_seq(&mut labs, 5, ev.a);
    }
  } else if k == VV_OBJ {
    let tk = kind_t(m, xv.ty);
    let mut j = 0;
    while j < xv.n && j < 4 {
      let acc = ghost_acc(tk, j);
      if slen(acc) > 0 {
        let s = vec_len(chars);
        w_s(&mut chars, acc);
        w_s(&mut chars, "(");
        let mut q = 0;
        while q < vec_len(name) {
          vec_push(&mut chars, u_at(name, q));
          q = q + 1;
        }
        w_s(&mut chars, ")");
        let n = vec_len(chars);
        if n >= s {
          vec_push(&mut labs, Lab { s: s, n: n - s, tm: obj_field(v, x, j), seq: 0, arr: 0 });
        }
      }
      j = j + 1;
    }
  } else if k == VV_STRUCT || k == VV_ENUM {
    if k == VV_ENUM {
      add_lab(&mut labs, &mut chars, "tag(", name, ")", xv.a);
    }
    let base = vec_len(name);
    let mut j = 0;
    while j < xv.n {
      let fd = part_node(m, p, xv.ty, j);
      w_s(&mut name, ".");
      out_src(&mut name, p, fd.s, fd.e);
      show(v, m, p, &mut name, kid(v, x, j), &mut labs, &mut chars);
      trunc(&mut name, base);
      j = j + 1;
    }
  } else if k == VV_BOXK {
    show(v, m, p, &mut name, xv.a, &mut labs, &mut chars);
  }
}

/// The labels and terms of obligation o's counterexample, in stage0's order:
/// variables sorted by name, each shown in full.
fn cex_labels(v: &Vr, m: &Mono, p: &Parser, o: Obl, labs: &mut Vec[Lab], chars: &mut Vec[u64]) {
  let mut bs = vec_new[Bind]();
  let mut k = 0;
  while k < o.n {
    vec_push(&mut bs, bind_at(v.snaps, vadd(o.env, k)));
    k = k + 1;
  }
  // insertion sort by name
  k = 1;
  while k < vec_len(bs) {
    let mut j = k;
    while j > 0 && j < vec_len(bs) {
      let a = bind_at(bs, j - 1);
      let b = bind_at(bs, j);
      if name_less(v, p, b, a) {
        vec_set(&mut bs, j - 1, b);
        vec_set(&mut bs, j, a);
        j = j - 1;
      } else {
        j = 0;
      }
    }
    k = k + 1;
  }
  k = 0;
  while k < vec_len(bs) {
    let b = bind_at(bs, k);
    let mut name = vec_new[u64]();
    out_name(&mut name, v, p, b);
    show(v, m, p, &mut name, b.val, &mut labs, &mut chars);
    vec_free(name);
    k = k + 1;
  }
  vec_free(bs);
}

fn obl_at(v: &Vr, k: u64) -> Obl {
  if k < vec_len(v.obls) {
    return vec_get(v.obls, k);
  }
  return Obl { at: 0, code: 0, x: 0, env: 0, n: 0, ms: 0, ml: 0, ns: 0, nl: 0 };
}

/// After `solve` fails on a proof: what the failed obligation says, as
/// stage0's message ("could not prove ..."); nothing for E-SOLVER.
fn fail_msg(v: &Vr, out: &mut Vec[u64]) {
  if v.fail_code == 0 || v.fail_obl == 0 {
    return;
  }
  let o = obl_at(v, v.fail_obl - 1);
  let mut k = 0;
  while k < o.ml {
    vec_push(&mut out, u_at(v.mpool, vadd(o.ms, k)));
    k = k + 1;
  }
}

fn lab_at(xs: &Vec[Lab], k: u64) -> Lab {
  if k < vec_len(xs) {
    return vec_get(xs, k);
  }
  return Lab { s: 0, n: 0, tm: 0, seq: 0, arr: 0 };
}

/// `error F:L:C CODE` for the failed obligation, as the dumps print it.
fn out_error(out: &mut Vec[u64], v: &Vr, p: &Parser) {
  let n = node_at(p.nodes, v.fail_at);
  w_s(&mut out, "error ");
  w_num(&mut out, n.file);
  w_s(&mut out, ":");
  w_num(&mut out, n.line);
  w_s(&mut out, ":");
  w_num(&mut out, n.col);
  w_s(&mut out, " ");
  if v.fail_code == 0 {
    w_s(&mut out, "E-SOLVER");
  } else {
    w_s(&mut out, vc_name(v.fail_code));
  }
  w_s(&mut out, "\n");
}

/// Starts the solver (`BASTIO_SOLVER`, default `z3`, as stage0 does) and
/// sends the two commands every session starts with.
fn z3_start(h: &Host) -> Child {
  let mut argv = vec_new[Bytes]();
  let mut cmd = balloc(0);
  if host_env(h, "BASTIO_SOLVER", &mut cmd) {
    vec_push(&mut argv, cmd);
  } else {
    bfree(cmd);
    push_arg(&mut argv, "z3");
  }
  push_arg(&mut argv, "-in");
  push_arg(&mut argv, "-smt2");
  let mut z = host_spawn(h, argv);
  drop_argv(argv);
  let mut out = vec_new[u64]();
  out_header(&mut out);
  z3_send(&mut z, &mut out);
  vec_free(out);
  return z;
}

/// The solver's name, as z3_start runs it: `BASTIO_SOLVER`, or `z3`.
fn solver_name(h: &Host, out: &mut Vec[u64]) {
  let mut cmd = balloc(0);
  if host_env(h, "BASTIO_SOLVER", &mut cmd) {
    let mut k = 0;
    while k < blen(cmd) {
      vec_push(&mut out, cast[u64](bget(cmd, k)));
      k = k + 1;
    }
  } else {
    w_s(&mut out, "z3");
  }
  bfree(cmd);
}

/// Whether the solver starts and answers at all: a program that cannot be
/// started gives a child that writes nothing (`host_spawn`). The driver
/// asks before verifying, so that a missing Z3 is one error about no line
/// of the program, as stage0 reports it, rather than a failed proof.
fn solver_starts(h: &Host) -> bool {
  let mut z = z3_start(h);
  let mut out = vec_new[u64]();
  w_s(&mut out, "(check-sat)\n");
  z3_send(&mut z, &mut out);
  vec_free(out);
  let mut line = balloc(0);
  let got = child_read_line(&mut z, &mut line);
  bfree(line);
  z3_stop(z);
  return got;
}

fn z3_stop(z: Child) {
  let mut w = z;
  child_close(&mut w);
  child_wait(w);
}

/// Sends the commands log[from..to) to the solver `z`, reading the answer
/// to each `(check-sat)`; `ob0` is the index of the first obligation among
/// them. True if every obligation holds; otherwise the first that fails is
/// recorded (`fail_at`, `fail_code`) and `rep` gets its notes, one `  = ..`
/// line each.
fn solve_range(v: &mut Vr, m: &Mono, p: &Parser, z: &mut Child, rep: &mut Vec[u64], from: u64, to: u64, ob0: u64) -> bool {
  let mut out = vec_new[u64]();
  let mut resp = vec_new[u64]();
  let mut ok = true;
  let mut ob = ob0;
  let mut k = from;
  while k < to && k < vec_len(v.log) && ok {
    let cmd = vec_get(v.log, k);
    out_cmd(&mut out, v, cmd);
    if cmd.kind == CMD_FAIL {
      let o = obl_at(v, ob);
      v.fail_at = o.at;
      v.fail_code = o.code;
      v.fail_obl = vadd(ob, 1);
      w_s(&mut rep, "  = a buffer lent by C may only be written in place (`bset`, or lent to functions that do only that)\n");
      ok = false;
      ob = vadd(ob, 1);
    } else if cmd.kind == CMD_CHECK {
      let o = obl_at(v, ob);
      z3_send(&mut z, &mut out);
      let alive = z3_read(&mut z, &mut resp);
      let r = trim(resp);
      if !alive || starts_text(resp, r, "(error") {
        v.fail_at = o.at;
        v.fail_code = 0;
        v.fail_obl = vadd(ob, 1);
        ok = false;
      } else if !is_text(resp, r, "unsat") {
        v.fail_at = o.at;
        v.fail_code = o.code;
        v.fail_obl = vadd(ob, 1);
        if is_text(resp, r, "sat") {
          report_cex(&mut v, m, p, &mut z, o, &mut rep);
          if o.nl > 0 {
            w_s(&mut rep, "  = ");
            let mut q = 0;
            while q < o.nl {
              vec_push(&mut rep, u_at(v.mpool, vadd(o.ns, q)));
              q = q + 1;
            }
            w_s(&mut rep, "\n");
          }
          proof_hint(&mut rep, o.code);
        } else {
          w_s(&mut rep, "  = the solver gave up (its work limit, or quantifiers); add an `assert` or a stronger invariant as a hint\n");
        }
        // A copy of a generic function says which.
        let nm = inst_name(&mut v, m, p, o.x);
        let t = tm_at(v, nm);
        let mut generic = false;
        let mut q = 0;
        while q < t.b {
          if pool_at(v, vadd(t.a, q)) == 91 {
            generic = true;
          }
          q = q + 1;
        }
        if generic {
          w_s(&mut rep, "  = in `");
          out_tm(&mut rep, v, nm);
          w_s(&mut rep, "`, the copy of a generic function for these type arguments\n");
        }
        ok = false;
      }
      ob = vadd(ob, 1);
    }
    k = k + 1;
  }
  if ok {
    z3_send(&mut z, &mut out);
  }
  vec_free(out);
  vec_free(resp);
  return ok;
}

/// Runs one solver over the whole recorded log, in program order (what
/// `--dump-verify` does, which verifydump.bastio is compared with). True
/// if every obligation holds; otherwise the first that fails is recorded.
fn solve(v: &mut Vr, m: &Mono, p: &Parser, h: &Host, rep: &mut Vec[u64]) -> bool {
  let mut z = z3_start(h);
  let ok = solve_range(&mut v, m, p, &mut z, &mut rep, 0, vec_len(v.log), 0);
  z3_stop(z);
  return ok;
}

// ---- Proving in parallel ----

/// The commands of one function: log[s..e), its obligations from `ob` on,
/// `checks` of them sent to the solver, and whether a failure found
/// without the solver (CMD_FAIL) is among them.
struct Unit { s: u64, e: u64, ob: u64, checks: u64, fail: bool }

fn unit_len(u: Unit) -> u64 {
  if u.e >= u.s {
    return u.e - u.s;
  }
  return 0;
}

fn unit_at(us: &Vec[Unit], k: u64) -> Unit {
  if k < vec_len(us) {
    return vec_get(us, k);
  }
  return Unit { s: 0, e: 0, ob: 0, checks: 0, fail: false };
}

/// Splits the log into the preamble (log[0..returned)) and one unit per
/// function. Each function is verified in a solver scope of its own
/// (verify_program), so a unit ends where the scope it opened is closed.
fn units_of(v: &Vr, us: &mut Vec[Unit]) -> u64 {
  let n = vec_len(v.log);
  let mut pre = n;
  let mut started = false;
  let mut s = 0;
  let mut depth = 0;
  let mut ob = 0;
  let mut uob = 0;
  let mut checks = 0;
  let mut bad = false;
  let mut k = 0;
  while k < n {
    let cmd = vec_get(v.log, k);
    if !started && depth == 0 && (cmd.kind == CMD_PUSH || cmd.kind == CMD_FAIL) {
      started = true;
      pre = k;
      s = k;
    }
    if cmd.kind == CMD_PUSH {
      depth = vadd(depth, 1);
    } else if cmd.kind == CMD_CHECK {
      checks = vadd(checks, 1);
      ob = vadd(ob, 1);
    } else if cmd.kind == CMD_FAIL {
      bad = true;
      ob = vadd(ob, 1);
    } else if cmd.kind == CMD_POP && depth > 0 {
      depth = depth - 1;
      if depth == 0 && started {
        vec_push(&mut us, Unit { s: s, e: k + 1, ob: uob, checks: checks, fail: bad });
        s = k + 1;
        uob = ob;
        checks = 0;
        bad = false;
      }
    }
    k = k + 1;
  }
  return pre;
}

/// The number of solvers to run at once: `BASTIO_JOBS`, or the number of
/// processors (at most 8), as stage0 decides it.
fn solve_jobs(h: &Host) -> u64 {
  let mut j = host_cpus(h);
  if j > 8 {
    j = 8;
  }
  let mut b = balloc(0);
  if host_env(h, "BASTIO_JOBS", &mut b) && blen(b) > 0 && blen(b) <= 18 {
    let mut n = 0;
    let mut digits = true;
    let mut k = 0;
    while k < blen(b) && k <= 18 {
      let ch = cast[u64](bget(b, k));
      if ch >= 48 && ch <= 57 && n < 100000000000000000 {
        n = n * 10 + (ch - 48);
      } else {
        digits = false;
      }
      k = k + 1;
    }
    if digits {
      j = n;
    }
  }
  bfree(b);
  if j < 1 {
    j = 1;
  }
  return j;
}

/// Appends the commands log[s..e) to `out`.
fn out_range(out: &mut Vec[u64], v: &Vr, s: u64, e: u64) {
  let mut k = s;
  while k < e && k < vec_len(v.log) {
    out_cmd(&mut out, v, vec_get(v.log, k));
    k = k + 1;
  }
}

/// Sends log[s..e) to the solver `z` without reading anything.
fn send_range(v: &Vr, z: &mut Child, s: u64, e: u64) {
  let mut out = vec_new[u64]();
  out_range(&mut out, v, s, e);
  z3_send(&mut z, &mut out);
  vec_free(out);
}

/// Reads the answers to unit u's checks: true if all are `unsat`.
fn unit_holds(z: &mut Child, u: Unit) -> bool {
  if u.fail {
    return false;
  }
  let mut resp = vec_new[u64]();
  let mut ok = true;
  let mut k = 0;
  while k < u.checks && ok {
    ok = z3_read(&mut z, &mut resp) && is_text(resp, trim(resp), "unsat");
    k = k + 1;
  }
  vec_free(resp);
  return ok;
}

/// A child that is no process (there is no program to start): a
/// placeholder while a solver is taken out of the list.
fn no_child(h: &Host) -> Child {
  let argv = vec_new[Bytes]();
  let c = host_spawn(h, argv);
  vec_free(argv);
  return c;
}

/// Runs `argv` and returns the first line it prints (empty if none).
fn run_line(h: &Host, argv: Vec[Bytes]) -> Bytes {
  let mut c = host_spawn(h, argv);
  drop_argv(argv);
  child_close(&mut c);
  let mut line = balloc(0);
  child_read_line(&mut c, &mut line);
  child_wait(c);
  return line;
}

/// Writes the text in `body` to the file `path`.
fn write_body(h: &Host, path: &Bytes, body: &Vec[u64]) -> bool {
  let mut b = balloc(vec_len(body));
  let mut k = 0;
  while k < vec_len(body) && k < blen(b) {
    let ch = u_at(body, k);
    if ch <= 255 {
      bset(&mut b, k, cast[u8](ch));
    }
    k = k + 1;
  }
  let ok = host_write(h, path, b);
  bfree(b);
  return ok;
}

// ---- The proof cache ----

/// Two independent 64-bit hashes of a text, 128 bits together. Each step
/// is an FNV-style xor and wrapping multiply, the second lane with a
/// shift-xor between steps so that its bits mix both ways.
struct Hash2 { a: u64, b: u64 }

fn hash_new() -> Hash2 {
  return Hash2 { a: 14695981039346656037, b: 11400714819323198485 };
}

fn hash_text(x: Hash2, t: &Vec[u64]) -> Hash2 {
  let mut a = x.a;
  let mut b = x.b;
  let mut k = 0;
  while k < vec_len(t) {
    let ch = vec_get(t, k);
    a = wrap_mul(a ^ ch, 1099511628211);
    let m = wrap_mul(b ^ ch, 11400714819323198485);
    b = m ^ (m >> 29);
    k = k + 1;
  }
  return Hash2 { a: a, b: b };
}

/// The text in `v` as bytes (characters above 255 are left out).
fn text_bytes(v: &Vec[u64]) -> Bytes {
  let mut b = balloc(vec_len(v));
  let mut k = 0;
  while k < vec_len(v) && k < blen(b) {
    let ch = u_at(v, k);
    if ch <= 255 {
      bset(&mut b, k, cast[u8](ch));
    }
    k = k + 1;
  }
  return b;
}

/// The directory of the proof cache (`BASTIO_PROOF_CACHE`); empty if the
/// cache is off. A function whose verification conditions have been
/// proved before, to the byte and by the same solver, is not sent to the
/// solver again. The cache is trusted like the solver: a file in it says
/// "these conditions are unsat", so only a directory the user controls
/// should be named.
fn cache_dir(h: &Host) -> Bytes {
  let mut d = balloc(0);
  if !host_env(h, "BASTIO_PROOF_CACHE", &mut d) {
    bfree(d);
    return balloc(0);
  }
  return d;
}

/// `<dir>/<key>`, the file that records that the function whose text
/// hashes to x (together with the preamble) was proved.
fn cache_path(dir: &Bytes, x: Hash2) -> Bytes {
  let mut t = vec_new[u64]();
  let mut k = 0;
  while k < blen(dir) {
    vec_push(&mut t, cast[u64](bget(dir, k)));
    k = k + 1;
  }
  w_s(&mut t, "/");
  w_hex(&mut t, x.a);
  w_s(&mut t, "-");
  w_hex(&mut t, x.b);
  let b = text_bytes(t);
  vec_free(t);
  return b;
}

fn cache_hit(h: &Host, path: &Bytes) -> bool {
  let mut b = balloc(0);
  let ok = host_read(h, path, &mut b);
  bfree(b);
  return ok;
}

/// Records that the functions behind paths[0..upto) were proved. A path
/// that is empty (a function that is not cached) is skipped.
fn cache_record(h: &Host, paths: &mut Vec[Bytes], upto: u64) {
  let mut k = 0;
  while k < upto && k < vec_len(paths) {
    let p = vec_swap(&mut paths, k, balloc(0));
    if blen(p) > 0 {
      let mut body = vec_new[u64]();
      w_s(&mut body, "unsat\n");
      write_body(h, p, body);
      vec_free(body);
    }
    bfree(vec_swap(&mut paths, k, p));
    k = k + 1;
  }
}

/// The hash of everything every function's proof starts from: the proof
/// cache's format, the solver, the header and the preamble log[0..pre).
fn cache_base(v: &Vr, h: &Host, pre: u64) -> Hash2 {
  let mut t = vec_new[u64]();
  w_s(&mut t, "bastio-proof-cache-1\n");
  solver_name(h, &mut t);
  w_s(&mut t, "\n");
  // The solver's version: another Z3 may answer differently.
  let mut argv = vec_new[Bytes]();
  let mut cmd = balloc(0);
  if host_env(h, "BASTIO_SOLVER", &mut cmd) {
    vec_push(&mut argv, cmd);
  } else {
    bfree(cmd);
    push_arg(&mut argv, "z3");
  }
  push_arg(&mut argv, "--version");
  let ver = run_line(h, argv);
  let mut k = 0;
  while k < blen(ver) {
    vec_push(&mut t, cast[u64](bget(ver, k)));
    k = k + 1;
  }
  bfree(ver);
  w_s(&mut t, "\n");
  out_header(&mut t);
  out_range(&mut t, v, 0, pre);
  let r = hash_text(hash_new(), t);
  vec_free(t);
  return r;
}

/// As `solve`, with up to `jobs` solvers at once, as stage0 proves. Each
/// function goes to the solver with the least work so far (counted in
/// commands). A solver reads its functions from a file, so none waits for
/// this process to hand it the next; its answers are read in program
/// order, so the first function found failing is the first in program
/// order. Then the solvers are stopped, and that function is proved again
/// on a solver of its own, step by step, for its counterexample and notes:
/// the same report as `solve` gives. Without a temporary directory
/// (`mktemp -d`) the proofs run on one solver.
fn solve_par(v: &mut Vr, m: &Mono, p: &Parser, h: &Host, rep: &mut Vec[u64], jobs: u64) -> bool {
  let mut all = vec_new[Unit]();
  let pre = units_of(v, &mut all);
  // The functions that were proved before are left out. `paths` has, for
  // each function that remains, the cache file to write once it is
  // proved (empty if there is no cache or the function cannot be cached).
  let cdir = cache_dir(h);
  let mut us = vec_new[Unit]();
  let mut paths = vec_new[Bytes]();
  if blen(cdir) > 0 {
    let mut mk = vec_new[Bytes]();
    push_arg(&mut mk, "mkdir");
    push_arg(&mut mk, "-p");
    vec_push(&mut mk, copy_bytes(cdir));
    let c = host_spawn(h, mk);
    drop_argv(mk);
    child_wait(c);
  }
  let base = cache_base(v, h, pre);
  let mut a = 0;
  while a < vec_len(all) {
    let u = unit_at(all, a);
    let mut hit = false;
    let mut path = balloc(0);
    if blen(cdir) > 0 && !u.fail {
      let mut t = vec_new[u64]();
      out_range(&mut t, v, u.s, u.e);
      bfree(path);
      path = cache_path(cdir, hash_text(base, t));
      vec_free(t);
      hit = cache_hit(h, path);
    }
    if hit {
      bfree(path);
    } else {
      vec_push(&mut us, u);
      vec_push(&mut paths, path);
    }
    a = a + 1;
  }
  let had = vec_len(all);
  vec_free(all);
  bfree(cdir);
  if had > 0 && vec_len(us) == 0 {
    vec_free(us);
    drop_argv(paths);
    return true;
  }
  let n = vec_len(us);
  let mut dir = balloc(0);
  if jobs > 1 && n > 1 {
    let mut argv = vec_new[Bytes]();
    push_arg(&mut argv, "mktemp");
    push_arg(&mut argv, "-d");
    bfree(dir);
    dir = run_line(h, argv);
  }
  if blen(dir) == 0 {
    bfree(dir);
    vec_free(us);
    let whole = solve(&mut v, m, p, h, &mut rep);
    if whole {
      cache_record(h, &mut paths, vec_len(paths));
    }
    drop_argv(paths);
    return whole;
  }
  let mut nj = jobs;
  if nj > n {
    nj = n;
  }
  // Who proves each function.
  let mut owner = vec_new[u64]();
  let mut work = vec_new[u64]();
  let mut j = 0;
  while j < nj {
    vec_push(&mut work, 0);
    j = j + 1;
  }
  let mut k = 0;
  while k < n {
    let u = unit_at(us, k);
    let mut best = 0;
    j = 1;
    while j < nj {
      if u_at(work, j) < u_at(work, best) {
        best = j;
      }
      j = j + 1;
    }
    if best < vec_len(work) {
      let w = vadd(u_at(work, best), unit_len(u));
      vec_set(&mut work, best, w);
    }
    vec_push(&mut owner, best);
    k = k + 1;
  }
  vec_free(work);
  // Each solver's script, and the solver started on it. `sh` prints the
  // solver's process id first, so it can be stopped.
  let mut solver = balloc(0);
  if !host_env(h, "BASTIO_SOLVER", &mut solver) {
    bfree(solver);
    solver = bfrom("z3");
  }
  let mut zs = vec_new[Child]();
  let mut pids = vec_new[Bytes]();
  j = 0;
  while j < nj {
    let mut script = vec_new[u64]();
    out_header(&mut script);
    out_range(&mut script, v, 0, pre);
    k = 0;
    while k < n {
      if u_at(owner, k) == j {
        let u = unit_at(us, k);
        out_range(&mut script, v, u.s, u.e);
      }
      k = k + 1;
    }
    // `<dir>/<j>.smt2`
    let mut full = vec_new[u64]();
    k = 0;
    while k < blen(dir) {
      vec_push(&mut full, cast[u64](bget(dir, k)));
      k = k + 1;
    }
    w_s(&mut full, "/");
    w_num(&mut full, j);
    w_s(&mut full, ".smt2");
    let mut fb = balloc(vec_len(full));
    k = 0;
    while k < vec_len(full) && k < blen(fb) {
      let ch = u_at(full, k);
      if ch <= 255 {
        bset(&mut fb, k, cast[u8](ch));
      }
      k = k + 1;
    }
    vec_free(full);
    write_body(h, fb, script);
    vec_free(script);
    let mut argv = vec_new[Bytes]();
    push_arg(&mut argv, "sh");
    push_arg(&mut argv, "-c");
    push_arg(&mut argv, "echo $$; exec \"$0\" -smt2 \"$1\"");
    vec_push(&mut argv, copy_bytes(solver));
    vec_push(&mut argv, fb);
    let mut z = host_spawn(h, argv);
    drop_argv(argv);
    let mut pid = balloc(0);
    child_read_line(&mut z, &mut pid);
    vec_push(&mut pids, pid);
    vec_push(&mut zs, z);
    j = j + 1;
  }
  bfree(solver);
  let mut failed = n;
  let mut r = 0;
  while r < n && failed == n {
    let o = u_at(owner, r);
    if o < vec_len(zs) {
      let mut z = vec_swap(&mut zs, o, no_child(h));
      if !unit_holds(&mut z, unit_at(us, r)) {
        failed = r;
      }
      child_wait(vec_swap(&mut zs, o, z));
    }
    r = r + 1;
  }
  // The functions read as proved are recorded.
  cache_record(h, &mut paths, failed);
  drop_argv(paths);
  // Stop the solvers still working (after a failure), then wait for all.
  while vec_len(pids) > 0 {
    let pid = vec_pop(&mut pids);
    if failed < n && blen(pid) > 0 {
      let mut argv = vec_new[Bytes]();
      push_arg(&mut argv, "kill");
      vec_push(&mut argv, pid);
      let c = host_spawn(h, argv);
      drop_argv(argv);
      child_wait(c);
    } else {
      bfree(pid);
    }
  }
  vec_free(pids);
  while vec_len(zs) > 0 {
    z3_stop(vec_pop(&mut zs));
  }
  vec_free(zs);
  vec_free(owner);
  let mut argv = vec_new[Bytes]();
  push_arg(&mut argv, "rm");
  push_arg(&mut argv, "-rf");
  vec_push(&mut argv, dir);
  let rm = host_spawn(h, argv);
  drop_argv(argv);
  child_wait(rm);
  let mut ok = true;
  if failed < n {
    let u = unit_at(us, failed);
    let mut z = z3_start(h);
    send_range(v, &mut z, 0, pre);
    ok = solve_range(&mut v, m, p, &mut z, &mut rep, u.s, u.e, u.ob);
    z3_stop(z);
    if ok {
      // It held on its own (a query near the work limit): the whole log in
      // order decides.
      ok = solve(&mut v, m, p, h, &mut rep);
    }
  }
  vec_free(us);
  return ok;
}

/// Whether a failed proof of kind code shows the elements of short buffers
/// and vectors: a property that may be about them, not a bounds or
/// arithmetic error (stage0's `SHOW_ELEMS_FOR`).
fn shows_elems(code: u64) -> bool {
  return code == VC_ASSERT || code == VC_ENSURES || code == VC_INVARIANT || code == VC_INV_STEP || code == VC_LOCKINV || code == VC_REQUIRES;
}

/// The number written in t, if t is all digits and at most SHOW_ELEMS;
/// otherwise 0.
fn small_num(t: &Vec[u64]) -> u64 {
  if vec_len(t) == 0 || vec_len(t) > 2 {
    return 0;
  }
  let mut x = 0;
  let mut k = 0;
  while k < vec_len(t)
    invariant k <= 2 && x < 100 && (k == 0 ==> x == 0) && (k <= 1 ==> x < 10)
  {
    let ch = u_at(t, k);
    if ch < 48 || ch > 57 {
      return 0;
    }
    x = x * 10 + (ch - 48);
    k = k + 1;
  }
  if x > SHOW_ELEMS {
    return 0;
  }
  return x;
}

/// After a `sat`: asks for the value of each term shown and appends
/// `  = counterexample: a = 1, len(b) = 0` (nothing if no value is shown).
fn report_cex(v: &mut Vr, m: &Mono, p: &Parser, z: &mut Child, o: Obl, rep: &mut Vec[u64]) {
  let mut labs = vec_new[Lab]();
  let mut chars = vec_new[u64]();
  cex_labels(v, m, p, o, &mut labs, &mut chars);
  let mut out = vec_new[u64]();
  let mut resp = vec_new[u64]();
  let mut k = 0;
  while k < vec_len(labs) {
    let l = lab_at(labs, k);
    w_s(&mut out, "(get-value (");
    out_tm(&mut out, v, l.tm);
    w_s(&mut out, "))\n");
    z3_send(&mut z, &mut out);
    z3_read_value(&mut z, &mut resp);
    if k == 0 && o.code == VC_INV_STEP {
      w_s(&mut rep, "  = counterexample after one iteration: ");
    } else if k == 0 {
      w_s(&mut rep, "  = counterexample: ");
    } else {
      w_s(&mut rep, ", ");
    }
    out_rng(&mut rep, chars, Rng { s: l.s, e: vadd(l.s, l.n) });
    w_s(&mut rep, " = ");
    let mut val = vec_new[u64]();
    out_value(&mut val, resp);
    let len = small_num(val);
    out_rng(&mut rep, val, Rng { s: 0, e: vec_len(val) });
    vec_free(val);
    if l.seq > 0 && l.n > l.seq && len > 0 && len <= SHOW_ELEMS && shows_elems(o.code) {
      w_s(&mut rep, ", ");
      out_rng(&mut rep, chars, Rng { s: vadd(l.s, l.seq), e: vadd(l.s, l.n - 1) });
      w_s(&mut rep, " = [");
      let mut j = 0;
      while j < len {
        w_s(&mut out, "(get-value ((select ");
        out_tm(&mut out, v, l.arr);
        w_s(&mut out, " ");
        w_num(&mut out, j);
        w_s(&mut out, ")))\n");
        z3_send(&mut z, &mut out);
        z3_read_value(&mut z, &mut resp);
        if j > 0 {
          w_s(&mut rep, ", ");
        }
        out_value(&mut rep, resp);
        j = j + 1;
      }
      w_s(&mut rep, "]");
    }
    k = k + 1;
  }
  if vec_len(labs) > 0 {
    w_s(&mut rep, "\n");
  }
  vec_free(labs);
  vec_free(chars);
  vec_free(out);
  vec_free(resp);
}

/// Commands recorded before the solvers are run on them (see
/// `verify_batched`).
const SOLVE_BATCH: u64 = 200000;

/// `verify_program` and `solve_par` in batches: once a batch of functions
/// has recorded SOLVE_BATCH commands, they are proved, and everything made
/// for them is dropped, so the verifier's memory is that of one batch, not
/// of the whole program. The answer is the same: every function is proved
/// in its own scope after the same preamble, and the first function that
/// fails, in program order, is the one reported, since batches are proved
/// in order and later ones are not started. The dumps keep one log for
/// the whole program. True if every obligation holds.
fn verify_batched(v: &mut Vr, c: &Checker, m: &mut Mono, p: &Parser, h: &Host, rep: &mut Vec[u64], jobs: u64) -> bool {
  verify_begin(&mut v, c, &mut m, p);
  let mark = vr_mark(v);
  let n = vec_len(m.fns);
  let mut ok = true;
  let mut k = 0;
  while ok && k < n {
    verify_nth(&mut v, c, &mut m, p, k);
    k = k + 1;
    if k >= n || vec_len(v.log) >= vadd(mark.log, SOLVE_BATCH) {
      ok = solve_par(&mut v, m, p, h, &mut rep, jobs);
      if ok {
        vr_cut(&mut v, mark);
      }
    }
  }
  return ok;
}
