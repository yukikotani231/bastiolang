// The IR between the checker and the native backend (docs/ir.md): one
// function at a time, three-address code on virtual registers, with labels
// and jumps. This file is the first step of #125: the data, the lowering
// of the first subset (functions of integer and bool values: locals,
// arithmetic, comparisons, `if`, `while`, `return`, calls of such
// functions) and a text form for it (`irdump`). Nothing generates code from
// it yet; `x86.bastio` is unchanged.
//
// A function outside the subset is not an error: `ir_lower` reports it
// with the first thing it met that it does not handle yet, and the caller
// keeps using the old generator for it (docs/ir.md, "Getting there without
// a flag day").
//
// Values are 64-bit virtual registers; an operation that can wrap or
// depends on the width or sign of its operands carries the type in `ty`
// (as the checker recorded it for the operator node). Plain `+`, `-` and
// `*` are proved not to overflow, so they have no width.
import "codegen.bastio";
import "render.bastio";

// Operations. `d` is the register written, `a`, `b`, `c` the operands.
const IR_CONST: u64 = 1;     // d = a (an immediate)
const IR_MOV: u64 = 2;       // d = a
const IR_ADD: u64 = 3;      // (ADD, SUB and MUL with c = 1 wrap: the result is truncated to the integer type ty)
const IR_SUB: u64 = 4;
const IR_MUL: u64 = 5;
const IR_DIV: u64 = 6;       // unsigned
const IR_SDIV: u64 = 7;
const IR_REM: u64 = 8;
const IR_SREM: u64 = 9;
const IR_AND: u64 = 10;
const IR_OR: u64 = 11;
const IR_XOR: u64 = 12;
const IR_SHL: u64 = 13;
const IR_SHR: u64 = 14;      // logical
const IR_SAR: u64 = 15;      // arithmetic
const IR_NOT: u64 = 16;      // d = !a: the bits of a within the width of `ty`, or a bool
const IR_NEG: u64 = 17;
const IR_EQ: u64 = 20;
const IR_NE: u64 = 21;
const IR_LT: u64 = 22;       // unsigned
const IR_LE: u64 = 23;
const IR_GT: u64 = 24;
const IR_GE: u64 = 25;
const IR_SLT: u64 = 26;      // signed
const IR_SLE: u64 = 27;
const IR_SGT: u64 = 28;
const IR_SGE: u64 = 29;
const IR_LABEL: u64 = 40;    // label a starts here
const IR_JMP: u64 = 41;      // goto label a
const IR_BR: u64 = 42;       // if a goto label b else label c
const IR_RET: u64 = 43;      // return a, and b if a buffer (IR_NONE: nothing); with c > 0, a result of more than two words: the c words at address a, or, with a = IR_NONE, the c registers of args[b ..]
const IR_CALL: u64 = 44;     // d (and ty if a buffer) = instance a called with the c registers of args[b ..] (d = IR_NONE: no result)
const IR_UNREACH: u64 = 45;
const IR_LOAD: u64 = 46;     // d = the c-byte element a[b] (c is 1 or 8; a the data address, b the index)
const IR_STORE: u64 = 47;    // a[b] = d, c bytes (d is read here, not written)
const IR_ALLOC: u64 = 48;    // d = a new buffer's data address, n = a elements of c bytes (1 or 8); the length register is set by a separate mov
const IR_FREE: u64 = 49;     // frees the buffer whose data address is a
const IR_PRINT: u64 = 50;    // prints the number a
const IR_PUTC: u64 = 56;     // writes the byte a to the console (`serial_write`): a runtime call
const IR_GETC: u64 = 57;     // d = the next byte from the console (`serial_read`): a runtime call
const IR_WRAP: u64 = 51;     // d = a truncated to the integer type ty

const IR_SLOT: u64 = 52;     // d = the address of a frame slot of c words (one per instruction, allocated once per function however often it runs)
const IR_STRLIT: u64 = 55;   // d = the address of the bytes of the string literal or blob at syntax node a
const IR_CALLM: u64 = 54;    // d = the address of a frame slot of ty words that instance a, called with the c registers of args[b ..], fills with its result (a result of more than two words)
const IR_VGROW: u64 = 53;    // makes room in the Vec whose 3-word header is at address a (c = words per element): a runtime call that may change the header

const IR_NONE: u64 = 18446744073709551615;

/// In a `lent` entry, the third word at least this is a struct or enum of
/// that many words less this, held in registers.
const IR_LENT_WORDS: u64 = 1099511627776;

struct IrIns { op: u64, d: u64, a: u64, b: u64, c: u64, ty: u64 }

/// A variable in scope: its name in the source and its register.
struct IrVar { s: u64, e: u64, k: u64, r0: u64, r1: u64, t: u64 }

/// One function being lowered, and then lowered.
struct IrFn {
  /// The function instance.
  x: u64,
  /// Registers of the parameters, in order.
  params: Vec[u64],
  ins: Vec[IrIns],
  /// The argument registers of the calls.
  args: Vec[u64],
  nreg: u64,
  nlabel: u64,
  vars: Vec[IrVar],
  /// What stopped the lowering: set at the first thing not handled.
  failed: bool,
  why: Vec[u64],
  /// The `&mut Buf` / `&mut Bytes` parameters: per parameter its address, data and length registers.
  lent: Vec[u64],
  /// The line of the statement being lowered, and where the lowering failed.
  cur: u64,
  at: u64
}

fn ir_new(x: u64) -> IrFn {
  return IrFn { x: x, params: vec_new[u64](), ins: vec_new[IrIns](), args: vec_new[u64](), nreg: 0, nlabel: 0,
    vars: vec_new[IrVar](), failed: false, why: vec_new[u64](), lent: vec_new[u64](), cur: 0, at: 0 };
}

fn ir_free(f: IrFn) {
  vec_free(f.params);
  vec_free(f.ins);
  vec_free(f.args);
  vec_free(f.vars);
  vec_free(f.why);
  vec_free(f.lent);
}

fn ir_fail(f: &mut IrFn, why: Str) {
  if !f.failed {
    f.failed = true;
    f.at = f.cur;
    w_s(&mut f.why, why);
  }
}

fn ir_reg(f: &mut IrFn) -> u64 {
  let r = f.nreg;
  f.nreg = wrap_add(f.nreg, 1);
  return r;
}

fn ir_label(f: &mut IrFn) -> u64 {
  let l = f.nlabel;
  f.nlabel = wrap_add(f.nlabel, 1);
  return l;
}

fn ir_emit(f: &mut IrFn, op: u64, d: u64, a: u64, b: u64, c: u64, ty: u64) {
  vec_push(&mut f.ins, IrIns { op: op, d: d, a: a, b: b, c: c, ty: ty });
}

fn ir_place(f: &mut IrFn, l: u64) {
  ir_emit(&mut f, IR_LABEL, IR_NONE, l, 0, 0, 0);
}

fn ir_jump(f: &mut IrFn, l: u64) {
  ir_emit(&mut f, IR_JMP, IR_NONE, l, 0, 0, 0);
}

// ---- Lowering ----

// What a variable or value holds. A Buf or Bytes is two registers: the
// address of its data, then its length (the elements of a Buf are 8 bytes,
// those of Bytes one byte). A borrowed `&Buf` is the same two registers: the
// buffer cannot change under a shared borrow.
const IRK_INT: u64 = 1;
const IRK_BUF: u64 = 2;
const IRK_BYTES: u64 = 3;
// A `Str`: like a Bytes (data address, length), read-only.
const IRK_STR: u64 = 8;
// A `Box[T]`: one register, the address of the allocation (`t` is the Box type).
const IRK_BOX: u64 = 9;
const IRK_STRUCT: u64 = 4;
// An enum: its tag in `r0`, then the words of the largest payload, in
// consecutive registers like a struct (`r1` the count, `t` the type).
const IRK_ENUM: u64 = 6;
// A Vec: `r0` is the address of its three-word header (length, capacity,
// data address), in a frame slot or in the caller's, never in registers.
const IRK_VEC: u64 = 5;
// A struct or enum that stays in memory (a `&mut` parameter, a large `&`
// one, a field of such): `r0` is the register that holds the address of the
// value it is part of, `r1` the word offset from there (a constant), `t` its
// type. Fields are places too; reading a scalar, buffer or Vec field loads
// it, and writing one stores to it.
const IRK_PLACE: u64 = 7;

/// Is `k` a value held in several consecutive registers (a struct or an enum)?
fn ir_multi(k: u64) -> bool {
  return k == IRK_STRUCT || k == IRK_ENUM;
}

/// The registers a value of type `t` takes in the subset, or IR_NONE when
/// it is outside it: one for an integer or bool, two for a `Buf` or `Bytes`,
/// and for a struct the words of its fields in order (a struct is split
/// into registers, never held in memory). `depth` bounds the nesting.
fn ir_words(c: &Checker, m: &Mono, p: &Parser, t: u64, depth: u64) -> u64 {
  let u = base_t(m, t);
  let k = kind_t(m, u);
  if is_int(m, u) || k == TY_BOOL {
    return 1;
  }
  if k == TY_BUF || k == TY_BYTES || k == TY_STR {
    return 2;
  }
  if k == TY_BOX && ir_mw(c, m, p, inner_t(m, u), 0) != IR_NONE {
    return 1;
  }
  if k == TY_STRUCT && depth < 4 {
    let x = inner_t(m, u);
    let dn = def_node(m, p, x);
    let nf = list_len(p, dn.a);
    let mut s = 0;
    let mut j = 0;
    while j < nf && j < SRC_MAX {
      let w = ir_words(c, m, p, fld_ty(c, x, j), depth + 1);
      if w == IR_NONE {
        return IR_NONE;
      }
      s = wrap_add(s, w);
      j = j + 1;
    }
    if s == 0 || s > 64 {
      return IR_NONE;
    }
    return s;
  }
  if k == TY_ENUM && depth < 4 {
    let x = inner_t(m, u);
    let dn = def_node(m, p, x);
    let nf = list_len(p, dn.a);
    let mut best = 0;
    let mut j = 0;
    while j < nf && j < SRC_MAX {
      let ft = fld_ty(c, x, j);
      if ft != 0 {
        let w = ir_words(c, m, p, ft, depth + 1);
        if w == IR_NONE {
          return IR_NONE;
        }
        if w > best {
          best = w;
        }
      }
      j = j + 1;
    }
    if best > 63 {
      return IR_NONE;
    }
    return wrap_add(best, 1);
  }
  return IR_NONE;
}

/// The words a value of type `t` takes in memory, as `x86_words` counts them
/// (the layout the old generator and the IR share), or IR_NONE for a type the
/// IR does not know. `depth` bounds the nesting.
fn ir_mw(c: &Checker, m: &Mono, p: &Parser, t: u64, depth: u64) -> u64 {
  let u = base_t(m, t);
  let k = kind_t(m, u);
  if k == TY_UNIT {
    return 0;
  }
  if is_int(m, u) || k == TY_BOOL || k == TY_SERIAL || k == TY_HOST || k == TY_FRAME || k == TY_PT || k == TY_BOX || k == TY_MUTREF {
    return 1;
  }
  if k == TY_BUF || k == TY_BYTES || k == TY_STR || k == TY_POOL {
    return 2;
  }
  if k == TY_LOCK || k == TY_ATOMIC || k == TY_PORTS || k == TY_MMIOSPACE || k == TY_DMA || k == TY_MMU || k == TY_CPU || k == TY_LEASE || k == TY_SHARED || k == TY_DIRTY {
    return 1;
  }
  if k == TY_PORTIO || k == TY_MMIO {
    return 2;
  }
  if k == TY_VEC || k == TY_CHILD {
    return 3;
  }
  if (k == TY_STRUCT || k == TY_ENUM) && depth < 8 {
    let x = inner_t(m, u);
    let dn = def_node(m, p, x);
    let nf = list_len(p, dn.a);
    let mut s = 0;
    let mut j = 0;
    while j < nf && j < SRC_MAX {
      let ft = fld_ty(c, x, j);
      if k == TY_STRUCT {
        let w = ir_mw(c, m, p, ft, depth + 1);
        if w == IR_NONE {
          return IR_NONE;
        }
        s = wrap_add(s, w);
      } else if ft != 0 {
        let w = ir_mw(c, m, p, ft, depth + 1);
        if w == IR_NONE {
          return IR_NONE;
        }
        if w > s {
          s = w;
        }
      }
      j = j + 1;
    }
    if k == TY_ENUM {
      return wrap_add(s, 1);
    }
    return s;
  }
  return IR_NONE;
}

/// The kind of values of type `t` in the subset, or 0.
fn ir_kind(c: &Checker, m: &Mono, p: &Parser, t: u64) -> u64 {
  let u = base_t(m, t);
  if is_int(m, u) || kind_t(m, u) == TY_BOOL || kind_t(m, u) == TY_SERIAL {
    return IRK_INT;
  }
  if kind_t(m, u) == TY_BOX && ir_mw(c, m, p, inner_t(m, u), 0) != IR_NONE {
    return IRK_BOX;
  }
  if kind_t(m, u) == TY_BUF {
    return IRK_BUF;
  }
  if kind_t(m, u) == TY_BYTES {
    return IRK_BYTES;
  }
  if kind_t(m, u) == TY_STR {
    return IRK_STR;
  }
  if kind_t(m, u) == TY_STRUCT && ir_words(c, m, p, u, 0) != IR_NONE {
    return IRK_STRUCT;
  }
  if kind_t(m, u) == TY_ENUM && ir_words(c, m, p, u, 0) != IR_NONE {
    return IRK_ENUM;
  }
  if kind_t(m, u) == TY_VEC {
    let ew = ir_mw(c, m, p, inner_t(m, u), 0);
    if ew != IR_NONE && ew > 0 && ew < 64 {
      return IRK_VEC;
    }
  }
  return 0;
}

/// The words of a struct that the IR cannot hold in registers (a Vec or a
/// handle is in it) but keeps in memory, in a frame slot, or 0 for any other
/// type. At least three words: a smaller one travels in registers.
fn ir_ms(c: &Checker, m: &Mono, p: &Parser, t: u64) -> u64 {
  let u = base_t(m, t);
  if (kind_t(m, u) == TY_STRUCT || kind_t(m, u) == TY_ENUM) && ir_kind(c, m, p, u) == 0 {
    let w = ir_mw(c, m, p, u, 0);
    if w != IR_NONE && w >= 3 && w <= 512 {
      return w;
    }
  }
  return 0;
}

/// A value: its register, and the second one of a Buf or Bytes (IR_NONE
/// for an integer); `k` is its kind (0 after a failure).
struct IrVal { k: u64, r0: u64, r1: u64, t: u64 }

fn ir_none() -> IrVal {
  return IrVal { k: 0, r0: IR_NONE, r1: IR_NONE, t: 0 };
}

fn ir_bind(f: &mut IrFn, s: u64, e: u64, v: IrVal) {
  vec_push(&mut f.vars, IrVar { s: s, e: e, k: v.k, r0: v.r0, r1: v.r1, t: v.t });
}

/// The variable named `s..e`, the innermost one (k == 0: none).
fn ir_find(f: &IrFn, p: &Parser, s: u64, e: u64) -> IrVal {
  let mut k = vec_len(f.vars);
  while k > 0
    invariant k <= vlen(f.vars)
  {
    k = k - 1;
    let v = vec_get(f.vars, k);
    if same(p.src, v.s, v.e, s, e) {
      return IrVal { k: v.k, r0: v.r0, r1: v.r1, t: v.t };
    }
  }
  return ir_none();
}

fn ir_truncate(f: &mut IrFn, n: u64) {
  while vec_len(f.vars) > n {
    vec_pop(&mut f.vars);
  }
}

/// The `t` of a Vec value: the element type, and whether the address is part
/// of a place (a Vec read out of a place is the place's own header).
fn ir_vt(et: u64, alias: u64) -> u64 {
  return wrap_add(wrap_mul(et, 2), alias);
}

/// The element type of Vec value `v`.
fn ir_velem(v: IrVal) -> u64 {
  return v.t / 2;
}

/// New registers for a value of kind `k`; a struct of `w` words and type
/// `t` takes `w` consecutive ones.
fn ir_new_val(f: &mut IrFn, k: u64, w: u64, t: u64) -> IrVal {
  let r0 = ir_reg(&mut f);
  if k == IRK_INT {
    return IrVal { k: k, r0: r0, r1: IR_NONE, t: 0 };
  }
  if k == IRK_BOX {
    return IrVal { k: k, r0: r0, r1: IR_NONE, t: t };
  }
  if k == IRK_VEC {
    // The element type stays; the alias mark does not.
    return IrVal { k: k, r0: r0, r1: IR_NONE, t: wrap_mul(t / 2, 2) };
  }
  if ir_multi(k) {
    let mut j = 1;
    while j < w && j < 64 {
      ir_reg(&mut f);
      j = j + 1;
    }
    return IrVal { k: k, r0: r0, r1: w, t: t };
  }
  let r1 = ir_reg(&mut f);
  return IrVal { k: k, r0: r0, r1: r1, t: 0 };
}

fn ir_fresh(f: &mut IrFn, k: u64) -> IrVal {
  return ir_new_val(&mut f, k, 0, 0);
}

/// New registers for a value like `v`.
fn ir_like(f: &mut IrFn, v: IrVal) -> IrVal {
  return ir_new_val(&mut f, v.k, v.r1, v.t);
}

/// dst = src, word by word.
fn ir_copy(f: &mut IrFn, dst: IrVal, src: IrVal) {
  if ir_multi(dst.k) {
    let mut j = 0;
    while j < dst.r1 && j < 64 {
      ir_emit(&mut f, IR_MOV, wrap_add(dst.r0, j), wrap_add(src.r0, j), 0, 0, 0);
      j = j + 1;
    }
    return;
  }
  ir_emit(&mut f, IR_MOV, dst.r0, src.r0, 0, 0, 0);
  if dst.r1 != IR_NONE {
    ir_emit(&mut f, IR_MOV, dst.r1, src.r1, 0, 0, 0);
  }
}

/// The payload of variant number `v` of enum value `e`: the registers after
/// the tag, seen as a value of the payload's type.
fn ir_payload(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, e: IrVal, v: u64) -> IrVal {
  let ft = fld_ty(c, inner_t(m, e.t), v);
  let fk = ir_kind(c, m, p, ft);
  let r = wrap_add(e.r0, 1);
  if fk == IRK_INT {
    return IrVal { k: fk, r0: r, r1: IR_NONE, t: 0 };
  }
  if fk == IRK_BOX {
    return IrVal { k: fk, r0: r, r1: IR_NONE, t: base_t(m, ft) };
  }
  if fk == IRK_BUF || fk == IRK_BYTES || fk == IRK_STR {
    return IrVal { k: fk, r0: wrap_add(r, 1), r1: r, t: 0 };
  }
  if ir_multi(fk) {
    return IrVal { k: fk, r0: r, r1: ir_words(c, m, p, ft, 1), t: ft };
  }
  ir_fail(&mut f, "a payload outside the subset");
  return ir_none();
}

/// Field `s..e` of struct value `v`: the registers it occupies.
fn ir_field(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, v: IrVal, s: u64, e: u64) -> IrVal {
  if v.k == IRK_PLACE {
    return ir_pfield(&mut f, c, m, p, v, s, e);
  }
  if v.k == IRK_BOX {
    // A field through a Box is a field of the struct it points to.
    let place = IrVal { k: IRK_PLACE, r0: v.r0, r1: 0, t: base_t(m, inner_t(m, v.t)) };
    return ir_pfield(&mut f, c, m, p, place, s, e);
  }
  if v.k != IRK_STRUCT {
    ir_fail(&mut f, "a field of something that is not a struct");
    return ir_none();
  }
  let x = inner_t(m, v.t);
  let dn = def_node(m, p, x);
  let j = index_in(p, dn.a, s, e);
  if j == 0 {
    ir_fail(&mut f, "a field that is not there");
    return ir_none();
  }
  let mut off = 0;
  let mut q = 0;
  while q < SRC_MAX && wrap_add(q, 1) < j {
    off = wrap_add(off, ir_words(c, m, p, fld_ty(c, x, q), 1));
    q = q + 1;
  }
  let ft = fld_ty(c, x, j - 1);
  let fk = ir_kind(c, m, p, ft);
  if fk == IRK_INT {
    return IrVal { k: fk, r0: wrap_add(v.r0, off), r1: IR_NONE, t: 0 };
  }
  if fk == IRK_BOX {
    return IrVal { k: fk, r0: wrap_add(v.r0, off), r1: IR_NONE, t: base_t(m, ft) };
  }
  if fk == IRK_BUF || fk == IRK_BYTES || fk == IRK_STR {
    // In memory, and so in the registers of a struct, a buffer is its
    // length then its data address.
    return IrVal { k: fk, r0: wrap_add(v.r0, wrap_add(off, 1)), r1: wrap_add(v.r0, off), t: 0 };
  }
  if ir_multi(fk) {
    return IrVal { k: fk, r0: wrap_add(v.r0, off), r1: ir_words(c, m, p, ft, 1), t: ft };
  }
  ir_fail(&mut f, "a field outside the subset");
  return ir_none();
}


/// The IR operation of binary operator `op` on operands of the type kind
/// `signed` says, or 0 for one outside the subset.
fn ir_binop(op: u64, signed: bool) -> u64 {
  if op == P_PLUS { return IR_ADD; }
  if op == P_MINUS { return IR_SUB; }
  if op == P_STAR { return IR_MUL; }
  if op == P_SLASH { if signed { return IR_SDIV; } return IR_DIV; }
  if op == P_PERCENT { if signed { return IR_SREM; } return IR_REM; }
  if op == P_AMP { return IR_AND; }
  if op == P_PIPE { return IR_OR; }
  if op == P_CARET { return IR_XOR; }
  if op == P_SHL { return IR_SHL; }
  if op == P_SHR { if signed { return IR_SAR; } return IR_SHR; }
  if op == P_EQEQ { return IR_EQ; }
  if op == P_NE { return IR_NE; }
  if op == P_LT { if signed { return IR_SLT; } return IR_LT; }
  if op == P_LE { if signed { return IR_SLE; } return IR_LE; }
  if op == P_GT { if signed { return IR_SGT; } return IR_GT; }
  if op == P_GE { if signed { return IR_SGE; } return IR_GE; }
  return 0;
}

/// Condition `i` as control flow: goes to `lt` when it holds and `lf` when
/// it does not, without materialising `&&`, `||` and `!` of booleans in a
/// register.
fn ir_branch(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64, lt: u64, lf: u64) {
  let n = node_at(p.nodes, i);
  if n.kind == E_BIN && (n.v == P_ANDAND || n.v == P_OROR) {
    let mid = ir_label(&mut f);
    if n.v == P_ANDAND {
      ir_branch(&mut f, c, &mut m, p, n.a, mid, lf);
    } else {
      ir_branch(&mut f, c, &mut m, p, n.a, lt, mid);
    }
    ir_place(&mut f, mid);
    ir_branch(&mut f, c, &mut m, p, n.b, lt, lf);
    return;
  }
  if n.kind == E_NOT && cg_int_op(c, f.x, i) == 0 {
    ir_branch(&mut f, c, &mut m, p, n.a, lf, lt);
    return;
  }
  let cond = ir_int(&mut f, c, &mut m, p, i);
  ir_emit(&mut f, IR_BR, IR_NONE, cond, lt, lf, 0);
}

/// An integer expression: its register.
fn ir_int(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  let v = ir_expr(&mut f, c, &mut m, p, i);
  if !f.failed && v.k != IRK_INT {
    ir_fail(&mut f, "a buffer where an integer is expected");
    return IR_NONE;
  }
  return v.r0;
}

/// A Buf or Bytes expression: a variable (or a call that returns one).
fn ir_buf(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64, k: u64) -> IrVal {
  let v = ir_expr(&mut f, c, &mut m, p, i);
  if !f.failed && v.k != k {
    ir_fail(&mut f, "a buffer of another kind");
    return ir_none();
  }
  return v;
}

/// The enum value built by variant node `i` of enum instance `x`.
fn ir_variant(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64, x: u64) -> IrVal {
  let n = node_at(p.nodes, i);
  let t = intern(&mut m, p, TY_ENUM, x);
  let mw = ir_ms(c, m, p, t);
  if mw > 0 {
    // An enum the IR keeps in memory: the tag, then the payload, in a frame
    // slot of ours.
    let slot = ir_reg(&mut f);
    ir_emit(&mut f, IR_SLOT, slot, 0, 0, mw, 0);
    let out = IrVal { k: IRK_PLACE, r0: slot, r1: 0, t: base_t(m, t) };
    let v = cg_variant(m, p, x, n.s2, n.e2);
    let tag = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, tag, v, 0, 0, 0);
    ir_hdr_store(&mut f, slot, 0, tag);
    if n.a != 0 {
      let pv = ir_vexpr(&mut f, c, &mut m, p, n.a);
      let ft = fld_ty(c, x, v);
      if !f.failed && ft != 0 {
        let dst = IrVal { k: IRK_PLACE, r0: slot, r1: 1, t: base_t(m, ft) };
        ir_store_val(&mut f, c, m, p, dst, pv);
      }
    }
    return out;
  }
  if ir_kind(c, m, p, t) != IRK_ENUM {
    ir_fail(&mut f, "an enum outside the subset");
    return ir_none();
  }
  let out = ir_new_val(&mut f, IRK_ENUM, ir_words(c, m, p, t, 0), t);
  let v = cg_variant(m, p, x, n.s2, n.e2);
  ir_emit(&mut f, IR_CONST, out.r0, v, 0, 0, 0);
  // The payload words no variant uses are defined too.
  let mut z = 1;
  while z < out.r1 && z < 64 {
    ir_emit(&mut f, IR_CONST, wrap_add(out.r0, z), 0, 0, 0, 0);
    z = z + 1;
  }
  if n.a != 0 {
    let pv = ir_vexpr(&mut f, c, &mut m, p, n.a);
    let dst = ir_payload(&mut f, c, m, p, out, v);
    if !f.failed {
      if pv.k != dst.k {
        ir_fail(&mut f, "a payload of another kind");
      } else {
        ir_copy(&mut f, dst, pv);
      }
    }
  }
  return out;
}

/// The struct value built by literal node `i` of struct instance `x`.
fn ir_slit(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64, x: u64) -> IrVal {
  let n = node_at(p.nodes, i);
  let t = intern(&mut m, p, TY_STRUCT, x);
  let mw = ir_ms(c, m, p, t);
  if mw > 0 {
    // Built in place in a frame slot of ours.
    let slot = ir_reg(&mut f);
    ir_emit(&mut f, IR_SLOT, slot, 0, 0, mw, 0);
    let out = IrVal { k: IRK_PLACE, r0: slot, r1: 0, t: base_t(m, t) };
    let mut q = n.a;
    while q != 0 && !f.failed {
      let fi = node_at(p.nodes, q);
      let dst = ir_pfield(&mut f, c, m, p, out, fi.s, fi.e);
      let v = ir_vexpr(&mut f, c, &mut m, p, fi.a);
      if !f.failed {
        ir_store_val(&mut f, c, m, p, dst, v);
      }
      q = fi.next;
    }
    return out;
  }
  if ir_kind(c, m, p, t) != IRK_STRUCT {
    ir_fail(&mut f, "a struct outside the subset");
    return ir_none();
  }
  let out = ir_new_val(&mut f, IRK_STRUCT, ir_words(c, m, p, t, 0), t);
  let mut q = n.a;
  while q != 0 && !f.failed {
    let fi = node_at(p.nodes, q);
    let dst = ir_field(&mut f, c, m, p, out, fi.s, fi.e);
    let v = ir_vexpr(&mut f, c, &mut m, p, fi.a);
    if !f.failed {
      if v.k != dst.k {
        ir_fail(&mut f, "a field initializer of another kind");
      } else {
        ir_copy(&mut f, dst, v);
      }
    }
    q = fi.next;
  }
  return out;
}

/// Is expression `e` the place that assignment path `path` names (`q.st` in
/// `q.st = set(q.st, i, v)`)?
fn ir_is_path(p: &Parser, e: u64, path: Node) -> bool {
  let mut segs = vec_new[u64]();
  let mut seg = path.next;
  while seg != 0 && vec_len(segs) < 64 {
    vec_push(&mut segs, seg);
    let sn = node_at(p.nodes, seg);
    seg = sn.next;
  }
  let mut cur = e;
  let mut ok = e != 0;
  let mut j = vec_len(segs);
  while j > 0 && ok
    invariant j <= vlen(segs)
  {
    j = j - 1;
    let en = node_at(p.nodes, cur);
    let sn = node_at(p.nodes, u_at(segs, j));
    if en.kind != E_FIELD || !same(p.src, en.s, en.e, sn.s, sn.e) {
      ok = false;
    } else {
      cur = en.a;
    }
  }
  if ok {
    let en = node_at(p.nodes, cur);
    ok = en.kind == E_VAR && same(p.src, en.s, en.e, path.s, path.e);
  }
  vec_free(segs);
  return ok;
}

/// Lowers expression `i`; returns the registers that hold its value.
fn ir_expr(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  if f.failed {
    return ir_none();
  }
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_INT || k == E_BOOL {
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, d, n.v, 0, 0, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if k == E_VAR {
    let v = ir_find(f, p, n.s, n.e);
    if v.k == 0 {
      ir_fail(&mut f, "a name that is not a scalar or buffer variable");
    }
    return ir_rv(&mut f, c, m, p, v);
  }
  if k == E_STR || k == E_BLOB {
    let mut len = n.v;
    if k == E_STR {
      len = 0;
      if n.s <= n.e && n.e <= blen(p.src) {
        let bytes = decode(p.src, n.s, n.e);
        len = blen(bytes);
        bfree(bytes);
      }
    }
    let a = ir_reg(&mut f);
    ir_emit(&mut f, IR_STRLIT, a, i, 0, 0, 0);
    let l = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, l, len, 0, 0, 0);
    return IrVal { k: IRK_STR, r0: a, r1: l, t: 0 };
  }
  if k == E_NEG || k == E_NOT {
    let a = ir_int(&mut f, c, &mut m, p, n.a);
    let d = ir_reg(&mut f);
    let mut op = IR_NOT;
    if k == E_NEG {
      op = IR_NEG;
    }
    ir_emit(&mut f, op, d, a, 0, 0, cg_int_op(c, f.x, i));
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if k == E_BIN && (n.v == P_ANDAND || n.v == P_OROR) {
    // The right operand runs only if the left does not decide the result.
    let d = ir_reg(&mut f);
    let a = ir_int(&mut f, c, &mut m, p, n.a);
    ir_emit(&mut f, IR_MOV, d, a, 0, 0, 0);
    let rhs = ir_label(&mut f);
    let end = ir_label(&mut f);
    if n.v == P_ANDAND {
      ir_emit(&mut f, IR_BR, IR_NONE, d, rhs, end, 0);
    } else {
      ir_emit(&mut f, IR_BR, IR_NONE, d, end, rhs, 0);
    }
    ir_place(&mut f, rhs);
    let b = ir_int(&mut f, c, &mut m, p, n.b);
    ir_emit(&mut f, IR_MOV, d, b, 0, 0, 0);
    ir_place(&mut f, end);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if k == E_BIN {
    let t = cg_int_op(c, f.x, i);
    let op = ir_binop(n.v, t != 0 && is_signed(m, t));
    if op == 0 {
      ir_fail(&mut f, "an operator outside the first subset");
      return ir_none();
    }
    let a = ir_int(&mut f, c, &mut m, p, n.a);
    let b = ir_int(&mut f, c, &mut m, p, n.b);
    let d = ir_reg(&mut f);
    ir_emit(&mut f, op, d, a, b, 0, t);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if k == E_CALL {
    return ir_call(&mut f, c, &mut m, p, i);
  }
  if k == E_TAPP && name_is(p, n.b, "vec_new") {
    let et = conv(&mut m, p, n.a, f.x, i);
    let ew = ir_mw(c, m, p, et, 0);
    if ew == IR_NONE || ew == 0 || ew >= 64 {
      ir_fail(&mut f, "a vector of elements the IR does not know");
      return ir_none();
    }
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_SLOT, d, 0, 0, 3, 0);
    let zero = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, zero, 0, 0, 0, 0);
    ir_hdr_store(&mut f, d, 0, zero);
    ir_hdr_store(&mut f, d, 1, zero);
    ir_hdr_store(&mut f, d, 2, zero);
    return IrVal { k: IRK_VEC, r0: d, r1: IR_NONE, t: ir_vt(et, 0) };
  }
  if k == E_MUTBORROW {
    let path = node_at(p.nodes, n.a);
    let mut v = ir_find(f, p, path.s, path.e);
    let mut seg = path.next;
    while seg != 0 && v.k == IRK_PLACE && !f.failed {
      let sn = node_at(p.nodes, seg);
      v = ir_field(&mut f, c, m, p, v, sn.s, sn.e);
      seg = sn.next;
    }
    if f.failed {
      return ir_none();
    }
    if v.k == IRK_PLACE {
      let uk = kind_t(m, base_t(m, v.t));
      if uk == TY_STRUCT || uk == TY_ENUM {
        return v;
      }
      if ir_kind(c, m, p, base_t(m, v.t)) == IRK_INT {
        // A scalar field in memory: lent by its address.
        return v;
      }
      v = ir_rv(&mut f, c, m, p, v);
    }
    if seg == 0 && (v.k == IRK_INT || v.k == IRK_BUF || v.k == IRK_BYTES || ir_multi(v.k)) {
      // A lent buffer stays the caller's: it is never freed or replaced
      // while lent, so its registers stay valid.
      return v;
    }
    if seg != 0 || v.k != IRK_VEC {
      ir_fail(&mut f, "a borrow of something that is not a vector or a struct in memory");
      return ir_none();
    }
    return v;
  }
  if k == E_VARIANT {
    let def = find_in(p, p.enums.head, i);
    let dnode = node_at(p.nodes, def);
    if def == 0 || dnode.v != 0 {
      ir_fail(&mut f, "a variant of a generic enum");
      return ir_none();
    }
    let x = plain_inst(&mut m, def);
    return ir_variant(&mut f, c, &mut m, p, i, x);
  }
  if k == E_TAPP && kind_of(p, n.b) == E_CALL && !is_typed_builtin(p, n.b) {
    // `f[T](args)`: the instance the monomorphizer made.
    let callee = tapp_inst(&mut m, p, i, f.x);
    if callee == 0 {
      ir_fail(&mut f, "a call of a generic function");
      return ir_none();
    }
    return ir_call_to(&mut f, c, &mut m, p, n.b, callee);
  }
  if k == E_TAPP && kind_of(p, n.b) == E_VARIANT {
    // `Option[u64]::Some(x)`: the instance the monomorphizer made.
    let x = tapp_inst(&mut m, p, i, f.x);
    if x == 0 {
      ir_fail(&mut f, "a variant of a generic enum");
      return ir_none();
    }
    return ir_variant(&mut f, c, &mut m, p, n.b, x);
  }
  if k == E_IS {
    let e0 = ir_expr(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return ir_none();
    }
    if e0.k == IRK_PLACE && kind_t(m, base_t(m, e0.t)) == TY_ENUM {
      // The tag is the first word.
      let v = cg_variant(m, p, inner_t(m, base_t(m, e0.t)), n.s2, n.e2);
      let tag = ir_hdr_load(&mut f, e0.r0, e0.r1);
      let kr = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, kr, v, 0, 0, 0);
      let d = ir_reg(&mut f);
      ir_emit(&mut f, IR_EQ, d, tag, kr, 0, 0);
      return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
    }
    let e = ir_val(&mut f, c, m, p, e0);
    if f.failed {
      return ir_none();
    }
    if e.k != IRK_ENUM {
      ir_fail(&mut f, "`is` on something that is not an enum");
      return ir_none();
    }
    let v = cg_variant(m, p, inner_t(m, e.t), n.s2, n.e2);
    let kr = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, kr, v, 0, 0, 0);
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_EQ, d, e.r0, kr, 0, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if k == E_FIELD {
    let b = ir_expr(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return ir_none();
    }
    let fv = ir_field(&mut f, c, m, p, b, n.s, n.e);
    if f.failed {
      return ir_none();
    }
    return ir_rv(&mut f, c, m, p, fv);
  }
  if k == E_SLIT {
    let def = find_in(p, p.structs.head, i);
    let dnode = node_at(p.nodes, def);
    if def == 0 || dnode.v != 0 {
      ir_fail(&mut f, "a literal of a generic struct");
      return ir_none();
    }
    return ir_slit(&mut f, c, &mut m, p, i, plain_inst(&mut m, def));
  }
  if k == E_TAPP && kind_of(p, n.b) == E_SLIT {
    // `Pair[u64, bool] { .. }`: the instance the monomorphizer made.
    let x = tapp_inst(&mut m, p, i, f.x);
    if x == 0 {
      ir_fail(&mut f, "a literal of a generic struct");
      return ir_none();
    }
    return ir_slit(&mut f, c, &mut m, p, n.b, x);
  }
  // `cast[T](x)` is proved to fit, so the value is unchanged; `wrap[T](x)`
  // keeps the low bits.
  if k == E_TAPP && (name_is(p, n.b, "cast") || name_is(p, n.b, "wrap")) {
    let inner = node_at(p.nodes, n.b);
    let a = ir_int(&mut f, c, &mut m, p, inner.a);
    let d = ir_reg(&mut f);
    if name_is(p, n.b, "wrap") {
      let t = conv(&mut m, p, n.a, f.x, i);
      ir_emit(&mut f, IR_WRAP, d, a, 0, 0, t);
    } else {
      ir_emit(&mut f, IR_MOV, d, a, 0, 0, 0);
    }
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  let first = !f.failed;
  ir_fail(&mut f, "an expression outside the first subset");
  if first {
    w_s(&mut f.why, " (node kind ");
    w_num(&mut f.why, k);
    w_s(&mut f.why, ")");
  }
  return ir_none();
}

/// The data address of buffer `v` plus index register `ix`, scaled by the
/// element size, is the element: loads and stores name both registers.
fn ir_elem(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  // get(b, ix) / bget(b, ix): the buffer, then the index in r1... see the
  // callers: the buffer's data register is returned in r0, the index in r1.
  let n = node_at(p.nodes, i);
  let a0 = n.a;
  let a1 = next_of(p, a0);
  let mut kind = IRK_BUF;
  if name_is(p, i, "bget") || name_is(p, i, "bset") {
    kind = IRK_BYTES;
  } else if name_is(p, i, "sget") {
    kind = IRK_STR;
  }
  let b = ir_buf(&mut f, c, &mut m, p, a0, kind);
  let ix = ir_int(&mut f, c, &mut m, p, a1);
  return IrVal { k: kind, r0: b.r0, r1: ix, t: 0 };
}

/// Stores the `w` words in the consecutive registers from `r` at the memory
/// at address register `a`, from word `off` on.
fn ir_store_words(f: &mut IrFn, a: u64, off: u64, r: u64, w: u64) {
  let mut j = 0;
  while j < w && j < 64 {
    ir_hdr_store(&mut f, a, wrap_add(off, j), wrap_add(r, j));
    j = j + 1;
  }
}

/// Loads `w` words from address register `a`, from word `off` on, into the
/// consecutive registers from `r`.
fn ir_load_words(f: &mut IrFn, a: u64, off: u64, r: u64, w: u64) {
  let mut j = 0;
  while j < w && j < 64 {
    let kr = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, kr, wrap_add(off, j), 0, 0, 0);
    ir_emit(&mut f, IR_LOAD, wrap_add(r, j), a, kr, 8, 0);
    j = j + 1;
  }
}

/// The register that holds the address of place `v`.
fn ir_paddr(f: &mut IrFn, v: IrVal) -> u64 {
  if v.r1 == 0 {
    return v.r0;
  }
  let k = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, k, wrap_mul(8, v.r1), 0, 0, 0);
  let d = ir_reg(&mut f);
  ir_emit(&mut f, IR_ADD, d, v.r0, k, 0, 0);
  return d;
}

/// Field `s..e` of the struct in memory at place `v`: the place of the field.
fn ir_pfield(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, v: IrVal, s: u64, e: u64) -> IrVal {
  let u = base_t(m, v.t);
  if kind_t(m, u) != TY_STRUCT {
    ir_fail(&mut f, "a field of something that is not a struct");
    return ir_none();
  }
  let x = inner_t(m, u);
  let dn = def_node(m, p, x);
  let j = index_in(p, dn.a, s, e);
  if j == 0 {
    ir_fail(&mut f, "a field that is not there");
    return ir_none();
  }
  let mut off = 0;
  let mut q = 0;
  while q < SRC_MAX && wrap_add(q, 1) < j {
    let w = ir_mw(c, m, p, fld_ty(c, x, q), 0);
    if w == IR_NONE {
      ir_fail(&mut f, "a field of a type the IR does not know");
      return ir_none();
    }
    off = wrap_add(off, w);
    q = q + 1;
  }
  return IrVal { k: IRK_PLACE, r0: v.r0, r1: wrap_add(v.r1, off), t: base_t(m, fld_ty(c, x, j - 1)) };
}

/// The value read from place `v`, when it is a scalar (loaded), a buffer
/// (its two words loaded) or a Vec (the address of its header, marked `t` = 1
/// as part of the place); a struct or enum stays a place.
fn ir_rv(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, v: IrVal) -> IrVal {
  if v.k != IRK_PLACE {
    return v;
  }
  let k = ir_kind(c, m, p, v.t);
  if k == IRK_INT {
    return IrVal { k: IRK_INT, r0: ir_hdr_load(&mut f, v.r0, v.r1), r1: IR_NONE, t: 0 };
  }
  if k == IRK_BOX {
    return IrVal { k: IRK_BOX, r0: ir_hdr_load(&mut f, v.r0, v.r1), r1: IR_NONE, t: base_t(m, v.t) };
  }
  if k == IRK_BUF || k == IRK_BYTES || k == IRK_STR {
    let len = ir_hdr_load(&mut f, v.r0, v.r1);
    let data = ir_hdr_load(&mut f, v.r0, wrap_add(v.r1, 1));
    return IrVal { k: k, r0: data, r1: len, t: 0 };
  }
  if k == IRK_VEC {
    return IrVal { k: IRK_VEC, r0: ir_paddr(&mut f, v), r1: IR_NONE, t: ir_vt(inner_t(m, base_t(m, v.t)), 1) };
  }
  return v;
}

/// Like `ir_rv`, and a struct or enum in memory is loaded into registers
/// (when the IR holds that type in registers).
fn ir_val(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, v: IrVal) -> IrVal {
  if v.k != IRK_PLACE {
    return v;
  }
  let r = ir_rv(&mut f, c, m, p, v);
  if r.k != IRK_PLACE {
    return r;
  }
  let k = ir_kind(c, m, p, v.t);
  if ir_multi(k) {
    let w = ir_words(c, m, p, v.t, 0);
    let d = ir_new_val(&mut f, k, w, v.t);
    ir_load_words(&mut f, v.r0, v.r1, d.r0, w);
    return d;
  }
  if ir_ms(c, m, p, v.t) > 0 {
    return v;
  }
  ir_fail(&mut f, "a struct or enum held in memory used as a value");
  return ir_none();
}

/// Expression `i` as a value (see `ir_val`).
fn ir_vexpr(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  let v = ir_expr(&mut f, c, &mut m, p, i);
  if f.failed {
    return ir_none();
  }
  return ir_val(&mut f, c, m, p, v);
}

/// `v` stored to place `d`.
fn ir_store_val(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, d: IrVal, v: IrVal) {
  let k = ir_kind(c, m, p, d.t);
  let mw = ir_ms(c, m, p, d.t);
  if k == 0 && mw > 0 && v.k == IRK_PLACE {
    // A struct held in memory: its words, one by one.
    let mut j = 0;
    while j < mw {
      let kr = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, kr, wrap_add(v.r1, j), 0, 0, 0);
      let w = ir_reg(&mut f);
      ir_emit(&mut f, IR_LOAD, w, v.r0, kr, 8, 0);
      ir_hdr_store(&mut f, d.r0, wrap_add(d.r1, j), w);
      j = j + 1;
    }
    return;
  }
  if k == 0 || v.k != k {
    ir_fail(&mut f, "a store between kinds");
    return;
  }
  if k == IRK_INT || k == IRK_BOX {
    ir_hdr_store(&mut f, d.r0, d.r1, v.r0);
  } else if k == IRK_BUF || k == IRK_BYTES || k == IRK_STR {
    ir_hdr_store(&mut f, d.r0, d.r1, v.r1);
    ir_hdr_store(&mut f, d.r0, wrap_add(d.r1, 1), v.r0);
  } else if k == IRK_VEC {
    let mut j = 0;
    while j < 3 {
      let w = ir_hdr_load(&mut f, v.r0, j);
      ir_hdr_store(&mut f, d.r0, wrap_add(d.r1, j), w);
      j = j + 1;
    }
  } else {
    ir_store_words(&mut f, d.r0, d.r1, v.r0, v.r1);
  }
}

/// A Vec read out of a place is the place's own header; a Vec that is kept
/// (bound, assigned) is a copy of it in a slot of ours.
fn ir_own(f: &mut IrFn, v: IrVal) -> IrVal {
  if v.k != IRK_VEC || v.t % 2 != 1 {
    return v;
  }
  let slot = ir_reg(&mut f);
  ir_emit(&mut f, IR_SLOT, slot, 0, 0, 3, 0);
  let mut j = 0;
  while j < 3 {
    let w = ir_hdr_load(&mut f, v.r0, j);
    ir_hdr_store(&mut f, slot, j, w);
    j = j + 1;
  }
  return IrVal { k: IRK_VEC, r0: slot, r1: IR_NONE, t: wrap_mul(v.t / 2, 2) };
}

/// A struct or enum held in memory, copied to a frame slot of ours.
fn ir_own_place(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, v: IrVal) -> IrVal {
  let mw = ir_ms(c, m, p, v.t);
  if mw == 0 {
    ir_fail(&mut f, "a value held in memory that the IR cannot copy");
    return ir_none();
  }
  let slot = ir_reg(&mut f);
  ir_emit(&mut f, IR_SLOT, slot, 0, 0, mw, 0);
  let r = IrVal { k: IRK_PLACE, r0: slot, r1: 0, t: v.t };
  ir_store_val(&mut f, c, m, p, r, v);
  return r;
}

/// Word `k` of the Vec header at address `a`.
fn ir_hdr_load(f: &mut IrFn, a: u64, k: u64) -> u64 {
  let kr = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, kr, k, 0, 0, 0);
  let d = ir_reg(&mut f);
  ir_emit(&mut f, IR_LOAD, d, a, kr, 8, 0);
  return d;
}

fn ir_hdr_store(f: &mut IrFn, a: u64, k: u64, v: u64) {
  let kr = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, kr, k, 0, 0, 0);
  ir_emit(&mut f, IR_STORE, v, a, kr, 8, 0);
}

/// The Vec a `vec_*` builtin works on: a variable, or `&mut` of one.
fn ir_vec_arg(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  let v = ir_expr(&mut f, c, &mut m, p, i);
  if !f.failed && v.k != IRK_VEC {
    ir_fail(&mut f, "a vector builtin on something that is not a vector variable");
    return ir_none();
  }
  return v;
}

/// The place of element `ix` (a register) of the Vec `v`: its data address
/// plus `ix` elements of `w` words.
fn ir_vel(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, v: IrVal, ix: u64, w: u64) -> IrVal {
  let data = ir_hdr_load(&mut f, v.r0, 2);
  let k = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, k, wrap_mul(8, w), 0, 0, 0);
  let off = ir_reg(&mut f);
  ir_emit(&mut f, IR_MUL, off, ix, k, 0, 0);
  let ea = ir_reg(&mut f);
  ir_emit(&mut f, IR_ADD, ea, data, off, 0, 0);
  return IrVal { k: IRK_PLACE, r0: ea, r1: 0, t: ir_velem(v) };
}

/// Is the element of Vec `v` one integer word (so that it is loaded and
/// stored directly)?
fn ir_vsimple(c: &Checker, m: &Mono, p: &Parser, v: IrVal) -> bool {
  return ir_kind(c, m, p, ir_velem(v)) == IRK_INT;
}

/// Copies `cnt` bytes from `src[so ..]` to `dst[do ..]` (address and offset
/// registers) with a forward loop; the two ranges do not overlap.
fn ir_copy_bytes(f: &mut IrFn, c: &Checker, dst: u64, doff: u64, src: u64, soff: u64, cnt: u64) {
  let k = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, k, 0, 0, 0, 0);
  let one = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, one, 1, 0, 0, 0);
  let l_head = ir_label(&mut f);
  let l_body = ir_label(&mut f);
  let l_end = ir_label(&mut f);
  ir_place(&mut f, l_head);
  let more = ir_reg(&mut f);
  ir_emit(&mut f, IR_LT, more, k, cnt, 0, 0);
  ir_emit(&mut f, IR_BR, IR_NONE, more, l_body, l_end, 0);
  ir_place(&mut f, l_body);
  let si = ir_reg(&mut f);
  ir_emit(&mut f, IR_ADD, si, soff, k, 0, c.tu64);
  let di = ir_reg(&mut f);
  ir_emit(&mut f, IR_ADD, di, doff, k, 0, c.tu64);
  let x = ir_reg(&mut f);
  ir_emit(&mut f, IR_LOAD, x, src, si, 1, 0);
  ir_emit(&mut f, IR_STORE, x, dst, di, 1, 0);
  let k1 = ir_reg(&mut f);
  ir_emit(&mut f, IR_ADD, k1, k, one, 0, c.tu64);
  ir_emit(&mut f, IR_MOV, k, k1, 0, 0, 0);
  ir_jump(&mut f, l_head);
  ir_place(&mut f, l_end);
}

/// A call: a builtin of the subset (`len`, `blen`, `get`, `bget`) or a
/// function that is not generic and not a builtin, whose arguments and
/// result are integers or buffers (or no result).
fn ir_call(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  let n = node_at(p.nodes, i);
  if name_is(p, i, "len") || name_is(p, i, "blen") || name_is(p, i, "slen") {
    let mut kind = IRK_BUF;
    if name_is(p, i, "blen") {
      kind = IRK_BYTES;
    } else if name_is(p, i, "slen") {
      kind = IRK_STR;
    }
    let b = ir_buf(&mut f, c, &mut m, p, n.a, kind);
    return IrVal { k: IRK_INT, r0: b.r1, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "get") || name_is(p, i, "bget") || name_is(p, i, "sget") {
    let e = ir_elem(&mut f, c, &mut m, p, i);
    let d = ir_reg(&mut f);
    let mut size = 8;
    if e.k == IRK_BYTES || e.k == IRK_STR {
      size = 1;
    }
    ir_emit(&mut f, IR_LOAD, d, e.r0, e.r1, size, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if is_wrap_builtin(p, n.s, n.e) {
    // Modular arithmetic: the same operation as `+`, `-`, `*`, marked by
    // `c` = 1, whose result the emitter truncates to the type in `ty`. (The
    // plain operators are proved not to overflow, so they need no
    // truncation and have `c` = 0.)
    let mut op = IR_MUL;
    if name_is(p, i, "wrap_add") {
      op = IR_ADD;
    } else if name_is(p, i, "wrap_sub") {
      op = IR_SUB;
    }
    let a = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let b = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let d = ir_reg(&mut f);
    ir_emit(&mut f, op, d, a, b, 1, cg_int_ty(c, f.x, i));
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "vec_len") {
    let v = ir_vec_arg(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return ir_none();
    }
    return IrVal { k: IRK_INT, r0: ir_hdr_load(&mut f, v.r0, 0), r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "vec_get") || name_is(p, i, "vec_set") {
    let v = ir_vec_arg(&mut f, c, &mut m, p, n.a);
    let ix = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let mut xv = ir_none();
    if name_is(p, i, "vec_set") {
      xv = ir_vexpr(&mut f, c, &mut m, p, cg_arg(p, i, 2));
    }
    if f.failed {
      return ir_none();
    }
    let setting = name_is(p, i, "vec_set");
    if ir_vsimple(c, m, p, v) {
      let data = ir_hdr_load(&mut f, v.r0, 2);
      if !setting {
        let d = ir_reg(&mut f);
        ir_emit(&mut f, IR_LOAD, d, data, ix, 8, 0);
        return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
      }
      ir_emit(&mut f, IR_STORE, xv.r0, data, ix, 8, 0);
      return ir_none();
    }
    let el = ir_vel(&mut f, c, m, p, v, ix, ir_mw(c, m, p, ir_velem(v), 0));
    if !setting {
      return ir_rv(&mut f, c, m, p, el);
    }
    ir_store_val(&mut f, c, m, p, el, xv);
    return ir_none();
  }
  if name_is(p, i, "vec_pop") {
    let v = ir_vec_arg(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return ir_none();
    }
    let len = ir_hdr_load(&mut f, v.r0, 0);
    let one = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, one, 1, 0, 0, 0);
    let len1 = ir_reg(&mut f);
    ir_emit(&mut f, IR_SUB, len1, len, one, 0, c.tu64);
    ir_hdr_store(&mut f, v.r0, 0, len1);
    if ir_vsimple(c, m, p, v) {
      let data = ir_hdr_load(&mut f, v.r0, 2);
      let d = ir_reg(&mut f);
      ir_emit(&mut f, IR_LOAD, d, data, len1, 8, 0);
      return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
    }
    let el = ir_vel(&mut f, c, m, p, v, len1, ir_mw(c, m, p, ir_velem(v), 0));
    return ir_rv(&mut f, c, m, p, el);
  }
  if name_is(p, i, "vec_swap") {
    // Puts `x` at `i` and returns what was there.
    let v = ir_vec_arg(&mut f, c, &mut m, p, n.a);
    let ix = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let x = ir_vexpr(&mut f, c, &mut m, p, cg_arg(p, i, 2));
    if f.failed {
      return ir_none();
    }
    if ir_vsimple(c, m, p, v) {
      let data = ir_hdr_load(&mut f, v.r0, 2);
      let d = ir_reg(&mut f);
      ir_emit(&mut f, IR_LOAD, d, data, ix, 8, 0);
      ir_emit(&mut f, IR_STORE, x.r0, data, ix, 8, 0);
      return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
    }
    let el = ir_vel(&mut f, c, m, p, v, ix, ir_mw(c, m, p, ir_velem(v), 0));
    let prev = ir_val(&mut f, c, m, p, ir_rv(&mut f, c, m, p, el));
    if f.failed {
      return ir_none();
    }
    ir_store_val(&mut f, c, m, p, el, x);
    return ir_own(&mut f, prev);
  }
  if name_is(p, i, "vec_push") {
    let v = ir_vec_arg(&mut f, c, &mut m, p, n.a);
    let x = ir_vexpr(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    if f.failed {
      return ir_none();
    }
    let w = ir_mw(c, m, p, ir_velem(v), 0);
    let len = ir_hdr_load(&mut f, v.r0, 0);
    let cap = ir_hdr_load(&mut f, v.r0, 1);
    let full = ir_reg(&mut f);
    ir_emit(&mut f, IR_EQ, full, len, cap, 0, 0);
    let l_grow = ir_label(&mut f);
    let l_room = ir_label(&mut f);
    ir_emit(&mut f, IR_BR, IR_NONE, full, l_grow, l_room, 0);
    ir_place(&mut f, l_grow);
    ir_emit(&mut f, IR_VGROW, IR_NONE, v.r0, 0, w, 0);
    ir_place(&mut f, l_room);
    if ir_vsimple(c, m, p, v) {
      let data = ir_hdr_load(&mut f, v.r0, 2);
      ir_emit(&mut f, IR_STORE, x.r0, data, len, 8, 0);
    } else {
      let el = ir_vel(&mut f, c, m, p, v, len, w);
      ir_store_val(&mut f, c, m, p, el, x);
    }
    let one = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, one, 1, 0, 0, 0);
    let len1 = ir_reg(&mut f);
    ir_emit(&mut f, IR_ADD, len1, len, one, 0, c.tu64);
    ir_hdr_store(&mut f, v.r0, 0, len1);
    return ir_none();
  }
  if name_is(p, i, "set") || name_is(p, i, "bset") {
    // `bset(&mut b, i, v)` changes the buffer in place.
    let mut kind = IRK_BUF;
    let mut size = 8;
    if name_is(p, i, "bset") {
      kind = IRK_BYTES;
      size = 1;
    }
    let a1 = next_of(p, n.a);
    let a2 = next_of(p, a1);
    let b = ir_buf(&mut f, c, &mut m, p, n.a, kind);
    let ix = ir_int(&mut f, c, &mut m, p, a1);
    let v = ir_int(&mut f, c, &mut m, p, a2);
    if !f.failed {
      ir_emit(&mut f, IR_STORE, v, b.r0, ix, size, 0);
    }
    return ir_none();
  }
  if name_is(p, i, "bcopy") {
    // `bcopy(&mut dst, d, src, s, n)`: a byte loop.
    let a1 = next_of(p, n.a);
    let a2 = next_of(p, a1);
    let a3 = next_of(p, a2);
    let a4 = next_of(p, a3);
    let dst = ir_buf(&mut f, c, &mut m, p, n.a, IRK_BYTES);
    let doff = ir_int(&mut f, c, &mut m, p, a1);
    let src = ir_buf(&mut f, c, &mut m, p, a2, IRK_BYTES);
    let soff = ir_int(&mut f, c, &mut m, p, a3);
    let cnt = ir_int(&mut f, c, &mut m, p, a4);
    if !f.failed {
      ir_copy_bytes(&mut f, c, dst.r0, doff, src.r0, soff, cnt);
    }
    return ir_none();
  }
  if name_is(p, i, "bfrom") {
    // A copy of a string literal.
    let s = ir_buf(&mut f, c, &mut m, p, n.a, IRK_STR);
    if f.failed {
      return ir_none();
    }
    let d = ir_fresh(&mut f, IRK_BYTES);
    ir_emit(&mut f, IR_ALLOC, d.r0, s.r1, 0, 1, 0);
    ir_emit(&mut f, IR_MOV, d.r1, s.r1, 0, 0, 0);
    let zero = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, zero, 0, 0, 0, 0);
    ir_copy_bytes(&mut f, c, d.r0, zero, s.r0, zero, s.r1);
    return d;
  }
  if name_is(p, i, "vec_free") {
    let v = ir_vec_arg(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return ir_none();
    }
    let data = ir_hdr_load(&mut f, v.r0, 2);
    ir_emit(&mut f, IR_FREE, IR_NONE, data, 0, 0, 0);
    return ir_none();
  }
  if name_is(p, i, "alloc") || name_is(p, i, "balloc") {
    let mut kind = IRK_BUF;
    let mut size = 8;
    if name_is(p, i, "balloc") {
      kind = IRK_BYTES;
      size = 1;
    }
    let cnt = ir_int(&mut f, c, &mut m, p, n.a);
    let d = ir_fresh(&mut f, kind);
    // The length register is the request: a buffer is exactly n long.
    ir_emit(&mut f, IR_ALLOC, d.r0, cnt, 0, size, 0);
    ir_emit(&mut f, IR_MOV, d.r1, cnt, 0, 0, 0);
    return d;
  }
  if name_is(p, i, "free") || name_is(p, i, "bfree") {
    let mut kind = IRK_BUF;
    if name_is(p, i, "bfree") {
      kind = IRK_BYTES;
    }
    let b = ir_buf(&mut f, c, &mut m, p, n.a, kind);
    ir_emit(&mut f, IR_FREE, IR_NONE, b.r0, 0, 0, 0);
    return ir_none();
  }
  if name_is(p, i, "box") {
    // The contents first, then the allocation they are copied into.
    let v = ir_vexpr(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return ir_none();
    }
    let mut t0 = v.t;
    if v.k == IRK_INT {
      t0 = c.tu64;
    }
    let w = ir_mw(c, m, p, t0, 0);
    if t0 == 0 || w == IR_NONE || w == 0 || w > 512 || (v.k != IRK_INT && v.k != IRK_STRUCT && v.k != IRK_ENUM && v.k != IRK_PLACE && v.k != IRK_BOX) {
      ir_fail(&mut f, "a box of a type the IR does not know");
      return ir_none();
    }
    let cnt = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, cnt, w, 0, 0, 0);
    let ptr = ir_reg(&mut f);
    ir_emit(&mut f, IR_ALLOC, ptr, cnt, 0, 8, 0);
    let dst = IrVal { k: IRK_PLACE, r0: ptr, r1: 0, t: base_t(m, t0) };
    if v.k == IRK_INT || v.k == IRK_BOX {
      ir_hdr_store(&mut f, ptr, 0, v.r0);
    } else if v.k == IRK_PLACE {
      ir_store_val(&mut f, c, m, p, dst, v);
    } else {
      ir_store_words(&mut f, ptr, 0, v.r0, v.r1);
    }
    return IrVal { k: IRK_BOX, r0: ptr, r1: IR_NONE, t: intern(&mut m, p, TY_BOX, t0) };
  }
  if name_is(p, i, "unbox") {
    let b = ir_expr(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return ir_none();
    }
    if b.k != IRK_BOX {
      ir_fail(&mut f, "an unbox of something that is not a box");
      return ir_none();
    }
    let it = base_t(m, inner_t(m, b.t));
    let place = IrVal { k: IRK_PLACE, r0: b.r0, r1: 0, t: it };
    let mut out = ir_val(&mut f, c, m, p, place);
    if out.k == IRK_PLACE {
      // Held in memory: a slot of ours.
      out = ir_own_place(&mut f, c, m, p, out);
    } else if out.k == IRK_VEC {
      out = ir_own(&mut f, out);
    }
    if !f.failed {
      ir_emit(&mut f, IR_FREE, IR_NONE, b.r0, 0, 0, 0);
    }
    return out;
  }
  if name_is(p, i, "serial_write") {
    // `serial_write(con, byte)`: the capability is only a name for the right
    // to call it.
    let a1 = next_of(p, n.a);
    let b = ir_int(&mut f, c, &mut m, p, a1);
    ir_emit(&mut f, IR_PUTC, IR_NONE, b, 0, 0, 0);
    return ir_none();
  }
  if name_is(p, i, "serial_read") {
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_GETC, d, 0, 0, 0, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "print") {
    let a = ir_int(&mut f, c, &mut m, p, n.a);
    ir_emit(&mut f, IR_PRINT, IR_NONE, a, 0, 0, 0);
    return ir_none();
  }
  if is_builtin_name(c, p, n.s, n.e) {
    let first = !f.failed;
    ir_fail(&mut f, "a builtin outside the first subset: ");
    if first && n.s <= n.e && n.e <= blen(p.src) {
      let mut k = n.s;
      while k < n.e
        invariant n.e <= blen(p.src)
      {
        vec_push(&mut f.why, cast[u64](bget(p.src, k)));
        k = k + 1;
      }
    }
    return ir_none();
  }
  let def = plain_fn(p, n.s, n.e);
  if def == 0 {
    ir_fail(&mut f, "a call of a generic function");
    return ir_none();
  }
  let callee = plain_inst(&mut m, def);
  return ir_call_to(&mut f, c, &mut m, p, i, callee);
}

/// The call node `i` of function instance `callee`: the arguments, the
/// call, and the lent buffers read back.
fn ir_call_to(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64, callee: u64) -> IrVal {
  let n = node_at(p.nodes, i);
  let mut regs = vec_new[u64]();
  let mut lent = vec_new[u64]();
  let mut a = n.a;
  let cdef = inst_at(m, callee);
  let cdn = node_at(p.nodes, cdef.def);
  let mut cq = cdn.a;
  while a != 0 && !f.failed {
    let v = ir_expr(&mut f, c, &mut m, p, a);
    let mut pt_kind = 0;
    let mut pt = 0;
    if cq != 0 {
      let cqn = node_at(p.nodes, cq);
      pt = conv(&mut m, p, cqn.a, callee, cq);
      pt_kind = kind_t(m, pt);
      cq = cqn.next;
    }
    let pu = base_t(m, pt);
    let aggr = pt != 0 && (kind_t(m, pu) == TY_STRUCT || kind_t(m, pu) == TY_ENUM);
    if f.failed {
      // Nothing more to lower.
    } else if aggr && pt_kind == TY_MUTREF {
      // Lent by address.
      if ir_multi(v.k) && v.r1 <= 64 {
        // A struct held in registers: its words go to a slot, the callee gets
        // the address, and they are read back after the call.
        let slot = ir_reg(&mut f);
        ir_emit(&mut f, IR_SLOT, slot, 0, 0, v.r1, 0);
        ir_store_words(&mut f, slot, 0, v.r0, v.r1);
        vec_push(&mut regs, slot);
        vec_push(&mut lent, slot);
        vec_push(&mut lent, v.r0);
        vec_push(&mut lent, wrap_add(IR_LENT_WORDS, v.r1));
      } else if v.k != IRK_PLACE {
        ir_fail(&mut f, "a `&mut` argument that is not a struct in memory");
      } else {
        vec_push(&mut regs, ir_paddr(&mut f, v));
      }
    } else if aggr && pt_kind == TY_REF && ir_mw(c, m, p, pu, 0) != IR_NONE && ir_mw(c, m, p, pu, 0) >= 4 {
      // Large borrows go by address too (`x86_byaddr`).
      if v.k == IRK_PLACE {
        vec_push(&mut regs, ir_paddr(&mut f, v));
      } else if ir_multi(v.k) {
        let slot = ir_reg(&mut f);
        ir_emit(&mut f, IR_SLOT, slot, 0, 0, v.r1, 0);
        ir_store_words(&mut f, slot, 0, v.r0, v.r1);
        vec_push(&mut regs, slot);
      } else {
        ir_fail(&mut f, "a borrowed argument of another kind");
      }
    } else if pt_kind == TY_MUTREF && v.k == IRK_PLACE && ir_kind(c, m, p, pu) == IRK_INT {
      // A scalar in memory (a field): its address.
      vec_push(&mut regs, ir_paddr(&mut f, v));
    } else if pt_kind == TY_MUTREF && v.k == IRK_INT {
      // A scalar variable: its word goes to a slot, the callee gets the
      // address, and the word is read back after the call.
      let slot = ir_reg(&mut f);
      ir_emit(&mut f, IR_SLOT, slot, 0, 0, 1, 0);
      ir_store_words(&mut f, slot, 0, v.r0, 1);
      vec_push(&mut regs, slot);
      vec_push(&mut lent, slot);
      vec_push(&mut lent, v.r0);
      vec_push(&mut lent, wrap_add(IR_LENT_WORDS, 1));
    } else if v.k == IRK_PLACE {
      // By value: the words of the place.
      let w = ir_mw(c, m, p, v.t, 0);
      if w == IR_NONE || w == 0 || w > 64 {
        ir_fail(&mut f, "an argument of a type the IR does not know");
      } else {
        let d = ir_new_val(&mut f, IRK_STRUCT, w, v.t);
        ir_load_words(&mut f, v.r0, v.r1, d.r0, w);
        let mut j = 0;
        while j < w {
          vec_push(&mut regs, wrap_add(d.r0, j));
          j = j + 1;
        }
      }
    } else if v.k == IRK_VEC {
      if pt_kind == TY_MUTREF {
        vec_push(&mut regs, v.r0);
      } else {
        // By value or shared: the three header words, as the existing
        // calling convention passes them.
        let mut w = 0;
        while w < 3 {
          vec_push(&mut regs, ir_hdr_load(&mut f, v.r0, w));
          w = w + 1;
        }
      }
    } else if pt_kind == TY_MUTREF && (v.k == IRK_BUF || v.k == IRK_BYTES) {
      // A lent buffer goes by address of its two words (length, then data);
      // the callee cannot replace it, so nothing is copied back.
      let slot = ir_reg(&mut f);
      ir_emit(&mut f, IR_SLOT, slot, 0, 0, 2, 0);
      ir_hdr_store(&mut f, slot, 0, v.r1);
      ir_hdr_store(&mut f, slot, 1, v.r0);
      vec_push(&mut regs, slot);
      vec_push(&mut lent, slot);
      vec_push(&mut lent, v.r0);
      vec_push(&mut lent, v.r1);
    } else if ir_multi(v.k) {
      let mut w = 0;
      while w < v.r1 && w < 64 {
        vec_push(&mut regs, wrap_add(v.r0, w));
        w = w + 1;
      }
    } else {
      vec_push(&mut regs, v.r0);
      if v.r1 != IR_NONE {
        vec_push(&mut regs, v.r1);
      }
    }
    a = next_of(p, a);
  }
  let first = vec_len(f.args);
  let mut j = 0;
  while j < vec_len(regs) {
    vec_push(&mut f.args, vec_get(regs, j));
    j = j + 1;
  }
  let count = vec_len(regs);
  vec_free(regs);
  if f.failed {
    vec_free(lent);
    return ir_none();
  }
  let rt = cg_ret_ty(&mut m, p, callee);
  let rk = ir_kind(c, m, p, rt);
  let rmw = ir_ms(c, m, p, rt);
  if rk == 0 && rmw > 0 {
    // A struct with a Vec in it: the callee writes it to the space the call
    // reserves, and it stays there as a place.
    let slot = ir_reg(&mut f);
    ir_emit(&mut f, IR_CALLM, slot, callee, first, count, rmw);
    ir_take_back(&mut f, lent);
    vec_free(lent);
    return IrVal { k: IRK_PLACE, r0: slot, r1: 0, t: base_t(m, rt) };
  }
  if rk == 0 && kind_t(m, rt) != TY_UNIT {
    ir_fail(&mut f, "a call with a result that is not an integer or a buffer");
    vec_free(lent);
    return ir_none();
  }
  let mut d = IrVal { k: 0, r0: IR_NONE, r1: IR_NONE, t: 0 };
  if rk != 0 {
    d = ir_new_val(&mut f, rk, ir_words(c, m, p, rt, 0), base_t(m, rt));
  }
  if rk == IRK_VEC || (ir_multi(rk) && d.r1 > 2) {
    // The callee writes its result to the space the call reserves; it is
    // in a frame slot after the call.
    let mut w = 3;
    if rk != IRK_VEC {
      w = d.r1;
    }
    let slot = ir_reg(&mut f);
    ir_emit(&mut f, IR_CALLM, slot, callee, first, count, w);
    ir_take_back(&mut f, lent);
    vec_free(lent);
    if rk == IRK_VEC {
      return IrVal { k: IRK_VEC, r0: slot, r1: IR_NONE, t: ir_vt(inner_t(m, base_t(m, rt)), 0) };
    }
    ir_load_words(&mut f, slot, 0, d.r0, w);
    return d;
  }
  if ir_multi(d.k) {
    let mut second = IR_NONE;
    if d.r1 == 2 {
      second = wrap_add(d.r0, 1);
    }
    ir_emit(&mut f, IR_CALL, d.r0, callee, first, count, second);
  } else {
    ir_emit(&mut f, IR_CALL, d.r0, callee, first, count, d.r1);
  }
  ir_take_back(&mut f, lent);
  vec_free(lent);
  return d;
}

/// Before a return: the lent buffers go back to their callers' words, since
/// the function may have replaced them.
fn ir_give_back(f: &mut IrFn) {
  let mut j = 0;
  while wrap_add(j, 2) < vec_len(f.lent) && j < 1000000 {
    let a = vec_get(f.lent, j);
    let data = vec_get(f.lent, wrap_add(j, 1));
    let len = vec_get(f.lent, wrap_add(j, 2));
    if len >= IR_LENT_WORDS {
      // A scalar: its word goes back.
      ir_store_words(&mut f, a, 0, data, len - IR_LENT_WORDS);
    } else {
      ir_hdr_store(&mut f, a, 0, len);
      ir_hdr_store(&mut f, a, 1, data);
    }
    j = j + 3;
  }
}

/// After a call: the lent buffers (slot, data, length registers of the
/// caller's variable) are read back, since the callee may have replaced them.
fn ir_take_back(f: &mut IrFn, lent: &Vec[u64]) {
  let mut j = 0;
  while wrap_add(j, 2) < vec_len(lent) && j < 1000000 {
    let slot = vec_get(lent, j);
    let data = vec_get(lent, wrap_add(j, 1));
    let len = vec_get(lent, wrap_add(j, 2));
    if len >= IR_LENT_WORDS {
      // A struct or enum held in registers: its words, from `data` on.
      ir_load_words(&mut f, slot, 0, data, len - IR_LENT_WORDS);
    } else {
      let k1 = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, k1, 1, 0, 0, 0);
      ir_emit(&mut f, IR_LOAD, data, slot, k1, 8, 0);
      let k0 = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, k0, 0, 0, 0, 0);
      ir_emit(&mut f, IR_LOAD, len, slot, k0, 8, 0);
    }
    j = j + 3;
  }
}

fn ir_block(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, head: u64) {
  let saved = vec_len(f.vars);
  let mut i = head;
  while i != 0 && !f.failed {
    ir_stmt(&mut f, c, &mut m, p, i);
    i = next_of(p, i);
  }
  ir_truncate(&mut f, saved);
}

fn ir_stmt(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) {
  let n = node_at(p.nodes, i);
  f.cur = n.line;
  let k = n.kind;
  if k == S_LET {
    let t = let_ty(m, f.x, i);
    let kind = ir_kind(c, m, p, t);
    let mw = ir_ms(c, m, p, t);
    if kind == 0 && mw > 0 {
      // A struct with a Vec in it: a frame slot of its own.
      let v = ir_vexpr(&mut f, c, &mut m, p, n.b);
      if f.failed {
        return;
      }
      if v.k != IRK_PLACE {
        ir_fail(&mut f, "an initializer of another kind");
        return;
      }
      let slot = ir_reg(&mut f);
      ir_emit(&mut f, IR_SLOT, slot, 0, 0, mw, 0);
      let r = IrVal { k: IRK_PLACE, r0: slot, r1: 0, t: base_t(m, t) };
      ir_store_val(&mut f, c, m, p, r, v);
      ir_bind(&mut f, n.s, n.e, r);
      return;
    }
    if kind == 0 {
      ir_fail(&mut f, "a variable that is not an integer, bool, buffer, struct, enum or Vec");
      return;
    }
    let before = f.nreg;
    let v = ir_own(&mut f, ir_vexpr(&mut f, c, &mut m, p, n.b));
    if f.failed {
      return;
    }
    // Fresh registers: the initializer's may be another variable's.
    if v.k != kind {
      ir_fail(&mut f, "an initializer of another kind");
      return;
    }
    if kind == IRK_INT && v.r0 >= before {
      // A temporary made by the initializer itself: no one else holds it, so
      // the variable can be that register.
      ir_bind(&mut f, n.s, n.e, v);
      return;
    }
    let r = ir_like(&mut f, v);
    ir_copy(&mut f, r, v);
    ir_bind(&mut f, n.s, n.e, r);
  } else if k == S_ASSIGN {
    let path = node_at(p.nodes, n.a);
    let mut target = ir_find(f, p, path.s, path.e);
    let mut seg = path.next;
    while seg != 0 && target.k != 0 && !f.failed {
      let sn = node_at(p.nodes, seg);
      target = ir_field(&mut f, c, m, p, target, sn.s, sn.e);
      seg = sn.next;
    }
    if target.k == 0 {
      ir_fail(&mut f, "an assignment to something that is not a variable of the subset");
      return;
    }
    let rhs = node_at(p.nodes, n.b);
    if rhs.kind == E_CALL && (name_is(p, n.b, "set") || name_is(p, n.b, "bset")) && ir_is_path(p, rhs.a, path) {
      // `b = set(b, i, v)` (or `q.b = set(q.b, i, v)`) changes the buffer in
      // place.
      let a0 = rhs.a;
      let a1 = next_of(p, a0);
      let a2 = next_of(p, a1);
      let mut kind = IRK_BUF;
      if name_is(p, n.b, "bset") {
        kind = IRK_BYTES;
      }
      target = ir_rv(&mut f, c, m, p, target);
      if target.k != kind {
        ir_fail(&mut f, "a set that does not assign to its own buffer");
        return;
      }
      let ix = ir_int(&mut f, c, &mut m, p, a1);
      let v = ir_int(&mut f, c, &mut m, p, a2);
      if !f.failed {
        let mut size = 8;
        if kind == IRK_BYTES {
          size = 1;
        }
        ir_emit(&mut f, IR_STORE, v, target.r0, ix, size, 0);
      }
      return;
    }
    let v = ir_own(&mut f, ir_vexpr(&mut f, c, &mut m, p, n.b));
    if !f.failed {
      if target.k == IRK_PLACE {
        ir_store_val(&mut f, c, m, p, target, v);
      } else if v.k != target.k {
        ir_fail(&mut f, "an assignment between kinds");
      } else {
        ir_copy(&mut f, target, v);
      }
    }
  } else if k == S_IF {
    let l_then = ir_label(&mut f);
    let l_else = ir_label(&mut f);
    let l_end = ir_label(&mut f);
    ir_branch(&mut f, c, &mut m, p, n.a, l_then, l_else);
    ir_place(&mut f, l_then);
    ir_block(&mut f, c, &mut m, p, n.b);
    ir_jump(&mut f, l_end);
    ir_place(&mut f, l_else);
    if n.c != 0 {
      ir_block(&mut f, c, &mut m, p, n.c);
    }
    ir_place(&mut f, l_end);
  } else if k == S_WHILE {
    let l_head = ir_label(&mut f);
    let l_body = ir_label(&mut f);
    let l_end = ir_label(&mut f);
    ir_place(&mut f, l_head);
    ir_branch(&mut f, c, &mut m, p, n.a, l_body, l_end);
    ir_place(&mut f, l_body);
    ir_block(&mut f, c, &mut m, p, n.c);
    ir_jump(&mut f, l_head);
    ir_place(&mut f, l_end);
  } else if k == S_RETURN {
    if n.a == 0 {
      ir_give_back(&mut f);
      ir_emit(&mut f, IR_RET, IR_NONE, IR_NONE, IR_NONE, 0, 0);
    } else {
      let v = ir_vexpr(&mut f, c, &mut m, p, n.a);
      if f.failed {
        return;
      }
      ir_give_back(&mut f);
      if v.k == IRK_VEC {
        ir_emit(&mut f, IR_RET, IR_NONE, v.r0, IR_NONE, 3, 0);
      } else if v.k == IRK_PLACE && ir_ms(c, m, p, v.t) > 0 {
        let a = ir_paddr(&mut f, v);
        ir_emit(&mut f, IR_RET, IR_NONE, a, IR_NONE, ir_ms(c, m, p, v.t), 0);
      } else if ir_multi(v.k) && v.r1 > 2 {
        let first = vec_len(f.args);
        let mut w = 0;
        while w < v.r1 && w < 4096 {
          vec_push(&mut f.args, wrap_add(v.r0, w));
          w = w + 1;
        }
        ir_emit(&mut f, IR_RET, IR_NONE, IR_NONE, first, v.r1, 0);
      } else if ir_multi(v.k) {
        let mut second = IR_NONE;
        if v.r1 == 2 {
          second = wrap_add(v.r0, 1);
        }
        ir_emit(&mut f, IR_RET, IR_NONE, v.r0, second, 0, 0);
      } else {
        ir_emit(&mut f, IR_RET, IR_NONE, v.r0, v.r1, 0, 0);
      }
    }
    // Code after a return is unreachable but must still sit in a block.
    let dead = ir_label(&mut f);
    ir_place(&mut f, dead);
  } else if k == S_UNREACHABLE {
    ir_emit(&mut f, IR_UNREACH, IR_NONE, 0, 0, 0, 0);
    let dead = ir_label(&mut f);
    ir_place(&mut f, dead);
  } else if k == S_MATCH {
    let scrut0 = ir_expr(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return;
    }
    // An enum the IR cannot hold in registers is matched where it is: its
    // tag is the first word, the payload of a variant the words after it.
    let inplace = scrut0.k == IRK_PLACE && ir_kind(c, m, p, scrut0.t) == 0 && kind_t(m, base_t(m, scrut0.t)) == TY_ENUM;
    let mut scrut = scrut0;
    if !inplace {
      scrut = ir_val(&mut f, c, m, p, scrut0);
    }
    if f.failed {
      return;
    }
    if scrut.k != IRK_ENUM && !inplace {
      ir_fail(&mut f, "a match on something that is not an enum");
      return;
    }
    // The scrutinee is copied, so an arm may change what it was read from.
    let mut e = scrut;
    let mut tagr = IR_NONE;
    if inplace {
      tagr = ir_hdr_load(&mut f, scrut.r0, scrut.r1);
    } else {
      e = ir_like(&mut f, scrut);
      ir_copy(&mut f, e, scrut);
      tagr = e.r0;
    }
    let x = inner_t(m, e.t);
    let l_end = ir_label(&mut f);
    let mut a = n.b;
    while a != 0 && !f.failed {
      let arm = node_at(p.nodes, a);
      let l_next = ir_label(&mut f);
      let saved = vec_len(f.vars);
      if arm.v != PAT_WILD {
        let v = cg_variant(m, p, x, arm.s2, arm.e2);
        if arm.next != 0 {
          let kr = ir_reg(&mut f);
          ir_emit(&mut f, IR_CONST, kr, v, 0, 0, 0);
          let hit = ir_reg(&mut f);
          ir_emit(&mut f, IR_EQ, hit, tagr, kr, 0, 0);
          let l_arm = ir_label(&mut f);
          ir_emit(&mut f, IR_BR, IR_NONE, hit, l_arm, l_next, 0);
          ir_place(&mut f, l_arm);
        }
        if arm.a != 0 {
          let b = node_at(p.nodes, arm.a);
          if !span_is(p, b.s, b.e, "_") {
            if inplace {
              let ft = fld_ty(c, x, v);
              if ft == 0 {
                ir_fail(&mut f, "a binding of a variant without a payload");
              } else {
                let view = IrVal { k: IRK_PLACE, r0: e.r0, r1: wrap_add(e.r1, 1), t: base_t(m, ft) };
                let r = ir_own(&mut f, ir_rv(&mut f, c, m, p, view));
                ir_bind(&mut f, b.s, b.e, r);
              }
            } else {
              let view = ir_payload(&mut f, c, m, p, e, v);
              if !f.failed {
                let r = ir_like(&mut f, view);
                ir_copy(&mut f, r, view);
                ir_bind(&mut f, b.s, b.e, r);
              }
            }
          }
        }
      }
      ir_block(&mut f, c, &mut m, p, arm.c);
      ir_truncate(&mut f, saved);
      ir_jump(&mut f, l_end);
      ir_place(&mut f, l_next);
      a = arm.next;
    }
    ir_place(&mut f, l_end);
  } else if k == S_EXPR {
    let e = node_at(p.nodes, n.a);
    if e.kind == E_CALL {
      ir_call(&mut f, c, &mut m, p, n.a);
    } else {
      ir_fail(&mut f, "an expression statement that is not a call");
    }
  } else if k == S_ASSERT {
    // Ghost code is erased before lowering, as before C generation.
  } else {
    ir_fail(&mut f, "a statement outside the first subset");
  }
}

/// Drops the code no jump reaches: what follows a `ret`, `jmp`, `br` or
/// `unreachable` up to the next label something jumps to, and the labels
/// nothing jumps to.
fn ir_trim(f: &mut IrFn) {
  let mut used = vec_new[u64]();
  let mut k = 0;
  while k < vec_len(f.ins) {
    let q = vec_get(f.ins, k);
    if q.op == IR_JMP {
      vec_push(&mut used, q.a);
    } else if q.op == IR_BR {
      vec_push(&mut used, q.b);
      vec_push(&mut used, q.c);
    }
    k = k + 1;
  }
  let mut out = vec_new[IrIns]();
  let mut live = true;
  k = 0;
  while k < vec_len(f.ins) {
    let q = vec_get(f.ins, k);
    k = k + 1;
    if q.op == IR_LABEL {
      if has_id(used, q.a) {
        vec_push(&mut out, q);
        live = true;
      }
    } else if live {
      vec_push(&mut out, q);
      if q.op == IR_RET || q.op == IR_JMP || q.op == IR_BR || q.op == IR_UNREACH {
        live = false;
      }
    }
  }
  vec_free(used);
  vec_free(f.ins);
  f.ins = out;
}

/// Lowers function instance `x`: parameters, then the body, and a `return`
/// at the end for a body that falls off it. `f.failed` says whether the
/// function is outside the subset.
fn ir_lower(c: &Checker, m: &mut Mono, p: &Parser, x: u64) -> IrFn {
  let mut f = ir_new(x);
  let xi = inst_at(m, x);
  let dn = node_at(p.nodes, xi.def);
  let mut q = dn.a;
  while q != 0 && !f.failed {
    let qn = node_at(p.nodes, q);
    let pt = conv(&mut m, p, qn.a, x, q);
    let pk = ir_kind(c, m, p, pt);
    let pu = base_t(m, pt);
    let aggr = kind_t(m, pu) == TY_STRUCT || kind_t(m, pu) == TY_ENUM;
    let pmw = ir_mw(c, m, p, pu, 0);
    if aggr && pmw != IR_NONE && pmw > 0 && (kind_t(m, pt) == TY_MUTREF || (kind_t(m, pt) == TY_REF && pmw >= 4)) {
      // Lent by address: the value stays where the caller has it.
      let r = ir_reg(&mut f);
      vec_push(&mut f.params, r);
      ir_bind(&mut f, qn.s, qn.e, IrVal { k: IRK_PLACE, r0: r, r1: 0, t: pu });
    } else if pk == 0 && aggr && pmw != IR_NONE && pmw > 0 && pmw <= 16 {
      // Arrives as words, of a type the IR cannot hold in registers: put
      // them in a slot of ours.
      let w0 = ir_reg(&mut f);
      vec_push(&mut f.params, w0);
      let mut j = 1;
      while j < pmw {
        let wj = ir_reg(&mut f);
        vec_push(&mut f.params, wj);
        j = j + 1;
      }
      let slot = ir_reg(&mut f);
      ir_emit(&mut f, IR_SLOT, slot, 0, 0, pmw, 0);
      ir_store_words(&mut f, slot, 0, w0, pmw);
      ir_bind(&mut f, qn.s, qn.e, IrVal { k: IRK_PLACE, r0: slot, r1: 0, t: pu });
    } else if pk == 0 {
      let first = !f.failed;
      ir_fail(&mut f, "a parameter that is not an integer, bool, buffer, struct, enum or Vec: ");
      if first {
        tyn_to(&mut f.why, m, p, pt);
      }
    } else if kind_t(m, pt) == TY_MUTREF && (pk == IRK_BUF || pk == IRK_BYTES) {
      // Lent by the address of its two words (length, then data).
      let a = ir_reg(&mut f);
      vec_push(&mut f.params, a);
      let data = ir_hdr_load(&mut f, a, 1);
      let len = ir_hdr_load(&mut f, a, 0);
      ir_bind(&mut f, qn.s, qn.e, IrVal { k: pk, r0: data, r1: len, t: 0 });
      vec_push(&mut f.lent, a);
      vec_push(&mut f.lent, data);
      vec_push(&mut f.lent, len);
    } else if kind_t(m, pt) == TY_MUTREF && pk == IRK_INT {
      // A scalar lent by address: its word is ours until the function returns.
      let a = ir_reg(&mut f);
      vec_push(&mut f.params, a);
      let w = ir_new_val(&mut f, IRK_INT, 1, 0);
      ir_load_words(&mut f, a, 0, w.r0, 1);
      ir_bind(&mut f, qn.s, qn.e, w);
      vec_push(&mut f.lent, a);
      vec_push(&mut f.lent, w.r0);
      vec_push(&mut f.lent, wrap_add(IR_LENT_WORDS, 1));
    } else if kind_t(m, pt) == TY_MUTREF && pk != IRK_VEC {
      ir_fail(&mut f, "a `&mut` parameter that is not a Vec, a Buf or a Bytes");
    } else {
      let mut r = ir_new_val(&mut f, pk, ir_words(c, m, p, pt, 0), base_t(m, pt));
      if pk == IRK_VEC {
        r.t = ir_vt(inner_t(m, pu), 0);
      }
      if pk == IRK_VEC && kind_t(m, pt) != TY_MUTREF {
        // Passed as three words: put them in a slot of ours.
        let w0 = r.r0;
        let w1 = ir_reg(&mut f);
        let w2 = ir_reg(&mut f);
        vec_push(&mut f.params, w0);
        vec_push(&mut f.params, w1);
        vec_push(&mut f.params, w2);
        let slot = ir_reg(&mut f);
        ir_emit(&mut f, IR_SLOT, slot, 0, 0, 3, 0);
        ir_hdr_store(&mut f, slot, 0, w0);
        ir_hdr_store(&mut f, slot, 1, w1);
        ir_hdr_store(&mut f, slot, 2, w2);
        r = IrVal { k: IRK_VEC, r0: slot, r1: IR_NONE, t: ir_vt(inner_t(m, pu), 0) };
      } else if ir_multi(pk) {
        let mut w = 0;
        while w < r.r1 && w < 64 {
          vec_push(&mut f.params, wrap_add(r.r0, w));
          w = w + 1;
        }
      } else {
        vec_push(&mut f.params, r.r0);
        if r.r1 != IR_NONE {
          vec_push(&mut f.params, r.r1);
        }
      }
      ir_bind(&mut f, qn.s, qn.e, r);
    }
    q = qn.next;
  }
  let rt = cg_ret_ty(&mut m, p, x);
  if !f.failed && ir_kind(c, m, p, rt) == 0 && ir_ms(c, m, p, rt) == 0 && kind_t(m, rt) != TY_UNIT {
    ir_fail(&mut f, "a result that is not an integer, bool, buffer, struct or enum");
  }
  if !f.failed {
    ir_block(&mut f, c, &mut m, p, dn.x);
    ir_give_back(&mut f);
    ir_emit(&mut f, IR_RET, IR_NONE, IR_NONE, IR_NONE, 0, 0);
    ir_trim(&mut f);
  }
  return f;
}

// ---- The text form ----

fn ir_op_name(op: u64) -> Str {
  if op == IR_CONST { return "const"; }
  if op == IR_MOV { return "mov"; }
  if op == IR_ADD { return "add"; }
  if op == IR_SUB { return "sub"; }
  if op == IR_MUL { return "mul"; }
  if op == IR_DIV { return "div"; }
  if op == IR_SDIV { return "sdiv"; }
  if op == IR_REM { return "rem"; }
  if op == IR_SREM { return "srem"; }
  if op == IR_AND { return "and"; }
  if op == IR_OR { return "or"; }
  if op == IR_XOR { return "xor"; }
  if op == IR_SHL { return "shl"; }
  if op == IR_SHR { return "shr"; }
  if op == IR_SAR { return "sar"; }
  if op == IR_NOT { return "not"; }
  if op == IR_NEG { return "neg"; }
  if op == IR_EQ { return "eq"; }
  if op == IR_NE { return "ne"; }
  if op == IR_LT { return "lt"; }
  if op == IR_LE { return "le"; }
  if op == IR_GT { return "gt"; }
  if op == IR_GE { return "ge"; }
  if op == IR_SLT { return "slt"; }
  if op == IR_SLE { return "sle"; }
  if op == IR_SGT { return "sgt"; }
  if op == IR_SGE { return "sge"; }
  return "?";
}

fn ir_w_reg(out: &mut Vec[u64], r: u64) {
  w_s(&mut out, "v");
  w_num(&mut out, r);
}

fn ir_w_label(out: &mut Vec[u64], l: u64) {
  w_s(&mut out, "L");
  w_num(&mut out, l);
}

/// The name of instance `x` as the source spells it, with its number when
/// it is generic.
fn ir_w_name(out: &mut Vec[u64], m: &Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  let dn = node_at(p.nodes, xi.def);
  if dn.s <= dn.e && dn.e <= blen(p.src) {
    let mut k = dn.s;
    while k < dn.e
      invariant dn.e <= blen(p.src)
    {
      vec_push(&mut out, cast[u64](bget(p.src, k)));
      k = k + 1;
    }
  }
}

/// The text of a lowered function:
///   fn name(v0, v1) {
///     v2 = add v0, v1
///   L0:
///     br v2, L1, L2
///     ret v2
///   }
fn ir_print(out: &mut Vec[u64], f: &IrFn, m: &Mono, p: &Parser) {
  w_s(&mut out, "fn ");
  ir_w_name(&mut out, m, p, f.x);
  w_s(&mut out, "(");
  let mut k = 0;
  while k < vec_len(f.params) {
    if k > 0 {
      w_s(&mut out, ", ");
    }
    ir_w_reg(&mut out, vec_get(f.params, k));
    k = k + 1;
  }
  w_s(&mut out, ") {\n");
  k = 0;
  while k < vec_len(f.ins) {
    let q = vec_get(f.ins, k);
    k = k + 1;
    if q.op != IR_LABEL {
      w_s(&mut out, "  ");
    }
    if q.op == IR_LABEL {
      ir_w_label(&mut out, q.a);
      w_s(&mut out, ":");
    } else if q.op == IR_CONST {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = const ");
      w_num(&mut out, q.a);
    } else if q.op == IR_MOV || q.op == IR_NOT || q.op == IR_NEG {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = ");
      w_s(&mut out, ir_op_name(q.op));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_JMP {
      w_s(&mut out, "jmp ");
      ir_w_label(&mut out, q.a);
    } else if q.op == IR_BR {
      w_s(&mut out, "br ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      ir_w_label(&mut out, q.b);
      w_s(&mut out, ", ");
      ir_w_label(&mut out, q.c);
    } else if q.op == IR_RET && q.c > 0 && q.a == IR_NONE {
      w_s(&mut out, "ret regs");
      let mut j = 0;
      while j < q.c && j < 4096 {
        if j > 0 {
          w_s(&mut out, ",");
        }
        w_s(&mut out, " ");
        ir_w_reg(&mut out, u_at(f.args, wrap_add(q.b, j)));
        j = j + 1;
      }
    } else if q.op == IR_RET && q.c > 0 {
      w_s(&mut out, "ret mem ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      w_num(&mut out, q.c);
    } else if q.op == IR_RET {
      w_s(&mut out, "ret");
      if q.a != IR_NONE {
        w_s(&mut out, " ");
        ir_w_reg(&mut out, q.a);
      }
      if q.b != IR_NONE {
        w_s(&mut out, ", ");
        ir_w_reg(&mut out, q.b);
      }
    } else if q.op == IR_LOAD {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = load");
      w_num(&mut out, wrap_mul(q.c, 8));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, "[");
      ir_w_reg(&mut out, q.b);
      w_s(&mut out, "]");
    } else if q.op == IR_STORE {
      w_s(&mut out, "store");
      w_num(&mut out, wrap_mul(q.c, 8));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, "[");
      ir_w_reg(&mut out, q.b);
      w_s(&mut out, "], ");
      ir_w_reg(&mut out, q.d);
    } else if q.op == IR_ALLOC {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = alloc");
      w_num(&mut out, wrap_mul(q.c, 8));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_STRLIT {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = str ");
      w_num(&mut out, q.a);
    } else if q.op == IR_SLOT {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = slot ");
      w_num(&mut out, q.c);
    } else if q.op == IR_VGROW {
      w_s(&mut out, "vgrow ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_FREE {
      w_s(&mut out, "free ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_PRINT {
      w_s(&mut out, "print ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_PUTC {
      w_s(&mut out, "putc ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_GETC {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = getc");
    } else if q.op == IR_WRAP {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = wrap ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_UNREACH {
      w_s(&mut out, "unreachable");
    } else if q.op == IR_CALL || q.op == IR_CALLM {
      if q.op == IR_CALLM {
        ir_w_reg(&mut out, q.d);
        w_s(&mut out, " = ");
      } else if q.d != IR_NONE {
        ir_w_reg(&mut out, q.d);
        if q.ty != IR_NONE && q.ty != 0 {
          w_s(&mut out, ", ");
          ir_w_reg(&mut out, q.ty);
        }
        w_s(&mut out, " = ");
      }
      if q.op == IR_CALLM {
        w_s(&mut out, "callm ");
      } else {
        w_s(&mut out, "call ");
      }
      ir_w_name(&mut out, m, p, q.a);
      w_s(&mut out, "(");
      let mut j = 0;
      while j < q.c {
        if j > 0 {
          w_s(&mut out, ", ");
        }
        ir_w_reg(&mut out, u_at(f.args, wrap_add(q.b, j)));
        j = j + 1;
      }
      w_s(&mut out, ")");
    } else {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = ");
      if q.c == 1 {
        w_s(&mut out, "w");
      }
      w_s(&mut out, ir_op_name(q.op));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.b);
    }
    w_s(&mut out, "\n");
  }
  w_s(&mut out, "}\n");
}
