    if f.failed || pool.k == 0 {
      return ir_none();
    }
    let at = ir_count_addr(&mut f, c, IRS_SHARED_REFS, pg);
    let id = ir_page_id(&mut f, c, pg);
    let last = ir_reg(&mut f);
    ir_emit(&mut f, IR_LOCKDEC, last, at, 0, 0, 0);
    let zero = ir_k(&mut f, 0);
    let mask = ir_reg(&mut f);
    ir_emit(&mut f, IR_SUB, mask, zero, last, 0, c.tu64);
    let kept = ir_reg(&mut f);
    ir_emit(&mut f, IR_AND, kept, id, mask, 0, 0);
    let ones = ir_k(&mut f, 18446744073709551615);
    let inv = ir_reg(&mut f);
    ir_emit(&mut f, IR_XOR, inv, mask, ones, 0, 0);
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_OR, d, kept, inv, 0, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "shared_id") {
    let pg = ir_handle_arg(&mut f, c, &mut m, p, n.a);
    let d = ir_page_id(&mut f, c, pg);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "dirty_id") {
    let pg = ir_handle_arg(&mut f, c, &mut m, p, n.a);
    let base = ir_reg(&mut f);
    ir_emit(&mut f, IR_GLOBAL, base, IRS_POOL_BASE, 0, 0, 0);
    let off = ir_reg(&mut f);
    ir_emit(&mut f, IR_SUB, off, pg, base, 0, 0);
    let sh = ir_k(&mut f, 12);
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_SHR, d, off, sh, 0, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "dirty_zero") {
    let pg = ir_handle_arg(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return ir_none();
    }
    ir_emit(&mut f, IR_ZERO, IR_NONE, pg, 0, 0, 0);
    return IrVal { k: IRK_INT, r0: pg, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "frame_copy") || name_is(p, i, "shared_copy") {
    // The whole page, a word at a time; the result is the dirty page.
    let dst = ir_handle_arg(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let src = ir_handle_arg(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    if f.failed {
      return ir_none();
    }
    ir_emit(&mut f, IR_COPYPAGE, IR_NONE, dst, src, 0, 0);
    return IrVal { k: IRK_INT, r0: dst, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "dirty_fill") {
    // dirty_fill(d, src, s): the page from the source's data + s.
    let dst = ir_handle_arg(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let src = ir_buf(&mut f, c, &mut m, p, cg_arg(p, i, 1), IRK_BYTES);
    let s = ir_handle_arg(&mut f, c, &mut m, p, cg_arg(p, i, 2));
    if f.failed {
      return ir_none();
    }
    let from = ir_reg(&mut f);
    ir_emit(&mut f, IR_ADD, from, src.r0, s, 0, c.tu64);
    ir_emit(&mut f, IR_COPYPAGE, IR_NONE, dst, from, 0, 0);
    return IrVal { k: IRK_INT, r0: dst, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "pt_free_root") {
    // The root table comes back as the frame it is.
    let mm = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let t = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    if f.failed {
      return ir_none();
    }
    return IrVal { k: IRK_INT, r0: t, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "mmu_enter") {
    // Counts the lease before the table can be in use (`lockinc` is a full
    // barrier), then hands it to the processor; the lease is the table.
    if c.target != TARGET_KERNEL {
      ir_fail(&mut f, "an mmu_enter outside the kernel");
      return ir_none();
    }
    let mm = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let t = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    if f.failed {
      return ir_none();
    }
    let at = ir_count_addr(&mut f, c, IRS_PT_LEASES, t);
    ir_emit(&mut f, IR_LOCKINC, IR_NONE, at, 0, 0, 0);
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_RT, d, t, 0, IRS_USER_TABLE, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "pt_lease_count") {
    // The count of the table's page, read from the runtime's array of 32-bit
    // counts (a load is an acquire on x86).
    let t = ir_int(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return ir_none();
    }
    let at = ir_count_addr(&mut f, c, IRS_PT_LEASES, t);
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_DEVR, d, at, 0, 4, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "pt_has") || name_is(p, i, "pt_writable") || name_is(p, i, "pt_accessible") {
    // An entry of a page table: bit 0 is present, bit 1 writable, bit 10
    // marks an entry that is hidden (`pt_set_access` 0) and still owned.
    let t = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let ix = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let e = ir_reg(&mut f);
    ir_emit(&mut f, IR_LOAD, e, t, ix, 8, 0);
    let d = ir_reg(&mut f);
    if name_is(p, i, "pt_has") {
      let k = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, k, 1025, 0, 0, 0);
      let a = ir_reg(&mut f);
      ir_emit(&mut f, IR_AND, a, e, k, 0, 0);
      let z = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, z, 0, 0, 0, 0);
      ir_emit(&mut f, IR_NE, d, a, z, 0, 0);
    } else if name_is(p, i, "pt_writable") {
      let one = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, one, 1, 0, 0, 0);
      let a = ir_reg(&mut f);
      ir_emit(&mut f, IR_SHR, a, e, one, 0, 0);
      ir_emit(&mut f, IR_AND, d, a, one, 0, 0);
    } else {
      let one = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, one, 1, 0, 0, 0);
      ir_emit(&mut f, IR_AND, d, e, one, 0, 0);
    }
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "pt_put") || name_is(p, i, "pt_put_frame") || name_is(p, i, "pt_put_shared") {
    // A slot: the page's address with the flag bits (1 present, 2 writable,
    // 4 user, 0x200 shared). `pt_put` maps a writable user page.
    let t = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let ix = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let fr = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 2));
    let mut e = fr;
    if name_is(p, i, "pt_put") {
      let k = ir_k(&mut f, 7);
      e = ir_reg(&mut f);
      ir_emit(&mut f, IR_OR, e, fr, k, 0, 0);
    } else {
      let w = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 3));
      let one = ir_k(&mut f, 1);
      let w2 = ir_reg(&mut f);
      ir_emit(&mut f, IR_SHL, w2, w, one, 0, 0);
      let o1 = ir_reg(&mut f);
      ir_emit(&mut f, IR_OR, o1, fr, w2, 0, 0);
      let mut bits = 5;
      if name_is(p, i, "pt_put_shared") {
        bits = 517;
      }
      let k = ir_k(&mut f, bits);
      e = ir_reg(&mut f);
      ir_emit(&mut f, IR_OR, e, o1, k, 0, 0);
    }
    ir_emit(&mut f, IR_STORE, e, t, ix, 8, 0);
    return ir_none();
  }
  if name_is(p, i, "pt_take") || name_is(p, i, "pt_take_frame") || name_is(p, i, "pt_take_shared") {
    // Empties a slot and returns the page it held.
    let t = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let ix = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let e = ir_reg(&mut f);
    ir_emit(&mut f, IR_LOAD, e, t, ix, 8, 0);
    let z = ir_k(&mut f, 0);
    ir_emit(&mut f, IR_STORE, z, t, ix, 8, 0);
    let mask = ir_k(&mut f, 4503599627366400);
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_AND, d, e, mask, 0, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "pt_set_access") {
    // Clears present, writable and hidden (bit 10), then sets hidden for 0,
    // present for 1, present and writable for 2 (2a - 1 for a > 0).
    let t = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let ix = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let acc = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 2));
    let e = ir_reg(&mut f);
    ir_emit(&mut f, IR_LOAD, e, t, ix, 8, 0);
    let keep = ir_k(&mut f, 18446744073709550588);
    let base = ir_reg(&mut f);
    ir_emit(&mut f, IR_AND, base, e, keep, 0, 0);
    let one = ir_k(&mut f, 1);
    let a2 = ir_reg(&mut f);
    ir_emit(&mut f, IR_SHL, a2, acc, one, 0, 0);
    let m1 = ir_reg(&mut f);
    ir_emit(&mut f, IR_SUB, m1, a2, one, 0, 0);
    let zero = ir_k(&mut f, 0);
    let z = ir_reg(&mut f);
    ir_emit(&mut f, IR_EQ, z, acc, zero, 0, 0);
    let zm = ir_reg(&mut f);
    ir_emit(&mut f, IR_SUB, zm, z, one, 0, 0);
    let lo = ir_reg(&mut f);
    ir_emit(&mut f, IR_AND, lo, m1, zm, 0, 0);
    let ten = ir_k(&mut f, 10);
    let hid = ir_reg(&mut f);
    ir_emit(&mut f, IR_SHL, hid, z, ten, 0, 0);
    let bits = ir_reg(&mut f);
    ir_emit(&mut f, IR_OR, bits, lo, hid, 0, 0);
    let out = ir_reg(&mut f);
    ir_emit(&mut f, IR_OR, out, base, bits, 0, 0);
    ir_emit(&mut f, IR_STORE, out, t, ix, 8, 0);
    return ir_none();
  }
  if name_is(p, i, "pt_shared") {
    // Bit 9, which the processor ignores, marks a slot mapping a shared page.
    let t = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let ix = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let e = ir_reg(&mut f);
    ir_emit(&mut f, IR_LOAD, e, t, ix, 8, 0);
    let nine = ir_k(&mut f, 9);
    let sh = ir_reg(&mut f);
    ir_emit(&mut f, IR_SHR, sh, e, nine, 0, 0);
    let one = ir_k(&mut f, 1);
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_AND, d, sh, one, 0, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "frame_read") || name_is(p, i, "frame_read8") {
    // A frame is the address of its page.
    let fr = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let ix = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let d = ir_reg(&mut f);
    let mut size = 8;
    if name_is(p, i, "frame_read8") {
      size = 1;
    }
    ir_emit(&mut f, IR_LOAD, d, fr, ix, size, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "frame_write") || name_is(p, i, "frame_write8") {
    let fr = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let ix = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let v = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 2));
    let mut size = 8;
    if name_is(p, i, "frame_write8") {
      size = 1;
    }
    ir_emit(&mut f, IR_STORE, v, fr, ix, size, 0);
    return ir_none();
  }
  if is_pt_borrow_builtin(p, n.s, n.e) {
    // `pt_borrow(&mut t, i, f, args..)` (`pt_borrow_frame` alike): `f` gets
    // the address of a copy of the child in slot `i`, which it may change
    // only in its contents (proved), so nothing is written back.
    let t = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let ix = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let fnode = node_at(p.nodes, cg_arg(p, i, 2));
    let def = plain_fn(p, fnode.s, fnode.e);
    if def == 0 {
      ir_fail(&mut f, "a pt_borrow of a generic function");
      return ir_none();
    }
    let e = ir_reg(&mut f);
    ir_emit(&mut f, IR_LOAD, e, t, ix, 8, 0);
    let mask = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, mask, 4503599627366400, 0, 0, 0);
    let child = ir_reg(&mut f);
    ir_emit(&mut f, IR_AND, child, e, mask, 0, 0);
    let callee = plain_inst(&mut m, def);
    return ir_call_to(&mut f, c, &mut m, p, i, callee, IrVal { k: IRK_INT, r0: child, r1: IR_NONE, t: 0 }, cg_arg(p, i, 3));
  }
  if name_is(p, i, "serial_write") {
    // `serial_write(con, byte)`: the capability is only a name for the right
    // to call it.
    let a1 = next_of(p, n.a);
    let b = ir_int(&mut f, c, &mut m, p, a1);
    ir_emit(&mut f, IR_PUTC, IR_NONE, b, 0, 0, 0);
    return ir_none();
  }
  if name_is(p, i, "serial_read") {
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_GETC, d, 0, 0, 0, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "print") {
    let a = ir_int(&mut f, c, &mut m, p, n.a);
    ir_emit(&mut f, IR_PRINT, IR_NONE, a, 0, 0, 0);
    return ir_none();
  }
  if is_builtin_name(c, p, n.s, n.e) {
    let first = !f.failed;
    ir_fail(&mut f, "a builtin outside the first subset: ");
    if first && n.s <= n.e && n.e <= blen(p.src) {
      let mut k = n.s;
      while k < n.e
        invariant n.e <= blen(p.src)
      {
        vec_push(&mut f.why, cast[u64](bget(p.src, k)));
        k = k + 1;
      }
    }
    return ir_none();
  }
  let def = plain_fn(p, n.s, n.e);
  if def == 0 {
    ir_fail(&mut f, "a call of a generic function");
    return ir_none();
  }
  let callee = plain_inst(&mut m, def);
  return ir_call_to(&mut f, c, &mut m, p, i, callee, ir_none(), IR_NONE);
}

/// The call node `i` of function instance `callee`: the arguments, the
/// call, and the lent buffers read back. With `pre.k != 0`, the first
/// argument is the value `pre` and the argument nodes start at `a0` (as for
/// `pt_borrow`, whose first argument the call makes up); otherwise they start
/// at the call's own, and `a0` is ignored.
fn ir_call_to(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64, callee: u64, pre: IrVal, a0: u64) -> IrVal {
  let n = node_at(p.nodes, i);
  let mut regs = vec_new[u64]();
  let mut lent = vec_new[u64]();
  let mut a = n.a;
  let mut havepre = pre.k != 0;
  if havepre {
    a = a0;
  }
  // A `locked` call: the lock word is the place's base (its payload is the
  // place), taken once the arguments are evaluated.
  let mut lockreg = IR_NONE;
  if pre.k == IRK_PLACE && pre.t == IR_NONE {
    lockreg = pre.r0;
  }
  let cdef = inst_at(m, callee);
  let cdn = node_at(p.nodes, cdef.def);
  let mut cq = cdn.a;
  while (a != 0 || havepre) && !f.failed {
    let mut pt_kind = 0;
    let mut pt = 0;
    if cq != 0 {
      let cqn = node_at(p.nodes, cq);
      pt = conv(&mut m, p, cqn.a, callee, cq);
      pt_kind = kind_t(m, pt);
      cq = cqn.next;
    }
    let pu = base_t(m, pt);
    let mut v = pre;
    let from_pre = havepre;
    if havepre {
      havepre = false;
    } else if pt_kind == TY_MUTREF && kind_of(p, a) == E_MUTBORROW && (ir_kind(c, m, p, pu) == IRK_BUF || ir_kind(c, m, p, pu) == IRK_BYTES) {
      // A buffer in a field: the callee may replace it (`t = nt`), so it is
      // lent by the address of the field's own two words.
      v = ir_mutborrow_place(&mut f, c, &mut m, p, a);
      if !f.failed && v.k != IRK_PLACE {
        v = ir_expr(&mut f, c, &mut m, p, a);
      }
    } else {
      v = ir_expr(&mut f, c, &mut m, p, a);
    }
    let aggr = pt != 0 && (kind_t(m, pu) == TY_STRUCT || kind_t(m, pu) == TY_ENUM || kind_t(m, pu) == TY_CHILD);
    if f.failed {
      // Nothing more to lower.
    } else if aggr && pt_kind == TY_MUTREF {
      // Lent by address.
      if ir_multi(v.k) && v.r1 <= 64 {
        // A struct held in registers: its words go to a slot, the callee gets
        // the address, and they are read back after the call.
        let slot = ir_reg(&mut f);
        ir_emit(&mut f, IR_SLOT, slot, 0, 0, v.r1, 0);
        ir_store_words(&mut f, slot, 0, v.r0, v.r1);
        vec_push(&mut regs, slot);
        vec_push(&mut lent, slot);
        vec_push(&mut lent, v.r0);
        vec_push(&mut lent, wrap_add(IR_LENT_WORDS, v.r1));
      } else if v.k != IRK_PLACE {
        ir_fail(&mut f, "a `&mut` argument that is not a struct in memory");
      } else {
        vec_push(&mut regs, ir_paddr(&mut f, v));
      }
    } else if aggr && pt_kind == TY_REF && ir_mw(c, m, p, pu, 0) != IR_NONE && ir_mw(c, m, p, pu, 0) >= 4 {
      // Large borrows go by address too (`x86_byaddr`).
      if v.k == IRK_PLACE {
        vec_push(&mut regs, ir_paddr(&mut f, v));
      } else if ir_multi(v.k) {
        let slot = ir_reg(&mut f);
        ir_emit(&mut f, IR_SLOT, slot, 0, 0, v.r1, 0);
        ir_store_words(&mut f, slot, 0, v.r0, v.r1);
        vec_push(&mut regs, slot);
      } else {
        ir_fail(&mut f, "a borrowed argument of another kind");
      }
    } else if pt_kind == TY_MUTREF && v.k == IRK_PLACE && (ir_kind(c, m, p, pu) == IRK_INT || ir_kind(c, m, p, pu) == IRK_BOX) {
      // A scalar in memory (a field): its address.
      vec_push(&mut regs, ir_paddr(&mut f, v));
    } else if pt_kind == TY_MUTREF && (v.k == IRK_INT || v.k == IRK_BOX) {
      // A scalar variable: its word goes to a slot, the callee gets the
      // address, and the word is read back after the call.
      let slot = ir_reg(&mut f);
      ir_emit(&mut f, IR_SLOT, slot, 0, 0, 1, 0);
      ir_store_words(&mut f, slot, 0, v.r0, 1);
      vec_push(&mut regs, slot);
      vec_push(&mut lent, slot);
      vec_push(&mut lent, v.r0);
      vec_push(&mut lent, wrap_add(IR_LENT_WORDS, 1));
    } else if pt_kind == TY_MUTREF && v.k == IRK_PLACE && (ir_kind(c, m, p, pu) == IRK_BUF || ir_kind(c, m, p, pu) == IRK_BYTES) {
      // A buffer held in memory: its own address, and the callee's changes
      // land in it.
      vec_push(&mut regs, ir_paddr(&mut f, v));
    } else if v.k == IRK_PLACE {
      // By value: the words of the place.
      let w = ir_mw(c, m, p, v.t, 0);
      if w == IR_NONE || w == 0 || w > 8192 {
        ir_fail(&mut f, "an argument of a type the IR does not know");
      } else {
        let d = ir_new_val(&mut f, IRK_STRUCT, w, v.t);
        ir_load_words(&mut f, v.r0, v.r1, d.r0, w);
        let mut j = 0;
        while j < w {
          vec_push(&mut regs, wrap_add(d.r0, j));
          j = j + 1;
        }
      }
    } else if v.k == IRK_VEC {
      if pt_kind == TY_MUTREF {
        vec_push(&mut regs, v.r0);
      } else {
        // By value or shared: the three header words, as the existing
        // calling convention passes them.
        let mut w = 0;
        while w < 3 {
          vec_push(&mut regs, ir_hdr_load(&mut f, v.r0, w));
          w = w + 1;
        }
      }
    } else if pt_kind == TY_MUTREF && (v.k == IRK_BUF || v.k == IRK_BYTES) {
      // A lent buffer goes by address of its two words (length, then data);
      // the callee cannot replace it, so nothing is copied back.
      let slot = ir_reg(&mut f);
      ir_emit(&mut f, IR_SLOT, slot, 0, 0, 2, 0);
      ir_hdr_store(&mut f, slot, 0, v.r1);
      ir_hdr_store(&mut f, slot, 1, v.r0);
      vec_push(&mut regs, slot);
      vec_push(&mut lent, slot);
      vec_push(&mut lent, v.r0);
      vec_push(&mut lent, v.r1);
    } else if ir_multi(v.k) {
      let mut w = 0;
      while w < v.r1 && w < 512 {
        vec_push(&mut regs, wrap_add(v.r0, w));
        w = w + 1;
      }
    } else {
      vec_push(&mut regs, v.r0);
      if v.r1 != IR_NONE {
        vec_push(&mut regs, v.r1);
      }
    }
    if !from_pre {
      a = next_of(p, a);
    }
  }
  let first = vec_len(f.args);
  let mut j = 0;
  while j < vec_len(regs) {
    vec_push(&mut f.args, vec_get(regs, j));
    j = j + 1;
  }
  let count = vec_len(regs);
  vec_free(regs);
  if f.failed {
    vec_free(lent);
    return ir_none();
  }
  let rt = cg_ret_ty(&mut m, p, callee);
  let rk = ir_kind(c, m, p, rt);
  let rmw = ir_ms(c, m, p, rt);
  if rk == 0 && rmw > 0 {
    // A struct with a Vec in it: the callee writes it to the space the call
    // reserves, and it stays there as a place.
    let slot = ir_reg(&mut f);
    ir_lock_acquire(&mut f, lockreg);
    ir_emit(&mut f, IR_CALLM, slot, callee, first, count, rmw);
    ir_take_back(&mut f, lent);
    vec_free(lent);
    return IrVal { k: IRK_PLACE, r0: slot, r1: 0, t: base_t(m, rt) };
  }
  if rk == 0 && kind_t(m, rt) != TY_UNIT {
    ir_fail(&mut f, "a call with a result that is not an integer or a buffer");
    vec_free(lent);
    return ir_none();
  }
  let mut d = IrVal { k: 0, r0: IR_NONE, r1: IR_NONE, t: 0 };
  if rk != 0 {
    d = ir_new_val(&mut f, rk, ir_words(c, m, p, rt, 0), base_t(m, rt));
  }
  if rk == IRK_VEC || (ir_multi(rk) && d.r1 > 2) {
    // The callee writes its result to the space the call reserves; it is
    // in a frame slot after the call.
    let mut w = 3;
    if rk != IRK_VEC {
      w = d.r1;
    }
    let slot = ir_reg(&mut f);
    ir_lock_acquire(&mut f, lockreg);
    ir_emit(&mut f, IR_CALLM, slot, callee, first, count, w);
    ir_take_back(&mut f, lent);
    vec_free(lent);
    if rk == IRK_VEC {
      return IrVal { k: IRK_VEC, r0: slot, r1: IR_NONE, t: ir_vt(inner_t(m, base_t(m, rt)), 0) };
    }
    ir_load_words(&mut f, slot, 0, d.r0, w);
    return d;
  }
  ir_lock_acquire(&mut f, lockreg);
  if ir_multi(d.k) {
    let mut second = IR_NONE;
    if d.r1 == 2 {
      second = wrap_add(d.r0, 1);
    }
    ir_emit(&mut f, IR_CALL, d.r0, callee, first, count, second);
  } else {
    ir_emit(&mut f, IR_CALL, d.r0, callee, first, count, d.r1);
  }
  ir_take_back(&mut f, lent);
  vec_free(lent);
  return d;
}

/// Takes the lock whose word is at address register `l` (IR_NONE: none).
fn ir_lock_acquire(f: &mut IrFn, l: u64) {
  if l != IR_NONE {
    ir_emit(&mut f, IR_LOCKACQ, IR_NONE, l, 0, 0, 0);
  }
}

/// Before a return: the lent buffers go back to their callers' words, since
/// the function may have replaced them.
fn ir_give_back(f: &mut IrFn) {
  let mut j = 0;
  while wrap_add(j, 2) < vec_len(f.lent) && j < 1000000 {
    let a = vec_get(f.lent, j);
    let data = vec_get(f.lent, wrap_add(j, 1));
    let len = vec_get(f.lent, wrap_add(j, 2));
    if len >= IR_LENT_WORDS {
      // A scalar: its word goes back.
      ir_store_words(&mut f, a, 0, data, len - IR_LENT_WORDS);
    } else {
      ir_hdr_store(&mut f, a, 0, len);
      ir_hdr_store(&mut f, a, 1, data);
    }
    j = j + 3;
  }
}

/// After a call: the lent buffers (slot, data, length registers of the
/// caller's variable) are read back, since the callee may have replaced them.
fn ir_take_back(f: &mut IrFn, lent: &Vec[u64]) {
  let mut j = 0;
  while wrap_add(j, 2) < vec_len(lent) && j < 1000000 {
    let slot = vec_get(lent, j);
    let data = vec_get(lent, wrap_add(j, 1));
    let len = vec_get(lent, wrap_add(j, 2));
    if len >= IR_LENT_WORDS {
      // A struct or enum held in registers: its words, from `data` on.
      ir_load_words(&mut f, slot, 0, data, len - IR_LENT_WORDS);
    } else {
      let k1 = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, k1, 1, 0, 0, 0);
      ir_emit(&mut f, IR_LOAD, data, slot, k1, 8, 0);
      let k0 = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, k0, 0, 0, 0, 0);
      ir_emit(&mut f, IR_LOAD, len, slot, k0, 8, 0);
    }
    j = j + 3;
  }
}

fn ir_block(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, head: u64) {
  let saved = vec_len(f.vars);
  let mut i = head;
  while i != 0 && !f.failed {
    ir_stmt(&mut f, c, &mut m, p, i);
    i = next_of(p, i);
  }
  ir_truncate(&mut f, saved);
}

/// Is `e` a value a loop can compute once: a variable other than the one
/// named `s..e` (the counter), a literal, or a `cast` / `wrap` of one?
fn ir_invariant(p: &Parser, e: u64, s: u64, en: u64) -> bool {
  let x = node_at(p.nodes, e);
  if x.kind == E_INT {
    return true;
  }
  if x.kind == E_VAR {
    return !same(p.src, x.s, x.e, s, en);
  }
  if x.kind == E_TAPP && (name_is(p, x.b, "cast") || name_is(p, x.b, "wrap")) {
    let inner = node_at(p.nodes, x.b);
    let y = node_at(p.nodes, inner.a);
    return y.kind == E_INT || (y.kind == E_VAR && !same(p.src, y.s, y.e, s, en));
  }
  return false;
}

/// A loop `while i < n { bset(&mut b, i, v); i = i + 1; }` (the body is just
/// those two statements, `n` and `v` are variables or literals that the loop
/// does not change) is one `fill` of the bytes `i .. n` of `b` and `i = n`,
/// when `i < n` holds on entry. With `bget(s, i)` for `v` it is one `copy`
/// of the bytes `i .. n` of `s` (another buffer). Returns whether it was
/// lowered that way.
fn ir_fill_loop(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, w: u64) -> bool {
  let n = node_at(p.nodes, w);
  let cond = node_at(p.nodes, n.a);
  if cond.kind != E_BIN || cond.v != P_LT || n.c == 0 {
    return false;
  }
  let ci = node_at(p.nodes, cond.a);
  let cb = node_at(p.nodes, cond.b);
  if ci.kind != E_VAR || !(cb.kind == E_VAR || cb.kind == E_INT) {
    return false;
  }
  let s1 = node_at(p.nodes, n.c);
  if s1.kind != S_EXPR || s1.next == 0 {
    return false;
  }
  let s2 = node_at(p.nodes, s1.next);
  if s2.kind != S_ASSIGN || s2.next != 0 {
    return false;
  }
  let call = node_at(p.nodes, s1.a);
  if call.kind != E_CALL || !name_is(p, s1.a, "bset") {
    return false;
  }
  let a1 = next_of(p, call.a);
  let a2 = next_of(p, a1);
  if a1 == 0 || a2 == 0 || next_of(p, a2) != 0 {
    return false;
  }
  let ix = node_at(p.nodes, a1);
  if ix.kind != E_VAR || !same(p.src, ix.s, ix.e, ci.s, ci.e) {
    return false;
  }
  let vn = node_at(p.nodes, a2);
  let mut src = 0;
  if vn.kind == E_CALL && name_is(p, a2, "bget") {
    // `bset(&mut b, i, bget(s, i))`: a copy from `s`, a different buffer
    // (a variable `s` spelled like `b` would be the same one).
    let sa1 = next_of(p, vn.a);
    let sx = node_at(p.nodes, sa1);
    let dst = node_at(p.nodes, call.a);
    let dseg = node_at(p.nodes, dst.a);
    let sv = node_at(p.nodes, vn.a);
    if vn.a == 0 || sa1 == 0 || next_of(p, sa1) != 0 || sx.kind != E_VAR || !same(p.src, sx.s, sx.e, ci.s, ci.e) {
      return false;
    }
    if dst.kind != E_MUTBORROW || (sv.kind == E_VAR && dseg.next == 0 && same(p.src, dseg.s, dseg.e, sv.s, sv.e)) {
      return false;
    }
    src = vn.a;
  } else if !ir_invariant(p, a2, ci.s, ci.e) {
    return false;
  }
  // `i = i + 1`
  let path = node_at(p.nodes, s2.a);
  let rhs = node_at(p.nodes, s2.b);
  if path.next != 0 || !same(p.src, path.s, path.e, ci.s, ci.e) || rhs.kind != E_BIN || rhs.v != P_PLUS {
    return false;
  }
  let ra = node_at(p.nodes, rhs.a);
  let rb = node_at(p.nodes, rhs.b);
  if ra.kind != E_VAR || !same(p.src, ra.s, ra.e, ci.s, ci.e) || rb.kind != E_INT || rb.v != 1 {
    return false;
  }
  let target = ir_find(f, p, ci.s, ci.e);
  if target.k != IRK_INT {
    return false;
  }
  let l_body = ir_label(&mut f);
  let l_end = ir_label(&mut f);
  ir_branch(&mut f, c, &mut m, p, n.a, l_body, l_end);
  ir_place(&mut f, l_body);
  let b = ir_buf(&mut f, c, &mut m, p, call.a, IRK_BYTES);
  let iv = ir_int(&mut f, c, &mut m, p, a1);
  let nv = ir_int(&mut f, c, &mut m, p, cond.b);
  if src != 0 {
    let sb = ir_buf(&mut f, c, &mut m, p, src, IRK_BYTES);
    if !f.failed {
      let cnt = ir_reg(&mut f);
      ir_emit(&mut f, IR_SUB, cnt, nv, iv, 0, c.tu64);
      ir_copy_bytes(&mut f, c, b.r0, iv, sb.r0, iv, cnt);
      ir_emit(&mut f, IR_MOV, target.r0, nv, 0, 0, 0);
    }
  } else {
    let v = ir_int(&mut f, c, &mut m, p, a2);
    if !f.failed {
      let da = ir_reg(&mut f);
      ir_emit(&mut f, IR_ADD, da, b.r0, iv, 0, c.tu64);
      let cnt = ir_reg(&mut f);
      ir_emit(&mut f, IR_SUB, cnt, nv, iv, 0, c.tu64);
      ir_emit(&mut f, IR_FILL, IR_NONE, da, v, cnt, 0);
      ir_emit(&mut f, IR_MOV, target.r0, nv, 0, 0, 0);
    }
  }
  ir_place(&mut f, l_end);
  return true;
}

// ---- Little-endian stores of the core library ----
//
// `store_le16`, `store_le32` and `store_le64` of core/endian.bastio put a
// value into a Bytes one byte at a time (two, four or eight `bset`s with a
// shift and a mask each). On a little-endian machine that is one store. A
// function is recognised by what its body does, not by its name alone:
// `store_le16` must be two `bset`s of the low and the high byte of its value
// at `at` and `at + 1`, and `store_le32` / `store_le64` two calls of the
// next narrower function for the low and the high half, at `at` and at the
// half's width on. Anything else with these names is lowered as written.

/// Is `t` the named type `w`?
fn ir_ty_is(p: &Parser, t: u64, w: Str) -> bool {
  let x = node_at(p.nodes, t);
  return t != 0 && x.kind == T_NAMED && span_is(p, x.s, x.e, w);
}

/// Is `e` the variable spelled `s..en`?
fn ir_is_var(p: &Parser, e: u64, s: u64, en: u64) -> bool {
  let x = node_at(p.nodes, e);
  return e != 0 && x.kind == E_VAR && same(p.src, x.s, x.e, s, en);
}

/// Is `e` `var op k` (`op` the punctuation code, `k` a literal)?
fn ir_is_var_op_int(p: &Parser, e: u64, s: u64, en: u64, op: u64, k: u64) -> bool {
  let x = node_at(p.nodes, e);
  if e == 0 || x.kind != E_BIN || x.v != op {
    return false;
  }
  let y = node_at(p.nodes, x.b);
  return ir_is_var(p, x.a, s, en) && x.b != 0 && y.kind == E_INT && y.v == k;
}

/// The argument of `cast[ty](arg)` when `e` is that, else 0.
fn ir_cast_arg(p: &Parser, e: u64, ty: Str) -> u64 {
  let x = node_at(p.nodes, e);
  if e == 0 || x.kind != E_TAPP || !name_is(p, x.b, "cast") || !ir_ty_is(p, x.a, ty) {
    return 0;
  }
  let t = node_at(p.nodes, x.a);
  let inner = node_at(p.nodes, x.b);
  if t.next != 0 || inner.a == 0 || next_of(p, inner.a) != 0 {
    return 0;
  }
  return inner.a;
}

/// Is `e` `&mut b` for the parameter spelled `s..en`?
fn ir_is_mutborrow_of(p: &Parser, e: u64, s: u64, en: u64) -> bool {
  let x = node_at(p.nodes, e);
  if e == 0 || x.kind != E_MUTBORROW || x.a == 0 {
    return false;
  }
  let seg = node_at(p.nodes, x.a);
  return seg.next == 0 && same(p.src, seg.s, seg.e, s, en);
}

/// Is statement `st` a call of `callee` (a name) with the three arguments
/// `&mut b`, `at + off` (`at` alone when `off` is 0) and a `cast[ty]` of
/// `v op k`? `b`, `at` and `v` are the parameters at `q1`, `q2`, `q3`.
fn ir_le_part(p: &Parser, st: u64, callee: Str, q1: u64, q2: u64, q3: u64, off: u64, ty: Str, op: u64, k: u64) -> bool {
  let sn = node_at(p.nodes, st);
  if st == 0 || sn.kind != S_EXPR || sn.a == 0 {
    return false;
  }
  let call = node_at(p.nodes, sn.a);
  if call.kind != E_CALL || !name_is(p, sn.a, callee) {
    return false;
  }
  let a1 = next_of(p, call.a);
  let a2 = next_of(p, a1);
  if call.a == 0 || a1 == 0 || a2 == 0 || next_of(p, a2) != 0 {
    return false;
  }
  let pb = node_at(p.nodes, q1);
  let pa = node_at(p.nodes, q2);
  let pv = node_at(p.nodes, q3);
  if !ir_is_mutborrow_of(p, call.a, pb.s, pb.e) {
    return false;
  }
  if off == 0 {
    if !ir_is_var(p, a1, pa.s, pa.e) {
      return false;
    }
  } else if !ir_is_var_op_int(p, a1, pa.s, pa.e, P_PLUS, off) {
    return false;
  }
  let inner = ir_cast_arg(p, a2, ty);
  return inner != 0 && ir_is_var_op_int(p, inner, pv.s, pv.e, op, k);
}

/// The three parameters of `dn` when it has exactly `b: &mut Bytes`, `at:
/// u64` and `v: <vt>`, and no result: their nodes in `ps` (else it is empty).
fn ir_le_params(p: &Parser, dn: Node, vt: Str, ps: &mut Vec[u64]) {
  let q1 = dn.a;
  let n1 = node_at(p.nodes, q1);
  let q2 = n1.next;
  let n2 = node_at(p.nodes, q2);
  let q3 = n2.next;
  let n3 = node_at(p.nodes, q3);
  if q1 == 0 || q2 == 0 || q3 == 0 || n3.next != 0 || dn.v != 0 {
    return;
  }
  let t1 = node_at(p.nodes, n1.a);
  if n1.a == 0 || t1.kind != T_MUTREF || !ir_ty_is(p, t1.a, "Bytes") {
    return;
  }
  if !ir_ty_is(p, n2.a, "u64") || !ir_ty_is(p, n3.a, vt) {
    return;
  }
  let rt = node_at(p.nodes, dn.b);
  if dn.b != 0 && rt.kind != T_UNIT {
    return;
  }
  vec_push(&mut ps, q1);
  vec_push(&mut ps, q2);
  vec_push(&mut ps, q3);
}

/// 2, 4 or 8 when `dn` is `store_le16`, `store_le32` or `store_le64` as
/// core/endian.bastio writes them (see above), else 0. `half` is what the
/// function it calls is (`ir_le_store_size` of that definition).
fn ir_le_store_shape(p: &Parser, dn: Node, half: u64) -> u64 {
  let mut ps = vec_new[u64]();
  let mut r = 0;
  let mut w = 2;
  let mut vt = "u16";
  let mut callee = "bset";
  let mut cty = "u8";
  if half == 2 {
    w = 4;
    vt = "u32";
    callee = "store_le16";
    cty = "u16";
  } else if half == 4 {
    w = 8;
    vt = "u64";
    callee = "store_le32";
    cty = "u32";
  }
  if (w == 2 && half == 0) || (w != 2 && half == w / 2) {
    ir_le_params(p, dn, vt, &mut ps);
  }
  if vec_len(ps) == 3 {
    let s1 = dn.x;
    let n1 = node_at(p.nodes, s1);
    let s2 = n1.next;
    let n2 = node_at(p.nodes, s2);
    let bits = w * 4;                 // the half's width in bits
    if s1 != 0 && s2 != 0 && n2.next == 0 {
      let q1 = vec_get(ps, 0);
      let q2 = vec_get(ps, 1);
      let q3 = vec_get(ps, 2);
      if w == 2 {
        if ir_le_part(p, s1, callee, q1, q2, q3, 0, cty, P_AMP, 255) && ir_le_part(p, s2, callee, q1, q2, q3, 1, cty, P_SHR, 8) {
          r = w;
        }
      } else {
        let mut lim = 65535;
        if w == 8 {
          lim = 4294967295;
        }
        if ir_le_part(p, s1, callee, q1, q2, q3, 0, cty, P_AMP, lim) && ir_le_part(p, s2, callee, q1, q2, q3, w / 2, cty, P_SHR, bits) {
          r = w;
        }
      }
    }
  }
  vec_free(ps);
  return r;
}

/// The definition of the function the first statement of `d` calls, or 0.
fn ir_le_callee(p: &Parser, d: u64) -> u64 {
  let dn = node_at(p.nodes, d);
  let s1 = node_at(p.nodes, dn.x);
  if dn.x == 0 || s1.kind != S_EXPR || s1.a == 0 {
    return 0;
  }
  return find_fn(p, s1.a);
}

/// 2, 4 or 8 when the function definition `d` is a recognised
/// `store_le16`, `store_le32` or `store_le64`, else 0.
fn ir_le_store_size(p: &Parser, d: u64) -> u64 {
  if d == 0 {
    return 0;
  }
  let dn = node_at(p.nodes, d);
  if dn.kind != D_FN {
    return 0;
  }
  if name_is(p, d, "store_le16") {
    return ir_le_store_shape(p, dn, 0);
  }
  if name_is(p, d, "store_le32") {
    let c16 = ir_le_callee(p, d);
    if c16 != 0 && name_is(p, c16, "store_le16") && ir_le_store_shape(p, node_at(p.nodes, c16), 0) == 2 {
      return ir_le_store_shape(p, dn, 2);
    }
    return 0;
  }
  if name_is(p, d, "store_le64") {
    let c32 = ir_le_callee(p, d);
    if c32 != 0 && name_is(p, c32, "store_le32") {
      let c16 = ir_le_callee(p, c32);
      if c16 != 0 && name_is(p, c16, "store_le16") && ir_le_store_shape(p, node_at(p.nodes, c16), 0) == 2 && ir_le_store_shape(p, node_at(p.nodes, c32), 2) == 4 {
        return ir_le_store_shape(p, dn, 4);
      }
    }
    return 0;
  }
  return 0;
}

/// Is `e` `bget(b, at + off)` (`at` alone when `off` is 0) for the
/// parameters spelled `bs..be` and `as..ae`?
fn ir_is_bget(p: &Parser, e: u64, bs: u64, be: u64, as_: u64, ae: u64, off: u64) -> bool {
  let x = node_at(p.nodes, e);
  if e == 0 || x.kind != E_CALL || !name_is(p, e, "bget") {
    return false;
  }
  let a1 = next_of(p, x.a);
  if x.a == 0 || a1 == 0 || next_of(p, a1) != 0 || !ir_is_var(p, x.a, bs, be) {
    return false;
  }
  if off == 0 {
    return ir_is_var(p, a1, as_, ae);
  }
  return ir_is_var_op_int(p, a1, as_, ae, P_PLUS, off);
}

/// Is `e` `cast[ty](bget(b, at + off))`?
fn ir_is_cast_bget(p: &Parser, e: u64, ty: Str, bs: u64, be: u64, as_: u64, ae: u64, off: u64) -> bool {
  let inner = ir_cast_arg(p, e, ty);
  return inner != 0 && ir_is_bget(p, inner, bs, be, as_, ae, off);
}

/// Is `e` `cast[ty](callee(b, at + off))`?
fn ir_is_cast_load(p: &Parser, e: u64, ty: Str, callee: Str, bs: u64, be: u64, as_: u64, ae: u64, off: u64) -> bool {
  let inner = ir_cast_arg(p, e, ty);
  let x = node_at(p.nodes, inner);
  if inner == 0 || x.kind != E_CALL || !name_is(p, inner, callee) {
    return false;
  }
  let a1 = next_of(p, x.a);
  if x.a == 0 || a1 == 0 || next_of(p, a1) != 0 || !ir_is_var(p, x.a, bs, be) {
    return false;
  }
  if off == 0 {
    return ir_is_var(p, a1, as_, ae);
  }
  return ir_is_var_op_int(p, a1, as_, ae, P_PLUS, off);
}

/// Is `dn` `fn NAME(b: &Bytes, at: u64) -> <rt>`? Then its parameters are in
/// `ps`.
fn ir_le_load_params(p: &Parser, dn: Node, rt: Str, ps: &mut Vec[u64]) {
  let q1 = dn.a;
  let n1 = node_at(p.nodes, q1);
  let q2 = n1.next;
  let n2 = node_at(p.nodes, q2);
  if q1 == 0 || q2 == 0 || n2.next != 0 || dn.v != 0 || n1.a == 0 {
    return;
  }
  let t1 = node_at(p.nodes, n1.a);
  if t1.kind != T_REF || !ir_ty_is(p, t1.a, "Bytes") || !ir_ty_is(p, n2.a, "u64") || !ir_ty_is(p, dn.b, rt) {
    return;
  }
  vec_push(&mut ps, q1);
  vec_push(&mut ps, q2);
}

/// 2, 4 or 8 when `dn` is `load_le16`, `load_le32` or `load_le64` as
/// core/endian.bastio writes them: the low and the high half added, the high
/// one shifted up (`half` is what the function it calls is, 0 for 16).
fn ir_le_load_shape(p: &Parser, dn: Node, half: u64) -> u64 {
  let mut ps = vec_new[u64]();
  let mut r = 0;
  let mut w = 2;
  let mut rt = "u16";
  let mut callee = "bget";
  if half == 2 {
    w = 4;
    rt = "u32";
    callee = "load_le16";
  } else if half == 4 {
    w = 8;
    rt = "u64";
    callee = "load_le32";
  }
  if (w == 2 && half == 0) || (w != 2 && half == w / 2) {
    ir_le_load_params(p, dn, rt, &mut ps);
  }
  if vec_len(ps) == 2 {
    let pb = node_at(p.nodes, vec_get(ps, 0));
    let pa = node_at(p.nodes, vec_get(ps, 1));
    let bits = w * 4;
    if w == 2 {
      // return cast[u16](bget(b, at)) + (cast[u16](bget(b, at + 1)) << 8);
      let s1 = node_at(p.nodes, dn.x);
      let e = node_at(p.nodes, s1.a);
      let sh = node_at(p.nodes, e.b);
      let k = node_at(p.nodes, sh.b);
      if dn.x != 0 && s1.kind == S_RETURN && s1.next == 0 && e.kind == E_BIN && e.v == P_PLUS && sh.kind == E_BIN && sh.v == P_SHL && k.kind == E_INT && k.v == 8 {
        if ir_is_cast_bget(p, e.a, "u16", pb.s, pb.e, pa.s, pa.e, 0) && ir_is_cast_bget(p, sh.a, "u16", pb.s, pb.e, pa.s, pa.e, 1) {
          r = w;
        }
      }
    } else {
      // let lo = cast[uN](load_leH(b, at)); let hi = cast[uN](load_leH(b, at + H/8));
      // return lo + (hi << H);
      let s1 = node_at(p.nodes, dn.x);
      let s2i = s1.next;
      let s2 = node_at(p.nodes, s2i);
      let s3i = s2.next;
      let s3 = node_at(p.nodes, s3i);
      if dn.x != 0 && s2i != 0 && s3i != 0 && s3.next == 0 && s1.kind == S_LET && s2.kind == S_LET && s3.kind == S_RETURN {
        let e = node_at(p.nodes, s3.a);
        let sh = node_at(p.nodes, e.b);
        let k = node_at(p.nodes, sh.b);
        if e.kind == E_BIN && e.v == P_PLUS && sh.kind == E_BIN && sh.v == P_SHL && k.kind == E_INT && k.v == bits {
          if ir_is_var(p, e.a, s1.s, s1.e) && ir_is_var(p, sh.a, s2.s, s2.e) && ir_is_cast_load(p, s1.b, rt, callee, pb.s, pb.e, pa.s, pa.e, 0) && ir_is_cast_load(p, s2.b, rt, callee, pb.s, pb.e, pa.s, pa.e, w / 2) {
            r = w;
          }
        }
      }
    }
  }
  vec_free(ps);
  return r;
}

/// 2, 4 or 8 when the function definition `d` is a recognised `load_le16`,
/// `load_le32` or `load_le64`, else 0.
fn ir_le_load_size(p: &Parser, d: u64) -> u64 {
  if d == 0 {
    return 0;
  }
  let dn = node_at(p.nodes, d);
  if dn.kind != D_FN {
    return 0;
  }
  if name_is(p, d, "load_le16") {
    return ir_le_load_shape(p, dn, 0);
  }
  if name_is(p, d, "load_le32") {
    let c16 = ir_le_load_callee(p, d);
    if c16 != 0 && name_is(p, c16, "load_le16") && ir_le_load_shape(p, node_at(p.nodes, c16), 0) == 2 {
      return ir_le_load_shape(p, dn, 2);
    }
    return 0;
  }
  if name_is(p, d, "load_le64") {
    let c32 = ir_le_load_callee(p, d);
    if c32 != 0 && name_is(p, c32, "load_le32") {
      let c16 = ir_le_load_callee(p, c32);
      if c16 != 0 && name_is(p, c16, "load_le16") && ir_le_load_shape(p, node_at(p.nodes, c16), 0) == 2 && ir_le_load_shape(p, node_at(p.nodes, c32), 2) == 4 {
        return ir_le_load_shape(p, dn, 4);
      }
    }
    return 0;
  }
  return 0;
}

/// The definition of the function called in the first `let` of `d`'s body.
fn ir_le_load_callee(p: &Parser, d: u64) -> u64 {
  let dn = node_at(p.nodes, d);
  let s1 = node_at(p.nodes, dn.x);
  let init = ir_cast_arg(p, s1.b, "u32");
  let mut e = init;
  if e == 0 {
    e = ir_cast_arg(p, s1.b, "u64");
  }
  if dn.x == 0 || s1.kind != S_LET || e == 0 {
    return 0;
  }
  return find_fn(p, e);
}

fn ir_stmt(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) {
  let n = node_at(p.nodes, i);
  f.cur = n.line;
  let k = n.kind;
  if k == S_LET {
    let t = let_ty(m, f.x, i);
    let kind = ir_kind(c, m, p, t);
    let mw = ir_ms(c, m, p, t);
    if kind == 0 && mw > 0 {
      // A struct with a Vec in it: a frame slot of its own.
      let v = ir_vexpr(&mut f, c, &mut m, p, n.b);
      if f.failed {
        return;
      }
      if v.k != IRK_PLACE {
        ir_fail(&mut f, "an initializer of another kind");
        return;
      }
      let initn = node_at(p.nodes, n.b);
      let initk = initn.kind;
      if initk == E_SLIT || (initk == E_TAPP && kind_of(p, initn.b) == E_SLIT) {
        // A struct literal was just built in a slot of its own: the
        // variable is that slot, not a copy of it.
        ir_bind(&mut f, n.s, n.e, IrVal { k: IRK_PLACE, r0: v.r0, r1: v.r1, t: base_t(m, t) });
        return;
      }
      if initk == E_CALL && vec_len(f.ins) > 0 && v.r1 == 0 {
        // The result of a call is in the space the call reserved in this
        // frame, used by this call alone: the variable is that space.
        let last = vec_get(f.ins, wrap_sub(vec_len(f.ins), 1));
        if last.op == IR_CALLM && last.d == v.r0 {
          ir_bind(&mut f, n.s, n.e, IrVal { k: IRK_PLACE, r0: v.r0, r1: 0, t: base_t(m, t) });
          return;
        }
      }
      let slot = ir_reg(&mut f);
      ir_emit(&mut f, IR_SLOT, slot, 0, 0, mw, 0);
      let r = IrVal { k: IRK_PLACE, r0: slot, r1: 0, t: base_t(m, t) };
      ir_store_val(&mut f, c, m, p, r, v);
      ir_bind(&mut f, n.s, n.e, r);
      return;
    }
    if kind == 0 {
      ir_fail(&mut f, "a variable that is not an integer, bool, buffer, struct, enum or Vec");
      return;
    }
    let before = f.nreg;
    let v = ir_own(&mut f, ir_vexpr(&mut f, c, &mut m, p, n.b));
    if f.failed {
      return;
    }
    // Fresh registers: the initializer's may be another variable's.
    if v.k != kind {
      ir_fail(&mut f, "an initializer of another kind");
      return;
    }
    if kind == IRK_INT && v.r0 >= before {
      // A temporary made by the initializer itself: no one else holds it, so
      // the variable can be that register.
      ir_bind(&mut f, n.s, n.e, v);
      return;
    }
    let r = ir_like(&mut f, v);
    ir_copy(&mut f, r, v);
    ir_bind(&mut f, n.s, n.e, r);
  } else if k == S_ASSIGN {
    let path = node_at(p.nodes, n.a);
    let mut target = ir_find(f, p, path.s, path.e);
    let mut seg = path.next;
    while seg != 0 && target.k != 0 && !f.failed {
      let sn = node_at(p.nodes, seg);
      target = ir_field(&mut f, c, m, p, target, sn.s, sn.e);
      seg = sn.next;
    }
    if target.k == 0 {
      ir_fail(&mut f, "an assignment to something that is not a variable of the subset");
      return;
    }
    let rhs = node_at(p.nodes, n.b);
    if rhs.kind == E_CALL && (name_is(p, n.b, "set") || name_is(p, n.b, "bset")) && ir_is_path(p, rhs.a, path) {
      // `b = set(b, i, v)` (or `q.b = set(q.b, i, v)`) changes the buffer in
      // place.
      let a0 = rhs.a;
      let a1 = next_of(p, a0);
      let a2 = next_of(p, a1);
      let mut kind = IRK_BUF;
      if name_is(p, n.b, "bset") {
        kind = IRK_BYTES;
      }
      target = ir_rv(&mut f, c, m, p, target);
      if target.k != kind {
        ir_fail(&mut f, "a set that does not assign to its own buffer");
        return;
      }
      let ix = ir_int(&mut f, c, &mut m, p, a1);
      let v = ir_int(&mut f, c, &mut m, p, a2);
      if !f.failed {
        let mut size = 8;
        if kind == IRK_BYTES {
          size = 1;
        }
        ir_emit(&mut f, IR_STORE, v, target.r0, ix, size, 0);
      }
      return;
    }
    let v = ir_own(&mut f, ir_vexpr(&mut f, c, &mut m, p, n.b));
    if !f.failed {
      if target.k == IRK_PLACE {
        ir_store_val(&mut f, c, m, p, target, v);
      } else if v.k != target.k {
        ir_fail(&mut f, "an assignment between kinds");
      } else if v.k == IRK_VEC && rhs.kind == E_VAR {
        // A vector taken from another variable moves its header words: both
        // names stand for headers in the frame, and the source's header is
        // written again when the code that made it runs again (a loop), so
        // the target must not keep pointing at it.
        let mut j = 0;
        while j < 3 {
          let w = ir_hdr_load(&mut f, v.r0, j);
          ir_hdr_store(&mut f, target.r0, j, w);
          j = j + 1;
        }
      } else {
        ir_copy(&mut f, target, v);
      }
    }
  } else if k == S_IF {
    let l_then = ir_label(&mut f);
    let l_else = ir_label(&mut f);
    let l_end = ir_label(&mut f);
    ir_branch(&mut f, c, &mut m, p, n.a, l_then, l_else);
    ir_place(&mut f, l_then);
    ir_block(&mut f, c, &mut m, p, n.b);
    ir_jump(&mut f, l_end);
    ir_place(&mut f, l_else);
    if n.c != 0 {
      ir_block(&mut f, c, &mut m, p, n.c);
    }
    ir_place(&mut f, l_end);
  } else if k == S_WHILE {
    if ir_fill_loop(&mut f, c, &mut m, p, i) {
      return;
    }
    let l_head = ir_label(&mut f);
    let l_body = ir_label(&mut f);
    let l_end = ir_label(&mut f);
    ir_place(&mut f, l_head);
    ir_branch(&mut f, c, &mut m, p, n.a, l_body, l_end);
    ir_place(&mut f, l_body);
    ir_block(&mut f, c, &mut m, p, n.c);
    ir_jump(&mut f, l_head);
    ir_place(&mut f, l_end);
  } else if k == S_RETURN {
    if n.a == 0 {
      ir_give_back(&mut f);
      ir_emit(&mut f, IR_RET, IR_NONE, IR_NONE, IR_NONE, 0, 0);
    } else {
      let v = ir_vexpr(&mut f, c, &mut m, p, n.a);
      if f.failed {
        return;
      }
      ir_give_back(&mut f);
      if v.k == IRK_VEC {
        ir_emit(&mut f, IR_RET, IR_NONE, v.r0, IR_NONE, 3, 0);
      } else if v.k == IRK_PLACE && ir_ms(c, m, p, v.t) > 0 {
        let a = ir_paddr(&mut f, v);
        ir_emit(&mut f, IR_RET, IR_NONE, a, IR_NONE, ir_ms(c, m, p, v.t), 0);
      } else if ir_multi(v.k) && v.r1 > 2 {
        let first = vec_len(f.args);
        let mut w = 0;
        while w < v.r1 && w < 4096 {
          vec_push(&mut f.args, wrap_add(v.r0, w));
          w = w + 1;
        }
        ir_emit(&mut f, IR_RET, IR_NONE, IR_NONE, first, v.r1, 0);
      } else if ir_multi(v.k) {
        let mut second = IR_NONE;
        if v.r1 == 2 {
          second = wrap_add(v.r0, 1);
        }
        ir_emit(&mut f, IR_RET, IR_NONE, v.r0, second, 0, 0);
      } else {
        ir_emit(&mut f, IR_RET, IR_NONE, v.r0, v.r1, 0, 0);
      }
    }
    // Code after a return is unreachable but must still sit in a block.
    let dead = ir_label(&mut f);
    ir_place(&mut f, dead);
  } else if k == S_UNREACHABLE {
    ir_emit(&mut f, IR_UNREACH, IR_NONE, 0, 0, 0, 0);
    let dead = ir_label(&mut f);
    ir_place(&mut f, dead);
  } else if k == S_MATCH {
    let scrut0 = ir_expr(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return;
    }
    // An enum the IR cannot hold in registers is matched where it is: its
    // tag is the first word, the payload of a variant the words after it.
    let inplace = scrut0.k == IRK_PLACE && ir_kind(c, m, p, scrut0.t) == 0 && kind_t(m, base_t(m, scrut0.t)) == TY_ENUM;
    let mut scrut = scrut0;
    if !inplace {
      scrut = ir_val(&mut f, c, m, p, scrut0);
    }
    if f.failed {
      return;
    }
    if scrut.k != IRK_ENUM && !inplace {
      ir_fail(&mut f, "a match on something that is not an enum");
      return;
    }
    // The scrutinee is read only at the start of an arm (the tag test, the
    // copy of the payload into the binding), before any statement of an arm
    // runs, so an arm that assigns to what it was read from changes nothing
    // that is still to be read: no copy is needed.
    let mut e = scrut;
    let mut tagr = IR_NONE;
    if inplace {
      tagr = ir_hdr_load(&mut f, scrut.r0, scrut.r1);
    } else {
      tagr = e.r0;
    }
    let x = inner_t(m, e.t);
    let l_end = ir_label(&mut f);
    let mut a = n.b;
    while a != 0 && !f.failed {
      let arm = node_at(p.nodes, a);
      let l_next = ir_label(&mut f);
      let saved = vec_len(f.vars);
      if arm.v != PAT_WILD {
        let v = cg_variant(m, p, x, arm.s2, arm.e2);
        if arm.next != 0 {
          let kr = ir_reg(&mut f);
          ir_emit(&mut f, IR_CONST, kr, v, 0, 0, 0);
          let hit = ir_reg(&mut f);
          ir_emit(&mut f, IR_EQ, hit, tagr, kr, 0, 0);
          let l_arm = ir_label(&mut f);
          ir_emit(&mut f, IR_BR, IR_NONE, hit, l_arm, l_next, 0);
          ir_place(&mut f, l_arm);
        }
        if arm.a != 0 {
          let b = node_at(p.nodes, arm.a);
          if !span_is(p, b.s, b.e, "_") {
            if inplace {
              let ft = fld_ty(c, x, v);
              if ft == 0 {
                ir_fail(&mut f, "a binding of a variant without a payload");
              } else {
                let view = IrVal { k: IRK_PLACE, r0: e.r0, r1: wrap_add(e.r1, 1), t: base_t(m, ft) };
                let mut r = ir_own(&mut f, ir_rv(&mut f, c, m, p, view));
                let sc = node_at(p.nodes, n.a);
                let mut st = 0;
                if r.k == IRK_PLACE && ir_ms(c, m, p, r.t) > 0 && ir_use_after_assign(p, arm.c, sc.s, sc.e, b.s, b.e, &mut st) {
                  // Still where the scrutinee is: an arm may assign to the
                  // scrutinee, so the payload gets a slot of its own.
                  r = ir_own_place(&mut f, c, m, p, r);
                }
                ir_bind(&mut f, b.s, b.e, r);
              }
            } else {
              let view = ir_payload(&mut f, c, m, p, e, v);
              if !f.failed {
                let r = ir_like(&mut f, view);
                ir_copy(&mut f, r, view);
                ir_bind(&mut f, b.s, b.e, r);
              }
            }
          }
        }
      }
      ir_block(&mut f, c, &mut m, p, arm.c);
      ir_truncate(&mut f, saved);
      ir_jump(&mut f, l_end);
      ir_place(&mut f, l_next);
      a = arm.next;
    }
    ir_place(&mut f, l_end);
  } else if k == S_EXPR {
    let e = node_at(p.nodes, n.a);
    if e.kind == E_CALL {
      ir_call(&mut f, c, &mut m, p, n.a);
    } else if e.kind == E_TAPP {
      // `f[T](..)` as a statement: the result, if any, is dropped.
      ir_expr(&mut f, c, &mut m, p, n.a);
    } else {
      ir_fail(&mut f, "an expression statement that is not a call");
    }
  } else if k == S_ASSERT {
    // Ghost code is erased before lowering, as before C generation.
  } else {
    ir_fail(&mut f, "a statement outside the first subset");
  }
}

/// Drops the code no jump reaches: what follows a `ret`, `jmp`, `br` or
/// `unreachable` up to the next label something jumps to, and the labels
/// nothing jumps to.
fn ir_trim(f: &mut IrFn) {
  let mut used = vec_new[u64]();
  let mut k = 0;
  while k < vec_len(f.ins) {
    let q = vec_get(f.ins, k);
    if q.op == IR_JMP {
      vec_push(&mut used, q.a);
    } else if q.op == IR_BR {
      vec_push(&mut used, q.b);
      vec_push(&mut used, q.c);
    }
    k = k + 1;
  }
  let mut out = vec_new[IrIns]();
  let mut live = true;
  k = 0;
  while k < vec_len(f.ins) {
    let q = vec_get(f.ins, k);
    k = k + 1;
    if q.op == IR_LABEL {
      if has_id(used, q.a) {
        vec_push(&mut out, q);
        live = true;
      }
    } else if live {
      vec_push(&mut out, q);
      if q.op == IR_RET || q.op == IR_JMP || q.op == IR_BR || q.op == IR_UNREACH {
        live = false;
      }
    }
  }
  vec_free(used);
  vec_free(f.ins);
  f.ins = out;
}

/// Lowers function instance `x`: parameters, then the body, and a `return`
/// at the end for a body that falls off it. `f.failed` says whether the
/// function is outside the subset.
fn ir_lower(c: &Checker, m: &mut Mono, p: &Parser, x: u64) -> IrFn {
  let mut f = ir_new(x);
  let xi = inst_at(m, x);
  let dn = node_at(p.nodes, xi.def);
  let mut q = dn.a;
  while q != 0 && !f.failed {
    let qn = node_at(p.nodes, q);
    let pt = conv(&mut m, p, qn.a, x, q);
    let pk = ir_kind(c, m, p, pt);
    let pu = base_t(m, pt);
    let aggr = kind_t(m, pu) == TY_STRUCT || kind_t(m, pu) == TY_ENUM || kind_t(m, pu) == TY_CHILD;
    let pmw = ir_mw(c, m, p, pu, 0);
    if aggr && pmw != IR_NONE && pmw > 0 && (kind_t(m, pt) == TY_MUTREF || (kind_t(m, pt) == TY_REF && pmw >= 4)) {
      // Lent by address: the value stays where the caller has it.
      let r = ir_reg(&mut f);
      vec_push(&mut f.params, r);
      ir_bind(&mut f, qn.s, qn.e, IrVal { k: IRK_PLACE, r0: r, r1: 0, t: pu });
    } else if pk == 0 && aggr && pmw != IR_NONE && pmw > 0 && pmw <= 8192 {
      // Arrives as words, of a type the IR cannot hold in registers: put
      // them in a slot of ours.
      let w0 = ir_reg(&mut f);
      vec_push(&mut f.params, w0);
      let mut j = 1;
      while j < pmw {
        let wj = ir_reg(&mut f);
        vec_push(&mut f.params, wj);
        j = j + 1;
      }
      let slot = ir_reg(&mut f);
      ir_emit(&mut f, IR_SLOT, slot, 0, 0, pmw, 0);
      ir_store_words(&mut f, slot, 0, w0, pmw);
      ir_bind(&mut f, qn.s, qn.e, IrVal { k: IRK_PLACE, r0: slot, r1: 0, t: pu });
    } else if pk == 0 {
      let first = !f.failed;
      ir_fail(&mut f, "a parameter that is not an integer, bool, buffer, struct, enum or Vec: ");
      if first {
        tyn_to(&mut f.why, m, p, pt);
      }
    } else if kind_t(m, pt) == TY_MUTREF && (pk == IRK_BUF || pk == IRK_BYTES) {
      // Lent by the address of its two words (length, then data).
      let a = ir_reg(&mut f);
      vec_push(&mut f.params, a);
      let data = ir_hdr_load(&mut f, a, 1);
      let len = ir_hdr_load(&mut f, a, 0);
      ir_bind(&mut f, qn.s, qn.e, IrVal { k: pk, r0: data, r1: len, t: 0 });
      vec_push(&mut f.lent, a);
      vec_push(&mut f.lent, data);
      vec_push(&mut f.lent, len);
    } else if kind_t(m, pt) == TY_MUTREF && (pk == IRK_INT || pk == IRK_BOX) {
      // A scalar or Box lent by address: its word is ours until the function
      // returns.
      let a = ir_reg(&mut f);
      vec_push(&mut f.params, a);
      let w = ir_new_val(&mut f, pk, 1, base_t(m, pt));
      ir_load_words(&mut f, a, 0, w.r0, 1);
      ir_bind(&mut f, qn.s, qn.e, w);
      vec_push(&mut f.lent, a);
      vec_push(&mut f.lent, w.r0);
      vec_push(&mut f.lent, wrap_add(IR_LENT_WORDS, 1));
    } else if kind_t(m, pt) == TY_MUTREF && pk != IRK_VEC {
      ir_fail(&mut f, "a `&mut` parameter that is not a Vec, a Buf or a Bytes");
    } else {
      let mut r = ir_new_val(&mut f, pk, ir_words(c, m, p, pt, 0), base_t(m, pt));
      if pk == IRK_VEC {
        r.t = ir_vt(inner_t(m, pu), 0);
      }
      if pk == IRK_VEC && kind_t(m, pt) != TY_MUTREF {
        // Passed as three words: put them in a slot of ours.
        let w0 = r.r0;
        let w1 = ir_reg(&mut f);
        let w2 = ir_reg(&mut f);
        vec_push(&mut f.params, w0);
        vec_push(&mut f.params, w1);
        vec_push(&mut f.params, w2);
        let slot = ir_reg(&mut f);
        ir_emit(&mut f, IR_SLOT, slot, 0, 0, 3, 0);
        ir_hdr_store(&mut f, slot, 0, w0);
        ir_hdr_store(&mut f, slot, 1, w1);
        ir_hdr_store(&mut f, slot, 2, w2);
        r = IrVal { k: IRK_VEC, r0: slot, r1: IR_NONE, t: ir_vt(inner_t(m, pu), 0) };
      } else if ir_multi(pk) {
        let mut w = 0;
        while w < r.r1 && w < 512 {
          vec_push(&mut f.params, wrap_add(r.r0, w));
          w = w + 1;
        }
      } else {
        vec_push(&mut f.params, r.r0);
        if r.r1 != IR_NONE {
          vec_push(&mut f.params, r.r1);
        }
      }
      ir_bind(&mut f, qn.s, qn.e, r);
    }
    q = qn.next;
  }
  let rt = cg_ret_ty(&mut m, p, x);
  if !f.failed && ir_kind(c, m, p, rt) == 0 && ir_ms(c, m, p, rt) == 0 && kind_t(m, rt) != TY_UNIT {
    ir_fail(&mut f, "a result that is not an integer, bool, buffer, struct or enum");
  }
  let le = ir_le_store_size(p, xi.def);
  if !f.failed && le != 0 {
    // A little-endian store of 2, 4 or 8 bytes: one store (see above).
    let q1 = node_at(p.nodes, dn.a);
    let q2 = node_at(p.nodes, q1.next);
    let q3 = node_at(p.nodes, q2.next);
    let bv = ir_find(f, p, q1.s, q1.e);
    let av = ir_find(f, p, q2.s, q2.e);
    let vv = ir_find(f, p, q3.s, q3.e);
    let da = ir_reg(&mut f);
    ir_emit(&mut f, IR_ADD, da, bv.r0, av.r0, 0, c.tu64);
    let z = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, z, 0, 0, 0, 0);
    ir_emit(&mut f, IR_STORE, vv.r0, da, z, le, 0);
    ir_emit(&mut f, IR_RET, IR_NONE, IR_NONE, IR_NONE, 0, 0);
    ir_trim(&mut f);
  } else if !f.failed && ir_le_load_size(p, xi.def) != 0 {
    // A little-endian load of 2, 4 or 8 bytes: one load.
    let lw = ir_le_load_size(p, xi.def);
    let q1 = node_at(p.nodes, dn.a);
    let q2 = node_at(p.nodes, q1.next);
    let bv = ir_find(f, p, q1.s, q1.e);
    let av = ir_find(f, p, q2.s, q2.e);
    let da = ir_reg(&mut f);
    ir_emit(&mut f, IR_ADD, da, bv.r0, av.r0, 0, c.tu64);
    let z = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, z, 0, 0, 0, 0);
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_LOAD, d, da, z, lw, 0);
    ir_emit(&mut f, IR_RET, IR_NONE, d, IR_NONE, 0, 0);
    ir_trim(&mut f);
  } else if !f.failed {
    ir_block(&mut f, c, &mut m, p, dn.x);
    ir_give_back(&mut f);
    ir_emit(&mut f, IR_RET, IR_NONE, IR_NONE, IR_NONE, 0, 0);
    ir_trim(&mut f);
  }
  return f;
}

// ---- The text form ----

/// The symbols `IR_RT` and `IR_GLOBAL` name: the runtime's page routines
/// (kernel) and the pool's globals.

fn ir_sym(i: u64) -> Str {
  if i == IRS_PAGE_AT { return "bst_rt_page_at"; }
  if i == IRS_FRAME_ID { return "bst_rt_frame_id"; }
  if i == IRS_POOL_BASE { return "bst_rt_pool_base"; }
  if i == IRS_PORT_CELL { return "bst_rt_port_cell"; }
  if i == IRS_MMIO_CELL { return "bst_rt_mmio_cell"; }
  if i == IRS_PT_LEASES { return "bst_rt_pt_leases"; }
  if i == IRS_SHARED_REFS { return "bst_rt_shared_refs"; }
  if i == IRS_USER_TABLE { return "bst_rt_user_table"; }
  if i == IRS_KERNEL_TABLE { return "bst_rt_kernel_table"; }
  return "bst_kernel_pml4";
}

fn ir_op_name(op: u64) -> Str {
  if op == IR_CONST { return "const"; }
  if op == IR_MOV { return "mov"; }
  if op == IR_ADD { return "add"; }
  if op == IR_SUB { return "sub"; }
  if op == IR_MUL { return "mul"; }
  if op == IR_DIV { return "div"; }
  if op == IR_SDIV { return "sdiv"; }
  if op == IR_REM { return "rem"; }
  if op == IR_SREM { return "srem"; }
  if op == IR_AND { return "and"; }
  if op == IR_OR { return "or"; }
  if op == IR_XOR { return "xor"; }
  if op == IR_SHL { return "shl"; }
  if op == IR_SHR { return "shr"; }
  if op == IR_SAR { return "sar"; }
  if op == IR_NOT { return "not"; }
  if op == IR_NEG { return "neg"; }
  if op == IR_EQ { return "eq"; }
  if op == IR_NE { return "ne"; }
  if op == IR_LT { return "lt"; }
  if op == IR_LE { return "le"; }
  if op == IR_GT { return "gt"; }
  if op == IR_GE { return "ge"; }
  if op == IR_SLT { return "slt"; }
  if op == IR_SLE { return "sle"; }
  if op == IR_SGT { return "sgt"; }
  if op == IR_SGE { return "sge"; }
  return "?";
}

fn ir_w_reg(out: &mut Vec[u64], r: u64) {
  w_s(&mut out, "v");
  w_num(&mut out, r);
}

fn ir_w_label(out: &mut Vec[u64], l: u64) {
  w_s(&mut out, "L");
  w_num(&mut out, l);
}

/// The name of instance `x` as the source spells it, with its number when
/// it is generic.
fn ir_w_name(out: &mut Vec[u64], m: &Mono, p: &Parser, x: u64) {
  let xi = inst_at(m, x);
  let dn = node_at(p.nodes, xi.def);
  if dn.s <= dn.e && dn.e <= blen(p.src) {
    let mut k = dn.s;
    while k < dn.e
      invariant dn.e <= blen(p.src)
    {
      vec_push(&mut out, cast[u64](bget(p.src, k)));
      k = k + 1;
    }
  }
}

/// The text of a lowered function:
///   fn name(v0, v1) {
///     v2 = add v0, v1
///   L0:
///     br v2, L1, L2
///     ret v2
///   }
fn ir_print(out: &mut Vec[u64], f: &IrFn, m: &Mono, p: &Parser) {
  w_s(&mut out, "fn ");
  ir_w_name(&mut out, m, p, f.x);
  w_s(&mut out, "(");
  let mut k = 0;
  while k < vec_len(f.params) {
    if k > 0 {
      w_s(&mut out, ", ");
    }
    ir_w_reg(&mut out, vec_get(f.params, k));
    k = k + 1;
  }
  w_s(&mut out, ") {\n");
  k = 0;
  while k < vec_len(f.ins) {
    let q = vec_get(f.ins, k);
    k = k + 1;
    if q.op != IR_LABEL {
      w_s(&mut out, "  ");
    }
    if q.op == IR_LABEL {
      ir_w_label(&mut out, q.a);
      w_s(&mut out, ":");
    } else if q.op == IR_CONST {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = const ");
      w_num(&mut out, q.a);
    } else if q.op == IR_MOV || q.op == IR_NOT || q.op == IR_NEG {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = ");
      w_s(&mut out, ir_op_name(q.op));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_JMP {
      w_s(&mut out, "jmp ");
      ir_w_label(&mut out, q.a);
    } else if q.op == IR_BR {
      w_s(&mut out, "br ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      ir_w_label(&mut out, q.b);
      w_s(&mut out, ", ");
      ir_w_label(&mut out, q.c);
    } else if q.op == IR_RET && q.c > 0 && q.a == IR_NONE {
      w_s(&mut out, "ret regs");
      let mut j = 0;
      while j < q.c && j < 4096 {
        if j > 0 {
          w_s(&mut out, ",");
        }
        w_s(&mut out, " ");
        ir_w_reg(&mut out, u_at(f.args, wrap_add(q.b, j)));
        j = j + 1;
      }
    } else if q.op == IR_RET && q.c > 0 {
      w_s(&mut out, "ret mem ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      w_num(&mut out, q.c);
    } else if q.op == IR_RET {
      w_s(&mut out, "ret");
      if q.a != IR_NONE {
        w_s(&mut out, " ");
        ir_w_reg(&mut out, q.a);
      }
      if q.b != IR_NONE {
        w_s(&mut out, ", ");
        ir_w_reg(&mut out, q.b);
      }
    } else if q.op == IR_LOAD {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = load");
      w_num(&mut out, wrap_mul(q.c, 8));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, "[");
      ir_w_reg(&mut out, q.b);
      w_s(&mut out, "]");
    } else if q.op == IR_STORE {
      w_s(&mut out, "store");
      w_num(&mut out, wrap_mul(q.c, 8));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, "[");
      ir_w_reg(&mut out, q.b);
      w_s(&mut out, "], ");
      ir_w_reg(&mut out, q.d);
    } else if q.op == IR_ALLOC {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = alloc");
      if q.ty == 1 {
        w_s(&mut out, "?");
      } else if q.ty == 2 {
        w_s(&mut out, "~");
      }
      w_num(&mut out, wrap_mul(q.c, 8));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_STRLIT {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = str ");
      w_num(&mut out, q.a);
    } else if q.op == IR_SLOT {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = slot ");
      w_num(&mut out, q.c);
    } else if q.op == IR_VGROW {
      w_s(&mut out, "vgrow ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_FREE {
      w_s(&mut out, "free ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_PRINT {
      w_s(&mut out, "print ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_PUTC {
      w_s(&mut out, "putc ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_GETC {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = getc");
    } else if q.op == IR_RT {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = rt ");
      w_s(&mut out, ir_sym(q.c));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_GLOBAL {
      ir_w_reg(&mut out, q.d);
      if q.c == 1 {
        w_s(&mut out, " = addr ");
      } else {
        w_s(&mut out, " = global ");
      }
      w_s(&mut out, ir_sym(q.a));
    } else if q.op == IR_ZERO {
      w_s(&mut out, "zero ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_TSC {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = tsc");
    } else if q.op == IR_PCALL {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = pcall ");
      w_num(&mut out, q.c);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.b);
    } else if q.op == IR_LOCKINC {
      w_s(&mut out, "lockinc ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_LOCKDEC {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = lockdec ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_COPYPAGE {
      w_s(&mut out, "copypage ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.b);
    } else if q.op == IR_FILL {
      w_s(&mut out, "fill ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.b);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.c);
    } else if q.op == IR_COPY {
      w_s(&mut out, "copy ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.b);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.c);
    } else if q.op == IR_XCHG {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = xchg ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.b);
    } else if q.op == IR_CAS {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = cas ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.b);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.c);
    } else if q.op == IR_LOCKACQ {
      w_s(&mut out, "lockacq ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_FENCE {
      w_s(&mut out, "fence");
      if q.a == 1 {
        w_s(&mut out, " dma");
      }
    } else if q.op == IR_DEVR || q.op == IR_PIN {
      ir_w_reg(&mut out, q.d);
      if q.op == IR_DEVR {
        w_s(&mut out, " = devr");
      } else {
        w_s(&mut out, " = in");
      }
      w_num(&mut out, wrap_mul(8, q.c));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_MMCHK {
      w_s(&mut out, "mmchk ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.b);
    } else if q.op == IR_DEVW || q.op == IR_POUT {
      if q.op == IR_DEVW {
        w_s(&mut out, "devw");
      } else {
        w_s(&mut out, "out");
      }
      w_num(&mut out, wrap_mul(8, q.c));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.b);
    } else if q.op == IR_WRAP {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = wrap ");
      ir_w_reg(&mut out, q.a);
    } else if q.op == IR_UNREACH {
      w_s(&mut out, "unreachable");
    } else if q.op == IR_CALL || q.op == IR_CALLM {
      if q.op == IR_CALLM {
        ir_w_reg(&mut out, q.d);
        w_s(&mut out, " = ");
      } else if q.d != IR_NONE {
        ir_w_reg(&mut out, q.d);
        if q.ty != IR_NONE && q.ty != 0 {
          w_s(&mut out, ", ");
          ir_w_reg(&mut out, q.ty);
        }
        w_s(&mut out, " = ");
      }
      if q.op == IR_CALLM {
        w_s(&mut out, "callm ");
      } else {
        w_s(&mut out, "call ");
      }
      ir_w_name(&mut out, m, p, q.a);
      w_s(&mut out, "(");
      let mut j = 0;
      while j < q.c {
        if j > 0 {
          w_s(&mut out, ", ");
        }
        ir_w_reg(&mut out, u_at(f.args, wrap_add(q.b, j)));
        j = j + 1;
      }
      w_s(&mut out, ")");
    } else {
      ir_w_reg(&mut out, q.d);
      w_s(&mut out, " = ");
      if q.c == 1 {
        w_s(&mut out, "w");
      }
      w_s(&mut out, ir_op_name(q.op));
      w_s(&mut out, " ");
      ir_w_reg(&mut out, q.a);
      w_s(&mut out, ", ");
      ir_w_reg(&mut out, q.b);
    }
    w_s(&mut out, "\n");
  }
  w_s(&mut out, "}\n");
}
