// The IR between the checker and the native backend (docs/ir.md): one
// function at a time, three-address code on virtual registers, with labels
// and jumps. This file is the first step of #125: the data, the lowering
// of the first subset (functions of integer and bool values: locals,
// arithmetic, comparisons, `if`, `while`, `return`, calls of such
// functions) and a text form for it (`irdump`). Nothing generates code from
// it yet; `x86.bastio` is unchanged.
//
// A function outside the subset is not an error: `ir_lower` reports it
// with the first thing it met that it does not handle yet, and the caller
// keeps using the old generator for it (docs/ir.md, "Getting there without
// a flag day").
//
// Values are 64-bit virtual registers; an operation that can wrap or
// depends on the width or sign of its operands carries the type in `ty`
// (as the checker recorded it for the operator node). Plain `+`, `-` and
// `*` are proved not to overflow, so they have no width.
import "codegen.bastio";
import "render.bastio";

// Operations. `d` is the register written, `a`, `b`, `c` the operands.
const IR_CONST: u64 = 1;     // d = a (an immediate)
const IR_MOV: u64 = 2;       // d = a
const IR_ADD: u64 = 3;      // (ADD, SUB and MUL with c = 1 wrap: the result is truncated to the integer type ty)
const IR_SUB: u64 = 4;
const IR_MUL: u64 = 5;
const IR_DIV: u64 = 6;       // unsigned
const IR_SDIV: u64 = 7;
const IR_REM: u64 = 8;
const IR_SREM: u64 = 9;
const IR_AND: u64 = 10;
const IR_OR: u64 = 11;
const IR_XOR: u64 = 12;
const IR_SHL: u64 = 13;
const IR_SHR: u64 = 14;      // logical
const IR_SAR: u64 = 15;      // arithmetic
const IR_NOT: u64 = 16;      // d = !a: the bits of a within the width of `ty`, or a bool
const IR_NEG: u64 = 17;
const IR_EQ: u64 = 20;
const IR_NE: u64 = 21;
const IR_LT: u64 = 22;       // unsigned
const IR_LE: u64 = 23;
const IR_GT: u64 = 24;
const IR_GE: u64 = 25;
const IR_SLT: u64 = 26;      // signed
const IR_SLE: u64 = 27;
const IR_SGT: u64 = 28;
const IR_SGE: u64 = 29;
const IR_LABEL: u64 = 40;    // label a starts here
const IR_JMP: u64 = 41;      // goto label a
const IR_BR: u64 = 42;       // if a goto label b else label c
const IR_RET: u64 = 43;      // return a, and b if a buffer (IR_NONE: nothing); with c > 0, a result of more than two words: the c words at address a, or, with a = IR_NONE, the c registers of args[b ..]
const IR_CALL: u64 = 44;     // d (and ty if a buffer) = instance a called with the c registers of args[b ..] (d = IR_NONE: no result)
const IR_UNREACH: u64 = 45;
const IR_LOAD: u64 = 46;     // d = the c-byte element a[b] (c is 1 or 8; a the data address, b the index)
const IR_STORE: u64 = 47;    // a[b] = d, c bytes (d is read here, not written); c is 1 or 8, or 2 or 4 with b = 0 (the byte address a)
const IR_ALLOC: u64 = 48;    // d = a new buffer's data address, n = a elements of c bytes (1 or 8); the length register is set by a separate mov
const IR_FREE: u64 = 49;     // frees the buffer whose data address is a
const IR_PRINT: u64 = 50;    // prints the number a
const IR_PUTC: u64 = 56;     // writes the byte a to the console (`serial_write`): a runtime call
const IR_RT: u64 = 58;       // d = the runtime routine ir_sym(c) applied to a (argument and result in %rax; no other register changes)
const IR_GLOBAL: u64 = 59;   // d = the value of the global symbol ir_sym(a), or with c = 1 its address
const IR_ZERO: u64 = 60;     // zeroes the 4096 bytes at address a
const IR_GETC: u64 = 57;     // d = the next byte from the console (`serial_read`): a runtime call
const IR_WRAP: u64 = 51;     // d = a truncated to the integer type ty

const IR_SLOT: u64 = 52;     // d = the address of a frame slot of c words (one per instruction, allocated once per function however often it runs)
const IR_STRLIT: u64 = 55;   // d = the address of the bytes of the string literal or blob at syntax node a
const IR_CALLM: u64 = 54;    // d = the address of a frame slot of ty words that instance a, called with the c registers of args[b ..], fills with its result (a result of more than two words)
const IR_VGROW: u64 = 53;    // makes room in the Vec whose 3-word header is at address a (c = words per element): a runtime call that may change the header

const IRS_PAGE_AT: u64 = 0;
const IRS_FRAME_ID: u64 = 1;
const IRS_POOL_BASE: u64 = 2;
const IRS_KERNEL_PML4: u64 = 3;
const IRS_PORT_CELL: u64 = 4;
const IRS_MMIO_CELL: u64 = 5;
const IRS_PT_LEASES: u64 = 6;
const IRS_SHARED_REFS: u64 = 7;
const IRS_USER_TABLE: u64 = 8;
const IRS_KERNEL_TABLE: u64 = 9;

const IR_DEVR: u64 = 61;     // d = the c-byte (1, 2, 4 or 8) value at address a, zero-extended: a volatile load, never dropped or reordered
const IR_DEVW: u64 = 62;     // the low c bytes of b are stored at address a: a volatile store
const IR_PIN: u64 = 63;      // d = the c-byte value read from I/O port a (`in`)
const IR_FENCE: u64 = 65;    // a full memory fence (`dma_lend`, `dma_take`); with a = 1 the fence around a copy to or from a lent page, which only the AArch64 target emits (`dmb osh`; x86-64 DMA is coherent)
const IR_MMCHK: u64 = 66;    // stops the machine if the block at address a, b bytes, is RAM (`mmio_claim` in the kernel): a runtime call that keeps every register
const IR_TSC: u64 = 67;      // d = the processor's time-stamp counter (`cpu_tsc`)
const IR_PCALL: u64 = 68;    // d = a call of one runtime or platform function, which c names, on (a, b) (ty: a constant for the callee; for c 20 to 31, a hosted runtime routine called with the four words at address a; for c 10 and 11, a is a system call number and b the address of three argument words, for 12 a is a Buf's data address and b the address of two bounds): a call for the allocator
const IR_LOCKINC: u64 = 69;  // atomically adds one to the 32-bit count at address a
const IR_LOCKDEC: u64 = 70;  // atomically subtracts one from the 32-bit count at address a; d = 1 if it reached zero, else 0
const IR_COPYPAGE: u64 = 71; // copies the 4096 bytes at address b to address a
const IR_XCHG: u64 = 72;     // d = the 64-bit word at address a, which b replaces (atomically)
const IR_CAS: u64 = 73;      // d = 1 if the 64-bit word at address a was b and is now the register c, else 0 (atomically)
const IR_FILL: u64 = 76;     // stores the low byte of b in the c bytes from address a (a `while` that sets each byte of a range to one value)
const IR_COPY: u64 = 75;     // copies c bytes from address b to address a, lowest address first (`bcopy` and the frame and DMA copies)
const IR_LOCKACQ: u64 = 74;  // spins until it takes the lock word at address a (0 free, 1 held)
const IR_POUT: u64 = 64;     // the low c bytes of b are written to I/O port a (`out`)

const IR_NONE: u64 = 18446744073709551615;

/// In a `lent` entry, the third word at least this is a struct or enum of
/// that many words less this, held in registers.
const IR_LENT_WORDS: u64 = 1099511627776;

struct IrIns { op: u64, d: u64, a: u64, b: u64, c: u64, ty: u64 }

/// A variable in scope: its name in the source and its register.
struct IrVar { s: u64, e: u64, k: u64, r0: u64, r1: u64, t: u64 }

/// One function being lowered, and then lowered.
struct IrFn {
  /// The function instance.
  x: u64,
  /// Registers of the parameters, in order.
  params: Vec[u64],
  ins: Vec[IrIns],
  /// The argument registers of the calls.
  args: Vec[u64],
  nreg: u64,
  nlabel: u64,
  vars: Vec[IrVar],
  /// What stopped the lowering: set at the first thing not handled.
  failed: bool,
  why: Vec[u64],
  /// The `&mut Buf` / `&mut Bytes` parameters: per parameter its address, data and length registers.
  lent: Vec[u64],
  /// The line of the statement being lowered, and where the lowering failed.
  cur: u64,
  at: u64
}

fn ir_new(x: u64) -> IrFn {
  return IrFn { x: x, params: vec_new[u64](), ins: vec_new[IrIns](), args: vec_new[u64](), nreg: 0, nlabel: 0,
    vars: vec_new[IrVar](), failed: false, why: vec_new[u64](), lent: vec_new[u64](), cur: 0, at: 0 };
}

fn ir_free(f: IrFn) {
  vec_free(f.params);
  vec_free(f.ins);
  vec_free(f.args);
  vec_free(f.vars);
  vec_free(f.why);
  vec_free(f.lent);
}

fn ir_fail(f: &mut IrFn, why: Str) {
  if !f.failed {
    f.failed = true;
    f.at = f.cur;
    w_s(&mut f.why, why);
  }
}

fn ir_reg(f: &mut IrFn) -> u64 {
  let r = f.nreg;
  f.nreg = wrap_add(f.nreg, 1);
  return r;
}

fn ir_label(f: &mut IrFn) -> u64 {
  let l = f.nlabel;
  f.nlabel = wrap_add(f.nlabel, 1);
  return l;
}

fn ir_emit(f: &mut IrFn, op: u64, d: u64, a: u64, b: u64, c: u64, ty: u64) {
  vec_push(&mut f.ins, IrIns { op: op, d: d, a: a, b: b, c: c, ty: ty });
}

fn ir_place(f: &mut IrFn, l: u64) {
  ir_emit(&mut f, IR_LABEL, IR_NONE, l, 0, 0, 0);
}

fn ir_jump(f: &mut IrFn, l: u64) {
  ir_emit(&mut f, IR_JMP, IR_NONE, l, 0, 0, 0);
}

// ---- Lowering ----

// What a variable or value holds. A Buf or Bytes is two registers: the
// address of its data, then its length (the elements of a Buf are 8 bytes,
// those of Bytes one byte). A borrowed `&Buf` is the same two registers: the
// buffer cannot change under a shared borrow.
const IRK_INT: u64 = 1;
const IRK_BUF: u64 = 2;
const IRK_BYTES: u64 = 3;
// A `Str`: like a Bytes (data address, length), read-only.
const IRK_STR: u64 = 8;
// A `Box[T]`: one register, the address of the allocation (`t` is the Box type).
const IRK_BOX: u64 = 9;
const IRK_STRUCT: u64 = 4;
// An enum: its tag in `r0`, then the words of the largest payload, in
// consecutive registers like a struct (`r1` the count, `t` the type).
const IRK_ENUM: u64 = 6;
// A Vec: `r0` is the address of its three-word header (length, capacity,
// data address), in a frame slot or in the caller's, never in registers.
const IRK_VEC: u64 = 5;
// A struct or enum that stays in memory (a `&mut` parameter, a large `&`
// one, a field of such): `r0` is the register that holds the address of the
// value it is part of, `r1` the word offset from there (a constant), `t` its
// type. Fields are places too; reading a scalar, buffer or Vec field loads
// it, and writing one stores to it.
const IRK_PLACE: u64 = 7;

/// Is `k` a value held in several consecutive registers (a struct or an enum)?
fn ir_multi(k: u64) -> bool {
  return k == IRK_STRUCT || k == IRK_ENUM;
}

/// The registers a value of type `t` takes in the subset, or IR_NONE when
/// it is outside it: one for an integer or bool, two for a `Buf` or `Bytes`,
/// and for a struct the words of its fields in order (a struct is split
/// into registers, never held in memory). `depth` bounds the nesting.
fn ir_words(c: &Checker, m: &Mono, p: &Parser, t: u64, depth: u64) -> u64 {
  let u = base_t(m, t);
  let k = kind_t(m, u);
  if is_int(m, u) || k == TY_BOOL || ir_is_handle(k) {
    return 1;
  }
  if k == TY_BUF || k == TY_BYTES || k == TY_STR || k == TY_POOL || k == TY_PORTIO || k == TY_MMIO {
    return 2;
  }
  if k == TY_CHILD {
    // The pid, the input and the output of a child process, held like a
    // struct of three words.
    return 3;
  }
  if k == TY_BOX && ir_mw(c, m, p, inner_t(m, u), 0) != IR_NONE {
    return 1;
  }
  if k == TY_STRUCT && depth < 4 {
    let x = inner_t(m, u);
    let dn = def_node(m, p, x);
    let nf = list_len(p, dn.a);
    let mut s = 0;
    let mut j = 0;
    while j < nf && j < SRC_MAX {
      let w = ir_words(c, m, p, fld_ty(c, x, j), depth + 1);
      if w == IR_NONE {
        return IR_NONE;
      }
      s = wrap_add(s, w);
      j = j + 1;
    }
    if s == 0 || s > 64 {
      return IR_NONE;
    }
    return s;
  }
  if k == TY_ENUM && depth < 4 {
    let x = inner_t(m, u);
    let dn = def_node(m, p, x);
    let nf = list_len(p, dn.a);
    let mut best = 0;
    let mut j = 0;
    while j < nf && j < SRC_MAX {
      let ft = fld_ty(c, x, j);
      if ft != 0 {
        let w = ir_words(c, m, p, ft, depth + 1);
        if w == IR_NONE {
          return IR_NONE;
        }
        if w > best {
          best = w;
        }
      }
      j = j + 1;
    }
    if best > 63 {
      return IR_NONE;
    }
    return wrap_add(best, 1);
  }
  return IR_NONE;
}

/// The words a value of type `t` takes in memory, as `x86_words` counts them
/// (the layout the old generator and the IR share), or IR_NONE for a type the
/// IR does not know. `depth` bounds the nesting.
fn ir_mw(c: &Checker, m: &Mono, p: &Parser, t: u64, depth: u64) -> u64 {
  let u = base_t(m, t);
  let k = kind_t(m, u);
  if k == TY_UNIT {
    return 0;
  }
  if is_int(m, u) || k == TY_BOOL || k == TY_SERIAL || k == TY_HOST || k == TY_FRAME || k == TY_PT || k == TY_BOX || k == TY_MUTREF {
    return 1;
  }
  if k == TY_BUF || k == TY_BYTES || k == TY_STR || k == TY_POOL || k == TY_PORTIO || k == TY_MMIO {
    return 2;
  }
  if k == TY_LOCK || k == TY_ATOMIC || k == TY_PORTS || k == TY_MMIOSPACE || k == TY_DMA || k == TY_MMU || k == TY_CPU || k == TY_LEASE || k == TY_SHARED || k == TY_DIRTY {
    return 1;
  }
  if k == TY_PORTIO || k == TY_MMIO {
    return 2;
  }
  if k == TY_VEC || k == TY_CHILD {
    return 3;
  }
  if (k == TY_STRUCT || k == TY_ENUM) && depth < 8 {
    let x = inner_t(m, u);
    let dn = def_node(m, p, x);
    let nf = list_len(p, dn.a);
    let mut s = 0;
    let mut j = 0;
    while j < nf && j < SRC_MAX {
      let ft = fld_ty(c, x, j);
      if k == TY_STRUCT {
        let w = ir_mw(c, m, p, ft, depth + 1);
        if w == IR_NONE {
          return IR_NONE;
        }
        s = wrap_add(s, w);
      } else if ft != 0 {
        let w = ir_mw(c, m, p, ft, depth + 1);
        if w == IR_NONE {
          return IR_NONE;
        }
        if w > s {
          s = w;
        }
      }
      j = j + 1;
    }
    if k == TY_ENUM {
      return wrap_add(s, 1);
    }
    return s;
  }
  return IR_NONE;
}

/// The word type of the atomic that argument `a` names, when `a` is a
/// parameter of the function being lowered (0 otherwise, or when it is not
/// an integer or bool).
fn ir_atomic_ty(f: &IrFn, c: &Checker, m: &mut Mono, p: &Parser, a: u64) -> u64 {
  let an = node_at(p.nodes, a);
  if an.kind != E_VAR {
    return 0;
  }
  let xd = inst_at(m, f.x);
  let dn = node_at(p.nodes, xd.def);
  let mut q = dn.a;
  while q != 0 {
    let qn = node_at(p.nodes, q);
    if same(p.src, qn.s, qn.e, an.s, an.e) {
      let pt = base_t(m, conv(&mut m, p, qn.a, f.x, q));
      if kind_t(m, pt) != TY_ATOMIC {
        return 0;
      }
      let t = base_t(m, inner_t(m, pt));
      if is_int(m, t) || kind_t(m, t) == TY_BOOL || ir_word_struct(c, m, p, t) {
        return t;
      }
      return 0;
    }
    q = qn.next;
  }
  return 0;
}

/// Is `t` a struct the IR keeps in one register (an atomic can hold it)?
fn ir_word_struct(c: &Checker, m: &Mono, p: &Parser, t: u64) -> bool {
  let u = base_t(m, t);
  return kind_t(m, u) == TY_STRUCT && ir_kind(c, m, p, u) == IRK_STRUCT && ir_words(c, m, p, u, 0) == 1;
}

/// The one word that argument `a` of an atomic operation is: an integer, or
/// the register of a one-word struct (`sw`).
fn ir_atomic_arg(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, a: u64, sw: bool) -> u64 {
  if !sw {
    return ir_int(&mut f, c, &mut m, p, a);
  }
  let v = ir_vexpr(&mut f, c, &mut m, p, a);
  if f.failed {
    return IR_NONE;
  }
  if v.k != IRK_STRUCT {
    ir_fail(&mut f, "an atomic operand of another kind");
    return IR_NONE;
  }
  return v.r0;
}

/// The index of the page at address register `fr`: the runtime's lookup in
/// the kernel, the offset into the pool when hosted.
fn ir_page_id(f: &mut IrFn, c: &Checker, fr: u64) -> u64 {
  let d = ir_reg(&mut f);
  if c.target == TARGET_KERNEL {
    ir_emit(&mut f, IR_RT, d, fr, 0, IRS_FRAME_ID, 0);
  } else {
    let base = ir_reg(&mut f);
    ir_emit(&mut f, IR_GLOBAL, base, IRS_POOL_BASE, 0, 0, 0);
    let off = ir_reg(&mut f);
    ir_emit(&mut f, IR_SUB, off, fr, base, 0, 0);
    let sh = ir_k(&mut f, 12);
    ir_emit(&mut f, IR_SHR, d, off, sh, 0, 0);
  }
  return d;
}

/// The address of the 32-bit count of the page at address register `pg` in
/// the runtime's array `sym` (a pointer in the kernel, the array itself when
/// hosted).
fn ir_count_addr(f: &mut IrFn, c: &Checker, sym: u64, pg: u64) -> u64 {
  let id = ir_page_id(&mut f, c, pg);
  let arr = ir_reg(&mut f);
  if c.target == TARGET_KERNEL {
    ir_emit(&mut f, IR_GLOBAL, arr, sym, 0, 0, 0);
  } else {
    ir_emit(&mut f, IR_GLOBAL, arr, sym, 0, 1, 0);
  }
  let two = ir_k(&mut f, 2);
  let sc = ir_reg(&mut f);
  ir_emit(&mut f, IR_SHL, sc, id, two, 0, 0);
  let at = ir_reg(&mut f);
  ir_emit(&mut f, IR_ADD, at, arr, sc, 0, 0);
  return at;
}

/// The width in bytes of the device access that call `i` names (`pio_in8`,
/// `mmio_write32`, `dma_read64`, ..), or 0.
fn ir_dev_width(p: &Parser, i: u64) -> u64 {
  if name_is(p, i, "pio_in8") || name_is(p, i, "pio_out8") || name_is(p, i, "mmio_read8") || name_is(p, i, "mmio_write8")
    || name_is(p, i, "dma_read8") || name_is(p, i, "dma_write8") {
    return 1;
  }
  if name_is(p, i, "pio_in16") || name_is(p, i, "pio_out16") || name_is(p, i, "mmio_read16") || name_is(p, i, "mmio_write16")
    || name_is(p, i, "dma_read16") || name_is(p, i, "dma_write16") {
    return 2;
  }
  if name_is(p, i, "pio_in32") || name_is(p, i, "pio_out32") || name_is(p, i, "mmio_read32") || name_is(p, i, "mmio_write32")
    || name_is(p, i, "dma_read32") || name_is(p, i, "dma_write32") {
    return 4;
  }
  if name_is(p, i, "mmio_read64") || name_is(p, i, "mmio_write64") || name_is(p, i, "dma_read64") || name_is(p, i, "dma_write64") {
    return 8;
  }
  return 0;
}

/// Does device access `i` write? (Otherwise it reads.)
fn ir_dev_writes(p: &Parser, i: u64) -> bool {
  return name_is(p, i, "pio_out8") || name_is(p, i, "pio_out16") || name_is(p, i, "pio_out32")
    || name_is(p, i, "mmio_write8") || name_is(p, i, "mmio_write16") || name_is(p, i, "mmio_write32") || name_is(p, i, "mmio_write64")
    || name_is(p, i, "dma_write8") || name_is(p, i, "dma_write16") || name_is(p, i, "dma_write32") || name_is(p, i, "dma_write64");
}

/// 1 for a port access, 2 for MMIO, 3 for a DMA page.
fn ir_dev_kind(p: &Parser, i: u64) -> u64 {
  if name_is(p, i, "pio_in8") || name_is(p, i, "pio_in16") || name_is(p, i, "pio_in32")
    || name_is(p, i, "pio_out8") || name_is(p, i, "pio_out16") || name_is(p, i, "pio_out32") {
    return 1;
  }
  if name_is(p, i, "dma_read8") || name_is(p, i, "dma_read16") || name_is(p, i, "dma_read32") || name_is(p, i, "dma_read64")
    || name_is(p, i, "dma_write8") || name_is(p, i, "dma_write16") || name_is(p, i, "dma_write32") || name_is(p, i, "dma_write64") {
    return 3;
  }
  return 2;
}

/// Is a value of this kind of type one word that nothing but a builtin looks
/// into? The console, the zero-sized capabilities of the kernel (ports, MMIO
/// space, MMU, CPU) and the words that name a frame, a table, a DMA window or a
/// page are carried around like integers.
fn ir_is_handle(k: u64) -> bool {
  return k == TY_SERIAL || k == TY_HOST || k == TY_FRAME || k == TY_PT || k == TY_PORTS || k == TY_MMIOSPACE || k == TY_DMA || k == TY_MMU || k == TY_CPU || k == TY_LEASE || k == TY_SHARED || k == TY_DIRTY || k == TY_LOCK || k == TY_ATOMIC;
}

/// The kind of values of type `t` in the subset, or 0.
fn ir_kind(c: &Checker, m: &Mono, p: &Parser, t: u64) -> u64 {
  let u = base_t(m, t);
  if is_int(m, u) || kind_t(m, u) == TY_BOOL || ir_is_handle(kind_t(m, u)) {
    return IRK_INT;
  }
  if kind_t(m, u) == TY_BOX && ir_mw(c, m, p, inner_t(m, u), 0) != IR_NONE {
    return IRK_BOX;
  }
  if kind_t(m, u) == TY_BUF {
    return IRK_BUF;
  }
  if kind_t(m, u) == TY_BYTES || kind_t(m, u) == TY_POOL || kind_t(m, u) == TY_PORTIO || kind_t(m, u) == TY_MMIO {
    // A Pool is two words in memory, the base address and then the page
    // count; held like a Bytes (data = word 1 = the count, length = word 0
    // = the base), though only the pool builtins look into it.
    return IRK_BYTES;
  }
  if kind_t(m, u) == TY_STR {
    return IRK_STR;
  }
  if (kind_t(m, u) == TY_STRUCT || kind_t(m, u) == TY_CHILD) && ir_words(c, m, p, u, 0) != IR_NONE {
    return IRK_STRUCT;
  }
  if kind_t(m, u) == TY_ENUM && ir_words(c, m, p, u, 0) != IR_NONE {
    return IRK_ENUM;
  }
  if kind_t(m, u) == TY_VEC {
    let ew = ir_mw(c, m, p, inner_t(m, u), 0);
    if ew != IR_NONE && ew > 0 && ew < 64 {
      return IRK_VEC;
    }
  }
  return 0;
}

/// The words of a struct that the IR cannot hold in registers (a Vec or a
/// handle is in it) but keeps in memory, in a frame slot, or 0 for any other
/// type. At least three words: a smaller one travels in registers.
fn ir_ms(c: &Checker, m: &Mono, p: &Parser, t: u64) -> u64 {
  let u = base_t(m, t);
  if (kind_t(m, u) == TY_STRUCT || kind_t(m, u) == TY_ENUM) && ir_kind(c, m, p, u) == 0 {
    let w = ir_mw(c, m, p, u, 0);
    if w != IR_NONE && w >= 3 && w <= 8192 {
      return w;
    }
  }
  return 0;
}

/// A value: its register, and the second one of a Buf or Bytes (IR_NONE
/// for an integer); `k` is its kind (0 after a failure).
struct IrVal { k: u64, r0: u64, r1: u64, t: u64 }

fn ir_none() -> IrVal {
  return IrVal { k: 0, r0: IR_NONE, r1: IR_NONE, t: 0 };
}

fn ir_bind(f: &mut IrFn, s: u64, e: u64, v: IrVal) {
  vec_push(&mut f.vars, IrVar { s: s, e: e, k: v.k, r0: v.r0, r1: v.r1, t: v.t });
}

/// The variable named `s..e`, the innermost one (k == 0: none).
fn ir_find(f: &IrFn, p: &Parser, s: u64, e: u64) -> IrVal {
  let mut k = vec_len(f.vars);
  while k > 0
    invariant k <= vlen(f.vars)
  {
    k = k - 1;
    let v = vec_get(f.vars, k);
    if same(p.src, v.s, v.e, s, e) {
      return IrVal { k: v.k, r0: v.r0, r1: v.r1, t: v.t };
    }
  }
  return ir_none();
}

fn ir_truncate(f: &mut IrFn, n: u64) {
  while vec_len(f.vars) > n {
    vec_pop(&mut f.vars);
  }
}

/// The `t` of a Vec value: the element type, and whether the address is part
/// of a place (a Vec read out of a place is the place's own header).
fn ir_vt(et: u64, alias: u64) -> u64 {
  return wrap_add(wrap_mul(et, 2), alias);
}

/// The element type of Vec value `v`.
fn ir_velem(v: IrVal) -> u64 {
  return v.t / 2;
}

/// New registers for a value of kind `k`; a struct of `w` words and type
/// `t` takes `w` consecutive ones.
fn ir_new_val(f: &mut IrFn, k: u64, w: u64, t: u64) -> IrVal {
  let r0 = ir_reg(&mut f);
  if k == IRK_INT {
    return IrVal { k: k, r0: r0, r1: IR_NONE, t: 0 };
  }
  if k == IRK_BOX {
    return IrVal { k: k, r0: r0, r1: IR_NONE, t: t };
  }
  if k == IRK_VEC {
    // The element type stays; the alias mark does not.
    return IrVal { k: k, r0: r0, r1: IR_NONE, t: wrap_mul(t / 2, 2) };
  }
  if ir_multi(k) {
    let mut j = 1;
    while j < w && j < 8192 {
      ir_reg(&mut f);
      j = j + 1;
    }
    return IrVal { k: k, r0: r0, r1: w, t: t };
  }
  let r1 = ir_reg(&mut f);
  return IrVal { k: k, r0: r0, r1: r1, t: 0 };
}

fn ir_fresh(f: &mut IrFn, k: u64) -> IrVal {
  return ir_new_val(&mut f, k, 0, 0);
}

/// New registers for a value like `v`.
fn ir_like(f: &mut IrFn, v: IrVal) -> IrVal {
  return ir_new_val(&mut f, v.k, v.r1, v.t);
}

/// dst = src, word by word.
fn ir_copy(f: &mut IrFn, dst: IrVal, src: IrVal) {
  if ir_multi(dst.k) {
    let mut j = 0;
    while j < dst.r1 && j < 64 {
      ir_emit(&mut f, IR_MOV, wrap_add(dst.r0, j), wrap_add(src.r0, j), 0, 0, 0);
      j = j + 1;
    }
    return;
  }
  ir_emit(&mut f, IR_MOV, dst.r0, src.r0, 0, 0, 0);
  if dst.r1 != IR_NONE {
    ir_emit(&mut f, IR_MOV, dst.r1, src.r1, 0, 0, 0);
  }
}

/// The payload of variant number `v` of enum value `e`: the registers after
/// the tag, seen as a value of the payload's type.
fn ir_payload(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, e: IrVal, v: u64) -> IrVal {
  let ft = fld_ty(c, inner_t(m, e.t), v);
  let fk = ir_kind(c, m, p, ft);
  let r = wrap_add(e.r0, 1);
  if fk == IRK_INT {
    return IrVal { k: fk, r0: r, r1: IR_NONE, t: 0 };
  }
  if fk == IRK_BOX {
    return IrVal { k: fk, r0: r, r1: IR_NONE, t: base_t(m, ft) };
  }
  if fk == IRK_BUF || fk == IRK_BYTES || fk == IRK_STR {
    return IrVal { k: fk, r0: wrap_add(r, 1), r1: r, t: 0 };
  }
  if ir_multi(fk) {
    return IrVal { k: fk, r0: r, r1: ir_words(c, m, p, ft, 1), t: ft };
  }
  ir_fail(&mut f, "a payload outside the subset");
  return ir_none();
}

/// Field `s..e` of struct value `v`: the registers it occupies.
fn ir_field(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, v: IrVal, s: u64, e: u64) -> IrVal {
  if v.k == IRK_PLACE {
    return ir_pfield(&mut f, c, m, p, v, s, e);
  }
  if v.k == IRK_BOX {
    // A field through a Box is a field of the struct it points to.
    let place = IrVal { k: IRK_PLACE, r0: v.r0, r1: 0, t: base_t(m, inner_t(m, v.t)) };
    return ir_pfield(&mut f, c, m, p, place, s, e);
  }
  if v.k != IRK_STRUCT {
    ir_fail(&mut f, "a field of something that is not a struct");
    return ir_none();
  }
  let x = inner_t(m, v.t);
  let dn = def_node(m, p, x);
  let j = index_in(p, dn.a, s, e);
  if j == 0 {
    ir_fail(&mut f, "a field that is not there");
    return ir_none();
  }
  let mut off = 0;
  let mut q = 0;
  while q < SRC_MAX && wrap_add(q, 1) < j {
    off = wrap_add(off, ir_words(c, m, p, fld_ty(c, x, q), 1));
    q = q + 1;
  }
  let ft = fld_ty(c, x, j - 1);
  let fk = ir_kind(c, m, p, ft);
  if fk == IRK_INT {
    return IrVal { k: fk, r0: wrap_add(v.r0, off), r1: IR_NONE, t: 0 };
  }
  if fk == IRK_BOX {
    return IrVal { k: fk, r0: wrap_add(v.r0, off), r1: IR_NONE, t: base_t(m, ft) };
  }
  if fk == IRK_BUF || fk == IRK_BYTES || fk == IRK_STR {
    // In memory, and so in the registers of a struct, a buffer is its
    // length then its data address.
    return IrVal { k: fk, r0: wrap_add(v.r0, wrap_add(off, 1)), r1: wrap_add(v.r0, off), t: 0 };
  }
  if ir_multi(fk) {
    return IrVal { k: fk, r0: wrap_add(v.r0, off), r1: ir_words(c, m, p, ft, 1), t: ft };
  }
  ir_fail(&mut f, "a field outside the subset");
  return ir_none();
}


/// The IR operation of binary operator `op` on operands of the type kind
/// `signed` says, or 0 for one outside the subset.
fn ir_binop(op: u64, signed: bool) -> u64 {
  if op == P_PLUS { return IR_ADD; }
  if op == P_MINUS { return IR_SUB; }
  if op == P_STAR { return IR_MUL; }
  if op == P_SLASH { if signed { return IR_SDIV; } return IR_DIV; }
  if op == P_PERCENT { if signed { return IR_SREM; } return IR_REM; }
  if op == P_AMP { return IR_AND; }
  if op == P_PIPE { return IR_OR; }
  if op == P_CARET { return IR_XOR; }
  if op == P_SHL { return IR_SHL; }
  if op == P_SHR { if signed { return IR_SAR; } return IR_SHR; }
  if op == P_EQEQ { return IR_EQ; }
  if op == P_NE { return IR_NE; }
  if op == P_LT { if signed { return IR_SLT; } return IR_LT; }
  if op == P_LE { if signed { return IR_SLE; } return IR_LE; }
  if op == P_GT { if signed { return IR_SGT; } return IR_GT; }
  if op == P_GE { if signed { return IR_SGE; } return IR_GE; }
  return 0;
}

/// Condition `i` as control flow: goes to `lt` when it holds and `lf` when
/// it does not, without materialising `&&`, `||` and `!` of booleans in a
/// register.
fn ir_branch(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64, lt: u64, lf: u64) {
  let n = node_at(p.nodes, i);
  if n.kind == E_BIN && (n.v == P_ANDAND || n.v == P_OROR) {
    let mid = ir_label(&mut f);
    if n.v == P_ANDAND {
      ir_branch(&mut f, c, &mut m, p, n.a, mid, lf);
    } else {
      ir_branch(&mut f, c, &mut m, p, n.a, lt, mid);
    }
    ir_place(&mut f, mid);
    ir_branch(&mut f, c, &mut m, p, n.b, lt, lf);
    return;
  }
  if n.kind == E_NOT && cg_int_op(c, f.x, i) == 0 {
    ir_branch(&mut f, c, &mut m, p, n.a, lf, lt);
    return;
  }
  let cond = ir_int(&mut f, c, &mut m, p, i);
  ir_emit(&mut f, IR_BR, IR_NONE, cond, lt, lf, 0);
}

/// A register holding the constant `v`.
fn ir_k(f: &mut IrFn, v: u64) -> u64 {
  let r = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, r, v, 0, 0, 0);
  return r;
}

/// An integer expression: its register.
fn ir_int(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  let v = ir_expr(&mut f, c, &mut m, p, i);
  if !f.failed && v.k != IRK_INT {
    ir_fail(&mut f, "a buffer where an integer is expected");
    return IR_NONE;
  }
  return v.r0;
}

/// A Buf or Bytes expression: a variable (or a call that returns one).
fn ir_buf(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64, k: u64) -> IrVal {
  let v = ir_expr(&mut f, c, &mut m, p, i);
  if !f.failed && v.k != k {
    ir_fail(&mut f, "a buffer of another kind");
    return ir_none();
  }
  return v;
}

/// The enum value built by variant node `i` of enum instance `x`.
fn ir_variant(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64, x: u64) -> IrVal {
  let n = node_at(p.nodes, i);
  let t = intern(&mut m, p, TY_ENUM, x);
  let mw = ir_ms(c, m, p, t);
  if mw > 0 {
    // An enum the IR keeps in memory: the tag, then the payload, in a frame
    // slot of ours.
    let slot = ir_reg(&mut f);
    ir_emit(&mut f, IR_SLOT, slot, 0, 0, mw, 0);
    let out = IrVal { k: IRK_PLACE, r0: slot, r1: 0, t: base_t(m, t) };
    let v = cg_variant(m, p, x, n.s2, n.e2);
    let tag = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, tag, v, 0, 0, 0);
    ir_hdr_store(&mut f, slot, 0, tag);
    if n.a != 0 {
      let pv = ir_vexpr(&mut f, c, &mut m, p, n.a);
      let ft = fld_ty(c, x, v);
      if !f.failed && ft != 0 {
        let dst = IrVal { k: IRK_PLACE, r0: slot, r1: 1, t: base_t(m, ft) };
        ir_store_val(&mut f, c, m, p, dst, pv);
      }
    }
    return out;
  }
  if ir_kind(c, m, p, t) != IRK_ENUM {
    ir_fail(&mut f, "an enum outside the subset");
    return ir_none();
  }
  let out = ir_new_val(&mut f, IRK_ENUM, ir_words(c, m, p, t, 0), t);
  let v = cg_variant(m, p, x, n.s2, n.e2);
  ir_emit(&mut f, IR_CONST, out.r0, v, 0, 0, 0);
  // The payload words no variant uses are defined too.
  let mut z = 1;
  while z < out.r1 && z < 64 {
    ir_emit(&mut f, IR_CONST, wrap_add(out.r0, z), 0, 0, 0, 0);
    z = z + 1;
  }
  if n.a != 0 {
    let pv = ir_vexpr(&mut f, c, &mut m, p, n.a);
    let dst = ir_payload(&mut f, c, m, p, out, v);
    if !f.failed {
      if pv.k != dst.k {
        ir_fail(&mut f, "a payload of another kind");
      } else {
        ir_copy(&mut f, dst, pv);
      }
    }
  }
  return out;
}

/// Writes the fields of struct literal `i` into the place `out` (a struct
/// that lives in memory).
fn ir_slit_fill(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64, out: IrVal) {
  let n = node_at(p.nodes, i);
  let mut q = n.a;
  while q != 0 && !f.failed {
    let fi = node_at(p.nodes, q);
    let dst = ir_pfield(&mut f, c, m, p, out, fi.s, fi.e);
    let v = ir_vexpr(&mut f, c, &mut m, p, fi.a);
    if !f.failed {
      ir_store_val(&mut f, c, m, p, dst, v);
    }
    q = fi.next;
  }
}

/// The struct value built by literal node `i` of struct instance `x`.
fn ir_slit(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64, x: u64) -> IrVal {
  let n = node_at(p.nodes, i);
  let t = intern(&mut m, p, TY_STRUCT, x);
  let mw = ir_ms(c, m, p, t);
  if mw > 0 {
    // Built in place in a frame slot of ours.
    let slot = ir_reg(&mut f);
    ir_emit(&mut f, IR_SLOT, slot, 0, 0, mw, 0);
    let out = IrVal { k: IRK_PLACE, r0: slot, r1: 0, t: base_t(m, t) };
    ir_slit_fill(&mut f, c, &mut m, p, i, out);
    return out;
  }
  if ir_kind(c, m, p, t) != IRK_STRUCT {
    ir_fail(&mut f, "a struct outside the subset");
    return ir_none();
  }
  let out = ir_new_val(&mut f, IRK_STRUCT, ir_words(c, m, p, t, 0), t);
  let mut q = n.a;
  while q != 0 && !f.failed {
    let fi = node_at(p.nodes, q);
    let dst = ir_field(&mut f, c, m, p, out, fi.s, fi.e);
    let v = ir_vexpr(&mut f, c, &mut m, p, fi.a);
    if !f.failed {
      if v.k != dst.k {
        ir_fail(&mut f, "a field initializer of another kind");
      } else {
        ir_copy(&mut f, dst, v);
      }
    }
    q = fi.next;
  }
  return out;
}

/// Is expression `e` the place that assignment path `path` names (`q.st` in
/// `q.st = set(q.st, i, v)`)?
fn ir_is_path(p: &Parser, e: u64, path: Node) -> bool {
  let mut segs = vec_new[u64]();
  let mut seg = path.next;
  while seg != 0 && vec_len(segs) < 64 {
    vec_push(&mut segs, seg);
    let sn = node_at(p.nodes, seg);
    seg = sn.next;
  }
  let mut cur = e;
  let mut ok = e != 0;
  let mut j = vec_len(segs);
  while j > 0 && ok
    invariant j <= vlen(segs)
  {
    j = j - 1;
    let en = node_at(p.nodes, cur);
    let sn = node_at(p.nodes, u_at(segs, j));
    if en.kind != E_FIELD || !same(p.src, en.s, en.e, sn.s, sn.e) {
      ok = false;
    } else {
      cur = en.a;
    }
  }
  if ok {
    let en = node_at(p.nodes, cur);
    ok = en.kind == E_VAR && same(p.src, en.s, en.e, path.s, path.e);
  }
  vec_free(segs);
  return ok;
}

/// Lowers expression `i`; returns the registers that hold its value.
/// Whether an integer type fills the 64-bit register (no narrowing after an operation).
fn ir_full_width(m: &Mono, t: u64) -> bool {
  let k = kind_t(m, t);
  return k != TY_U8 && k != TY_U16 && k != TY_U32 && k != TY_I8 && k != TY_I16 && k != TY_I32;
}

fn ir_expr(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  if f.failed {
    return ir_none();
  }
  let n = node_at(p.nodes, i);
  let k = n.kind;
  if k == E_INT || k == E_BOOL {
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, d, n.v, 0, 0, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if k == E_VAR {
    let v = ir_find(f, p, n.s, n.e);
    if v.k == 0 {
      ir_fail(&mut f, "a name that is not a scalar or buffer variable");
    }
    return ir_rv(&mut f, c, m, p, v);
  }
  if k == E_STR || k == E_BLOB {
    let mut len = n.v;
    if k == E_STR {
      len = 0;
      if n.s <= n.e && n.e <= blen(p.src) {
        let bytes = decode(p.src, n.s, n.e);
        len = blen(bytes);
        bfree(bytes);
      }
    }
    let a = ir_reg(&mut f);
    ir_emit(&mut f, IR_STRLIT, a, i, 0, 0, 0);
    let l = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, l, len, 0, 0, 0);
    return IrVal { k: IRK_STR, r0: a, r1: l, t: 0 };
  }
  if k == E_NEG || k == E_NOT {
    let a = ir_int(&mut f, c, &mut m, p, n.a);
    let d = ir_reg(&mut f);
    let mut op = IR_NOT;
    if k == E_NEG {
      op = IR_NEG;
    }
    let nty = cg_int_op(c, f.x, i);
    if op == IR_NOT && nty != 0 && ir_full_width(m, nty) {
      // `!x` on a full-width integer is `x ^ all ones`, which the constant
      // folder and the immediate forms of the backends understand.
      let ones = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, ones, 0xFFFFFFFFFFFFFFFF, 0, 0, 0);
      ir_emit(&mut f, IR_XOR, d, a, ones, 0, 0);
      return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
    }
    ir_emit(&mut f, op, d, a, 0, 0, nty);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if k == E_BIN && (n.v == P_ANDAND || n.v == P_OROR) {
    // The right operand runs only if the left does not decide the result.
    // The chain branches straight to the two outcomes (`ir_branch`), and
    // the value is made once at the end, not carried from test to test.
    let d = ir_reg(&mut f);
    let l_true = ir_label(&mut f);
    let l_false = ir_label(&mut f);
    let end = ir_label(&mut f);
    ir_branch(&mut f, c, &mut m, p, i, l_true, l_false);
    ir_place(&mut f, l_true);
    ir_emit(&mut f, IR_CONST, d, 1, 0, 0, 0);
    ir_emit(&mut f, IR_JMP, IR_NONE, end, 0, 0, 0);
    ir_place(&mut f, l_false);
    ir_emit(&mut f, IR_CONST, d, 0, 0, 0, 0);
    ir_place(&mut f, end);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if k == E_BIN {
    let t = cg_int_op(c, f.x, i);
    let op = ir_binop(n.v, t != 0 && is_signed(m, t));
    if op == 0 {
      ir_fail(&mut f, "an operator outside the first subset");
      return ir_none();
    }
    let a = ir_int(&mut f, c, &mut m, p, n.a);
    let b = ir_int(&mut f, c, &mut m, p, n.b);
    let d = ir_reg(&mut f);
    ir_emit(&mut f, op, d, a, b, 0, t);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if k == E_CALL {
    return ir_call(&mut f, c, &mut m, p, i);
  }
  if k == E_TAPP && name_is(p, n.b, "vec_new") {
    let et = conv(&mut m, p, n.a, f.x, i);
    let ew = ir_mw(c, m, p, et, 0);
    if ew == IR_NONE || ew == 0 || ew >= 64 {
      ir_fail(&mut f, "a vector of elements the IR does not know");
      return ir_none();
    }
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_SLOT, d, 0, 0, 3, 0);
    let zero = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, zero, 0, 0, 0, 0);
    ir_hdr_store(&mut f, d, 0, zero);
    ir_hdr_store(&mut f, d, 1, zero);
    ir_hdr_store(&mut f, d, 2, zero);
    return IrVal { k: IRK_VEC, r0: d, r1: IR_NONE, t: ir_vt(et, 0) };
  }
  if k == E_MUTBORROW {
    let path = node_at(p.nodes, n.a);
    let mut v = ir_find(f, p, path.s, path.e);
    let mut seg = path.next;
    while seg != 0 && (v.k == IRK_PLACE || v.k == IRK_BOX || v.k == IRK_STRUCT) && !f.failed {
      let sn = node_at(p.nodes, seg);
      v = ir_field(&mut f, c, m, p, v, sn.s, sn.e);
      seg = sn.next;
    }
    if f.failed {
      return ir_none();
    }
    if v.k == IRK_PLACE {
      let uk = kind_t(m, base_t(m, v.t));
      if uk == TY_STRUCT || uk == TY_ENUM || uk == TY_CHILD {
        return v;
      }
      let fk = ir_kind(c, m, p, base_t(m, v.t));
      if fk == IRK_INT || fk == IRK_BOX {
        // A scalar or Box field in memory: lent by its address.
        return v;
      }
      v = ir_rv(&mut f, c, m, p, v);
    }
    if seg == 0 && (v.k == IRK_INT || v.k == IRK_BOX || v.k == IRK_BUF || v.k == IRK_BYTES || ir_multi(v.k)) {
      // A lent buffer stays the caller's: it is never freed or replaced
      // while lent, so its registers stay valid.
      return v;
    }
    if seg != 0 || v.k != IRK_VEC {
      ir_fail(&mut f, "a borrow of something that is not a vector or a struct in memory");
      return ir_none();
    }
    return v;
  }
  if k == E_VARIANT {
    let def = find_in(p, p.enums.head, i);
    let dnode = node_at(p.nodes, def);
    if def == 0 || dnode.v != 0 {
      ir_fail(&mut f, "a variant of a generic enum");
      return ir_none();
    }
    let x = plain_inst(&mut m, def);
    return ir_variant(&mut f, c, &mut m, p, i, x);
  }
  if k == E_TAPP && kind_of(p, n.b) == E_CALL && !is_typed_builtin(p, n.b) {
    // `f[T](args)`: the instance the monomorphizer made.
    let callee = tapp_inst(&mut m, p, i, f.x);
    if callee == 0 {
      ir_fail(&mut f, "a call of a generic function");
      return ir_none();
    }
    return ir_call_to(&mut f, c, &mut m, p, n.b, callee, ir_none(), IR_NONE);
  }
  if k == E_TAPP && kind_of(p, n.b) == E_VARIANT {
    // `Option[u64]::Some(x)`: the instance the monomorphizer made.
    let x = tapp_inst(&mut m, p, i, f.x);
    if x == 0 {
      ir_fail(&mut f, "a variant of a generic enum");
      return ir_none();
    }
    return ir_variant(&mut f, c, &mut m, p, n.b, x);
  }
  if k == E_IS {
    let e0 = ir_expr(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return ir_none();
    }
    if e0.k == IRK_PLACE && kind_t(m, base_t(m, e0.t)) == TY_ENUM {
      // The tag is the first word.
      let v = cg_variant(m, p, inner_t(m, base_t(m, e0.t)), n.s2, n.e2);
      let tag = ir_hdr_load(&mut f, e0.r0, e0.r1);
      let kr = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, kr, v, 0, 0, 0);
      let d = ir_reg(&mut f);
      ir_emit(&mut f, IR_EQ, d, tag, kr, 0, 0);
      return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
    }
    let e = ir_val(&mut f, c, m, p, e0);
    if f.failed {
      return ir_none();
    }
    if e.k != IRK_ENUM {
      ir_fail(&mut f, "`is` on something that is not an enum");
      return ir_none();
    }
    let v = cg_variant(m, p, inner_t(m, e.t), n.s2, n.e2);
    let kr = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, kr, v, 0, 0, 0);
    let d = ir_reg(&mut f);
    ir_emit(&mut f, IR_EQ, d, e.r0, kr, 0, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if k == E_FIELD {
    let b = ir_expr(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return ir_none();
    }
    let fv = ir_field(&mut f, c, m, p, b, n.s, n.e);
    if f.failed {
      return ir_none();
    }
    return ir_rv(&mut f, c, m, p, fv);
  }
  if k == E_SLIT {
    let def = find_in(p, p.structs.head, i);
    let dnode = node_at(p.nodes, def);
    if def == 0 || dnode.v != 0 {
      ir_fail(&mut f, "a literal of a generic struct");
      return ir_none();
    }
    return ir_slit(&mut f, c, &mut m, p, i, plain_inst(&mut m, def));
  }
  if k == E_TAPP && kind_of(p, n.b) == E_SLIT {
    // `Pair[u64, bool] { .. }`: the instance the monomorphizer made.
    let x = tapp_inst(&mut m, p, i, f.x);
    if x == 0 {
      ir_fail(&mut f, "a literal of a generic struct");
      return ir_none();
    }
    return ir_slit(&mut f, c, &mut m, p, n.b, x);
  }
  // `cast[T](x)` is proved to fit, so the value is unchanged; `wrap[T](x)`
  // keeps the low bits.
  if k == E_TAPP && (name_is(p, n.b, "cast") || name_is(p, n.b, "wrap")) {
    let inner = node_at(p.nodes, n.b);
    let a = ir_int(&mut f, c, &mut m, p, inner.a);
    let d = ir_reg(&mut f);
    if name_is(p, n.b, "wrap") {
      let t = conv(&mut m, p, n.a, f.x, i);
      ir_emit(&mut f, IR_WRAP, d, a, 0, 0, t);
    } else {
      ir_emit(&mut f, IR_MOV, d, a, 0, 0, 0);
    }
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  let first = !f.failed;
  ir_fail(&mut f, "an expression outside the first subset");
  if first {
    w_s(&mut f.why, " (node kind ");
    w_num(&mut f.why, k);
    w_s(&mut f.why, ")");
  }
  return ir_none();
}

/// The data address of buffer `v` plus index register `ix`, scaled by the
/// element size, is the element: loads and stores name both registers.
fn ir_elem(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  // get(b, ix) / bget(b, ix): the buffer, then the index in r1... see the
  // callers: the buffer's data register is returned in r0, the index in r1.
  let n = node_at(p.nodes, i);
  let a0 = n.a;
  let a1 = next_of(p, a0);
  let mut kind = IRK_BUF;
  if name_is(p, i, "bget") || name_is(p, i, "bset") {
    kind = IRK_BYTES;
  } else if name_is(p, i, "sget") {
    kind = IRK_STR;
  }
  let b = ir_buf(&mut f, c, &mut m, p, a0, kind);
  let ix = ir_int(&mut f, c, &mut m, p, a1);
  return IrVal { k: kind, r0: b.r0, r1: ix, t: 0 };
}

/// Stores the `w` words in the consecutive registers from `r` at the memory
/// at address register `a`, from word `off` on.
fn ir_store_words(f: &mut IrFn, a: u64, off: u64, r: u64, w: u64) {
  let mut j = 0;
  while j < w && j < 8192 {
    ir_hdr_store(&mut f, a, wrap_add(off, j), wrap_add(r, j));
    j = j + 1;
  }
}

/// Loads `w` words from address register `a`, from word `off` on, into the
/// consecutive registers from `r`.
fn ir_load_words(f: &mut IrFn, a: u64, off: u64, r: u64, w: u64) {
  let mut j = 0;
  while j < w && j < 8192 {
    let kr = ir_reg(&mut f);
    ir_emit(&mut f, IR_CONST, kr, wrap_add(off, j), 0, 0, 0);
    ir_emit(&mut f, IR_LOAD, wrap_add(r, j), a, kr, 8, 0);
    j = j + 1;
  }
}

/// The register that holds the address of place `v`.
fn ir_paddr(f: &mut IrFn, v: IrVal) -> u64 {
  if v.r1 == 0 {
    return v.r0;
  }
  let k = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, k, wrap_mul(8, v.r1), 0, 0, 0);
  let d = ir_reg(&mut f);
  ir_emit(&mut f, IR_ADD, d, v.r0, k, 0, 0);
  return d;
}

/// Field `s..e` of the struct in memory at place `v`: the place of the field.
fn ir_pfield(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, v: IrVal, s: u64, e: u64) -> IrVal {
  let u = base_t(m, v.t);
  if kind_t(m, u) != TY_STRUCT {
    ir_fail(&mut f, "a field of something that is not a struct");
    return ir_none();
  }
  let x = inner_t(m, u);
  let dn = def_node(m, p, x);
  let j = index_in(p, dn.a, s, e);
  if j == 0 {
    ir_fail(&mut f, "a field that is not there");
    return ir_none();
  }
  let mut off = 0;
  let mut q = 0;
  while q < SRC_MAX && wrap_add(q, 1) < j {
    let w = ir_mw(c, m, p, fld_ty(c, x, q), 0);
    if w == IR_NONE {
      ir_fail(&mut f, "a field of a type the IR does not know");
      return ir_none();
    }
    off = wrap_add(off, w);
    q = q + 1;
  }
  return IrVal { k: IRK_PLACE, r0: v.r0, r1: wrap_add(v.r1, off), t: base_t(m, fld_ty(c, x, j - 1)) };
}

/// The value read from place `v`, when it is a scalar (loaded), a buffer
/// (its two words loaded) or a Vec (the address of its header, marked `t` = 1
/// as part of the place); a struct or enum stays a place.
fn ir_rv(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, v: IrVal) -> IrVal {
  if v.k != IRK_PLACE {
    return v;
  }
  let k = ir_kind(c, m, p, v.t);
  if k == IRK_INT {
    return IrVal { k: IRK_INT, r0: ir_hdr_load(&mut f, v.r0, v.r1), r1: IR_NONE, t: 0 };
  }
  if k == IRK_BOX {
    return IrVal { k: IRK_BOX, r0: ir_hdr_load(&mut f, v.r0, v.r1), r1: IR_NONE, t: base_t(m, v.t) };
  }
  if k == IRK_BUF || k == IRK_BYTES || k == IRK_STR {
    let len = ir_hdr_load(&mut f, v.r0, v.r1);
    let data = ir_hdr_load(&mut f, v.r0, wrap_add(v.r1, 1));
    return IrVal { k: k, r0: data, r1: len, t: 0 };
  }
  if k == IRK_VEC {
    return IrVal { k: IRK_VEC, r0: ir_paddr(&mut f, v), r1: IR_NONE, t: ir_vt(inner_t(m, base_t(m, v.t)), 1) };
  }
  return v;
}

/// Like `ir_rv`, and a struct or enum in memory is loaded into registers
/// (when the IR holds that type in registers).
fn ir_val(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, v: IrVal) -> IrVal {
  if v.k != IRK_PLACE {
    return v;
  }
  let r = ir_rv(&mut f, c, m, p, v);
  if r.k != IRK_PLACE {
    return r;
  }
  let k = ir_kind(c, m, p, v.t);
  if ir_multi(k) {
    let w = ir_words(c, m, p, v.t, 0);
    let d = ir_new_val(&mut f, k, w, v.t);
    ir_load_words(&mut f, v.r0, v.r1, d.r0, w);
    return d;
  }
  if ir_ms(c, m, p, v.t) > 0 {
    return v;
  }
  ir_fail(&mut f, "a struct or enum held in memory used as a value");
  return ir_none();
}

/// The place a `&mut path` borrows, as it is in memory (nothing loaded):
/// `IRK_PLACE` for a field of a struct in memory, else whatever the path
/// is (the caller falls back to `ir_expr`).
fn ir_mutborrow_place(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  let n = node_at(p.nodes, i);
  let path = node_at(p.nodes, n.a);
  let mut v = ir_find(f, p, path.s, path.e);
  let mut seg = path.next;
  while seg != 0 && (v.k == IRK_PLACE || v.k == IRK_BOX || v.k == IRK_STRUCT) && !f.failed {
    let sn = node_at(p.nodes, seg);
    v = ir_field(&mut f, c, m, p, v, sn.s, sn.e);
    seg = sn.next;
  }
  if f.failed || seg != 0 {
    return ir_none();
  }
  return v;
}

/// Expression `i` as a value (see `ir_val`).
fn ir_vexpr(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  let v = ir_expr(&mut f, c, &mut m, p, i);
  if f.failed {
    return ir_none();
  }
  return ir_val(&mut f, c, m, p, v);
}

/// `v` stored to place `d`.
fn ir_store_val(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, d: IrVal, v: IrVal) {
  let k = ir_kind(c, m, p, d.t);
  let mw = ir_ms(c, m, p, d.t);
  if k == 0 && mw > 0 && v.k == IRK_PLACE {
    // A struct held in memory: its words, one by one.
    let mut j = 0;
    while j < mw {
      let kr = ir_reg(&mut f);
      ir_emit(&mut f, IR_CONST, kr, wrap_add(v.r1, j), 0, 0, 0);
      let w = ir_reg(&mut f);
      ir_emit(&mut f, IR_LOAD, w, v.r0, kr, 8, 0);
      ir_hdr_store(&mut f, d.r0, wrap_add(d.r1, j), w);
      j = j + 1;
    }
    return;
  }
  if k == 0 || v.k != k {
    ir_fail(&mut f, "a store between kinds");
    return;
  }
  if k == IRK_INT || k == IRK_BOX {
    ir_hdr_store(&mut f, d.r0, d.r1, v.r0);
  } else if k == IRK_BUF || k == IRK_BYTES || k == IRK_STR {
    ir_hdr_store(&mut f, d.r0, d.r1, v.r1);
    ir_hdr_store(&mut f, d.r0, wrap_add(d.r1, 1), v.r0);
  } else if k == IRK_VEC {
    let mut j = 0;
    while j < 3 {
      let w = ir_hdr_load(&mut f, v.r0, j);
      ir_hdr_store(&mut f, d.r0, wrap_add(d.r1, j), w);
      j = j + 1;
    }
  } else {
    ir_store_words(&mut f, d.r0, d.r1, v.r0, v.r1);
  }
}

/// A Vec read out of a place is the place's own header; a Vec that is kept
/// (bound, assigned) is a copy of it in a slot of ours.
fn ir_own(f: &mut IrFn, v: IrVal) -> IrVal {
  if v.k != IRK_VEC || v.t % 2 != 1 {
    return v;
  }
  let slot = ir_reg(&mut f);
  ir_emit(&mut f, IR_SLOT, slot, 0, 0, 3, 0);
  let mut j = 0;
  while j < 3 {
    let w = ir_hdr_load(&mut f, v.r0, j);
    ir_hdr_store(&mut f, slot, j, w);
    j = j + 1;
  }
  return IrVal { k: IRK_VEC, r0: slot, r1: IR_NONE, t: wrap_mul(v.t / 2, 2) };
}

/// Does expression `i` (or the list it heads, through `next`) mention the
/// name `s..e`? An expression of a kind not known here counts as a mention.
fn ir_mentions(p: &Parser, i: u64, s: u64, e: u64) -> bool {
  let mut j = i;
  while j != 0 {
    let n = node_at(p.nodes, j);
    let k = n.kind;
    if k == E_VAR {
      if same(p.src, n.s, n.e, s, e) {
        return true;
      }
    } else if k == E_MUTBORROW {
      let mut q = n.a;
      while q != 0 {
        let qn = node_at(p.nodes, q);
        if same(p.src, qn.s, qn.e, s, e) {
          return true;
        }
        q = qn.next;
      }
    } else if k == E_FIELD || k == E_IS || k == E_NOT || k == E_NEG || k == E_VARIANT {
      if ir_mentions(p, n.a, s, e) {
        return true;
      }
    } else if k == E_CALL {
      if ir_mentions(p, n.a, s, e) {
        return true;
      }
    } else if k == E_TAPP {
      if ir_mentions(p, n.b, s, e) {
        return true;
      }
    } else if k == E_BIN {
      if ir_mentions(p, n.a, s, e) || ir_mentions(p, n.b, s, e) {
        return true;
      }
    } else if k == E_SLIT {
      let mut f = n.a;
      while f != 0 {
        let fi = node_at(p.nodes, f);
        if ir_mentions(p, fi.a, s, e) {
          return true;
        }
        f = fi.next;
      }
    } else if k != E_INT && k != E_BOOL && k != E_STR && k != E_BLOB {
      return true;
    }
    j = n.next;
  }
  return false;
}

/// Does the statement list from `head` end in a `return` (or `unreachable`),
/// so that nothing it did reaches what follows it?
fn ir_ends_in_exit(p: &Parser, head: u64) -> bool {
  let mut i = head;
  let mut last = 0;
  while i != 0 {
    let n = node_at(p.nodes, i);
    last = n.kind;
    i = n.next;
  }
  return last == S_RETURN || last == S_UNREACHABLE;
}

/// Does the statement list from `head` use the name `bs..be` after
/// assigning to something spelled with the name `rs..re` (its root)? `st`
/// is 1 once an assignment to the root has run. A conservative scan: both
/// branches count, a loop body is scanned twice.
fn ir_use_after_assign(p: &Parser, head: u64, rs: u64, re: u64, bs: u64, be: u64, st: &mut u64) -> bool {
  let mut i = head;
  while i != 0 {
    let n = node_at(p.nodes, i);
    let k = n.kind;
    if k == S_ASSIGN {
      let r = node_at(p.nodes, n.a);
      if st == 1 && (ir_mentions(p, n.b, bs, be) || same(p.src, r.s, r.e, bs, be)) {
        return true;
      }
      if re >= rs && r.e >= r.s && r.e - r.s >= re - rs && same(p.src, r.s, wrap_add(r.s, re - rs), rs, re) {
        st = 1;
      }
    } else if k == S_LET {
      if st == 1 && ir_mentions(p, n.b, bs, be) {
        return true;
      }
    } else if k == S_RETURN || k == S_ASSERT || k == S_EXPR {
      if st == 1 && n.a != 0 && ir_mentions(p, n.a, bs, be) {
        return true;
      }
    } else if k == S_IF {
      if st == 1 && ir_mentions(p, n.a, bs, be) {
        return true;
      }
      let mut s1 = st;
      let mut s2 = st;
      if ir_use_after_assign(p, n.b, rs, re, bs, be, &mut s1) || ir_use_after_assign(p, n.c, rs, re, bs, be, &mut s2) {
        return true;
      }
      if (s1 == 1 && !ir_ends_in_exit(p, n.b)) || (s2 == 1 && !ir_ends_in_exit(p, n.c)) {
        st = 1;
      }
    } else if k == S_WHILE {
      if st == 1 && ir_mentions(p, n.a, bs, be) {
        return true;
      }
      if ir_use_after_assign(p, n.c, rs, re, bs, be, &mut st) || ir_use_after_assign(p, n.c, rs, re, bs, be, &mut st) {
        return true;
      }
    } else if k == S_MATCH {
      if st == 1 && ir_mentions(p, n.a, bs, be) {
        return true;
      }
      let mut out = st;
      let mut a = n.b;
      while a != 0 {
        let arm = node_at(p.nodes, a);
        let mut sa = st;
        if ir_use_after_assign(p, arm.c, rs, re, bs, be, &mut sa) {
          return true;
        }
        if sa == 1 && !ir_ends_in_exit(p, arm.c) {
          out = 1;
        }
        a = arm.next;
      }
      st = out;
    } else if st == 1 {
      return true;
    }
    i = n.next;
  }
  return false;
}

/// A struct or enum held in memory, copied to a frame slot of ours.
fn ir_own_place(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, v: IrVal) -> IrVal {
  let mw = ir_ms(c, m, p, v.t);
  if mw == 0 {
    ir_fail(&mut f, "a value held in memory that the IR cannot copy");
    return ir_none();
  }
  let slot = ir_reg(&mut f);
  ir_emit(&mut f, IR_SLOT, slot, 0, 0, mw, 0);
  let r = IrVal { k: IRK_PLACE, r0: slot, r1: 0, t: v.t };
  ir_store_val(&mut f, c, m, p, r, v);
  return r;
}

/// Word `k` of the Vec header at address `a`.
fn ir_hdr_load(f: &mut IrFn, a: u64, k: u64) -> u64 {
  let kr = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, kr, k, 0, 0, 0);
  let d = ir_reg(&mut f);
  ir_emit(&mut f, IR_LOAD, d, a, kr, 8, 0);
  return d;
}

fn ir_hdr_store(f: &mut IrFn, a: u64, k: u64, v: u64) {
  let kr = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, kr, k, 0, 0, 0);
  ir_emit(&mut f, IR_STORE, v, a, kr, 8, 0);
}

/// The Vec a `vec_*` builtin works on: a variable, or `&mut` of one.
fn ir_vec_arg(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  let v = ir_expr(&mut f, c, &mut m, p, i);
  if !f.failed && v.k != IRK_VEC {
    ir_fail(&mut f, "a vector builtin on something that is not a vector variable");
    return ir_none();
  }
  return v;
}

/// The place of element `ix` (a register) of the Vec `v`: its data address
/// plus `ix` elements of `w` words.
fn ir_vel(f: &mut IrFn, c: &Checker, m: &Mono, p: &Parser, v: IrVal, ix: u64, w: u64) -> IrVal {
  let data = ir_hdr_load(&mut f, v.r0, 2);
  let k = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, k, wrap_mul(8, w), 0, 0, 0);
  let off = ir_reg(&mut f);
  ir_emit(&mut f, IR_MUL, off, ix, k, 0, 0);
  let ea = ir_reg(&mut f);
  ir_emit(&mut f, IR_ADD, ea, data, off, 0, 0);
  return IrVal { k: IRK_PLACE, r0: ea, r1: 0, t: ir_velem(v) };
}

/// Is the element of Vec `v` one integer word (so that it is loaded and
/// stored directly)?
fn ir_vsimple(c: &Checker, m: &Mono, p: &Parser, v: IrVal) -> bool {
  return ir_kind(c, m, p, ir_velem(v)) == IRK_INT;
}

/// Copies `cnt` bytes from `src[so ..]` to `dst[do ..]` (address and offset
/// registers), lowest address first, in one `copy`; the destination does not
/// start inside the source.
fn ir_copy_bytes(f: &mut IrFn, c: &Checker, dst: u64, doff: u64, src: u64, soff: u64, cnt: u64) {
  let da = ir_reg(&mut f);
  ir_emit(&mut f, IR_ADD, da, dst, doff, 0, c.tu64);
  let sa = ir_reg(&mut f);
  ir_emit(&mut f, IR_ADD, sa, src, soff, 0, c.tu64);
  ir_emit(&mut f, IR_COPY, IR_NONE, da, sa, cnt, 0);
}

/// `bmove`: a copy within one buffer whose ranges may overlap, as memmove:
/// backward when the destination starts inside the source.
fn ir_move_bytes(f: &mut IrFn, c: &Checker, buf: u64, doff: u64, soff: u64, cnt: u64) {
  let diff = ir_reg(&mut f);
  ir_emit(&mut f, IR_SUB, diff, doff, soff, 0, c.tu64);
  let back = ir_reg(&mut f);
  ir_emit(&mut f, IR_LT, back, diff, cnt, 0, 0);
  let l_back = ir_label(&mut f);
  let l_fwd = ir_label(&mut f);
  let l_end = ir_label(&mut f);
  ir_emit(&mut f, IR_BR, IR_NONE, back, l_back, l_fwd, 0);
  ir_place(&mut f, l_fwd);
  ir_copy_bytes(&mut f, c, buf, doff, buf, soff, cnt);
  ir_jump(&mut f, l_end);
  ir_place(&mut f, l_back);
  let k = ir_reg(&mut f);
  ir_emit(&mut f, IR_MOV, k, cnt, 0, 0, 0);
  let one = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, one, 1, 0, 0, 0);
  let l_head = ir_label(&mut f);
  let l_body = ir_label(&mut f);
  ir_place(&mut f, l_head);
  let zero = ir_reg(&mut f);
  ir_emit(&mut f, IR_CONST, zero, 0, 0, 0, 0);
  let more = ir_reg(&mut f);
  ir_emit(&mut f, IR_GT, more, k, zero, 0, 0);
  ir_emit(&mut f, IR_BR, IR_NONE, more, l_body, l_end, 0);
  ir_place(&mut f, l_body);
  let k1 = ir_reg(&mut f);
  ir_emit(&mut f, IR_SUB, k1, k, one, 0, c.tu64);
  ir_emit(&mut f, IR_MOV, k, k1, 0, 0, 0);
  let si = ir_reg(&mut f);
  ir_emit(&mut f, IR_ADD, si, soff, k, 0, c.tu64);
  let di = ir_reg(&mut f);
  ir_emit(&mut f, IR_ADD, di, doff, k, 0, c.tu64);
  let x = ir_reg(&mut f);
  ir_emit(&mut f, IR_LOAD, x, buf, si, 1, 0);
  ir_emit(&mut f, IR_STORE, x, buf, di, 1, 0);
  ir_jump(&mut f, l_head);
  ir_place(&mut f, l_end);
}

/// The one-word value of a page handle argument (`Frame`, `Dma`) that is
/// lent: a handle held in a field of a struct in memory comes as that field's
/// place.
fn ir_handle_arg(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> u64 {
  let mut v = ir_expr(&mut f, c, &mut m, p, i);
  if !f.failed && v.k == IRK_PLACE {
    v = ir_rv(&mut f, c, m, p, v);
  }
  if !f.failed && v.k != IRK_INT {
    ir_fail(&mut f, "a page handle that is not one word");
    return IR_NONE;
  }
  return v.r0;
}

/// Is call node `i` one of the hosted runtime's calls on the process
/// (`Host` and `Child`)?
fn ir_is_host(p: &Parser, i: u64) -> bool {
  return name_is(p, i, "host_argc") || name_is(p, i, "host_arg") || name_is(p, i, "host_read") || name_is(p, i, "host_write")
    || name_is(p, i, "host_env") || name_is(p, i, "host_cpus") || name_is(p, i, "host_eprint") || name_is(p, i, "host_spawn")
    || name_is(p, i, "child_write") || name_is(p, i, "child_close") || name_is(p, i, "child_read_line") || name_is(p, i, "child_wait");
}

/// The address of the two words (length, then data) of the buffer that
/// argument `a` lends (the runtime may replace it): a slot, read back after
/// the call through `lent`.
fn ir_lend_bytes(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, a: u64, lent: &mut Vec[u64]) -> u64 {
  let b = ir_buf(&mut f, c, &mut m, p, a, IRK_BYTES);
  if f.failed {
    return IR_NONE;
  }
  let slot = ir_reg(&mut f);
  ir_emit(&mut f, IR_SLOT, slot, 0, 0, 2, 0);
  ir_hdr_store(&mut f, slot, 0, b.r1);
  ir_hdr_store(&mut f, slot, 1, b.r0);
  vec_push(&mut lent, slot);
  vec_push(&mut lent, b.r0);
  vec_push(&mut lent, b.r1);
  return slot;
}

/// The address of the three words of the Child that argument `a` is: where
/// it lies, or a slot its registers go to (and are read back from).
fn ir_child_addr(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, a: u64, lent: &mut Vec[u64]) -> u64 {
  let v = ir_expr(&mut f, c, &mut m, p, a);
  if f.failed {
    return IR_NONE;
  }
  if v.k == IRK_PLACE {
    return ir_paddr(&mut f, v);
  }
  if ir_multi(v.k) && v.r1 == 3 {
    let slot = ir_reg(&mut f);
    ir_emit(&mut f, IR_SLOT, slot, 0, 0, 3, 0);
    ir_store_words(&mut f, slot, 0, v.r0, 3);
    vec_push(&mut lent, slot);
    vec_push(&mut lent, v.r0);
    vec_push(&mut lent, wrap_add(IR_LENT_WORDS, 3));
    return slot;
  }
  ir_fail(&mut f, "a Child that is not in words or memory");
  return IR_NONE;
}

/// A call of the hosted runtime on the process: a `pcall` (`c` 20 to 31)
/// whose operand is the address of a block of four words, the values for
/// %rdi, %rsi, %rdx and %rcx of the runtime's routine (the old generator's
/// conventions); the routine's %rax, %rdx and %rcx are stored back in the
/// block's first three words. 31 is `host_argc`, which reads a variable.
fn ir_host_call(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  if c.target != TARGET_HOSTED {
    ir_fail(&mut f, "a host call outside a hosted program");
    return ir_none();
  }
  let mut lent = vec_new[u64]();
  let blk = ir_reg(&mut f);
  ir_emit(&mut f, IR_SLOT, blk, 0, 0, 4, 0);
  let mut which = 31;
  // 0: the result is in %rax, 1: no result, 2: a Bytes in %rax, %rdx, 3: a Child
  let mut res = 0;
  // The Host argument of a host call is only evaluated: nothing reads it.
  if !name_is(p, i, "child_write") && !name_is(p, i, "child_close") && !name_is(p, i, "child_read_line") && !name_is(p, i, "child_wait") {
    let h = ir_expr(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    if f.failed || h.k != IRK_INT {
      vec_free(lent);
      ir_fail(&mut f, "a host argument of another kind");
      return ir_none();
    }
  }
  if name_is(p, i, "host_arg") {
    which = 20;
    res = 2;
    let k = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    ir_hdr_store(&mut f, blk, 0, k);
  } else if name_is(p, i, "host_read") || name_is(p, i, "host_env") {
    which = 21;
    let mut kind = IRK_BYTES;
    if name_is(p, i, "host_env") {
      which = 23;
      kind = IRK_STR;
    }
    let path = ir_buf(&mut f, c, &mut m, p, cg_arg(p, i, 1), kind);
    let at = ir_lend_bytes(&mut f, c, &mut m, p, cg_arg(p, i, 2), &mut lent);
    if f.failed {
      vec_free(lent);
      return ir_none();
    }
    ir_hdr_store(&mut f, blk, 0, path.r0);
    ir_hdr_store(&mut f, blk, 1, path.r1);
    ir_hdr_store(&mut f, blk, 2, at);
  } else if name_is(p, i, "host_write") {
    which = 22;
    let path = ir_buf(&mut f, c, &mut m, p, cg_arg(p, i, 1), IRK_BYTES);
    let data = ir_buf(&mut f, c, &mut m, p, cg_arg(p, i, 2), IRK_BYTES);
    if f.failed {
      vec_free(lent);
      return ir_none();
    }
    ir_hdr_store(&mut f, blk, 0, path.r0);
    ir_hdr_store(&mut f, blk, 1, path.r1);
    ir_hdr_store(&mut f, blk, 2, data.r0);
    ir_hdr_store(&mut f, blk, 3, data.r1);
  } else if name_is(p, i, "host_cpus") {
    which = 24;
  } else if name_is(p, i, "host_eprint") {
    which = 25;
    res = 1;
    let b = ir_buf(&mut f, c, &mut m, p, cg_arg(p, i, 1), IRK_BYTES);
    if f.failed {
      vec_free(lent);
      return ir_none();
    }
    ir_hdr_store(&mut f, blk, 0, b.r0);
    ir_hdr_store(&mut f, blk, 1, b.r1);
  } else if name_is(p, i, "host_spawn") {
    // The argument vector: its data address, capacity and length.
    which = 26;
    res = 3;
    let v = ir_vec_arg(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    if f.failed {
      vec_free(lent);
      return ir_none();
    }
    let data = ir_hdr_load(&mut f, v.r0, 2);
    let cap = ir_hdr_load(&mut f, v.r0, 1);
    let len = ir_hdr_load(&mut f, v.r0, 0);
    ir_hdr_store(&mut f, blk, 0, data);
    ir_hdr_store(&mut f, blk, 1, cap);
    ir_hdr_store(&mut f, blk, 2, len);
  } else if name_is(p, i, "child_write") {
    which = 27;
    let ch = ir_child_addr(&mut f, c, &mut m, p, cg_arg(p, i, 0), &mut lent);
    let b = ir_buf(&mut f, c, &mut m, p, cg_arg(p, i, 1), IRK_BYTES);
    if f.failed {
      vec_free(lent);
      return ir_none();
    }
    ir_hdr_store(&mut f, blk, 0, b.r0);
    ir_hdr_store(&mut f, blk, 1, b.r1);
    ir_hdr_store(&mut f, blk, 2, ch);
  } else if name_is(p, i, "child_close") {
    which = 28;
    res = 1;
    let ch = ir_child_addr(&mut f, c, &mut m, p, cg_arg(p, i, 0), &mut lent);
    if f.failed {
      vec_free(lent);
      return ir_none();
    }
    ir_hdr_store(&mut f, blk, 0, ch);
  } else if name_is(p, i, "child_read_line") {
    which = 29;
    let ch = ir_child_addr(&mut f, c, &mut m, p, cg_arg(p, i, 0), &mut lent);
    let at = ir_lend_bytes(&mut f, c, &mut m, p, cg_arg(p, i, 1), &mut lent);
    if f.failed {
      vec_free(lent);
      return ir_none();
    }
    ir_hdr_store(&mut f, blk, 0, ch);
    ir_hdr_store(&mut f, blk, 1, at);
  } else if name_is(p, i, "child_wait") {
    // The child's pid, input and output go to %rdx, %rsi and %rdi.
    which = 30;
    let ch = ir_expr(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    if f.failed {
      vec_free(lent);
      return ir_none();
    }
    if !ir_multi(ch.k) || ch.r1 != 3 {
      vec_free(lent);
      ir_fail(&mut f, "a Child that is not in words");
      return ir_none();
    }
    ir_hdr_store(&mut f, blk, 0, wrap_add(ch.r0, 2));
    ir_hdr_store(&mut f, blk, 1, wrap_add(ch.r0, 1));
    ir_hdr_store(&mut f, blk, 2, ch.r0);
  }
  if f.failed {
    vec_free(lent);
    return ir_none();
  }
  let d = ir_reg(&mut f);
  ir_emit(&mut f, IR_PCALL, d, blk, blk, which, 0);
  ir_take_back(&mut f, lent);
  vec_free(lent);
  if res == 1 {
    return ir_none();
  }
  if res == 2 {
    let out = ir_new_val(&mut f, IRK_BYTES, 2, 0);
    ir_load_words(&mut f, blk, 0, out.r0, 2);
    return out;
  }
  if res == 3 {
    // The runtime leaves the output in %rax, the input in %rdx and the pid
    // in %rcx; the Child's words are the pid, the input and the output.
    let ct = prim(&mut m, p, TY_CHILD);
    let out = ir_new_val(&mut f, IRK_STRUCT, 3, ct);
    ir_load_words(&mut f, blk, 2, out.r0, 1);
    ir_load_words(&mut f, blk, 1, wrap_add(out.r0, 1), 1);
    ir_load_words(&mut f, blk, 0, wrap_add(out.r0, 2), 1);
    return out;
  }
  return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
}

/// Is call node `i` one of a user program's system calls?
fn ir_is_sys(p: &Parser, i: u64) -> bool {
  return name_is(p, i, "sys_spawn") || name_is(p, i, "sys_wait") || name_is(p, i, "sys_kill") || name_is(p, i, "sys_info")
    || name_is(p, i, "sys_yield") || name_is(p, i, "sys_getpid") || name_is(p, i, "sys_ps") || name_is(p, i, "sys_poweroff")
    || name_is(p, i, "sys_call") || name_is(p, i, "sys_send") || name_is(p, i, "sys_recv");
}

/// A system call of a user program. It is a `pcall` whose first register
/// is the system call number (for 10 and 11) and whose second is the address
/// of a frame slot of three words, the arguments for %rdi, %rsi and %rdx;
/// `c` 10 makes the call as it is, 11 writes out the console buffer first
/// (every call that can block or hand a buffer to the kernel), and 12 is
/// `sys_spawn`: the first register is the data address of the name's Buf, the
/// slot holds the two bounds.
fn ir_syscall(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  if c.target != TARGET_USER {
    ir_fail(&mut f, "a system call outside a user program");
    return ir_none();
  }
  let mut num = IR_NONE;
  let mut w0 = IR_NONE;
  let mut w1 = IR_NONE;
  let mut w2 = IR_NONE;
  let mut which = 10;
  let mut unit = false;
  if name_is(p, i, "sys_spawn") {
    let b = ir_buf(&mut f, c, &mut m, p, cg_arg(p, i, 0), IRK_BUF);
    w0 = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    w1 = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 2));
    num = b.r0;
    which = 12;
  } else if name_is(p, i, "sys_wait") || name_is(p, i, "sys_kill") || name_is(p, i, "sys_info") {
    w0 = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let mut nr = 7;
    if name_is(p, i, "sys_wait") {
      nr = 4;
    } else if name_is(p, i, "sys_kill") {
      nr = 9;
    }
    num = ir_k(&mut f, nr);
  } else if name_is(p, i, "sys_yield") || name_is(p, i, "sys_getpid") {
    let mut nr = 6;
    if name_is(p, i, "sys_yield") {
      nr = 5;
      unit = true;
    }
    num = ir_k(&mut f, nr);
  } else if name_is(p, i, "sys_ps") || name_is(p, i, "sys_poweroff") {
    let mut nr = 10;
    if name_is(p, i, "sys_ps") {
      nr = 8;
    }
    num = ir_k(&mut f, nr);
    which = 11;
    unit = true;
  } else if name_is(p, i, "sys_call") {
    num = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    w0 = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    w1 = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 2));
    which = 11;
  } else if name_is(p, i, "sys_send") {
    num = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    w0 = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let b = ir_buf(&mut f, c, &mut m, p, cg_arg(p, i, 2), IRK_BYTES);
    w1 = b.r0;
    w2 = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 3));
    which = 11;
  } else {
    // sys_recv: the kernel may fill all of the buffer.
    num = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    w0 = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let b = ir_buf(&mut f, c, &mut m, p, cg_arg(p, i, 2), IRK_BYTES);
    w1 = b.r0;
    w2 = b.r1;
    which = 11;
  }
  if f.failed {
    return ir_none();
  }
  if w0 == IR_NONE {
    w0 = ir_k(&mut f, 0);
  }
  if w1 == IR_NONE {
    w1 = ir_k(&mut f, 0);
  }
  if w2 == IR_NONE {
    w2 = ir_k(&mut f, 0);
  }
  let slot = ir_reg(&mut f);
  ir_emit(&mut f, IR_SLOT, slot, 0, 0, 3, 0);
  ir_hdr_store(&mut f, slot, 0, w0);
  ir_hdr_store(&mut f, slot, 1, w1);
  ir_hdr_store(&mut f, slot, 2, w2);
  let d = ir_reg(&mut f);
  ir_emit(&mut f, IR_PCALL, d, num, slot, which, 0);
  if unit {
    return ir_none();
  }
  return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
}

/// A call: a builtin of the subset (`len`, `blen`, `get`, `bget`) or a
/// function that is not generic and not a builtin, whose arguments and
/// result are integers or buffers (or no result).
fn ir_call(f: &mut IrFn, c: &Checker, m: &mut Mono, p: &Parser, i: u64) -> IrVal {
  let n = node_at(p.nodes, i);
  if name_is(p, i, "len") || name_is(p, i, "blen") || name_is(p, i, "slen") {
    let mut kind = IRK_BUF;
    if name_is(p, i, "blen") {
      kind = IRK_BYTES;
    } else if name_is(p, i, "slen") {
      kind = IRK_STR;
    }
    let b = ir_buf(&mut f, c, &mut m, p, n.a, kind);
    return IrVal { k: IRK_INT, r0: b.r1, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "get") || name_is(p, i, "bget") || name_is(p, i, "sget") {
    let e = ir_elem(&mut f, c, &mut m, p, i);
    let d = ir_reg(&mut f);
    let mut size = 8;
    if e.k == IRK_BYTES || e.k == IRK_STR {
      size = 1;
    }
    ir_emit(&mut f, IR_LOAD, d, e.r0, e.r1, size, 0);
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if is_wrap_builtin(p, n.s, n.e) {
    // Modular arithmetic: the same operation as `+`, `-`, `*`, marked by
    // `c` = 1, whose result the emitter truncates to the type in `ty`. (The
    // plain operators are proved not to overflow, so they need no
    // truncation and have `c` = 0.)
    let mut op = IR_MUL;
    if name_is(p, i, "wrap_add") {
      op = IR_ADD;
    } else if name_is(p, i, "wrap_sub") {
      op = IR_SUB;
    }
    let a = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 0));
    let b = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let d = ir_reg(&mut f);
    ir_emit(&mut f, op, d, a, b, 1, cg_int_ty(c, f.x, i));
    return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "vec_len") {
    let v = ir_vec_arg(&mut f, c, &mut m, p, n.a);
    if f.failed {
      return ir_none();
    }
    return IrVal { k: IRK_INT, r0: ir_hdr_load(&mut f, v.r0, 0), r1: IR_NONE, t: 0 };
  }
  if name_is(p, i, "vec_get") || name_is(p, i, "vec_set") {
    let v = ir_vec_arg(&mut f, c, &mut m, p, n.a);
    let ix = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let mut xv = ir_none();
    if name_is(p, i, "vec_set") {
      xv = ir_vexpr(&mut f, c, &mut m, p, cg_arg(p, i, 2));
    }
    if f.failed {
      return ir_none();
    }
    let setting = name_is(p, i, "vec_set");
    if ir_vsimple(c, m, p, v) {
      let data = ir_hdr_load(&mut f, v.r0, 2);
      if !setting {
        let d = ir_reg(&mut f);
        ir_emit(&mut f, IR_LOAD, d, data, ix, 8, 0);
        return IrVal { k: IRK_INT, r0: d, r1: IR_NONE, t: 0 };
      }
      ir_emit(&mut f, IR_STORE, xv.r0, data, ix, 8, 0);
      return ir_none();
    }
    let el = ir_vel(&mut f, c, m, p, v, ix, ir_mw(c, m, p, ir_velem(v), 0));
    if !setting {
      return ir_rv(&mut f, c, m, p, el);
    }
    ir_store_val(&mut f, c, m, p, el, xv);
    return ir_none();
  }
  if name_is(p, i, "vec_with") {
    // `vec_with(v, i, f, args..)`: `f` gets the element's place as its
    // first argument (by address when large, as any `&T`); the arguments
    // after `f` have no effect, so they can be evaluated after it.
    let v = ir_vec_arg(&mut f, c, &mut m, p, n.a);
    let ix = ir_int(&mut f, c, &mut m, p, cg_arg(p, i, 1));
    let fnode = node_at(p.nodes, cg_arg(p, i, 2));
    let def = plain_fn(p, fnode.s, fnode.e);
    if f.failed {
      return ir_none();
    }
    if def == 0 {
      ir_fail(&mut f, "a vec_with of a generic function");
      return ir_none();
    }
    let el = ir_vel(&mut f, c, m, p, v, ix, ir_mw(c, m, p, ir_velem(v), 0));
    let callee = plain_inst(&mut m, def);
    return ir_call_to(&mut f, c, &mut m, p, i, callee, el, cg_arg(p, i, 3));
  }
  if name_is(p, i, "vec_pop") {
    let v = ir_vec_arg(&mut f, c, &mut m, p, n.a);
