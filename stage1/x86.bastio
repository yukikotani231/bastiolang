  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_cpu_run:                 # run the saved user context; %rax = the trap vector\n");
  cg_s(&mut out, "\tmov %cr3, %rax              # flush the TLB: pages may have moved since the last run\n");
  cg_s(&mut out, "\tmov %rax, %cr3\n");
  cg_s(&mut out, "\tlea bst_cpu_enter(%rip), %rax\n");
  cg_s(&mut out, "\tjmp bst_rt_ccall\n");
  cg_s(&mut out, "bst_rt_fpu_load:                # load the user's x87/SSE state from the page at %rdi\n");
  cg_s(&mut out, "\tpush %rbp\n");
  cg_s(&mut out, "\tmov %rsp, %rbp\n");
  cg_s(&mut out, "\tsub $512, %rsp\n");
  cg_s(&mut out, "\tand $-16, %rsp\n");
  cg_s(&mut out, "\tmov %rdi, %rsi\n");
  cg_s(&mut out, "\tmov %rsp, %rdi\n");
  cg_s(&mut out, "\tmov $64, %ecx\n");
  cg_s(&mut out, "\trep movsq\n");
  cg_s(&mut out, "\tandq $0xFFFF, 24(%rsp)      # MXCSR: only the defined bits (fxrstor faults on the others)\n");
  cg_s(&mut out, "\tfxrstor64 (%rsp)\n");
  cg_s(&mut out, "\tleave\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_smp_start:               # run the thunk %rdi with %rsi on every other processor\n");
  cg_s(&mut out, "\tlea bst_platform_smp_start(%rip), %rax\n");
  cg_s(&mut out, "\tjmp bst_rt_ccall\n");
  cg_s(&mut out, "bst_rt_smp_join:                # wait until they have all returned\n");
  cg_s(&mut out, "\tlea bst_platform_smp_join(%rip), %rax\n");
  cg_s(&mut out, "\tjmp bst_rt_ccall\n");
  cg_s(&mut out, "\t.bss\n");
  cg_s(&mut out, "\t.p2align 3\n");
  cg_s(&mut out, "bst_rt_mbi:\t.quad 0\n");
  cg_s(&mut out, "bst_rt_pool_base:\t.quad 0\n");
  cg_s(&mut out, "bst_rt_pt_leases:\t.zero 1048576    # a 32-bit lease count per pool frame\n");
  cg_s(&mut out, "bst_rt_shared_refs:\t.zero 1048576  # a 32-bit reference count per shared pool frame\n");
  cg_s(&mut out, "bst_rt_arena_lock:\t.quad 0\n");
  cg_s(&mut out, "bst_rt_arena_top:\t.quad 0\n");
  cg_s(&mut out, "bst_rt_free_list:\t.quad 0\n");
  cg_s(&mut out, "bst_rt_arena:\t.zero 8388608\n");
  cg_s(&mut out, "\t.section .rodata\n");
  cg_s(&mut out, ".Lrt_oom:\n");
  cg_s(&mut out, "\t.string \"bastio: out of memory\\n\"\n");
  cg_s(&mut out, ".Lrt_fault:\n");
  cg_s(&mut out, "\t.string \"\\nbastio: kernel fault, vector \"\n");
  cg_s(&mut out, ".Lrt_rip:\n");
  cg_s(&mut out, "\t.string \" rip \"\n");
  cg_s(&mut out, ".Lrt_cr2:\n");
  cg_s(&mut out, "\t.string \" cr2 \"\n");
  cg_s(&mut out, ".Lrt_err:\n");
  cg_s(&mut out, "\t.string \" err \"\n");
  cg_s(&mut out, ".Lrt_0x:\n");
  cg_s(&mut out, "\t.string \"0x\"\n");
  cg_s(&mut out, ".Lrt_hex:\n");
  cg_s(&mut out, "\t.string \"0123456789abcdef\"\n");
  cg_s(&mut out, "\t.text\n");
}
