  w_s(&mut out, "\tlea 8(,%r12,8), %rdi        # argv for execvp, NULL-terminated\n");
  w_s(&mut out, "\tcall malloc@PLT\n");
  w_s(&mut out, "\ttest %rax, %rax\n");
