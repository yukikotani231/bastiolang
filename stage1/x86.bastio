  cg_s(&mut out, "\tcall waitpid@PLT\n");
  cg_s(&mut out, "\ttest %eax, %eax\n");
  cg_s(&mut out, "\tjs 3b\n");
  cg_s(&mut out, "\tmov -24(%rbp), %eax\n");
  cg_s(&mut out, "\tmov %eax, %ecx\n");
  cg_s(&mut out, "\tand $0x7f, %ecx\n");
  cg_s(&mut out, "\tjnz 4f\n");
  cg_s(&mut out, "\tshr $8, %eax                # exited: its status\n");
  cg_s(&mut out, "\tand $0xff, %eax\n");
