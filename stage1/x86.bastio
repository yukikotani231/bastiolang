  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "\t.section .rodata\n");
  cg_s(&mut out, ".Lrt_rb:\t.string \"rb\"\n");
  cg_s(&mut out, "\t.bss\n");
  cg_s(&mut out, "\t.p2align 4\n");
  cg_s(&mut out, "bst_rt_port_cell:\t.zero 262144            # the simulated I/O ports\n");
  cg_s(&mut out, "bst_rt_mmio_cell:\t.zero 1048576           # the simulated MMIO window\n");
