  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_child_read_line:         # the next line of the Child at (%rdi) into the Bytes at (%rsi); %rax = 1 if there was one\n");
  cg_s(&mut out, "\tpush %rbp\n");
  cg_s(&mut out, "\tmov %rsp, %rbp\n");
  cg_s(&mut out, "\tpush %rbx\n");
  cg_s(&mut out, "\tpush %r12\n");
  cg_s(&mut out, "\tpush %r13\n");
  cg_s(&mut out, "\tpush %r14\n");
  cg_s(&mut out, "\tpush %r15\n");
  cg_s(&mut out, "\tand $-16, %rsp\n");
  cg_s(&mut out, "\tmov 16(%rdi), %rbx\n");
  cg_s(&mut out, "\tmov %rsi, %r12\n");
  cg_s(&mut out, "\ttest %rbx, %rbx\n");
  cg_s(&mut out, "\tjz 8f\n");
  cg_s(&mut out, "\tmov $64, %r14d              # capacity, doubled when full\n");
  cg_s(&mut out, "\tmov %r14, %rdi\n");
  cg_s(&mut out, "\tcall malloc@PLT\n");
  cg_s(&mut out, "\ttest %rax, %rax\n");
  cg_s(&mut out, "\tjz bst_rt_oom\n");
  cg_s(&mut out, "\tmov %rax, %r13\n");
  cg_s(&mut out, "\txor %r15d, %r15d            # bytes in the line\n");
  cg_s(&mut out, "1:\tcmp %r14, %r15\n");
  cg_s(&mut out, "\tjne 2f\n");
  cg_s(&mut out, "\tadd %r14, %r14\n");
  cg_s(&mut out, "\tmov %r13, %rdi\n");
  cg_s(&mut out, "\tmov %r14, %rsi\n");
  cg_s(&mut out, "\tcall realloc@PLT\n");
  cg_s(&mut out, "\ttest %rax, %rax\n");
  cg_s(&mut out, "\tjz bst_rt_oom\n");
  cg_s(&mut out, "\tmov %rax, %r13\n");
  cg_s(&mut out, "2:\tmov %rbx, %rdi\n");
  cg_s(&mut out, "\tcall getc@PLT\n");
