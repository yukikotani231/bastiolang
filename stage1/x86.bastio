/// The runtime of the native backend for BastiOS user programs: the
/// C prelude's user part (`cg_prelude_user`) in assembly over the kernel's
/// system calls (`int $0x80`), with no C library. Part of the trusted base.
fn x86_runtime_user(out: &mut Vec[u64]) {
  w_s(&mut out, "\n");
  w_s(&mut out, "# ---- runtime: BastiOS user programs (trusted base) ----\n");
  w_s(&mut out, "bst_rt_sys:                     # system call %rax with %rdi, %rsi, %rdx: %rax = its result\n");
  w_s(&mut out, "\tint $0x80\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_fsys:                    # the same, after the console output so far\n");
  w_s(&mut out, "\tpush %rax\n");
  w_s(&mut out, "\tpush %rdi\n");
  w_s(&mut out, "\tpush %rsi\n");
  w_s(&mut out, "\tpush %rdx\n");
  w_s(&mut out, "\tcall bst_rt_flush\n");
  w_s(&mut out, "\tpop %rdx\n");
  w_s(&mut out, "\tpop %rsi\n");
  w_s(&mut out, "\tpop %rdi\n");
  w_s(&mut out, "\tpop %rax\n");
  w_s(&mut out, "\tint $0x80\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_flush:                   # write out the console buffer\n");
  w_s(&mut out, "\tmov bst_rt_out_n(%rip), %rsi\n");
  w_s(&mut out, "\ttest %rsi, %rsi\n");
  w_s(&mut out, "\tjz 1f\n");
  w_s(&mut out, "\tmov $1, %eax                # SYS_WRITE\n");
  w_s(&mut out, "\tlea bst_rt_out(%rip), %rdi\n");
  w_s(&mut out, "\txor %edx, %edx\n");
  w_s(&mut out, "\tint $0x80\n");
  w_s(&mut out, "\tmovq $0, bst_rt_out_n(%rip)\n");
  w_s(&mut out, "1:\tret\n");
  w_s(&mut out, "bst_rt_putc:                    # write byte %rdi to the console; flush at a newline or when full\n");
  w_s(&mut out, "\tmov bst_rt_out_n(%rip), %rax\n");
  w_s(&mut out, "\tlea bst_rt_out(%rip), %rcx\n");
  w_s(&mut out, "\tmov %dil, (%rcx,%rax)\n");
  w_s(&mut out, "\tinc %rax\n");
  w_s(&mut out, "\tmov %rax, bst_rt_out_n(%rip)\n");
  w_s(&mut out, "\tcmp $10, %dil\n");
  w_s(&mut out, "\tje bst_rt_flush\n");
  w_s(&mut out, "\tcmp $256, %rax\n");
  w_s(&mut out, "\tje bst_rt_flush\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_print:                   # print(%rdi) as a decimal line\n");
  w_s(&mut out, "\tpush %rbp\n");
  w_s(&mut out, "\tmov %rsp, %rbp\n");
  w_s(&mut out, "\tpush %r12\n");
  w_s(&mut out, "\tsub $24, %rsp\n");
  w_s(&mut out, "\tmov %rdi, %rax\n");
  w_s(&mut out, "\txor %r12d, %r12d            # digits, last first\n");
  w_s(&mut out, "\tmov $10, %ecx\n");
  w_s(&mut out, "1:\txor %edx, %edx\n");
  w_s(&mut out, "\tdiv %rcx\n");
  w_s(&mut out, "\tadd $48, %edx\n");
  w_s(&mut out, "\tmov %dl, (%rsp,%r12)\n");
  w_s(&mut out, "\tinc %r12\n");
  w_s(&mut out, "\ttest %rax, %rax\n");
  w_s(&mut out, "\tjnz 1b\n");
  w_s(&mut out, "2:\tdec %r12\n");
  w_s(&mut out, "\tmovzbl (%rsp,%r12), %edi\n");
  w_s(&mut out, "\tcall bst_rt_putc\n");
  w_s(&mut out, "\ttest %r12, %r12\n");
  w_s(&mut out, "\tjnz 2b\n");
  w_s(&mut out, "\tmov $10, %edi\n");
  w_s(&mut out, "\tcall bst_rt_putc\n");
  w_s(&mut out, "\tmov -8(%rbp), %r12\n");
  w_s(&mut out, "\tleave\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_getc:                    # %rax = the next byte of console input\n");
  w_s(&mut out, "\tcall bst_rt_flush\n");
  w_s(&mut out, "\tmov $2, %eax                # SYS_READ\n");
  w_s(&mut out, "\txor %edi, %edi\n");
  w_s(&mut out, "\txor %esi, %esi\n");
  w_s(&mut out, "\txor %edx, %edx\n");
  w_s(&mut out, "\tint $0x80\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_try_balloc:              # as bst_rt_balloc, but %rax = 0 when out of memory\n");
  w_s(&mut out, "\tadd $7, %rdi\n");
  w_s(&mut out, "\tshr $3, %rdi\n");
  w_s(&mut out, "bst_rt_try_alloc:\n");
  w_s(&mut out, "\tmov $1, %r8d\n");
  w_s(&mut out, "\tjmp 0f\n");
  w_s(&mut out, "bst_rt_balloc:                  # %rax = %rdi zeroed bytes (at least one)\n");
  w_s(&mut out, "\tadd $7, %rdi\n");
  w_s(&mut out, "\tshr $3, %rdi\n");
  w_s(&mut out, "bst_rt_alloc:                   # %rax = %rdi zeroed words (at least one), after a header word\n");
  w_s(&mut out, "\txor %r8d, %r8d             # out of memory stops the program\n");
  w_s(&mut out, "0:\ttest %rdi, %rdi\n");
  w_s(&mut out, "\tjnz 1f\n");
  w_s(&mut out, "\tmov $1, %edi\n");
  w_s(&mut out, "1:\tadd $1, %rdi                # the block's words, header included\n");
  w_s(&mut out, "\tjc 6f\n");
  w_s(&mut out, "\tlea bst_rt_free_list(%rip), %rdx\n");
  w_s(&mut out, "2:\tmov (%rdx), %rax            # a free block of exactly that size first\n");
  w_s(&mut out, "\ttest %rax, %rax\n");
  w_s(&mut out, "\tjz 4f\n");
  w_s(&mut out, "\tcmp (%rax), %rdi\n");
  w_s(&mut out, "\tje 3f\n");
  w_s(&mut out, "\tlea 8(%rax), %rdx\n");
  w_s(&mut out, "\tjmp 2b\n");
  w_s(&mut out, "3:\tmov 8(%rax), %rcx\n");
  w_s(&mut out, "\tmov %rcx, (%rdx)\n");
  w_s(&mut out, "\tjmp 5f\n");
  w_s(&mut out, "4:\tmov bst_rt_arena_top(%rip), %rax\n");
  w_s(&mut out, "\tmov $8192, %ecx             # the arena's words\n");
  w_s(&mut out, "\tsub %rax, %rcx\n");
  w_s(&mut out, "\tcmp %rcx, %rdi\n");
  w_s(&mut out, "\tja 6f\n");
  w_s(&mut out, "\tlea (%rax,%rdi), %rcx\n");
  w_s(&mut out, "\tmov %rcx, bst_rt_arena_top(%rip)\n");
  w_s(&mut out, "\tlea bst_rt_arena(%rip), %rcx\n");
  w_s(&mut out, "\tlea (%rcx,%rax,8), %rax\n");
  w_s(&mut out, "\tmov %rdi, (%rax)\n");
  w_s(&mut out, "5:\tlea 8(%rax), %rdx\n");
  w_s(&mut out, "\tlea -1(%rdi), %rcx\n");
  w_s(&mut out, "\tmov %rdx, %rdi\n");
  w_s(&mut out, "\txor %eax, %eax\n");
  w_s(&mut out, "\trep stosq\n");
  w_s(&mut out, "\tmov %rdx, %rax\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "6:\ttest %r8d, %r8d\n");
  w_s(&mut out, "\tjz bst_rt_oom\n");
  w_s(&mut out, "\txor %eax, %eax\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_free:                    # give the block at %rdi back to the free list (0: none)\n");
  w_s(&mut out, "\ttest %rdi, %rdi\n");
  w_s(&mut out, "\tjz 1f\n");
  w_s(&mut out, "\tmov bst_rt_free_list(%rip), %rax\n");
  w_s(&mut out, "\tmov %rax, (%rdi)\n");
  w_s(&mut out, "\tsub $8, %rdi\n");
  w_s(&mut out, "\tmov %rdi, bst_rt_free_list(%rip)\n");
  w_s(&mut out, "1:\tret\n");
  w_s(&mut out, "bst_rt_vec_grow:                # grow the Vec at (%rdi), elements of %rsi bytes\n");
  w_s(&mut out, "\tpush %rbp\n");
  w_s(&mut out, "\tmov %rsp, %rbp\n");
  w_s(&mut out, "\tpush %rbx\n");
  w_s(&mut out, "\tpush %r12\n");
  w_s(&mut out, "\tpush %r13\n");
  w_s(&mut out, "\tpush %r14\n");
  w_s(&mut out, "\tmov %rdi, %rbx\n");
  w_s(&mut out, "\tmov %rsi, %r13\n");
  w_s(&mut out, "\tmov 8(%rbx), %rax           # the old words\n");
  w_s(&mut out, "\tmul %rsi\n");
  w_s(&mut out, "\tadd $7, %rax\n");
  w_s(&mut out, "\tshr $3, %rax\n");
  w_s(&mut out, "\tmov %rax, %r14\n");
  w_s(&mut out, "\tmov 8(%rbx), %r12           # new capacity: double, or 4 when empty\n");
  w_s(&mut out, "\tadd %r12, %r12\n");
  w_s(&mut out, "\tjnz 1f\n");
  w_s(&mut out, "\tmov $4, %r12d\n");
  w_s(&mut out, "1:\tmov %r12, %rax\n");
  w_s(&mut out, "\tmul %r13                    # bytes; past 64 bits the request cannot be met\n");
  w_s(&mut out, "\tjo bst_rt_oom\n");
  w_s(&mut out, "\tmov %rax, %rdi\n");
  w_s(&mut out, "\tadd $7, %rdi\n");
  w_s(&mut out, "\tjc bst_rt_oom\n");
  w_s(&mut out, "\tshr $3, %rdi\n");
  w_s(&mut out, "\tcall bst_rt_alloc\n");
  w_s(&mut out, "\tmov %rax, %r13\n");
  w_s(&mut out, "\tmov 16(%rbx), %rsi\n");
  w_s(&mut out, "\ttest %rsi, %rsi\n");
  w_s(&mut out, "\tjz 2f\n");
  w_s(&mut out, "\tmov %rax, %rdi\n");
  w_s(&mut out, "\tmov %r14, %rcx\n");
  w_s(&mut out, "\trep movsq\n");
  w_s(&mut out, "\tmov 16(%rbx), %rdi\n");
  w_s(&mut out, "\tcall bst_rt_free\n");
  w_s(&mut out, "2:\tmov %r13, 16(%rbx)\n");
  w_s(&mut out, "\tmov %r12, 8(%rbx)\n");
  w_s(&mut out, "\tmov -8(%rbp), %rbx\n");
  w_s(&mut out, "\tmov -16(%rbp), %r12\n");
  w_s(&mut out, "\tmov -24(%rbp), %r13\n");
  w_s(&mut out, "\tmov -32(%rbp), %r14\n");
  w_s(&mut out, "\tleave\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_vec_try_reserve:         # room for %rsi more elements of %rdx bytes in the Vec at (%rdi): %eax = 1, or 0 and unchanged\n");
  w_s(&mut out, "\tmov 8(%rdi), %rax\n");
  w_s(&mut out, "\tsub (%rdi), %rax\n");
  w_s(&mut out, "\tcmp %rsi, %rax\n");
  w_s(&mut out, "\tjb 1f\n");
  w_s(&mut out, "\tmov $1, %eax\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "1:\tpush %rbp\n");
  w_s(&mut out, "\tmov %rsp, %rbp\n");
  w_s(&mut out, "\tpush %rbx\n");
  w_s(&mut out, "\tpush %r12\n");
  w_s(&mut out, "\tpush %r13\n");
  w_s(&mut out, "\tpush %r14\n");
  w_s(&mut out, "\tmov %rdi, %rbx\n");
  w_s(&mut out, "\tmov %rdx, %r13\n");
  w_s(&mut out, "\tmov $1, %eax                # lim = 2^60 / size: the capacity stays at most 2^60\n");
  w_s(&mut out, "\tshl $60, %rax\n");
  w_s(&mut out, "\txor %edx, %edx\n");
  w_s(&mut out, "\tdiv %r13\n");
  w_s(&mut out, "\tmov (%rbx), %rcx\n");
  w_s(&mut out, "\tcmp %rax, %rcx\n");
  w_s(&mut out, "\tja 3f\n");
  w_s(&mut out, "\tmov %rax, %r8\n");
  w_s(&mut out, "\tsub %rcx, %r8\n");
  w_s(&mut out, "\tcmp %r8, %rsi\n");
  w_s(&mut out, "\tja 3f\n");
  w_s(&mut out, "\tlea (%rcx,%rsi), %r12       # new capacity: len + k, or double when that is more and fits\n");
  w_s(&mut out, "\tmov 8(%rbx), %rdx\n");
  w_s(&mut out, "\tshr $1, %rax\n");
  w_s(&mut out, "\tcmp %rax, %rdx\n");
  w_s(&mut out, "\tja 2f\n");
  w_s(&mut out, "\tadd %rdx, %rdx\n");
  w_s(&mut out, "\tcmp %r12, %rdx\n");
  w_s(&mut out, "\tjbe 2f\n");
  w_s(&mut out, "\tmov %rdx, %r12\n");
  w_s(&mut out, "2:\tmov 8(%rbx), %rax           # the old words\n");
  w_s(&mut out, "\tmul %r13\n");
  w_s(&mut out, "\tadd $7, %rax\n");
  w_s(&mut out, "\tshr $3, %rax\n");
  w_s(&mut out, "\tmov %rax, %r14\n");
  w_s(&mut out, "\tmov %r12, %rax              # the new words\n");
  w_s(&mut out, "\tmul %r13\n");
  w_s(&mut out, "\tadd $7, %rax\n");
  w_s(&mut out, "\tshr $3, %rax\n");
  w_s(&mut out, "\tmov %rax, %rdi\n");
  w_s(&mut out, "\tcall bst_rt_try_alloc\n");
  w_s(&mut out, "\ttest %rax, %rax\n");
  w_s(&mut out, "\tjz 3f\n");
  w_s(&mut out, "\tmov %rax, %r13\n");
  w_s(&mut out, "\tmov 16(%rbx), %rsi\n");
  w_s(&mut out, "\ttest %rsi, %rsi\n");
  w_s(&mut out, "\tjz 4f\n");
  w_s(&mut out, "\tmov %rax, %rdi\n");
  w_s(&mut out, "\tmov %r14, %rcx\n");
  w_s(&mut out, "\trep movsq\n");
  w_s(&mut out, "\tmov 16(%rbx), %rdi\n");
  w_s(&mut out, "\tcall bst_rt_free\n");
  w_s(&mut out, "4:\tmov %r13, 16(%rbx)\n");
  w_s(&mut out, "\tmov %r12, 8(%rbx)\n");
  w_s(&mut out, "\tmov $1, %eax\n");
  w_s(&mut out, "\tjmp 5f\n");
  w_s(&mut out, "3:\txor %eax, %eax\n");
  w_s(&mut out, "5:\tmov -8(%rbp), %rbx\n");
  w_s(&mut out, "\tmov -16(%rbp), %r12\n");
  w_s(&mut out, "\tmov -24(%rbp), %r13\n");
  w_s(&mut out, "\tmov -32(%rbp), %r14\n");
  w_s(&mut out, "\tleave\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_bfrom:                   # Bytes copied from the %rdi bytes at %rsi: %rax = data, %rdx = len\n");
  w_s(&mut out, "\tpush %rbp\n");
  w_s(&mut out, "\tmov %rsp, %rbp\n");
  w_s(&mut out, "\tpush %rbx\n");
  w_s(&mut out, "\tpush %r12\n");
  w_s(&mut out, "\tmov %rdi, %rbx\n");
  w_s(&mut out, "\tmov %rsi, %r12\n");
  w_s(&mut out, "\tcall bst_rt_balloc\n");
  w_s(&mut out, "\tmov %rax, %rdi\n");
  w_s(&mut out, "\tmov %r12, %rsi\n");
  w_s(&mut out, "\tmov %rbx, %rcx\n");
  w_s(&mut out, "\trep movsb\n");
  w_s(&mut out, "\tmov %rbx, %rdx\n");
  w_s(&mut out, "\tmov -8(%rbp), %rbx\n");
  w_s(&mut out, "\tmov -16(%rbp), %r12\n");
  w_s(&mut out, "\tleave\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_sys_spawn:               # start the program named by words %rsi..%rdx of the Buf data at %rdi\n");
  w_s(&mut out, "\tpush %rbp\n");
  w_s(&mut out, "\tmov %rsp, %rbp\n");
  w_s(&mut out, "\tsub $64, %rsp\n");
  w_s(&mut out, "\txor %ecx, %ecx              # the name's bytes, at most 64\n");
  w_s(&mut out, "1:\tcmp %rdx, %rsi\n");
  w_s(&mut out, "\tjae 2f\n");
  w_s(&mut out, "\tcmp $64, %rcx\n");
  w_s(&mut out, "\tjae 2f\n");
  w_s(&mut out, "\tmov (%rdi,%rsi,8), %rax\n");
  w_s(&mut out, "\tmov %al, (%rsp,%rcx)\n");
  w_s(&mut out, "\tinc %rcx\n");
  w_s(&mut out, "\tinc %rsi\n");
  w_s(&mut out, "\tjmp 1b\n");
  w_s(&mut out, "2:\tmov $3, %eax                # SYS_SPAWN\n");
  w_s(&mut out, "\tmov %rsp, %rdi\n");
  w_s(&mut out, "\tmov %rcx, %rsi\n");
  w_s(&mut out, "\txor %edx, %edx\n");
  w_s(&mut out, "\tint $0x80\n");
  w_s(&mut out, "\tleave\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_oom:\n");
  w_s(&mut out, "\tcall bst_rt_flush\n");
  w_s(&mut out, "\tmov $1, %eax\n");
  w_s(&mut out, "\tlea .Lrt_oom(%rip), %rdi\n");
  w_s(&mut out, "\tmov $22, %esi\n");
  w_s(&mut out, "\txor %edx, %edx\n");
  w_s(&mut out, "\tint $0x80\n");
  w_s(&mut out, "\txor %eax, %eax              # SYS_EXIT\n");
  w_s(&mut out, "\tmov $255, %edi\n");
  w_s(&mut out, "\tint $0x80\n");
  w_s(&mut out, "\tud2\n");
  w_s(&mut out, "\t.bss\n");
  w_s(&mut out, "\t.p2align 3\n");
  w_s(&mut out, "bst_rt_out_n:\t.quad 0\n");
  w_s(&mut out, "bst_rt_arena_top:\t.quad 0\n");
  w_s(&mut out, "bst_rt_free_list:\t.quad 0\n");
  w_s(&mut out, "bst_rt_out:\t.zero 256\n");
  w_s(&mut out, "bst_rt_arena:\t.zero 65536\n");
  w_s(&mut out, "\t.section .rodata\n");
  w_s(&mut out, ".Lrt_oom:\n");
  w_s(&mut out, "\t.string \"bastio: out of memory\\n\"\n");
  w_s(&mut out, "\t.text\n");
}

/// The runtime of the native backend for a BastiOS kernel: the C prelude's
/// `kernel`, `kernel_cpu` and `bytes_arena` parts in assembly (COM1, the
/// 8 MiB arena, the page pool from the Multiboot information, the fault
/// report), calling the platform's C only where the C prelude does. Part of
/// the trusted base.
fn x86_runtime_kernel(out: &mut Vec[u64], fast: bool) {
  w_s(&mut out, "\n");
  w_s(&mut out, "# ---- runtime: BastiOS kernel (trusted base) ----\n");
  w_s(&mut out, "bst_rt_putc:                    # write byte %rdi to COM1, waiting for room\n");
  w_s(&mut out, "\tmov $0x3FD, %edx\n");
  w_s(&mut out, "1:\tinb %dx, %al\n");
  w_s(&mut out, "\ttest $0x20, %al\n");
  w_s(&mut out, "\tjz 1b\n");
  w_s(&mut out, "\tmov %edi, %eax\n");
  w_s(&mut out, "\tmov $0x3F8, %edx\n");
  w_s(&mut out, "\toutb %al, %dx\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_getc:                    # %rax = the next byte from COM1 (waits for one)\n");
  w_s(&mut out, "\tmov $0x3FD, %edx\n");
  w_s(&mut out, "1:\tinb %dx, %al\n");
  w_s(&mut out, "\ttest $1, %al\n");
  w_s(&mut out, "\tjnz 2f\n");
  w_s(&mut out, "\tpause\n");
  w_s(&mut out, "\tjmp 1b\n");
  w_s(&mut out, "2:\tmov $0x3F8, %edx\n");
  w_s(&mut out, "\tinb %dx, %al\n");
  w_s(&mut out, "\tmovzbl %al, %eax\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_poll:                    # %rax = a byte from COM1, or 256 when none is waiting\n");
  w_s(&mut out, "\tmov $0x3FD, %edx\n");
  w_s(&mut out, "\tinb %dx, %al\n");
  w_s(&mut out, "\ttest $1, %al\n");
  w_s(&mut out, "\tjz 1f\n");
  w_s(&mut out, "\tmov $0x3F8, %edx\n");
  w_s(&mut out, "\tinb %dx, %al\n");
  w_s(&mut out, "\tmovzbl %al, %eax\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "1:\tmov $256, %eax\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_serial_init:             # COM1: 115200 baud, 8N1, FIFO on, interrupt on received data\n");
  w_s(&mut out, "\tmov $0x3F9, %edx\n");
  w_s(&mut out, "\tmov $0x00, %al              # interrupts off while configuring\n");
  w_s(&mut out, "\toutb %al, %dx\n");
  w_s(&mut out, "\tmov $0x3FB, %edx\n");
  w_s(&mut out, "\tmov $0x80, %al              # DLAB on\n");
  w_s(&mut out, "\toutb %al, %dx\n");
  w_s(&mut out, "\tmov $0x3F8, %edx\n");
  w_s(&mut out, "\tmov $0x01, %al              # 115200 baud\n");
  w_s(&mut out, "\toutb %al, %dx\n");
  w_s(&mut out, "\tmov $0x3F9, %edx\n");
  w_s(&mut out, "\tmov $0x00, %al\n");
  w_s(&mut out, "\toutb %al, %dx\n");
  w_s(&mut out, "\tmov $0x3FB, %edx\n");
  w_s(&mut out, "\tmov $0x03, %al              # 8N1\n");
  w_s(&mut out, "\toutb %al, %dx\n");
  w_s(&mut out, "\tmov $0x3FA, %edx\n");
  w_s(&mut out, "\tmov $0xC7, %al              # FIFO on\n");
  w_s(&mut out, "\toutb %al, %dx\n");
  w_s(&mut out, "\tmov $0x3FC, %edx\n");
  w_s(&mut out, "\tmov $0x0B, %al              # DTR, RTS, OUT2 (routes the IRQ line)\n");
  w_s(&mut out, "\toutb %al, %dx\n");
  w_s(&mut out, "\tmov $0x3F9, %edx\n");
  w_s(&mut out, "\tmov $0x01, %al              # interrupt on received data\n");
  w_s(&mut out, "\toutb %al, %dx\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_print:                   # print(%rdi) as a decimal line\n");
  w_s(&mut out, "\tpush %rbp\n");
  w_s(&mut out, "\tmov %rsp, %rbp\n");
  w_s(&mut out, "\tpush %r12\n");
  w_s(&mut out, "\tsub $24, %rsp\n");
  w_s(&mut out, "\tmov %rdi, %rax\n");
  w_s(&mut out, "\txor %r12d, %r12d            # digits, last first\n");
  w_s(&mut out, "\tmov $10, %ecx\n");
  w_s(&mut out, "1:\txor %edx, %edx\n");
  w_s(&mut out, "\tdiv %rcx\n");
  w_s(&mut out, "\tadd $48, %edx\n");
  w_s(&mut out, "\tmov %dl, (%rsp,%r12)\n");
  w_s(&mut out, "\tinc %r12\n");
  w_s(&mut out, "\ttest %rax, %rax\n");
  w_s(&mut out, "\tjnz 1b\n");
  w_s(&mut out, "2:\tdec %r12\n");
  w_s(&mut out, "\tmovzbl (%rsp,%r12), %edi\n");
  w_s(&mut out, "\tcall bst_rt_putc\n");
  w_s(&mut out, "\ttest %r12, %r12\n");
  w_s(&mut out, "\tjnz 2b\n");
  w_s(&mut out, "\tmov $10, %edi\n");
  w_s(&mut out, "\tcall bst_rt_putc\n");
  w_s(&mut out, "\tmov -8(%rbp), %r12\n");
  w_s(&mut out, "\tleave\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_puts:                    # write the NUL-terminated string at %rdi to COM1\n");
  w_s(&mut out, "\tpush %rbx\n");
  w_s(&mut out, "\tmov %rdi, %rbx\n");
  w_s(&mut out, "1:\tmovzbl (%rbx), %edi\n");
  w_s(&mut out, "\ttest %edi, %edi\n");
  w_s(&mut out, "\tjz 2f\n");
  w_s(&mut out, "\tcall bst_rt_putc\n");
  w_s(&mut out, "\tinc %rbx\n");
  w_s(&mut out, "\tjmp 1b\n");
  w_s(&mut out, "2:\tpop %rbx\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_puthex:                  # write %rdi to COM1 as 0x and 16 hex digits\n");
  w_s(&mut out, "\tpush %rbx\n");
  w_s(&mut out, "\tpush %r12\n");
  w_s(&mut out, "\tmov %rdi, %rbx\n");
  w_s(&mut out, "\tlea .Lrt_0x(%rip), %rdi\n");
  w_s(&mut out, "\tcall bst_rt_puts\n");
  w_s(&mut out, "\tmov $60, %r12d\n");
  w_s(&mut out, "1:\tmov %rbx, %rax\n");
  w_s(&mut out, "\tmov %r12d, %ecx\n");
  w_s(&mut out, "\tshr %cl, %rax\n");
  w_s(&mut out, "\tand $15, %eax\n");
  w_s(&mut out, "\tlea .Lrt_hex(%rip), %rdx\n");
