  w_s(&mut out, "\tlea bst_kernel_pml4(%rip), %rcx\n");
  w_s(&mut out, "\tmov %rcx, %cr3\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "1:\tpush %rax\n");
  w_s(&mut out, "\tpush %rdx\n");
  w_s(&mut out, "\tpush %rsi\n");
  w_s(&mut out, "\tpush %rdi\n");
  w_s(&mut out, "\tpush %r8\n");
  w_s(&mut out, "\tpush %r9\n");
  w_s(&mut out, "\tpush %r10\n");
  w_s(&mut out, "\tpush %r11\n");
  w_s(&mut out, "\tlea bst_platform_mmu_state(%rip), %rax\n");
  w_s(&mut out, "\tcall bst_rt_ccall\n");
  w_s(&mut out, "\tmovq $0, 24(%rax)\n");
  w_s(&mut out, "\tpop %r11\n");
  w_s(&mut out, "\tpop %r10\n");
  w_s(&mut out, "\tpop %r9\n");
  w_s(&mut out, "\tpop %r8\n");
  w_s(&mut out, "\tpop %rdi\n");
  w_s(&mut out, "\tpop %rsi\n");
  w_s(&mut out, "\tpop %rdx\n");
  w_s(&mut out, "\tpop %rax\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_cpu_run:                 # run the saved user context; %rax = the trap vector\n");
  w_s(&mut out, "\tmov $bst_platform_deferred_cr3, %eax\n");
  w_s(&mut out, "\ttest %eax, %eax\n");
  w_s(&mut out, "\tjnz 1f\n");
  w_s(&mut out, "\tmov %cr3, %rax              # flush the TLB: pages may have moved since the last run\n");
  w_s(&mut out, "\tmov %rax, %cr3\n");
  w_s(&mut out, "1:\n");
  w_s(&mut out, "\tlea bst_cpu_enter(%rip), %rax\n");
  w_s(&mut out, "\tjmp bst_rt_ccall\n");
  w_s(&mut out, "bst_rt_fpu_load:                # load the user's x87/SSE state from the page at %rdi\n");
  w_s(&mut out, "\tmov 24(%rdi), %rax\n");
  w_s(&mut out, "\tmovzwl %ax, %edx               # MXCSR: only the defined bits (fxrstor faults on the others)\n");
  w_s(&mut out, "\tmov %rdx, 24(%rdi)\n");
  w_s(&mut out, "\tfxrstor64 (%rdi)\n");
  w_s(&mut out, "\tmov %rax, 24(%rdi)              # the page reads as it did\n");
  w_s(&mut out, "\tret\n");
  w_s(&mut out, "bst_rt_smp_start:               # run the thunk %rdi with %rsi on every other processor\n");
  w_s(&mut out, "\tlea bst_platform_smp_start(%rip), %rax\n");
  w_s(&mut out, "\tjmp bst_rt_ccall\n");
  w_s(&mut out, "bst_rt_smp_join:                # wait until they have all returned\n");
  w_s(&mut out, "\tlea bst_platform_smp_join(%rip), %rax\n");
  w_s(&mut out, "\tjmp bst_rt_ccall\n");
  w_s(&mut out, "\t.bss\n");
  w_s(&mut out, "\t.p2align 3\n");
  w_s(&mut out, "bst_rt_mbi:\t.quad 0\n");
  w_s(&mut out, "\t.globl bst_pt_gen\n");
  w_s(&mut out, "bst_pt_gen:\n");
  w_s(&mut out, "bst_rt_pt_gen:\t.quad 0         # entries taken out of any table (boot.S compares it)\n");
  w_s(&mut out, "bst_rt_run_at:\t.zero 256        # where each run of RAM starts (bst_rt_pool_init)\n");
  w_s(&mut out, "bst_rt_run_id:\t.zero 264        # the page number each starts at, and the end\n");
  w_s(&mut out, "bst_rt_runs:\t.quad 0\n");
  w_s(&mut out, "bst_rt_pt_leases:\t.quad 0       # a 32-bit lease count per pool page, carved from RAM\n");
  w_s(&mut out, "bst_rt_shared_refs:\t.quad 0     # a 32-bit reference count per pool page, after them\n");
  w_s(&mut out, "bst_rt_carved_lo:\t.quad 0       # the RAM carved off for the counters and the arena's extension\n");
  w_s(&mut out, "bst_rt_carved_hi:\t.quad 0\n");
  w_s(&mut out, "bst_rt_arena2:\t.quad 0          # the arena's extension: an eighth of the pool, at least 4 MiB\n");
  w_s(&mut out, "bst_rt_arena2_words:\t.quad 0\n");
  w_s(&mut out, "bst_rt_arena2_top:\t.quad 0\n");
  w_s(&mut out, "bst_rt_arena_lock:\t.quad 0\n");
  w_s(&mut out, "bst_rt_arena_top:\t.quad 0\n");
  w_s(&mut out, "bst_rt_free_list:\t.quad 0\n");
  w_s(&mut out, "bst_rt_arena:\t.zero 8388608\n");
  w_s(&mut out, "\t.section .rodata\n");
  w_s(&mut out, ".Lrt_oom:\n");
  w_s(&mut out, "\t.string \"bastio: out of memory\\n\"\n");
  w_s(&mut out, ".Lrt_mmio_ram:\n");
  w_s(&mut out, "\t.string \"bastio: mmio_claim of RAM at \"\n");
  w_s(&mut out, ".Lrt_fault:\n");
  w_s(&mut out, "\t.string \"\\nbastio: kernel fault, vector \"\n");
  w_s(&mut out, ".Lrt_rip:\n");
  w_s(&mut out, "\t.string \" rip \"\n");
  w_s(&mut out, ".Lrt_cr2:\n");
  w_s(&mut out, "\t.string \" cr2 \"\n");
  w_s(&mut out, ".Lrt_err:\n");
  w_s(&mut out, "\t.string \" err \"\n");
  w_s(&mut out, ".Lrt_0x:\n");
  w_s(&mut out, "\t.string \"0x\"\n");
  w_s(&mut out, ".Lrt_hex:\n");
  w_s(&mut out, "\t.string \"0123456789abcdef\"\n");
  w_s(&mut out, "\t.text\n");
}
