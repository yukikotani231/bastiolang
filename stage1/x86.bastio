/// The runtime of the native backend for BastiOS user programs: the
/// C prelude's user part (`cg_prelude_user`) in assembly over the kernel's
/// system calls (`int $0x80`), with no C library. Part of the trusted base.
fn x86_runtime_user(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "# ---- runtime: BastiOS user programs (trusted base) ----\n");
  cg_s(&mut out, "bst_rt_sys:                     # system call %rax with %rdi, %rsi, %rdx: %rax = its result\n");
  cg_s(&mut out, "\tint $0x80\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_fsys:                    # the same, after the console output so far\n");
  cg_s(&mut out, "\tpush %rax\n");
  cg_s(&mut out, "\tpush %rdi\n");
  cg_s(&mut out, "\tpush %rsi\n");
  cg_s(&mut out, "\tpush %rdx\n");
  cg_s(&mut out, "\tcall bst_rt_flush\n");
  cg_s(&mut out, "\tpop %rdx\n");
  cg_s(&mut out, "\tpop %rsi\n");
  cg_s(&mut out, "\tpop %rdi\n");
  cg_s(&mut out, "\tpop %rax\n");
  cg_s(&mut out, "\tint $0x80\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_flush:                   # write out the console buffer\n");
  cg_s(&mut out, "\tmov bst_rt_out_n(%rip), %rsi\n");
  cg_s(&mut out, "\ttest %rsi, %rsi\n");
  cg_s(&mut out, "\tjz 1f\n");
  cg_s(&mut out, "\tmov $1, %eax                # SYS_WRITE\n");
  cg_s(&mut out, "\tlea bst_rt_out(%rip), %rdi\n");
  cg_s(&mut out, "\txor %edx, %edx\n");
  cg_s(&mut out, "\tint $0x80\n");
  cg_s(&mut out, "\tmovq $0, bst_rt_out_n(%rip)\n");
  cg_s(&mut out, "1:\tret\n");
  cg_s(&mut out, "bst_rt_putc:                    # write byte %rdi to the console; flush at a newline or when full\n");
  cg_s(&mut out, "\tmov bst_rt_out_n(%rip), %rax\n");
  cg_s(&mut out, "\tlea bst_rt_out(%rip), %rcx\n");
  cg_s(&mut out, "\tmov %dil, (%rcx,%rax)\n");
  cg_s(&mut out, "\tinc %rax\n");
  cg_s(&mut out, "\tmov %rax, bst_rt_out_n(%rip)\n");
  cg_s(&mut out, "\tcmp $10, %dil\n");
  cg_s(&mut out, "\tje bst_rt_flush\n");
  cg_s(&mut out, "\tcmp $256, %rax\n");
  cg_s(&mut out, "\tje bst_rt_flush\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_print:                   # print(%rdi) as a decimal line\n");
  cg_s(&mut out, "\tpush %rbp\n");
  cg_s(&mut out, "\tmov %rsp, %rbp\n");
  cg_s(&mut out, "\tpush %r12\n");
  cg_s(&mut out, "\tsub $24, %rsp\n");
  cg_s(&mut out, "\tmov %rdi, %rax\n");
  cg_s(&mut out, "\txor %r12d, %r12d            # digits, last first\n");
  cg_s(&mut out, "\tmov $10, %ecx\n");
  cg_s(&mut out, "1:\txor %edx, %edx\n");
  cg_s(&mut out, "\tdiv %rcx\n");
  cg_s(&mut out, "\tadd $48, %edx\n");
  cg_s(&mut out, "\tmov %dl, (%rsp,%r12)\n");
  cg_s(&mut out, "\tinc %r12\n");
  cg_s(&mut out, "\ttest %rax, %rax\n");
  cg_s(&mut out, "\tjnz 1b\n");
  cg_s(&mut out, "2:\tdec %r12\n");
  cg_s(&mut out, "\tmovzbl (%rsp,%r12), %edi\n");
  cg_s(&mut out, "\tcall bst_rt_putc\n");
  cg_s(&mut out, "\ttest %r12, %r12\n");
  cg_s(&mut out, "\tjnz 2b\n");
  cg_s(&mut out, "\tmov $10, %edi\n");
  cg_s(&mut out, "\tcall bst_rt_putc\n");
  cg_s(&mut out, "\tmov -8(%rbp), %r12\n");
  cg_s(&mut out, "\tleave\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_getc:                    # %rax = the next byte of console input\n");
  cg_s(&mut out, "\tcall bst_rt_flush\n");
  cg_s(&mut out, "\tmov $2, %eax                # SYS_READ\n");
  cg_s(&mut out, "\txor %edi, %edi\n");
  cg_s(&mut out, "\txor %esi, %esi\n");
  cg_s(&mut out, "\txor %edx, %edx\n");
  cg_s(&mut out, "\tint $0x80\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_try_balloc:              # as bst_rt_balloc, but %rax = 0 when out of memory\n");
  cg_s(&mut out, "\tadd $7, %rdi\n");
  cg_s(&mut out, "\tshr $3, %rdi\n");
  cg_s(&mut out, "bst_rt_try_alloc:\n");
  cg_s(&mut out, "\tmov $1, %r8d\n");
  cg_s(&mut out, "\tjmp 0f\n");
  cg_s(&mut out, "bst_rt_balloc:                  # %rax = %rdi zeroed bytes (at least one)\n");
  cg_s(&mut out, "\tadd $7, %rdi\n");
  cg_s(&mut out, "\tshr $3, %rdi\n");
  cg_s(&mut out, "bst_rt_alloc:                   # %rax = %rdi zeroed words (at least one), after a header word\n");
  cg_s(&mut out, "\txor %r8d, %r8d             # out of memory stops the program\n");
  cg_s(&mut out, "0:\ttest %rdi, %rdi\n");
  cg_s(&mut out, "\tjnz 1f\n");
  cg_s(&mut out, "\tmov $1, %edi\n");
  cg_s(&mut out, "1:\tadd $1, %rdi                # the block's words, header included\n");
  cg_s(&mut out, "\tjc 6f\n");
  cg_s(&mut out, "\tlea bst_rt_free_list(%rip), %rdx\n");
  cg_s(&mut out, "2:\tmov (%rdx), %rax            # a free block of exactly that size first\n");
  cg_s(&mut out, "\ttest %rax, %rax\n");
  cg_s(&mut out, "\tjz 4f\n");
  cg_s(&mut out, "\tcmp (%rax), %rdi\n");
  cg_s(&mut out, "\tje 3f\n");
  cg_s(&mut out, "\tlea 8(%rax), %rdx\n");
  cg_s(&mut out, "\tjmp 2b\n");
  cg_s(&mut out, "3:\tmov 8(%rax), %rcx\n");
  cg_s(&mut out, "\tmov %rcx, (%rdx)\n");
  cg_s(&mut out, "\tjmp 5f\n");
  cg_s(&mut out, "4:\tmov bst_rt_arena_top(%rip), %rax\n");
  cg_s(&mut out, "\tmov $8192, %ecx             # the arena's words\n");
  cg_s(&mut out, "\tsub %rax, %rcx\n");
  cg_s(&mut out, "\tcmp %rcx, %rdi\n");
  cg_s(&mut out, "\tja 6f\n");
  cg_s(&mut out, "\tlea (%rax,%rdi), %rcx\n");
  cg_s(&mut out, "\tmov %rcx, bst_rt_arena_top(%rip)\n");
  cg_s(&mut out, "\tlea bst_rt_arena(%rip), %rcx\n");
  cg_s(&mut out, "\tlea (%rcx,%rax,8), %rax\n");
  cg_s(&mut out, "\tmov %rdi, (%rax)\n");
  cg_s(&mut out, "5:\tlea 8(%rax), %rdx\n");
  cg_s(&mut out, "\tlea -1(%rdi), %rcx\n");
  cg_s(&mut out, "\tmov %rdx, %rdi\n");
  cg_s(&mut out, "\txor %eax, %eax\n");
  cg_s(&mut out, "\trep stosq\n");
  cg_s(&mut out, "\tmov %rdx, %rax\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "6:\ttest %r8d, %r8d\n");
  cg_s(&mut out, "\tjz bst_rt_oom\n");
  cg_s(&mut out, "\txor %eax, %eax\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_free:                    # give the block at %rdi back to the free list (0: none)\n");
  cg_s(&mut out, "\ttest %rdi, %rdi\n");
  cg_s(&mut out, "\tjz 1f\n");
  cg_s(&mut out, "\tmov bst_rt_free_list(%rip), %rax\n");
  cg_s(&mut out, "\tmov %rax, (%rdi)\n");
  cg_s(&mut out, "\tsub $8, %rdi\n");
  cg_s(&mut out, "\tmov %rdi, bst_rt_free_list(%rip)\n");
  cg_s(&mut out, "1:\tret\n");
  cg_s(&mut out, "bst_rt_vec_grow:                # grow the Vec at (%rdi), elements of %rsi bytes\n");
  cg_s(&mut out, "\tpush %rbp\n");
  cg_s(&mut out, "\tmov %rsp, %rbp\n");
  cg_s(&mut out, "\tpush %rbx\n");
  cg_s(&mut out, "\tpush %r12\n");
  cg_s(&mut out, "\tpush %r13\n");
  cg_s(&mut out, "\tpush %r14\n");
  cg_s(&mut out, "\tmov %rdi, %rbx\n");
  cg_s(&mut out, "\tmov %rsi, %r13\n");
  cg_s(&mut out, "\tmov 8(%rbx), %rax           # the old words\n");
  cg_s(&mut out, "\tmul %rsi\n");
  cg_s(&mut out, "\tadd $7, %rax\n");
  cg_s(&mut out, "\tshr $3, %rax\n");
  cg_s(&mut out, "\tmov %rax, %r14\n");
  cg_s(&mut out, "\tmov 8(%rbx), %r12           # new capacity: double, or 4 when empty\n");
  cg_s(&mut out, "\tadd %r12, %r12\n");
  cg_s(&mut out, "\tjnz 1f\n");
  cg_s(&mut out, "\tmov $4, %r12d\n");
  cg_s(&mut out, "1:\tmov %r12, %rax\n");
  cg_s(&mut out, "\tmul %r13                    # bytes; past 64 bits the request cannot be met\n");
  cg_s(&mut out, "\tjo bst_rt_oom\n");
  cg_s(&mut out, "\tmov %rax, %rdi\n");
  cg_s(&mut out, "\tadd $7, %rdi\n");
  cg_s(&mut out, "\tjc bst_rt_oom\n");
  cg_s(&mut out, "\tshr $3, %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_alloc\n");
  cg_s(&mut out, "\tmov %rax, %r13\n");
  cg_s(&mut out, "\tmov 16(%rbx), %rsi\n");
  cg_s(&mut out, "\ttest %rsi, %rsi\n");
  cg_s(&mut out, "\tjz 2f\n");
  cg_s(&mut out, "\tmov %rax, %rdi\n");
  cg_s(&mut out, "\tmov %r14, %rcx\n");
  cg_s(&mut out, "\trep movsq\n");
  cg_s(&mut out, "\tmov 16(%rbx), %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_free\n");
  cg_s(&mut out, "2:\tmov %r13, 16(%rbx)\n");
  cg_s(&mut out, "\tmov %r12, 8(%rbx)\n");
  cg_s(&mut out, "\tmov -8(%rbp), %rbx\n");
  cg_s(&mut out, "\tmov -16(%rbp), %r12\n");
  cg_s(&mut out, "\tmov -24(%rbp), %r13\n");
  cg_s(&mut out, "\tmov -32(%rbp), %r14\n");
  cg_s(&mut out, "\tleave\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_vec_try_reserve:         # room for %rsi more elements of %rdx bytes in the Vec at (%rdi): %eax = 1, or 0 and unchanged\n");
  cg_s(&mut out, "\tmov 8(%rdi), %rax\n");
  cg_s(&mut out, "\tsub (%rdi), %rax\n");
  cg_s(&mut out, "\tcmp %rsi, %rax\n");
  cg_s(&mut out, "\tjb 1f\n");
  cg_s(&mut out, "\tmov $1, %eax\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "1:\tpush %rbp\n");
  cg_s(&mut out, "\tmov %rsp, %rbp\n");
  cg_s(&mut out, "\tpush %rbx\n");
  cg_s(&mut out, "\tpush %r12\n");
  cg_s(&mut out, "\tpush %r13\n");
  cg_s(&mut out, "\tpush %r14\n");
  cg_s(&mut out, "\tmov %rdi, %rbx\n");
  cg_s(&mut out, "\tmov %rdx, %r13\n");
  cg_s(&mut out, "\tmov $1, %eax                # lim = 2^60 / size: the capacity stays at most 2^60\n");
  cg_s(&mut out, "\tshl $60, %rax\n");
  cg_s(&mut out, "\txor %edx, %edx\n");
  cg_s(&mut out, "\tdiv %r13\n");
  cg_s(&mut out, "\tmov (%rbx), %rcx\n");
  cg_s(&mut out, "\tcmp %rax, %rcx\n");
  cg_s(&mut out, "\tja 3f\n");
  cg_s(&mut out, "\tmov %rax, %r8\n");
  cg_s(&mut out, "\tsub %rcx, %r8\n");
  cg_s(&mut out, "\tcmp %r8, %rsi\n");
  cg_s(&mut out, "\tja 3f\n");
  cg_s(&mut out, "\tlea (%rcx,%rsi), %r12       # new capacity: len + k, or double when that is more and fits\n");
  cg_s(&mut out, "\tmov 8(%rbx), %rdx\n");
  cg_s(&mut out, "\tshr $1, %rax\n");
  cg_s(&mut out, "\tcmp %rax, %rdx\n");
  cg_s(&mut out, "\tja 2f\n");
  cg_s(&mut out, "\tadd %rdx, %rdx\n");
  cg_s(&mut out, "\tcmp %r12, %rdx\n");
  cg_s(&mut out, "\tjbe 2f\n");
  cg_s(&mut out, "\tmov %rdx, %r12\n");
  cg_s(&mut out, "2:\tmov 8(%rbx), %rax           # the old words\n");
  cg_s(&mut out, "\tmul %r13\n");
  cg_s(&mut out, "\tadd $7, %rax\n");
  cg_s(&mut out, "\tshr $3, %rax\n");
  cg_s(&mut out, "\tmov %rax, %r14\n");
  cg_s(&mut out, "\tmov %r12, %rax              # the new words\n");
  cg_s(&mut out, "\tmul %r13\n");
  cg_s(&mut out, "\tadd $7, %rax\n");
  cg_s(&mut out, "\tshr $3, %rax\n");
  cg_s(&mut out, "\tmov %rax, %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_try_alloc\n");
  cg_s(&mut out, "\ttest %rax, %rax\n");
  cg_s(&mut out, "\tjz 3f\n");
  cg_s(&mut out, "\tmov %rax, %r13\n");
  cg_s(&mut out, "\tmov 16(%rbx), %rsi\n");
  cg_s(&mut out, "\ttest %rsi, %rsi\n");
  cg_s(&mut out, "\tjz 4f\n");
  cg_s(&mut out, "\tmov %rax, %rdi\n");
  cg_s(&mut out, "\tmov %r14, %rcx\n");
  cg_s(&mut out, "\trep movsq\n");
  cg_s(&mut out, "\tmov 16(%rbx), %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_free\n");
  cg_s(&mut out, "4:\tmov %r13, 16(%rbx)\n");
  cg_s(&mut out, "\tmov %r12, 8(%rbx)\n");
  cg_s(&mut out, "\tmov $1, %eax\n");
  cg_s(&mut out, "\tjmp 5f\n");
  cg_s(&mut out, "3:\txor %eax, %eax\n");
  cg_s(&mut out, "5:\tmov -8(%rbp), %rbx\n");
  cg_s(&mut out, "\tmov -16(%rbp), %r12\n");
  cg_s(&mut out, "\tmov -24(%rbp), %r13\n");
  cg_s(&mut out, "\tmov -32(%rbp), %r14\n");
  cg_s(&mut out, "\tleave\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_bfrom:                   # Bytes copied from the %rdi bytes at %rsi: %rax = data, %rdx = len\n");
  cg_s(&mut out, "\tpush %rbp\n");
  cg_s(&mut out, "\tmov %rsp, %rbp\n");
  cg_s(&mut out, "\tpush %rbx\n");
  cg_s(&mut out, "\tpush %r12\n");
  cg_s(&mut out, "\tmov %rdi, %rbx\n");
  cg_s(&mut out, "\tmov %rsi, %r12\n");
  cg_s(&mut out, "\tcall bst_rt_balloc\n");
  cg_s(&mut out, "\tmov %rax, %rdi\n");
  cg_s(&mut out, "\tmov %r12, %rsi\n");
  cg_s(&mut out, "\tmov %rbx, %rcx\n");
  cg_s(&mut out, "\trep movsb\n");
  cg_s(&mut out, "\tmov %rbx, %rdx\n");
  cg_s(&mut out, "\tmov -8(%rbp), %rbx\n");
  cg_s(&mut out, "\tmov -16(%rbp), %r12\n");
  cg_s(&mut out, "\tleave\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_sys_spawn:               # start the program named by words %rsi..%rdx of the Buf data at %rdi\n");
  cg_s(&mut out, "\tpush %rbp\n");
  cg_s(&mut out, "\tmov %rsp, %rbp\n");
  cg_s(&mut out, "\tsub $64, %rsp\n");
  cg_s(&mut out, "\txor %ecx, %ecx              # the name's bytes, at most 64\n");
  cg_s(&mut out, "1:\tcmp %rdx, %rsi\n");
  cg_s(&mut out, "\tjae 2f\n");
  cg_s(&mut out, "\tcmp $64, %rcx\n");
  cg_s(&mut out, "\tjae 2f\n");
  cg_s(&mut out, "\tmov (%rdi,%rsi,8), %rax\n");
  cg_s(&mut out, "\tmov %al, (%rsp,%rcx)\n");
  cg_s(&mut out, "\tinc %rcx\n");
  cg_s(&mut out, "\tinc %rsi\n");
  cg_s(&mut out, "\tjmp 1b\n");
  cg_s(&mut out, "2:\tmov $3, %eax                # SYS_SPAWN\n");
  cg_s(&mut out, "\tmov %rsp, %rdi\n");
  cg_s(&mut out, "\tmov %rcx, %rsi\n");
  cg_s(&mut out, "\txor %edx, %edx\n");
  cg_s(&mut out, "\tint $0x80\n");
  cg_s(&mut out, "\tleave\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_oom:\n");
  cg_s(&mut out, "\tcall bst_rt_flush\n");
  cg_s(&mut out, "\tmov $1, %eax\n");
  cg_s(&mut out, "\tlea .Lrt_oom(%rip), %rdi\n");
  cg_s(&mut out, "\tmov $22, %esi\n");
  cg_s(&mut out, "\txor %edx, %edx\n");
  cg_s(&mut out, "\tint $0x80\n");
  cg_s(&mut out, "\txor %eax, %eax              # SYS_EXIT\n");
  cg_s(&mut out, "\tmov $255, %edi\n");
  cg_s(&mut out, "\tint $0x80\n");
  cg_s(&mut out, "\tud2\n");
  cg_s(&mut out, "\t.bss\n");
  cg_s(&mut out, "\t.p2align 3\n");
  cg_s(&mut out, "bst_rt_out_n:\t.quad 0\n");
  cg_s(&mut out, "bst_rt_arena_top:\t.quad 0\n");
  cg_s(&mut out, "bst_rt_free_list:\t.quad 0\n");
  cg_s(&mut out, "bst_rt_out:\t.zero 256\n");
  cg_s(&mut out, "bst_rt_arena:\t.zero 65536\n");
  cg_s(&mut out, "\t.section .rodata\n");
  cg_s(&mut out, ".Lrt_oom:\n");
  cg_s(&mut out, "\t.string \"bastio: out of memory\\n\"\n");
  cg_s(&mut out, "\t.text\n");
}

/// The runtime of the native backend for a BastiOS kernel: the C prelude's
/// `kernel`, `kernel_cpu` and `bytes_arena` parts in assembly (COM1, the
/// 8 MiB arena, the page pool from the Multiboot information, the fault
/// report), calling the platform's C only where the C prelude does. Part of
/// the trusted base.
fn x86_runtime_kernel(out: &mut Vec[u64]) {
  cg_s(&mut out, "\n");
  cg_s(&mut out, "# ---- runtime: BastiOS kernel (trusted base) ----\n");
  cg_s(&mut out, "bst_rt_putc:                    # write byte %rdi to COM1, waiting for room\n");
  cg_s(&mut out, "\tmov $0x3FD, %edx\n");
  cg_s(&mut out, "1:\tinb %dx, %al\n");
  cg_s(&mut out, "\ttest $0x20, %al\n");
  cg_s(&mut out, "\tjz 1b\n");
  cg_s(&mut out, "\tmov %edi, %eax\n");
  cg_s(&mut out, "\tmov $0x3F8, %edx\n");
  cg_s(&mut out, "\toutb %al, %dx\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_getc:                    # %rax = the next byte from COM1 (waits for one)\n");
  cg_s(&mut out, "\tmov $0x3FD, %edx\n");
  cg_s(&mut out, "1:\tinb %dx, %al\n");
  cg_s(&mut out, "\ttest $1, %al\n");
  cg_s(&mut out, "\tjnz 2f\n");
  cg_s(&mut out, "\tpause\n");
  cg_s(&mut out, "\tjmp 1b\n");
  cg_s(&mut out, "2:\tmov $0x3F8, %edx\n");
  cg_s(&mut out, "\tinb %dx, %al\n");
  cg_s(&mut out, "\tmovzbl %al, %eax\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_poll:                    # %rax = a byte from COM1, or 256 when none is waiting\n");
  cg_s(&mut out, "\tmov $0x3FD, %edx\n");
  cg_s(&mut out, "\tinb %dx, %al\n");
  cg_s(&mut out, "\ttest $1, %al\n");
  cg_s(&mut out, "\tjz 1f\n");
  cg_s(&mut out, "\tmov $0x3F8, %edx\n");
  cg_s(&mut out, "\tinb %dx, %al\n");
  cg_s(&mut out, "\tmovzbl %al, %eax\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "1:\tmov $256, %eax\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_serial_init:             # COM1: 115200 baud, 8N1, FIFO on, interrupt on received data\n");
  cg_s(&mut out, "\tmov $0x3F9, %edx\n");
  cg_s(&mut out, "\tmov $0x00, %al              # interrupts off while configuring\n");
  cg_s(&mut out, "\toutb %al, %dx\n");
  cg_s(&mut out, "\tmov $0x3FB, %edx\n");
  cg_s(&mut out, "\tmov $0x80, %al              # DLAB on\n");
  cg_s(&mut out, "\toutb %al, %dx\n");
  cg_s(&mut out, "\tmov $0x3F8, %edx\n");
  cg_s(&mut out, "\tmov $0x01, %al              # 115200 baud\n");
  cg_s(&mut out, "\toutb %al, %dx\n");
  cg_s(&mut out, "\tmov $0x3F9, %edx\n");
  cg_s(&mut out, "\tmov $0x00, %al\n");
  cg_s(&mut out, "\toutb %al, %dx\n");
  cg_s(&mut out, "\tmov $0x3FB, %edx\n");
  cg_s(&mut out, "\tmov $0x03, %al              # 8N1\n");
  cg_s(&mut out, "\toutb %al, %dx\n");
  cg_s(&mut out, "\tmov $0x3FA, %edx\n");
  cg_s(&mut out, "\tmov $0xC7, %al              # FIFO on\n");
  cg_s(&mut out, "\toutb %al, %dx\n");
  cg_s(&mut out, "\tmov $0x3FC, %edx\n");
  cg_s(&mut out, "\tmov $0x0B, %al              # DTR, RTS, OUT2 (routes the IRQ line)\n");
  cg_s(&mut out, "\toutb %al, %dx\n");
  cg_s(&mut out, "\tmov $0x3F9, %edx\n");
  cg_s(&mut out, "\tmov $0x01, %al              # interrupt on received data\n");
  cg_s(&mut out, "\toutb %al, %dx\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_print:                   # print(%rdi) as a decimal line\n");
  cg_s(&mut out, "\tpush %rbp\n");
  cg_s(&mut out, "\tmov %rsp, %rbp\n");
  cg_s(&mut out, "\tpush %r12\n");
  cg_s(&mut out, "\tsub $24, %rsp\n");
  cg_s(&mut out, "\tmov %rdi, %rax\n");
  cg_s(&mut out, "\txor %r12d, %r12d            # digits, last first\n");
  cg_s(&mut out, "\tmov $10, %ecx\n");
  cg_s(&mut out, "1:\txor %edx, %edx\n");
  cg_s(&mut out, "\tdiv %rcx\n");
  cg_s(&mut out, "\tadd $48, %edx\n");
  cg_s(&mut out, "\tmov %dl, (%rsp,%r12)\n");
  cg_s(&mut out, "\tinc %r12\n");
  cg_s(&mut out, "\ttest %rax, %rax\n");
  cg_s(&mut out, "\tjnz 1b\n");
  cg_s(&mut out, "2:\tdec %r12\n");
  cg_s(&mut out, "\tmovzbl (%rsp,%r12), %edi\n");
  cg_s(&mut out, "\tcall bst_rt_putc\n");
  cg_s(&mut out, "\ttest %r12, %r12\n");
  cg_s(&mut out, "\tjnz 2b\n");
  cg_s(&mut out, "\tmov $10, %edi\n");
  cg_s(&mut out, "\tcall bst_rt_putc\n");
  cg_s(&mut out, "\tmov -8(%rbp), %r12\n");
  cg_s(&mut out, "\tleave\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_puts:                    # write the NUL-terminated string at %rdi to COM1\n");
  cg_s(&mut out, "\tpush %rbx\n");
  cg_s(&mut out, "\tmov %rdi, %rbx\n");
  cg_s(&mut out, "1:\tmovzbl (%rbx), %edi\n");
  cg_s(&mut out, "\ttest %edi, %edi\n");
  cg_s(&mut out, "\tjz 2f\n");
  cg_s(&mut out, "\tcall bst_rt_putc\n");
  cg_s(&mut out, "\tinc %rbx\n");
  cg_s(&mut out, "\tjmp 1b\n");
  cg_s(&mut out, "2:\tpop %rbx\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_puthex:                  # write %rdi to COM1 as 0x and 16 hex digits\n");
  cg_s(&mut out, "\tpush %rbx\n");
  cg_s(&mut out, "\tpush %r12\n");
  cg_s(&mut out, "\tmov %rdi, %rbx\n");
  cg_s(&mut out, "\tlea .Lrt_0x(%rip), %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_puts\n");
  cg_s(&mut out, "\tmov $60, %r12d\n");
  cg_s(&mut out, "1:\tmov %rbx, %rax\n");
  cg_s(&mut out, "\tmov %r12d, %ecx\n");
  cg_s(&mut out, "\tshr %cl, %rax\n");
  cg_s(&mut out, "\tand $15, %eax\n");
  cg_s(&mut out, "\tlea .Lrt_hex(%rip), %rdx\n");
  cg_s(&mut out, "\tmovzbl (%rdx,%rax), %edi\n");
  cg_s(&mut out, "\tcall bst_rt_putc\n");
  cg_s(&mut out, "\tsub $4, %r12d\n");
  cg_s(&mut out, "\tjns 1b\n");
  cg_s(&mut out, "\tpop %r12\n");
  cg_s(&mut out, "\tpop %rbx\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_halt:\n");
  cg_s(&mut out, "\tcli\n");
  cg_s(&mut out, "\thlt\n");
  cg_s(&mut out, "\tjmp bst_rt_halt\n");
  cg_s(&mut out, "\t.globl bst_kernel_fault\n");
  cg_s(&mut out, "bst_kernel_fault:               # called by the platform on a fault in kernel mode (C calling convention)\n");
  cg_s(&mut out, "\tmov %rdi, %r12\n");
  cg_s(&mut out, "\tmov %rsi, %r13\n");
  cg_s(&mut out, "\tmov %rdx, %r14\n");
  cg_s(&mut out, "\tmov %rcx, %r15\n");
  cg_s(&mut out, "\tlea .Lrt_fault(%rip), %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_puts\n");
  cg_s(&mut out, "\tmov %r12, %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_puthex\n");
  cg_s(&mut out, "\tlea .Lrt_rip(%rip), %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_puts\n");
  cg_s(&mut out, "\tmov %r13, %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_puthex\n");
  cg_s(&mut out, "\tlea .Lrt_cr2(%rip), %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_puts\n");
  cg_s(&mut out, "\tmov %r14, %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_puthex\n");
  cg_s(&mut out, "\tlea .Lrt_err(%rip), %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_puts\n");
  cg_s(&mut out, "\tmov %r15, %rdi\n");
  cg_s(&mut out, "\tcall bst_rt_puthex\n");
  cg_s(&mut out, "\tmov $10, %edi\n");
