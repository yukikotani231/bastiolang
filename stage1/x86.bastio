  cg_s(&mut out, "4:\tcmp $0x7f, %ecx\n");
  cg_s(&mut out, "\tje 5f\n");
  cg_s(&mut out, "\tlea 128(%rcx), %eax         # killed by a signal: 128 + the signal\n");
  cg_s(&mut out, "\tjmp 9f\n");
  cg_s(&mut out, "5:\tmov $255, %eax\n");
  cg_s(&mut out, "9:\tmov -8(%rbp), %rbx\n");
  cg_s(&mut out, "\tmov -16(%rbp), %r12\n");
