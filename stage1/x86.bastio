  cg_s(&mut out, "\tje 4f\n");
  cg_s(&mut out, "\tmov %al, (%r13,%r15)\n");
  cg_s(&mut out, "\tinc %r15\n");
  cg_s(&mut out, "\tjmp 1b\n");
