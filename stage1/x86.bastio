  w_s(&mut out, "\tmovslq -52(%rbp), %rdi\n");
  w_s(&mut out, "\tcall close@PLT\n");
  w_s(&mut out, "\tjmp 9f\n");
  w_s(&mut out, "1:\tmovslq -52(%rbp), %rdi      # the parent's ends are not inherited by later children,\n");
  w_s(&mut out, "\tmov $2, %esi                # so closing a child's input reaches it as end of file\n");
  w_s(&mut out, "\tmov $1, %edx                # (F_SETFD, FD_CLOEXEC)\n");
  w_s(&mut out, "\txor %eax, %eax\n");
  w_s(&mut out, "\tcall fcntl@PLT\n");
  w_s(&mut out, "\tmovslq -64(%rbp), %rdi\n");
  w_s(&mut out, "\tmov $2, %esi\n");
  w_s(&mut out, "\tmov $1, %edx\n");
