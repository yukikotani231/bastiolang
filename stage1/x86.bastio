  cg_s(&mut out, "\tmov $1, %eax\n");
  cg_s(&mut out, "\tjmp 9f\n");
  cg_s(&mut out, "8:\txor %eax, %eax\n");
  cg_s(&mut out, "9:\tmov -8(%rbp), %rbx\n");
  cg_s(&mut out, "\tmov -16(%rbp), %r12\n");
  cg_s(&mut out, "\tmov -24(%rbp), %r13\n");
  cg_s(&mut out, "\tmov -32(%rbp), %r14\n");
  cg_s(&mut out, "\tmov -40(%rbp), %r15\n");
  cg_s(&mut out, "\tleave\n");
  cg_s(&mut out, "\tret\n");
  cg_s(&mut out, "bst_rt_child_wait:              # wait for the Child %rdx (pid), %rsi (input), %rdi (output): %rax = its exit status\n");
