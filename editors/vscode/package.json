{
  "name": "bastio",
  "displayName": "Bastio",
  "description": "Syntax highlighting and compiler diagnostics for the Bastio language",
  "version": "0.1.0",
  "publisher": "bastio",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yukikotani231/bastiolang",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:bastio"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "bastio",
        "aliases": [
          "Bastio",
          "bastio"
        ],
        "extensions": [
          ".bastio"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bastio",
        "scopeName": "source.bastio",
        "path": "./syntaxes/bastio.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Bastio",
      "properties": {
        "bastio.compiler.path": {
          "type": "string",
          "default": "bastioc0",
          "description": "The stage0 compiler, bastioc0. A relative path is resolved against the workspace folder."
        },
        "bastio.compiler.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--check"
          ],
          "description": "Arguments given to the compiler before the file name, for example [\"--check\", \"--target\", \"kernel\"]."
        },
        "bastio.compiler.entry": {
          "type": "string",
          "default": "",
          "description": "A file to check instead of the one saved, such as the program's main file (which pulls the others in through `import`). A relative path is resolved against the workspace folder. Empty: check the saved file."
        },
        "bastio.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run the compiler when a .bastio file is saved and show its error in the editor."
        }
      }
    },
    "commands": [
      {
        "command": "bastio.check",
        "title": "Bastio: Check This File"
      }
    ]
  },
  "scripts": {
    "test": "node test/tokenize_all.js"
  },
  "devDependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  }
}
