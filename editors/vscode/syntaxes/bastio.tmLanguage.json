{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bastio",
  "scopeName": "source.bastio",
  "fileTypes": [
    "bastio"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#variants"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.bastio"
    },
    "strings": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.bastio"
        }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.bastio"
        }
      },
      "name": "string.quoted.double.bastio",
      "patterns": [
        {
          "match": "\\\\[nrt0\\\\\"]",
          "name": "constant.character.escape.bastio"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.bastio"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b",
          "name": "constant.numeric.hex.bastio"
        },
        {
          "match": "\\b[0-9][0-9_]*\\b",
          "name": "constant.numeric.decimal.bastio"
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "\\b(spec)\\s+(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.spec.bastio"
            },
            "2": {
              "name": "keyword.declaration.function.bastio"
            },
            "3": {
              "name": "entity.name.function.bastio"
            }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.bastio"
            },
            "2": {
              "name": "entity.name.function.bastio"
            }
          }
        },
        {
          "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.bastio"
            },
            "2": {
              "name": "entity.name.type.bastio"
            }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.constant.bastio"
            },
            "2": {
              "name": "variable.other.constant.bastio"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|else|while|match|return|unreachable)\\b",
          "name": "keyword.control.bastio"
        },
        {
          "match": "\\b(requires|ensures|invariant|assert|forall)\\b",
          "name": "keyword.other.proof.bastio"
        },
        {
          "match": "\\b(import)\\b",
          "name": "keyword.control.import.bastio"
        },
        {
          "match": "\\b(let|fn|export|spec|struct|enum|const)\\b",
          "name": "keyword.declaration.bastio"
        },
        {
          "match": "\\b(mut)\\b",
          "name": "storage.modifier.mut.bastio"
        },
        {
          "match": "\\b(is)\\b",
          "name": "keyword.operator.is.bastio"
        }
      ]
    },
    "variants": {
      "comment": "`Enum::Variant`, also with type arguments (`Opt[u64]::Some`). No spaces around `::`, which tells it apart from `forall i: u64 :: body`.",
      "patterns": [
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=(?:\\[[^;{}()\\n]*\\])?::[A-Za-z_])",
          "name": "entity.name.type.bastio"
        },
        {
          "match": "(?<=[A-Za-z0-9_\\]])(::)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.path.bastio"
            },
            "2": {
              "name": "entity.name.tag.variant.bastio"
            }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b(old|include_bytes)\\s*(?=\\()",
          "name": "support.function.builtin.bastio"
        },
        {
          "comment": "A call, possibly with type arguments: `f(..)`, `vec_new[u64](..)`.",
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\(|\\[)",
          "name": "entity.name.function.call.bastio"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(u64|u32|u16|u8|i64|i32|i16|i8|bool|Str|Buf|Bytes|Host|Child|Serial|Frame|PageTable|Pool|Mmu|Cpu|Vec|Box)\\b",
          "name": "support.type.builtin.bastio"
        },
        {
          "match": "\\b[A-Z][A-Z0-9_]+\\b",
          "name": "variable.other.constant.bastio"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.bastio"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.bastio"
        },
        {
          "match": "\\b(result)\\b",
          "name": "variable.language.result.bastio"
        },
        {
          "match": "\\b_\\b",
          "name": "variable.language.wildcard.bastio"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "==>",
          "name": "keyword.operator.logical.implies.bastio"
        },
        {
          "match": "=>",
          "name": "keyword.operator.arrow.fat.bastio"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.bastio"
        },
        {
          "match": "==|!=|<=|>=|<|>",
          "name": "keyword.operator.comparison.bastio"
        },
        {
          "match": "&&|\\|\\||!",
          "name": "keyword.operator.logical.bastio"
        },
        {
          "match": "&",
          "name": "keyword.operator.borrow.bastio"
        },
        {
          "match": "[-+*/%]",
          "name": "keyword.operator.arithmetic.bastio"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.bastio"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "::",
          "name": "punctuation.separator.path.bastio"
        },
        {
          "match": "[,;]",
          "name": "punctuation.separator.bastio"
        },
        {
          "match": ":",
          "name": "punctuation.separator.type.bastio"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.bastio"
        },
        {
          "match": "[{}]",
          "name": "punctuation.bracket.curly.bastio"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.bracket.square.bastio"
        },
        {
          "match": "[()]",
          "name": "punctuation.bracket.round.bastio"
        }
      ]
    }
  }
}
