// The smallest useful program: squares 1..5, printed, proved free of
// overflow and out-of-bounds access.

fn main() -> u64 {
  let mut b = alloc(5);
  let mut i = 0;
  while i < len(b)
    invariant i <= len(b)
  {
    b = set(b, i, (i + 1) * (i + 1));
    i = i + 1;
  }
  let mut j = 0;
  while j < len(b)
    invariant j <= len(b)
  {
    print(get(b, j));
    j = j + 1;
  }
  free(b);
  return 0;
}
