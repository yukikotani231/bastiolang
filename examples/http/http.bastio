// HTTP/1.1 request head parser (RFC 9112, sections 3 to 5), strict: the
// request line and header fields of a message that arrives from a socket,
// where a length or a delimiter read without care sends a parser past its
// buffer or lets a request be read two ways (request smuggling).
//
// A library: each `export fn` is a C function or a WebAssembly export (see
// README.md). The parser allocates nothing: it hands back offsets into the
// input. What the compiler proves, for every input and with no runtime
// checks in the generated code: no out-of-bounds read, no overflow, and the
// `ensures` clauses (every offset handed back lies inside the input, in
// order). Not proved: that the parser accepts exactly the requests it
// should; the tests check that against vectors.
//
// Strict means: a line ends with CR LF (a bare LF or CR is rejected), no
// control character other than HT appears in the head, the method is a
// token, the target is one or more visible characters, the version is
// HTTP/1.0 or HTTP/1.1, and a header field is `name: value` with no space
// before the colon. Obsolete line folding is rejected (a line that starts
// with a space is not a field name).

/// One request head: the method is `0..method_end`, the target
/// `target..target_end`, the version is HTTP/1.`minor`, the first header
/// field starts at `fields`, there are `nfields` of them and the body
/// starts at `head_end`.
struct Req { method_end: u64, target: u64, target_end: u64, minor: u8, fields: u64, nfields: u64, head_end: u64 }

enum Head {
  Ok(Req),
  // The input ends inside the head: read more and call again.
  Partial,
  // The offset of the first byte that makes the head invalid.
  Bad(u64),
}

/// One header field: the name is `at..name_end`, the value (with the
/// whitespace around it removed) `value..value_end`, the next line starts at
/// `next`.
struct Field { name_end: u64, value: u64, value_end: u64, next: u64 }

enum Next {
  Ok(Field),
  // The empty line that ends the head; the body starts at this offset.
  End(u64),
  Partial,
  Bad(u64),
}

/// Is `c` a token character (RFC 9110, section 5.6.2)?
fn http_tchar(c: u8) -> bool {
  if c >= 48 && c <= 57 { return true; }
  if c >= 65 && c <= 90 { return true; }
  if c >= 97 && c <= 122 { return true; }
  return c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42
    || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126;
}

/// The offset of the first byte from `at` on that cannot be part of a line:
/// a control character other than HT, or the end of the input.
fn http_line_end(s: &Bytes, at: u64) -> u64
  requires at <= blen(s)
  ensures at <= result && result <= blen(s)
{
  let n = blen(s);
  let mut k = at;
  while k < n && (bget(s, k) >= 32 && bget(s, k) != 127 || bget(s, k) == 9)
    invariant at <= k && k <= n
  {
    k = k + 1;
  }
  return k;
}

/// The line that starts at `at`: Ok(e) when it ends with CR LF at `e`
/// (the next line starts at e + 2), Partial when the input ends in it,
/// Bad(e) otherwise.
enum Line { Ok(u64), Partial, Bad(u64) }

fn http_line(s: &Bytes, at: u64) -> Line
  requires at <= blen(s)
  ensures result is Line::Ok ==> at <= result.Ok && result.Ok + 2 <= blen(s)
  ensures result is Line::Bad ==> at <= result.Bad && result.Bad < blen(s)
{
  let n = blen(s);
  let e = http_line_end(s, at);
  if e == n {
    return Line::Partial;
  }
  if bget(s, e) != 13 {
    return Line::Bad(e);
  }
  if e + 1 == n {
    return Line::Partial;
  }
  if bget(s, e + 1) != 10 {
    return Line::Bad(e + 1);
  }
  return Line::Ok(e);
}

/// The header field that starts at `at`, or the empty line that ends the head.
export fn http_field(s: &Bytes, at: u64) -> Next
  ensures result is Next::Ok ==> at < result.Ok.name_end && result.Ok.name_end < result.Ok.value
  ensures result is Next::Ok ==> result.Ok.value <= result.Ok.value_end && result.Ok.value_end + 2 <= result.Ok.next
  ensures result is Next::Ok ==> at < result.Ok.next && result.Ok.next <= blen(s)
  ensures result is Next::End ==> at + 2 <= result.End && result.End <= blen(s)
  ensures result is Next::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  if at > n {
    return Next::Bad(n);
  }
  let mut e = 0;
  match http_line(s, at) {
    Line::Partial => { return Next::Partial; }
    Line::Bad(x) => { return Next::Bad(x); }
    Line::Ok(x) => { e = x; }
  }
  if e == at {
    return Next::End(at + 2);
  }
  let mut p = at;
  while p < e && http_tchar(bget(s, p))
    invariant at <= p && p <= e && e + 2 <= n
  {
    p = p + 1;
  }
  if p == at || p == e || bget(s, p) != 58 {
    return Next::Bad(p);
  }
  let mut v = p + 1;
  while v < e && (bget(s, v) == 32 || bget(s, v) == 9)
    invariant p < v && v <= e && e + 2 <= n
  {
    v = v + 1;
  }
  let mut ve = e;
  while ve > v && (bget(s, ve - 1) == 32 || bget(s, ve - 1) == 9)
    invariant v <= ve && ve <= e && e + 2 <= n
  {
    ve = ve - 1;
  }
  return Next::Ok(Field { name_end: p, value: v, value_end: ve, next: e + 2 });
}

/// Parses the request line and counts the header fields of the head at the
/// start of `s`.
export fn http_parse_head(s: &Bytes) -> Head
  ensures result is Head::Ok ==> 0 < result.Ok.method_end && result.Ok.method_end < result.Ok.target
  ensures result is Head::Ok ==> result.Ok.target < result.Ok.target_end && result.Ok.target_end + 11 == result.Ok.fields
  ensures result is Head::Ok ==> result.Ok.fields <= result.Ok.head_end && result.Ok.head_end <= blen(s)
  ensures result is Head::Ok ==> result.Ok.minor <= 1
  ensures result is Head::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  let mut e = 0;
  match http_line(s, 0) {
    Line::Partial => { return Head::Partial; }
    Line::Bad(x) => { return Head::Bad(x); }
    Line::Ok(x) => { e = x; }
  }
  // The method.
  let mut m = 0;
  while m < e && http_tchar(bget(s, m))
    invariant m <= e && e + 2 <= n
  {
    m = m + 1;
  }
  if m == 0 || m == e || bget(s, m) != 32 {
    return Head::Bad(m);
  }
  // The target: visible characters up to the next space.
  let t = m + 1;
  let mut q = t;
  while q < e && bget(s, q) > 32
    invariant t <= q && q <= e && e + 2 <= n
  {
    q = q + 1;
  }
  if q == t || q == e || bget(s, q) != 32 {
    return Head::Bad(q);
  }
  // The version, which fills the rest of the line: "HTTP/1." and a digit.
  if e - q != 9 {
    return Head::Bad(q + 1);
  }
  if bget(s, q + 1) != 72 || bget(s, q + 2) != 84 || bget(s, q + 3) != 84 || bget(s, q + 4) != 80
    || bget(s, q + 5) != 47 || bget(s, q + 6) != 49 || bget(s, q + 7) != 46 {
    return Head::Bad(q + 1);
  }
  let d = bget(s, q + 8);
  if d != 48 && d != 49 {
    return Head::Bad(q + 8);
  }
  // The header fields, up to the empty line.
  match http_fields(s, e + 2) {
    Fields::Partial => { return Head::Partial; }
    Fields::Bad(x) => { return Head::Bad(x); }
    Fields::Ok(r) => {
      return Head::Ok(Req { method_end: m, target: t, target_end: q, minor: d - 48, fields: e + 2, nfields: r.count, head_end: r.head_end });
    }
  }
}

/// The number of header fields and the end of the head.
struct Done { count: u64, head_end: u64 }

enum Fields { Ok(Done), Partial, Bad(u64) }

/// Walks the header fields from `first` to the empty line that ends the head.
fn http_fields(s: &Bytes, first: u64) -> Fields
  requires first <= blen(s)
  ensures result is Fields::Ok ==> first + 2 <= result.Ok.head_end && result.Ok.head_end <= blen(s)
  ensures result is Fields::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  let mut at = first;
  let mut count: u64 = 0;
  while at < n
    invariant first <= at && at <= n && count <= at
  {
    match http_field(s, at) {
      Next::Partial => { return Fields::Partial; }
      Next::Bad(x) => { return Fields::Bad(x); }
      Next::End(x) => { return Fields::Ok(Done { count: count, head_end: x }); }
      Next::Ok(f) => {
        at = f.next;
        count = count + 1;
      }
    }
  }
  return Fields::Partial;
}

/// One response head: HTTP/1.`minor`, the status code, the reason phrase
/// `reason..reason_end` (possibly empty), then the header fields as in `Req`.
struct Resp { minor: u8, status: u64, reason: u64, reason_end: u64, fields: u64, nfields: u64, head_end: u64 }

enum RespHead {
  Ok(Resp),
  Partial,
  Bad(u64),
}

/// Parses the status line and counts the header fields of the response head
/// at the start of `s`: "HTTP/1.x", a space, a three-digit status from 100 to
/// 599, a space, the reason phrase (which may be empty), CR LF.
export fn http_parse_response(s: &Bytes) -> RespHead
  ensures result is RespHead::Ok ==> result.Ok.minor <= 1 && 100 <= result.Ok.status && result.Ok.status <= 599
  ensures result is RespHead::Ok ==> result.Ok.reason == 13 && result.Ok.reason <= result.Ok.reason_end
  ensures result is RespHead::Ok ==> result.Ok.reason_end + 2 == result.Ok.fields
  ensures result is RespHead::Ok ==> result.Ok.fields <= result.Ok.head_end && result.Ok.head_end <= blen(s)
  ensures result is RespHead::Bad ==> result.Bad <= blen(s)
{
  let mut e = 0;
  match http_line(s, 0) {
    Line::Partial => { return RespHead::Partial; }
    Line::Bad(x) => { return RespHead::Bad(x); }
    Line::Ok(x) => { e = x; }
  }
  if e < 13 {
    return RespHead::Bad(e);
  }
  if bget(s, 0) != 72 || bget(s, 1) != 84 || bget(s, 2) != 84 || bget(s, 3) != 80
    || bget(s, 4) != 47 || bget(s, 5) != 49 || bget(s, 6) != 46 {
    return RespHead::Bad(0);
  }
  let d = bget(s, 7);
  if d != 48 && d != 49 {
    return RespHead::Bad(7);
  }
  if bget(s, 8) != 32 {
    return RespHead::Bad(8);
  }
  let a = bget(s, 9);
  let b = bget(s, 10);
  let c = bget(s, 11);
  if a < 49 || a > 53 {
    return RespHead::Bad(9);
  }
  if b < 48 || b > 57 {
    return RespHead::Bad(10);
  }
  if c < 48 || c > 57 {
    return RespHead::Bad(11);
  }
  if bget(s, 12) != 32 {
    return RespHead::Bad(12);
  }
  let status = (cast[u64](a) - 48) * 100 + (cast[u64](b) - 48) * 10 + (cast[u64](c) - 48);
  match http_fields(s, e + 2) {
    Fields::Partial => { return RespHead::Partial; }
    Fields::Bad(x) => { return RespHead::Bad(x); }
    Fields::Ok(r) => {
      return RespHead::Ok(Resp { minor: d - 48, status: status, reason: 13, reason_end: e, fields: e + 2, nfields: r.count, head_end: r.head_end });
    }
  }
}

/// The value of hexadecimal digit `c`, or 16 if `c` is not one.
fn http_hex(c: u8) -> u8
  ensures result <= 16
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 65 && c <= 70 { return c - 55; }
  if c >= 97 && c <= 102 { return c - 87; }
  return 16;
}

/// One chunk of a chunked message body: its data is `data..data+size` and
/// the next chunk starts at `next`.
struct ChunkData { data: u64, size: u64, next: u64 }

enum Chunk {
  Ok(ChunkData),
  // The last chunk (size 0) and the trailer fields after it, up to and
  // including the empty line: the message ends at this offset.
  Last(u64),
  Partial,
  Bad(u64),
}

/// The chunk that starts at `at` in a chunked body (RFC 9112, section 7.1):
/// a size in hexadecimal (at most 2^56 - 1), an optional extension that is
/// skipped, CR LF, the data, CR LF.
export fn http_chunk(s: &Bytes, at: u64) -> Chunk
  ensures result is Chunk::Ok ==> at < result.Ok.data && result.Ok.data + result.Ok.size + 2 == result.Ok.next
  ensures result is Chunk::Ok ==> 0 < result.Ok.size && result.Ok.next <= blen(s)
  ensures result is Chunk::Last ==> at + 3 <= result.Last && result.Last <= blen(s)
  ensures result is Chunk::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  if at > n {
    return Chunk::Bad(n);
  }
  let mut e = 0;
  match http_line(s, at) {
    Line::Partial => { return Chunk::Partial; }
    Line::Bad(x) => { return Chunk::Bad(x); }
    Line::Ok(x) => { e = x; }
  }
  let mut p = at;
  let mut size: u64 = 0;
  while p < e && http_hex(bget(s, p)) < 16
    invariant at <= p && p <= e && e + 2 <= n && size < 0x0100000000000000
  {
    size = size * 16 + cast[u64](http_hex(bget(s, p)));
    if size >= 0x0100000000000000 {
      return Chunk::Bad(p);
    }
    p = p + 1;
  }
  if p == at {
    return Chunk::Bad(p);
  }
  // An extension: ";" and text to the end of the line.
  if p < e && bget(s, p) != 59 {
    return Chunk::Bad(p);
  }
  let data = e + 2;
  if size == 0 {
    match http_fields(s, data) {
      Fields::Partial => { return Chunk::Partial; }
      Fields::Bad(x) => { return Chunk::Bad(x); }
      Fields::Ok(r) => { return Chunk::Last(r.head_end); }
    }
  }
  if n - data < size + 2 {
    return Chunk::Partial;
  }
  if bget(s, data + size) != 13 {
    return Chunk::Bad(data + size);
  }
  if bget(s, data + size + 1) != 10 {
    return Chunk::Bad(data + size + 1);
  }
  return Chunk::Ok(ChunkData { data: data, size: size, next: data + size + 2 });
}

/// `c` in lower case, if it is an ASCII letter.
fn http_lower(c: u8) -> u8 {
  if c >= 65 && c <= 90 { return c + 32; }
  return c;
}

/// Is `s[a..b)` equal to "content-length", ignoring case?
fn http_is_content_length(s: &Bytes, a: u64, b: u64) -> bool
  requires a <= b && b <= blen(s)
{
  if b - a != 14 { return false; }
  let mut i = 0;
  while i < 14
    invariant i <= 14 && a + 14 == b
  {
    if http_lower(bget(s, a + i)) != sget("content-length", i) { return false; }
    i = i + 1;
  }
  return true;
}

/// Is `s[a..b)` equal to "transfer-encoding", ignoring case?
fn http_is_transfer_encoding(s: &Bytes, a: u64, b: u64) -> bool
  requires a <= b && b <= blen(s)
{
  if b - a != 17 { return false; }
  let mut i = 0;
  while i < 17
    invariant i <= 17 && a + 17 == b
  {
    if http_lower(bget(s, a + i)) != sget("transfer-encoding", i) { return false; }
    i = i + 1;
  }
  return true;
}

/// Is `s[a..b)` equal to "chunked", ignoring case?
fn http_is_chunked(s: &Bytes, a: u64, b: u64) -> bool
  requires a <= b && b <= blen(s)
{
  if b - a != 7 { return false; }
  let mut i = 0;
  while i < 7
    invariant i <= 7 && a + 7 == b
  {
    if http_lower(bget(s, a + i)) != sget("chunked", i) { return false; }
    i = i + 1;
  }
  return true;
}

/// How the body of a message is delimited (RFC 9112, section 6.3).
enum Body {
  // Neither header: no body (a request) or a body that runs to the end of
  // the connection (a response); the caller knows which.
  None,
  // `Content-Length`: this many bytes.
  Length(u64),
  // `Transfer-Encoding: chunked`: read it with http_chunk.
  Chunked,
  // The offset of the field that makes the framing ambiguous or invalid.
  Bad(u64),
}

/// Decides how the body is delimited from the header fields that start at
/// `first` (as `http_parse_head` and `http_parse_response` return it). The
/// rules are the strict ones that stop request smuggling: a repeated
/// `Content-Length` or `Transfer-Encoding`, both at once, a transfer coding
/// other than a lone `chunked`, and a length that is not plain decimal digits
/// (at most 2^56 - 1) are all rejected.
export fn http_body(s: &Bytes, first: u64) -> Body
  ensures result is Body::Bad ==> result.Bad <= blen(s)
{
  let n = blen(s);
  if first > n {
    return Body::Bad(n);
  }
  let mut at = first;
  let mut have_len = false;
  let mut len: u64 = 0;
  let mut chunked = false;
  while at < n
    invariant first <= at && at <= n
  {
    match http_field(s, at) {
      Next::Partial => { return Body::Bad(n); }
      Next::Bad(x) => { return Body::Bad(x); }
      Next::End(x) => {
        if chunked && have_len {
          return Body::Bad(first);
        }
        if chunked { return Body::Chunked; }
        if have_len { return Body::Length(len); }
        return Body::None;
      }
      Next::Ok(f) => {
        if http_is_content_length(s, at, f.name_end) {
          if have_len || f.value == f.value_end {
            return Body::Bad(at);
          }
          let mut v: u64 = 0;
          let mut k = f.value;
          while k < f.value_end
            invariant f.value <= k && k <= f.value_end && f.value_end <= n && v < 0x0100000000000000
          {
            let c = bget(s, k);
            if c < 48 || c > 57 { return Body::Bad(k); }
            v = v * 10 + (cast[u64](c) - 48);
            if v >= 0x0100000000000000 { return Body::Bad(k); }
            k = k + 1;
          }
          have_len = true;
          len = v;
        }
        if http_is_transfer_encoding(s, at, f.name_end) {
          if chunked || !http_is_chunked(s, f.value, f.value_end) {
            return Body::Bad(at);
          }
          chunked = true;
        }
        at = f.next;
      }
    }
  }
  return Body::Bad(n);
}
