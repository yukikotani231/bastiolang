// The base64 library as a C translation unit. stage0 requires every program
// to have a `main`; this one is never called: base64_capi.c renames the C
// `main` the compiler generates, and C programs call the functions through
// base64.h. (See README.md, "The C boundary".)
import "base64.bastio";

fn main() -> u64 {
  return 0;
}
