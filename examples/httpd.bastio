// stage1-only: host_net (sockets), std/http
// A small HTTP server with std/http: two routes, and an answer for anything
// else, with keep-alive. Run with no arguments it checks itself: it listens
// on a free port of 127.0.0.1, sends itself a request for each route over one
// real connection, and exits with 0 if the answers are right. `httpd serve
// PORT` serves on 127.0.0.1:PORT until it is killed.
//
// What the compiler proves: no buffer is read or written out of bounds and
// none leaks. It does not prove that the answers are right (the self-check
// does) or that a peer behaves.
import "core/print.bastio";
import "std/host.bastio";
import "std/http.bastio";

/// Answers the request `r`: the page for its target. The connection comes
/// back, still open, when the client may send another request on it.
fn answer(h: &Host, r: HttpReq) -> Option[u64] {
  let t = http_req_target(r);
  if bytes_eq_str(t, "/") {
    bfree(t);
    let body = bfrom("hello from Bastio\n");
    let k = http_answer(h, r, 200, "OK", "text/plain", body);
    bfree(body);
    return k;
  }
  if bytes_eq_str(t, "/about") {
    bfree(t);
    let body = bfrom("<h1>Bastio</h1><p>memory safety, proved at compile time</p>\n");
    let k = http_answer(h, r, 200, "OK", "text/html", body);
    bfree(body);
    return k;
  }
  bfree(t);
  let body = bfrom("not found\n");
  let k = http_answer(h, r, 404, "Not Found", "text/plain", body);
  bfree(body);
  return k;
}

/// Reads the next request on the connection `c` and answers it. The
/// connection again if it stays open; `None` once it is closed (the client
/// asked for that, or went away, or sent something that is not a request).
fn step(h: &Host, c: u64) -> Option[u64] {
  match http_read_request(h, c, 8192) {
    Option::Some(r) => { return answer(h, r); },
    Option::None => { return Option[u64]::None; },
  }
}

/// Serves the connection `c` until it is closed, but for at most 100
/// requests, so that one client cannot hold the server for ever.
fn serve_conn(h: &Host, c: u64) {
  let mut cur = c;
  let mut n = 0;
  while cur != 0 && n < 100
    invariant n <= 100
  {
    match step(h, cur) {
      Option::Some(k) => { cur = k; },
      Option::None => { cur = 0; },
    }
    n = n + 1;
  }
  if cur != 0 {
    net_close(h, cur);
  }
}

/// Sends a request for `path` on `c` (already connected) and has the server
/// side `a` answer it; returns the status of the answer, 0 on failure. The
/// `Connection: keep-alive` of the answer shows if the connection stayed open.
fn ask(h: &Host, a: u64, c: u64, path: Str, last: bool) -> u64 {
  let mut t = text_new();
  text_push_str(&mut t, "GET ");
  text_push_str(&mut t, path);
  if last {
    text_push_str(&mut t, " HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
  } else {
    text_push_str(&mut t, " HTTP/1.1\r\nHost: localhost\r\n\r\n");
  }
  let req = text_finish(t);
  let sent = net_send_all(h, c, req);
  bfree(req);
  if !sent {
    return 0;
  }
  let mut open = false;
  match step(h, a) {
    Option::Some(k) => { open = true; },
    Option::None => {},
  }
  // A kept connection must be kept exactly when the client did not ask to
  // close it.
  if open == last {
    return 0;
  }
  match http_read_response(h, c, 65536) {
    Option::Some(m) => {
      let st = http_status(m);
      bfree(m);
      return st;
    },
    Option::None => { return 0; },
  }
}

/// Listens on `lo`:`port` and answers requests for ever, one connection at a
/// time.
fn serve(con: &Serial, h: &Host, lo: u64, port: u64) -> u64 {
  match net_listen(h, lo, port) {
    Option::Some(s) => {
      print_str(con, "listening on 127.0.0.1:");
      print_u64(con, net_port(h, s));
      print_nl(con);
      while true {
        match net_accept(h, s) {
          Option::Some(c) => { serve_conn(h, c); },
          Option::None => {},
        }
      }
      net_close(h, s);
      return 0;
    },
    Option::None => {
      print_str(con, "cannot listen\n");
      return 1;
    },
  }
}

/// Starts the server on a free port and asks it for each route over one
/// connection, the last request asking to close it.
fn selfcheck(con: &Serial, h: &Host, lo: u64) -> u64 {
  let mut good = 0;
  match net_listen(h, lo, 0) {
    Option::Some(s) => {
      match net_connect(h, lo, net_port(h, s)) {
        Option::Some(c) => {
          match net_accept(h, s) {
            Option::Some(a) => {
              let st0 = ask(h, a, c, "/", false);
              let st1 = ask(h, a, c, "/about", false);
              let st2 = ask(h, a, c, "/missing", true);
              print_u64(con, st0);
              print_nl(con);
              print_u64(con, st1);
              print_nl(con);
              print_u64(con, st2);
              print_nl(con);
              if st0 == 200 && st1 == 200 && st2 == 404 {
                good = 1;
              }
            },
            Option::None => {},
          }
          net_close(h, c);
        },
        Option::None => {},
      }
      net_close(h, s);
    },
    Option::None => {},
  }
  if good == 1 {
    return 0;
  }
  return 1;
}

fn main(con: &mut Serial, h: &mut Host) -> u64 {
  let lo = net_ip4(127, 0, 0, 1);
  if host_arg_is(h, 1, "serve") {
    let a = host_arg(h, 2);
    let mut port = 8080;
    match parse_u64(a, 0, blen(a)) {
      Option::Some(p) => { port = p; },
      Option::None => {},
    }
    bfree(a);
    return serve(con, h, lo, port);
  }
  return selfcheck(con, h, lo);
}
