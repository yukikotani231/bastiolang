// bastio-lsp: a language server for Bastio, over standard input and output.
//
// What it does:
//   - diagnostics: the lexical error of the buffer as you type, and the
//     first error of `bastioc1 --check` (syntax, types, linearity and the
//     proofs, with a failed proof's counterexample) when a file is opened
//     or saved, on the text of the buffer (with `checkOnChange`, on every
//     edit too);
//   - go to definition and hover for functions, `spec fn`s, structs, enums,
//     constants, variants, fields and local variables, in the file and in
//     the files it imports (hover shows the signature and the `///` doc
//     comment);
//   - find references, highlights and rename of the same names, in the open
//     documents and the files they import;
//   - document symbols;
//   - formatting, with bastiofmt's rules.
//
// Options (`initializationOptions`): `bastioc` (the compiler, default
// `$BASTIOC` or `bastioc1`), `target` (`hosted`, `kernel` or `user`), `lib`
// (a list of library directories, for imports and for the compiler),
// `checkOnChange` (run the compiler on every edit).
//
// It reads the buffer text the editor sends (full-text synchronization), and
// everything it reports about other files comes from the files on disk, or
// from their open buffers.
import "defs.bastio";

struct State {
  uris: Vec[Bytes],
  paths: Vec[Bytes],
  texts: Vec[Bytes],
  cmd: Bytes,
  target: Bytes,
  libs: Vec[Bytes],
  on_change: bool,
  shutdown: bool
}

// ---- Bytes and text ----

fn to_bytes(v: &Vec[u64]) -> Bytes {
  let n = vec_len(v);
  let mut b = balloc(n);
  let mut k = 0;
  while k < n && k < blen(b)
    invariant k <= n && n == vlen(v) && blen(b) == n
  {
    let c = u_at(v, k);
    if c <= 255 {
      bset(&mut b, k, cast[u8](c));
    }
    k = vadd(k, 1);
  }
  return b;
}

fn from_str(s: Str) -> Bytes {
  return bfrom(s);
}

fn vec_is(v: &Vec[u64], w: Str) -> bool {
  if vec_len(v) != slen(w) {
    return false;
  }
  let mut k = 0;
  while k < slen(w)
    invariant k <= slen(w) && vlen(v) == slen(w)
  {
    if u_at(v, k) != cast[u64](sget(w, k)) {
      return false;
    }
    k = vadd(k, 1);
  }
  return true;
}

fn bytes_starts(b: &Bytes, w: Str) -> bool {
  if blen(b) < slen(w) {
    return false;
  }
  return spells(b, 0, slen(w), w);
}

fn push_bytes(out: &mut Vec[u64], b: &Bytes) {
  let mut k = 0;
  while k < blen(b)
  {
    vec_push(&mut out, cast[u64](bget(b, k)));
    k = vadd(k, 1);
  }
}

// ---- URIs ----

fn hexd(c: u64) -> u64
  ensures result <= 16
{
  let h = hex_val(c);
  return h;
}

/// The path of a `file://` URI, percent-decoded; empty for any other URI.
fn uri_to_path(uri: &Bytes) -> Bytes {
  let mut out = vec_new[u64]();
  if bytes_starts(uri, "file://") {
    let n = blen(uri);
    let mut k = 7;
    while k < n
    {
      let c = at(uri, k);
      if c == 37 && vadd(k, 2) < vadd(n, 1) && hexd(at(uri, vadd(k, 1))) < 16 && hexd(at(uri, vadd(k, 2))) < 16 {
        vec_push(&mut out, hexd(at(uri, vadd(k, 1))) * 16 + hexd(at(uri, vadd(k, 2))));
        k = vadd(k, 3);
      } else {
        vec_push(&mut out, c);
        k = vadd(k, 1);
      }
    }
  }
  let b = to_bytes(out);
  vec_free(out);
  return b;
}

fn uri_plain(c: u64) -> bool {
  return (is_alpha(c) && c != 95) || is_digit(c) || c == 45 || c == 46 || c == 95 || c == 126 || c == 47 || c == 58;
}

fn path_to_uri(path: &Bytes) -> Bytes {
  let mut out = vec_new[u64]();
  w_s(&mut out, "file://");
  let mut k = 0;
  while k < blen(path)
  {
    let c = at(path, k);
    if uri_plain(c) {
      vec_push(&mut out, c);
    } else {
      vec_push(&mut out, 37);
      let hi = c / 16;
      let lo = c % 16;
      if hi < 10 { vec_push(&mut out, 48 + hi); } else { vec_push(&mut out, 55 + hi); }
      if lo < 10 { vec_push(&mut out, 48 + lo); } else { vec_push(&mut out, 55 + lo); }
    }
    k = vadd(k, 1);
  }
  let b = to_bytes(out);
  vec_free(out);
  return b;
}

// ---- Positions ----

/// The UTF-16 length of the character that starts with byte `c`: 0 for a
/// continuation byte, 2 for the first byte of a four-byte sequence.
fn utf16_units(c: u64) -> u64
  ensures result <= 2
{
  if c >= 128 && c < 192 {
    return 0;
  }
  if c >= 240 {
    return 2;
  }
  return 1;
}

/// The byte offset of LSP position (`line`, `ch`, in UTF-16 units) in `all`,
/// where the text starts at `from`.
fn lsp_to_off(all: &Bytes, from: u64, line: u64, ch: u64) -> u64 {
  let n = blen(all);
  let mut k = from;
  let mut l = 0;
  while k < n && l < line
  {
    if at(all, k) == 10 {
      l = vadd(l, 1);
    }
    k = vadd(k, 1);
  }
  let mut u = 0;
  while k < n && at(all, k) != 10 && u < ch
  {
    u = vadd(u, utf16_units(at(all, k)));
    k = vadd(k, 1);
    while k < n && at(all, k) >= 128 && at(all, k) < 192
    {
      k = vadd(k, 1);
    }
  }
  return k;
}

struct Pos { line: u64, ch: u64 }

/// The LSP position of byte offset `off`, in the text that starts at `from`.
fn off_to_lsp(all: &Bytes, from: u64, off: u64) -> Pos {
  let n = blen(all);
  let mut e = off;
  if e > n {
    e = n;
  }
  let mut line = 0;
  let mut ls = from;
  let mut k = from;
  while k < e
  {
    if at(all, k) == 10 {
      line = vadd(line, 1);
      ls = vadd(k, 1);
    }
    k = vadd(k, 1);
  }
  let mut u = 0;
  k = ls;
  while k < e
  {
    u = vadd(u, utf16_units(at(all, k)));
    k = vadd(k, 1);
  }
  return Pos { line: line, ch: u };
}

fn w_pos(out: &mut Vec[u64], p: Pos) {
  w_s(&mut out, "{\"line\":");
  w_num(&mut out, p.line);
  w_s(&mut out, ",\"character\":");
  w_num(&mut out, p.ch);
  w_s(&mut out, "}");
}

fn w_range(out: &mut Vec[u64], all: &Bytes, from: u64, s: u64, e: u64) {
  w_s(&mut out, "{\"start\":");
  w_pos(&mut out, off_to_lsp(all, from, s));
  w_s(&mut out, ",\"end\":");
  w_pos(&mut out, off_to_lsp(all, from, e));
  w_s(&mut out, "}");
}

// ---- Protocol ----

/// Reads one message: false at the end of the input. Headers are read up to
/// the blank line; only Content-Length matters.
fn read_msg(con: &mut Serial, out: &mut Bytes) -> bool {
  let mut len = 0;
  let mut have_len = false;
  let mut done = false;
  while !done {
    // One header line.
    let mut line = vec_new[u64]();
    let mut eol = false;
    while !eol {
      let c = cast[u64](serial_read(con));
      if c == 4 {
        vec_free(line);
        return false;
      }
      if c == 10 {
        eol = true;
      } else if vec_len(line) < 4096 {
        vec_push(&mut line, c);
      }
    }
    while vec_len(line) > 0 && u_at(line, vec_len(line) - 1) == 13 {
      vec_pop(&mut line);
    }
    if vec_len(line) == 0 {
      done = true;
    } else {
      // `Content-Length: N`, whatever the case.
      let mut k = 0;
      let mut colon = false;
      let mut name = vec_new[u64]();
      while k < vec_len(line) && !colon
      {
        let c = u_at(line, k);
        if c == 58 {
          colon = true;
        } else if c >= 65 && c <= 90 {
          vec_push(&mut name, vadd(c, 32));
        } else {
          vec_push(&mut name, c);
        }
        k = vadd(k, 1);
      }
      if colon && vec_is(name, "content-length") {
        let mut v = 0;
        while k < vec_len(line)
        {
          let c = u_at(line, k);
          if is_digit(c) && v < 1000000000 {
            v = v * 10 + (c - 48);
          }
          k = vadd(k, 1);
        }
        len = v;
        have_len = true;
      }
      vec_free(name);
    }
    vec_free(line);
  }
  if !have_len || len > 268435456 {
    return false;
  }
  let mut b = balloc(len);
  let mut k = 0;
  while k < len && k < blen(b)
    invariant k <= len && blen(b) == len
  {
    bset(&mut b, k, serial_read(con));
    k = vadd(k, 1);
  }
  bfree(out);
  out = b;
  return true;
}

fn send(con: &mut Serial, body: &Vec[u64]) {
  let mut head = vec_new[u64]();
  w_s(&mut head, "Content-Length: ");
  w_num(&mut head, vec_len(body));
  w_s(&mut head, "\r\n\r\n");
  let mut k = 0;
  while k < vec_len(head)
  {
    serial_write(con, cast[u8](vec_get(head, k) % 256));
    k = vadd(k, 1);
  }
  vec_free(head);
  k = 0;
  while k < vec_len(body)
  {
    serial_write(con, cast[u8](vec_get(body, k) % 256));
    k = vadd(k, 1);
  }
}

/// `{"jsonrpc":"2.0","id":ID,"result":RESULT}`
fn send_result(con: &mut Serial, id: &Vec[u64], res_: &Vec[u64]) {
  let mut m = vec_new[u64]();
  w_s(&mut m, "{\"jsonrpc\":\"2.0\",\"id\":");
  w_append(&mut m, id);
  w_s(&mut m, ",\"result\":");
  w_append(&mut m, res_);
  w_s(&mut m, "}");
  send(&mut con, m);
  vec_free(m);
}

fn send_error(con: &mut Serial, id: &Vec[u64], code: u64, msg: Str) {
  let mut m = vec_new[u64]();
  w_s(&mut m, "{\"jsonrpc\":\"2.0\",\"id\":");
  w_append(&mut m, id);
  w_s(&mut m, ",\"error\":{\"code\":-");
  w_num(&mut m, code);
  w_s(&mut m, ",\"message\":\"");
  w_s(&mut m, msg);
  w_s(&mut m, "\"}}");
  send(&mut con, m);
  vec_free(m);
}

fn send_notification(con: &mut Serial, method: Str, params: &Vec[u64]) {
  let mut m = vec_new[u64]();
  w_s(&mut m, "{\"jsonrpc\":\"2.0\",\"method\":\"");
  w_s(&mut m, method);
  w_s(&mut m, "\",\"params\":");
  w_append(&mut m, params);
  w_s(&mut m, "}");
  send(&mut con, m);
  vec_free(m);
}

/// The id of the request as JSON text (`null` if it has none).
fn id_json(j: &Json, root: u64, out: &mut Vec[u64]) {
  let id = jget(j, root, "id");
  let n = jn(j, id);
  if n.kind == J_STR {
    vec_push(&mut out, 34);
    jraw(j, id, &mut out);
    vec_push(&mut out, 34);
  } else if n.kind == J_NUM {
    jraw(j, id, &mut out);
  } else {
    w_s(&mut out, "null");
  }
}

/// The decoded string at `node` as bytes (empty if it is not a string).
fn str_of(j: &Json, node: u64) -> Bytes {
  let mut v = vec_new[u64]();
  jdecode(j, node, &mut v);
  let b = to_bytes(v);
  vec_free(v);
  return b;
}

// ---- Documents ----

/// The index + 1 of the open document with this URI, or 0.
fn find_doc(st: &mut State, uri: &Bytes) -> u64 {
  let mut k = 0;
  while k < vec_len(st.uris)
  {
    let u = vec_swap(&mut st.uris, k, balloc(0));
    let same = bytes_same(u, uri);
    bfree(vec_swap(&mut st.uris, k, u));
    if same {
      return vadd(k, 1);
    }
    k = vadd(k, 1);
  }
  return 0;
}

fn doc_copy(v: &mut Vec[Bytes], k: u64) -> Bytes {
  if k >= vec_len(v) {
    return balloc(0);
  }
  let t = vec_swap(&mut v, k, balloc(0));
  let c = byte_range(t, 0, blen(t));
  bfree(vec_swap(&mut v, k, t));
  return c;
}

fn set_doc(st: &mut State, uri: &Bytes, text: Bytes) {
  let k = find_doc(&mut st, uri);
  if k > 0 && k <= vec_len(st.texts) {
    bfree(vec_swap(&mut st.texts, k - 1, text));
  } else {
    let path = uri_to_path(uri);
    let canon = canon_path(path);
    bfree(path);
    vec_push(&mut st.uris, byte_range(uri, 0, blen(uri)));
    vec_push(&mut st.paths, canon);
    vec_push(&mut st.texts, text);
  }
}

/// Removes element `i` of `v` (the order of the others does not matter).
fn remove_at(v: &mut Vec[Bytes], i: u64) {
  if i < vec_len(v) {
    let last = vec_pop(&mut v);
    if i < vec_len(v) {
      bfree(vec_swap(&mut v, i, last));
    } else {
      bfree(last);
    }
  }
}

fn drop_doc(st: &mut State, uri: &Bytes) {
  let k = find_doc(&mut st, uri);
  if k > 0 {
    remove_at(&mut st.uris, k - 1);
    remove_at(&mut st.paths, k - 1);
    remove_at(&mut st.texts, k - 1);
  }
}

/// The program of file `path`: it and everything it imports.
fn pg_for(host: &Host, st: &mut State, path: &Bytes) -> Prog {
  let mut ix = pg_new();
  let mut k = 0;
  while k < vec_len(st.libs)
  {
    let l = vec_swap(&mut st.libs, k, balloc(0));
    loader_lib(&mut ix.ld, byte_range(l, 0, blen(l)));
    bfree(vec_swap(&mut st.libs, k, l));
    k = vadd(k, 1);
  }
  loader_env_libs(host, &mut ix.ld);
  pg_load(host, &mut ix, &mut st.paths, &mut st.texts, path, 0);
  return ix;
}

/// The path of file `k` of the program.
fn pg_path(ix: &Prog, k: u64) -> Bytes {
  let mut w = vec_new[u64]();
  if k < vec_len(ix.ld.files) {
    let f = vec_get(ix.ld.files, k);
    let mut q = 0;
    while q < f.len
    {
      vec_push(&mut w, u_at(ix.ld.paths, vadd(f.start, q)));
      q = vadd(q, 1);
    }
  }
  let b = to_bytes(w);
  vec_free(w);
  return b;
}

/// The URI of file `k` of the program: an open document's own, or one made
/// from its path.
fn pg_uri(st: &mut State, ix: &Prog, k: u64) -> Bytes {
  let p = pg_path(ix, k);
  let mut d = 0;
  while d < vec_len(st.paths)
  {
    let q = vec_swap(&mut st.paths, d, balloc(0));
    let same = bytes_same(q, p);
    bfree(vec_swap(&mut st.paths, d, q));
    if same {
      bfree(p);
      return doc_copy(&mut st.uris, d);
    }
    d = vadd(d, 1);
  }
  let u = path_to_uri(p);
  bfree(p);
  return u;
}

// ---- Diagnostics ----

/// Appends one diagnostic: range, severity 1, message, code and source.
fn w_diag(out: &mut Vec[u64], all: &Bytes, from: u64, s: u64, e: u64, code: &Vec[u64], msg: &Vec[u64]) {
  w_s(&mut out, "{\"range\":");
  w_range(&mut out, all, from, s, e);
  w_s(&mut out, ",\"severity\":1,\"source\":\"bastio\"");
  if vec_len(code) > 0 {
    w_s(&mut out, ",\"code\":\"");
    jesc_vec(&mut out, code);
    w_s(&mut out, "\"");
  }
  w_s(&mut out, ",\"message\":\"");
  jesc_vec(&mut out, msg);
  w_s(&mut out, "\"}");
}

/// The offset of 1-based character column `col` on 1-based line `line` of `all`.
fn lc_to_off(all: &Bytes, line: u64, col: u64) -> u64 {
  let n = blen(all);
  let mut k = 0;
  let mut l = 1;
  while k < n && l < line
  {
    if at(all, k) == 10 {
      l = vadd(l, 1);
    }
    k = vadd(k, 1);
  }
  let mut c = 1;
  while k < n && at(all, k) != 10 && c < col
  {
    k = vadd(k, 1);
    while k < n && at(all, k) >= 128 && at(all, k) < 192
    {
      k = vadd(k, 1);
    }
    c = vadd(c, 1);
  }
  return k;
}

/// The diagnostics of the text for the lexer alone, as a JSON array body.
fn lex_diags(text: &Bytes, out: &mut Vec[u64]) {
  if blen(text) > SRC_MAX {
    return;
  }
  let mut toks = vec_new[Tok]();
  let last = lex(text, 0, &mut toks);
  if last.kind == K_ERROR {
    let mut msg = vec_new[u64]();
    lex_msg(text, last, &mut msg);
    let s = lc_to_off(text, last.line, last.col);
    let mut e = s;
    if e < blen(text) && at(text, e) != 10 {
      e = vadd(e, 1);
    }
    let code = vec_new[u64]();
    w_diag(&mut out, text, 0, s, e, code, msg);
    vec_free(code);
    vec_free(msg);
  }
  vec_free(toks);
}

/// The text of the line the child printed, as a vector.
fn line_vec(b: &Bytes) -> Vec[u64] {
  let mut v = vec_new[u64]();
  push_bytes(&mut v, b);
  return v;
}

/// Puts line `v` back at index `i` of `lines`, dropping the empty one there.
fn line_back(lines: &mut Vec[Vec[u64]], i: u64, v: Vec[u64]) {
  if i < vec_len(lines) {
    let prev_line = vec_swap(&mut lines, i, v);
    vec_free(prev_line);
  } else {
    vec_free(v);
  }
}

fn find_error(v: &Vec[u64]) -> u64 {
  return find_text(v, ": error[");
}

/// The position of `pat` in `v`, plus 1, or 0 if it is not there.
fn find_text(v: &Vec[u64], pat: Str) -> u64 {
  let n = vec_len(v);
  let mut k = 0;
  while k < n && n - k >= slen(pat)
  {
    let mut m = 0;
    while m < slen(pat) && u_at(v, vadd(k, m)) == cast[u64](sget(pat, m))
    {
      m = vadd(m, 1);
    }
    if m == slen(pat) {
      return vadd(k, 1);
    }
    k = vadd(k, 1);
  }
  return 0;
}

/// Runs `bastioc --check` on `file` and collects what it printed, line by
/// line, in `lines`. Returns its exit status.
fn run_check(host: &mut Host, st: &mut State, file: &Bytes, lines: &mut Vec[Vec[u64]]) -> u64 {
  let mut argv = vec_new[Bytes]();
  vec_push(&mut argv, bfrom("sh"));
  vec_push(&mut argv, bfrom("-c"));
  vec_push(&mut argv, bfrom("exec \"$0\" \"$@\" 2>&1"));
  vec_push(&mut argv, byte_range(st.cmd, 0, blen(st.cmd)));
  vec_push(&mut argv, bfrom("--check"));
  if blen(st.target) > 0 {
    vec_push(&mut argv, bfrom("--target"));
    vec_push(&mut argv, byte_range(st.target, 0, blen(st.target)));
  }
  let mut k = 0;
  while k < vec_len(st.libs)
  {
    let l = vec_swap(&mut st.libs, k, balloc(0));
    vec_push(&mut argv, bfrom("--lib"));
    vec_push(&mut argv, byte_range(l, 0, blen(l)));
    bfree(vec_swap(&mut st.libs, k, l));
    k = vadd(k, 1);
  }
  vec_push(&mut argv, byte_range(file, 0, blen(file)));
  let mut child = host_spawn(host, argv);
  let mut line = balloc(0);
  while child_read_line(&mut child, &mut line) && vec_len(lines) < 400 {
    vec_push(&mut lines, line_vec(line));
  }
  bfree(line);
  let status = child_wait(child);
  while vec_len(argv) > 0 {
    bfree(vec_pop(&mut argv));
  }
  vec_free(argv);
  return status;
}

fn free_lines(lines: Vec[Vec[u64]]) {
  let mut w = lines;
  while vec_len(w) > 0 {
    let dead = vec_pop(&mut w);
    vec_free(dead);
  }
  vec_free(w);
}

/// Does any of the lines contain `pat`?
fn lines_have(lines: &mut Vec[Vec[u64]], pat: Str) -> bool {
  let mut i = 0;
  let mut has = false;
  while i < vec_len(lines) && !has
  {
    let l = vec_swap(&mut lines, i, vec_new[u64]());
    if find_text(l, pat) > 0 {
      has = true;
    }
    line_back(&mut lines, i, l);
    i = vadd(i, 1);
  }
  return has;
}

/// Removes `path` (with `rm -f`: the host has no call for it).
fn remove_file(host: &mut Host, path: &Bytes) {
  let mut argv = vec_new[Bytes]();
  vec_push(&mut argv, bfrom("rm"));
  vec_push(&mut argv, bfrom("-f"));
  vec_push(&mut argv, byte_range(path, 0, blen(path)));
  let child = host_spawn(host, argv);
  child_wait(child);
  while vec_len(argv) > 0 {
    bfree(vec_pop(&mut argv));
  }
  vec_free(argv);
}

/// A file name in the temporary directory that is the same for the same
/// `path` and differs between paths.
fn wrapper_path(path: &Bytes) -> Bytes {
  let mut h = 5381;
  let mut k = 0;
  while k < blen(path)
  {
    h = wrap_mul(h, 33) ^ cast[u64](bget(path, k));
    k = vadd(k, 1);
  }
  let mut v = vec_new[u64]();
  w_s(&mut v, "/tmp/bastio-lsp-");
  w_hex(&mut v, h);
  w_s(&mut v, ".bastio");
  let b = to_bytes(v);
  vec_free(v);
  return b;
}

/// A file beside `path` (so that its imports resolve the same way) named
/// after it: where the text of the buffer is written to be checked.
fn shadow_path(path: &Bytes) -> Bytes {
  let mut slash = 0;
  let mut k = 0;
  while k < blen(path)
  {
    if bget(path, k) == 47 {
      slash = vadd(k, 1);
    }
    k = vadd(k, 1);
  }
  let mut v = vec_new[u64]();
  let mut q = 0;
  while q < slash && q < blen(path)
  {
    vec_push(&mut v, cast[u64](bget(path, q)));
    q = vadd(q, 1);
  }
  w_s(&mut v, ".bastio-lsp-");
  let mut r = slash;
  while r < blen(path)
  {
    vec_push(&mut v, cast[u64](bget(path, r)));
    r = vadd(r, 1);
  }
  let b = to_bytes(v);
  vec_free(v);
  return b;
}

/// Runs the compiler on the file `path` and appends its first error as a
/// diagnostic. `all` is the buffer's text, which positions are in. Returns
/// false if the compiler found nothing wrong.
///
/// A library has no `main`, so the compiler stops at that. It is then
/// checked through a program that only imports it, written to the
/// temporary directory.
fn check_diags(host: &mut Host, st: &mut State, path: &Bytes, all: &Bytes, out: &mut Vec[u64]) -> bool {
  let mut lines = vec_new[Vec[u64]]();
  let mut status = run_check(&mut host, &mut st, path, &mut lines);
  if lines_have(&mut lines, "no `main` function") {
    let wp = wrapper_path(path);
    let mut src = vec_new[u64]();
    w_s(&mut src, "import \"");
    push_bytes(&mut src, path);
    w_s(&mut src, "\";\nfn main() -> u64 { return 0; }\n");
    let sb = to_bytes(src);
    vec_free(src);
    if host_write(host, wp, sb) {
      free_lines(lines);
      lines = vec_new[Vec[u64]]();
      status = run_check(&mut host, &mut st, wp, &mut lines);
      remove_file(&mut host, wp);
    }
    bfree(sb);
    bfree(wp);
  }
  let mut found = false;
  let mut i = 0;
  while i < vec_len(lines) && !found
  {
    let l = vec_swap(&mut lines, i, vec_new[u64]());
    let m = find_error(l);
    if m > 0 {
      found = true;
      // `FILE:LINE:COL: error[CODE]: MESSAGE`
      let mut e = m - 1;
      let mut nums = vec_new[u64]();
      // Walk back over `:COL` and `:LINE`.
      let mut cur = e;
      let mut parts = 0;
      while parts < 2 && cur > 0
      {
        let mut s = cur;
        while s > 0 && is_digit(u_at(l, s - 1))
        {
          s = s - 1;
        }
        let mut v = 0;
        let mut q = s;
        while q < cur && v < 1000000000
        {
          let dg = u_at(l, q);
          if is_digit(dg) {
            v = v * 10 + (dg - 48);
          }
          q = vadd(q, 1);
        }
        vec_push(&mut nums, v);
        if s > 0 && u_at(l, s - 1) == 58 {
          cur = s - 1;
        } else {
          cur = s;
        }
        parts = vadd(parts, 1);
      }
      let col = u_at(nums, 0);
      let ln = u_at(nums, 1);
      vec_free(nums);
      // The file name is the text before the line number.
      let mut fname = vec_new[u64]();
      let mut f = 0;
      while f < cur && f < vec_len(l)
      {
        vec_push(&mut fname, u_at(l, f));
        f = vadd(f, 1);
      }
      let fb = to_bytes(fname);
      vec_free(fname);
      let fcanon = canon_path(fb);
      let pcanon = canon_path(path);
      let ours = bytes_same(fcanon, pcanon);
      bfree(fb);
      bfree(fcanon);
      bfree(pcanon);
      // The code and the message.
      let mut code = vec_new[u64]();
      let mut c = vadd(m, 7);
      while c < vec_len(l) && u_at(l, c) != 93
      {
        vec_push(&mut code, u_at(l, c));
        c = vadd(c, 1);
      }
      let mut msg = vec_new[u64]();
      if !ours {
        // An error in another file: say where, on the first line.
        let mut w = 0;
        while w < vec_len(l)
        {
          vec_push(&mut msg, u_at(l, w));
          w = vadd(w, 1);
        }
      } else {
        c = vadd(c, 3);
        while c < vec_len(l)
        {
          vec_push(&mut msg, u_at(l, c));
          c = vadd(c, 1);
        }
      }
      // The caret's width and the notes after the source line.
      let mut width = 1;
      let mut j = vadd(i, 1);
      while j < vec_len(lines) && j < vadd(i, 40)
      {
        let nl = vec_swap(&mut lines, j, vec_new[u64]());
        if vec_len(nl) > 0 && find_error(nl) == 0 {
          let mut carets = 0;
          let mut x = 0;
          let mut bar = false;
          while x < vec_len(nl)
          {
            let ch = u_at(nl, x);
            if ch == 124 {
              bar = true;
            }
            if bar && ch == 94 {
              carets = vadd(carets, 1);
            }
            x = vadd(x, 1);
          }
          if carets > 0 && width == 1 {
            width = carets;
          }
          if vec_len(nl) > 5 && u_at(nl, 3) == 61 && u_at(nl, 4) == 32 {
            vec_push(&mut msg, 10);
            let mut y = 5;
            while y < vec_len(nl)
            {
              vec_push(&mut msg, u_at(nl, y));
              y = vadd(y, 1);
            }
          }
        }
        line_back(&mut lines, j, nl);
        j = vadd(j, 1);
      }
      if ours {
        let s = lc_to_off(all, ln, col);
        let mut e2 = s;
        let mut w2 = 0;
        while w2 < width && e2 < blen(all) && at(all, e2) != 10
        {
          e2 = vadd(e2, 1);
          w2 = vadd(w2, 1);
        }
        w_diag(&mut out, all, 0, s, e2, code, msg);
      } else {
        w_diag(&mut out, all, 0, 0, 0, code, msg);
      }
      vec_free(code);
      vec_free(msg);
    }
    line_back(&mut lines, i, l);
    i = vadd(i, 1);
  }
  if !found && status != 0 {
    // The compiler did not run, or said something else.
    let mut msg = vec_new[u64]();
    w_s(&mut msg, "bastioc did not check the file (exit status ");
    w_num(&mut msg, status);
    w_s(&mut msg, ")");
    let mut q = 0;
    while q < vec_len(lines) && q < 5
    {
      let nl = vec_swap(&mut lines, q, vec_new[u64]());
      vec_push(&mut msg, 10);
      w_append(&mut msg, nl);
      line_back(&mut lines, q, nl);
      q = vadd(q, 1);
    }
    let code = vec_new[u64]();
    w_diag(&mut out, all, 0, 0, 0, code, msg);
    vec_free(code);
    vec_free(msg);
    found = true;
  }
  free_lines(lines);
  return found;
}

/// The compiler checks what is in the buffer, not what is on disk: the text
/// is written to a file beside `real` (`shadow_path`), checked, and removed.
/// If that file cannot be written, `real` itself is checked.
fn compiler_diags(host: &mut Host, st: &mut State, real: &Bytes, all: &Bytes, out: &mut Vec[u64]) -> bool {
  let sp = shadow_path(real);
  let mut found = false;
  if host_write(host, sp, all) {
    found = check_diags(&mut host, &mut st, sp, all, &mut out);
    remove_file(&mut host, sp);
  } else {
    found = check_diags(&mut host, &mut st, real, all, &mut out);
  }
  bfree(sp);
  return found;
}

/// Publishes the diagnostics of the open document `uri`; `full` runs the
/// compiler too.
fn publish(con: &mut Serial, host: &mut Host, st: &mut State, uri: &Bytes, full: bool) {
  let k = find_doc(&mut st, uri);
  if k == 0 {
    return;
  }
  let text = doc_copy(&mut st.texts, k - 1);
  let path = doc_copy(&mut st.paths, k - 1);
  let mut items = vec_new[u64]();
  let mut found = false;
  if full {
    found = compiler_diags(&mut host, &mut st, path, text, &mut items);
  }
  if !found {
    lex_diags(text, &mut items);
  }
  let mut params = vec_new[u64]();
  w_s(&mut params, "{\"uri\":\"");
  jesc_bytes(&mut params, uri, 0, blen(uri));
  w_s(&mut params, "\",\"diagnostics\":[");
  w_append(&mut params, items);
  w_s(&mut params, "]}");
  send_notification(&mut con, "textDocument/publishDiagnostics", params);
  vec_free(params);
  vec_free(items);
  bfree(text);
  bfree(path);
}

fn publish_empty(con: &mut Serial, uri: &Bytes) {
  let mut params = vec_new[u64]();
  w_s(&mut params, "{\"uri\":\"");
  jesc_bytes(&mut params, uri, 0, blen(uri));
  w_s(&mut params, "\",\"diagnostics\":[]}");
  send_notification(&mut con, "textDocument/publishDiagnostics", params);
  vec_free(params);
}

// ---- Requests ----

fn kind_name(kind: u64) -> Str {
  if kind == DK_FN { return "function"; }
  if kind == DK_SPEC { return "spec function"; }
  if kind == DK_STRUCT { return "struct"; }
  if kind == DK_ENUM { return "enum"; }
  if kind == DK_CONST { return "constant"; }
  if kind == DK_VARIANT { return "variant"; }
  return "field";
}

/// The span of a local binding's statement or parameter, for hover: the
/// `let` through the end of the line, or the parameter and its type.
fn local_text(ix: &Prog, ti: u64, out: &mut Vec[u64]) {
  let t = tok_at(ix.toks, ti);
  let p = tok_at(ix.toks, vsub(ti, 1));
  let mut s = t.start;
  if is_kw(p, KW_MUT) {
    s = p.start;
  }
  // `let [mut] x [: T] = ...;` up to the `=`; a parameter up to `,` or `)`.
  let mut j = vadd(ti, 1);
  let mut depth = 0;
  let mut e = t.end;
  let mut stop = false;
  while !stop && j < vec_len(ix.toks) && j < vadd(ti, 60)
  {
    let c = tok_at(ix.toks, j);
    if c.kind == K_EOF {
      stop = true;
    } else if is_opener(c) {
      depth = sadd(depth, 1);
      e = c.end;
    } else if is_closer(c) {
      if depth == 0 {
        stop = true;
      } else {
        depth = depth - 1;
        e = c.end;
      }
    } else if depth == 0 && (is_p(c, P_COMMA) || is_p(c, P_EQ) || is_p(c, P_SEMI) || is_p(c, P_FATARROW)) {
      stop = true;
    } else {
      e = tok_end(c);
    }
    j = vadd(j, 1);
  }
  let mut k = s;
  if is_kw(tok_at(ix.toks, vsub(ti, 2)), KW_LET) && is_kw(p, KW_MUT) {
    k = tok_at_start(ix.toks, vsub(ti, 2));
  } else if is_kw(p, KW_LET) {
    k = p.start;
  }
  while k < e && k < blen(ix.all)
  {
    vec_push(&mut out, at(ix.all, k));
    k = vadd(k, 1);
  }
}

/// The hover text (Markdown) for definition `d` of the program.
fn hover_def(ix: &Prog, d: Def, out: &mut Vec[u64]) {
  w_s(&mut out, "```bastio\n");
  let mut s = d.ss;
  let mut e = d.se;
  if e > blen(ix.all) {
    e = blen(ix.all);
  }
  if e > s && e - s > 1500 {
    e = vadd(s, 1500);
  }
  if d.parent != 0 {
    let pd = def_at(ix, d.parent - 1);
    w_s(&mut out, kind_name(pd.kind));
    vec_push(&mut out, 32);
    let mut k = pd.ns;
    while k < pd.ne && k < blen(ix.all)
    {
      vec_push(&mut out, at(ix.all, k));
      k = vadd(k, 1);
    }
    w_s(&mut out, "\n  ");
  }
  while s < e
  {
    vec_push(&mut out, at(ix.all, s));
    s = vadd(s, 1);
  }
  w_s(&mut out, "\n```");
  let mut doc = vec_new[u64]();
  doc_comment(ix.all, u_at(ix.fstart, d.file), d.ss, &mut doc);
  if vec_len(doc) > 0 {
    w_s(&mut out, "\n\n");
    w_append(&mut out, doc);
  }
  vec_free(doc);
}

/// Appends the text of the identifier token `ti`.
fn tok_text(ix: &Prog, ti: u64, out: &mut Vec[u64]) {
  let t = tok_at(ix.toks, ti);
  let mut k = t.start;
  while k < t.end && k < blen(ix.all)
  {
    vec_push(&mut out, at(ix.all, k));
    k = vadd(k, 1);
  }
}

/// Builds the program of the document at `uri` and finds what is at the
/// request's position. Returns the program (the file is index 0) and what
/// resolve found.
struct Found { ix: Prog, res: Res, ti: u64 }

fn locate(host: &Host, st: &mut State, j: &Json, params: u64) -> Found {
  let uri = str_of(j, jpath2(j, params, "textDocument", "uri"));
  let k = find_doc(&mut st, uri);
  bfree(uri);
  if k == 0 {
    return Found { ix: pg_new(), res: no_res(), ti: 0 };
  }
  let path = doc_copy(&mut st.paths, k - 1);
  let ix = pg_for(host, &mut st, path);
  bfree(path);
  let line = jnum(j, jpath2(j, params, "position", "line"));
  let ch = jnum(j, jpath2(j, params, "position", "character"));
  let off = lsp_to_off(ix.all, 0, line, ch);
  let at_tok = tok_at_offset(ix, 0, off);
  if !at_tok.found {
    return Found { ix: ix, res: no_res(), ti: 0 };
  }
  let r = resolve_any(ix, 0, at_tok.idx);
  return Found { ix: ix, res: r, ti: at_tok.idx };
}

fn on_hover(con: &mut Serial, host: &Host, st: &mut State, j: &Json, root: u64, id: &Vec[u64]) {
  let params = jget(j, root, "params");
  let f = locate(host, &mut st, j, params);
  let mut res_ = vec_new[u64]();
  if f.res.found {
    let mut md = vec_new[u64]();
    let t = tok_at(f.ix.toks, f.ti);
    if f.res.local {
      w_s(&mut md, "```bastio\n");
      local_text(f.ix, f.res.idx, &mut md);
      w_s(&mut md, "\n```\n\nlocal variable");
    } else {
      let d = def_at(f.ix, f.res.idx);
      hover_def(f.ix, d, &mut md);
    }
    w_s(&mut res_, "{\"contents\":{\"kind\":\"markdown\",\"value\":\"");
    jesc_vec(&mut res_, md);
    w_s(&mut res_, "\"},\"range\":");
    w_range(&mut res_, f.ix.all, 0, t.start, t.end);
    w_s(&mut res_, "}");
    vec_free(md);
  } else {
    w_s(&mut res_, "null");
  }
  send_result(&mut con, id, res_);
  vec_free(res_);
  pg_free(f.ix);
}

fn on_definition(con: &mut Serial, host: &Host, st: &mut State, j: &Json, root: u64, id: &Vec[u64]) {
  let params = jget(j, root, "params");
  let f = locate(host, &mut st, j, params);
  let mut res_ = vec_new[u64]();
  if f.res.found {
    let mut file = 0;
    let mut s = 0;
    let mut e = 0;
    if f.res.local {
      let t = tok_at(f.ix.toks, f.res.idx);
      s = t.start;
      e = t.end;
    } else {
      let d = def_at(f.ix, f.res.idx);
      file = d.file;
      s = d.ns;
      e = d.ne;
    }
    let uri = pg_uri(&mut st, f.ix, file);
    w_s(&mut res_, "{\"uri\":\"");
    jesc_bytes(&mut res_, uri, 0, blen(uri));
    w_s(&mut res_, "\",\"range\":");
    w_range(&mut res_, f.ix.all, u_at(f.ix.fstart, file), s, e);
    w_s(&mut res_, "}");
    bfree(uri);
  } else {
    w_s(&mut res_, "null");
  }
  send_result(&mut con, id, res_);
  vec_free(res_);
  pg_free(f.ix);
}

// ---- References, highlights and rename ----

/// Places that name one thing: `uris` are the files, hit k is range
/// `hrange[k]` (as JSON) of file `huri[k]`.
struct Hits { uris: Vec[Bytes], huri: Vec[u64], hrange: Vec[Bytes] }

fn hits_new() -> Hits {
  return Hits { uris: vec_new[Bytes](), huri: vec_new[u64](), hrange: vec_new[Bytes]() };
}

fn hits_free(h: Hits) {
  let mut uris = h.uris;
  while vec_len(uris) > 0 {
    bfree(vec_pop(&mut uris));
  }
  vec_free(uris);
  vec_free(h.huri);
  let mut ranges = h.hrange;
  while vec_len(ranges) > 0 {
    bfree(vec_pop(&mut ranges));
  }
  vec_free(ranges);
}

fn bytes_at_same(v: &mut Vec[Bytes], k: u64, b: &Bytes) -> bool {
  if k >= vec_len(v) {
    return false;
  }
  let t = vec_swap(&mut v, k, balloc(0));
  let same = bytes_same(t, b);
  bfree(vec_swap(&mut v, k, t));
  return same;
}

/// The index of `uri` in the hits' files; it is added if it is new.
fn hits_uri(h: &mut Hits, uri: &Bytes) -> u64 {
  let mut k = 0;
  while k < vec_len(h.uris)
  {
    if bytes_at_same(&mut h.uris, k, uri) {
      return k;
    }
    k = vadd(k, 1);
  }
  vec_push(&mut h.uris, byte_range(uri, 0, blen(uri)));
  return k;
}

/// Adds the range `rb` of file `uri`, unless it is there. Takes `rb`.
fn hits_add(h: &mut Hits, uri: &Bytes, rb: Bytes) {
  let u = hits_uri(&mut h, uri);
  let mut k = 0;
  while k < vec_len(h.huri)
  {
    if u_at(h.huri, k) == u && bytes_at_same(&mut h.hrange, k, rb) {
      bfree(rb);
      return;
    }
    k = vadd(k, 1);
  }
  vec_push(&mut h.huri, u);
  vec_push(&mut h.hrange, rb);
}

/// Adds every place of program `ix` that names `tgt` (a result of
/// `resolve_any` in `ix`): all its files, or only file 0 with `only0`; the
/// place where it is declared only with `decl`.
fn collect_refs(h: &mut Hits, st: &mut State, ix: &Prog, tgt: Res, decl: bool, only0: bool) {
  let mut ns = 0;
  let mut ne = 0;
  let mut dfile = 0;
  if tgt.local {
    let t = tok_at(ix.toks, tgt.idx);
    ns = t.start;
    ne = t.end;
  } else {
    let d = def_at(ix, tgt.idx);
    ns = d.ns;
    ne = d.ne;
    dfile = d.file;
  }
  let mut f = 0;
  while f < vec_len(ix.fstart) && (!only0 || f == 0)
  {
    let uri = pg_uri(&mut st, ix, f);
    let from = u_at(ix.fstart, f);
    let te = file_toks_end(ix, f);
    let mut i = u_at(ix.tstart, f);
    while i < te && i < vec_len(ix.toks)
    {
      let t = vec_get(ix.toks, i);
      if t.kind == K_IDENT && same_text(ix.all, t.start, t.end, ns, ne) {
        let r = resolve_any(ix, f, i);
        if r.found && r.local == tgt.local && r.idx == tgt.idx {
          let mut is_decl = i == tgt.idx;
          if !tgt.local {
            is_decl = f == dfile && t.start == ns;
          }
          if decl || !is_decl {
            let mut rj = vec_new[u64]();
            w_range(&mut rj, ix.all, from, t.start, t.end);
            let rb = to_bytes(rj);
            vec_free(rj);
            hits_add(&mut h, uri, rb);
          }
        }
      }
      i = vadd(i, 1);
    }
    bfree(uri);
    f = vadd(f, 1);
  }
}

/// The places that name what the request's position is on. A local is
/// searched for in its file; anything else also in the programs of the other
/// open documents, which may use it without the first one seeing them.
fn gather(host: &Host, st: &mut State, f: &Found, decl: bool, everywhere: bool) -> Hits {
  let mut h = hits_new();
  if !f.res.found {
    return h;
  }
  collect_refs(&mut h, &mut st, f.ix, f.res, decl, f.res.local || !everywhere);
  if f.res.local || !everywhere {
    return h;
  }
  let d = def_at(f.ix, f.res.idx);
  let dpath = pg_path(f.ix, d.file);
  let rel = vsub(d.ns, u_at(f.ix.fstart, d.file));
  let me = pg_path(f.ix, 0);
  let mut k = 0;
  while k < vec_len(st.paths)
  {
    let p = doc_copy(&mut st.paths, k);
    if !bytes_same(p, me) {
      let ix2 = pg_for(host, &mut st, p);
      let mut found = false;
      let mut d2 = 0;
      while d2 < vec_len(ix2.defs) && !found
      {
        let df = vec_get(ix2.defs, d2);
        if df.kind == d.kind && vsub(df.ns, u_at(ix2.fstart, df.file)) == rel {
          let q = pg_path(ix2, df.file);
          if bytes_same(q, dpath) {
            found = true;
          }
          bfree(q);
        }
        if !found {
          d2 = vadd(d2, 1);
        }
      }
      if found {
        collect_refs(&mut h, &mut st, ix2, Res { found: true, local: false, idx: d2 }, decl, false);
      }
      pg_free(ix2);
    }
    bfree(p);
    k = vadd(k, 1);
  }
  bfree(dpath);
  bfree(me);
  return h;
}

fn on_references(con: &mut Serial, host: &Host, st: &mut State, j: &Json, root: u64, id: &Vec[u64]) {
  let params = jget(j, root, "params");
  let decl = jis_true(j, jpath2(j, params, "context", "includeDeclaration"));
  let f = locate(host, &mut st, j, params);
  let mut res_ = vec_new[u64]();
  if f.res.found {
    let mut h = gather(host, &mut st, f, decl, true);
    w_s(&mut res_, "[");
    let mut k = 0;
    while k < vec_len(h.huri)
    {
      if k > 0 {
        vec_push(&mut res_, 44);
      }
      let uri = doc_copy(&mut h.uris, u_at(h.huri, k));
      w_s(&mut res_, "{\"uri\":\"");
      jesc_bytes(&mut res_, uri, 0, blen(uri));
      w_s(&mut res_, "\",\"range\":");
      let rb = doc_copy(&mut h.hrange, k);
      push_bytes(&mut res_, rb);
      w_s(&mut res_, "}");
      bfree(rb);
      bfree(uri);
      k = vadd(k, 1);
    }
    w_s(&mut res_, "]");
    hits_free(h);
  } else {
    w_s(&mut res_, "null");
  }
  send_result(&mut con, id, res_);
  vec_free(res_);
  pg_free(f.ix);
}

fn on_highlight(con: &mut Serial, host: &Host, st: &mut State, j: &Json, root: u64, id: &Vec[u64]) {
  let params = jget(j, root, "params");
  let f = locate(host, &mut st, j, params);
  let mut res_ = vec_new[u64]();
  if f.res.found {
    let mut h = gather(host, &mut st, f, true, false);
    w_s(&mut res_, "[");
    let mut k = 0;
    while k < vec_len(h.huri)
    {
      // Only the file of the request (the first one the hits name).
      if u_at(h.huri, k) == 0 {
        if k > 0 {
          vec_push(&mut res_, 44);
        }
        w_s(&mut res_, "{\"range\":");
        let rb = doc_copy(&mut h.hrange, k);
        push_bytes(&mut res_, rb);
        w_s(&mut res_, ",\"kind\":1}");
        bfree(rb);
      }
      k = vadd(k, 1);
    }
    w_s(&mut res_, "]");
    hits_free(h);
  } else {
    w_s(&mut res_, "null");
  }
  send_result(&mut con, id, res_);
  vec_free(res_);
  pg_free(f.ix);
}

fn on_prepare_rename(con: &mut Serial, host: &Host, st: &mut State, j: &Json, root: u64, id: &Vec[u64]) {
  let params = jget(j, root, "params");
  let f = locate(host, &mut st, j, params);
  let mut res_ = vec_new[u64]();
  if f.res.found {
    let t = tok_at(f.ix.toks, f.ti);
    w_s(&mut res_, "{\"range\":");
    w_range(&mut res_, f.ix.all, 0, t.start, t.end);
    w_s(&mut res_, ",\"placeholder\":\"");
    jesc_bytes(&mut res_, f.ix.all, t.start, t.end);
    w_s(&mut res_, "\"}");
  } else {
    w_s(&mut res_, "null");
  }
  send_result(&mut con, id, res_);
  vec_free(res_);
  pg_free(f.ix);
}

/// Is `name` one identifier (and not a keyword)?
fn is_ident_name(name: &Bytes) -> bool {
  if blen(name) == 0 || blen(name) > 256 {
    return false;
  }
  let mut toks = vec_new[Tok]();
  lex(name, 0, &mut toks);
  let mut ok = false;
  if vec_len(toks) == 2 {
    let t = vec_get(toks, 0);
    ok = t.kind == K_IDENT && t.start == 0 && t.end == blen(name);
  }
  vec_free(toks);
  return ok;
}

fn on_rename(con: &mut Serial, host: &Host, st: &mut State, j: &Json, root: u64, id: &Vec[u64]) {
  let params = jget(j, root, "params");
  let name = str_of(j, jget(j, params, "newName"));
  if !is_ident_name(name) {
    send_error(&mut con, id, 32602, "the new name is not an identifier");
    bfree(name);
    return;
  }
  let f = locate(host, &mut st, j, params);
  let mut res_ = vec_new[u64]();
  if f.res.found {
    let mut h = gather(host, &mut st, f, true, true);
    w_s(&mut res_, "{\"changes\":{");
    let mut u = 0;
    while u < vec_len(h.uris)
    {
      if u > 0 {
        vec_push(&mut res_, 44);
      }
      let uri = doc_copy(&mut h.uris, u);
      w_s(&mut res_, "\"");
      jesc_bytes(&mut res_, uri, 0, blen(uri));
      w_s(&mut res_, "\":[");
      bfree(uri);
      let mut first = true;
      let mut k = 0;
      while k < vec_len(h.huri)
      {
        if u_at(h.huri, k) == u {
          if !first {
            vec_push(&mut res_, 44);
          }
          first = false;
          w_s(&mut res_, "{\"range\":");
          let rb = doc_copy(&mut h.hrange, k);
          push_bytes(&mut res_, rb);
          bfree(rb);
          w_s(&mut res_, ",\"newText\":\"");
          jesc_bytes(&mut res_, name, 0, blen(name));
          w_s(&mut res_, "\"}");
        }
        k = vadd(k, 1);
      }
      w_s(&mut res_, "]");
      u = vadd(u, 1);
    }
    w_s(&mut res_, "}}");
    hits_free(h);
  } else {
    w_s(&mut res_, "null");
  }
  send_result(&mut con, id, res_);
  vec_free(res_);
  pg_free(f.ix);
  bfree(name);
}

fn symbol_kind(kind: u64) -> u64 {
  if kind == DK_FN || kind == DK_SPEC { return 12; }
  if kind == DK_STRUCT { return 23; }
  if kind == DK_ENUM { return 10; }
  if kind == DK_CONST { return 14; }
  if kind == DK_VARIANT { return 22; }
  return 8;
}

fn w_symbol(out: &mut Vec[u64], ix: &Prog, d: Def, children: &Vec[u64]) {
  let from = u_at(ix.fstart, d.file);
  w_s(&mut out, "{\"name\":\"");
  jesc_bytes(&mut out, ix.all, d.ns, d.ne);
  w_s(&mut out, "\",\"kind\":");
  w_num(&mut out, symbol_kind(d.kind));
  w_s(&mut out, ",\"range\":");
  w_range(&mut out, ix.all, from, d.ss, d.ie);
  w_s(&mut out, ",\"selectionRange\":");
  w_range(&mut out, ix.all, from, d.ns, d.ne);
  if vec_len(children) > 0 {
    w_s(&mut out, ",\"children\":[");
    w_append(&mut out, children);
    w_s(&mut out, "]");
  }
  w_s(&mut out, "}");
}

fn on_symbols(con: &mut Serial, host: &Host, st: &mut State, j: &Json, root: u64, id: &Vec[u64]) {
  let params = jget(j, root, "params");
  let uri = str_of(j, jpath2(j, params, "textDocument", "uri"));
  let k = find_doc(&mut st, uri);
  bfree(uri);
  let mut res_ = vec_new[u64]();
  w_s(&mut res_, "[");
  if k > 0 {
    let path = doc_copy(&mut st.paths, k - 1);
    let ix = pg_for(host, &mut st, path);
    bfree(path);
    let mut first = true;
    let mut d = 0;
    while d < vec_len(ix.defs)
    {
      let df = vec_get(ix.defs, d);
      if df.file == 0 && df.parent == 0 {
        let mut kids = vec_new[u64]();
        let mut m = vadd(d, 1);
        let mut kf = true;
        while m < vec_len(ix.defs)
        {
          let mdf = vec_get(ix.defs, m);
          if mdf.parent == vadd(d, 1) {
            if !kf {
              vec_push(&mut kids, 44);
            }
            let none = vec_new[u64]();
            w_symbol(&mut kids, ix, mdf, none);
            vec_free(none);
            kf = false;
          }
          m = vadd(m, 1);
        }
        if !first {
          vec_push(&mut res_, 44);
        }
        w_symbol(&mut res_, ix, df, kids);
        vec_free(kids);
        first = false;
      }
      d = vadd(d, 1);
    }
    pg_free(ix);
  }
  w_s(&mut res_, "]");
  send_result(&mut con, id, res_);
  vec_free(res_);
}

fn on_format(con: &mut Serial, st: &mut State, j: &Json, root: u64, id: &Vec[u64]) {
  let params = jget(j, root, "params");
  let uri = str_of(j, jpath2(j, params, "textDocument", "uri"));
  let k = find_doc(&mut st, uri);
  bfree(uri);
  let mut res_ = vec_new[u64]();
  w_s(&mut res_, "null");
  if k > 0 {
    let text = doc_copy(&mut st.texts, k - 1);
    let mut out = vec_new[u64]();
    if blen(text) <= SRC_MAX && fmt_source(text, &mut out) {
      let b = to_bytes(out);
      let mut same = blen(b) == blen(text) && bytes_same(b, text);
      if blen(b) <= SRC_MAX && !fmt_same_tokens(text, b) {
        same = true;
      }
      vec_free(res_);
      res_ = vec_new[u64]();
      w_s(&mut res_, "[");
      if !same {
        // Replace everything: from the start to the end of the text.
        let end = off_to_lsp(text, 0, blen(text));
        w_s(&mut res_, "{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":");
        w_pos(&mut res_, end);
        w_s(&mut res_, "},\"newText\":\"");
        jesc_bytes(&mut res_, b, 0, blen(b));
        w_s(&mut res_, "\"}");
      }
      w_s(&mut res_, "]");
      bfree(b);
    }
    vec_free(out);
    bfree(text);
  }
  send_result(&mut con, id, res_);
  vec_free(res_);
}

fn on_initialize(con: &mut Serial, st: &mut State, j: &Json, root: u64, id: &Vec[u64]) {
  let opts = jget(j, jget(j, root, "params"), "initializationOptions");
  let cmd = jget(j, opts, "bastioc");
  if jis_str(j, cmd) {
    bfree(st.cmd);
    st.cmd = str_of(j, cmd);
  }
  let target = jget(j, opts, "target");
  if jis_str(j, target) {
    bfree(st.target);
    st.target = str_of(j, target);
  }
  if jis_true(j, jget(j, opts, "checkOnChange")) {
    st.on_change = true;
  }
  let libs = jget(j, opts, "lib");
  let n = jcount(j, libs);
  let mut k = 0;
  while k < n && k < 64
  {
    let e = jelem(j, libs, k);
    if jis_str(j, e) {
      vec_push(&mut st.libs, str_of(j, e));
    }
    k = vadd(k, 1);
  }
  let mut res_ = vec_new[u64]();
  w_s(&mut res_, "{\"capabilities\":{\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":{\"includeText\":false}},");
  w_s(&mut res_, "\"hoverProvider\":true,\"definitionProvider\":true,\"referencesProvider\":true,\"documentHighlightProvider\":true,\"renameProvider\":{\"prepareProvider\":true},\"documentSymbolProvider\":true,\"documentFormattingProvider\":true},");
  w_s(&mut res_, "\"serverInfo\":{\"name\":\"bastio-lsp\"}}");
  send_result(&mut con, id, res_);
  vec_free(res_);
}

/// Handles one message. 0 to go on, 1 to exit with status 0, 2 for status 1.
fn handle(con: &mut Serial, host: &mut Host, st: &mut State, msg: Bytes) -> u64 {
  let p = json_parse(msg);
  let mut code = 0;
  if p.j.ok {
    let root = p.root;
    let mut method = vec_new[u64]();
    jdecode(p.j, jget(p.j, root, "method"), &mut method);
    let mut id = vec_new[u64]();
    id_json(p.j, root, &mut id);
    let is_request = jget(p.j, root, "id") != 0;
    let params = jget(p.j, root, "params");
    if vec_is(method, "initialize") {
      on_initialize(&mut con, &mut st, p.j, root, id);
    } else if vec_is(method, "shutdown") {
      st.shutdown = true;
      let mut nv = vec_new[u64]();
      w_s(&mut nv, "null");
      send_result(&mut con, id, nv);
      vec_free(nv);
    } else if vec_is(method, "exit") {
      code = 2;
      if st.shutdown {
        code = 1;
      }
    } else if vec_is(method, "textDocument/didOpen") {
      let td = jget(p.j, params, "textDocument");
      let uri = str_of(p.j, jget(p.j, td, "uri"));
      let text = str_of(p.j, jget(p.j, td, "text"));
      set_doc(&mut st, uri, text);
      publish(&mut con, &mut host, &mut st, uri, true);
      bfree(uri);
    } else if vec_is(method, "textDocument/didChange") {
      let uri = str_of(p.j, jpath2(p.j, params, "textDocument", "uri"));
      let changes = jget(p.j, params, "contentChanges");
      let n = jcount(p.j, changes);
      if n > 0 {
        let text = str_of(p.j, jget(p.j, jelem(p.j, changes, n - 1), "text"));
        set_doc(&mut st, uri, text);
        publish(&mut con, &mut host, &mut st, uri, st.on_change);
      }
      bfree(uri);
    } else if vec_is(method, "textDocument/didSave") {
      let uri = str_of(p.j, jpath2(p.j, params, "textDocument", "uri"));
      publish(&mut con, &mut host, &mut st, uri, true);
      bfree(uri);
    } else if vec_is(method, "textDocument/didClose") {
      let uri = str_of(p.j, jpath2(p.j, params, "textDocument", "uri"));
      drop_doc(&mut st, uri);
      publish_empty(&mut con, uri);
      bfree(uri);
    } else if vec_is(method, "textDocument/hover") {
      on_hover(&mut con, host, &mut st, p.j, root, id);
    } else if vec_is(method, "textDocument/definition") {
      on_definition(&mut con, host, &mut st, p.j, root, id);
    } else if vec_is(method, "textDocument/references") {
      on_references(&mut con, host, &mut st, p.j, root, id);
    } else if vec_is(method, "textDocument/documentHighlight") {
      on_highlight(&mut con, host, &mut st, p.j, root, id);
    } else if vec_is(method, "textDocument/prepareRename") {
      on_prepare_rename(&mut con, host, &mut st, p.j, root, id);
    } else if vec_is(method, "textDocument/rename") {
      on_rename(&mut con, host, &mut st, p.j, root, id);
    } else if vec_is(method, "textDocument/documentSymbol") {
      on_symbols(&mut con, host, &mut st, p.j, root, id);
    } else if vec_is(method, "textDocument/formatting") {
      on_format(&mut con, &mut st, p.j, root, id);
    } else if is_request && vec_len(method) > 0 {
      send_error(&mut con, id, 32601, "method not found");
    }
    vec_free(method);
    vec_free(id);
  }
  let src = json_free(p);
  bfree(src);
  return code;
}

fn main(con: &mut Serial, host: &mut Host) -> u64 {
  let mut cmd = balloc(0);
  if !host_env(host, "BASTIOC", &mut cmd) {
    bfree(cmd);
    cmd = bfrom("bastioc1");
  }
  let mut st = State {
    uris: vec_new[Bytes](),
    paths: vec_new[Bytes](),
    texts: vec_new[Bytes](),
    cmd: cmd,
    target: balloc(0),
    libs: vec_new[Bytes](),
    on_change: false,
    shutdown: false
  };
  let mut status = 1;
  let mut running = true;
  while running {
    let mut msg = balloc(0);
    if !read_msg(&mut con, &mut msg) {
      bfree(msg);
      running = false;
    } else {
      let r = handle(&mut con, &mut host, &mut st, msg);
      if r == 1 {
        status = 0;
        running = false;
      } else if r == 2 {
        status = 1;
        running = false;
      }
    }
  }
  while vec_len(st.uris) > 0 {
    bfree(vec_pop(&mut st.uris));
  }
  vec_free(st.uris);
  while vec_len(st.paths) > 0 {
    bfree(vec_pop(&mut st.paths));
  }
  vec_free(st.paths);
  while vec_len(st.texts) > 0 {
    bfree(vec_pop(&mut st.texts));
  }
  vec_free(st.texts);
  while vec_len(st.libs) > 0 {
    bfree(vec_pop(&mut st.libs));
  }
  vec_free(st.libs);
  bfree(st.cmd);
  bfree(st.target);
  return status;
}
